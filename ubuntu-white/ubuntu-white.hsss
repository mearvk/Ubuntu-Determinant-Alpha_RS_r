# Ubuntu White HSSS
# Human/System Style Specification
# Extension: .hsss (intentionally not .hss)
# Pronunciation: H-S-S-S / "aitch ess ess ess"

style.name = Ubuntu White
style.family = Ubuntu-inspired open-source desktop ergonomics
style.status = project-design-specification
style.intent = moral and guided by Law and Morals

[visual]
background = #FFFFFF
surface = #FFFFFF
panel = #F7F7F7
control = #F2F2F2
text = #303030
text-muted = #626262
border = #D6D6D6
focus = #4A4A4A
accent = restrained-warm-accent
folder.fill = #FFFFFF
folder.stroke = #4A4A4A

[typography]
stack = "Noto Sans, Ubuntu Sans, Inter, system-ui, sans-serif"
weight.body = 400
weight.label = 500
weight.heading = 600
line-height = 1.5

[ergonomics]
spacing.base = 8px
interactive.minimum = 40px
primary.minimum = 44px
focus.visible = true
keyboard.navigation = required
hover.must-not-be-only-signal = true

[icons]
source = SVG
stroke = dark-grey
fill = white
geometry = simple
negative-space = generous
sizes = 16,24,32,48,64
labels = preferred when ambiguity exists

[desktop]
workspace = white-first
chrome = dark-grey-on-white
folders = white-with-dark-grey-outline
windows = light-surfaces-with-clear-boundaries
menus = white-or-near-white
shadows = restrained
animations = subtle

[install]
model = inspect-plan-authorize-apply-verify
silent-persistent-changes = false
rollback = preferred
existing-desktop-detection = required-when-integrated

[provenance]
source-inspiration = Ubuntu/GNOME open-source desktop conventions
project-assets = independently authored
trademark-claim = none

[ethics]
label = moral and guided by Law and Morals
meaning = design value and engineering constraint
legal-advice = false
statutory-replacement = false

[compatibility]
gtk = target
icon-themes = target
shells = adapter-based
fallback = system-theme
