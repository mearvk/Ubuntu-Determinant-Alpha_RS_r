#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# jdesk-provision — JDesk Native Application Provisioner
#
# Reads jdesk-packages.json and installs all declared native applications.
# Runs at first boot (or on demand) with Grade 3+ privilege (sudo_gate).
#
# Strategy: NO binaries in the git repo. All apps come from:
#   1. Ubuntu apt repositories (most packages)
#   2. GitHub Releases (VSCodium, other AppImage/tarball distribs)
#   3. Offline USB cache (for air-gapped installations)
#
# This avoids GitHub LFS entirely. The repo stays source-only.
# The binaries arrive at install time, verified by SHA-256 where applicable.
#
# Usage:
#   sudo jdesk-provision                    # Install core + standard
#   sudo jdesk-provision --full             # Install all (including optional)
#   sudo jdesk-provision --core-only        # Install core only
#   sudo jdesk-provision --build-cache DIR  # Build offline cache tarball
#   sudo jdesk-provision --status           # Show what's installed
#   sudo jdesk-provision --verify           # Verify all symlinks and binaries
#
# Privilege: Grade 3 (Maintenance) per sudo_gate
# Does: apt install, mkdir, ln, wget/curl
# Does NOT: kernel modules, security policy, boot changes (those are Grade 7+)
#
# Copyright (C) 2026 MEARVK LLC
# Author: Maximilian Eric Alexander Rupplin von Keffikon

set -euo pipefail

# ===========================================================================
#  Configuration
# ===========================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$SCRIPT_DIR/jdesk-packages.json"
INSTALL_DIR="/opt/jdesk/apps"
CACHE_DIR="/opt/jdesk/.cache"
ICONS_DIR="/opt/jdesk/icons"
MANIFESTS_DIR="/opt/jdesk/manifests"
PROFILES_DIR="/opt/jdesk/profiles"
OFFLINE_CACHE="/media/jdesk-cache/packages.tar.zst"
LOG_FILE="/var/log/jdesk-provision.log"
MIN_SPACE_MB=3072

# Fall back to user-writable log if not root
if [ "$(id -u)" -ne 0 ]; then
    LOG_FILE="${HOME}/.local/share/jdesk-provision.log"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || LOG_FILE="/dev/null"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Counters
INSTALLED=0
SKIPPED=0
FAILED=0

# ===========================================================================
#  Functions
# ===========================================================================

log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    echo "$msg" >> "$LOG_FILE"
    echo -e "$msg"
}

info()    { log "${BLUE}[INFO]${NC} $1"; }
success() { log "${GREEN}[OK]${NC}   $1"; }
warn()    { log "${YELLOW}[WARN]${NC} $1"; }
error()   { log "${RED}[FAIL]${NC} $1"; }

check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        error "This script requires Grade 3+ privilege (sudo)."
        echo "  Usage: sudo jdesk-provision"
        echo "  Grade: 3 (Maintenance) per sudo_gate"
        exit 1
    fi
}

check_manifest() {
    if [ ! -f "$MANIFEST" ]; then
        error "Package manifest not found: $MANIFEST"
        exit 1
    fi
}

check_space() {
    info "Checking disk space..."
    mkdir -p "$INSTALL_DIR"

    local avail
    avail=$(df -BM "$INSTALL_DIR" | tail -1 | awk '{print $4}' | tr -d 'M')

    if [ "$avail" -lt "$MIN_SPACE_MB" ]; then
        error "Insufficient space: ${avail} MB available, need ${MIN_SPACE_MB} MB (3 GB)"
        echo "  Allocation covers: Linux natives (~900 MB) + Wine (~400 MB) +"
        echo "  Darling (~300 MB) + Windows/macOS app space (~800 MB) + headroom (~550 MB)"
        exit 1
    fi

    success "Disk space OK: ${avail} MB available (need ${MIN_SPACE_MB} MB)"
}

check_tools() {
    # Need jq for JSON parsing, and wget or curl for downloads
    local missing=()

    command -v jq &>/dev/null || missing+=("jq")
    command -v wget &>/dev/null || command -v curl &>/dev/null || missing+=("wget or curl")

    if [ ${#missing[@]} -gt 0 ]; then
        info "Installing required tools: ${missing[*]}"
        apt-get update -qq
        apt-get install -y -qq jq wget 2>/dev/null
    fi
}

# ---------------------------------------------------------------------------
#  Package Installation Methods
# ---------------------------------------------------------------------------

install_apt_package() {
    local pkg_name="$1"
    local apt_pkg="$2"
    local binary="$3"
    local symlink="$4"

    # Check if already installed
    if [ -f "$binary" ] && [ -L "$symlink" ]; then
        success "$pkg_name already installed"
        ((SKIPPED++))
        return 0
    fi

    # Install via apt if binary not present
    if [ ! -f "$binary" ]; then
        info "Installing $pkg_name via apt ($apt_pkg)..."
        if apt-get install -y -qq "$apt_pkg" 2>/dev/null; then
            success "$pkg_name installed via apt"
        else
            warn "$pkg_name: apt install failed (may need manual install)"
            ((FAILED++))
            return 1
        fi
    fi

    # Create symlink
    if [ -f "$binary" ]; then
        local symlink_dir
        symlink_dir=$(dirname "$symlink")
        mkdir -p "$symlink_dir"
        ln -sf "$binary" "$symlink"
        success "$pkg_name: $symlink → $binary"
        ((INSTALLED++))
    else
        warn "$pkg_name: binary not found at $binary after install"
        ((FAILED++))
    fi
}

install_github_package() {
    local pkg_name="$1"
    local repo="$2"
    local asset_pattern="$3"
    local extract_to="$4"
    local binary="$5"
    local version_pin="$6"

    # Check if already installed
    if [ -f "$binary" ]; then
        success "$pkg_name already installed at $binary"
        ((SKIPPED++))
        return 0
    fi

    info "Installing $pkg_name from GitHub ($repo)..."

    # Determine download URL via GitHub API
    local api_url="https://api.github.com/repos/$repo/releases/latest"
    local download_url

    if command -v wget &>/dev/null; then
        download_url=$(wget -qO- "$api_url" | jq -r ".assets[] | select(.name | test(\"linux.*x64.*tar\")) | .browser_download_url" | head -1)
    else
        download_url=$(curl -sL "$api_url" | jq -r ".assets[] | select(.name | test(\"linux.*x64.*tar\")) | .browser_download_url" | head -1)
    fi

    if [ -z "$download_url" ] || [ "$download_url" = "null" ]; then
        warn "$pkg_name: Could not determine download URL from GitHub"
        ((FAILED++))
        return 1
    fi

    # Download to cache
    mkdir -p "$CACHE_DIR"
    local filename
    filename=$(basename "$download_url")
    local cache_path="$CACHE_DIR/$filename"

    if [ ! -f "$cache_path" ]; then
        info "  Downloading: $filename"
        if command -v wget &>/dev/null; then
            wget -q --show-progress -O "$cache_path" "$download_url"
        else
            curl -L --progress-bar -o "$cache_path" "$download_url"
        fi
    else
        info "  Using cached: $filename"
    fi

    # Extract
    mkdir -p "$extract_to"
    info "  Extracting to: $extract_to"
    tar xf "$cache_path" -C "$extract_to" --strip-components=0 2>/dev/null || \
        tar xf "$cache_path" -C "$extract_to" 2>/dev/null

    if [ -f "$binary" ]; then
        chmod +x "$binary"
        success "$pkg_name installed: $binary"
        ((INSTALLED++))
    else
        warn "$pkg_name: binary not found at $binary after extraction"
        ((FAILED++))
    fi
}

install_from_offline_cache() {
    if [ ! -f "$OFFLINE_CACHE" ]; then
        return 1  # No offline cache available
    fi

    info "Offline cache detected: $OFFLINE_CACHE"
    info "Extracting pre-built packages from USB cache..."

    mkdir -p "$INSTALL_DIR"

    if command -v zstd &>/dev/null; then
        zstd -d "$OFFLINE_CACHE" --stdout | tar x -C "$INSTALL_DIR"
    else
        # Fallback: try tar directly (GNU tar handles zstd if compiled with it)
        tar --zstd -xf "$OFFLINE_CACHE" -C "$INSTALL_DIR" 2>/dev/null || {
            warn "Cannot decompress zstd. Install zstd: apt install zstd"
            return 1
        }
    fi

    success "Offline cache extracted successfully"
    return 0
}

# ---------------------------------------------------------------------------
#  Core Logic
# ---------------------------------------------------------------------------

provision_packages() {
    local filter="$1"  # "core", "standard", "optional", "all"

    local pkg_count
    pkg_count=$(jq '.packages | length' "$MANIFEST")

    info "Processing $pkg_count packages (filter: $filter)..."
    echo ""

    for i in $(seq 0 $((pkg_count - 1))); do
        local name source priority apt_pkg binary symlink
        local github_repo github_asset extract_to version_pin

        name=$(jq -r ".packages[$i].name" "$MANIFEST")
        source=$(jq -r ".packages[$i].source" "$MANIFEST")
        priority=$(jq -r ".packages[$i].priority" "$MANIFEST")

        # Priority filter
        case "$filter" in
            core)
                [ "$priority" != "core" ] && continue
                ;;
            standard)
                [ "$priority" = "optional" ] && continue
                ;;
            all)
                # Install everything
                ;;
        esac

        echo "  [$((i+1))/$pkg_count] $name ($priority, $source)"

        case "$source" in
            apt)
                apt_pkg=$(jq -r ".packages[$i].apt_package" "$MANIFEST")
                binary=$(jq -r ".packages[$i].binary // empty" "$MANIFEST")
                symlink=$(jq -r ".packages[$i].symlink // empty" "$MANIFEST")

                # Handle multi-binary packages (like coreutils)
                if [ -z "$binary" ]; then
                    # Multi-binary: create symlink dir
                    local symlink_dir
                    symlink_dir=$(jq -r ".packages[$i].symlink_dir" "$MANIFEST")
                    local binaries
                    binaries=$(jq -r ".packages[$i].binaries[]" "$MANIFEST")

                    mkdir -p "$symlink_dir"
                    local all_present=true
                    for bin in $binaries; do
                        if [ -f "$bin" ]; then
                            local bn
                            bn=$(basename "$bin")
                            ln -sf "$bin" "${symlink_dir}${bn}"
                        else
                            all_present=false
                        fi
                    done
                    if [ "$all_present" = true ]; then
                        success "$name: all binaries symlinked to $symlink_dir"
                        ((INSTALLED++))
                    else
                        install_apt_package "$name" "$apt_pkg" "/usr/bin/ls" "${symlink_dir}ls"
                    fi
                else
                    install_apt_package "$name" "$apt_pkg" "$binary" "$symlink"
                fi
                ;;
            github)
                github_repo=$(jq -r ".packages[$i].github_repo" "$MANIFEST")
                github_asset=$(jq -r ".packages[$i].github_asset_pattern" "$MANIFEST")
                extract_to=$(jq -r ".packages[$i].extract_to" "$MANIFEST")
                binary=$(jq -r ".packages[$i].binary" "$MANIFEST")
                version_pin=$(jq -r ".packages[$i].version_pin // \"latest\"" "$MANIFEST")

                install_github_package "$name" "$github_repo" "$github_asset" "$extract_to" "$binary" "$version_pin"
                ;;
            *)
                warn "$name: unknown source type '$source'"
                ((FAILED++))
                ;;
        esac
    done
}

build_offline_cache() {
    local output_dir="$1"
    local output_file="$output_dir/packages.tar.zst"

    info "Building offline cache tarball..."
    info "This downloads all packages and creates a portable archive."
    echo ""

    # First, ensure everything is installed normally
    provision_packages "all"

    # Then archive the install directory
    info "Creating archive: $output_file"
    mkdir -p "$output_dir"

    if command -v zstd &>/dev/null; then
        tar cf - -C "$INSTALL_DIR" . | zstd -T0 -3 -o "$output_file"
    else
        tar czf "${output_file%.zst}.gz" -C "$INSTALL_DIR" .
        output_file="${output_file%.zst}.gz"
    fi

    local size
    size=$(du -h "$output_file" | cut -f1)
    success "Offline cache built: $output_file ($size)"
    echo ""
    echo "  Copy this file to a USB drive at: /media/jdesk-cache/packages.tar.zst"
    echo "  The provisioner will use it instead of downloading on air-gapped machines."
}

show_status() {
    echo ""
    echo "═══════════════════════════════════════════════════════"
    echo "  JDesk Provision Status"
    echo "═══════════════════════════════════════════════════════"
    echo ""

    local pkg_count
    pkg_count=$(jq '.packages | length' "$MANIFEST")
    local present=0
    local missing=0

    for i in $(seq 0 $((pkg_count - 1))); do
        local name binary symlink priority
        name=$(jq -r ".packages[$i].name" "$MANIFEST")
        binary=$(jq -r ".packages[$i].binary // empty" "$MANIFEST")
        symlink=$(jq -r ".packages[$i].symlink // empty" "$MANIFEST")
        priority=$(jq -r ".packages[$i].priority" "$MANIFEST")

        if [ -n "$binary" ] && [ -f "$binary" ]; then
            echo -e "  ${GREEN}✓${NC} $name ($priority)"
            ((present++))
        elif [ -n "$symlink" ] && [ -L "$symlink" ]; then
            echo -e "  ${GREEN}✓${NC} $name ($priority)"
            ((present++))
        else
            echo -e "  ${RED}✗${NC} $name ($priority)"
            ((missing++))
        fi
    done

    echo ""
    echo "  Total: $pkg_count | Present: $present | Missing: $missing"
    echo ""

    # Disk usage
    if [ -d "$INSTALL_DIR" ]; then
        local used
        used=$(du -sh "$INSTALL_DIR" 2>/dev/null | cut -f1)
        echo "  Disk usage: $used at $INSTALL_DIR"
    fi
    echo "═══════════════════════════════════════════════════════"
}

verify_installation() {
    info "Verifying all symlinks and binaries..."
    local issues=0

    local pkg_count
    pkg_count=$(jq '.packages | length' "$MANIFEST")

    for i in $(seq 0 $((pkg_count - 1))); do
        local name symlink binary
        name=$(jq -r ".packages[$i].name" "$MANIFEST")
        symlink=$(jq -r ".packages[$i].symlink // empty" "$MANIFEST")
        binary=$(jq -r ".packages[$i].binary // empty" "$MANIFEST")

        if [ -n "$symlink" ] && [ -L "$symlink" ]; then
            local target
            target=$(readlink "$symlink")
            if [ ! -f "$target" ]; then
                warn "$name: broken symlink $symlink → $target"
                ((issues++))
            fi
        fi

        if [ -n "$binary" ] && [ ! -f "$binary" ]; then
            warn "$name: binary missing at $binary"
            ((issues++))
        fi
    done

    if [ "$issues" -eq 0 ]; then
        success "All packages verified — no issues found"
    else
        warn "$issues issue(s) found. Run: sudo jdesk-provision"
    fi
}

# ===========================================================================
#  Main
# ===========================================================================

main() {
    local mode="standard"

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --full)        mode="all"; shift ;;
            --core-only)   mode="core"; shift ;;
            --status)      check_manifest; show_status; exit 0 ;;
            --verify)      check_manifest; verify_installation; exit 0 ;;
            --build-cache)
                shift
                local cache_out="${1:-.}"
                check_root; check_manifest; check_tools; check_space
                build_offline_cache "$cache_out"
                exit 0
                ;;
            --help|-h)
                echo "Usage: sudo jdesk-provision [OPTIONS]"
                echo ""
                echo "Options:"
                echo "  (none)         Install core + standard packages"
                echo "  --full         Install all packages (including optional)"
                echo "  --core-only    Install core packages only"
                echo "  --build-cache DIR  Build offline cache tarball"
                echo "  --status       Show current installation status"
                echo "  --verify       Verify symlinks and binaries"
                echo "  --help         This message"
                echo ""
                echo "Privilege: Grade 3 (Maintenance) per sudo_gate"
                echo "Manifest: $MANIFEST"
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    # Preflight
    check_root
    check_manifest
    check_tools
    check_space

    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  JDesk Native Application Provisioner"
    echo "  Galactic Cherry Marvell Edition 98"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    echo "  Strategy:  Script-based install from upstream repositories"
    echo "  Mode:      $mode"
    echo "  Manifest:  $MANIFEST"
    echo "  Target:    $INSTALL_DIR"
    echo "  Privilege: Grade 3 (Maintenance)"
    echo ""

    # Check for offline cache first
    if [ -f "$OFFLINE_CACHE" ]; then
        if install_from_offline_cache; then
            success "All packages restored from offline cache"
            echo ""
            show_status
            exit 0
        fi
        warn "Offline cache extraction failed — falling back to online install"
    fi

    # Update apt cache once
    info "Updating package index..."
    apt-get update -qq 2>/dev/null

    # Install packages
    provision_packages "$mode"

    # Install JDesk metadata (icons, manifests, profiles)
    echo ""
    info "Installing JDesk metadata..."
    mkdir -p "$ICONS_DIR" "$MANIFESTS_DIR" "$PROFILES_DIR"
    cp "$SCRIPT_DIR/icons/"*.svg "$ICONS_DIR/" 2>/dev/null || true
    cp "$SCRIPT_DIR/manifests/"*.jdesk-app "$MANIFESTS_DIR/" 2>/dev/null || true
    cp "$SCRIPT_DIR/profiles/"*.xml "$PROFILES_DIR/" 2>/dev/null || true
    success "Icons, manifests, and profiles installed"

    # Mark provisioning complete
    date '+%Y-%m-%d %H:%M:%S' > /opt/jdesk/.provisioned
    echo "$mode" >> /opt/jdesk/.provisioned

    # Summary
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  Provisioning Complete"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    echo -e "  Installed: ${GREEN}$INSTALLED${NC}"
    echo -e "  Skipped:   ${BLUE}$SKIPPED${NC} (already present)"
    echo -e "  Failed:    ${RED}$FAILED${NC}"
    echo ""
    echo "  All applications launch under JVM Memory Proxy:"
    echo "    java -memory-guard -Xguard:profile=<name> <binary>"
    echo ""
    echo "  Log: $LOG_FILE"
    echo "═══════════════════════════════════════════════════════════════"
}

main "$@"
