# JDesk Application Manifest: IDE
# VSCodium — open-source VS Code, native ELF binary (Electron)
#
# Format: Java Properties
# Loaded by: us.mearvk.jdesk.launcher.NativeAppLauncher

name=IDE
binary=/opt/jdesk/apps/vscodium/bin/codium
args=
icon=/opt/jdesk/icons/ide.svg
profile=ide
category=development
desktop=true
panel=true

# Resource governance (Memory Proxy)
ram-soft=1g
ram-hard=4g
cpu=90
threads=128
disk-write=500m
