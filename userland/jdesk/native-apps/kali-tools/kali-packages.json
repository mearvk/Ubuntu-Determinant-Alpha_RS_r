{
  "title": "JDesk Kali Security Tools — Core Pentest Package",
  "version": "1.0",
  "date": "2026-08-10",
  "author": "MEARVK LLC",
  "license": "GPL-2.0 (wrapper); individual tools retain their upstream licenses",

  "description": "The most important Kali Linux penetration testing and security auditing tools, packaged for JDesk terminal interpretation. 250MB budget. These are the tools a professional pentester reaches for first.",

  "budget_mb": 250,
  "install_dir": "/opt/jdesk/apps/kali",
  "bin_dir": "/opt/jdesk/apps/kali/bin",
  "path_integration": true,
  "jdesk_profile": "kali-security",

  "categories": {
    "recon": "Information gathering, network discovery, OSINT",
    "vuln": "Vulnerability scanning and assessment",
    "exploit": "Exploitation frameworks and tools",
    "password": "Password cracking, hash analysis, brute-force",
    "wireless": "WiFi auditing, wireless protocol analysis",
    "web": "Web application testing, directory enumeration",
    "network": "Network analysis, sniffing, MITM",
    "post-exploit": "Post-exploitation, privilege escalation, persistence",
    "forensics": "Digital forensics, disk analysis, memory analysis",
    "util": "Supporting utilities"
  },

  "tools": [
    {
      "name": "nmap",
      "category": "recon",
      "priority": 1,
      "description": "Network discovery and security auditing. The gold standard port scanner.",
      "source": "apt",
      "apt_package": "nmap",
      "binary": "/usr/bin/nmap",
      "size_mb": 25,
      "license": "NPSL",
      "critical": true
    },
    {
      "name": "masscan",
      "category": "recon",
      "priority": 2,
      "description": "Fastest Internet-wide port scanner. Transmits 10M packets/sec.",
      "source": "apt",
      "apt_package": "masscan",
      "binary": "/usr/bin/masscan",
      "size_mb": 2,
      "license": "AGPL-3.0",
      "critical": true
    },
    {
      "name": "netcat",
      "category": "network",
      "priority": 1,
      "description": "TCP/UDP swiss army knife. Connections, listeners, port forwarding.",
      "source": "apt",
      "apt_package": "ncat",
      "binary": "/usr/bin/ncat",
      "size_mb": 1,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "nikto",
      "category": "web",
      "priority": 2,
      "description": "Web server scanner. Checks for dangerous files, outdated versions, misconfigs.",
      "source": "apt",
      "apt_package": "nikto",
      "binary": "/usr/bin/nikto",
      "size_mb": 5,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "sqlmap",
      "category": "web",
      "priority": 1,
      "description": "Automatic SQL injection and database takeover tool.",
      "source": "github",
      "github_repo": "sqlmapproject/sqlmap",
      "install_method": "git-clone",
      "binary": "python3 /opt/jdesk/apps/kali/sqlmap/sqlmap.py",
      "wrapper_script": true,
      "size_mb": 15,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "hydra",
      "category": "password",
      "priority": 1,
      "description": "Fast and flexible online password cracker. 50+ protocols supported.",
      "source": "apt",
      "apt_package": "hydra",
      "binary": "/usr/bin/hydra",
      "size_mb": 4,
      "license": "AGPL-3.0",
      "critical": true
    },
    {
      "name": "john",
      "category": "password",
      "priority": 1,
      "description": "John the Ripper — offline password hash cracker. Supports 300+ hash types.",
      "source": "apt",
      "apt_package": "john",
      "binary": "/usr/bin/john",
      "size_mb": 20,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "hashcat",
      "category": "password",
      "priority": 2,
      "description": "GPU-accelerated password recovery. World's fastest hash cracker.",
      "source": "apt",
      "apt_package": "hashcat",
      "binary": "/usr/bin/hashcat",
      "size_mb": 15,
      "license": "MIT",
      "critical": true
    },
    {
      "name": "metasploit-framework",
      "category": "exploit",
      "priority": 1,
      "description": "The exploit framework. 2000+ exploits, payloads, auxiliaries, post modules.",
      "source": "github",
      "github_repo": "rapid7/metasploit-framework",
      "install_method": "installer-script",
      "installer_url": "https://raw.githubusercontent.com/rapid7/metasploit-omnibus/master/config/templates/metasploit-framework-wrappers/msfupdate.erb",
      "binary": "/opt/jdesk/apps/kali/metasploit/msfconsole",
      "wrapper_script": true,
      "size_mb": 80,
      "license": "BSD-3-Clause",
      "critical": true,
      "notes": "Largest single tool. Worth the budget alone."
    },
    {
      "name": "aircrack-ng",
      "category": "wireless",
      "priority": 1,
      "description": "WiFi security auditing suite. WEP/WPA/WPA2 cracking, monitoring, injection.",
      "source": "apt",
      "apt_package": "aircrack-ng",
      "binary": "/usr/bin/aircrack-ng",
      "binaries": ["/usr/bin/aircrack-ng", "/usr/bin/airodump-ng", "/usr/bin/aireplay-ng", "/usr/bin/airmon-ng"],
      "size_mb": 8,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "wireshark-cli",
      "category": "network",
      "priority": 1,
      "description": "Network protocol analyzer (CLI: tshark). Deep packet inspection.",
      "source": "apt",
      "apt_package": "tshark",
      "binary": "/usr/bin/tshark",
      "size_mb": 15,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "tcpdump",
      "category": "network",
      "priority": 1,
      "description": "Command-line packet analyzer. Lightweight, fast, everywhere.",
      "source": "apt",
      "apt_package": "tcpdump",
      "binary": "/usr/bin/tcpdump",
      "size_mb": 2,
      "license": "BSD-3-Clause",
      "critical": true
    },
    {
      "name": "gobuster",
      "category": "web",
      "priority": 2,
      "description": "Directory/file/DNS brute-forcer. Fast, written in Go.",
      "source": "apt",
      "apt_package": "gobuster",
      "binary": "/usr/bin/gobuster",
      "size_mb": 8,
      "license": "Apache-2.0",
      "critical": true
    },
    {
      "name": "dirb",
      "category": "web",
      "priority": 3,
      "description": "Web content scanner. Dictionary-based directory discovery.",
      "source": "apt",
      "apt_package": "dirb",
      "binary": "/usr/bin/dirb",
      "size_mb": 3,
      "license": "GPL-2.0",
      "critical": false
    },
    {
      "name": "wfuzz",
      "category": "web",
      "priority": 3,
      "description": "Web application fuzzer. Parameter discovery, brute-force, injection.",
      "source": "pip",
      "pip_package": "wfuzz",
      "binary": "/opt/jdesk/apps/kali/venv/bin/wfuzz",
      "size_mb": 5,
      "license": "GPL-2.0",
      "critical": false
    },
    {
      "name": "burpsuite-community",
      "category": "web",
      "priority": 2,
      "description": "Web application security testing platform. Proxy, scanner, intruder.",
      "source": "direct",
      "download_url": "https://portswigger.net/burp/releases/download",
      "binary": "java -jar /opt/jdesk/apps/kali/burpsuite/burpsuite_community.jar",
      "wrapper_script": true,
      "size_mb": 0,
      "license": "Proprietary (Community Edition: free)",
      "critical": false,
      "notes": "Skipped in 250MB budget. User can add with --install burpsuite"
    },
    {
      "name": "responder",
      "category": "network",
      "priority": 2,
      "description": "LLMNR/NBT-NS/MDNS poisoner. Credential harvesting on local networks.",
      "source": "github",
      "github_repo": "lgandx/Responder",
      "install_method": "git-clone",
      "binary": "python3 /opt/jdesk/apps/kali/responder/Responder.py",
      "wrapper_script": true,
      "size_mb": 3,
      "license": "GPL-3.0",
      "critical": true
    },
    {
      "name": "impacket",
      "category": "post-exploit",
      "priority": 1,
      "description": "Python classes for working with network protocols. SMB, MSRPC, NTLM, Kerberos.",
      "source": "pip",
      "pip_package": "impacket",
      "binaries_pattern": "/opt/jdesk/apps/kali/venv/bin/impacket-*",
      "key_binaries": ["impacket-smbexec", "impacket-psexec", "impacket-wmiexec", "impacket-secretsdump", "impacket-getTGT", "impacket-GetNPUsers"],
      "size_mb": 12,
      "license": "Apache-2.0",
      "critical": true
    },
    {
      "name": "enum4linux-ng",
      "category": "recon",
      "priority": 2,
      "description": "Linux alternative to enum4linux. SMB/NetBIOS enumeration.",
      "source": "pip",
      "pip_package": "enum4linux-ng",
      "binary": "/opt/jdesk/apps/kali/venv/bin/enum4linux-ng",
      "size_mb": 2,
      "license": "GPL-3.0",
      "critical": false
    },
    {
      "name": "crackmapexec",
      "category": "post-exploit",
      "priority": 1,
      "description": "Swiss army knife for pentesting Windows/AD environments. SMB, WinRM, LDAP, MSSQL.",
      "source": "pip",
      "pip_package": "crackmapexec",
      "binary": "/opt/jdesk/apps/kali/venv/bin/crackmapexec",
      "size_mb": 8,
      "license": "BSD-2-Clause",
      "critical": true
    },
    {
      "name": "linpeas",
      "category": "post-exploit",
      "priority": 1,
      "description": "Linux Privilege Escalation Awesome Script. Automated local enum.",
      "source": "github",
      "github_repo": "peass-ng/PEASS-ng",
      "github_asset": "linpeas.sh",
      "binary": "/opt/jdesk/apps/kali/scripts/linpeas.sh",
      "size_mb": 1,
      "license": "GPL-3.0",
      "critical": true
    },
    {
      "name": "chisel",
      "category": "network",
      "priority": 2,
      "description": "Fast TCP/UDP tunnel over HTTP. Pivoting through firewalls.",
      "source": "github",
      "github_repo": "jpillora/chisel",
      "github_asset_pattern": "chisel_*_linux_amd64.gz",
      "binary": "/opt/jdesk/apps/kali/bin/chisel",
      "size_mb": 8,
      "license": "MIT",
      "critical": true
    },
    {
      "name": "socat",
      "category": "network",
      "priority": 2,
      "description": "Multipurpose relay. Bidirectional data transfer between two channels.",
      "source": "apt",
      "apt_package": "socat",
      "binary": "/usr/bin/socat",
      "size_mb": 2,
      "license": "GPL-2.0",
      "critical": true
    },
    {
      "name": "ffuf",
      "category": "web",
      "priority": 2,
      "description": "Fast web fuzzer written in Go. Directories, parameters, vhosts.",
      "source": "github",
      "github_repo": "ffuf/ffuf",
      "github_asset_pattern": "ffuf_*_linux_amd64.tar.gz",
      "binary": "/opt/jdesk/apps/kali/bin/ffuf",
      "size_mb": 8,
      "license": "MIT",
      "critical": true
    },
    {
      "name": "seclists",
      "category": "util",
      "priority": 1,
      "description": "Collection of wordlists for fuzzing, discovery, brute-force. Essential companion to every tool above.",
      "source": "github",
      "github_repo": "danielmiessler/SecLists",
      "install_method": "partial-clone",
      "partial_dirs": ["Discovery/Web-Content", "Passwords/Common-Credentials", "Fuzzing", "Usernames"],
      "install_path": "/opt/jdesk/apps/kali/wordlists",
      "size_mb": 25,
      "license": "MIT",
      "critical": true,
      "notes": "Only core wordlists cloned to stay within budget. Full SecLists is 1GB+."
    }
  ],

  "budget_breakdown": {
    "metasploit-framework": 80,
    "nmap": 25,
    "seclists-partial": 25,
    "john": 20,
    "hashcat": 15,
    "wireshark-cli": 15,
    "sqlmap": 15,
    "impacket": 12,
    "aircrack-ng": 8,
    "gobuster": 8,
    "chisel": 8,
    "ffuf": 8,
    "crackmapexec": 8,
    "hydra": 4,
    "nikto": 5,
    "wfuzz": 5,
    "responder": 3,
    "dirb": 3,
    "masscan": 2,
    "socat": 2,
    "tcpdump": 2,
    "enum4linux-ng": 2,
    "netcat": 1,
    "linpeas": 1,
    "total_estimated_mb": 247
  },

  "jdesk_terminal_integration": {
    "path_append": "/opt/jdesk/apps/kali/bin:/opt/jdesk/apps/kali/venv/bin",
    "alias_file": "/opt/jdesk/apps/kali/kali-aliases.sh",
    "interpreter_mode": "All Kali binaries are executable via JDesk terminal. The terminal's PATH is extended at session init. Wrapper scripts handle Python-based tools transparently.",
    "memory_proxy_profile": "kali-security"
  }
}
