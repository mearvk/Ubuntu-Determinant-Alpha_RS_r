{
  "title": "JDesk Native Application Package Manifest",
  "version": "1.0",
  "date": "2026-08-10",
  "author": "MEARVK LLC",
  "license": "GPL-2.0",

  "strategy": "script-install-at-first-boot",
  "rationale": "Binaries are NOT stored in the git repository. They are provisioned at install time from upstream package repos and verified downloads. This avoids GitHub LFS limits (repo is 46 GB+), ensures current versions, and keeps the distribution reproducible via pinned versions.",

  "privileges": {
    "minimum_grade": 3,
    "invocation": "sudo jdesk-provision",
    "notes": "Grade 3 (Maintenance) per sudo_gate. Installs packages, creates dirs, writes to /opt. No Grade 7+ needed — this is normal package installation."
  },

  "install_dir": "/opt/jdesk/apps",
  "cache_dir": "/opt/jdesk/.cache",
  "allocation_mb": 3072,

  "sources": {
    "apt": "Ubuntu 24.04 (US Treasury & MEARVK LLC) repositories",
    "github": "GitHub Releases (tarball, AppImage)",
    "direct": "Verified HTTPS download with SHA-256 check"
  },

  "packages": [
    {
      "name": "LibreOffice Writer",
      "id": "writer",
      "category": "office",
      "priority": "core",
      "source": "apt",
      "apt_package": "libreoffice-writer",
      "binary": "/usr/bin/soffice",
      "symlink": "/opt/jdesk/apps/libreoffice/soffice",
      "size_mb": 350,
      "format": "ELF",
      "profile": "writer",
      "icon": "writer.svg",
      "license": "MPL-2.0"
    },
    {
      "name": "VSCodium",
      "id": "ide",
      "category": "development",
      "priority": "core",
      "source": "github",
      "github_repo": "VSCodium/vscodium",
      "github_asset_pattern": "VSCodium-linux-x64-*.tar.gz",
      "version_pin": "latest",
      "extract_to": "/opt/jdesk/apps/vscodium",
      "binary": "/opt/jdesk/apps/vscodium/codium",
      "size_mb": 300,
      "format": "ELF",
      "profile": "ide",
      "icon": "ide.svg",
      "license": "MIT",
      "sha256_verify": true
    },
    {
      "name": "Chromium",
      "id": "browser",
      "category": "internet",
      "priority": "core",
      "source": "apt",
      "apt_package": "chromium-browser",
      "binary": "/usr/bin/chromium-browser",
      "symlink": "/opt/jdesk/apps/chromium/chrome",
      "size_mb": 180,
      "format": "ELF",
      "profile": "browser",
      "icon": "browser.svg",
      "license": "BSD-3-Clause"
    },
    {
      "name": "PCManFM-Qt",
      "id": "files",
      "category": "system",
      "priority": "core",
      "source": "apt",
      "apt_package": "pcmanfm-qt",
      "binary": "/usr/bin/pcmanfm-qt",
      "symlink": "/opt/jdesk/apps/pcmanfm/pcmanfm-qt",
      "size_mb": 45,
      "format": "ELF",
      "profile": "files",
      "icon": "files.svg",
      "license": "GPL-2.0"
    },
    {
      "name": "Bash",
      "id": "bash",
      "category": "system",
      "priority": "core",
      "source": "apt",
      "apt_package": "bash",
      "binary": "/usr/bin/bash",
      "symlink": "/opt/jdesk/apps/terminal/bash",
      "size_mb": 2,
      "format": "ELF",
      "profile": "terminal",
      "icon": "terminal.svg",
      "license": "GPL-3.0",
      "notes": "Already installed on all Ubuntu systems — symlink only"
    },
    {
      "name": "OpenSSH Client",
      "id": "ssh",
      "category": "network",
      "priority": "core",
      "source": "apt",
      "apt_package": "openssh-client",
      "binary": "/usr/bin/ssh",
      "symlink": "/opt/jdesk/apps/network/ssh",
      "size_mb": 5,
      "format": "ELF",
      "profile": "terminal",
      "icon": "network.svg",
      "license": "BSD-2-Clause"
    },
    {
      "name": "Telnet",
      "id": "telnet",
      "category": "network",
      "priority": "standard",
      "source": "apt",
      "apt_package": "telnet",
      "binary": "/usr/bin/telnet",
      "symlink": "/opt/jdesk/apps/network/telnet",
      "size_mb": 1,
      "format": "ELF",
      "profile": "terminal",
      "icon": "network.svg",
      "license": "BSD-3-Clause"
    },
    {
      "name": "GNU Coreutils",
      "id": "coreutils",
      "category": "system",
      "priority": "core",
      "source": "apt",
      "apt_package": "coreutils",
      "binaries": ["/usr/bin/ls", "/usr/bin/cp", "/usr/bin/mv", "/usr/bin/cat", "/usr/bin/mkdir", "/usr/bin/rm", "/usr/bin/chmod", "/usr/bin/chown"],
      "symlink_dir": "/opt/jdesk/apps/coreutils/",
      "size_mb": 15,
      "format": "ELF",
      "profile": "terminal",
      "license": "GPL-3.0",
      "notes": "Always present on Ubuntu — symlinks only, no download"
    },
    {
      "name": "Git",
      "id": "git",
      "category": "development",
      "priority": "standard",
      "source": "apt",
      "apt_package": "git",
      "binary": "/usr/bin/git",
      "symlink": "/opt/jdesk/apps/development/git",
      "size_mb": 40,
      "format": "ELF",
      "profile": "terminal",
      "icon": "development.svg",
      "license": "GPL-2.0"
    },
    {
      "name": "cURL",
      "id": "curl",
      "category": "network",
      "priority": "standard",
      "source": "apt",
      "apt_package": "curl",
      "binary": "/usr/bin/curl",
      "symlink": "/opt/jdesk/apps/network/curl",
      "size_mb": 3,
      "format": "ELF",
      "profile": "terminal",
      "license": "MIT"
    },
    {
      "name": "Wine",
      "id": "wine",
      "category": "runtime",
      "priority": "optional",
      "source": "apt",
      "apt_package": "wine64",
      "binary": "/usr/bin/wine64",
      "symlink": "/opt/jdesk/apps/runtimes/wine",
      "size_mb": 400,
      "format": "ELF",
      "profile": "windows-app",
      "license": "LGPL-2.1",
      "notes": "Required only for Windows PE binary execution"
    },
    {
      "name": "Kali Security Tools",
      "id": "kali",
      "category": "security",
      "priority": "standard",
      "source": "script",
      "install_script": "kali-tools/kali-provision",
      "binary": "/opt/jdesk/apps/kali/nmap",
      "symlink": "/opt/jdesk/apps/kali/nmap",
      "size_mb": 250,
      "format": "ELF",
      "profile": "terminal",
      "icon": "kali.svg",
      "license": "GPL-2.0",
      "notes": "Penetration testing toolkit: nmap, nikto, sqlmap, john, hydra, aircrack-ng"
    },
    {
      "name": "GIMP",
      "id": "gimp",
      "category": "graphics",
      "priority": "standard",
      "source": "apt",
      "apt_package": "gimp",
      "binary": "/usr/bin/gimp",
      "symlink": "/opt/jdesk/apps/graphics/gimp",
      "size_mb": 120,
      "format": "ELF",
      "profile": "writer",
      "icon": "graphics.svg",
      "license": "GPL-3.0"
    },
    {
      "name": "VLC Media Player",
      "id": "vlc",
      "category": "media",
      "priority": "standard",
      "source": "apt",
      "apt_package": "vlc",
      "binary": "/usr/bin/vlc",
      "symlink": "/opt/jdesk/apps/media/vlc",
      "size_mb": 90,
      "format": "ELF",
      "profile": "browser",
      "icon": "media.svg",
      "license": "GPL-2.0"
    }
  ],

  "priority_classes": {
    "core": "Installed automatically at first boot. JDesk will not start without these.",
    "standard": "Installed automatically at first boot. JDesk starts without them but they are expected.",
    "optional": "Installed on user request or via jdesk-provision --full. Desktop icon appears only when present."
  },

  "offline_cache": {
    "enabled": true,
    "method": "USB cache tarball",
    "path": "/media/jdesk-cache/packages.tar.zst",
    "notes": "If /media/jdesk-cache/ contains a pre-built tarball (from a machine with internet), the provisioner uses it instead of downloading. Built with: jdesk-provision --build-cache /path/to/output.tar.zst"
  }
}
