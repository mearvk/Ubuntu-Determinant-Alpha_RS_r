<?xml version="1.0" encoding="UTF-8"?>
<!--
  jvm-config.xml - JVM Start Flags Configuration
  Ubuntu Determinant Alpha RS - Galactic Cherry Marvell Edition 98

  Location: $JAVA_HOME/conf/jvm-config.xml or /etc/jvm-config.xml
  Security: Must be owned by root or launching user, not world-writable.
  Optional: Add signature="sha256:<hex>" to jvm-config element for integrity.

  Copyright (C) 2026 MEARVK LLC
-->
<jvm-config version="1">

  <!-- JVM Flags (equivalent to -XX:Name=Value on command line) -->
  <flags>
    <!-- Memory -->
    <flag name="MaxHeapSize" value="4g"/>
    <flag name="InitialHeapSize" value="512m"/>
    <flag name="MaxMetaspaceSize" value="512m"/>
    <flag name="UseCompressedOops" value="true"/>

    <!-- Garbage Collection -->
    <flag name="UseG1GC" value="true"/>
    <flag name="MaxGCPauseMillis" value="200"/>
    <flag name="G1HeapRegionSize" value="4m"/>
    <flag name="GCTimeRatio" value="12"/>
    <flag name="ParallelGCThreads" value="4"/>
    <flag name="ConcGCThreads" value="2"/>

    <!-- JIT Compilation -->
    <flag name="TieredCompilation" value="true"/>
    <flag name="CompileThreshold" value="5000"/>

    <!-- Diagnostics -->
    <flag name="NativeMemoryTracking" value="summary"/>
    <flag name="HeapDumpOnOutOfMemoryError" value="true"/>
    <flag name="HeapDumpPath" value="/var/log/jvm"/>

    <!-- Security -->
    <flag name="UseSecureRandom" value="true"/>
  </flags>

  <!-- System Properties (equivalent to -Dname=value) -->
  <system-properties>
    <property name="java.io.tmpdir" value="/var/tmp/jvm"/>
    <property name="file.encoding" value="UTF-8"/>
    <property name="java.net.preferIPv4Stack" value="false"/>
    <property name="jdk.tls.ephemeralDHKeySize" value="2048"/>
  </system-properties>

  <!-- Classpath Entries (appended to system classpath) -->
  <classpath>
    <!-- <entry path="/opt/app/lib/*"/> -->
    <!-- <entry path="/opt/app/conf"/> -->
  </classpath>

  <!-- Class Load Guard: quantity and quality controls -->
  <class-load-guard enabled="true" policy="warn">
    <!-- Global ceiling: max classes the JVM will load from application code -->
    <global-max value="5000"/>
    <!-- Grade threshold: grades below (Main - threshold) face stricter limits -->
    <threshold value="3"/>
    <!-- Per-grade maximums -->
    <grade name="Manager" max="100"/>
    <grade name="Archetype" max="200"/>
    <grade name="Builder" max="150"/>
    <grade name="Inheritor" max="500"/>
    <grade name="Gainer" max="300"/>
    <grade name="Substitute" max="200"/>
    <grade name="Ungraded" max="2000"/>
  </class-load-guard>

</jvm-config>
