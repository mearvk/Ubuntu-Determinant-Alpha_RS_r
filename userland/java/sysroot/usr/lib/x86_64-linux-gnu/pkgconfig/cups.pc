prefix=/usr
exec_prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

cups_api_version="2.4"
cups_build="cups-2.4.7"
cups_datadir=/usr/share/cups
cups_serverbin=/usr/lib/cups
cups_serverroot=/etc/cups

Name: CUPS
Description: CUPS API Library
Version: 2.4.7
URL: https://openprinting.github.io/cups/
Cflags:  -I${prefix}/include
Libs: -L${prefix}/lib/x86_64-linux-gnu -lcups

Requires.private:  gnutls avahi-client
Libs.private:  -lz -L/usr/lib/x86_64-linux-gnu/mit-krb5 -Wl,-Bsymbolic-functions -flto=auto -ffat-lto-objects -Wl,-z,relro -lgssapi_krb5 -lkrb5 -lk5crypto -lcom_err
