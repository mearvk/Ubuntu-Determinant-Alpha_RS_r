<?xml version="1.0" encoding="UTF-8"?>
<!-- Declarative preview model; does not modify the host filesystem. -->
<ubuntuWhiteDesktop version="1.0">
  <wallpaper path="images/mediate-ubuntu-white-edition-001.jpeg"/>
  <desktop fullscreen="true" exitKeys="ESC,CTRL+TAB">
    <folder name="Desktop" path="/home/user/Desktop" icon="folder-desktop"/>
    <folder name="Documents" path="/home/user/Documents" icon="folder-documents"/>
    <folder name="Downloads" path="/home/user/Downloads" icon="folder-downloads"/>
    <folder name="Music" path="/home/user/Music" icon="folder-music"/>
    <folder name="Pictures" path="/home/user/Pictures" icon="folder-pictures"/>
    <folder name="Public" path="/home/user/Public" icon="folder-public"/>
    <folder name="Templates" path="/home/user/Templates" icon="folder-templates"/>
    <folder name="Videos" path="/home/user/Videos" icon="folder-videos"/>
    <folder name="Trash" path="trash:///" icon="folder-trash"/>
  </desktop>
  <assets source="../ubuntu-white/icons"/>
</ubuntuWhiteDesktop>
