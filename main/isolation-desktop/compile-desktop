#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"
mkdir -p build
if [ -x ./gradlew ]; then
    exec ./gradlew clean build
fi
if command -v gradle >/dev/null 2>&1; then
    exec gradle clean build
fi
echo "Gradle is required to compile the Ubuntu White Desktop Preview." >&2
exit 3
