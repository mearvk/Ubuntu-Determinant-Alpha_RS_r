#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUILD="$ROOT/build"
SRC="$ROOT/src"

mkdir -p "$BUILD"

if [ ! -d "$SRC" ]; then
    echo "Ubuntu White Isolation Desktop: source directory is $SRC" >&2
    echo "Add desktop source there before compiling." >&2
    exit 2
fi

if [ -x "$ROOT/gradlew" ]; then
    exec "$ROOT/gradlew" clean build
fi

if [ -f "$ROOT/pom.xml" ] && command -v mvn >/dev/null 2>&1; then
    exec mvn -f "$ROOT/pom.xml" clean package
fi

if [ -f "$ROOT/build.gradle" ] && command -v gradle >/dev/null 2>&1; then
    exec gradle -p "$ROOT" clean build
fi

echo "No desktop build configuration found." >&2
echo "Provide a Gradle wrapper, pom.xml, or build.gradle in $ROOT." >&2
exit 3
