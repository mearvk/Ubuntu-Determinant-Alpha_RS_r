#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VERSION="9.7.1"
cd "$ROOT"
mkdir -p build

if [ -x "$ROOT/.gradle-dist/gradle-$VERSION/bin/gradle" ]; then
    exec "$ROOT/.gradle-dist/gradle-$VERSION/bin/gradle" clean build
fi

if [ -x ./gradlew ]; then
    exec ./gradlew clean build
fi

if command -v gradle >/dev/null 2>&1; then
    exec gradle clean build
fi

echo "Gradle has not been provisioned. Run ./bootstrap-gradle or make." >&2
exit 3
