#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUILD="$ROOT/build"

if [ ! -d "$BUILD" ]; then
    echo "Desktop preview has not been compiled. Run ./compile-desktop first." >&2
    exit 2
fi

# Locate a conventional JavaFX/JVM application artifact without assuming a
# particular project layout. A concrete launcher can be selected by the GUI
# project once its main class/application name is established.
for candidate in "$BUILD"/*.jar "$BUILD"/libs/*.jar; do
    if [ -f "$candidate" ]; then
        exec java -jar "$candidate"
    fi
done

echo "No runnable desktop artifact found in $BUILD." >&2
exit 3
