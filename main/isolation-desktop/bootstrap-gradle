#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER="$ROOT/gradlew"

if [ -x "$WRAPPER" ]; then
    exit 0
fi

if command -v gradle >/dev/null 2>&1; then
    echo "Gradle found; generating the project wrapper."
    cd "$ROOT"
    gradle wrapper
    chmod +x "$WRAPPER"
    exit 0
fi

echo "Gradle is required to bootstrap the Ubuntu White Desktop Preview." >&2
echo "Install Gradle once, then run: ./bootstrap-gradle" >&2
echo "After the wrapper is generated, future builds use ./gradlew." >&2
exit 3
