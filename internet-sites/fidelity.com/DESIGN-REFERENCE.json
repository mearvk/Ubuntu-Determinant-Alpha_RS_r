    "digital_services": "//digital.fidelity.com/ctgw/digital/",
    "fonts": "https://assets.fidelity.com/fonts/"
  },

  "key_patterns": {
    "cta_buttons": "Green primary (#368727), large rounded, full-width on mobile",
    "cards": "White background, subtle shadow, rounded corners, icon-led",
    "section_spacing": "Large vertical padding between sections",
    "footer": "Dark background, multi-column link grid, social icons row",
    "accessibility": "Skip-to-content, ARIA labels, high contrast text"
  }
