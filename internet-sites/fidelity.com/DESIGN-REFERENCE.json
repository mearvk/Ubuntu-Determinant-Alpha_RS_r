{
  "site": "fidelity.com",
  "captured": "2026-08-19",
  "purpose": "Base model reference for look and feel",

  "framework": {
    "frontend": "Angular 19.2.25",
    "rendering": "Server-side + client hydration",
    "component_prefix": "_ngcontent-ng-c*",
    "design_system": "FDS (Fidelity Design System)",
    "build": "Minified bundles with content hashes"
  },

  "typography": {
    "primary_font": "Fidelity Sans",
    "secondary_font": "Fidelity Slab",
    "fallback": "system-ui, -apple-system, sans-serif",
    "css_variable": "--fds-text-family, --fds-family-sans",
    "font_files": [
      "https://assets.fidelity.com/fonts/FidelitySans-Regular.woff2",
      "https://assets.fidelity.com/fonts/FidelitySans-Bold.woff2",
      "https://assets.fidelity.com/fonts/FidelitySans-Demibold.woff2",
      "https://assets.fidelity.com/fonts/fidelity-slab/FidelitySlabVAR-UprightVF-e1619e.woff2"
    ],
    "weights": ["Regular (400)", "Demibold (600)", "Bold (700)"],
    "slab_type": "Variable font (VF)"
  },

  "color_palette": {
    "primary_green": "#368727",
    "dark_green": "#1e6f1d",
    "forest_green": "#0F5319",
    "teal": "#009681",
    "dark_teal": "#058070",
    "primary_blue": "#3266E0",
    "dark_blue": "#132454",
    "navy": "#1D3986",
    "sky_blue": "#0799D9",
    "light_blue": "#29BBF7",
    "white": "#FFFFFF",
    "off_white": "#FBFAF3",
    "background_default": "#FFFFFF",
    "text_dark": "#141414",
    "text_secondary": "#403F3E",
    "text_tertiary": "#525150",
    "black": "#000000",
    "error_red": "#FA3939",
    "warning_orange": "#FF8210",
    "success_green": "#48AC36",
    "aqua_accent": "#04C8A8",
    "aqua_light": "#1DE4CA",
    "purple": "#3A1664",
    "pink": "#FD27E5",
    "gold": "#FFCA1F",
    "disabled_bg": "#F0F0F0"
  },

  "css_design_tokens": {
    "prefix": "--fds-",
    "categories": [
      "action (background, foreground, stroke, weight)",
      "avatar (background, foreground, gap, height, padding, radius, stroke, width)",
      "colors: aqua, blue, green, neutral, orange, pink, purple, red, teal, yellow (50-900 scale)",
      "background-default",
      "text-family, family-sans"
    ],
    "button_states": ["default", "hover", "active", "focus", "disabled"],
    "animation": {
      "transition_duration": "0.48s",
      "transition_ease": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },

  "layout": {
    "approach": "Responsive, mobile-first",
    "viewport_meta": "width=device-width, initial-scale=1",
    "box_sizing": "border-box (universal)",
    "hero_section": "Full-width background image with overlay text",
    "card_layout": "3-feature cards with icon + title + description",
    "sections": [
      "Hero banner (background image, CTA buttons)",
      "Product offerings (tabbed cards: Brokerage, Roth IRA, HSA, 529)",
      "Wealth management feature (image + text)",
      "Why choose Fidelity (bullet points)",
      "Looking for something else (interactive selector)",
      "Footer (links grid, social icons, legal)"
    ]
  },

  "stylesheets": [
    "//digital.fidelity.com/ctgw/digital/prelogin/styles-QGQ3MRSP.css",
    "https://digital.fidelity.com/ctgw/digital/search/client/smartSuggestStyles.css",
    "https://www.fidelity.com/bin-public/060_www_fidelity_com/css/global-seo-standalone-footer-06.18.min.css"
  ],

  "javascript": [
    "https://digital.fidelity.com/ctgw/digital/search/client/smartSuggest.js",
    "https://www.fidelity.com/bin-public/060_www_fidelity_com/js/global-seo-standalone-footer-06-18.min.js",
    "//digital.fidelity.com/ctgw/digital/prelogin/polyfills-5CFQRCPP.js",
    "//digital.fidelity.com/ctgw/digital/prelogin/scripts-N7XQXSJC.js",
    "//digital.fidelity.com/ctgw/digital/prelogin/main-TLINBR47.js"
  ],

  "navigation": {
    "type": "Mega dropdown menu",
    "top_level": ["Accounts & Trade", "Investing", "Retirement", "Wealth Management", "News & Research"],
    "features": ["Skip to content link", "Search suggest", "Login CTA", "Open account CTA"],
    "mobile": "Hamburger menu with full navigation tree"
  },

  "hero_images": [
    "https://www.fidelity.com/bin-public/600_Fidelity_Com_English/images/homepage/hero-images/in-market-HP-banner-mountain-3.jpg"
