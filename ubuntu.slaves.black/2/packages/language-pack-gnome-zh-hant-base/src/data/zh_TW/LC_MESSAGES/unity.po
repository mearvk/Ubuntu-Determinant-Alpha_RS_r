msgid "Automaximize Value"
msgstr "自動最大化值"

#: ../plugins/unityshell/unityshell.xml.in.h:32
msgid "The minimum value to trigger automaximize."
msgstr "觸發自動最大化的最小值。"

#: ../plugins/unityshell/unityshell.xml.in.h:33
msgid "Enable Shortcut Hints Overlay"
msgstr "啟用捷徑提示覆蓋層"

