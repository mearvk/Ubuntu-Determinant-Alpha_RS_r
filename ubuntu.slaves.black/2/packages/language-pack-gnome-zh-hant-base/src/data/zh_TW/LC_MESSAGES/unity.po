msgid "Type of blur in the Dash."
msgstr "Dash 的模糊類型"

#: ../plugins/unityshell/unityshell.xml.in.h:28
msgid "No Blur"
msgstr "不模糊"

#: ../plugins/unityshell/unityshell.xml.in.h:29
msgid "Static Blur"
msgstr "靜態模糊"

#: ../plugins/unityshell/unityshell.xml.in.h:30
msgid "Active Blur"
msgstr "動態模糊"

