msgstr "顯示所有檔案的除錯資訊"

#: src/gcm-debug.c:128
msgid "Debugging Options"
msgstr "除錯選項"

#: src/gcm-debug.c:128
msgid "Show debugging options"
msgstr "顯示除錯選項"

