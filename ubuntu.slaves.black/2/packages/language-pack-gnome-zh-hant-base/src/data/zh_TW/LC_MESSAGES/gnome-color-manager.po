#: src/gcm-cell-renderer-profile-text.c:57
msgid "No profile"
msgstr "沒有描述檔"

#: src/gcm-cell-renderer-profile-text.c:73
#, c-format
msgid "Default %s"
msgstr "預設值 %s"

