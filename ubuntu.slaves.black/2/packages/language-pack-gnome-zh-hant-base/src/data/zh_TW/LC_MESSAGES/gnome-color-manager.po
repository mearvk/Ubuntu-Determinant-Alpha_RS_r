#: src/gcm-viewer.ui:138
msgid "Created"
msgstr "建立於"

#. The version of the profile
#: src/gcm-viewer.ui:155
msgid "Version"
msgstr "版本"

#. The manufacturer of the profile
#: src/gcm-viewer.ui:172
msgid "Manufacturer"
