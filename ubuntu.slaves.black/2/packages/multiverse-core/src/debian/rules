#!/usr/bin/make -f

%:
	dh $@ --buildsystem=gradle --with javahelper --with maven_repo_helper

override_dh_auto_build:
	dh_auto_build -- --project-prop finalRelease=true jar javadoc
  
get-orig-source:
	cd $(dir $(firstword $(MAKEFILE_LIST)))../ && \
	uscan \
		--verbose \
		--rename  \
		--no-symlink \
		--destdir $(CURDIR)      \
		--watchfile debian/watch \
		--force-download
