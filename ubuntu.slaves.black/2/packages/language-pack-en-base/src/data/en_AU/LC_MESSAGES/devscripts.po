msgid "B<--help>, B<-h>, B<-?>"
msgstr ""

#. type: textblock
#: ../scripts/hardening-check.pl:653
msgid "Print a brief help message and exit."
msgstr ""

#. type: =item
#: ../scripts/hardening-check.pl:655
msgid "B<--man>, B<-H>"
msgstr ""

#. type: textblock
#: ../scripts/hardening-check.pl:657
msgid "Print the manual page and exit."
msgstr ""

#. type: =head1
#: ../scripts/hardening-check.pl:661
msgid "RETURN VALUE"
msgstr ""

