msgstr "Auto-detected active dm device >>%s<< for data device %s.\n"

#: src/cryptsetup.c:3013
msgid "Option --skip is supported only for open of plain and loopaes devices."
msgstr ""
"Option --skip is supported only for open of plain and loop-aes devices."

#: src/cryptsetup.c:3016
msgid ""
"Option --offset with open action is only supported for plain and loopaes "
"devices."
msgstr ""
"Option --offset with open action is only supported for plain and loop-aes "
"devices."

#: src/utils_tools.c:293
#, c-format
