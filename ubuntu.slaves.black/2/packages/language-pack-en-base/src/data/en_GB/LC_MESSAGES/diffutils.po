#: src/diff.c:948
msgid ""
"  These format options provide fine-grained control over the output\n"
"    of diff, generalizing -D/--ifdef."
msgstr ""
"  These format options provide fine-grained control over the output\n"
"    of diff, generalising -D/--ifdef."

#: src/diff.c:976
msgid ""
"    --color[=WHEN]       color output; WHEN is 'never', 'always', or "
"'auto';\n"
"                           plain --color means --color='auto'"
msgstr ""
"    --color[=WHEN]       colour output; WHEN is 'never', 'always', or "
"'auto';\n"
"                           plain --color means --color='auto'"

#: src/diff.c:978
msgid ""
"    --palette=PALETTE    the colors to use when --color is active; PALETTE "
"is\n"
"                           a colon-separated list of terminfo capabilities"
msgstr ""
"    --palette=PALETTE    the colours to use when --color is active; PALETTE "
"is\n"
"                           a colon-separated list of terminfo capabilities"

#: src/diff.c:1063
#, c-format
msgid "invalid color '%s'"
msgstr "invalid colour '%s'"

#: src/sdiff.c:182
msgid "-I, --ignore-matching-lines=RE  ignore changes all whose lines match RE"
msgstr ""
"-I, --ignore-matching-lines=RE  ignore changes from all lines which match RE"

