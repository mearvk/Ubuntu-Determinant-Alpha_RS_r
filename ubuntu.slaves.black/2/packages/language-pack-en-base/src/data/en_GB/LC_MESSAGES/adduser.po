#: ../deluser:180
msgid ""
"In order to use the --remove-home, --remove-all-files, and --backup "
"features,\n"
"you need to install the `perl' package. To accomplish that, run\n"
"apt-get install perl.\n"
msgstr ""
"In order to use the --remove-home, --remove-all-files, and --backup "
"features,\n"
"you need to install the `perl' package. To accomplish that, run\n"
"apt-get install perl\n"
