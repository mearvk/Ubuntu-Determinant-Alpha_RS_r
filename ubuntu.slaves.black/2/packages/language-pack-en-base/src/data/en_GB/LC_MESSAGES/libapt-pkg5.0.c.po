#: apt-pkg/acquire-item.cc:1604
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' doesn't have the "
"component '%s' (component misspelt in sources.list?)"
msgstr ""
"Skipping acquisition of configured file '%s', as repository '%s' doesn't "
"have the component '%s' (component misspelt in sources.list?)"

#: apt-pkg/acquire-item.cc:1623
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' doesn't support "
"architecture '%s'"
msgstr ""
"Skipping acquisition of configured file '%s', as repository '%s' doesn't "
"support architecture '%s'"

#: apt-pkg/acquire-item.cc:1640
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' does not seem to "
"provide it (sources.list entry misspelt?)"
msgstr ""
"Skipping acquisition of configured file '%s', as repository '%s' does not "
"seem to provide it (sources.list entry misspelt?)"

#: apt-pkg/acquire-item.cc:1658
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' provides only "
"weak security information for it"
msgstr ""
"Skipping acquisition of configured file '%s', as repository '%s' provides "
"only weak security information for it"

#: apt-pkg/acquire-worker.cc:690
#, c-format
msgid ""
"Please insert the disc labeled: '%s' in the drive '%s' and press [Enter]."
msgstr ""
"Please insert the disc labelled: '%s' in the drive '%s' and press [Enter]."

#: apt-pkg/contrib/configuration.cc:720
#, c-format
msgid "Unrecognized type abbreviation: '%c'"
msgstr "Unrecognised type abbreviation: '%c'"

#: apt-pkg/contrib/mmap.cc:177 apt-pkg/contrib/mmap.cc:205
msgid "Unable to synchronize mmap"
msgstr "Unable to synchronise mmap"

