#: src/ui.cc:2639
msgid ""
"Cycle through the modes of the package information area: it can show the "
"package's long description, a summary of its dependency status, or an "
"analysis of why the package is required."
msgstr ""

#: src/ui.cc:2642
msgid "^Changelog"
msgstr "चेंजलाॅग"

#: src/ui.cc:2643
msgid "Display the Debian changelog of the selected package"
msgstr "निवडलेल्या पॅकेजचे डेबियन चेंजलाॅग दाखवा."

#: src/ui.cc:2650
msgid "^Examine Solution"
msgstr "उत्तराचे परिक्षण"

#: src/ui.cc:2651
msgid "Examine the currently selected solution to the dependency problems."
msgstr "डिपेंडन्सी प्रश्नावर आत्ता निवडलेल्या उत्तराचे परिक्षण करा."

#: src/ui.cc:2654
msgid "Apply ^Solution"
msgstr "उत्तर वापरा लावा."

#: src/ui.cc:2655
msgid "Perform the actions contained in the currently selected solution."
msgstr "आत्ता निवडलेल्या उत्तरावर क्रिया करण्यास सुरुवात करा."

#: src/ui.cc:2658
msgid "^Next Solution"
msgstr "पुढील उत्तर"

#: src/ui.cc:2659
msgid "Select the next solution to the dependency problems."
msgstr "डिपेंडन्सी प्रश्नाला पुढील उत्तर निवडा."

#: src/ui.cc:2662
msgid "^Previous Solution"
msgstr "मागील उत्तर"

#: src/ui.cc:2663
msgid "Select the previous solution to the dependency problems."
msgstr "डिपेंडन्सी प्रश्नाला मागील उत्तर निवडा."

#: src/ui.cc:2666
msgid "^First Solution"
msgstr "पहिले उत्तर"

#: src/ui.cc:2667
msgid "Select the first solution to the dependency problems."
msgstr "डिपेंडन्सी प्रश्नाला पहिले उत्तर निवडा."

#: src/ui.cc:2670
msgid "^Last Solution"
msgstr "शेवटचे उत्तर"

#: src/ui.cc:2671
msgid ""
"Select the last solution to the dependency problems that has been generated "
"so far."
msgstr "तयार झालेल्या डिपेंडन्सी प्रश्नाला शेवटचे उत्तर निवडा."

#: src/ui.cc:2677
msgid "Toggle ^Rejected"
msgstr "टाॅगल परतवले नापसंत"

#: src/ui.cc:2678
msgid "Toggle whether the currently selected action is rejected."
msgstr "नुकतीच निवडलेली क्रिया असंमत केली आहे का ते टाॅगल करा."

#: src/ui.cc:2682
msgid "Toggle ^Approved"
msgstr "टाॅगल संमत"

#: src/ui.cc:2683
msgid "Toggle whether the currently selected action is approved."
msgstr "टाॅगल, आत्ताच निवडलेली क्रिया संमत झाली का?"

#: src/ui.cc:2687
msgid "^View Target"
msgstr "लक्ष्य दाखवा."

#: src/ui.cc:2688
msgid "View the package which will be affected by the selected action"
msgstr "निवडलेल्या क्रियेने परिणाम केलेली पॅकेजेस दाखवा."

#: src/ui.cc:2694
msgid "Reject Breaking ^Holds"
msgstr ""

#: src/ui.cc:2696
msgid ""
"Reject all actions that would change the state of held packages or install "
"forbidden versions"
msgstr ""

#: src/ui.cc:2704
msgid "^Find"
msgstr "शोधा"

#: src/ui.cc:2705
msgid "Search forwards"
msgstr "पुढे बघा."

#: src/ui.cc:2708
msgid "^Find Backwards"
msgstr "मागे शोधा."

#: src/ui.cc:2709
msgid "Search backwards"
msgstr "मागे बघा"

#: src/ui.cc:2712
msgid "Find ^Again"
msgstr "बघा पुन्हा"

#: src/ui.cc:2713
msgid "Repeat the last search"
msgstr "मागचा शोध पुन्हा दाखवा."

#: src/ui.cc:2716
msgid "Find Again ^Backwards"
msgstr ""

#: src/ui.cc:2717
msgid "Repeat the last search in the opposite direction"
msgstr ""

#: src/ui.cc:2721
msgid "^Limit Display"
msgstr "दृष्य सिमीत करा."

#: src/ui.cc:2722
msgid "Apply a filter to the package list"
msgstr "पॅकेज यादीला गाळणी फिल्टर वापरा."

#: src/ui.cc:2725
msgid "^Un-Limit Display"
msgstr "दृष्य असिमीत"

#: src/ui.cc:2726
msgid "Remove the filter from the package list"
msgstr "पॅकेज यादीमधून गाळणी फिल्टर काढून टाका."

#: src/ui.cc:2730
msgid "Find ^Broken"
msgstr "शोधा तुटके."

#: src/ui.cc:2731
msgid "Find the next package with unsatisfied dependencies"
msgstr "असमाधानी डिपेंडन्सीजसह पुढील पॅकेज शोधा."

#: src/ui.cc:2738
msgid "^Preferences"
msgstr ""

#: src/ui.cc:2743
msgid "^UI options"
msgstr "यू आय पर्याय"

#: src/ui.cc:2744
msgid "Change the settings which affect the user interface"
msgstr "मानवी   वर परिणाम होण्यासाठी    सेटींग (मांडणी) बदला."

#: src/ui.cc:2747
msgid "^Dependency handling"
msgstr "डिपेंडन्सी हाताळणे"

#: src/ui.cc:2748
msgid "Change the settings which affect how package dependencies are handled"
msgstr "पॅकेज डिपेंडन्सीज कसे हाताळावे यासाठी सेटींग (मांडणी) बदलता येतात."

#: src/ui.cc:2751
msgid "^Miscellaneous"
msgstr "^संकीर्ण"

#: src/ui.cc:2752
msgid "Change miscellaneous program settings"
msgstr "इतर आज्ञावली मांडणी बदला."

#: src/ui.cc:2758
msgid "^Revert options"
msgstr "पुनः पर्याय"

#: src/ui.cc:2759
msgid "Reset all settings to the system defaults"
msgstr "मुलभूत प्रणालीमध्ये मांडणीची पुर्नमांडणी करा."

#: src/ui.cc:2770
msgid "^Next"
msgstr "पुढे"

#: src/ui.cc:2771
msgid "View next display"
msgstr "पुढील दृष्य दाखवा."

#: src/ui.cc:2774
msgid "^Prev"
msgstr "मागील"

#: src/ui.cc:2775
msgid "View previous display"
msgstr "मागील दृष्य दाखवा."

#: src/ui.cc:2778
msgid "^Close"
msgstr "बंद करा"

#: src/ui.cc:2779
msgid "Close this display"
msgstr "हे दृष्य बंद करा"

#: src/ui.cc:2784
msgid "New Package ^View"
msgstr "नवीन पॅकेज दृष्य"

#: src/ui.cc:2785
msgid "Create a new default package view"
msgstr "नवीन मुलभूत पॅकेज दृष्य तयार करा"

#: src/ui.cc:2788
msgid "Audit ^Recommendations"
msgstr "आॅडिट ^शिफारसी"

#: src/ui.cc:2789
msgid ""
"View packages which it is recommended that you install, but which are not "
"currently installed."
msgstr ""
"तूम्हाला सांगितलेली व तुम्ही संरचित केलेली , पण आत्ता संरचित न केलेली "
"पॅकेजेस दाखवा."

#: src/ui.cc:2792
msgid "New ^Flat Package List"
msgstr "नवीन सरळ पॅकेज यादी"

#: src/ui.cc:2793
msgid "View all the packages on the system in a single uncategorized list"
msgstr "प्रणालीत असणाऱ्या सगळ्या पॅकेजेस एका अवर्गीकृत यादीमध्ये दाखवा."

#: src/ui.cc:2796
msgid "New ^Debtags Browser"
msgstr "नवीन डेबटॅग्ज्् ब्राऊझर"

#: src/ui.cc:2798
msgid "Browse packages using Debtags data"
msgstr "डेबटॅग्ज्् डेटा वापरुन पॅकेजेस ब्राउझ करा वाचा"

#: src/ui.cc:2801
