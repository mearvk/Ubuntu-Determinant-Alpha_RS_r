#: tools/hangul.c:72
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Aufruf: %s [OPTION]... [DATEI]...\n"

#: tools/hangul.c:76
msgid ""
"Convert string into korean characters according to korean keyboard layout.\n"
"\n"
"Mandatory arguments to long options are mandatory for short options too.\n"
"  -k, --keyboard=KEYBOARDID   select keyboard layout by KEYBOARDID\n"
"  -l, --list                  list available keyboard and exit\n"
"  -i, --input=STRING          use STRING as input instead of standard input\n"
"  -o, --output=FILE           write result to FILE instead of standard "
"output\n"
"  -s, --strict-order          do not allow wrong input sequence\n"
msgstr ""
"Zeichenkette in koreanische Zeichen entsprechend der koreanischen "
"Tastaturbelegung umwandeln.\n"
"\n"
"Obligatorische Argumente für lange Optionen sind auch für kurze Optionen "
"obligatorisch.\n"
"  -k, --keyboard=KEYBOARDID wählt Tastaturlayout nach KEYBOARDID\n"
"  -l, --list Liste der verfügbaren Tastaturen und Beenden\n"
"  -i, --input=STRING verwendet STRING als Eingabe anstelle der "
"Standardeingabe\n"
"  -o, --output=FILE schreibe Ergebnis in DATEI statt in die Standardausgabe\n"
"  -s, --strict-order keine falsche Eingabereihenfolge zulassen\n"

#: tools/hangul.c:87
msgid ""
"      --help                  display this help and exit\n"
"      --version               output version information and exit\n"
msgstr ""
"      --help Diese Hilfe ausgeben und beenden\n"
"      --version Versionsinformationen ausgeben und beenden\n"

#: tools/hangul.c:92
msgid ""
"\n"
"With no FILE, or when FILE is -, read standard input.\n"
msgstr ""
"\n"
"Ohne DATEI oder wenn DATEI »-« ist, Standardeingabe lesen.\n"

#: tools/hangul.c:97
#, c-format
msgid ""
"\n"
"Examples:\n"
"  %s -i gksrmfdlqfur  Convert specified string into korean characters\n"
"                          and print them to standard output.\n"
"  %s                  Convert standard input into korean characters\n"
"                          and print them to standard output.\n"
msgstr ""
"\n"
"Beispiele:\n"
"  %s -i gksrmfdlqfur Konvertiere angegebenen String in koreanische Zeichen\n"
"                          und gebe diese auf der Standardausgabe aus.\n"
"  %s Konvertiere Standardeingabe in koreanische Zeichen\n"
"                          und gebe diese auf der Standardausgabe aus.\n"

#: tools/hangul.c:107
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Versuchen Sie »%s --help« für mehr Informationen.\n"

#: tools/hangul.c:237 tools/hangul.c:276
msgid "standard output"
msgstr "Standardausgabe"

#: tools/hangul.c:360
#, c-format
msgid "conversion from %s to UTF-8"
msgstr "Konvertierung von %s in UTF-8"
