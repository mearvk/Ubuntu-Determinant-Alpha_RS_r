msgstr "Erfolgreich"

#: src/ypbinderr_string.c:45
msgid "Internal ypbind error"
msgstr "Interner Fehler in »ypbind«"

#: src/ypbinderr_string.c:48
msgid "Domain not bound"
msgstr "Die Domain wurde nicht zugewiesen"

#: src/ypbinderr_string.c:51
msgid "System resource allocation failure"
msgstr "Fehler bei der Beschaffung einer Systemressource"

#: src/ypbinderr_string.c:54
msgid "Domain doesn't exist"
msgstr "Domain existiert nicht"

#: src/ypbinderr_string.c:57
