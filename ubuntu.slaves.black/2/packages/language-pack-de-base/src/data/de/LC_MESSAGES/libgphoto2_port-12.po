#: libgphoto2_port/gphoto2-port-info-list.c:446
msgid "Generic Port"
msgstr "Generischer Port"

#: libgphoto2_port/gphoto2-port-result.c:42
msgid "No error"
msgstr "Kein Fehler"

#: libgphoto2_port/gphoto2-port-result.c:44
msgid "Unspecified error"
msgstr "Unspezifizierter Fehler"

#: libgphoto2_port/gphoto2-port-result.c:46
msgid "I/O problem"
msgstr "I/O-Problem"

#: libgphoto2_port/gphoto2-port-result.c:48
msgid "Bad parameters"
msgstr "Falsche Parameter"

#: libgphoto2_port/gphoto2-port-result.c:50
msgid "Unsupported operation"
msgstr "Nicht unterstützte Funktion"

#: libgphoto2_port/gphoto2-port-result.c:52
msgid "Fixed limit exceeded"
msgstr "Festes Limit überschritten"

#: libgphoto2_port/gphoto2-port-result.c:54
msgid "Timeout reading from or writing to the port"
msgstr "Zeitüberschreitung beim Lesen oder Schreiben des Ports"

#: libgphoto2_port/gphoto2-port-result.c:56
msgid "Serial port not supported"
msgstr "Serieller Port nicht unterstützt"

#: libgphoto2_port/gphoto2-port-result.c:58
msgid "USB port not supported"
msgstr "USB-Port nicht unterstützt"

#: libgphoto2_port/gphoto2-port-result.c:60
msgid "Unknown port"
msgstr "Unbekannter Port"

#: libgphoto2_port/gphoto2-port-result.c:62
msgid "Out of memory"
msgstr "Kein Speicherplatz vorhanden"

#: libgphoto2_port/gphoto2-port-result.c:64
msgid "Error loading a library"
msgstr "Fehler beim Laden einer Bibliothek"

#: libgphoto2_port/gphoto2-port-result.c:66
msgid "Error initializing the port"
msgstr "Fehler beim Initialisieren des Ports"

#: libgphoto2_port/gphoto2-port-result.c:68
msgid "Error reading from the port"
msgstr "Fehler beim Lesen des Ports"

#: libgphoto2_port/gphoto2-port-result.c:70
msgid "Error writing to the port"
msgstr "Fehler beim Schreiben des Ports"

#: libgphoto2_port/gphoto2-port-result.c:72
msgid "Error updating the port settings"
msgstr "Fehler beim Aktualisieren der Port-Einstellungen"

#: libgphoto2_port/gphoto2-port-result.c:74
msgid "Error setting the serial port speed"
msgstr "Fehler beim Setzen der Port-Geschwindigkeit"

#: libgphoto2_port/gphoto2-port-result.c:76
msgid "Error clearing a halt condition on the USB port"
msgstr "Fehler beim Löschen einer »halt condition« auf dem USB-Port"

#: libgphoto2_port/gphoto2-port-result.c:78
msgid "Could not find the requested device on the USB port"
msgstr "Konnte das angeforderte Gerät nicht am USB-Port finden"

#: libgphoto2_port/gphoto2-port-result.c:80
msgid "Could not claim the USB device"
msgstr "Konnte das USB-Gerät nicht beanspruchen"

#: libgphoto2_port/gphoto2-port-result.c:82
msgid "Could not lock the device"
msgstr "Konnte das Gerät nicht alleinig reservieren"

#: libgphoto2_port/gphoto2-port-result.c:84
msgid "libhal error"
msgstr "Fehler in libhal"

#: libgphoto2_port/gphoto2-port-result.c:86
msgid "Unknown error"
msgstr "Unbekannter Fehler"

#: libgphoto2_port/gphoto2-port.c:46
#, c-format
msgid "The operation '%s' is not supported by this device"
msgstr "Die Funktion »%s« wird von diesem Gerät nicht unterstützt"

#: libgphoto2_port/gphoto2-port.c:47
msgid "The port has not yet been initialized"
msgstr "Der Port wurde noch nicht initialisiert"

#: libgphoto2_port/gphoto2-port.c:673
msgid "low"
msgstr "niedrig"

#: libgphoto2_port/gphoto2-port.c:674
msgid "high"
msgstr "hoch"

#: libgphoto2_port/gphoto2-port.c:1202
msgid "No error description available"
msgstr "Keine Fehlerbeschreibung verfügbar"

#: disk/disk.c:133 disk/disk.c:134 disk/disk.c:212 disk/disk.c:213
#: disk/disk.c:253 disk/disk.c:276
#, c-format
msgid "Media '%s'"
msgstr "Medium »%s«"

#: serial/unix.c:209
#, c-format
msgid "Could not lock device '%s'"
msgstr "Konnte Gerät »%s« nicht reservieren"

#: serial/unix.c:219 usbdiskdirect/linux.c:79
#, c-format
msgid "Device '%s' is locked by pid %d"
msgstr "Gerät »%s« ist von PID %d reserviert"

#: serial/unix.c:222 usbdiskdirect/linux.c:82
#, c-format
msgid "Device '%s' could not be locked (dev_lock returned %d)"
msgstr "Gerät »%s« konnte nicht reserviert werden (dev_lock lieferte %d)"

#: serial/unix.c:251
#, c-format
msgid "Device '%s' could not be unlocked."
msgstr "Reservierung von Gerät »%s« konnte nicht freigegeben werden."

#: serial/unix.c:263 usbdiskdirect/linux.c:111
#, c-format
msgid "Device '%s' could not be unlocked as it is locked by pid %d."
msgstr ""
"Reservierung von Gerät »%s« konnte nicht freigegeben werden, da es von PID "
"%d reserviert ist."

#: serial/unix.c:267 usbdiskdirect/linux.c:115
#, c-format
msgid "Device '%s' could not be unlocked (dev_unlock returned %d)"
msgstr ""
"Reservierung von Gerät »%s« konnte nicht freigegeben werden (dev_unlock "
"lieferte %d)"

#: serial/unix.c:313
#, c-format
msgid "Serial Port %i"
msgstr "Serieller Port %i"

#: serial/unix.c:326
msgid "Serial Port Device"
msgstr "Gerät mit serieller Schnittstelle"

#: serial/unix.c:401
#, c-format
msgid "Failed to open '%s' (%s)."
msgstr "Fehler beim Öffnen von »%s« (%s)."

#: serial/unix.c:421
#, c-format
msgid "Could not close '%s' (%s)."
msgstr "Konnte »%s« nicht schließen (%s)."

#: serial/unix.c:477
#, c-format
msgid "Could not write to port (%s)"
msgstr "Konnte nicht auf den Port schreiben (%s)"

#: serial/unix.c:552
msgid "Parity error."
msgstr "Paritätsfehler."

#: serial/unix.c:556
#, c-format
msgid "Unexpected parity response sequence 0xff 0x%02x."
msgstr "Unerwartete Paritätsantwort, Sequenz 0xff 0x%02x."

#: serial/unix.c:599
#, c-format
msgid "Unknown pin %i."
msgstr "Unbekannter Pin %i."

#: serial/unix.c:621
#, c-format
msgid "Could not get level of pin %i (%s)."
msgstr "Pegel von Pin %i (%s) konnte nicht ermittelt werden."

#: serial/unix.c:657
#, c-format
msgid "Could not set level of pin %i to %i (%s)."
msgstr "Pegel von Pin %i konnte nicht auf %i (%s) gesetzt werden."

#: serial/unix.c:684
#, c-format
msgid "Could not flush '%s' (%s)."
msgstr "Konnte »%s« (%s) nicht bereinigen"

#: serial/unix.c:778
#, c-format
msgid "Could not set the baudrate to %d"
msgstr "Konnte Baudrate nicht auf %d setzen"

#: usbdiskdirect/linux.c:218
msgid "USB Mass Storage direct IO"
msgstr "USB Mass Storage direkter IO"

#: usbdiskdirect/linux.c:269 usbscsi/linux.c:253
#, c-format
msgid "Failed to open '%s' (%m)."
msgstr "Konnte »%s« nicht öffnen (%m)."

#: usbdiskdirect/linux.c:283 usbscsi/linux.c:281
#, c-format
msgid "Could not close '%s' (%m)."
msgstr "Konnte »%s« nicht schließen (%m)."

#: usbdiskdirect/linux.c:307
#, c-format
msgid "Could not seek to offset: %x on '%s' (%m)."
msgstr "Konnte nicht auf Offset %x auf »%s« vorspulen (%m)."

#: usbdiskdirect/linux.c:329
#, c-format
msgid "Could not write to '%s' (%m)."
msgstr "Konnte nicht auf »%s« schreiben (%m)."

#: usbdiskdirect/linux.c:350
#, c-format
msgid "Could not read from '%s' (%m)."
msgstr "Konnte nicht von »%s« lesen (%m)."

#: libusb1/libusb1.c:386 usb/libusb.c:248
#, c-format
msgid "Could not open USB device (%s)."
msgstr "Konnte USB-Gerät nicht öffnen (%s)."

#: libusb1/libusb1.c:395 usb/libusb.c:261
msgid "Camera is already in use."
msgstr "Kamera ist bereits in Benutzung."

#: usb/libusb.c:269
#, c-format
msgid "Could not detach kernel driver '%s' of camera device."
msgstr "Konnte Kerneltreiber '%s' nicht vom Kamera Device lösen."

#: libusb1/libusb1.c:410 usb/libusb.c:274
msgid "Could not query kernel driver of device."
msgstr "Konnte den Kerneltreiber des Gerätes nicht abfragen."

#: libusb1/libusb1.c:417 usb/libusb.c:283
#, c-format
msgid ""
"Could not claim interface %d (%s). Make sure no other program (%s) or kernel "
"module (such as %s) is using the device and you have read/write access to "
"the device."
msgstr ""
"Schnittstelle %d (%s) konnte nicht verwendet werden. Stellen Sie sicher, "
"dass kein anderes Programm (%s) oder Kernelmodul (z. B. %s) das Gerät "
"verwendet und Sie Lese-/Schreibzugriff auf das Gerät haben."

#: libusb1/libusb1.c:428 usb/libusb.c:295
msgid "MacOS PTPCamera service"
msgstr "PTP-Kameradienst für MacOS"

#: libusb1/libusb1.c:430 usb/libusb.c:297
msgid "unknown libgphoto2 using program"
msgstr "unbekanntes Programm verwendet libgphoto2"

#: libusb1/libusb1.c:499 usb/libusb.c:314
#, c-format
msgid "Could not release interface %d (%s)."
msgstr "Konnte Schnittstelle %d nicht freigeben (%s)."

#: libusb1/libusb1.c:513 usb/libusb.c:329
#, c-format
msgid "Could not reset USB port (%s)."
msgstr "Konnte USB-Port nicht resetten (%s)."

#: usb/libusb.c:359
#, c-format
msgid "Could not close USB port (%s)."
msgstr "Konnte nicht den USB-Port schließen (%s)."

#: libusb1/libusb1.c:956 usb/libusb.c:621
#, c-format
msgid "Could not set config %d/%d (%s)"
msgstr "Konnte Konfiguration %d/%d nicht setzen (%s)"

#: libusb1/libusb1.c:985 usb/libusb.c:652
#, c-format
msgid "Could not set altsetting from %d to %d (%s)"
msgstr "Konnte Alternativ-Setting %d/%d nicht setzen (%s)"

#: libusb1/libusb1.c:1150 usb/libusb.c:741
#, c-format
msgid "The supplied vendor or product id (0x%x,0x%x) is not valid."
msgstr ""
"Die angegebene Hersteller- oder Produkt-ID (0x%x,0x%x) ist nicht gültig."

#: libusb1/libusb1.c:1119 libusb1/libusb1.c:1211 usb/libusb.c:812
#: usb/libusb.c:898
#, c-format
msgid ""
"Could not find USB device (vendor 0x%x, product 0x%x). Make sure this device "
"is connected to the computer."
msgstr ""
"Konnte USB-Gerät (Hersteller 0x%x, Produkt 0x%x) nicht finden. Stellen Sie "
"sicher, dass das Gerät ordnungsgemäß an den Computer angeschlossen ist."

#: libusb1/libusb1.c:1500 usb/libusb.c:1191
#, c-format
msgid ""
"Could not find USB device (class 0x%x, subclass 0x%x, protocol 0x%x). Make "
"sure this device is connected to the computer."
msgstr ""
"Konnte USB-Gerät (Klasse 0x%x, Subklasse 0x%x, Protokoll 0x%x) nicht finden. "
"Stellen Sie sicher, dass das Gerät ordnungsgemäß an den Computer "
"angeschlossen ist."

#: libusb1/libusb1.c:404
msgid "Could not detach kernel driver of camera device."
msgstr "Konnte Kerneltreiber nicht vom Kamera Device lösen."

#: libusb1/libusb1.c:522
msgid "Could not reattach kernel driver of camera device."
msgstr "Konnte Kerneltreiber nicht an Kamera Device reattachen."

#: usbscsi/linux.c:92
#, c-format
msgid "Device '%s' is locked by another app."
msgstr "Gerät »%s« ist durch eine andere Anwendung gesperrt."

#: usbscsi/linux.c:97
#, c-format
msgid "Failed to lock '%s' (%m)."
msgstr "Fehler beim Sperren von »%s« (%m)."

#: usbscsi/linux.c:113
#, c-format
msgid "Failed to unlock '%s' (%m)."
msgstr "Fehler beim Entsperren von »%s« (%m)."

#: usbscsi/linux.c:214
msgid "USB Mass Storage raw SCSI"
msgstr "USB Mass Storage raw SCSI"

#: usbscsi/linux.c:325
#, c-format
msgid "Could not send scsi command to: '%s' (%m)."
msgstr "Konnte SCSI Kommando nicht an »%s« senden (%m)"
