msgstr "%s: Unterverzeichnissatz kann nicht erstellt werden\n"

#: fc-cache/fc-cache.c:275
#, c-format
msgid "%s: Can't create subdir list\n"
msgstr "%s: Liste der Unterverzeichnisse kann nicht erstellt werden\n"

#: fc-cache/fc-cache.c:383 fc-cat/fc-cat.c:309
#, c-format
msgid "%s: Can't initialize font config library\n"
msgstr "%s: Konnte fontconfig-Bibliothek nicht initialisieren\n"

#: fc-cache/fc-cache.c:393
#, c-format
msgid "%s: Can't create list of directories\n"
msgstr "%s: Kann keine Liste der Verzeichnisse erstellen\n"

#: fc-cache/fc-cache.c:401
#, c-format
msgid "%s: Can't add directory\n"
msgstr "%s: Kann Verzeichnis nicht hinzufügen\n"

#: fc-cache/fc-cache.c:413
#, c-format
msgid "Out of Memory\n"
msgstr "Speicherüberlauf\n"

#: fc-cache/fc-cache.c:456
msgid "failed"
msgstr "fehlgeschlagen"

#: fc-cache/fc-cache.c:456
msgid "succeeded"
msgstr "erfolgreich"

