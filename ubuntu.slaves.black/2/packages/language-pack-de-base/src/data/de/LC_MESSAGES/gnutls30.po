#: lib/alert.c:40
msgid "Close notify"
msgstr "Benachrichtigung schließen"

#: lib/alert.c:41
msgid "Unexpected message"
msgstr "Unerwartete Nachricht"

#: lib/alert.c:42
msgid "Bad record MAC"
msgstr "Fehlerhafter MAC-Eintrag"

#: lib/alert.c:43
msgid "Decryption failed"
msgstr "Entschlüsselung fehlgeschlagen"

#: lib/alert.c:44
msgid "Record overflow"
msgstr "Eintragsüberlauf"

