#: ../policy/org.freedesktop.fwupd.policy.in.h:1
msgid "Install signed system firmware"
msgstr "Signierte System-Firmware installieren"

#. TRANSLATORS: this is the PolicyKit modal dialog
#: ../policy/org.freedesktop.fwupd.policy.in.h:3
msgid "Authentication is required to update the firmware on this machine"
msgstr ""
"Eine Legitimierung ist notwendig, um die Firmware auf diesem Gerät zu "
"aktualisieren"

#: ../policy/org.freedesktop.fwupd.policy.in.h:4
msgid "Install unsigned system firmware"
msgstr "Nicht-signierte System-Firmware installieren"

#: ../policy/org.freedesktop.fwupd.policy.in.h:5
msgid "Install old version of system firmware"
msgstr "Alte Version der System-Firmware installieren"

#. TRANSLATORS: this is the PolicyKit modal dialog
#: ../policy/org.freedesktop.fwupd.policy.in.h:7
msgid "Authentication is required to downgrade the firmware on this machine"
msgstr ""
"Eine Legitimierung ist notwendig, um die Firmware auf diesem Gerät "
"herabzustufen"

#: ../policy/org.freedesktop.fwupd.policy.in.h:8
msgid "Install signed device firmware"
msgstr "Signierte Geräte-Firmware installieren"

#. TRANSLATORS: this is the PolicyKit modal dialog
#: ../policy/org.freedesktop.fwupd.policy.in.h:10
msgid ""
"Authentication is required to update the firmware on a removable device"
msgstr ""
"Eine Legitimierung ist notwendig, um die Firmware auf einem entfernbaren "
"Gerät zu aktualisieren"

#: ../policy/org.freedesktop.fwupd.policy.in.h:11
msgid "Install unsigned device firmware"
msgstr "Nicht-signierte Geräte-Firmware installieren"

#. TRANSLATORS: this is the PolicyKit modal dialog
#: ../policy/org.freedesktop.fwupd.policy.in.h:13
msgid ""
"Authentication is required to downgrade the firmware on a removable device"
msgstr ""
"Eine Legitimierung ist notwendig, um die Firmware auf einem entfernbaren "
"Gerät herabzustufen"

#: ../policy/org.freedesktop.fwupd.policy.in.h:14
msgid "Unlock the device to allow access"
msgstr "Das Gerät entsperren, um Zugriff zu ermöglichen"

#. TRANSLATORS: this is the PolicyKit modal dialog
#: ../policy/org.freedesktop.fwupd.policy.in.h:16
msgid "Authentication is required to unlock a device"
msgstr "Eine Legitimierung ist notwendig, um eine Gerät zu entsperren"

#: ../policy/org.freedesktop.fwupd.policy.in.h:17
msgid "Update the stored device verification information"
msgstr "Gespeicherte Geräteverifizierungsinformationen aktualisieren"

#. TRANSLATORS: this is the PolicyKit modal dialog
#: ../policy/org.freedesktop.fwupd.policy.in.h:19
msgid ""
"Authentication is required to update the stored checksums for the device"
msgstr ""
"Eine Authentifizierung ist erforderlich, um die gespeicherten Prüfsummen für "
"das Gerät zu aktualisieren"

