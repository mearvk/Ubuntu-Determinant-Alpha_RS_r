#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "Nach kurzer Verzögerung beenden"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "Abbrechen, nachdem die Programmroutine geladen wurde"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr "Ersetze den alten Daemon"

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "Zusätzliche Informationen zur Fehlerdiagnose anzeigen"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "Objektpfade für die Geräte aufzählen"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "Alle Informationen über alle Objekte anzeigen"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "Weckrufe von Geräten (remote wakeups) anzeigen"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "Aktivität des Energieverwaltungsdienstes überwachen"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "Detailliert überwachen"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "Informationen über den Objektpfad anzeigen"
