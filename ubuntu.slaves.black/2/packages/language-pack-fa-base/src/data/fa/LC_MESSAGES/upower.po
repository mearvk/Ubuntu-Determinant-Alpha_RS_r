#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "خروج پس از کمی وقفه"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "خروج پس از بار شدن موتور"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr "جایگزینی خدمت قدیمی"

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "نشان دادن اطّلاعات اضافی اشکال‌زدايی"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "شماره گذاری مسیرهای اشیا برای دستگاه‌ها"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "نسخه برداری از همه‌ی پارامترها برا تمام اشیا"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "گرفتن داده‌ّای بیدار شدن"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "پایش فعّالیت‌ها از دمون انرژی"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "پایش با جزئیات"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "نمایش اطّلاعات درباره‌ی مسیر شیٔ"
