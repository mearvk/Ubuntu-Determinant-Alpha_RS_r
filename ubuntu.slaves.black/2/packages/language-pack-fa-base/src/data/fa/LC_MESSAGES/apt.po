#, c-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "مقدار ⁦%sB⁩ در ⁦%s⁩ واکشی شد ⁦(%sB/s)⁩\n"

#: apt-private/acqprogress.cc:247
msgid " [Working]"
msgstr " [مشغول به کار]"

#: apt-private/acqprogress.cc:315
#, c-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press [Enter]\n"
msgstr ""
"تغییر رسانه: لطفاً دیسک با عنوان\n"
" «%s»\n"
"را در گرداننده «%s» وارد و [Enter] را فشار دهید\n"

