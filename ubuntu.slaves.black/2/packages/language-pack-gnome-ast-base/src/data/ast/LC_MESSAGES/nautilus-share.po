#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"Nautilus necesita amestar dalgunos permisos a la so carpeta «%s» pa poder "
"compartila"

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"La carpeta «%s» necesita los siguientes permisos estra adicionales pa poder "
"compartila:\n"
"%s%s%s¿Quier que Nautilus amieste automáticamente estos permisos a la "
"carpeta?"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - permisos de llectura pa otros\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - permisos d'escritura pa otros\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - permisos d'execución pa otros\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "Amestar los permisos automáticamente"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "Nun se pueden camudar los permisos de la carpeta «%s»"

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "El nome compartíu ye enforma llargu"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "El nome compartíu nun pue quedar ermu"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr "Fallu al garrar la información de compartición: %s"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "Otru recursu compartíu tien el mesmu nome"

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "Camudar _compartición"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "Facer _compartición"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "Falló la instalación del serviciu de compartición"

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr ""
"La instalación del serviciu de compartición falló. ¿Quier volver a tentalo?"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "Volver a tentalo"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "El serviciu de compartición nun ta instaláu"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"Necesites instalar el serviciu de compartición de redes Windows pa poder "
"compartir les carpetes."

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "Instalar el serviciu"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr "Ocurrió un fallu al garrar la información de compartición"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "Recursu compartíu na rede llocal"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "Compartición de Carpetes"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "Compartir esta carpeta"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "devolvióse %s %s %s cola señal %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s falló por una razón desconocía"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "La «rede compartía» devolvió'l fallu %d: %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "La «rede compartía» devolvió'l fallu %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "La salida de la «rede compartía» nun ta codificada en UTF-8"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "Falló"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "Devolvióse'l parámetru de prueba de Samba cola señal %d"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "El parámetru de preba de Samba falló por una razón desconocía"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "El parámetru de prueba de Samba devolvió'l fallu %d: %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "El parámetru de prueba de Samba devolvió'l fallu %d"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr ""
"Nun se pue desaniciar la compartición pa la ruta %s: esa ruta nun ta "
"compartida"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"Nun se pue camudar la ruta d'una compartición esistente; desanicia la "
"compartición vieya primero y amiesta una nueva"

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>Compartición de Carpetes</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "_Nome pa compartir:"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "Compartir esta car_peta"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "Co_mentariu:"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr "Permitir _a otros crear y esborrar ficheros nesta carpeta"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr "Accesu d'invi_táu (pa xente ensin cuenta d'usuariu)"
