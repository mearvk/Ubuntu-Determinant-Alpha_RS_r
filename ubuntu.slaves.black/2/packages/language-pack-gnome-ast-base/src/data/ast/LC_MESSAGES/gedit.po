msgid "_Save"
msgstr "_Guardar"

#: gedit/gedit-close-confirmation-dialog.c:312
#, c-format
msgid ""
"If you don’t save, changes from the last %ld second will be permanently lost."
msgid_plural ""
"If you don’t save, changes from the last %ld seconds will be permanently "
"lost."
msgstr[0] ""
"Si nun grabes, los cambeos dende l'últimu %ld segundu van perdese pa "
"siempres."
msgstr[1] ""
"Si nun grabes, los cambeos dende los últimos %ld segundos van perdese pa "
"siempres."

#: gedit/gedit-close-confirmation-dialog.c:321
msgid ""
"If you don’t save, changes from the last minute will be permanently lost."
msgstr ""
"Si nun grabes, los cambeos dende l'últimu minutu van perdese pa siempres."

#: gedit/gedit-close-confirmation-dialog.c:327
#, c-format
msgid ""
"If you don’t save, changes from the last minute and %ld second will be "
"permanently lost."
msgid_plural ""
"If you don’t save, changes from the last minute and %ld seconds will be "
"permanently lost."
msgstr[0] ""
"Si nun grabes, los cambeos dende l'últimu minutu y  %ld segundu van perdese "
"pa siempres."
msgstr[1] ""
"Si nun los grabes, los cambeos dende l'últimu minutu y  %ld segundu van "
"perdese pa siempres."

#: gedit/gedit-close-confirmation-dialog.c:337
#, c-format
msgid ""
"If you don’t save, changes from the last %ld minute will be permanently lost."
msgid_plural ""
"If you don’t save, changes from the last %ld minutes will be permanently "
"lost."
msgstr[0] ""
"Si nun grabes, los cambeos dende l'últimu minutu y  %ld segundu van perdese "
"pa siempres."
msgstr[1] ""
"Si nun grabes, los cambeos dende los últimos %ld minutos van perdese pa "
"siempres."

#: gedit/gedit-close-confirmation-dialog.c:352
msgid ""
"If you don’t save, changes from the last hour will be permanently lost."
msgstr "Si nun grabes, los cambeos de la última hora va perdese pa siempres."

#: gedit/gedit-close-confirmation-dialog.c:358
#, c-format
msgid ""
"If you don’t save, changes from the last hour and %d minute will be "
"permanently lost."
msgid_plural ""
"If you don’t save, changes from the last hour and %d minutes will be "
"permanently lost."
msgstr[0] ""
"Si nun grabes, los cambeos dende la última hora y %d minutu va perdese pa "
"siempres."
msgstr[1] ""
"Si nun grabes, los cambeos dende la última hora y %d minutos van perdese pa "
"siempres."

#: gedit/gedit-close-confirmation-dialog.c:373
#, c-format
msgid ""
"If you don’t save, changes from the last %d hour will be permanently lost."
msgid_plural ""
"If you don’t save, changes from the last %d hours will be permanently lost."
msgstr[0] ""
"Si nun grabes, los cambeos de la última hora van perdese pa siempres."
msgstr[1] ""
"Si nun grabes, los cambeos de les últimes hores %d hores van perdese pa "
"siempres."

#: gedit/gedit-close-confirmation-dialog.c:400
#, c-format
msgid "Save changes to document “%s” before closing?"
msgstr "¿Guardar los cambios del documentu «%s» antes de zarrar?"

#: gedit/gedit-close-confirmation-dialog.c:470
#, c-format
msgid ""
"There is %d document with unsaved changes. Save changes before closing?"
msgid_plural ""
"There are %d documents with unsaved changes. Save changes before closing?"
msgstr[0] ""
"Hai %d documentu con cambeos ensin guardar. ¿Deseya guardar los cambeos "
"anantes de zarrar?"
