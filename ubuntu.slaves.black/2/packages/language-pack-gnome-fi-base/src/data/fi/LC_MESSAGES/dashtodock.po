"General Public -lisenssi, versio 2 tai uudempi</a> saadaksesi "
"lisätietoja.</span>"

#: Settings.ui.h:106
msgid "About"
msgstr "Tietoja"

#: Settings.ui.h:107
msgid "Customize minimum and maximum opacity values"
msgstr "Mukauta peittokyvyn vähimmäis- ja enimmäisarvoja"

#: Settings.ui.h:108
msgid "Minimum opacity"
msgstr "Peittokyky vähintään"

#: Settings.ui.h:109
msgid "Maximum opacity"
msgstr "Peittokyky enintään"

#: Settings.ui.h:110
msgid "Number overlay"
msgstr "Numeronäkymä"

#: Settings.ui.h:111
msgid ""
"Temporarily show the application numbers over the icons, corresponding to "
"the shortcut."
msgstr ""
"Näytä väliaikaisesti sovellusten numerot kuvakkeiden päällä, ilmaisee "
"pikanäppäinten numeroita."

#: Settings.ui.h:112
msgid "Show the dock if it is hidden"
msgstr "Näytä telakka jos se on piilotettuna"

#: Settings.ui.h:113
msgid ""
"If using autohide, the dock will appear for a short time when triggering the "
"shortcut."
msgstr ""
"Jos automaattinen piilotus on käytössä, telakka ilmestyy näkyviin lyhyeksi "
"ajaksi pikanäppäintä painamalla."

#: Settings.ui.h:114
msgid "Shortcut for the options above"
msgstr "Pikanäppäin yllä oleville valinnoille"

#: Settings.ui.h:115
msgid "Syntax: <Shift>, <Ctrl>, <Alt>, <Super>"
msgstr "Syntaksi: <Shift>, <Ctrl>, <Alt>, <Super>"

#: Settings.ui.h:116
msgid "Hide timeout (s)"
msgstr "Piilotuksen viive (s)"

#: Settings.ui.h:117
msgid "Show the dock by mouse hover on the screen edge."
msgstr "Näytä telakka viemällä hiiren osoitin näytön reunaan."

#: Settings.ui.h:118
msgid "Autohide"
msgstr "Piilota automaattisesti"

#: Settings.ui.h:119
msgid "Push to show: require pressure to show the dock"
msgstr "Esiintuonti työntämällä: vaadi painetta, jotta telakka näytetään"

#: Settings.ui.h:120
msgid "Enable in fullscreen mode"
msgstr "Käytä koko näytön tilassa"

#: Settings.ui.h:122
msgid "Show the dock when it doesn't obstruct application windows."
msgstr "Näytä telakka, kun se ei peitä sovellusikkunoita."

#: Settings.ui.h:123
msgid "Dodge windows"
msgstr "Väistä ikkunoita"

#: Settings.ui.h:124
msgid "All windows"
msgstr "Kaikki ikkunat"

#: Settings.ui.h:125
msgid "Only focused application's windows"
msgstr "Vain kohdistetun sovelluksen ikkunat"

#: Settings.ui.h:126
msgid "Only maximized windows"
msgstr "Vain suurennetut ikkunat"

#: Settings.ui.h:127
msgid "Always on top"
msgstr "Aina päällimmäisenä"

#: Settings.ui.h:128
msgid "Animation duration (s)"
msgstr "Animaation kesto (s)"

#: Settings.ui.h:129
msgid "Show timeout (s)"
msgstr "Näyttämisen viive (s)"

#: Settings.ui.h:130
msgid "Pressure threshold"
msgstr "Paineen kynnysarvo"
