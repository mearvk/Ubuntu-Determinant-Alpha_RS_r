msgid "Move the viewport of the current workspace to Y coordinate Y"
msgstr "Siirrä nykyisen työtilan katselunäkymä Y-koordinaattiin Y"

#: libwnck/wnckprop.c:188 libwnck/wnckprop.c:275
msgid "Y"
msgstr "Y"

