msgstr "Päivitys on valmis"

#: ../DistUpgrade/DistUpgradeController.py:2517
#: ../DistUpgrade/DistUpgradeController.py:2569
#: ../DistUpgrade/DistUpgradeController.py:2575
msgid ""
"The upgrade has completed but there were errors during the upgrade process."
msgstr "Päivitys valmistui, mutta päivityksen yhteydessä tapahtui virheitä."

#: ../DistUpgrade/DistUpgradeController.py:2532
msgid "System upgrade is complete."
msgstr "Järjestelmän päivitys on valmis."

#: ../DistUpgrade/DistUpgradeController.py:2586
