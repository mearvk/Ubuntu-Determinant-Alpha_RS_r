#: Settings.ui.h:106
msgid "About"
msgstr "על אודות"

#: Settings.ui.h:107
msgid "Customize minimum and maximum opacity values"
msgstr "התאמת ערכי הסף של האטימות"

#: Settings.ui.h:108
msgid "Minimum opacity"
msgstr "אטימות מזערית"

#: Settings.ui.h:109
msgid "Maximum opacity"
msgstr "אטימות מרבית"

#: Settings.ui.h:110
msgid "Number overlay"
msgstr "שכבת מספר"

#: Settings.ui.h:111
msgid ""
"Temporarily show the application numbers over the icons, corresponding to "
"the shortcut."
msgstr "הצגת מספרי היישומים באופן זמני על גבי הסמל, בהתאם לקיצור שלהם."

#: Settings.ui.h:112
msgid "Show the dock if it is hidden"
msgstr "הצגת המעגן אם הוא מוסתר"

#: Settings.ui.h:113
msgid ""
"If using autohide, the dock will appear for a short time when triggering the "
"shortcut."
msgstr ""
"בעת שימוש בהסתרה אוטומטית, המעגן יופיע לזמן קצר בעת הפעלת קיצור הדרך."

#: Settings.ui.h:114
msgid "Shortcut for the options above"
msgstr "קיצור הדרך של האפשרויות שלעיל"

#: Settings.ui.h:115
msgid "Syntax: <Shift>, <Ctrl>, <Alt>, <Super>"
msgstr "תחביר: <Shift>,‏ <Ctrl>,‏ <Alt>,‏ <Super>"

#: Settings.ui.h:116
msgid "Hide timeout (s)"
msgstr "תום זמן הסתרה (שנ׳)"

#: Settings.ui.h:117
msgid "Show the dock by mouse hover on the screen edge."
msgstr "הצגת המעגן עם מעבר העכבר על שולי המסך."

#: Settings.ui.h:118
msgid "Autohide"
msgstr "הסתרה אוטומטית"

#: Settings.ui.h:119
msgid "Push to show: require pressure to show the dock"
msgstr "יש ללחוץ כדי להציג: נדרש לחץ כדי להציג את המעגן"

#: Settings.ui.h:120
msgid "Enable in fullscreen mode"
msgstr "הפעלה במסך מלא"

#: Settings.ui.h:122
msgid "Show the dock when it doesn't obstruct application windows."
msgstr "הצגת המעגן כשאינו חוסם חלונות יישומים."

#: Settings.ui.h:123
msgid "Dodge windows"
msgstr "התחמקות מחלונות"

#: Settings.ui.h:124
msgid "All windows"
msgstr "כל החלונות"

#: Settings.ui.h:125
msgid "Only focused application's windows"
msgstr "רק חלונות של יישומים במיקור"

#: Settings.ui.h:126
msgid "Only maximized windows"
msgstr "רק חלונות מוגדלים"

#: Settings.ui.h:127
msgid "Always on top"
msgstr "תמיד עליון"

#: Settings.ui.h:128
msgid "Animation duration (s)"
msgstr "משך הנפשה (שנ׳)"

#: Settings.ui.h:129
msgid "Show timeout (s)"
msgstr "תום זמן הצגה (שנ׳)"

#: Settings.ui.h:130
msgid "Pressure threshold"
msgstr "סף לחץ"
