#: Settings.ui.h:1
msgid ""
"When set to minimize, double clicking minimizes all the windows of the "
"application."
msgstr "אם ההגדרה היא למזער, לחיצה כפולה ממזערת את כל חלונות היישום."

#: Settings.ui.h:2
msgid "Shift+Click action"
msgstr "פעולת Shift עם לחיצה"

#: Settings.ui.h:3
msgid "Raise window"
msgstr "הגבהת חלון"

#: Settings.ui.h:4
msgid "Minimize window"
msgstr "מזעור חלון"

#: Settings.ui.h:5
msgid "Launch new instance"
msgstr "הפעלת מופע חדש"

#: Settings.ui.h:6
msgid "Cycle through windows"
msgstr "מעבר בין חלונות"

#: Settings.ui.h:7
msgid "Minimize or overview"
msgstr "מזעור או סקירה"

#: Settings.ui.h:8
msgid "Show window previews"
msgstr "הצגת תצוגות מקדימות של חלונות"

#: Settings.ui.h:9
msgid "Minimize or show previews"
msgstr "מזעור או הצגת תצוגות מקדימות"

#: Settings.ui.h:10
msgid "Focus or show previews"
msgstr "מיקוד או הצגת תצוגות מקדימות"

#: Settings.ui.h:12
msgid "Focus, minimize or show previews"
msgstr "להתמקד, למזער או להציג תצוגות מקדימות"

#: Settings.ui.h:14
msgid "Quit"
msgstr "יציאה"

#: Settings.ui.h:15
msgid "Behavior for Middle-Click."
msgstr "התנהגות בלחיצה אמצעית."

#: Settings.ui.h:16
msgid "Middle-Click action"
msgstr "פעולת לחיצה אמצעית"

#: Settings.ui.h:17
msgid "Behavior for Shift+Middle-Click."
msgstr "התנהגות של Shift עם לחיצה אמצעית"

#: Settings.ui.h:18
msgid "Shift+Middle-Click action"
msgstr "פעולה של Shift עם לחיצה אמצעית"

#: Settings.ui.h:19
msgid "Enable Unity7 like glossy backlit items"
msgstr "הפעלת פריטים מבריקים עם תאורה אחורית דמויי Unity7"

#: Settings.ui.h:20
msgid "Apply glossy effect."
msgstr "החלת אפקט מבריק."

#: Settings.ui.h:21
msgid "Use dominant color"
msgstr "שימוש בצבע שולט"

#: Settings.ui.h:22
msgid "Customize indicator style"
msgstr "התאמת סגנון מחוון"

#: Settings.ui.h:23
msgid "Color"
msgstr "צבע"

#: Settings.ui.h:24
msgid "Border color"
msgstr "צבע מסגרת"

#: Settings.ui.h:25
msgid "Border width"
msgstr "עובי מסגרת"

#: Settings.ui.h:26
msgid "Show the dock on"
msgstr "הצגת המעגן על גבי"

#: Settings.ui.h:25
msgid "Show on all monitors."
msgstr "הצגה על כל הצגים."

#: Settings.ui.h:28
msgid "Position on screen"
msgstr "מיקום במסך"

#: Settings.ui.h:30
msgid "Bottom"
msgstr "בתחתית"

#: Settings.ui.h:31
msgid "Top"
msgstr "למעלה"

#: Settings.ui.h:33
msgid ""
"Hide the dock when it obstructs a window of the current application. More "
"refined settings are available."
msgstr ""
"הסתרת המעגן כשהוא חוסם חלון של היישום הנוכחי. ישנן הגדרות נוספות לאיתור מחדש."

#: Settings.ui.h:34
msgid "Intelligent autohide"
msgstr "הסתרה אוטומטית חכמה"

#: Settings.ui.h:35
msgid "Dock size limit"
msgstr "מגבלת גודל מעגן"

#: Settings.ui.h:36
msgid "Panel mode: extend to the screen edge"
msgstr "מצב חלונית: הרחבה עד לקצה המסך"

#: Settings.ui.h:38
msgid "Icon size limit"
msgstr "מגבלת גודל סמל"

#: Settings.ui.h:39
msgid "Fixed icon size: scroll to reveal other icons"
msgstr "גודל סמל קבוע: יש לגלול כדי לחשוף סמלים אחרים"

#: Settings.ui.h:40
msgid "Preview size scale"
msgstr "תצוגה מקדימה של שינוי גודל"

#: Settings.ui.h:41
msgid "Position and size"
msgstr "מיקום וגודל"

#: prefs.js:242
msgid "Show favorite applications"
msgstr "הצגת יישומים מועדפים"

#: Settings.ui.h:43
msgid "Show running applications"
msgstr "הצגת יישומים פעילים"

#: Settings.ui.h:41
msgid "Isolate workspaces."
msgstr "בידוד מרחבי עבודה."

#: Settings.ui.h:42
msgid "Show urgent windows despite current workspace."
msgstr "להציג חלונות דחופים למרות מרחב העבודה הנוכחי."

#: Settings.ui.h:43
msgid "Isolate monitors."
msgstr "בידוד צגים."

#: Settings.ui.h:44
msgid "Show open windows previews."
msgstr "הצגת תצוגות מקדימות של חלונות פתוחים."

#: Settings.ui.h:48
msgid "Keep the focused application always visible in the dash"
msgstr "לשמור על היישום הממוקד תמיד גלוי בחלונית היישומים"

#: Settings.ui.h:49
msgid ""
"If disabled, these settings are accessible from gnome-tweak-tool or the "
"extension website."
msgstr ""
"אם הגדרה זו מושבתת, הגדרות אלו נגישות דרך gnome-tweak-tool או דרך אתר "
"ההרחבות."

#: Settings.ui.h:50
msgid "Show <i>Applications</i> icon"
msgstr "הצגת הסמל <b>יישומים</b>"

#: Settings.ui.h:48
msgid "Move the applications button at the beginning of the dock."
msgstr "העברת כפתורי היישומים לתחילת המעגן."

#: Settings.ui.h:49
msgid "Animate <i>Show Applications</i>."
msgstr "הנפשת <b>הצגת חלונות</b>"

#: Settings.ui.h:54
msgid "Show trash can"
msgstr "הצגת סל אשפה"

#: Settings.ui.h:55
msgid "Show volumes and devices"
msgstr "להציג כרכים והתקנים"

#: Settings.ui.h:56
msgid "Only if mounted"
msgstr "רק אם מעוגנים"

#: Settings.ui.h:57
msgid "Include network volumes"
msgstr "לכלול כרכי רשת"

#: Settings.ui.h:58
msgid "Isolate volumes, devices and trash windows from file manager"
msgstr "בידוד חלונות כרכים, התקנים ואשפה ממנהל הקבצים"

#: Settings.ui.h:65
msgid "Launchers"
msgstr "משגרים"

#: Settings.ui.h:66
msgid ""
"Enable Super+(0-9) as shortcuts to activate apps. It can also be used "
"together with Shift and Ctrl."
msgstr ""
"הפעלת מקש Super‏ + (0‏-9) כקיצורי דרך להפעלת יישומים. ניתן גם להשתמש עם "
"Shift ו־Ctrl."

#: Settings.ui.h:67
msgid "Use keyboard shortcuts to activate apps"
msgstr "ניתן להשתמש בקיצורי מקלדת כדי להפעיל יישומים"

#: Settings.ui.h:68
msgid "Behaviour when clicking on the icon of a running application."
msgstr "התנהגות בעת לחיצה על סמל היישום הפעיל."

#: Settings.ui.h:69
msgid "Click action"
msgstr "פעולת לחיצה"

#: Settings.ui.h:70
msgid "Minimize"
msgstr "מזעור"

#: Settings.ui.h:71
msgid "Behaviour when scrolling on the icon of an application."
msgstr "התנהגות בעת גלילה על סמל היישום."

#: Settings.ui.h:72
msgid "Scroll action"
msgstr "פעולת גלילה"

#: Settings.ui.h:73
msgid "Do nothing"
msgstr "לא לעשות כלום"

#: Settings.ui.h:74
msgid "Switch workspace"
msgstr "להחליף מרחב עבודה"

#: Settings.ui.h:75
msgid "Behavior"
msgstr "התנהגות"

#: Settings.ui.h:80
msgid ""
"Few customizations meant to integrate the dock with the default GNOME theme. "
"Alternatively, specific options can be enabled below."
msgstr ""
"מיעוט בהתאמות יוביל לשילוב המעגן בערכת העיצוב של GNOME כבררת מחדל. לחלופין, "
"ניתן להפעיל אפשרויות נקודתיות להלן."

#: Settings.ui.h:81
msgid "Use built-in theme"
msgstr "להשתמש בערכת עיצוב מובנית"

#: Settings.ui.h:76
msgid "Save space reducing padding and border radius."
msgstr "ניתן לחסוך במקום על ידי הפחתת הריפוד ורדיוס הפינות."

#: Settings.ui.h:77
msgid "Shrink the dash"
msgstr "צמצום לוח המחוונים"

#: Settings.ui.h:82
msgid "Customize windows counter indicators"
msgstr "התאמת מחווני מניין של החלונות"

#: Settings.ui.h:83
msgid "Default"
msgstr "בררת מחדל"

#: Settings.ui.h:84
msgid "Dots"
msgstr "נקודות"

#: Settings.ui.h:85
msgid "Squares"
msgstr "ריבועים"

#: Settings.ui.h:86
msgid "Dashes"
msgstr "קווקווים"

#: Settings.ui.h:87
msgid "Segmented"
msgstr "מקוטע"

#: Settings.ui.h:88
msgid "Solid"
msgstr "אחיד"

#: Settings.ui.h:89
msgid "Ciliora"
msgstr "סיליורה"

#: Settings.ui.h:90
msgid "Metro"
msgstr "מטרו"

#: Settings.ui.h:92
msgid "Set the background color for the dash."
msgstr "הגדרת צבע הרקע של לוח המחוונים."

#: Settings.ui.h:93
msgid "Customize the dash color"
msgstr "התאמת צבע לוח המחוונים"

#: Settings.ui.h:94
msgid "Tune the dash background opacity."
msgstr "כוונון אטימות רקע לוח המחוונים."

#: Settings.ui.h:96
msgid "Fixed"
msgstr "קבועה"

#: Settings.ui.h:97
msgid "Dynamic"
msgstr "דינמית"

#: Settings.ui.h:98
msgid "Opacity"
msgstr "אטימות"

#: Settings.ui.h:78
msgid "Force straight corner"
msgstr "אכיפת יישור פינה"

#: Settings.ui.h:79
msgid "Show overview on startup"
msgstr "הצגת סקירה עם הפתיחה"

#: Settings.ui.h:99
msgid "Appearance"
msgstr "מראה"

#: Settings.ui.h:100
msgid "version: "
msgstr "גרסה: "

#: Settings.ui.h:101
msgid "Moves the dash out of the overview transforming it in a dock"
msgstr "העברת לוח המחוונים מחוץ לסקירה ולהפוך אותו למעגן"

#: Settings.ui.h:102
msgid "Created by"
msgstr "נוצר על ידי"

#: Settings.ui.h:103
msgid "Webpage"
msgstr "אתר"

#: Settings.ui.h:104
msgid ""
"<span size=\"small\">This program comes with ABSOLUTELY NO WARRANTY.\n"
"See the <a href=\"https://www.gnu.org/licenses/old-licenses/gpl-"
"2.0.html\">GNU General Public License, version 2 or later</a> for "
"details.</span>"
msgstr ""
"<span size=\"small\">תכנית זו מופצת ללא שום אחריות.\n"
