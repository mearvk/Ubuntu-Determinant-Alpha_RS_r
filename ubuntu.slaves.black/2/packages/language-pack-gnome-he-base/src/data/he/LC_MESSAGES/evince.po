#, c-format
msgid ""
"%s%s\n"
"Encoding: %s\n"
"%s\n"
"Substituting with <b>%s</b>\n"
"(%s)"
msgstr ""
"‏%s ‏%s\n"
"קידוד: %s\n"
"‏%s\n"
"מוטמע עם <b>%s</b>\n"
"‏(‎%s)"

