msgid ""
"An application has crashed on your system (now or in the past). Click on the "
"notification icon to display details. "
msgstr ""
"יישום קרס במערכת שלך (כרגע או בעבר). נא ללחוץ על סמל ההתרעות להצגת פרטים. "

#: ../src/cdroms.c:48
msgid "Software Packages Volume Detected"
msgstr "התגלה כרך חבילות תוכנה"

#: ../src/cdroms.c:49
msgid ""
"<span weight=\"bold\" size=\"larger\">A volume with software packages has "
"been detected.</span>\n"
"\n"
"Would you like to open it with the package manager?"
msgstr ""
"<span weight=\"bold\" size=\"larger\">התגלה כרך עם חבילות תוכנה.</span>\n"
"\n"
"לפתוח אותו עם מנהל החבילות?"

#: ../src/cdroms.c:57
msgid "Start Package Manager"
msgstr "הפעלת מנהל החבילות"

#: ../src/cdroms.c:63
msgid "Upgrade volume detected"
msgstr "התגלה כרך שדרוג"

#: ../src/cdroms.c:64
msgid ""
"<span weight=\"bold\" size=\"larger\">A distribution volume with software "
"packages has been detected.</span>\n"
"\n"
"Would you like to try to upgrade from it automatically? "
msgstr ""
"<span weight=\"bold\" size=\"larger\">התגלה כרך הפצה עם חבילות "
"תוכנה.</span>\n"
"\n"
"לנסות לשדרג ממנו באופן אוטומטי? "

#: ../src/cdroms.c:71
msgid "Run upgrade"
msgstr "הפעלת שדרוג"

#: ../src/cdroms.c:79
msgid "APTonCD volume detected"
msgstr "התגלה כרך APTonCD"

#: ../src/cdroms.c:80
msgid ""
"<span weight=\"bold\" size=\"larger\">A volume with unofficial software "
"packages has been detected.</span>\n"
"\n"
"Would you like to open it with the package manager?"
msgstr ""
"<span weight=\"bold\" size=\"larger\">התגלה כרך עם חבילות תוכנה "
"בלתי־רשמיות.</span>\n"
"\n"
"לפתוח אותו בעזרת מנהל החבילות?"

