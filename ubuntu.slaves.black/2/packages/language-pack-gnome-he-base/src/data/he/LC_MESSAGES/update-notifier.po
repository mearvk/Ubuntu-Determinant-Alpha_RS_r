#: ../data/apt_check.py:243
#, python-format
msgid "%i update can be applied immediately."
msgid_plural "%i updates can be applied immediately."
msgstr[0] "את אחד (%i) מהעדכונים האלו ניתן להחיל מיד."
msgstr[1] "את %i מהעדכונים האלו ניתן להחיל מיד."

#: ../data/apt_check.py:256
