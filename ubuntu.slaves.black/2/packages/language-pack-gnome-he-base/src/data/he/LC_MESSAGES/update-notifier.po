msgstr[1] "%i מהעדכונים האלו הם עדכוני אבטחה רגילים."

#: ../data/apt_check.py:266
msgid "To see these additional updates run: apt list --upgradable"
msgstr "כדי לצפות בעדכונים נוספים יש להריץ: apt list --upgradable"

