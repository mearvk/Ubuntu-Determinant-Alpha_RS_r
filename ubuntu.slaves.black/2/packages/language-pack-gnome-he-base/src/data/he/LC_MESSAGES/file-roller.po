msgid "Sort type"
msgstr "Sort type"

#: data/org.gnome.FileRoller.gschema.xml:64
msgid ""
"Whether to sort in ascending or descending direction. Possible values: "
"ascending, descending."
msgstr ""
"Whether to sort in ascending or descending direction. Possible values: "
"ascending, descending."

