"No network connection detected, you can not download changelog information."
msgstr ""
"Non se detectou ningunha conexión de rede; non é posíbel descargar a "
"información do rexistro de cambios."

#: ../UpdateManager/UpdatesAvailable.py:644
msgid "Downloading list of changes..."
msgstr "Descargando a lista de cambios..."

#: ../UpdateManager/UpdatesAvailable.py:690
msgid "_Deselect All"
msgstr "_Anular toda a selección"

#: ../UpdateManager/UpdatesAvailable.py:697
msgid "Select _All"
msgstr "Seleccionar _todo"

