#: data/mousetweaks.ui:8
msgid "Hover Click"
msgstr "Pulsación ao pasar por enriba"

#: data/mousetweaks.ui:56
msgid "Single Click"
msgstr "Clic único"

#: data/mousetweaks.ui:111
msgid "Double Click"
msgstr "Dobre clic"

#. 'Drag' like in a Drag and Drop operation
#: data/mousetweaks.ui:166
msgid "Drag"
msgstr "Arrastrar"

#: data/mousetweaks.ui:221
msgid "Secondary Click"
msgstr "Pulsación secundaria"

#: data/mousetweaks.ui:249
msgid "Button Style"
msgstr "Estilo de botón"

#: data/mousetweaks.ui:257
msgid "Text only"
msgstr "Só texto"

#: data/mousetweaks.ui:267
msgid "Icons only"
msgstr "Só iconas"

#: data/mousetweaks.ui:277
msgid "Text and Icons"
msgstr "Iconas e texto"

#: data/mousetweaks.ui:287
msgid "Orientation"
msgstr "Orientación"

#. Buttons are arranged from left to right in the layout
#: data/mousetweaks.ui:295
msgid "Horizontal"
msgstr "Horizontal"

#. Buttons are arranged from top to bottom in the layout
#: data/mousetweaks.ui:305
msgid "Vertical"
msgstr "Vertical"

#: data/org.gnome.mousetweaks.gschema.xml:5
msgid "Click-type window style"
msgstr "Estilo da xanela do tipo de pulsación"

#: data/org.gnome.mousetweaks.gschema.xml:6
msgid "Button style of the click-type window."
msgstr "Estilo do botón da xanela do tipo de pulsación."

#: data/org.gnome.mousetweaks.gschema.xml:10
msgid "Click-type window orientation"
msgstr "Orientación da xanela do tipo de pulsación"

#: data/org.gnome.mousetweaks.gschema.xml:11
msgid "Orientation of the click-type window."
msgstr "Orientación da xanela do tipo de botón."

#: data/org.gnome.mousetweaks.gschema.xml:15 src/mt-main.c:638
msgid "Click-type window geometry"
msgstr "Xeometría da xanela do tipo de pulsación"

#: data/org.gnome.mousetweaks.gschema.xml:16
msgid ""
"Size and position of the click-type window. The format is a standard X "
"Window System geometry string."
msgstr ""
"Tamaño e posición da xanela do tipo de pulsación. O formato é unha cadea de "
"xeometría estándar do sistema X Window."

#: src/mt-main.c:624
msgid "Enable dwell click"
msgstr "Activar o clic de espera"

#: src/mt-main.c:626
msgid "Enable simulated secondary click"
msgstr "Activar o clic secundario simulado"

#: src/mt-main.c:628
msgid "Time to wait before a dwell click"
msgstr "O tempo de espera antes dun clic de espera"

#: src/mt-main.c:630
msgid "Time to wait before a simulated secondary click"
msgstr "O tempo de espera antes de simular un clic secundario"

#: src/mt-main.c:632
msgid "Set the active dwell mode"
msgstr "Estabelecer modo de espera como activo"

#: src/mt-main.c:634
msgid "Hide the click-type window"
msgstr "Ocultar a xanela do tipo de pulsación"

#: src/mt-main.c:636
msgid "Ignore small pointer movements"
msgstr "Ignorar os pequenos movementos do punteiro"

#: src/mt-main.c:640
msgid "Shut down mousetweaks"
msgstr "Pechar os Axustes finos do rato"

#: src/mt-main.c:642
msgid "Start mousetweaks as a daemon"
msgstr "Iniciar Axustes finos do rato como daemon do sistema"

#: src/mt-main.c:644
msgid "Start mousetweaks in login mode"
msgstr "Iniciar Axustes finos do rato no modo de inicio de sesión"

#: src/mt-main.c:662
msgid "- GNOME mouse accessibility daemon"
msgstr "- «Daemon» de accesibilidade do rato do GNOME"

#: src/mt-main.c:814
msgid "Shutdown failed or nothing to shut down.\n"
msgstr "Non foi posíbel apagar ou non había nada que apagar.\n"

#: src/mt-main.c:816
msgid "Shutdown successful.\n"
msgstr "Apagado realizado correctamente.\n"

#: src/mt-main.c:824
#, c-format
msgid "Mousetweaks is already running. (PID %u)\n"
msgstr "Mousetweaks xa está en execución. (PID %u)\n"

#: src/mt-main.c:830
msgid "Starting daemon.\n"
msgstr "A iniciar o daemon.\n"

#: src/mt-common.c:97
msgid "Failed to Display Help"
msgstr "Produciuse un erro ao mostrar a axuda"
