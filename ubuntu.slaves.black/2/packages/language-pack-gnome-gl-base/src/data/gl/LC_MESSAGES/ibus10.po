#. Translators: Here “Preload” is a verb
#: data/dconf/org.freedesktop.ibus.gschema.xml:11
msgid "Preload engines"
msgstr "Precargar motores"

#. Translators: Tooltip for the button “Preload Engines”
#: data/dconf/org.freedesktop.ibus.gschema.xml:13
msgid "Preload engines during ibus starts up"
msgstr "Precargar os motores durante o inicio de ibus"

#: data/dconf/org.freedesktop.ibus.gschema.xml:17
msgid "Engines order"
msgstr "Orde dos motores"

#: data/dconf/org.freedesktop.ibus.gschema.xml:18
msgid "Saved engines order in input method list"
msgstr "Gardouse a orde dos motores na lista de métodos de entrada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:22
msgid "Popup delay milliseconds for IME switcher window"
msgstr ""
"Milisegundos para que apareza a xanela do selector de método de entrada."

#: data/dconf/org.freedesktop.ibus.gschema.xml:23
msgid ""
"Set popup delay milliseconds to show IME switcher window. The default is "
"400. 0 = Show the window immediately. 0 < Delay milliseconds. 0 > Do not "
"show the window and switch prev/next engines."
msgstr ""

#: data/dconf/org.freedesktop.ibus.gschema.xml:27
msgid "Saved version number"
msgstr "Gardouse o número da vesión"

#: data/dconf/org.freedesktop.ibus.gschema.xml:28
msgid ""
"The saved version number will be used to check the difference between the "
"version of the previous installed ibus and one of the current ibus."
msgstr ""
"O número gardado da versión usarase para comprobar a diferenza entre a "
"versión anterior instalada do ibus e unha das versións actuais."

#: data/dconf/org.freedesktop.ibus.gschema.xml:80
msgid "Latin layouts which have no ASCII"
msgstr "Disposicións latinas sen ASCII"

#: data/dconf/org.freedesktop.ibus.gschema.xml:81
msgid "US layout is appended to the Latin layouts. variant can be omitted."
msgstr ""
"A disposición dos EUA amécese ás disposicións latinas, a variante pode ser "
"omitida."

#: data/dconf/org.freedesktop.ibus.gschema.xml:85
msgid "Use xmodmap"
msgstr "Usar xmodmap"

#: data/dconf/org.freedesktop.ibus.gschema.xml:86
msgid ""
"Run xmodmap if .xmodmap or .Xmodmap exists when ibus engines are switched."
msgstr ""
"Executar xmodmap se existen .xmodmap ou .Xmodmap cando se cambian os motores "
"do ibus."

#: data/dconf/org.freedesktop.ibus.gschema.xml:90 setup/setup.ui:1220
msgid "Use system keyboard layout"
msgstr "Usar disposición do teclado do sistema"

#: data/dconf/org.freedesktop.ibus.gschema.xml:91 setup/setup.ui:1225
msgid "Use system keyboard (XKB) layout"
msgstr "Usar disposición do teclado do sistema (XKB)"

#: data/dconf/org.freedesktop.ibus.gschema.xml:95
msgid "Embed Preedit Text"
msgstr "Inserir texto preeditado"

#: data/dconf/org.freedesktop.ibus.gschema.xml:96
msgid "Embed Preedit Text in Application Window"
msgstr "Inserir texto previamente editado na xanela do aplicativo"

#: data/dconf/org.freedesktop.ibus.gschema.xml:100
msgid "Use global input method"
msgstr "Usar o método de entrada global"

#: data/dconf/org.freedesktop.ibus.gschema.xml:101 setup/setup.ui:1269
msgid "Share the same input method among all applications"
msgstr "Compartir o mesmo método de entrada con todos os aplicativos"

#: data/dconf/org.freedesktop.ibus.gschema.xml:105
msgid "Enable input method by default"
msgstr "Activar o método de entrada predefinido"

#: data/dconf/org.freedesktop.ibus.gschema.xml:106
msgid "Enable input method by default when the application gets input focus"
msgstr ""
"Activar o método de entrada por omisión cando o aplicativo en uso solicite "
"algún"

#: data/dconf/org.freedesktop.ibus.gschema.xml:110
msgid "DConf preserve name prefixes"
msgstr "Dconf preserva os prefijos de nomes"

#: data/dconf/org.freedesktop.ibus.gschema.xml:111
msgid "Prefixes of DConf keys to stop name conversion"
msgstr "Prefixos de chaves DConf para deter a conversión de nomes"

#: data/dconf/org.freedesktop.ibus.gschema.xml:118
msgid "Trigger shortcut keys"
msgstr "Activadora dos atallos de teclado"

#: data/dconf/org.freedesktop.ibus.gschema.xml:119
#: data/dconf/org.freedesktop.ibus.gschema.xml:124 setup/setup.ui:236
msgid "The shortcut keys for turning input method on or off"
msgstr "Atallo de teclado para encender ou apagar el método de entrada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:123
msgid "Trigger shortcut keys for gtk_accelerator_parse"
msgstr "Activadora de atallo do teclado de gtk_accelerator_parse"

#: data/dconf/org.freedesktop.ibus.gschema.xml:128
msgid "Enable shortcut keys"
msgstr "Activar atallos de teclado"

#: data/dconf/org.freedesktop.ibus.gschema.xml:129
msgid "The shortcut keys for turning input method on"
msgstr "Os atallos de teclado para activar o método de entrada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:133
msgid "Disable shortcut keys"
msgstr "Desactivar atallos de teclado"

#: data/dconf/org.freedesktop.ibus.gschema.xml:134
msgid "The shortcut keys for turning input method off"
msgstr "Os atallos de teclado para desactivar o método de entrada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:138
#: data/dconf/org.freedesktop.ibus.gschema.xml:143
msgid "Next engine shortcut keys"
msgstr "Atallo de teclado para o siguinte motor"

#: data/dconf/org.freedesktop.ibus.gschema.xml:139
#: data/dconf/org.freedesktop.ibus.gschema.xml:144
msgid "The shortcut keys for switching to the next input method in the list"
msgstr ""
"A tecla de atallo de teclado para cambiar ao seguinte método de entrada na "
"lista"

#: data/dconf/org.freedesktop.ibus.gschema.xml:148
#: data/dconf/org.freedesktop.ibus.gschema.xml:153
msgid "Prev engine shortcut keys"
msgstr "Atallo de teclado para o motor previo"

#: data/dconf/org.freedesktop.ibus.gschema.xml:149
#: data/dconf/org.freedesktop.ibus.gschema.xml:154
msgid "The shortcut keys for switching to the previous input method"
msgstr ""
"Os atallos de teclado para retroceder ao método de entrada anterior na lista"

#: data/dconf/org.freedesktop.ibus.gschema.xml:160
msgid "Auto hide"
msgstr "Ocultar automáticamente"

#: data/dconf/org.freedesktop.ibus.gschema.xml:161
msgid ""
"The behavior of property panel. 0 = Do not show, 1 = Auto hide, 2 = Always "
"show"
msgstr ""
"Comportamento do panel de propiedades. 0 = Non mostrar, 1 = Ocultar "
"automaticamente, 2 = Mostrar sempre"

#: data/dconf/org.freedesktop.ibus.gschema.xml:165
#: data/dconf/org.freedesktop.ibus.gschema.xml:169
msgid "Language panel position"
msgstr "Posición do panel de idioma"

#: data/dconf/org.freedesktop.ibus.gschema.xml:173
msgid "Follow the input cursor in case the panel is always shown"
msgstr ""
"Seguir o cursor de entrada no caso de que o panel estea sempre visíbel"

#: data/dconf/org.freedesktop.ibus.gschema.xml:174
msgid ""
"If true, the panel follows the input cursor in case the panel is always "
"shown. If false, the panel is shown at a fixed location."
msgstr ""
"Se está activado, o panel seguirá o cursor de entrada no caso de que aquel "
"estea sempre visíbel. Se está desactivado, o panel mostrarase nunha posición "
"fixa."

#: data/dconf/org.freedesktop.ibus.gschema.xml:178
msgid "The milliseconds to show property panel"
msgstr "Milisegundos antes de mostrar o panel de propiedades"

#: data/dconf/org.freedesktop.ibus.gschema.xml:179
msgid ""
"The milliseconds to show property panel after focus-in or properties are "
"changed."
msgstr ""
"Milisegundos antes de mostrar o panel de propiedades despois de que cambien "
"o foco ou as propidades."

#: data/dconf/org.freedesktop.ibus.gschema.xml:183
msgid "Orientation of lookup table"
msgstr "Orientación de busca na táboa"

#: data/dconf/org.freedesktop.ibus.gschema.xml:184
msgid "Orientation of lookup table. 0 = Horizontal, 1 = Vertical"
msgstr "Orientación da táboa de búsqueda. 0 = Horizontal, 1 = Vertical"

#: data/dconf/org.freedesktop.ibus.gschema.xml:188
#: data/dconf/org.freedesktop.ibus.gschema.xml:189 setup/setup.ui:482
#: setup/setup.ui:487
msgid "Show icon on system tray"
msgstr "Mostrar unha icona na área de notificación"

#: data/dconf/org.freedesktop.ibus.gschema.xml:193
msgid "Show input method name"
msgstr "Mostrar o nome do método de entrada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:194 setup/setup.ui:501
msgid "Show input method name on language bar"
msgstr "Mostrar o nome do método de entrada na barra de idioma"

#: data/dconf/org.freedesktop.ibus.gschema.xml:198
msgid "RGBA value of XKB icon"
msgstr "Valor RGBA da icona XKB"

#: data/dconf/org.freedesktop.ibus.gschema.xml:199
msgid ""
"XKB icon shows the layout string and the string is rendered with the RGBA "
"value. The RGBA value can be 1. a color name from X11, 2. a hex value in "
"form '#rrggbb' where 'r', 'g' and 'b' are hex digits of the red, green, and "
"blue, 3. a RGB color in form 'rgb(r,g,b)' or 4. a RGBA color in form "
"'rgba(r,g,b,a)' where 'r', 'g', and 'b' are either integers in the range 0 "
"to 255 or percentage values in the range 0% to 100%, and 'a' is a floating "
"point value in the range 0 to 1 of the alpha."
msgstr ""

#: data/dconf/org.freedesktop.ibus.gschema.xml:203
msgid "The milliseconds to show the panel icon for a property"
msgstr "Milisegundos para mostrar a icona do panel dunha propiedade"

#: data/dconf/org.freedesktop.ibus.gschema.xml:204
msgid ""
"The milliseconds to show the panel icon from the engine icon to a property "
"icon whenever engines are switched if the property is specified by the value "
"of icon-prop-key in IBusEngineDesc. If the value is 0, no delay time and the "
"property icon is shown immediately."
msgstr ""
"Milisegundos para mostrar a icona do panel desde a icona da engranaxe a unha "
"icona de propiedades cando as engranaxes están cambiadas se a propiedade se "
"indica por un valor de icon-prop-key no IBusEngineDesc. Se o valor é 0, non "
"hai tempo de retraso e a icona da propiedade móstrase inmediatamente."

#: data/dconf/org.freedesktop.ibus.gschema.xml:208
msgid "Use custom font"
msgstr "Empregar fonte personalizada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:209
msgid "Use custom font name for language panel"
msgstr "Usar un nome de tipografía personalizada para o panel de idioma"

#: data/dconf/org.freedesktop.ibus.gschema.xml:213
#: data/dconf/org.freedesktop.ibus.gschema.xml:260
msgid "Custom font"
msgstr "Fonte personalizada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:214
msgid "Custom font name for language panel"
msgstr "Nome do tipo de letra personalizado para o panel de linguaxe"

#: data/dconf/org.freedesktop.ibus.gschema.xml:238 setup/setup.ui:1317
msgid "Choose glyphs with input method's language on candidate window"
msgstr ""

#: data/dconf/org.freedesktop.ibus.gschema.xml:239
msgid ""
"Some code points have the different glyphs and Pango determines the glyphs "
"from the language attribute. Pango chooses glyphs from the IBus engine's "
"language if the value is true and choose them from the desktop locale if the "
"value is false."
msgstr ""

#: data/dconf/org.freedesktop.ibus.gschema.xml:250
msgid "Unicode shortcut keys for gtk_accelerator_parse"
msgstr "Atallos de teclado de Unicode para gtk_accelerator_parse"

#: data/dconf/org.freedesktop.ibus.gschema.xml:251
msgid "The shortcut keys for turning Unicode typing on or off"
msgstr "As teclas de atallo para activar e desactivar a escrita en Unicode"

#: data/dconf/org.freedesktop.ibus.gschema.xml:255
msgid "Emoji shortcut keys for gtk_accelerator_parse"
msgstr "Atallos do teclado dos «emojis» para gtk_accelerator_parse"

#: data/dconf/org.freedesktop.ibus.gschema.xml:256
msgid "The shortcut keys for turning emoji typing on or off"
msgstr ""
"Atallos do teclado para activar ou desactivar a escritura dos «emojis»"

#: data/dconf/org.freedesktop.ibus.gschema.xml:261
msgid "Custom font name for emoji characters on emoji dialog"
msgstr ""
"Nome do tipo de letra personalizado para caracteres emoji en diálogos emoji"

#: data/dconf/org.freedesktop.ibus.gschema.xml:265
msgid "Default language for emoji dictionary"
msgstr "Idioma predeterminado para o dicionario de «emojis»"

#: data/dconf/org.freedesktop.ibus.gschema.xml:266
msgid ""
"Choose a default language of emoji dictionaries on the emoji dialog. The "
"value $lang is applied to /usr/share/ibus/dicts/emoji-$lang.dict ."
msgstr ""
"Escolla un idioma predeterminado de dicionarios de emoji na caixa de diálogo "
"de emoji. O valor $lang aplícase a /usr/share/ibus/dicts/emoji-$lang.dict ."

#: data/dconf/org.freedesktop.ibus.gschema.xml:270
msgid "favorite emoji list on emoji dialog"
msgstr "lista de «emojis» favoritos no diálogo de «emojis»"

#: data/dconf/org.freedesktop.ibus.gschema.xml:271
msgid ""
"You can show the favorite emojis on emoji list if this list has any "
"characters."
msgstr ""
"Pode mostrar os «emojis» na lista de «emojis» se esta lista ten algún "
"carácter."

#: data/dconf/org.freedesktop.ibus.gschema.xml:275
msgid "favorite emoji annotation list on emoji dialog"
msgstr "lista de anotacións dos «emojis» favoritos no diálogo de «emojis»"

#: data/dconf/org.freedesktop.ibus.gschema.xml:276
msgid "You can assign an annotation for a favorite emoji in this list."
msgstr "Pode asignar unha nota a un «emoji» favorito da lista."

#: data/dconf/org.freedesktop.ibus.gschema.xml:280
msgid "Whether emoji annotations can be match partially or not"
msgstr "Indica se as notas dos «emojis» poden coincidir parcialmente ou non"

#: data/dconf/org.freedesktop.ibus.gschema.xml:281
msgid ""
"Whether emoji annotations can be matched with a partial string instead of "
"the exact match or not."
msgstr ""
"Indica se as notas dos «emojis» poden coincidir cunha cadea parcial no canto "
"dunha coincidencia total."

#: data/dconf/org.freedesktop.ibus.gschema.xml:285
msgid "Match emoji annotations with the specified length"
msgstr "Coincidencias de notas de «emojis» coa lonxitude indicada"

#: data/dconf/org.freedesktop.ibus.gschema.xml:286
msgid ""
"Match emoji annotations partially with more than the specified number of "
"characters instead of the exact match."
msgstr ""
"Buscar notas de «emojis» que coincidan parcialmente con máis do número de "
"caracteres indicados no canto do número exacto."

#: data/dconf/org.freedesktop.ibus.gschema.xml:290
msgid "Choose a condition to match emoji annotations partially"
msgstr ""
"Seleccionar unha condición para buscar notas de «emojis» que coincidan "
"parcialmente"

#: data/dconf/org.freedesktop.ibus.gschema.xml:291
msgid ""
"Choose one of the following conditions to match emoji annotations partially: "
"0 == Prefix match, 1 == Suffix match, 2 == Containing match"
msgstr ""
"Seleccionar unha das seguintes condicións para buscar notas de «emojis» que "
"coincidan parcialmente: 0 == coincidencia de prefixo, 1 == coincidencia de "
"sufixo, 2 == coincidencia de contido"

#: data/dconf/org.freedesktop.ibus.gschema.xml:295
msgid "Load the emoji data at the time of startup"
msgstr "Cargar os datos de emoji no inicio"

#: data/dconf/org.freedesktop.ibus.gschema.xml:296
msgid ""
"Load the emoji data at the time of startup if true. About 10MB memory is "
"needed to load the data. Load the emoji data when open the emoji dialog at "
"the beginning if false."
msgstr ""
"Cargar os datos de emoji no inicio se for verdadeiro. Precísanse duns 10 MB "
"de memoria. Cargar os datos de emoji ao abrir os diálogos de emoji no inicio "
"se for falso."

#: data/dconf/org.freedesktop.ibus.gschema.xml:300
msgid "Load the Unicode data at the time of startup"
msgstr "Cargar os datos de Unicode no inicio"

#: data/dconf/org.freedesktop.ibus.gschema.xml:301
msgid ""
"Load the Unicode data at the time of startup if true. About 15MB memory is "
"needed to load the data. Load the Unicode data when open the emoji dialog at "
"the beginning if false. The Unicode data is always loaded after the emoji "
"data is loaded even if true."
msgstr ""
"Cargar os datos de Unicode no inicio se for verdadeiro. Precísanse duns 15 "
"MB de memoria. Cargar os datos de Unicode ao abrir os diálogos de emoji no "
"inicio se for falso. Os datos de Unicode cárganse sempre despois dos datos "
"de emoji se se carga mesmo se for verdadeiro."

