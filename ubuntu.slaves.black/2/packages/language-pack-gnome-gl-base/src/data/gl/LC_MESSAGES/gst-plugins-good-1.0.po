"Produciuse un fallo ao enumerar os formatos de vídeo posíbeis cos que o "
"dispositivo «%s» pode reproducir"

#: sys/v4l2/gstv4l2object.c:3238
#, c-format
msgid "Could not map buffers from device '%s'"
msgstr "Non foi posíbel mapear os búferes do dispositivo «%s»"

#: sys/v4l2/gstv4l2object.c:3246
#, c-format
msgid "The driver of device '%s' does not support the IO method %d"
msgstr "O controlador do dispositivo «%s» non admite o método IO %d"

#: sys/v4l2/gstv4l2object.c:3253
#, c-format
msgid "The driver of device '%s' does not support any known IO method."
msgstr ""
"O controlador do dispositivo «%s» non admite calquera método IO coñecido."

#: sys/v4l2/gstv4l2object.c:4125
msgid "Invalid caps"
msgstr ""

#: sys/v4l2/gstv4l2object.c:4132 sys/v4l2/gstv4l2object.c:4156
#, c-format
msgid "Device '%s' has no supported format"
msgstr "O dispositivo «%s» non ten un formato compatíbel"

#: sys/v4l2/gstv4l2object.c:4138 sys/v4l2/gstv4l2object.c:4162
#, c-format
msgid "Device '%s' failed during initialization"
msgstr "Produciuse un fallo durante a iniciación do dispositivo «%s»"

#: sys/v4l2/gstv4l2object.c:4150
#, c-format
msgid "Device '%s' is busy"
msgstr "O dispositivo «%s» está ocupado"

#: sys/v4l2/gstv4l2object.c:4173
#, c-format
msgid "Device '%s' cannot capture at %dx%d"
msgstr "O dispositivo «%s» non pode capturar a %dx%d"

#: sys/v4l2/gstv4l2object.c:4182
#, c-format
msgid "Device '%s' cannot capture in the specified format"
msgstr "O dispositivo «%s» non pode capturar o formato especificado"

#: sys/v4l2/gstv4l2object.c:4193
#, c-format
msgid "Device '%s' does support non-contiguous planes"
msgstr "O dispositivo «%s» non admite planos non contiguos"

#: sys/v4l2/gstv4l2object.c:4208
#, c-format
msgid "Device '%s' does not support %s interlacing"
msgstr "O dispositivo «%s»  non acepta o entrelazado %s"

#: sys/v4l2/gstv4l2object.c:4222
#, c-format
msgid "Device '%s' does not support %s colorimetry"
msgstr "O dispositivo «%s»  non acepta a colorimetría %s"

#: sys/v4l2/gstv4l2object.c:4234
#, c-format
msgid "Could not get parameters on device '%s'"
msgstr "Non foi posíbel obter os parámetros para o dispositivo «%s»"

#: sys/v4l2/gstv4l2object.c:4242
msgid "Video device did not accept new frame rate setting."
msgstr ""
"O dispositivo de vídeo non acepta a nova configuración de taxa de marcos."

#: sys/v4l2/gstv4l2object.c:4383
msgid "Video device did not provide output format."
msgstr "O dispositivo de vídeo non proporciona un formato de saída."

#: sys/v4l2/gstv4l2object.c:4389
msgid "Video device returned invalid dimensions."
msgstr "O dispositivo de vídeo devolveu unhas dimensións incorrectas."

#: sys/v4l2/gstv4l2object.c:4397
msgid "Video device uses an unsupported interlacing method."
msgstr "O dispositivo de vídeo usa un método de entrelazado non compatíbel."

#: sys/v4l2/gstv4l2object.c:4404
msgid "Video device uses an unsupported pixel format."
msgstr "O dispositivo de vídeo usa un formato de píxel non compatíbel."

#: sys/v4l2/gstv4l2object.c:5319
msgid "Failed to configure internal buffer pool."
msgstr "Produciuse un fallo na configuración do grupo do búfer interno."

#: sys/v4l2/gstv4l2object.c:5325
msgid "Video device did not suggest any buffer size."
msgstr "O dispositivo de vídeo non suxire ningún tamaño para o búfer."

#: sys/v4l2/gstv4l2object.c:5331
msgid "No downstream pool to import from."
msgstr "Ningunha fonte en «downstream» da que importar."

#: sys/v4l2/gstv4l2radio.c:144
#, c-format
