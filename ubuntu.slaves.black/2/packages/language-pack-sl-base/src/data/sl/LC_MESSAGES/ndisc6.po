#, c-format
msgid "%s: invalid hop limit\n"
msgstr "%s: neveljavna hop omejitev\n"

#: src/traceroute.c:1287
#, c-format
msgid "%s: invalid packet length\n"
msgstr "%s: neveljavna dolžina paketa\n"
