#: apt-private/private-cacheset.cc:411 apt-private/private-install.cc:1138
#, c-format
msgid "Package '%s' is not installed, so not removed. Did you mean '%s'?\n"
msgstr ""
"Paket '%s' ni nameščen, zato ni bil odstranjen. Ali ste mislili '%s'?\n"

