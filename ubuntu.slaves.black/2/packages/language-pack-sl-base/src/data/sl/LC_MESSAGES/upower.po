#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "Končaj po kratki zakasnitvi"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "Končaj, ko se programnik naloži"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr "Zamenjaj odzadnji program"

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "Prikaži dodatne podrobnosti razhroščevanja"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "Oštevilči poti predmetov za naprave"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "Izpiše vse parametre za vse predmete"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "Pridobi podatke bujenja"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "Nadzoruj dejavnost iz ozadnjega programa porabe"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "Nadziraj s podrobnostmi"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "Pokaži podatke o poti predmeta"
