#: byobu-config:92
msgid "Change keybinding set"
msgstr "Spremeni nabor tipkovnih bližnjic"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Spremeni ubežno zaporedje"

#: byobu-config:94
msgid "Create new windows"
msgstr "Ustvari nova okna"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Upravljaj s privzetimi okni"

