#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Serveris %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Galvenais serveris"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Pašizvēlētie serveri"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr ""

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Nepareizs unikoda kods “%s” (%s) aprakstā. Lūdzu, ziņojiet par šo kļūdu."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Izmaiņu saraksts nav pieejams"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Izmaiņu saraksts vēl nav pieejams.\n"
"\n"
"Lūdzu, izmantojiet http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"līdz izmaiņas kļūst pieejamas vai mēģiniet vēlāk vēlreiz."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Neizdevās lejupielādēt izmaiņu sarakstu. \n"
"Lūdzu, pārbaudiet savu Interneta savienojumu."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Neizdevās nolasīt “%s” datņu sarakstu"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Saraksts ar “%s” datnēm, ko neizdevās nolasīt"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Atkarība nav apmierināma — %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Konfliktē ar uzinstalēto pakotni “%s”"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Salauž esošās pakotnes “%(pkgname)s” atkarību %(depname)s (%(deprelation)s "
"%(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Salauž esošās pakotnes “%(pkgname)s” konfliktu — %(targetpkg)s (%(comptype)s "
"%(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Salauž esošo pakotni “%(pkgname)s”, kas konfliktē — “%(targetpkg)s”. Bet "
"“%(debfile)s” to piedāvā no — “%(provides)s”"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Pakotnē nav arhitektūras lauks"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Nepareiza arhitektūra '%s' -- Izpildiet dpkg --add-architecture, lai to "
"pievienotu un vēlāk atjauninātu"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Jaunāka versija jau ir uzinstalēta"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Neizdevās apmierināt visas atkarības (bojāta kešatmiņa)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Nevar uzinstalēt “%s”"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Automātiski atspiests:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Automātiski pārveidots par drukājamu ascii:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr "Instalēt būvēšanas atkarības pirmkoda pakotnei “%s”, kas būvē %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Tiks noņemta svarīga pakotne"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Darīts"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Hit "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Saņemt:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Darbojas]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Datu nesēja maiņa — lūdzu, ievietojiet disku\n"
" “%s”\n"
"dzinī “%s” un piespiediet Enter\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Saņēma %sB %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
