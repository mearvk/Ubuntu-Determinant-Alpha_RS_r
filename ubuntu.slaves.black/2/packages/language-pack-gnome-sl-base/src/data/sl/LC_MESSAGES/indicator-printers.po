#: ../src/indicator-printers.c:298
msgid "Printers"
msgstr "Tiskalniki"

#: ../src/indicator-printers-menu.c:200
msgid "Paused"
msgstr "V premoru"

#: ../src/indicator-printer-state-notifier.c:110
#, c-format
msgid "You have %d job queued to print on this printer."
msgid_plural "You have %d jobs queued to print on this printer."
msgstr[0] "Na tem tiskalniku je v vrsti za tiskanje %d poslov."
msgstr[1] "Na tem tiskalniku je v vrsti za tiskanje %d posel."
msgstr[2] "Na tem tiskalniku sta v vrsti za tiskanje %d posla."
msgstr[3] "Na tem tiskalniku sta v vrsti za tiskanje %d posla."

#: ../src/indicator-printer-state-notifier.c:115
msgid "Printing Problem"
msgstr "Težave med tiskanjem"

#: ../src/indicator-printer-state-notifier.c:131
msgid "_Settings…"
msgstr "Na_stavitve ..."

#: ../src/indicator-printer-state-notifier.c:297
#, c-format
msgid "The printer “%s” is low on paper."
msgstr "Tiskalniku “%s”  zmanjkuje papirja."

#: ../src/indicator-printer-state-notifier.c:298
#, c-format
msgid "The printer “%s” is out of paper."
msgstr "Tiskalniku “%s” je zmanjkalo papirja."

#: ../src/indicator-printer-state-notifier.c:299
#, c-format
msgid "The printer “%s” is low on toner."
msgstr "Tiskalniku “%s” zmanjkuje črnila."

#: ../src/indicator-printer-state-notifier.c:300
#, c-format
msgid "The printer “%s” is out of toner."
msgstr "Tiskalniku “%s” je zmanjkalo črnila."

#: ../src/indicator-printer-state-notifier.c:301
#, c-format
msgid "A cover is open on the printer “%s”."
msgstr "Pokrov tikalnika “%s” je odprt."

#: ../src/indicator-printer-state-notifier.c:302
#, c-format
msgid "A door is open on the printer “%s”."
msgstr "Vratca tikalnika “%s” so odprta."

#: ../src/indicator-printer-state-notifier.c:303
#, c-format
msgid "The printer “%s” can’t be used, because required software is missing."
msgstr ""
"Tiskalnika “%s” ni mogoče uporabljati, ker manjka potrebna porogramska "
"oprema."

#: ../src/indicator-printer-state-notifier.c:304
#, c-format
msgid "The printer “%s” is currently off-line."
msgstr "Tiskalnik “%s” trenutno ni povezan."
