msgstr ""
"ಸಂಪರ್ಕ ವಿಳಾಸದ ಪಟ್ಟಿಯಲ್ಲಿ ಮಿಕ್ಕುಳಿದಿರುವ ಸಂಪರ್ಕಗಳನ್ನು ತೋರಿಸಬೇಕೆ ಅಥವ ಬೇಡವೆ."

#: ../data/org.gnome.Empathy.gschema.xml.h:16
msgid "Hide main window"
msgstr "ಮುಖ್ಯ ಕಿಟಕಿಯನ್ನು ಅಡಗಿಸು"

