#: ../patches/11_xephyr_nested.patch:1052
msgid "Disconnect"
msgstr "સંપર્ક તોડવો"

#: ../patches/11_xephyr_nested.patch:1056
msgid "Quit"
msgstr "બહાર નીકળો"
