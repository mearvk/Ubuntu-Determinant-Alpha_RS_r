msgid "Workday end time for Saturday"
msgstr ""

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:38
msgid "Workday start time for Sunday"
msgstr ""

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:39
