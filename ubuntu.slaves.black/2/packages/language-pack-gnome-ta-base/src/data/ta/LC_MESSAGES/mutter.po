#: data/50-mutter-navigation.xml:105
msgid "Switch system controls directly"
msgstr "கணினி கட்டுப்பாடுகளை நேரடியாக மாற்றவும்"

#: data/50-mutter-navigation.xml:110
#| msgid "Switch system controls"
