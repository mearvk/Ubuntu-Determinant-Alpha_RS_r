msgstr "நிற  எடுப்பி"

#: data/gcm-picker.desktop.in:4
msgid "Use the color sensor to sample spot colors"
msgstr "சிறுவட்ட நிறத்தை மாதிரி எடுக்க நிற உணர்வியை பயன்படுத்துக"

