#, c-format
msgid "layout \"%s\""
msgid_plural "layouts \"%s\""
msgstr[0] "నమూనా \"%s\""
msgstr[1] "నమూనా \"%s\""

#. Translators: The count is related to the number of options. The %s
#. * format specifier should not be modified, left "as is".
