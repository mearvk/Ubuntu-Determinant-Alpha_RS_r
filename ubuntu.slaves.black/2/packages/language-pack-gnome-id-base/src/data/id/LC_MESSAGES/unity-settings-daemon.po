msgid "Turn Off"
msgstr "Matikan"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:418
#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:486
msgid "Turn On"
