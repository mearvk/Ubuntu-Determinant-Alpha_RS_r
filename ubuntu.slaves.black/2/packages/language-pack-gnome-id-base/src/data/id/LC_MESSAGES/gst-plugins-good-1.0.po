msgstr "Galat saat mengambil kapabilitas bagi peranti '%s'."

#: sys/v4l2/gstv4l2radio.c:158
#, c-format
msgid "Device '%s' is not a tuner."
msgstr "Peranti '%s' bukan tuner."

#: sys/v4l2/gstv4l2radio.c:185
#, c-format
