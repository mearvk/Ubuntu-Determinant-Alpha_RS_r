#: ../ui/altpreferences.ui.h:11
msgid ""
"Display the playback controls in the toolbar in visually compact style "
"instead of the standard rhythmbox style.\n"
"Always enabled for modern toolbar mode."
msgstr ""
"Display the playback controls in the toolbar in visually compact style "
"instead of the standard Rhythmbox style.\n"
"Always enabled for modern toolbar mode."

#: ../ui/altpreferences.ui.h:27
msgid "Enhanced plugins dialog"
msgstr "Enhanced plugins dialogue"

#: ../ui/altpreferences.ui.h:28
msgid ""
"Show or hide redesigned plugins dialog. It features switches instead of "
"checkboxes and inline toolbar with symbolic icons .  Works best with Gnome "
"based desktop environments."
msgstr ""
"Show or hide redesigned plugins dialogue. It features switches instead of "
"checkboxes and inline toolbar with symbolic icons .  Works best with Gnome "
"based desktop environments."
