#: effects/bulge.effect.desktop.in:5
msgid "Bulges the center of the video"
msgstr "Bulges the centre of the video"

#: effects/inversion.effect.desktop.in:5
msgid "Invert colors of the video input"
msgstr "Invert colours of the video input"

#: effects/mauve.effect.desktop.in:5
msgid "Transform video input into a mauve color"
msgstr "Transform video input into a mauve colour"

#: effects/noir.effect.desktop.in:5
msgid "Transform video input into grayscale"
msgstr "Transform video input into greyscale"

#: effects/pinch.effect.desktop.in:5
msgid "Pinches the center of the video"
msgstr "Pinches the centre of the video"

#: effects/square.effect.desktop.in:5
msgid "Makes a square out of the center of the video"
msgstr "Makes a square out of the centre of the video"

#: effects/stretch.effect.desktop.in:5
msgid "Stretches the center of the video"
msgstr "Stretches the centre of the video"

#: effects/twirl.effect.desktop.in:5
msgid "Twirl the center of the video"
msgstr "Twirl the centre of the video"
