#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:15
msgid ""
"Sound Recorder automatically handles the saving process so that you do not "
"need to worry about accidentally discarding the previous recording."
msgstr ""
"Sound Recorder automatically handles the saving process so that you don't "
"need to worry about accidentally discarding the previous recording."

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:57
msgid "Fix export dialog for recordings disappears shortly after opening"
msgstr "Fix export dialogue for recordings disappears shortly after opening"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:60
msgid "Fix not able to use space bar in recording name input"
msgstr "Fix not being able to use the space bar in recording name input"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:63
msgid "Fix recording is lost when using space bar in name input"
msgstr "Fix recording being lost when using space bar in name input"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:66
msgid "Fix ui becomes unusable and recording is lost after stopping a record"
msgstr ""
"Fix UI becoming unusable and losing a recording after stopping a record"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:88
msgid "Code cleanup and translations updates"
msgstr "Code cleanup and translation updates"

