msgstr "Move to Rubbish Bin"

#: fileItemMenu.js:252
msgid "Empty Trash"
msgstr "Empty the Rubbish Bin"

#: fileItemMenu.js:502
msgid "Can not email a Directory"
msgstr "Cannot e-mail a Directory"

