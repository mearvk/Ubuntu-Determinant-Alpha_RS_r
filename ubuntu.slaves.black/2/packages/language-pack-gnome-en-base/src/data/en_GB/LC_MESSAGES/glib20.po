msgstr "Unable to delete file %s across filesystem boundaries"

#: gio/glocalfile.c:2327 gio/glocalfile.c:2383
#, c-format
msgid "Unable to trash file %s: %s"
msgstr "Unable to move file %s to the Rubbish Bin: %s"

#: gio/glocalfile.c:2389
#, c-format
msgid "Unable to trash file %s"
msgstr "Unable to move file %s to the Rubbish Bin"

