msgid "(*VERB) not recognized"
msgstr "(*VERB) not recognised"

#: glib/gregex.c:727
msgid "\\k is not followed by a braced, angle-bracketed, or quoted name"
msgstr ""
"\\k is not followed by a curly-bracketed, angle-bracketed, or quoted name"

