#: src/findreplace.c:523
msgid ""
"You may only give the offset as:\n"
"  - a positive decimal number, or\n"
"  - a hex number, beginning with '0x', or\n"
"  - a '+' or '-' sign, followed by a relative offset"
msgstr ""
"You may only give the offset as:\n"
"  - a positive decimal number, or\n"
"  - a hex number, beginning with >>0x<<, or\n"
"  - a >>+<< or >>-<< sign, followed by a relative offset"

