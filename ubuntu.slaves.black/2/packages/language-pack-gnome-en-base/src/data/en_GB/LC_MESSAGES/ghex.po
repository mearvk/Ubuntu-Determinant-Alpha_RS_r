#: src/preferences.c:560
msgid ""
"The offset format string contains invalid format specifier.\n"
"Only 'x', 'X', 'p', 'P', 'd' and 'o' are allowed."
msgstr ""
"The offset format string contains invalid format specifier.\n"
"Only >>x<<, >>X<<, >>p<<, >>P<<, >>d<< and >>o<< are allowed."

