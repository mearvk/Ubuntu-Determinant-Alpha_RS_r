#, python-format
msgid "Version %s: \n"
msgstr "Издање %s: \n"

#: ../UpdateManager/UpdatesAvailable.py:631
msgid ""
"No network connection detected, you can not download changelog information."
msgstr ""
"Није откривена веза са мрежом, нећете моћи да преузмете информације о "
"изменама дневника."

#: ../UpdateManager/UpdatesAvailable.py:644
msgid "Downloading list of changes..."
msgstr "Преузимам списак измена..."

#: ../UpdateManager/UpdatesAvailable.py:690
msgid "_Deselect All"
msgstr "_Поништи све"

#: ../UpdateManager/UpdatesAvailable.py:697
msgid "Select _All"
msgstr "Изабери _све"

#: ../UpdateManager/UpdatesAvailable.py:797
#, python-format
msgid "%s will be downloaded."
msgstr "Биће преузет „%s“."

#: ../UpdateManager/UpdatesAvailable.py:812
msgid "The update has already been downloaded."
msgid_plural "The updates have already been downloaded."
msgstr[0] "Ажурирање је већ преузето."
msgstr[1] "Ажурирања су већ преузета."
msgstr[2] "Ажурирања су већ преузета."

#: ../UpdateManager/UpdatesAvailable.py:819
msgid "There are no updates to install."
msgstr "Нема ажурирања за инсталирање."

#: ../UpdateManager/UpdatesAvailable.py:828
msgid "Unknown download size."
msgstr "Непозната величина преузимања."

#: ../UpdateManager/UpdatesAvailable.py:856
#, python-format
msgid ""
"Updated software has been issued since %s %s was released. Do you want to "
"install it now?"
msgstr ""
"Ажуриран софтвер је издат пре %s %s . Да ли желите одмах да га инсталирате?"

#: ../UpdateManager/UpdatesAvailable.py:862
msgid ""
"Updated software is available for this computer. Do you want to install it "
"now?"
msgstr ""
"Ажурирања софтвера су доступна за овај рачунар. Да ли желите сада да их "
"инсталирате?"

#: ../UpdateManager/UpdatesAvailable.py:867
msgid ""
"The computer also needs to restart to finish installing previous updates."
msgstr ""
"Потребно је поново покретање рачунара да би завршио инсталирање претходних "
"ажурирања."

#. print("on_button_install_clicked")
#: ../UpdateManager/UpdatesAvailable.py:898
msgid "Not enough free disk space"
msgstr "Нема довољно слободног простора на диску"

#: ../UpdateManager/UpdatesAvailable.py:900
#, python-format
msgid ""
"The upgrade needs a total of %s free space on disk '%s'. Please free at "
"least an additional %s of disk space on '%s'. %s"
msgstr ""
"Надоградњи је потребно укупно %s слободног простора на диску „%s“. "
"Ослободите барем %s простора на диску „%s“. %s"

#: ../UpdateManager/UpdatesAvailable.py:905
msgid ""
"Remove temporary packages of former installations using 'sudo apt clean'."
msgstr ""
"Уклоните привремене пакете претходних инсталација користећи „sudo apt clean“."

#: ../UpdateManager/UpdatesAvailable.py:909
msgid ""
"You can remove old kernels using 'sudo apt autoremove', and you could also "
"set COMPRESS=xz in /etc/initramfs-tools/initramfs.conf to reduce the size of "
"your initramfs."
msgstr ""
"Можете уклонити стара језгра користећи „sudo apt autoremove“, и можете "
"такође поставити „COMPRESS=xz“ у „/etc/initramfs-tools/initramfs.conf“ да "
"смањите величину ваших „initramfs“-а."

#: ../UpdateManager/UpdatesAvailable.py:914
msgid ""
"Empty your trash and remove temporary packages of former installations using "
"'sudo apt clean'."
msgstr ""
"Испразните смеће и уклоните привремене пакете претходних инсталација "
"користећи „sudo apt clean“."

#: ../UpdateManager/UpdatesAvailable.py:917
msgid "Reboot to clean up files in /tmp."
msgstr "Поново подигните систем да очистите датотеке у директоријуму „/tmp“."

#: ../UpdateManager/UpdatesAvailable.py:979
msgid "Connecting..."
msgstr "Повезујем се..."

#: ../UpdateManager/UpdatesAvailable.py:999
msgid "You may not be able to check for updates or download new updates."
msgstr ""
"Можда нећете бити у могућности да проверите за ажурирањима или да преузмете "
"нова ажурирања."

#: ../UpdateManager/UpdatesAvailable.py:1164
msgid "Improved hardware support"
msgstr "Побољшана хардверска подршка"

#: ../UpdateManager/UpdatesAvailable.py:1168
msgid "Security updates"
msgstr "Сигурносне исправке"

#: ../UpdateManager/UpdatesAvailable.py:1173
msgid "Other updates"
msgstr "Остале исправке"

#: ../UpdateManager/UpdatesAvailable.py:1177
msgid "Updates"
msgstr "Ажурирања"

#: ../UpdateManager/UpdatesAvailable.py:1182
msgid "Unused kernel updates to be removed"
msgstr "Некоришћена ажурирања језгра за уклањање"

#: ../UpdateManager/UpdatesAvailable.py:1188
msgid "Duplicate packages to be removed"
msgstr "Удвостручени пакети за уклањање"

#: ../UpdateManager/UpdatesAvailable.py:1194
msgid "Ubuntu Pro (enable in Settings…)"
msgstr ""

#: ../UpdateManager/UnitySupport.py:73
msgid "Install All Available Updates"
msgstr "Инсталирај све доступне исправке"

#: ../UpdateManager/Core/MyCache.py:459
msgid "This update does not come from a source that supports changelogs."
msgstr "Ово ажурирање не долази са извора који подржава дневнике измена."

#: ../UpdateManager/Core/MyCache.py:466 ../UpdateManager/Core/MyCache.py:508
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Нисам успео да преузмем списак измена.\n"
"Молим проверите вашу интернет везу."

#: ../UpdateManager/Core/MyCache.py:475
#, python-format
msgid ""
"Changes for %s versions:\n"
"Installed version: %s\n"
"Available version: %s\n"
"\n"
msgstr ""
"Промене за %s издања:\n"
"Инсталирано издање: %s\n"
"Доступно издање: %s\n"
"\n"

#: ../UpdateManager/Core/MyCache.py:493
#, python-format
msgid ""
"The changelog does not contain any relevant changes.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Дневник измена не садржи значајне измене.\n"
"\n"
"Користите „http://launchpad.net/ubuntu/+source/%s/%s/+changelog“\n"
"док промене не постану доступне или пробајте касније."

#: ../UpdateManager/Core/MyCache.py:500
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Списак измена још увек није доступан\n"
"\n"
"Користите „http://launchpad.net/ubuntu/+source/%s/%s/+changelog“\n"
"док промене не постану доступне или пробајте касније."

