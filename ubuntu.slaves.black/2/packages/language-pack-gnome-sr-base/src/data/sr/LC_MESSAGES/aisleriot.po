msgstr "sol.desktop"

#: data/sol.metainfo.xml.in:34
msgid "GPL-3.0+ or GFDL-1.3-only"
msgstr "ОЈЛ 3.0+ (GPL-3.0+) или само GFDL-1.3"

#: data/sol.metainfo.xml.in:35
