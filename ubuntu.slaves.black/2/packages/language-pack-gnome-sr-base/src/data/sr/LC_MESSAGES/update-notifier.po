msgstr[1] "%zd тренутна освежења"
msgstr[2] "%zd тренутних освежења"

#: ../src/livepatch-tray.c:168
msgid "An error occured when checking for Livepatch updates."
msgstr "Дошло је до грешке приликом провере за освежењима живе закрпе."

#: ../src/livepatch-tray.c:173
msgid "An error occured when applying Livepatch updates."
msgstr "Дошло је до грешке приликом примене освежења живе закрпе."

