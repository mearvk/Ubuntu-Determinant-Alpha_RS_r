msgid "_Try Again"
msgstr "_Cuba Lagi"

#: ../src/composer/mail-composer.error.xml.h:35
msgid "Your message was sent, but an error occurred during post-processing."
msgstr ""
"Mesej anda telah dihantar, tetapi satu ralat berlaku semasa pasca-"
