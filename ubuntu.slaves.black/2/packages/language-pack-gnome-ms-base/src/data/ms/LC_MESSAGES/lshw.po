#: ../lshw.cc:24
#, c-format
msgid "usage: %s [-format] [-options ...]\n"
msgstr "penggunaan: %s [-format] [-options ...]\n"

#: ../lshw.cc:25
#, c-format
msgid "       %s -version\n"
msgstr "       %s -version\n"

#: ../lshw.cc:27
#, c-format
msgid "\t-version        print program version (%s)\n"
msgstr "\t-version        cetak versi program (%s)\n"

#: ../lshw.cc:28
#, c-format
msgid ""
"\n"
"format can be\n"
msgstr ""
"\n"
"format boleh jadi\n"

#: ../lshw.cc:29
#, c-format
msgid "\t-html           output hardware tree as HTML\n"
msgstr "\t-html           outputkan pepohon perkakasan sebagi HTML\n"

#: ../lshw.cc:30
#, c-format
msgid "\t-xml            output hardware tree as XML\n"
msgstr "\t-xml            outputkan pepohon perkakasan sebagai XML\n"

#: ../lshw.cc:31
#, c-format
msgid "\t-short          output hardware paths\n"
msgstr "\t-short          outputkan laluan perkakasan\n"

#: ../lshw.cc:32
#, c-format
msgid "\t-businfo        output bus information\n"
msgstr "\t-businfo        outputkan maklumat bas\n"

#: ../lshw.cc:34
#, c-format
msgid "\t-X              use graphical interface\n"
msgstr "\t-X              guna antaramuka bergrafik\n"

#: ../lshw.cc:35
#, c-format
msgid ""
"\n"
"options can be\n"
msgstr ""
"\n"
"pilihan boleh jadi\n"

#: ../lshw.cc:37
#, c-format
msgid "\t-class CLASS    only show a certain class of hardware\n"
msgstr "\t-class CLASS    hanya tunjuk kelas perkakasan tertentu\n"

#: ../lshw.cc:38
#, c-format
msgid "\t-C CLASS        same as '-class CLASS'\n"
msgstr "\t-C CLASS        sama seperti '-class CLASS'\n"

#: ../lshw.cc:39
#, c-format
msgid "\t-c CLASS        same as '-class CLASS'\n"
msgstr "\t-c CLASS        sama seperti '-class CLASS'\n"

#: ../lshw.cc:41
#, c-format
msgid "\t-disable TEST   disable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr ""
"\t-disable TEST   lumpuhkan ujian (seperti pci, isapnp, cpuid, dan lain-"
"lain. )\n"

#: ../lshw.cc:43
#, c-format
msgid "\t-enable TEST    enable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr ""
"\t-enable TEST    benarkan ujian (seperti pci, isapnp, cpuid, dan lain-lain. "
")\n"

#: ../lshw.cc:44
#, c-format
msgid "\t-quiet          don't display status\n"
msgstr "\t-quiet          jangan papar status\n"

#: ../lshw.cc:45
#, c-format
msgid ""
"\t-sanitize       sanitize output (remove sensitive information like serial "
"numbers, etc.)\n"
msgstr ""
"\t-sanitize       sanitasikan output (buang maklumat sensitif seperti nombor "
"siri, dan lain-lain.)\n"

#: ../lshw.cc:46
#, c-format
msgid "\t-numeric        output numeric IDs (for PCI, USB, etc.)\n"
msgstr ""
"\t-numeric        outputkan ID bernombor (untuk PCI, USB, dan lain-lain.)\n"

#: ../lshw.cc:119
#, c-format
msgid "the latest version is %s\n"
msgstr "versi terkini ialah %s\n"

#: ../lshw.cc:215
#, c-format
msgid "WARNING: you should run this program as super-user.\n"
msgstr "AMARAN: anda patut jalankan program ini sebagai pengguna-super.\n"

#: ../lshw.cc:243
#, c-format
msgid ""
"WARNING: output may be incomplete or inaccurate, you should run this program "
"as super-user.\n"
msgstr ""
"AMARAN: output mungkin tidak lengkap atau tidak tepat, anda patut jalankan "
"program ini sebagai pengguna-super.\n"
