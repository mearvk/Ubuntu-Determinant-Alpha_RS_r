"IP atau nama pelayan PPTP.\n"
"konfig: parameter pertama pptp"

#: properties/nm-pptp-dialog.ui:384
msgid "Optional"
msgstr ""

#: properties/nm-pptp-dialog.ui:400
msgid "User name"
msgstr ""

#: properties/nm-pptp-dialog.ui:412
msgid ""
"Set the name used for authenticating the local system to the peer to "
"<name>.\n"
"config: user <name>"
msgstr ""
"Tetapkan nama yang diguna untuk mengesahihkan sistem setempat ke rakan ke "
"<name>.\n"
"konfig: uset <name>"

#: properties/nm-pptp-dialog.ui:439
msgid "Password passed to PPTP when prompted for it."
msgstr "Kata laluan diluluskan pada PPTP bila dimaklumkan untuknya."

#: properties/nm-pptp-dialog.ui:451
msgid "Show password"
msgstr "Papar kata laluan"

#: properties/nm-pptp-dialog.ui:468
msgid "NT Domain"
msgstr ""

#: properties/nm-pptp-dialog.ui:480
msgid ""
"Append the domain name <domain> to the local host name for authentication "
"purposes.\n"
"config: domain <domain>"
msgstr ""
"Tambah nama domain <domain> ke nama hos setempat untuk tujuan pengesahihan.\n"
"konfig: domain <domain>"

