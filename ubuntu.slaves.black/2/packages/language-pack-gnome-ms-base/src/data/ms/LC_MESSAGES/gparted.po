#: ../src/lvm2_pv.cc:32
msgid ""
"The LVM2 Physical Volume can not currently be resized because it is a member "
"of an exported Volume Group."
msgstr ""
"Volum Fizikal LVM2 buat masa ini tidak dapat disaiz semula kerana ia adalah "
"ahli Kumpulan Volum tereksport."

