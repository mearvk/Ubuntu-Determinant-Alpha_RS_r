msgstr "Default kumpulan, ditugaskan pada kejadian tetingkap"

#: libgnomekbd/org.gnome.libgnomekbd.desktop.gschema.xml.in:12
#: libgnomekbd/org.gnome.libgnomekbd.desktop.gschema.xml.in:13
