msgstr "Peserta lain tidak boleh memindahkan fail"

#: ../libempathy/empathy-ft-handler.c:748 ../libempathy/empathy-utils.c:256
msgid "Unknown reason"
msgstr "Sebab tak diketahui"

#: ../libempathy/empathy-ft-handler.c:895
