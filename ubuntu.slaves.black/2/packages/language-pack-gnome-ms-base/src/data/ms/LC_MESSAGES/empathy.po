#: ../libempathy/empathy-utils.c:232 ../libempathy/empathy-utils.c:266
#: ../libempathy-gtk/empathy-call-utils.c:42
#: ../libempathy-gtk/empathy-new-message-dialog.c:70
msgid "Network error"
msgstr "Ralat rangkaian"

