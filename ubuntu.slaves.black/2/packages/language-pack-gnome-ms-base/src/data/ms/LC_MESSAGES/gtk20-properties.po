msgstr ""
"Label digunakan bagi item dan butang menu yang mengaktifkan tindakan ini."

#: gtk/gtkaction.c:256
msgid "Short label"
msgstr "Label pendek"

#: gtk/gtkaction.c:257
msgid "A shorter label that may be used on toolbar buttons."
msgstr "Label lebih pendek yang mungkin digunakan pada butang palang alat."

#: gtk/gtkaction.c:265
msgid "Tooltip"
msgstr "Tip Alat"

#: gtk/gtkaction.c:266
msgid "A tooltip for this action."
msgstr "Tip alat bagi tindakan ini."

#: gtk/gtkaction.c:281
msgid "Stock Icon"
msgstr "Ikon Stok"

#: gtk/gtkaction.c:282
msgid "The stock icon displayed in widgets representing this action."
msgstr "Ikon stok dipaparkan pada widget mewakili tindakan ini."

#: gtk/gtkaction.c:302 gtk/gtkstatusicon.c:254
msgid "GIcon"
msgstr "GIcon"

#: gtk/gtkaction.c:303 gtk/gtkcellrendererpixbuf.c:206 gtk/gtkimage.c:341
#: gtk/gtkstatusicon.c:255
msgid "The GIcon being displayed"
msgstr "GIcon sedang dipaparkan"

#: gtk/gtkaction.c:323 gtk/gtkcellrendererpixbuf.c:171 gtk/gtkimage.c:323
#: gtk/gtkprinter.c:160 gtk/gtkstatusicon.c:238 gtk/gtkwindow.c:633
msgid "Icon Name"
msgstr "Nama Ikon"

#: gtk/gtkaction.c:324 gtk/gtkcellrendererpixbuf.c:172 gtk/gtkimage.c:324
#: gtk/gtkstatusicon.c:239
msgid "The name of the icon from the icon theme"
msgstr "Nama ikon daripada tema ikon"

#: gtk/gtkaction.c:331 gtk/gtktoolitem.c:192
msgid "Visible when horizontal"
msgstr "Kelihatan bila mengufuk"

#: gtk/gtkaction.c:332 gtk/gtktoolitem.c:193
msgid ""
"Whether the toolbar item is visible when the toolbar is in a horizontal "
"orientation."
msgstr ""
"Sama ada item palang alat  adalah kelihatan bila palang alat pada orientasi "
"mengufuk."

#: gtk/gtkaction.c:347
msgid "Visible when overflown"
msgstr "Kelihatan bila melimpah"

#: gtk/gtkaction.c:348
msgid ""
"When TRUE, toolitem proxies for this action are represented in the toolbar "
"overflow menu."
msgstr ""
"Bila BENAR, proksi item alat bagi tindakan ini diwakilkan didalam menu "
"limpah palang alat."

#: gtk/gtkaction.c:355 gtk/gtktoolitem.c:199
msgid "Visible when vertical"
msgstr "Kelihatan bila menegak"

#: gtk/gtkaction.c:356 gtk/gtktoolitem.c:200
msgid ""
"Whether the toolbar item is visible when the toolbar is in a vertical "
"orientation."
msgstr ""
"Sama ada item palang alat adalah kelihatan bila palang alat berada pada "
"orientasi menegak."

#: gtk/gtkaction.c:363 gtk/gtktoolitem.c:206
msgid "Is important"
msgstr "adalah penting"

#: gtk/gtkaction.c:364
msgid ""
"Whether the action is considered important. When TRUE, toolitem proxies for "
"this action show text in GTK_TOOLBAR_BOTH_HORIZ mode."
msgstr ""
"Sama ada tindakan dianggap penting. Bila BENAR, proksi item alat bagi "
"tindakan ini paparkan teks didialam mod TK_TOOLBAR_BOTH_HORIZ."

#: gtk/gtkaction.c:372
msgid "Hide if empty"
msgstr "Sembunyi jika kosong"

#: gtk/gtkaction.c:373
msgid "When TRUE, empty menu proxies for this action are hidden."
msgstr "Jika BENAR, proksi menu kosong bagi tindakan ini akan disembunyikan."

#: gtk/gtkaction.c:379 gtk/gtkactiongroup.c:177 gtk/gtkcellrenderer.c:193
#: gtk/gtkwidget.c:594
msgid "Sensitive"
msgstr "Sensitif"

#: gtk/gtkaction.c:380
msgid "Whether the action is enabled."
msgstr "Sama ada tindakan dibenarkan."

