#: gtk/gtkaboutdialog.c:332
msgid "Program name"
msgstr "Nama program"

#: gtk/gtkaboutdialog.c:333
msgid ""
"The name of the program. If this is not set, it defaults to "
"g_get_application_name()"
msgstr ""
"Nama bagi program. Jika ini tidak ditetapkan, nilai lalainya ke "
"g_get_application_name()"

#: gtk/gtkaboutdialog.c:347
msgid "Program version"
msgstr "Versi program"

#: gtk/gtkaboutdialog.c:348
msgid "The version of the program"
msgstr "Versi bagi program"

#: gtk/gtkaboutdialog.c:362
msgid "Copyright string"
msgstr "Rentetan hakcipta"

#: gtk/gtkaboutdialog.c:363
msgid "Copyright information for the program"
msgstr "Maklumat hakcipta program"

#: gtk/gtkaboutdialog.c:380
msgid "Comments string"
msgstr "Rentetan ulasan"

#: gtk/gtkaboutdialog.c:381
msgid "Comments about the program"
msgstr "Ulasan perihal program"

#: gtk/gtkaboutdialog.c:415
msgid "Website URL"
msgstr "URL Laman Sesawang"

#: gtk/gtkaboutdialog.c:416
msgid "The URL for the link to the website of the program"
msgstr "URL bagi pautan ke laman sesawang program"

#: gtk/gtkaboutdialog.c:431
msgid "Website label"
msgstr "Label laman sesawang"

#: gtk/gtkaboutdialog.c:432
msgid ""
"The label for the link to the website of the program. If this is not set, it "
"defaults to the URL"
msgstr ""
"Label bagi pautan ke laman sesawang program. Jika ini tidak ditetapkan, "
"nilai lalainya ke URL."

#: gtk/gtkaboutdialog.c:448
msgid "Authors"
msgstr "Pengarang"

#: gtk/gtkaboutdialog.c:449
msgid "List of authors of the program"
msgstr "Senarai pengarang program"

#: gtk/gtkaboutdialog.c:465
msgid "Documenters"
msgstr "Juru dokumentasi"

#: gtk/gtkaboutdialog.c:466
msgid "List of people documenting the program"
msgstr "Senarai penyumbang dokumentasi program"

#: gtk/gtkaboutdialog.c:482
msgid "Artists"
msgstr "Artis"

#: gtk/gtkaboutdialog.c:483
msgid "List of people who have contributed artwork to the program"
msgstr "Senarai individu yang menyumbang kerja seni program"

#: gtk/gtkaboutdialog.c:500
msgid "Translator credits"
msgstr "Penghargaan penterjemah"

#: gtk/gtkaboutdialog.c:501
msgid ""
"Credits to the translators. This string should be marked as translatable"
msgstr ""
"Penghargaan kepada penterjemah. Rentetan ini akan ditanda sebagai boleh "
"diterjemah"

#: gtk/gtkaboutdialog.c:516
msgid "Logo"
msgstr "Logo"

#: gtk/gtkaboutdialog.c:517
msgid ""
"A logo for the about box. If this is not set, it defaults to "
"gtk_window_get_default_icon_list()"
msgstr ""
"Logo untuk kekotak perihal. Jika ini tidak ditetapkan, nilai lalainya ke "
"gtk_window_get_default_icon_list()"

#: gtk/gtkaboutdialog.c:532
msgid "Logo Icon Name"
msgstr "Nama Ikon Logo"

#: gtk/gtkaboutdialog.c:533
msgid "A named icon to use as the logo for the about box."
msgstr "Ikon bernama yang digunakan sebagai logo pada kekotak perihal."

#: gtk/gtkaboutdialog.c:546
msgid "Wrap license"
msgstr "Lilit lesen"

#: gtk/gtkaboutdialog.c:547
msgid "Whether to wrap the license text."
msgstr "Sama ada hendak lilitkan teks lesen."

#: gtk/gtkaccellabel.c:178
msgid "Accelerator Closure"
msgstr "Penutupan Pemecut"

#: gtk/gtkaccellabel.c:179
msgid "The closure to be monitored for accelerator changes"
msgstr "Penutupan untuk memantau perubahan pemecut"

#: gtk/gtkaccellabel.c:185
msgid "Accelerator Widget"
msgstr "Widget Pemecut"

#: gtk/gtkaccellabel.c:186
msgid "The widget to be monitored for accelerator changes"
msgstr "Widget akan diperhati untuk perubahan pemecut"

