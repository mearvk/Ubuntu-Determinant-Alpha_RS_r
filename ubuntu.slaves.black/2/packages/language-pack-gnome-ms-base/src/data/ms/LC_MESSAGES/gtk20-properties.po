msgstr "Nilai Minimum"

#: gtk/gtkadjustment.c:111
msgid "The minimum value of the adjustment"
msgstr "Nilai minimum pelarasan"

#: gtk/gtkadjustment.c:130
msgid "Maximum Value"
msgstr "Nilai Maksimum"

#: gtk/gtkadjustment.c:131
msgid "The maximum value of the adjustment"
msgstr "Nilai maksimum pelarasan"

#: gtk/gtkadjustment.c:147
msgid "Step Increment"
msgstr "Tokokan Langkah"

#: gtk/gtkadjustment.c:148
msgid "The step increment of the adjustment"
msgstr "Tokokan langkah pelarasan"

#: gtk/gtkadjustment.c:164
msgid "Page Increment"
msgstr "Tokokan Halaman"

#: gtk/gtkadjustment.c:165
msgid "The page increment of the adjustment"
msgstr "Tokokan halaman pelarasan"

#: gtk/gtkadjustment.c:184
msgid "Page Size"
msgstr "Saiz Halaman"

#: gtk/gtkadjustment.c:185
msgid "The page size of the adjustment"
msgstr "Saiz halaman bagi pelarasan"

#: gtk/gtkalignment.c:109
msgid "Horizontal alignment"
msgstr "Jajaran mengufuk"

#: gtk/gtkalignment.c:110 gtk/gtkbutton.c:270
msgid ""
"Horizontal position of child in available space. 0.0 is left aligned, 1.0 is "
"right aligned"
msgstr ""
"Kedudukan mengufuk bagi anak pada ruang yang ada. 0.0 ialah terjajar ke "
"kiri, 1.0 ialah terjajar ke kanan"

#: gtk/gtkalignment.c:119
msgid "Vertical alignment"
msgstr "Jajaran menegak"

#: gtk/gtkalignment.c:120 gtk/gtkbutton.c:289
msgid ""
"Vertical position of child in available space. 0.0 is top aligned, 1.0 is "
"bottom aligned"
msgstr ""
"Kedudukan menegak bagi anak pada ruang yang ada. 0.0 ialah terjajar ke atas, "
"1.0 ialah terjajar ke bawah"

#: gtk/gtkalignment.c:128
msgid "Horizontal scale"
msgstr "Skala mengufuk"

#: gtk/gtkalignment.c:129
msgid ""
"If available horizontal space is bigger than needed for the child, how much "
"of it to use for the child. 0.0 means none, 1.0 means all"
msgstr ""
"Jika ruang mengufuk yang ada lebih besar daripada yang diperlukan oleh "
"anak,berapa banyak ianya digunakan untuk anak. 0.0 bermaksud tiada, 1.0 "
"bermaksud semua"

#: gtk/gtkalignment.c:137
msgid "Vertical scale"
msgstr "Skala menegak"

#: gtk/gtkalignment.c:138
msgid ""
"If available vertical space is bigger than needed for the child, how much of "
"it to use for the child. 0.0 means none, 1.0 means all"
msgstr ""
"Jika ruang menegak yang ada lebih besar daripada yang diperlukan untuk anak, "
"berapa banyak ianya digunakan untuk anak. 0.0 bermaksud tiada, 1.0 bermaksud "
"semua"

#: gtk/gtkalignment.c:155
msgid "Top Padding"
msgstr "Pemadatan Atas"

#: gtk/gtkalignment.c:156
msgid "The padding to insert at the top of the widget."
msgstr "Pemadatan untuk disisipkan pada atas widget."

#: gtk/gtkalignment.c:172
msgid "Bottom Padding"
msgstr "Pemadatan Bawah"

#: gtk/gtkalignment.c:173
msgid "The padding to insert at the bottom of the widget."
msgstr "Pemadatan untuk disisipkan pada bawah widget."

#: gtk/gtkalignment.c:189
msgid "Left Padding"
msgstr "Pemadatan Kiri"

#: gtk/gtkalignment.c:190
msgid "The padding to insert at the left of the widget."
msgstr "Pemadatan untuk disisipkan pada kiri widget."

#: gtk/gtkalignment.c:206
msgid "Right Padding"
msgstr "Pemadatan Kanan"

#: gtk/gtkalignment.c:207
msgid "The padding to insert at the right of the widget."
msgstr "Pemadatan untuk disisipkan pada kanan widget."

#: gtk/gtkarrow.c:95
msgid "Arrow direction"
msgstr "Hala anak panah"

#: gtk/gtkarrow.c:96
msgid "The direction the arrow should point"
msgstr "Hala anak panah patut ditudingi"

#: gtk/gtkarrow.c:104
msgid "Arrow shadow"
msgstr "Bayang anak panah"

#: gtk/gtkarrow.c:105
msgid "Appearance of the shadow surrounding the arrow"
msgstr "Penampilan bayang sekeliling anak panah"

#: gtk/gtkarrow.c:112 gtk/gtkmenu.c:715 gtk/gtkmenuitem.c:368
msgid "Arrow Scaling"
msgstr "Penskalaan Anak Panah"

#: gtk/gtkarrow.c:113
msgid "Amount of space used up by arrow"
msgstr "Jumlanh ruang yang digunakan oleh anak panah"

#: gtk/gtkaspectframe.c:93
msgid "Horizontal Alignment"
msgstr "Jajaran Mengufuk"

#: gtk/gtkaspectframe.c:94
msgid "X alignment of the child"
msgstr "Jajaran X anak"

#: gtk/gtkaspectframe.c:100
msgid "Vertical Alignment"
msgstr "Jajaran Menegak"

#: gtk/gtkaspectframe.c:101
msgid "Y alignment of the child"
msgstr "Jajaran Y anak"

#: gtk/gtkaspectframe.c:107
msgid "Ratio"
msgstr "Nisbah"

#: gtk/gtkaspectframe.c:108
msgid "Aspect ratio if obey_child is FALSE"
msgstr "Nisbah bidang jika obey_child PALSU"

#: gtk/gtkaspectframe.c:114
msgid "Obey child"
msgstr "Ikut anak"

#: gtk/gtkaspectframe.c:115
msgid "Force aspect ratio to match that of the frame's child"
msgstr "Paksa nisbah bidang supaya sepadan dengan kerangka anak"

#: gtk/gtkassistant.c:308
msgid "Header Padding"
msgstr "Pemadatan Pengepala"

#: gtk/gtkassistant.c:309
msgid "Number of pixels around the header."
msgstr "Bilangan piksel disekeliling pengepala."

#: gtk/gtkassistant.c:316
msgid "Content Padding"
msgstr "Pemadatan Kandungan"

#: gtk/gtkassistant.c:317
msgid "Number of pixels around the content pages."
msgstr "Bilangan piksel disekeliliing kandungan halaman."

#: gtk/gtkassistant.c:333
msgid "Page type"
msgstr "Jenis halaman"

#: gtk/gtkassistant.c:334
msgid "The type of the assistant page"
msgstr "Jenis halaman pembantu"

#: gtk/gtkassistant.c:351
msgid "Page title"
msgstr "Tajuk halaman"

#: gtk/gtkassistant.c:352
msgid "The title of the assistant page"
msgstr "Tajuk halaman pembantu"

#: gtk/gtkassistant.c:368
msgid "Header image"
msgstr "Imej pengepala"

#: gtk/gtkassistant.c:369
msgid "Header image for the assistant page"
msgstr "Imej pengepala halaman pembantu"

#: gtk/gtkassistant.c:385
msgid "Sidebar image"
msgstr "Imej palang sisi"

#: gtk/gtkassistant.c:386
msgid "Sidebar image for the assistant page"
msgstr "Imej palang sisi bagi halaman pembantu"

#: gtk/gtkassistant.c:401
msgid "Page complete"
msgstr "Halaman selesai"

#: gtk/gtkassistant.c:402
msgid "Whether all required fields on the page have been filled out"
msgstr "Sama ada semua medan yang diperlukan pada halaman telah diisikan"

#: gtk/gtkbbox.c:101
msgid "Minimum child width"
msgstr "Lebar minimum anak"

#: gtk/gtkbbox.c:102
msgid "Minimum width of buttons inside the box"
msgstr "Lebar minimum butang di dalam kekotak"

#: gtk/gtkbbox.c:110
msgid "Minimum child height"
msgstr "Tinggi minimum anak"

#: gtk/gtkbbox.c:111
msgid "Minimum height of buttons inside the box"
msgstr "Tinggi minimum butang di dalam kekotak"

#: gtk/gtkbbox.c:119
msgid "Child internal width padding"
msgstr "Pemadatan lebar dalaman anak"

#: gtk/gtkbbox.c:120
msgid "Amount to increase child's size on either side"
msgstr "Jumlah untuk meningkatkan saiz anak pada bahagian tepi"

#: gtk/gtkbbox.c:128
msgid "Child internal height padding"
msgstr "Pemadatan tinggi dalaman anak"

#: gtk/gtkbbox.c:129
msgid "Amount to increase child's size on the top and bottom"
msgstr "Jumlah untuk meningkatkan saiz anak pada atas dan bawah"

#: gtk/gtkbbox.c:137
msgid "Layout style"
msgstr "Gaya bentangan"

#: gtk/gtkbbox.c:138
msgid ""
"How to lay out the buttons in the box. Possible values are: default, spread, "
"edge, start and end"
msgstr ""
"Bagaimana hendak susun aturkan butang didalam kekotak. Nilai yang mungkin "
"ialah: lalai, sebaran, bucu, mula dan akhir"

#: gtk/gtkbbox.c:146
msgid "Secondary"
msgstr "Sekunder"

#: gtk/gtkbbox.c:147
msgid ""
"If TRUE, the child appears in a secondary group of children, suitable for, "
"e.g., help buttons"
msgstr ""
"Jika BENAR, anak muncul pada kumpulan kedua anak, sesuai untuk, e.g butang "
"bantuan."

#: gtk/gtkbox.c:130 gtk/gtkexpander.c:221 gtk/gtkiconview.c:666
#: gtk/gtktreeviewcolumn.c:217
msgid "Spacing"
msgstr "Penjarakan"

#: gtk/gtkbox.c:131
msgid "The amount of space between children"
msgstr "Jumlah ruang di antara anak"

#: gtk/gtkbox.c:140 gtk/gtknotebook.c:658 gtk/gtktable.c:165
#: gtk/gtktoolbar.c:575 gtk/gtktoolitemgroup.c:1596
msgid "Homogeneous"
msgstr "Seragam"

#: gtk/gtkbox.c:141
msgid "Whether the children should all be the same size"
msgstr "Sama ada anak patut semuanya pada saiz sama"

#: gtk/gtkbox.c:148 gtk/gtkpreview.c:102 gtk/gtktoolbar.c:567
#: gtk/gtktoolitemgroup.c:1603 gtk/gtktoolpalette.c:1053
#: gtk/gtktreeviewcolumn.c:273
msgid "Expand"
msgstr "Kembang"

#: gtk/gtkbox.c:149
msgid "Whether the child should receive extra space when the parent grows"
msgstr "Sama ada anak patut menerima ruang tambahan bila induk membesar"

#: gtk/gtkbox.c:155 gtk/gtktoolitemgroup.c:1610
msgid "Fill"
msgstr "Isi"

#: gtk/gtkbox.c:156
msgid ""
"Whether extra space given to the child should be allocated to the child or "
"used as padding"
msgstr ""
"Sama ada ruang tambahan yang diberikan ke anak seharusnya diuntukkan ke anak "
"atau digunakan sebagai pemadatan"

#: gtk/gtkbox.c:162
msgid "Padding"
msgstr "Pemadatan"

#: gtk/gtkbox.c:163
msgid "Extra space to put between the child and its neighbors, in pixels"
msgstr ""
"Ruang ekstra untuk diletakkan diantara anak dan jirannya, dalam piksel"

#: gtk/gtkbox.c:169
msgid "Pack type"
msgstr "Jenis pek"

#: gtk/gtkbox.c:170 gtk/gtknotebook.c:742
msgid ""
"A GtkPackType indicating whether the child is packed with reference to the "
"start or end of the parent"
msgstr ""
"GtkPackType menunjukkan sama ada anak dipek dengan rujukan ke permulaan atau "
"akhir bagi induk"

#: gtk/gtkbox.c:176 gtk/gtknotebook.c:720 gtk/gtkpaned.c:241 gtk/gtkruler.c:151
#: gtk/gtktoolitemgroup.c:1624
msgid "Position"
msgstr "Kedudukan"

#: gtk/gtkbox.c:177 gtk/gtknotebook.c:721
msgid "The index of the child in the parent"
msgstr "Indeks anak pada induk"

#: gtk/gtkbuilder.c:96
msgid "Translation Domain"
msgstr "Domain Terjemahan"

#: gtk/gtkbuilder.c:97
msgid "The translation domain used by gettext"
msgstr "Domain terjemahan yang digunakan oleh gettext"

#: gtk/gtkbutton.c:220
msgid ""
"Text of the label widget inside the button, if the button contains a label "
"widget"
msgstr ""
"Teks widget label didalam butang, jika butang mengandungi widget label"

#: gtk/gtkbutton.c:227 gtk/gtkexpander.c:205 gtk/gtklabel.c:528
#: gtk/gtkmenuitem.c:320 gtk/gtktoolbutton.c:211
