#: gtk/gtktreeviewcolumn.c:192 gtk/gtkwidget.c:587
msgid "Visible"
msgstr "Tampak"

#: gtk/gtkaction.c:387
msgid "Whether the action is visible."
msgstr "Sama ada tindakan boleh dilihat."

#: gtk/gtkaction.c:393
msgid "Action Group"
msgstr "Kumpulan Tindakan"

#: gtk/gtkaction.c:394
msgid ""
"The GtkActionGroup this GtkAction is associated with, or NULL (for internal "
"use)."
msgstr ""
"GtkActionGroup bagi GtkAction ini dikaitkan dengan, atau NOL (bagi kegunaan "
"luaran)."

#: gtk/gtkaction.c:412 gtk/gtkimagemenuitem.c:169
msgid "Always show image"
msgstr "Sentiasa paparkan imej"

#: gtk/gtkaction.c:413 gtk/gtkimagemenuitem.c:170
msgid "Whether the image will always be shown"
msgstr "Sama ada imej akan sentiasa dipaparkan"

#: gtk/gtkactiongroup.c:171
msgid "A name for the action group."
msgstr "Nama bagi kumpulan tindakan."

#: gtk/gtkactiongroup.c:178
msgid "Whether the action group is enabled."
msgstr "Sama ada kumpulan tindakan dibenarkan."

#: gtk/gtkactiongroup.c:185
msgid "Whether the action group is visible."
msgstr "Sama ada kumpulan tindakan boleh dilihat."

#: gtk/gtkactivatable.c:308
msgid "Related Action"
msgstr "Tindakan Berkaitan"

#: gtk/gtkactivatable.c:309
msgid "The action this activatable will activate and receive updates from"
msgstr "Tindakan boleh aktif ini akan diaktifkan dan menerima kemaskini dari"

#: gtk/gtkactivatable.c:331
msgid "Use Action Appearance"
msgstr "Guna Penampilan Tindakan"

#: gtk/gtkactivatable.c:332
msgid "Whether to use the related actions appearance properties"
msgstr "Sama ada hendak gunakan ciri-ciri penampilan tindakan yang berkaitan"

