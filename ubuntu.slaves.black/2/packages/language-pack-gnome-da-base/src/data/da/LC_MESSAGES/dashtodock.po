#: Settings.ui.h:106
msgid "About"
msgstr "Om"

#: Settings.ui.h:107
msgid "Customize minimum and maximum opacity values"
msgstr "Tilpas mindste og største værdier for uigennemsigtighed"

#: Settings.ui.h:108
msgid "Minimum opacity"
msgstr "Mindste uigennemsigtighed"

#: Settings.ui.h:109
msgid "Maximum opacity"
msgstr "Største uigennemsigtighed"

#: Settings.ui.h:110
msgid "Number overlay"
msgstr "Overlejring af antal"

#: Settings.ui.h:111
msgid ""
"Temporarily show the application numbers over the icons, corresponding to "
"the shortcut."
msgstr ""
"Viser kortvarigt antallet af programmer over ikonerne svarende til genvejen."

#: Settings.ui.h:112
msgid "Show the dock if it is hidden"
msgstr "Vis dokken, hvis den er skjult"

#: Settings.ui.h:113
msgid ""
"If using autohide, the dock will appear for a short time when triggering the "
"shortcut."
msgstr "Bruges autoskjul, vil dokken vises kortvarigt, når genvejen udløses."

#: Settings.ui.h:114
msgid "Shortcut for the options above"
msgstr "Genvej til indstillingerne ovenfor"

#: Settings.ui.h:115
msgid "Syntax: <Shift>, <Ctrl>, <Alt>, <Super>"
msgstr "Syntaks: <Skift>, <Ctrl>, <Alt>, <Super>"

#: Settings.ui.h:116
msgid "Hide timeout (s)"
msgstr "Forsinkelse for skjul (s)"

#: Settings.ui.h:117
msgid "Show the dock by mouse hover on the screen edge."
msgstr "Vis dokken, når musen svæver over skærmens kant."

#: Settings.ui.h:118
msgid "Autohide"
msgstr "Autoskjul"

#: Settings.ui.h:119
msgid "Push to show: require pressure to show the dock"
msgstr "Tryk for at vise: tryk kræves for at vise dokken"

#: Settings.ui.h:120
msgid "Enable in fullscreen mode"
msgstr "Aktivér i fuldskærmstilstand"

#: Settings.ui.h:122
msgid "Show the dock when it doesn't obstruct application windows."
msgstr "Vis dokken, når den ikke blokerer programvinduer."

#: Settings.ui.h:123
msgid "Dodge windows"
msgstr "Undvig vinduer"

#: Settings.ui.h:124
msgid "All windows"
msgstr "Alle vinduer"

#: Settings.ui.h:125
msgid "Only focused application's windows"
msgstr "Kun det fokuserede programs vinduer"

#: Settings.ui.h:126
msgid "Only maximized windows"
msgstr "Kun maksimerede vinduer"

#: Settings.ui.h:127
msgid "Always on top"
msgstr "Altid øverst"

#: Settings.ui.h:128
msgid "Animation duration (s)"
msgstr "Animationens varighed (s)"

#: Settings.ui.h:129
msgid "Show timeout (s)"
msgstr "Vis varighed (s)"

#: Settings.ui.h:130
msgid "Pressure threshold"
msgstr "Tryktærskel"
