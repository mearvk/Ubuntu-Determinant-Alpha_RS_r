#: Settings.ui.h:89
msgid "Ciliora"
msgstr "Ciliora"

#: Settings.ui.h:90
msgid "Metro"
msgstr "Metro"

#: Settings.ui.h:92
msgid "Set the background color for the dash."
msgstr "Indstil dashs baggrundsfarve."

#: Settings.ui.h:93
msgid "Customize the dash color"
msgstr "Tilpas dashs farve"

#: Settings.ui.h:94
msgid "Tune the dash background opacity."
msgstr "Indstil uigennemsigtigheden for dashs baggrund."

#: Settings.ui.h:96
msgid "Fixed"
msgstr "Fast"

#: Settings.ui.h:97
msgid "Dynamic"
msgstr "Dynamisk"

#: Settings.ui.h:98
msgid "Opacity"
msgstr "Uigennemsigtighed"

#: Settings.ui.h:78
msgid "Force straight corner"
msgstr "Gennemtving ret hjørne"

#: Settings.ui.h:79
msgid "Show overview on startup"
msgstr "Vis oversigt ved opstart"

#: Settings.ui.h:99
msgid "Appearance"
msgstr "Udseende"

#: Settings.ui.h:100
msgid "version: "
msgstr "version: "

#: Settings.ui.h:101
msgid "Moves the dash out of the overview transforming it in a dock"
msgstr "Flytter dash ud af oversigten og gør den til en dok"

#: Settings.ui.h:102
msgid "Created by"
msgstr "Lavet af"

#: Settings.ui.h:103
msgid "Webpage"
