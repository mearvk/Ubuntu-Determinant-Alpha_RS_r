#: Settings.ui.h:1
msgid ""
"When set to minimize, double clicking minimizes all the windows of the "
"application."
msgstr ""
"Når indstillet til at minimere, minimerer dobbeltklik alle programmets "
"vinduer."

#: Settings.ui.h:2
msgid "Shift+Click action"
msgstr "Handling for skift+klik"

#: Settings.ui.h:3
msgid "Raise window"
msgstr "Hæv vindue"

#: Settings.ui.h:4
msgid "Minimize window"
msgstr "Minimér vindue"

#: Settings.ui.h:5
msgid "Launch new instance"
msgstr "Start en ny instans"

#: Settings.ui.h:6
msgid "Cycle through windows"
msgstr "Gennemløb vinduer"

#: Settings.ui.h:7
msgid "Minimize or overview"
msgstr "Minimér eller oversigt"

#: Settings.ui.h:8
msgid "Show window previews"
msgstr "Forhåndsvisninger af vinduer"

#: Settings.ui.h:9
msgid "Minimize or show previews"
msgstr "Minimér eller vis forhåndsvisninger"

#: Settings.ui.h:10
msgid "Focus or show previews"
msgstr "Fokusér eller vis forhåndsvisninger"

#: Settings.ui.h:12
msgid "Focus, minimize or show previews"
msgstr "Giv fokus, minimér eller vis forhåndsvisninger"

#: Settings.ui.h:14
msgid "Quit"
msgstr "Afslut"

#: Settings.ui.h:15
msgid "Behavior for Middle-Click."
msgstr "Opførsel af midterklik."

#: Settings.ui.h:16
msgid "Middle-Click action"
msgstr "Handling for midterklik"

#: Settings.ui.h:17
msgid "Behavior for Shift+Middle-Click."
msgstr "Opførsel af skift+midterklik."

#: Settings.ui.h:18
msgid "Shift+Middle-Click action"
msgstr "Handling for skift+midterklik"

#: Settings.ui.h:19
msgid "Enable Unity7 like glossy backlit items"
msgstr "Aktivér Unity7-lignende blanke baggrundsbelyste elementer"

#: Settings.ui.h:20
msgid "Apply glossy effect."
msgstr "Anvend blankeffekt."

#: Settings.ui.h:21
msgid "Use dominant color"
msgstr "Brug dominerende farve"

#: Settings.ui.h:22
msgid "Customize indicator style"
msgstr "Tilpas indikatorstil"

#: Settings.ui.h:23
msgid "Color"
msgstr "Farve"

#: Settings.ui.h:24
msgid "Border color"
msgstr "Kantfarve"

#: Settings.ui.h:25
msgid "Border width"
msgstr "Kantbredde"

#: Settings.ui.h:26
msgid "Show the dock on"
msgstr "Vis dokken på"

#: Settings.ui.h:25
msgid "Show on all monitors."
msgstr "Vis på alle skærme."

#: Settings.ui.h:28
msgid "Position on screen"
msgstr "Placering på skærmen"

#: Settings.ui.h:30
msgid "Bottom"
msgstr "Nederst"

#: Settings.ui.h:31
msgid "Top"
msgstr "Øverst"

#: Settings.ui.h:33
msgid ""
"Hide the dock when it obstructs a window of the current application. More "
"refined settings are available."
msgstr ""
"Skjul dokken, når den blokerer et vindue i det aktuelle program. Der er "
"yderligere finindstillinger tilgængelige."

#: Settings.ui.h:34
msgid "Intelligent autohide"
msgstr "Intelligent autoskjul"

#: Settings.ui.h:35
msgid "Dock size limit"
msgstr "Grænse for dokkens størrelse"

#: Settings.ui.h:36
msgid "Panel mode: extend to the screen edge"
msgstr "Paneltilstand: udstræk til skærmens kant"

#: Settings.ui.h:38
msgid "Icon size limit"
msgstr "Grænse for ikonernes størrelse"

#: Settings.ui.h:39
msgid "Fixed icon size: scroll to reveal other icons"
msgstr "Fast ikonstørrelse: rul for at få vist andre ikoner"

#: Settings.ui.h:40
msgid "Preview size scale"
msgstr "Størrelsesskala for forhåndsvisning"

#: Settings.ui.h:41
msgid "Position and size"
msgstr "Placering og størrelse"

#: prefs.js:242
msgid "Show favorite applications"
msgstr "Vis favoritprogrammer"

#: Settings.ui.h:43
msgid "Show running applications"
msgstr "Vis kørende programmer"

#: Settings.ui.h:41
msgid "Isolate workspaces."
msgstr "Isolér arbejdsområder."

#: Settings.ui.h:42
msgid "Show urgent windows despite current workspace."
msgstr "Vis vigtige vinduer på trods af nuværende arbejdsområde."

#: Settings.ui.h:43
msgid "Isolate monitors."
msgstr "Isolér skærme."

#: Settings.ui.h:44
msgid "Show open windows previews."
msgstr "Forhåndsvisning af åbne vinduer."

#: Settings.ui.h:48
msgid "Keep the focused application always visible in the dash"
msgstr "Lad programmet med fokus altid være synligt i dash"

#: Settings.ui.h:49
msgid ""
"If disabled, these settings are accessible from gnome-tweak-tool or the "
"extension website."
msgstr ""
"Hvis deaktiveret kan indstillingerne tilgås fra gnome-tweak-tool eller "
"udvidelsens websted."

#: Settings.ui.h:50
msgid "Show <i>Applications</i> icon"
msgstr "Vis ikon for <i>Programmer</i>"

#: Settings.ui.h:48
msgid "Move the applications button at the beginning of the dock."
msgstr "Flyt programknappen til dokkens start."

#: Settings.ui.h:49
msgid "Animate <i>Show Applications</i>."
msgstr "Animér <i>Vis programmer</i>"

#: Settings.ui.h:54
msgid "Show trash can"
msgstr "Vis papirkurven"

#: Settings.ui.h:55
msgid "Show volumes and devices"
msgstr "Vis diskenheder og enheder"

#: Settings.ui.h:56
msgid "Only if mounted"
msgstr "Kun hvis monteret"

#: Settings.ui.h:57
msgid "Include network volumes"
msgstr "Medtag netværksdiskenheder"

#: Settings.ui.h:58
msgid "Isolate volumes, devices and trash windows from file manager"
msgstr ""
"Isolér diskenheders, enheders og papirkurvens vinduer fra filhåndtering"

#: Settings.ui.h:65
msgid "Launchers"
msgstr "Programstartere"

#: Settings.ui.h:66
msgid ""
"Enable Super+(0-9) as shortcuts to activate apps. It can also be used "
"together with Shift and Ctrl."
msgstr ""
"Aktivér Super+(0–9) som genveje til aktivering af programmer. Kan også "
"benyttes sammen med Skift og CDtrl."

#: Settings.ui.h:67
msgid "Use keyboard shortcuts to activate apps"
msgstr "Brug tastaturgenveje til aktivering af programmer"

#: Settings.ui.h:68
msgid "Behaviour when clicking on the icon of a running application."
msgstr "Opførsel når der klikkes på et kørende programs ikon."

#: Settings.ui.h:69
msgid "Click action"
msgstr "Handling ved klik"

#: Settings.ui.h:70
msgid "Minimize"
msgstr "Minimér"

#: Settings.ui.h:71
msgid "Behaviour when scrolling on the icon of an application."
msgstr "Opførsel når der rulles på et programs ikon."

#: Settings.ui.h:72
msgid "Scroll action"
msgstr "Handling ved rulning"

#: Settings.ui.h:73
msgid "Do nothing"
msgstr "Gør intet"

#: Settings.ui.h:74
msgid "Switch workspace"
msgstr "Skift arbejdsområde"

#: Settings.ui.h:75
msgid "Behavior"
msgstr "Opførsel"

#: Settings.ui.h:80
msgid ""
"Few customizations meant to integrate the dock with the default GNOME theme. "
"Alternatively, specific options can be enabled below."
msgstr ""
"Nogle få indstillinger af integration af dokken med GNOMEs standardtema. "
"Alternativt kan specifikke indstillinger aktiveres nedenfor."

#: Settings.ui.h:81
msgid "Use built-in theme"
msgstr "Brug medfølgende tema"

#: Settings.ui.h:76
msgid "Save space reducing padding and border radius."
msgstr "Spar plads ved at reducere udfyldning og kantradius."

#: Settings.ui.h:77
msgid "Shrink the dash"
msgstr "Formindsk dash"

#: Settings.ui.h:82
msgid "Customize windows counter indicators"
msgstr "Tilpas indikatorer til tælling af vinduer"

#: Settings.ui.h:83
msgid "Default"
msgstr "Standard"

#: Settings.ui.h:84
msgid "Dots"
msgstr "Prikker"

#: Settings.ui.h:85
msgid "Squares"
msgstr "Kvadrater"

#: Settings.ui.h:86
msgid "Dashes"
msgstr "Streger"

#: Settings.ui.h:87
msgid "Segmented"
msgstr "Segmenteret"

#: Settings.ui.h:88
msgid "Solid"
