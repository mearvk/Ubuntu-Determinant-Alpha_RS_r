msgstr "%s: errorea lehenetsitako acl kentzean \"%s\": %s\n"

#: tools/chacl.c:172 tools/chacl.c:191
#, c-format
msgid "%s: access ACL '%s': %s at entry %d\n"
msgstr "%s: ACL sarbidea '%s': %s , %d sarreran\n"

#: tools/chacl.c:259
#, c-format
msgid "%s: cannot get access ACL on '%s': %s\n"
msgstr "%s: ezin da eskuratu sarbide ACL-a '%s': %s\n"

#: tools/chacl.c:265
#, c-format
msgid "%s: cannot get default ACL on '%s': %s\n"
msgstr "%s: ezin da eskuratu lehenetsitako ACL-a '%s': %s\n"

#: tools/chacl.c:271
#, c-format
msgid "%s: cannot get access ACL text on '%s': %s\n"
msgstr "%s: ezin da eskuratu sarbide ACL-aren testua '%s': %s\n"

#: tools/chacl.c:278
#, c-format
msgid "%s: cannot get default ACL text on '%s': %s\n"
msgstr "%s: ezin da eskuratu lehenetsitako ACL-aren testua '%s': %s\n"

#: tools/chacl.c:304
#, c-format
msgid "%s: cannot set access acl on \"%s\": %s\n"
msgstr "%s: ezin da ezarri sarbide ACL-a '%s': %s\n"

#: tools/chacl.c:310
#, c-format
msgid "%s: cannot set default acl on \"%s\": %s\n"
msgstr "%s: ezin da ezarri lehenetsitako ACL-a '%s': %s\n"

#: tools/chacl.c:328
#, c-format
msgid "%s: opendir failed: %s\n"
msgstr "%s: opendir aginduak huts egin du: %s\n"

#: tools/chacl.c:342
#, c-format
msgid "%s: malloc failed: %s\n"
msgstr "%s: malloc aginduak huts egin du: %s\n"

#: tools/do_set.c:410
#, c-format
msgid "%s: %s: Malformed access ACL `%s': %s at entry %d\n"
msgstr "%s: %s: sarbide ACL oker osatua `%s': %s , %d sarreran\n"

#: tools/do_set.c:437
#, c-format
msgid "%s: %s: Malformed default ACL `%s': %s at entry %d\n"
msgstr ""
"%s: %s: lehenitsitako sarbide ACL oker osatua `%s': %s , %d sarreran\n"

#: tools/do_set.c:508
#, c-format
msgid "%s: %s: Only directories can have default ACLs\n"
msgstr "%s: %s: Direktorioek soilik izan ditzaketelehenetsitako ACL-ak\n"

#: tools/setfacl.c:147
#, c-format
msgid "%s: %s: No filename found in line %d, aborting\n"
msgstr ""
"%s: %s: Ez da fitxategi izenik aurkitu %d lerroan, bertan behera uzten\n"

#: tools/setfacl.c:152
#, c-format
msgid "%s: No filename found in line %d of standard input, aborting\n"
msgstr ""
"%s: Ez da fitxategi-izenik aurkitu sarrera estandarraren %d lerroan, bertan "
"behera uzten\n"

#: tools/setfacl.c:173
#, c-format
msgid "%s: %s: %s in line %d\n"
msgstr "%s: %s: %s , %d lerroan\n"

#: tools/setfacl.c:205
#, c-format
msgid "%s: %s: Cannot change owner/group: %s\n"
msgstr "%s: %s: Ezin da jabea/taldea aldatu: %s\n"

#: tools/setfacl.c:224
#, c-format
msgid "%s: %s: Cannot change mode: %s\n"
msgstr "%s: %s: Ezin da modua aldatu: %s\n"

#: tools/setfacl.c:266
#, c-format
msgid "%s %s -- set file access control lists\n"
msgstr "%s %s -- fitxategietara sarbide zerrendak (ACL) ezarri\n"

#: tools/setfacl.c:268 tools/setfacl.c:653
#, c-format
msgid "Usage: %s %s\n"
msgstr "Erabilera: %s %s\n"

#: tools/setfacl.c:271
#, c-format
msgid ""
"  -m, --modify=acl        modify the current ACL(s) of file(s)\n"
"  -M, --modify-file=file  read ACL entries to modify from file\n"
"  -x, --remove=acl        remove entries from the ACL(s) of file(s)\n"
"  -X, --remove-file=file  read ACL entries to remove from file\n"
"  -b, --remove-all        remove all extended ACL entries\n"
"  -k, --remove-default    remove the default ACL\n"
msgstr ""
"  -m, --modify=acl fitxategien oraingo ACL-ak aldatu\n"
"  -M, --modify-file=file fitxategiaren ACL sarrerak irakurri, aldatzeko\n"
"  -x, --remove=acl fitxategien ACL sarrerak kendu\n"
"  -X, --remove-file=file fitxategiaren ACL sarrerak irakurri, kentzeko\n"
"  -b, --remove-all ACL sarrera hedatu guztiak kendu\n"
"  -k, --remove-default lehenetsitako ACL-a kendu\n"

#: tools/setfacl.c:280
#, c-format
msgid ""
"      --set=acl           set the ACL of file(s), replacing the current ACL\n"
"      --set-file=file     read ACL entries to set from file\n"
"      --mask              do recalculate the effective rights mask\n"
msgstr ""
"      --set=acl fitxategien ACL-ak ezarri, oraingoa ordezkatuz\n"
"      --set-file=file fitxategi batetik irakurri ezarriko diren ACL "
"sarrerak\n"
"      --mask baimen maskara berriro kalkulatu\n"

#: tools/setfacl.c:286
#, c-format
msgid ""
"  -n, --no-mask           don't recalculate the effective rights mask\n"
"  -d, --default           operations apply to the default ACL\n"
msgstr ""
"  -n, --no-mask baimen maskara ez berriro kalkulatu\n"
"  -d, --default lehenetsitako ACL-ari ezarri aukerak\n"

#: tools/setfacl.c:291
#, c-format
msgid ""
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"      --restore=file      restore ACLs (inverse of `getfacl -R')\n"
"      --test              test mode (ACLs are not modified)\n"
msgstr ""
"  -R, --recursive azpidirektorioetan ere eragin\n"
"  -L, --logical esteka logikoak jarraitu\n"
"  -P, --physical esteka logikoak ez jarraitu\n"
"      --restore=file ACL-ak leheneratu (`getfacl -R' aginduaren kontrakoa)\n"
"      --test probatarako modua (ACL-ak ez dira aldatzen)\n"

#: tools/setfacl.c:299 tools/getfacl.c:597
#, c-format
msgid ""
"  -v, --version           print version and exit\n"
"  -h, --help              this help text\n"
msgstr ""
"  -v, --version           inprimatu bertsioa eta irten\n"
"  -h, --help              erakutsi laguntzarako testu hau\n"

#: tools/setfacl.c:316 tools/getfacl.c:743
#, c-format
msgid "%s: Standard input: %s\n"
msgstr "%s: Sarrera estandarra: %s\n"

#: tools/setfacl.c:452
#, c-format
msgid "%s: Option -%c incomplete\n"
msgstr "%s: -%c agindu osatugabea\n"

#: tools/setfacl.c:457
#, c-format
msgid "%s: Option -%c: %s near character %d\n"
msgstr "%s: -%c: %s aukera %d karakterearen inguruan\n"

#: tools/setfacl.c:533
#, c-format
msgid "%s: %s in line %d of file %s\n"
msgstr "%s: %s , %d lerroan, %s fitxategian\n"

#: tools/setfacl.c:541
#, c-format
msgid "%s: %s in line %d of standard input\n"
msgstr "%s: %s , %d lerroan, sarrera estandarrean\n"

#: tools/setfacl.c:655 tools/getfacl.c:758
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Probatu `%s --help' informazio gehiago eskuratzeko.\n"

#: tools/getfacl.c:498
#, c-format
msgid "%s: Removing leading '/' from absolute path names\n"
msgstr "%s: Bide-izen absolutoen '/' aurrizkia kentzen\n"

#: tools/getfacl.c:569
#, c-format
msgid "%s %s -- get file access control lists\n"
msgstr "%s %s -- fitxategi sarrera kontrol zerrendak (ACL) eskuratu\n"

#: tools/getfacl.c:571 tools/getfacl.c:756
#, c-format
msgid "Usage: %s [-%s] file ...\n"
msgstr "Erabilera: %s [-%s] fitxategia ...\n"

#: tools/getfacl.c:577
#, c-format
msgid "  -d, --default           display the default access control list\n"
msgstr "  -d, --default lehenetsitako sarrera kontrol zerrenda bistaratu\n"

#: tools/getfacl.c:581
#, c-format
msgid ""
"  -a, --access            display the file access control list only\n"
"  -d, --default           display the default access control list only\n"
"  -c, --omit-header       do not display the comment header\n"
"  -e, --all-effective     print all effective rights\n"
"  -E, --no-effective      print no effective rights\n"
"  -s, --skip-base         skip files that only have the base entries\n"
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"  -t, --tabular           use tabular output format\n"
"  -n, --numeric           print numeric user/group identifiers\n"
"      --one-file-system   skip files on different filesystems\n"
"  -p, --absolute-names    don't strip leading '/' in pathnames\n"
msgstr ""
