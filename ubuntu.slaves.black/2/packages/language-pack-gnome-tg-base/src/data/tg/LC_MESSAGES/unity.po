msgstr "Тапиш то иҷрошавӣ"

#: ../plugins/unityshell/unityshell.xml.in.h:111
msgid "Blink"
msgstr "Мижазанӣ"

#: ../plugins/unityshell/unityshell.xml.in.h:112
