"нишондиҳандаи муш лозим аст."

#: ../plugins/unityshell/unityshell.xml.in.h:92
msgid "Pressure Decay Rate"
msgstr "Андозаи таназзули фишор"

#: ../plugins/unityshell/unityshell.xml.in.h:93
