msgid ""
"sensible-editor, sensible-pager, sensible-browser - sensible editing, "
"paging, and web browsing"
msgstr ""
"sensible-editor, sensible-pager, sensible-browser - 気の利いたエディタ、ページャ、ウェブブラウザ"

