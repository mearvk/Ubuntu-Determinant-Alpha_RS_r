msgstr "文法エラー %s:%u: 命令はトップレベルでのみ実行できます"

#: apt-pkg/contrib/configuration.cc:1059
#, c-format
msgid "Syntax error %s:%u: Too many nested includes"
msgstr "文法エラー %s:%u: インクルードのネストが多すぎます"

