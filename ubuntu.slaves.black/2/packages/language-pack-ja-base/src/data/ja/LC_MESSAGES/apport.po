#: ../apport/ui.py:593
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:593
msgid "The specified process ID does not exist."
msgstr "指定されたプロセスIDは存在しません。"

#: ../apport/ui.py:598
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:598
msgid "Not your PID"
msgstr "プロセスIDの所有者ではありません"

