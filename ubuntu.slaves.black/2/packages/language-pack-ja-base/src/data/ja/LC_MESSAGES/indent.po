#: src/args.c:673
msgid ""
"usage: indent file [-o outfile ] [ options ]\n"
"       indent file1 file2 ... fileN [ options ]\n"
msgstr ""
"使い方: indent ファイル [-o 出力ファイル ] [ オプション ]\n"
"        indent ファイル1 ファイル2 ... ファイルN [ オプション ]\n"

