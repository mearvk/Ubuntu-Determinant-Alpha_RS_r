#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "内部エラー: %(1)s"

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "このマップは既に %(1)s -> %(2)s を含んでいます。"

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "メソッド %(1)s はサポートされていません。"

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "メソッド %(1)s は %(2)s 個の引数を取ります (%(3)s が与えられました)。"

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "アクセス権限がありません。"

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr "%(1)s 用の値 \"%(2)s\" はこのサーバーでサポートされていません。サーバーは \"%(3)s\" と言っています。"

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "%(1)s が %(2)s をハンドルするのは無効です。"

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "許可されていない操作を試みました。"

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr "選択したネットワークはすでに PIF 接続を持っており、別のものは接続することができません。"

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
