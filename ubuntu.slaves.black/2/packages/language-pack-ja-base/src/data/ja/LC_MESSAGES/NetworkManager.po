"                  ifname <interface name> | \"*\"\n"
"                  [con-name <connection name>]\n"
"                  [autoconnect yes|no]\n"
"                  [save yes|no]\n"
"                  [master <master (ifname, or connection UUID or name)>]\n"
"                  [slave-type <master connection type>]\n"
