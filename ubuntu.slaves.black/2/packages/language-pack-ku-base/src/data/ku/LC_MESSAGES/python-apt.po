#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Rajekara %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Rajekara bingehîn"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Rajekarên taybet"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Danasîna kêm ya ji bo '%s'. Xêra xwe rapor bike."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Di danasîna ji bo '%s' (%s) de unicode'a nederbasdar. Xêra xwe ragihîne."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Lîsteya guherînan ne gihiştbar e"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Lîsteya guhertinan hêj ne berdest e.\n"
"\n"
"Ji kerema xwe http://launchpad.net/ubuntu/+source/%s/%s/+changelog -ê bi kar "
"bînin,\n"
"heta ku guhertin berdest bibin yan jî heta ku hûn paşê dîsa biceribînin."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Daxistina lîsteya guhertinan bi ser neket.\n"
"Ji kerema xwe re girêdana înternetê kontrol bike."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Lîsteya peldankan ya ji bo '%s' nikare bê xwendin"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Lîsteya peldankên kontrolê yên ji bo '%s' nikare bê xwendin"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Bindestî nayê çareserkirin: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Nakokî bi pakêta '%s' ya sazkirî re heye"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Bestekîtiya '%(pkgname)s' ya bi %(depname)s re xera dike (%(deprelation)s "
"%(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Pakêta '%(pkgname)s' ya xera bi pakêta %(targetpkg)s re nelihev in: "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Wê pakêta '%(pkgname)s' ya ku bi '%(targetpkg)s' re nakok in bisekinîne. Lê "
"'%(debfile)s' -yê bi riya vê peyda dike: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Di pakêtê de qada Mîmarî tine"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Ji bo ku mîmariya nerast ya '%s' îlawe bikî û paşê rojane bikî 'dpkg --add-"
"architecture' -ê bixebitîne"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Guhertoya nûtir jixwe sazkirî ye"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Çareserkirina hemû bestekiyan bi ser neket (pêşbîr şikestî ye)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Nikare '%s' saz bike"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Ji pakêtê bi otomatîkî hate derxistin:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Bi otomatîkî ji ascii'ya çapbar re hate zivirandin:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Ji bo pakêta çavkanî ya '%s' yê ku %s -ê ava kiriye Build-Dependencies saz "
"bike\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Pakêtekê esasî wê bê rakirin"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Çêbû"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Lêketin "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Piştguh ke "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Çewtî "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Anîn:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Dixebite]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Guhertina medyayê: ji kerema xwe re dîska bi etîketa\n"
" '%s'\n"
"bixe ajogera '%s' û pêl li enter'ê bike\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "%sB di %s de hatine anîn (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
