#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Çewtiyên hundirîn: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Di vê nexşeyê de ji berê ve %(1)s -> %(2)s. heye."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Rêbaza %(1)s ne derbasbare."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Rêbaza %(1)s , %(2)s argumentan distîne ji (%(3)s ku hatine dayîn)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Destûr biser neket"

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Ev pêşkêşker li nirxa \"%(2)s\" ji bo %(1)s nayê piştgrîkirin. Pêşkêşker "
"diyar dike li \"%(3)s\""

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "Destikê  %(1)s , %(2)s ne derbasbare."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Te operasyoneke ku ne derbasbare kir."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Tora ku te destnîşan kiriye berê pêveka PIF pê re heye û wiha tu nikarî yeke "
"din pê ve bikî."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
