"%s%s\n"
"Encoding: %s\n"
"%s\n"
"Substituting with <b>%s</b>\n"
"(%s)"
msgstr ""
"%s%s\n"
"الترميز: %s\n"
"%s\n"
"استبدله <b>%s</b>\n"
"(%s)"

