#: lib/fascist.c:516
msgid "it is based on your username"
msgstr "dit is gebaseer op u gebruikersnaam"

#: lib/fascist.c:576
msgid "it is based upon your password entry"
msgstr "dit is gebaseer op u wagwoordinvoer"

#: lib/fascist.c:591
msgid "it is derived from your password entry"
msgstr "dit is afgelei van u wagwoordinvoer"

#: lib/fascist.c:599
msgid "it's derived from your password entry"
msgstr "dit is afgelei van u wagwoordinvoer"

#: lib/fascist.c:608
msgid "it is derivable from your password entry"
msgstr "dit is afgelei van u wagwoordinvoer"

#: lib/fascist.c:617
msgid "it's derivable from your password entry"
msgstr "dit is afgelei van u wagwoordinvoer"

#: lib/fascist.c:674
msgid "you are not registered in the password file"
msgstr "u is nie geregistreer in die wagwoordlêer nie"

#: lib/fascist.c:709
msgid "it is WAY too short"
msgstr "dit is HEELTEMAL te kort"

#: lib/fascist.c:714
msgid "it is too short"
msgstr "dit is te kort"

#: lib/fascist.c:731
msgid "it does not contain enough DIFFERENT characters"
msgstr "dit bevat nie genoeg VERSKILLENDE karakters nie"

#: lib/fascist.c:745
msgid "it is all whitespace"
msgstr "dit is alles spasie"

#: lib/fascist.c:764
msgid "it is too simplistic/systematic"
msgstr "dit is te simplisties/stelselmatig"

#: lib/fascist.c:769
msgid "it looks like a National Insurance number."
msgstr "dit lyk soos 'n nommer van die Nasionale Versekering."

#: lib/fascist.c:801
msgid "it is based on a dictionary word"
msgstr "dit is gebaseer op 'n woordeboekwoord"

#: lib/fascist.c:820
msgid "it is based on a (reversed) dictionary word"
msgstr "dit is gebaseer op 'n (omgekeerde) woordeboek"

#: lib/fascist.c:865
msgid "error loading dictionary"
msgstr "fout met die laai van woordeboek"
