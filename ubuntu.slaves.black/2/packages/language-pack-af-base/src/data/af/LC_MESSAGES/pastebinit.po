#: ../pastebinit:126
msgid "%s: no section [pastebin]"
msgstr "%s: geen seksie [pastebin]"

#: ../pastebinit:131
msgid "%s: no 'basename' in [pastebin]"
msgstr "%s: geen 'basename' in [pastebin]"

#: ../pastebinit:139
#, docstring
msgid "Return the parameters array for the selected pastebin"
msgstr "Keer terug die parameters struktuur vir die gekose pastebin"

#: ../pastebinit:154
msgid ""
"Unknown website, please post a bugreport to request this pastebin to be "
"added (%s)"
msgstr ""
"Onbekend webwerf, pos asseblief  'n fout verslag om te versoek dat hierdie "
"pastebin bygevoeg word (%s)"

#: ../pastebinit:204
msgid "Reads on stdin for input or takes a list of filenames as parameters"
msgstr "Lees op stdin vir inset of neem 'n lys leêrname as parameter"

#: ../pastebinit:206
msgid "Optional arguments (not supported by all pastebins):"
msgstr "Optionele argumente (nie ondersteun deur alle pastebin)"

#: ../pastebinit:208
msgid "\t-a <author:default is '%s'>"
msgstr "\t-a <skrywer:verstek is '%s'>"

#: ../pastebinit:209
msgid "\t-b <pastebin url:default is '%s'>"
msgstr "\t-b <pastebin url:verstek is '%s'>"

#: ../pastebinit:210
msgid "\t-f <format of paste:default is '%s'>"
msgstr "\t-f <formaat van plak:verstek is '%s'>"

#: ../pastebinit:211
msgid "\t-h This help screen"
msgstr "\t-h Hierdie hulp skerm"

#: ../pastebinit:197
msgid "\t-i <input file>"
msgstr "\t-i <input file>"

#: ../pastebinit:198
msgid "\t-l List all supported pastebins"
msgstr "\t-l Lys alle ondersteunde pastebins"

#: ../pastebinit:214
msgid "\t-j <jabberid for notifications:default is '%s'>"
msgstr "\t-j <jabberid vir boodskappe:verstek is '%s'>"

#: ../pastebinit:216
msgid "\t-m <permatag for all versions of a post:default is blank>"
msgstr "\t-m <permatag vir alle weergawes van 'n pos:verstek is leeg>"

#: ../pastebinit:218
msgid "\t-r <parent posts ID:defaults to none>"
msgstr "\t-r <ouer pos ID:verstek is geen>"

#: ../pastebinit:219
msgid "\t-t <title of paste:default is blank>"
msgstr "\t-t <opskrif van plak:verstek is leeg>"

#: ../pastebinit:216
msgid "\t-u <username> -p <password>"
msgstr "\t-u <gebruikersnaam> -p <wagwoord>"

#: ../pastebinit:201
msgid "\t-v Print the version number"
msgstr "\t-v Druk die weergawe nommer"

#: ../pastebinit:254 ../pastebinit:277 ../pastebinit:291 ../pastebinit:362
#: ../pastebinit:464 ../pastebinit:473
msgid "KeyboardInterrupt caught."
msgstr "Sleutelbordonderbreking is gevang"

#: ../pastebinit:280
msgid "Error parsing configuration file!"
msgstr "Fout met lees van konfigurasie leër"

#: ../pastebinit:281
msgid ""
"Please ensure that your configuration file looks similar to the following:"
msgstr ""
"Verseker asseblief dat jou konfigurasie leër soortgelyk soos volgende lyk:"

#: ../pastebinit:288
msgid "Invalid arguments!\n"
msgstr "Ongeldige argumente!\n"

#: ../pastebinit:310
msgid "Supported pastebins:"
msgstr "Ondersteunde pastebins"

#: ../pastebinit:365
msgid "Unable to read from: %s"
msgstr "Kan nie van %s lees nie"

#: ../pastebinit:369
msgid "You are trying to send an empty document, exiting."
msgstr "U probeer 'n leë dokument stuur, word uitgegaan."

#: ../pastebinit:414
msgid "The content you are trying to send exceeds the pastebin's size limit."
msgstr ""
"Die inhoud wat u probeer te stuur is te groot vir die pastebin's grootte "
"limiet"

#: ../pastebinit:403
msgid "Could not find any json library."
msgstr "Kon geen json sagteware biblioteek kry nie"

#: ../pastebinit:438
msgid "Failed to contact the server: %s"
msgstr "Kon nie die leêrbediener : %s kry nie"

#: ../pastebinit:467
msgid ""
"Unable to read or parse the result page, it could be a server timeout or a "
"change server side, try with another pastebin."
msgstr ""
"Kan nie die resultaat bladsy lees nie, dit kan wees omdat daar geen antwoord "
"terug ontvang is van die rekenaar bediener nie, probeer met 'n ander pastebin"
