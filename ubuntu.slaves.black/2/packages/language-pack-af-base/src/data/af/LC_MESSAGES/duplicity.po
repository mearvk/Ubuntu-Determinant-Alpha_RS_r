#: ../duplicity/commandline.py:79
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"Use of default filenames is strongly suggested."
msgstr ""
"Waarskuwing: Opsie %s is hangend deprecation en sal in 'n toekomstige "
"vrystelling verwyder word.\n"
"Gebruik van verstek lêername word sterk aanbeveel."

#: ../duplicity/commandline.py:86
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"--include-filelist and --exclude-filelist now accept globbing characters and "
"should be used instead."
msgstr ""
"Waarskuwing: Opsie %s is hangend deprecation en sal in 'n toekomstige "
"vrystelling verwyder word.\n"
"--include-filelist en --exclude-filelist aanvaar nou globing karakters en "
"moet eerder gebruik word."

#: ../duplicity/commandline.py:96
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"On many GNU/Linux systems, stdin is represented by /dev/stdin and\n"
"--include-filelist=/dev/stdin or --exclude-filelist=/dev/stdin could\n"
"be used as a substitute."
msgstr ""
"Waarskuwing: Opsie %s is hangend deprecation en sal in 'n toekomstige "
"vrystelling verwyder word.\n"
"Op vele GNU/Linux stelsels, stdin word verteenwoordig deur /dev/stdin en\n"
"--include-filelist=/dev/stdin of --exclude-filelist=/dev/stdin kon\n"
"gebruik word as 'n plaasvervanger."

