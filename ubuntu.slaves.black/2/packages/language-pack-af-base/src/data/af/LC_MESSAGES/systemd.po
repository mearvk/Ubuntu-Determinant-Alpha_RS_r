#: src/core/org.freedesktop.systemd1.policy.in:22
msgid "Send passphrase back to system"
msgstr "Stuur slaag frase terug aan die stelsel"

#: src/core/org.freedesktop.systemd1.policy.in:23
msgid ""
"Authentication is required to send the entered passphrase back to the system."
msgstr ""
"Waarmerking is wat nodig is om die ingevoerde slaagfrase terug na die "
"stelsel stuur."

#: src/core/org.freedesktop.systemd1.policy.in:33
msgid "Manage system services or other units"
msgstr "Bestuur stelsel dienste of ander eenhede"

#: src/core/org.freedesktop.systemd1.policy.in:34
msgid "Authentication is required to manage system services or other units."
msgstr ""
"Waarmerking is benodig word om stelsel dienste of ander eenhede te bestuur."

#: src/core/org.freedesktop.systemd1.policy.in:43
msgid "Manage system service or unit files"
msgstr "Bestuur stelsel diens of eenheid lêers"

#: src/core/org.freedesktop.systemd1.policy.in:44
msgid "Authentication is required to manage system service or unit files."
msgstr ""
"Waarmerking is wat nodig is om stelsel diens of eenheid lêers te bestuur."

#: src/core/org.freedesktop.systemd1.policy.in:54
msgid "Set or unset system and service manager environment variables"
msgstr "Stel of nie-stel stelsel en diens bestuurder omgewing veranderlikes"

#: src/core/org.freedesktop.systemd1.policy.in:55
msgid ""
"Authentication is required to set or unset system and service manager "
"environment variables."
msgstr ""
"Waarmerking is benodig om stel of nie-stel stelsel en diens bestuurder "
"omgewing veranderlikes."

#: src/core/org.freedesktop.systemd1.policy.in:64
msgid "Reload the systemd state"
msgstr "Herlaai die systemd staat"

#: src/core/org.freedesktop.systemd1.policy.in:65
msgid "Authentication is required to reload the systemd state."
msgstr "Waarmerking is benodig om- herlaai die system staat."

#: src/home/org.freedesktop.home1.policy:13
msgid "Create a home area"
msgstr "Skep 'n huis gebied"

#: src/home/org.freedesktop.home1.policy:14
msgid "Authentication is required to create a user's home area."
msgstr "Waarmerking is benodig om skep 'n gebruiker se huis gebied."

#: src/home/org.freedesktop.home1.policy:23
msgid "Remove a home area"
msgstr "Verwyder 'n huis gebied"

#: src/home/org.freedesktop.home1.policy:24
msgid "Authentication is required to remove a user's home area."
msgstr ""
"Waarmerking is benodig om die huis gebied van 'n gebruiker te verwyder."

#: src/home/org.freedesktop.home1.policy:33
msgid "Check credentials of a home area"
msgstr "Tjek geloofsbriewe van 'n huis gebied"

#: src/home/org.freedesktop.home1.policy:34
msgid ""
"Authentication is required to check credentials against a user's home area."
msgstr ""
"Waarmerking is benodig om tjek geloofsbriewe teen 'n gebruiker se huis "
"gebied."

#: src/home/org.freedesktop.home1.policy:43
msgid "Update a home area"
msgstr "Opdateer 'n huis gebied"

#: src/home/org.freedesktop.home1.policy:44
msgid "Authentication is required to update a user's home area."
msgstr "Waarmerking is benodig om opdateer 'n gebruiker se huis gebied."

#: src/home/org.freedesktop.home1.policy:53
msgid "Resize a home area"
msgstr "Verander grootte 'n huis gebied"

#: src/home/org.freedesktop.home1.policy:54
msgid "Authentication is required to resize a user's home area."
msgstr ""
"Waarmerking is benodig om verander grootte 'n gebruiker se huis gebied."

#: src/home/org.freedesktop.home1.policy:63
msgid "Change password of a home area"
msgstr "Verander wagwoord van 'n huis gebied"

#: src/home/org.freedesktop.home1.policy:64
msgid ""
"Authentication is required to change the password of a user's home area."
msgstr ""
"Waarmerking is benodig om verander die wagwoord van 'n gebruiker se huis "
"gebied."

#: src/hostname/org.freedesktop.hostname1.policy:20
msgid "Set hostname"
msgstr "Stel gasheernaam"

#: src/hostname/org.freedesktop.hostname1.policy:21
msgid "Authentication is required to set the local hostname."
msgstr "Waarmerking is benodig om stel die plaaslike gasheernaam."

#: src/hostname/org.freedesktop.hostname1.policy:30
msgid "Set static hostname"
msgstr "Stel statiese gasheernaam"

#: src/hostname/org.freedesktop.hostname1.policy:31
msgid ""
"Authentication is required to set the statically configured local hostname, "
"as well as the pretty hostname."
msgstr ""
"Waarmerking is benodig om stel die statiese gekonfigureer plaaslike "
"gasheernaam, sowel as die mooi gasheernaam."

#: src/hostname/org.freedesktop.hostname1.policy:41
msgid "Set machine information"
msgstr "Stel masjien inligting"

#: src/hostname/org.freedesktop.hostname1.policy:42
msgid "Authentication is required to set local machine information."
msgstr "Waarmerking is benodig om stel plaaslike masjien inligting."

#: src/hostname/org.freedesktop.hostname1.policy:51
msgid "Get product UUID"
msgstr "Kry produk UUID"

#: src/hostname/org.freedesktop.hostname1.policy:52
msgid "Authentication is required to get product UUID."
msgstr "Waarmerking is benodig om kry produk UUID."

#: src/import/org.freedesktop.import1.policy:22
msgid "Import a VM or container image"
msgstr "Invoer 'n VM of houer beeld"

#: src/import/org.freedesktop.import1.policy:23
msgid "Authentication is required to import a VM or container image"
msgstr "Waarmerking is benodig om invoer 'n VM of houer beeld"

#: src/import/org.freedesktop.import1.policy:32
msgid "Export a VM or container image"
msgstr "Uitvoer 'n VM of houer beeld"

#: src/import/org.freedesktop.import1.policy:33
msgid "Authentication is required to export a VM or container image"
msgstr "Waarmerking is benodig om uitvoer 'n VM of houer beeld"

#: src/import/org.freedesktop.import1.policy:42
msgid "Download a VM or container image"
msgstr "Aflaai 'n VM of houer beeld"

#: src/import/org.freedesktop.import1.policy:43
msgid "Authentication is required to download a VM or container image"
msgstr "Waarmerking is benodig om aflaai 'n VM of houer beeld"

#: src/locale/org.freedesktop.locale1.policy:22
msgid "Set system locale"
msgstr "Stel stelsel locale"

#: src/locale/org.freedesktop.locale1.policy:23
msgid "Authentication is required to set the system locale."
msgstr "Waarmerking is benodig om stel die stelsel locale."

#: src/locale/org.freedesktop.locale1.policy:33
msgid "Set system keyboard settings"
msgstr "Stel stelsel sleutelbord instellings"

#: src/locale/org.freedesktop.locale1.policy:34
msgid "Authentication is required to set the system keyboard settings."
msgstr "Waarmerking is benodig om stel die stelsel sleutelbord instellings"

#: src/login/org.freedesktop.login1.policy:22
msgid "Allow applications to inhibit system shutdown"
msgstr "Toelaat toepassings om inhibeer die stelsel te afsluiting"

#: src/login/org.freedesktop.login1.policy:23
msgid ""
"Authentication is required for an application to inhibit system shutdown."
msgstr ""
"Waarmerking is benodig vir 'n toepassings om inhibeer die stelsel te "
"afsluiting"

#: src/login/org.freedesktop.login1.policy:33
msgid "Allow applications to delay system shutdown"
msgstr "Toelaat toepassings om vertraging stelsel afsluiting"

#: src/login/org.freedesktop.login1.policy:34
msgid ""
"Authentication is required for an application to delay system shutdown."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om vertraging stelsel afsluiting."

#: src/login/org.freedesktop.login1.policy:44
msgid "Allow applications to inhibit system sleep"
msgstr "Toelaat toepassings om inhibeer stelsel slaap"

#: src/login/org.freedesktop.login1.policy:45
msgid ""
"Authentication is required for an application to inhibit system sleep."
msgstr "Waarmerking is benodig vir 'n aansoek om inhibeer stelsel slaap."

#: src/login/org.freedesktop.login1.policy:55
msgid "Allow applications to delay system sleep"
msgstr "Toelaat toepassings om vertraging stelsel slaap"

#: src/login/org.freedesktop.login1.policy:56
msgid "Authentication is required for an application to delay system sleep."
msgstr "Waarmerking is benodig vir 'n aansoek om vertraging stelsel slaap."

#: src/login/org.freedesktop.login1.policy:65
msgid "Allow applications to inhibit automatic system suspend"
msgstr "Toelaat toepassings om inhibeer outomatiese stelsel skort"

#: src/login/org.freedesktop.login1.policy:66
msgid ""
"Authentication is required for an application to inhibit automatic system "
"suspend."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om inhibeer outomatiese stelsel skort."

#: src/login/org.freedesktop.login1.policy:75
msgid "Allow applications to inhibit system handling of the power key"
msgstr ""
"Toelaat toepassings om inhibeer stelsel hantering van die krag sleutel"

#: src/login/org.freedesktop.login1.policy:76
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the power key."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om inhibeer stelsel hantering van die "
"krag sleutel."

#: src/login/org.freedesktop.login1.policy:86
msgid "Allow applications to inhibit system handling of the suspend key"
msgstr ""
"Toelaat toepassings om inhibeer stelsel hantering van die opskort sleutel"

#: src/login/org.freedesktop.login1.policy:87
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the suspend key."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om inhibeer stelsel hantering van die "
"opskort sleutel."

#: src/login/org.freedesktop.login1.policy:97
msgid "Allow applications to inhibit system handling of the hibernate key"
msgstr ""
"Toelaat toepassings om inhibeer stelsel hantering van die hiberneer sleutel"

#: src/login/org.freedesktop.login1.policy:98
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the hibernate key."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om inhibeer stelsel hantering van die "
"hiberneer sleutel."

#: src/login/org.freedesktop.login1.policy:107
msgid "Allow applications to inhibit system handling of the lid switch"
msgstr ""
"Toelaat toepassings om inhibeer stelsel hantering van die deksel skakelaar"

#: src/login/org.freedesktop.login1.policy:108
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the lid switch."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om inhibeer stelsel hantering van die "
"deksel skakelaar."

#: src/login/org.freedesktop.login1.policy:117
msgid "Allow applications to inhibit system handling of the reboot key"
msgstr ""
"Toelaat toepassings om inhibeer stelsel hantering van die herbegin sleutel"

#: src/login/org.freedesktop.login1.policy:118
msgid ""
"Authentication is required for an application to inhibit system handling of "
"the reboot key."
msgstr ""
"Waarmerking is benodig vir 'n aansoek om inhibeer stelsel hantering van die "
"herbegin sleutel."

#: src/login/org.freedesktop.login1.policy:128
msgid "Allow non-logged-in user to run programs"
msgstr "Toelaat non aangemelde gebruiker om programme- uit te voer"

#: src/login/org.freedesktop.login1.policy:129
msgid "Explicit request is required to run programs as a non-logged-in user."
msgstr ""
"Eksplisiete versoeke is nodig om programme as 'n non aangemelde gebruiker "
"uit te voer."

#: src/login/org.freedesktop.login1.policy:138
msgid "Allow non-logged-in users to run programs"
msgstr "Toelaat non aangemelde gebruiker om programme- uit te voer"

#: src/login/org.freedesktop.login1.policy:139
msgid "Authentication is required to run programs as a non-logged-in user."
msgstr ""
"Waarmerking is benodig om programme uit te voer as 'n non aangemelde "
"gebruiker."

#: src/login/org.freedesktop.login1.policy:148
msgid "Allow attaching devices to seats"
msgstr "Toelaat heg toestelle om sitplekke"

#: src/login/org.freedesktop.login1.policy:149
msgid "Authentication is required to attach a device to a seat."
msgstr "Waarmerking is benodig om heg toestell om sitplek."

#: src/login/org.freedesktop.login1.policy:159
msgid "Flush device to seat attachments"
msgstr "Flush toestell om sitplek aanhangsels"

#: src/login/org.freedesktop.login1.policy:160
msgid ""
"Authentication is required to reset how devices are attached to seats."
msgstr ""
"Waarmerking is benodig om terugstel hoe toestelle is verbonde aan sitplekke."

#: src/login/org.freedesktop.login1.policy:169
msgid "Power off the system"
msgstr "Krag af die stelsel"

#: src/login/org.freedesktop.login1.policy:170
msgid "Authentication is required to power off the system."
msgstr "Waarmerking is benodig om krag af die stelsel."

#: src/login/org.freedesktop.login1.policy:180
msgid "Power off the system while other users are logged in"
msgstr "Krag af die stelsel terwyl ander gebruikers aangemeld"

#: src/login/org.freedesktop.login1.policy:181
msgid ""
"Authentication is required to power off the system while other users are "
"logged in."
msgstr ""
"Waarmerking is benodig om krag af die stelsel terwyl ander gebruikers "
"aangemeld."

#: src/login/org.freedesktop.login1.policy:191
msgid "Power off the system while an application is inhibiting this"
msgstr "Krag af die stelsel terwyl 'n aansoek is inhibeer hierdie"

#: src/login/org.freedesktop.login1.policy:192
msgid ""
"Authentication is required to power off the system while an application is "
"inhibiting this."
msgstr ""
"Waarmerking is benodig om krag af die stelsel terwyl 'n aansoek is inhibeer "
"hierdie."

#: src/login/org.freedesktop.login1.policy:202
msgid "Reboot the system"
msgstr "Herbegin die stelsel"

#: src/login/org.freedesktop.login1.policy:203
msgid "Authentication is required to reboot the system."
msgstr "Waarmerking is benodig om herbegin die stelsel."

#: src/login/org.freedesktop.login1.policy:213
msgid "Reboot the system while other users are logged in"
msgstr "Herbegin die stelsel terwyl ander gebruikers word ingemeld"

#: src/login/org.freedesktop.login1.policy:214
msgid ""
"Authentication is required to reboot the system while other users are logged "
"in."
msgstr ""
"Waarmerking is benodig om herbegin die stelsel terwyl ander gebruikers word "
"ingemeld."

#: src/login/org.freedesktop.login1.policy:224
msgid "Reboot the system while an application is inhibiting this"
msgstr "Herbegin die stelsel terwyl 'n aansoek is inhibeer hierdie"

#: src/login/org.freedesktop.login1.policy:225
msgid ""
"Authentication is required to reboot the system while an application is "
"inhibiting this."
msgstr ""
"Waarmerking is benodig om herbegin die stelsel terwyl 'n aansoek is inhibeer "
"hierdie."

#: src/login/org.freedesktop.login1.policy:235
msgid "Halt the system"
msgstr "Stop die stelsel"

#: src/login/org.freedesktop.login1.policy:236
msgid "Authentication is required to halt the system."
msgstr "Waarmerking is benodig om stop die stelsel."

#: src/login/org.freedesktop.login1.policy:246
msgid "Halt the system while other users are logged in"
msgstr "Stop die stelsel terwyl ander gebruikers word ingemeld"

#: src/login/org.freedesktop.login1.policy:247
msgid ""
"Authentication is required to halt the system while other users are logged "
"in."
msgstr ""
"Waarmerking is benodig om stop die stelsel terwyl ander gebruikers word "
"ingemeld."

#: src/login/org.freedesktop.login1.policy:257
msgid "Halt the system while an application is inhibiting this"
msgstr "Stop die stelsel terwyl 'n aansoek is inhibeer hierdie"

#: src/login/org.freedesktop.login1.policy:258
msgid ""
"Authentication is required to halt the system while an application is "
"inhibiting this."
msgstr ""
"Waarmerking is benodig om stop die stelsel terwyl 'n aansoek is inhibeer "
"hierdie."

#: src/login/org.freedesktop.login1.policy:268
msgid "Suspend the system"
msgstr "Skort die stelsel"

#: src/login/org.freedesktop.login1.policy:269
msgid "Authentication is required to suspend the system."
msgstr "Waarmerking is benodig om skort die stelsel."

#: src/login/org.freedesktop.login1.policy:278
msgid "Suspend the system while other users are logged in"
msgstr "Skort die stelsel terwyl ander gebruikers word ingemeld"

#: src/login/org.freedesktop.login1.policy:279
msgid ""
"Authentication is required to suspend the system while other users are "
"logged in."
msgstr ""
"Waarmerking is benodig om skort die stelsel terwyl ander gebruikers word "
"ingemeld."

#: src/login/org.freedesktop.login1.policy:289
msgid "Suspend the system while an application is inhibiting this"
msgstr "Skort die stelsel terwyl 'n aansoek is inhibeer hierdie"

#: src/login/org.freedesktop.login1.policy:290
msgid ""
"Authentication is required to suspend the system while an application is "
"inhibiting this."
msgstr ""
"Waarmerking is benodig om skort die stelsel terwyl 'n aansoek is inhibeer "
"hierdie."

#: src/login/org.freedesktop.login1.policy:300
msgid "Hibernate the system"
msgstr "Hiberneer die stelsel"

#: src/login/org.freedesktop.login1.policy:301
msgid "Authentication is required to hibernate the system."
msgstr "Waarmerking is benodig om hiberneer die stelsel."

#: src/login/org.freedesktop.login1.policy:310
msgid "Hibernate the system while other users are logged in"
msgstr "Hiberneer die stelsel terwyl ander gebruikers word ingemeld"

#: src/login/org.freedesktop.login1.policy:311
msgid ""
"Authentication is required to hibernate the system while other users are "
"logged in."
msgstr ""
"Waarmerking is benodig om hiberneer die stelsel terwyl ander gebruikers word "
"ingemeld."

#: src/login/org.freedesktop.login1.policy:321
msgid "Hibernate the system while an application is inhibiting this"
msgstr "Hiberneer die stelsel terwyl 'n aansoek is inhibeer hierdie"

#: src/login/org.freedesktop.login1.policy:322
msgid ""
"Authentication is required to hibernate the system while an application is "
"inhibiting this."
msgstr ""
"Waarmerking is benodig om hiberneer die stelsel terwyl 'n aansoek is "
"inhibeer hierdie."

#: src/login/org.freedesktop.login1.policy:332
msgid "Manage active sessions, users and seats"
msgstr "Bestuur aktiewe sessies, gebruikers en sitplekke"

#: src/login/org.freedesktop.login1.policy:333
msgid ""
"Authentication is required to manage active sessions, users and seats."
msgstr ""
"Waarmerking is benodig om bestuur aktiewe sessies, gebruikers en sitplekke."

#: src/login/org.freedesktop.login1.policy:342
msgid "Lock or unlock active sessions"
msgstr "Slot of ontslot aktiewe sessies"

#: src/login/org.freedesktop.login1.policy:343
msgid "Authentication is required to lock or unlock active sessions."
msgstr "Waarmerking is benodig om slot of ontslot aktiewe sessies."

#: src/login/org.freedesktop.login1.policy:352
msgid "Set the reboot \"reason\" in the kernel"
msgstr "Stel die herbegin \"reason\" in die kernel"

#: src/login/org.freedesktop.login1.policy:353
msgid ""
"Authentication is required to set the reboot \"reason\" in the kernel."
msgstr "Waarmerking is benodig om stel die herbegin \"reason\" in die kernel"

#: src/login/org.freedesktop.login1.policy:363
msgid "Indicate to the firmware to boot to setup interface"
msgstr "Dui aan op die firmware om stewel na stel up koppelvlak"

#: src/login/org.freedesktop.login1.policy:364
msgid ""
"Authentication is required to indicate to the firmware to boot to setup "
"interface."
msgstr ""
"Waarmerking is benodig om dui aan op die firmware om stewel na stel-up "
"koppelvlak."

#: src/login/org.freedesktop.login1.policy:374
msgid "Indicate to the boot loader to boot to the boot loader menu"
msgstr "Dui tot die stewel laaier om stewel te die stewel laaier spyskaart"

#: src/login/org.freedesktop.login1.policy:375
msgid ""
"Authentication is required to indicate to the boot loader to boot to the "
"boot loader menu."
msgstr ""
"Waarmerking is benodig om dui tot die stewel laaier om stewel te die stewel "
"laaier spyskaart."

#: src/login/org.freedesktop.login1.policy:385
msgid "Indicate to the boot loader to boot a specific entry"
msgstr "Dui tot die stewel laaier om stewel 'n spesifieke inskrywing"

#: src/login/org.freedesktop.login1.policy:386
msgid ""
"Authentication is required to indicate to the boot loader to boot into a "
"specific boot loader entry."
msgstr ""
"Waarmerking is benodig om dui tot die stewel laaier om stewel in te 'n "
"spesifieke stewel laaier-inskwing."

#: src/login/org.freedesktop.login1.policy:396
msgid "Set a wall message"
msgstr "Stel 'n muur boodskap"

#: src/login/org.freedesktop.login1.policy:397
msgid "Authentication is required to set a wall message"
msgstr "Waarmerking is benodig om stel 'n muur boodskap"

#: src/login/org.freedesktop.login1.policy:406
msgid "Change Session"
msgstr "Verander Sessie"

#: src/login/org.freedesktop.login1.policy:407
msgid "Authentication is required to change the virtual terminal."
msgstr "Waarmerking is benodig om verander die virtuele terminaal."

#: src/machine/org.freedesktop.machine1.policy:22
msgid "Log into a local container"
msgstr "Meld in te 'n plaaslike houer"

#: src/machine/org.freedesktop.machine1.policy:23
msgid "Authentication is required to log into a local container."
msgstr "Waarmerking is benodig om meld in te 'n plaaslike houer."

#: src/machine/org.freedesktop.machine1.policy:32
msgid "Log into the local host"
msgstr "Meld in te die plaaslike gasheer"

#: src/machine/org.freedesktop.machine1.policy:33
msgid "Authentication is required to log into the local host."
msgstr "Waarmerking is benodig om meld in te die plaaslike gasheer"

#: src/machine/org.freedesktop.machine1.policy:42
msgid "Acquire a shell in a local container"
msgstr "Verkry 'n shell in 'n plaaslike houer"

#: src/machine/org.freedesktop.machine1.policy:43
msgid "Authentication is required to acquire a shell in a local container."
msgstr "Waarmerking is benodig om verkry 'n shell in 'n plaaslike houer."

#: src/machine/org.freedesktop.machine1.policy:53
msgid "Acquire a shell on the local host"
msgstr "Verkry 'n shell in 'n plaaslike gasheer"

#: src/machine/org.freedesktop.machine1.policy:54
msgid "Authentication is required to acquire a shell on the local host."
msgstr "Waarmerking is benodig om verkry 'n shell in 'n plaaslike gasheer."

#: src/machine/org.freedesktop.machine1.policy:64
msgid "Acquire a pseudo TTY in a local container"
msgstr "Verkry 'n pseudo TTY in 'n plaaslike houer"

#: src/machine/org.freedesktop.machine1.policy:65
msgid ""
"Authentication is required to acquire a pseudo TTY in a local container."
msgstr ""
"Waarmerking is benodig om verkry 'n pseudo TTY in 'n plaaslike houer."

#: src/machine/org.freedesktop.machine1.policy:74
msgid "Acquire a pseudo TTY on the local host"
msgstr "Verkry 'n pseudo TTY op die plaaslike gasheer"

#: src/machine/org.freedesktop.machine1.policy:75
msgid "Authentication is required to acquire a pseudo TTY on the local host."
msgstr ""
"Waarmerking is benodig om verkry 'n pseudo TTY op die plaaslike gasheer."

#: src/machine/org.freedesktop.machine1.policy:84
msgid "Manage local virtual machines and containers"
msgstr "Bestuur plaaslike virtuele masjiene en houers"

#: src/machine/org.freedesktop.machine1.policy:85
msgid ""
