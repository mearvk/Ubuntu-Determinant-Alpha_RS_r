#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "Gaan uit na 'n klein vertraging"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "Gaan uit nadat die enjin gelaai het"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr "Vervang die ou daemon"

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "Wys ekstra ontfoutinligting"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "Opnoemen die objekte se paaie vir toestelle op"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "Gooi weg alle parameters vir alle voorwerpe"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "Kry die wakker data"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "Moniteer aktiwiteit vanaf die krag-daemon"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "Moniteer met besonderhede"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "Wys inligting oor objekpad"
