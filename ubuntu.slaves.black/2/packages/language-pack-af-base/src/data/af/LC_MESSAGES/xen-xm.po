#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Interne fout: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Hierdie kaart bevat reeds %(1)s ->%(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Die metode %(1)s word nie ondersteun nie."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Die metode %(1)s neem %(2)s argument (s) (%(3)s gegee)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Toestemming geweier."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Waarde \"%(2)s\" vir %(1)s word nie deur hierdie bediener ondersteun nie. "
"Die bediener het gesê \"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "Die %(1)s handvatsel %(2)s is ongeldig."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "U het 'n aksie probeer wat nie toegelaat is nie."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Daar is reeds 'n PIF aan die netwerk wat u gespesifiseer het, aangeheg, en "
"'n ander een is moontlik nie verbonde nie."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
