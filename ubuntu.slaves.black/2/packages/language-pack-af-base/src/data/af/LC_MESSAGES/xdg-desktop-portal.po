#: src/background.c:260
#, c-format
msgid "Allow %s to run in the background?"
msgstr "Laat% s toe om in die agtergrond te hardloop?"

#: src/background.c:264
#, c-format
msgid "%s requests to be started automatically and run in the background."
msgstr "% s versoeke om outomaties te begin en op die agtergrond te loop."

#: src/background.c:266
#, c-format
msgid "%s requests to run in the background."
msgstr "% s versoek om in die agtergrond te hardloop."

#: src/background.c:267
msgid ""
"The ‘run in background’ permission can be changed at any time from the "
"application settings."
msgstr ""
"Die toestemming 'hardloop in die agtergrond' kan te eniger tyd verander word "
"vanaf die programinstellings."

#: src/background.c:272
msgid "Don't allow"
msgstr "Moenie toelaat nie"

#: src/background.c:273 src/wallpaper.c:165
msgid "Allow"
msgstr "Laat toe"

#: src/device.c:115
msgid "Turn On Microphone?"
msgstr "Skakel mikrofoon aan?"

#: src/device.c:116
msgid ""
"Access to your microphone can be changed at any time from the privacy "
"settings."
msgstr ""
"Toegang tot u mikrofoon kan te eniger tyd verander word vanuit die "
"privaatheidinstellings."

#: src/device.c:120
msgid "An application wants to use your microphone."
msgstr "'n Program wil u mikrofoon gebruik."

#: src/device.c:122
#, c-format
msgid "%s wants to use your microphone."
msgstr "% s wil u mikrofoon gebruik."

#: src/device.c:128
msgid "Turn On Speakers?"
msgstr "Skakel luidsprekers aan?"

#: src/device.c:129
msgid ""
"Access to your speakers can be changed at any time from the privacy settings."
msgstr ""
"Toegang tot u luidsprekers kan te eniger tyd verander word vanuit die "
"privaatheidinstellings."

#: src/device.c:133
msgid "An application wants to play sound."
msgstr "'n Sagteware Program wil klank speel."

#: src/device.c:135
#, c-format
msgid "%s wants to play sound."
msgstr "% s wil klank speel."

#: src/device.c:141
msgid "Turn On Camera?"
msgstr "Skakel die kamera aan?"

#: src/device.c:142
msgid ""
"Access to your camera can be changed at any time from the privacy settings."
msgstr ""
"Toegang tot u kamera kan te eniger tyd verander word vanuit die "
"privaatheidinstellings."

#: src/device.c:146
msgid "An application wants to use your camera."
msgstr "'n Sagteware Program wil u kamera gebruik."

#: src/device.c:148
#, c-format
msgid "%s wants to use your camera."
msgstr "% s wil u kamera gebruik."

#: src/location.c:526
msgid "Deny Access"
msgstr "Wyer toegang"

#: src/location.c:528
msgid "Grant Access"
msgstr "Verleen Toegang"

#: src/location.c:534
msgid "Grant Access to Your Location?"
msgstr "Toegang tot u ligging verleen?"

#: src/location.c:535
msgid "An application wants to use your location."
msgstr "'n Sagteware Program wil u ligging gebruik."

#: src/location.c:547
#, c-format
msgid "Give %s Access to Your Location?"
msgstr "Gee%s toegang tot u ligging?"

#: src/location.c:551
#, c-format
msgid "%s wants to use your location."
msgstr "%s wil u ligging gebruik."

#: src/location.c:554
msgid "Location access can be changed at any time from the privacy settings."
msgstr ""
"Toegang tot jou ligging kan enige tyd in privaatheid instellings verander "
"word."

#: src/settings.c:124
msgid "Requested setting not found"
msgstr "Gevraagde instelling nie gevind nie"

#: src/wallpaper.c:163
msgid "Deny"
msgstr "Ontken"

#: src/wallpaper.c:171
msgid "Allow Applications to Set Backgrounds?"
msgstr "Toelaat Aansoeke tot Stel Agtergronde?"

#: src/wallpaper.c:172
msgid ""
"An application is requesting to be able to change the background image."
msgstr ""
"'N Aansoek is versoek om in staat wees om die agtergrond beeld te verander."

#: src/wallpaper.c:184
#, c-format
msgid "Allow %s to Set Backgrounds?"
msgstr "Toelaat %s tot Stel Agtergronde?"

#: src/wallpaper.c:185
#, c-format
msgid "%s is requesting to be able to change the background image."
msgstr "%s is versoek tans om die agtergrondprent te kan verander."

#: src/wallpaper.c:188
msgid "This permission can be changed at any time from the privacy settings."
msgstr ""
"Hierdie toestemming kan verander word op enige tyd van die privaatheid "
"instellings."
