#: gst/gst.c:245
msgid "Print the GStreamer version"
msgstr "Druk die GStreamer weergawe"

#: gst/gst.c:247
msgid "Make all warnings fatal"
msgstr "Maak alle waarskuwings noodlottig"

#: gst/gst.c:251
msgid "Print available debug categories and exit"
msgstr "Druk beskikbare ontfout kategorieë en gaan uit"

#: gst/gst.c:255
msgid ""
"Default debug level from 1 (only error) to 9 (anything) or 0 for no output"
msgstr ""
"Verstek ontfouting vlak vanaf 1 (slegs fout) tot 9 (enigiets) of 0 vir geen "
"uitset nie"

#: gst/gst.c:257
msgid "LEVEL"
msgstr "VLAK"

#: gst/gst.c:259
msgid ""
"Comma-separated list of category_name:level pairs to set specific levels for "
"the individual categories. Example: GST_AUTOPLUG:5,GST_ELEMENT_*:3"
msgstr ""
"Komma-geskeide lys kategorie naam:vlak pare om spesifieke vlakke vir die "
"individuele kategorieë te stel. Voorbeeld: GST_AUTOPLUG:5,GST_ELEMENT_*:3"

#: gst/gst.c:262
msgid "LIST"
msgstr "LYS"

#: gst/gst.c:264
msgid "Disable colored debugging output"
msgstr "Deaktiveer gekleurde ontfouting uitvoer"

#: gst/gst.c:268
msgid ""
"Changes coloring mode of the debug log. Possible modes: off, on, disable, "
"auto, unix"
msgstr ""
"Verander kleurmodus van die ontfoutingslogboek. Moontlike modusse: af, aan, "
"deaktiveer, outo, Unix"

#: gst/gst.c:272
msgid "Disable debugging"
msgstr "Deaktiveer ontfouting"

#: gst/gst.c:276
msgid "Enable verbose plugin loading diagnostics"
msgstr "Aktiveer verbose inprop laai diagnostiek"

#: gst/gst.c:280
msgid "Colon-separated paths containing plugins"
msgstr "Dubbelpunt-geskeide paaie wat inproppe bevat"

#: gst/gst.c:280
msgid "PATHS"
msgstr "PAAIE"

#: gst/gst.c:283
msgid ""
"Comma-separated list of plugins to preload in addition to the list stored in "
"environment variable GST_PLUGIN_PATH"
msgstr ""
"Komma-geskeide lys van inproppe om vooraf te laai by die lys gestoor in "
"omgewingsveranderlike GST_PLUGIN_PATH"

#: gst/gst.c:285
msgid "PLUGINS"
msgstr "PLUGINS"

#: gst/gst.c:288
msgid "Disable trapping of segmentation faults during plugin loading"
msgstr "Deaktiveer die lokval van segmentasie foute tydens inprop laai"

#: gst/gst.c:293
msgid "Disable updating the registry"
msgstr "Deaktiveer die opdatering van die register"

#: gst/gst.c:298
msgid "Disable spawning a helper process while scanning the registry"
msgstr ""
"Deaktiveer die opwekking van 'n hulperproses terwyl u die register skandeer"

#: gst/gst.c:303
msgid "GStreamer Options"
msgstr "GStreamer Options"

#: gst/gst.c:304
msgid "Show GStreamer Options"
msgstr "Wys GStreamer Opsies"

#: gst/gst.c:1015
#, c-format
msgid "Unknown option"
msgstr "Onbekende opsie"

#: gst/gsterror.c:136
msgid "GStreamer encountered a general core library error."
msgstr "GStreamer het 'n generaals kernbiblioteekfout teëgekom."

#: gst/gsterror.c:138 gst/gsterror.c:180 gst/gsterror.c:204 gst/gsterror.c:246
msgid ""
"GStreamer developers were too lazy to assign an error code to this error."
msgstr ""
"GStreamer ontwikkelaars was te lui om 'n foutkode vir hierdie fout toe te "
"ken."

#: gst/gsterror.c:141
msgid "Internal GStreamer error: code not implemented."
msgstr "Interne GStreamer-fout: kode nie geïmplementeer nie."

#: gst/gsterror.c:143
msgid ""
"GStreamer error: state change failed and some element failed to post a "
"proper error message with the reason for the failure."
msgstr ""
"GStreamer-fout: toestandverandering het misluk en een of ander element kon "
"nie 'n behoorlike foutboodskap met die rede vir die mislukking plaas nie."

#: gst/gsterror.c:146
msgid "Internal GStreamer error: pad problem."
msgstr "Interne GStreamer-fout: pad problem."

#: gst/gsterror.c:148
msgid "Internal GStreamer error: thread problem."
msgstr "Interne GStreamer fout: draad probleem."

#: gst/gsterror.c:150
msgid "GStreamer error: negotiation problem."
msgstr "GStreamer-fout: onderhandeling probleem."

#: gst/gsterror.c:152
msgid "Internal GStreamer error: event problem."
msgstr "Interne GStreamer fout: gebeurtenis probleem."

#: gst/gsterror.c:154
msgid "Internal GStreamer error: seek problem."
msgstr "Interne GStreamer-fout: seek problem."

#: gst/gsterror.c:156
msgid "Internal GStreamer error: caps problem."
msgstr "Interne GStreamer fout: pette probleem."

#: gst/gsterror.c:158
msgid "Internal GStreamer error: tag problem."
msgstr "Interne GStreamer fout: tag probleem."

#: gst/gsterror.c:160
msgid "Your GStreamer installation is missing a plug-in."
msgstr "Jou GStreamer installasie ontbreek 'n inprop."

#: gst/gsterror.c:162
msgid "GStreamer error: clock problem."
msgstr "GStreamer fout: klok probleem."

#: gst/gsterror.c:164
msgid ""
"This application is trying to use GStreamer functionality that has been "
"disabled."
msgstr ""
"Hierdie toepassing probeer GStreamer funksionaliteit gebruik wat "
"gedeaktiveer is."

#: gst/gsterror.c:178
msgid "GStreamer encountered a general supporting library error."
msgstr "GStreamer het 'n generaal ondersteunende biblioteek fout teëgekom."

#: gst/gsterror.c:183
msgid "Could not initialize supporting library."
msgstr "Kon nie ondersteunende biblioteek inisialiseer nie."

#: gst/gsterror.c:185
msgid "Could not close supporting library."
msgstr "Kon nie ondersteunende biblioteek toemaak nie."

#: gst/gsterror.c:187
msgid "Could not configure supporting library."
msgstr "Kon nie ondersteunende biblioteek konfigureer nie."

#: gst/gsterror.c:189
msgid "Encoding error."
msgstr "Enkodering fout."

#: gst/gsterror.c:202
msgid "GStreamer encountered a general resource error."
msgstr "GStreamer het 'n generaal hulpbron fout teëgekom."

#: gst/gsterror.c:207
msgid "Resource not found."
msgstr "Hulpbron nie gevind nie."

#: gst/gsterror.c:209
msgid "Resource busy or not available."
msgstr "Hulpbron besig of nie beskikbaar."

#: gst/gsterror.c:211
msgid "Could not open resource for reading."
msgstr "Kon nie hulpbron oopmaak om te lees nie."

#: gst/gsterror.c:213
msgid "Could not open resource for writing."
msgstr "Kon nie hulpbron oopmaak om te skryf nie."

#: gst/gsterror.c:215
msgid "Could not open resource for reading and writing."
msgstr "Kon nie hulpbron oopmaak vir lees en skryf nie."

#: gst/gsterror.c:217
msgid "Could not close resource."
msgstr "Kon nie hulpbron toemaak nie."

#: gst/gsterror.c:219
msgid "Could not read from resource."
msgstr "Kon nie uit hulpbron lees nie."

#: gst/gsterror.c:221
msgid "Could not write to resource."
msgstr "Kon nie na hulpbron skryf nie."

#: gst/gsterror.c:223
msgid "Could not perform seek on resource."
msgstr "Kon nie seek op hulpbron uitvoer nie."

#: gst/gsterror.c:225
msgid "Could not synchronize on resource."
msgstr "Kon nie hulpbron sinkroniseer nie."

#: gst/gsterror.c:227
msgid "Could not get/set settings from/on resource."
msgstr "Kon nie instellings vanaf/op hulpbron kry/stel nie."

#: gst/gsterror.c:229
msgid "No space left on the resource."
msgstr "Geen spasie oor op die hulpbron nie."

#: gst/gsterror.c:231
msgid "Not authorized to access resource."
msgstr "Nie gemagtig om toegang tot hulpbron te verkry nie."

#: gst/gsterror.c:244
msgid "GStreamer encountered a general stream error."
msgstr "GStreamer het 'n generaal stroom fout teëgekom."

#: gst/gsterror.c:249
msgid "Element doesn't implement handling of this stream. Please file a bug."
msgstr ""
"Element implementeer nie hantering van hierdie stroom nie. Lêer asseblief 'n "
"fout in."

#: gst/gsterror.c:252
msgid "Could not determine type of stream."
msgstr "Kon nie die stroomtipe bepaal nie."

#: gst/gsterror.c:254
msgid "The stream is of a different type than handled by this element."
msgstr ""
"Die stroom is nie van dieselfde tipe as wat deur die element hanteer word "
"nie."

#: gst/gsterror.c:257
msgid "There is no codec present that can handle the stream's type."
msgstr ""
"Daar is nie 'n kodek beskikbaar om hierdie stroom se tipe te hanteer nie."

#: gst/gsterror.c:259
msgid "Could not decode stream."
msgstr "Kon nie stroom dekodeer nie."

#: gst/gsterror.c:261
msgid "Could not encode stream."
msgstr "Kon nie stroom enkodeer nie."

#: gst/gsterror.c:263
msgid "Could not demultiplex stream."
msgstr "Kon nie stroom demultiplekseer nie."

#: gst/gsterror.c:265
msgid "Could not multiplex stream."
msgstr "Kon nie stroom multiplekseer nie."

#: gst/gsterror.c:267
msgid "The stream is in the wrong format."
msgstr "Die stroom is in die verkeerde formaat."

#: gst/gsterror.c:269
msgid "The stream is encrypted and decryption is not supported."
msgstr "Die stroom is geïnkripteer en dekripsie word nie ondersteun nie."

#: gst/gsterror.c:271
msgid ""
"The stream is encrypted and can't be decrypted because no suitable key has "
"been supplied."
msgstr ""
"Die stroom is geïnkripteer en kan nie gedekripteer word nie omdat geen "
"geskikte sleutel verskaf is nie."

#: gst/gsterror.c:311
#, c-format
msgid "No error message for domain %s."
msgstr "Geen foutboodskap vir domein %s."

#: gst/gsterror.c:319
#, c-format
msgid "No standard error message for domain %s and code %d."
msgstr "Geen standaard foutboodskap vir domein %s en kode %d."

#: gst/gstpipeline.c:593
msgid "Selected clock cannot be used in pipeline."
msgstr "Geselekteerde klok kan nie in pyplyn gebruik word nie."

#: gst/gstregistry.c:1808
#, c-format
msgid "Error writing registry cache to %s: %s"
msgstr "Fout met skryf van registerkas na %s: %s"

