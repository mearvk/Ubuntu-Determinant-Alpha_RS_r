msgstr "Beperking nie nagekom."

#: nova/exception.py:492
msgid "Resource could not be found."
msgstr "Hulpbron kon nie gevind word nie."

#: nova/exception.py:497
#, python-format
msgid "No agent-build associated with id %(id)s."
msgstr "Geen agent-bou geassosieer met id %(id)s."

