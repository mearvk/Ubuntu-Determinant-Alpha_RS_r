#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Hierdie program moet as \"root\" begin word\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Skep en formatteer 'n geïnkripteerse LUKS-toestel\n"
"Gebruik: luksformat [-t <lêer stelsel>] <toestel> [ mkfs keuses ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Fout: toestel gemonteer: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Fout: ongeldige lêer stelsel: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Fout: kon nie tydelik gekarteerde toestel naam genereer nie"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Skep geïnkripteerde toestel op %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Kon nie LUKS-toestel %s skep nie"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Voer asb. weer u wagwoord in om dit te bevestig\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Die wagwoorde wat u ingevoer het is nie identies nie\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Kon nie toestel formatteer met lêer stelsel %s nie"
