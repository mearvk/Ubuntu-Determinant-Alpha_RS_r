#: src/libnmc-setting/nm-meta-setting-desc.c:6065
msgid ""
"Enter a list of IPv4 addresses of DNS servers.\n"
"\n"
"Example: 8.8.8.8, 8.8.4.4\n"
msgstr ""
"Ingaan 'n lys van IPv4 adresse van DNS bedieners.\n"
"\n"
"Voorbeeld: 8.8.8.8, 8.8.4.4\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6112
msgid "IPv4 address (IP[/plen]) [none]"
msgstr "IPv4 adres (IP[/plen]) [geen]"

#: src/libnmc-setting/nm-meta-setting-desc.c:6114
msgid ""
"Enter a list of IPv4 addresses formatted as:\n"
"  ip[/prefix], ip[/prefix],...\n"
"Missing prefix is regarded as prefix of 32.\n"
"\n"
"Example: 192.168.1.5/24, 10.0.0.11/24\n"
msgstr ""
"Ingaan 'n lys van IPv4 adresse geformateer as:\n"
"  ip[/prefix], ip[/prefix],...\n"
"Ontbrekende voorvoegsel word beskouas voorvoegsel van 32.\n"
"\n"
"Voorbeeld: 192.168.1.5/24, 10.0.0.11/24\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6133
msgid "IPv4 gateway [none]"
msgstr "IPv4 gateway [geen]"

#: src/libnmc-setting/nm-meta-setting-desc.c:6141
msgid ""
"Enter a list of IPv4 routes formatted as:\n"
"  ip[/prefix] [next-hop] [metric],...\n"
"\n"
"Missing prefix is regarded as a prefix of 32.\n"
"Missing next-hop is regarded as 0.0.0.0.\n"
"Missing metric means default (NM/kernel will set a default value).\n"
"\n"
"Examples: 192.168.2.0/24 192.168.2.1 3, 10.1.0.0/16 10.0.0.254\n"
"          10.1.2.0/24\n"
msgstr ""
"Ingaan 'n lys van IPv4 roetes geformateer as:\n"
"  ip[/prefix] [next-hop] [metric],...\n"
"\n"
"Ontbrekende voorvoegsel word beskou as 'n voorvoegsel van 32.\n"
"Ontbrekende volgende hop word beskou as 0.0.0.0.\n"
"Ontbrekende metrieke beteken verstek (NM/kern sal 'n verstek waarde stel).\n"
"Voorbeelde: 192.168.2.0/24 192.168.2.1 3, 10.1.0.0/16 10.0.0.254\n"
"          10.1.2.0/24\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6181
msgid ""
"Enter a list of IPv4 routing rules formatted as:\n"
"  priority [prio] [from [src]] [to [dst]], ,...\n"
"\n"
msgstr ""
"Ingaan 'n lys van IPv4-roeteerreëls geformateer as:\n"
"  prioriteit [prio] [from [src]] [to [dst]], ,...\n"
"\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6317
msgid ""
"Enter a list of IPv6 addresses of DNS servers.  If the IPv6 configuration "
"method is 'auto' these DNS servers are appended to those (if any) returned "
"by automatic configuration.  DNS servers cannot be used with the 'shared' or "
"'link-local' IPv6 configuration methods, as there is no upstream network. In "
"all other IPv6 configuration methods, these DNS servers are used as the only "
"DNS servers for this connection.\n"
"\n"
"Example: 2607:f0d0:1002:51::4, 2607:f0d0:1002:51::1\n"
msgstr ""
"Ingaan 'n lys van IPv6 adresse van DNS bedieners.  Indien die IPv6 "
"konfigurasie metode is 'auto' hierdie DNS-bedieners is aangeheg aan daardie "
"(indien enige) teruggestuur deur outomatiese konfigurasie.  DNS bedieners "
"kan nie gebruik word met die 'shared' of 'link-local' IPv6 "
"konfigurasiemetodes, aangesien daar geen stroomop-netwerk is nie. In alle "
"ander IPv6 konfigurasiemetodes, word hierdie DNS-bedieners as die enigste "
"DNS bedieners vir hierdie verbinding gebruik.\n"
"\n"
"Example: 2607:f0d0:1002:51::4, 2607:f0d0:1002:51::1\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6370
msgid "IPv6 address (IP[/plen]) [none]"
msgstr "IPv6-adres (IP[/plen]) [geen]"

#: src/libnmc-setting/nm-meta-setting-desc.c:6372
msgid ""
"Enter a list of IPv6 addresses formatted as:\n"
"  ip[/prefix], ip[/prefix],...\n"
"Missing prefix is regarded as prefix of 128.\n"
"\n"
"Example: 2607:f0d0:1002:51::4/64, 1050:0:0:0:5:600:300c:326b\n"
msgstr ""
"Ingaan 'n lys van IPv6 adresse geformateer as:\n"
"  ip[/prefix], ip[/prefix],...\n"
"Ontbrekende voorvoegsel word beskou as voorvoegsel van 128.\n"
"\n"
"Voorbeeld: 2607:f0d0:1002:51::4/64, 1050:0:0:0:5:600:300c:326b\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6391
msgid "IPv6 gateway [none]"
msgstr "IPv6 gateway [geen]"

#: src/libnmc-setting/nm-meta-setting-desc.c:6399
msgid ""
"Enter a list of IPv6 routes formatted as:\n"
"  ip[/prefix] [next-hop] [metric],...\n"
"\n"
"Missing prefix is regarded as a prefix of 128.\n"
"Missing next-hop is regarded as \"::\".\n"
"Missing metric means default (NM/kernel will set a default value).\n"
"\n"
"Examples: 2001:db8:beef:2::/64 2001:db8:beef::2, 2001:db8:beef:3::/64 "
"2001:db8:beef::3 2\n"
"          abbe::/64 55\n"
msgstr ""
"Ingaan 'n lys van IPv6 roetes geformateer as:\n"
"  ip[/prefix] [next-hop] [metric],...\n"
"\n"
"Ontbrekende voorvoegsel word beskou as 'n voorvoegsel van 128.\n"
"Ontbrekende volgende-hop word beskou as \"::\".\n"
"Ontbrekende metrieke beteken verstek (NM/kernel sal 'n verstek waarde "
"stel).\n"
"\n"
"Voorbeelde: 2001:db8:beef:2::/64 2001:db8:beef::2, 2001:db8:beef:3::/64 "
"2001:db8:beef::3 2\n"
"          abbe::/64 55\n"

#: src/libnmc-setting/nm-meta-setting-desc.c:6439
msgid ""
