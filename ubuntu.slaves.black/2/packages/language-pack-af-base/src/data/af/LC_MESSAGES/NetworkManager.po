#. TRANSLATORS: do not translate command names and keywords before ::
#. *              However, you should translate terms enclosed in <>.
#. 
#: src/nmcli/connections.c:7066
msgid ""
"---[ Main menu ]---\n"
"goto     [<setting> | <prop>]        :: go to a setting or property\n"
"remove   <setting>[.<prop>] | <prop> :: remove setting or reset property "
"value\n"
"set      [<setting>.<prop> <value>]  :: set property value\n"
"describe [<setting>.<prop>]          :: describe property\n"
"print    [all | <setting>[.<prop>]]  :: print the connection\n"
"verify   [all | fix]                 :: verify the connection\n"
"save     [persistent|temporary]      :: save the connection\n"
"activate [<ifname>] [/<ap>|<nsp>]    :: activate the connection\n"
"back                                 :: go one level up (back)\n"
"help/?   [<command>]                 :: print this help\n"
"nmcli    <conf-option> <value>       :: nmcli configuration\n"
"quit                                 :: exit nmcli\n"
msgstr ""
"---[ Main menu ]---\n"
"goto     [<setting> | <prop>]        :: gaan na 'n instelling of eiendom\n"
"remove   <setting>[.<prop>] | <prop> :: verwyder instelling of stel terug "
"eiendom waarde\n"
"set      [<setting>.<prop> <value>]  :: stel eiendom waarde\n"
"describe [<setting>.<prop>]          :: beskryf eiendom\n"
"print    [all | <setting>[.<prop>]]  :: afdruk die konneksie\n"
"verify   [all | fix]                 :: verifieer die konneksie\n"
"save     [persistent|temporary]      :: stoor die konneksie\n"
"activate [<ifname>] [/<ap>|<nsp>]    :: aktiveer die konneksie\n"
"back                                 :: gaan een vlak boontoe (terug)\n"
"help/?   [<command>]                 :: afdruk hierdie hulp\n"
"nmcli    <conf-option> <value>       :: nmcli konfigurasie\n"
"quit                                 :: uitgang nmcli\n"

#: src/nmcli/connections.c:7094
msgid ""
"goto <setting>[.<prop>] | <prop>  :: enter setting/property for editing\n"
"\n"
"This command enters into a setting or property for editing it.\n"
"\n"
"Examples: nmcli> goto connection\n"
"          nmcli connection> goto secondaries\n"
"          nmcli> goto ipv4.addresses\n"
msgstr ""
"goto <setting>[.<prop>] | <prop>  :: betree instelling/eienskap vir "
"redigering\n"
"\n"
"Hierdie bevel betree 'n instelling-of eiendom om te redigering dit.\n"
"\n"
"Voorbeelde: nmcli> goto connection\n"
"          nmcli connection> goto secondaries\n"
"          nmcli> goto ipv4.addresses\n"

#: src/nmcli/connections.c:7102
msgid ""
"remove <setting>[.<prop>]  :: remove setting or reset property value\n"
"\n"
"This command removes an entire setting from the connection, or if a "
"property\n"
"is given, resets that property to the default value.\n"
"\n"
"Examples: nmcli> remove wifi-sec\n"
"          nmcli> remove eth.mtu\n"
msgstr ""
"remove <setting>[.<prop>]  :: verwyder instelling of stel eiendom waarde "
"terug\n"
"\n"
"Hierdie bevel verwyder 'n hele instelling van die verbinding, of as 'n "
"eiendom\n"
"gegee word, stel daardie eiendom terug na die verstek waarde.\n"
"\n"
"Examples: nmcli> remove wifi-sec\n"
"          nmcli> remove eth.mtu\n"

#: src/nmcli/connections.c:7109
msgid ""
"set [<setting>.<prop> <value>]  :: set property value\n"
"\n"
"This command sets property value.\n"
"\n"
"Example: nmcli> set con.id My connection\n"
msgstr ""
"set [<setting>.<prop> <value>]  :: stel eiendom waarde\n"
"\n"
"Hierdie bevel stel eiendom waarde.\n"
"\n"
"Voorbeeld: nmcli> set con.id My konneksie\n"

#: src/nmcli/connections.c:7114
msgid ""
"add [<setting>.<prop> <value>]  :: add property value\n"
"\n"
"This command appends property value.\n"
"\n"
"Example: nmcli> add ipv4.addresses 192.168.1.1/24\n"
msgstr ""
"add [<setting>.<prop> <value>]  :: byvoeg eiendom waarde\n"
"\n"
"Hierdie bevel appends eiendom waarde.\n"
"\n"
"Voorbeeld: nmcli> add ipv4.addresses 192.168.1.1/24\n"

#: src/nmcli/connections.c:7119
msgid ""
"describe [<setting>.<prop>]  :: describe property\n"
"\n"
"Shows property description. You can consult nm-settings(5) manual page to "
"see all NM settings and properties.\n"
msgstr ""
"describe [<setting>.<prop>]  :: beskryf eiendom\n"
"\n"
"Wys eiendom beskrywing. Jy kan konsulteer nm-settings(5) handleiding bladsy "
"om alle te sien NM instellings en eiendomme.\n"

#: src/nmcli/connections.c:7124
msgid ""
"print [all]  :: print setting or connection values\n"
"\n"
"Shows current property or the whole connection.\n"
"\n"
"Example: nmcli ipv4> print all\n"
msgstr ""
"print [all]  :: afdruk instelling of konneksie waardes\n"
"\n"
"Toon huidige eiendom of die hele konneksie.\n"
"\n"
"Voorbeeld: nmcli ipv4> print all\n"

#: src/nmcli/connections.c:7130
msgid ""
"verify [all | fix]  :: verify setting or connection validity\n"
"\n"
"Verifies whether the setting or connection is valid and can be saved later.\n"
"It indicates invalid values on error. Some errors may be fixed "
"automatically\n"
"by 'fix' option.\n"
"\n"
"Examples: nmcli> verify\n"
"          nmcli> verify fix\n"
"          nmcli bond> verify\n"
msgstr ""
"verify [all | fix]  :: verifieer instelling of konneksie geldigheid\n"
"\n"
"Verifieer of die instelling of verbinding geldig is en later gestoor kan "
"word.\n"
"Dit dui ongeldige waardes op fout aan. Sommige foute kan outomaties "
"reggestel word\n"
"deur 'fix' opsie.\n"
"\n"
"Voorbeelde: nmcli> verify\n"
"          nmcli> verify fix\n"
"          nmcli bond> verify\n"

#: src/nmcli/connections.c:7140
msgid ""
"save [persistent|temporary]  :: save the connection\n"
"\n"
"Sends the connection profile to NetworkManager that either will save it\n"
"persistently, or will only keep it in memory. 'save' without an argument\n"
"means 'save persistent'.\n"
"Note that once you save the profile persistently those settings are saved\n"
"across reboot or restart. Subsequent changes can also be temporary or\n"
"persistent, but any temporary changes will not persist across reboot or\n"
"restart. If you want to fully remove the persistent connection, the "
"connection\n"
"profile must be deleted.\n"
msgstr ""
"save [persistent|temporary]  :: stoor die konneksie\n"
"\n"
"Stuur die verbinding profiel na NetwerkBestuurder dat óf sal dit red\n"
"persistently, of sal slegs net in die geheue hou. 'save' sonder 'n argument\n"
"betekens 'save persistent'.\n"
"Nota dat sodra jy die profiel stoor persistently daardie instellings word "
"gestoor\n"
"dwarsoor herlaai of herbegin. Daaropvolgende veranderinge kan ook tydelik "
"wees of\n"
"persistent, maar enige tydelike veranderinge sal nie voortduur tydens "
"herlaai of\n"
"herbegin. Indien jy wil om volledig verwyder die persistent konneksie, die "
"konneksie\n"
"profiel moet uitgevee word.\n"

#: src/nmcli/connections.c:7151
msgid ""
"activate [<ifname>] [/<ap>|<nsp>]  :: activate the connection\n"
"\n"
"Activates the connection.\n"
"\n"
"Available options:\n"
"<ifname>    - device the connection will be activated on\n"
"/<ap>|<nsp> - AP (Wi-Fi) or NSP (WiMAX) (prepend with / when <ifname> is not "
"specified)\n"
msgstr ""
"activate [<ifname>] [/<ap>|<nsp>]  :: aktiveer die konneksie\n"
"\n"
"Aktiveer die konneksie.\n"
"\n"
"Beskikbare opsies:\n"
"<ifname>    - toestel die konneksie geaktiveer sal word op\n"
"/<ap>|<nsp> - AP (Wi-Fi) of NSP (WiMAX) (prepend met / wanneer <ifname> is "
"nie gespesifiseer)\n"

#: src/nmcli/connections.c:7159 src/nmcli/connections.c:7318
msgid ""
"back  :: go to upper menu level\n"
"\n"
msgstr ""
"back  :: gaan na die boonste spyskaart vlak\n"
"\n"

#: src/nmcli/connections.c:7162
msgid ""
"help/? [<command>]  :: help for the nmcli commands\n"
"\n"
msgstr ""
"help/? [<command>]  :: hulp vir die nmcli bevele\n"
"\n"

#: src/nmcli/connections.c:7165
#, c-format
msgid ""
"nmcli [<conf-option> <value>]  :: nmcli configuration\n"
"\n"
"Configures nmcli. The following options are available:\n"
"status-line yes | no          [default: no]\n"
"save-confirmation yes | no    [default: yes]\n"
"show-secrets yes | no         [default: no]\n"
"prompt-color <color> | <0-8>  [default: 0]\n"
"%s\n"
"Examples: nmcli> nmcli status-line yes\n"
"          nmcli> nmcli save-confirmation no\n"
"          nmcli> nmcli prompt-color 3\n"
msgstr ""
"nmcli [<conf-option> <value>]  :: nmcli configuration\n"
"\n"
"Konfigureer nmcli. Die volgende opsies is beskikbaar:\n"
"status-line yes | no          [default: no]\n"
"save-confirmation yes | no    [default: yes]\n"
"show-secrets yes | no         [default: no]\n"
"prompt-color <color> | <0-8>  [default: 0]\n"
"%s\n"
"Voorbeelde: nmcli> nmcli status-line yes\n"
"          nmcli> nmcli save-confirmation no\n"
"          nmcli> nmcli prompt-color 3\n"

#: src/nmcli/connections.c:7187 src/nmcli/connections.c:7324
msgid ""
"quit  :: exit nmcli\n"
"\n"
"This command exits nmcli. When the connection being edited is not saved, the "
"user is asked to confirm the action.\n"
msgstr ""
"quit  :: exit nmcli\n"
"\n"
"Hierdie bevel uitgange nmcli. Wanneer die verbinding wat geredigeer word, "
"nie gestoor word nie, die gebruiker word gevra om die handeling te "
"bevestig.\n"

#: src/nmcli/connections.c:7192 src/nmcli/connections.c:7329
#: src/nmcli/connections.c:7721 src/nmcli/connections.c:8763
#, c-format
msgid "Unknown command: '%s'\n"
msgstr "Onbekende bevel: '%s'\n"

#. TRANSLATORS: do not translate command names and keywords before ::
#. *              However, you should translate terms enclosed in <>.
#. 
#: src/nmcli/connections.c:7257
msgid ""
"---[ Property menu ]---\n"
"set      [<value>]               :: set new value\n"
"add      [<value>]               :: add new option to the property\n"
"change                           :: change current value\n"
"remove   [<index> | <option>]    :: delete the value\n"
"describe                         :: describe property\n"
"print    [setting | connection]  :: print property (setting/connection) "
"value(s)\n"
"back                             :: go to upper level\n"
"help/?   [<command>]             :: print this help or command description\n"
"quit                             :: exit nmcli\n"
msgstr ""
"---[ Eiendom spyskaart ]---\n"
"set      [<value>]               :: stel nuwe waarde\n"
"add      [<value>]               :: byvoeg nuwe opsie die eiendom\n"
"change                           :: verander huidige waarde\n"
"remove   [<index> | <option>]    :: skrap die waarde\n"
"describe                         :: beskryf eiendom\n"
"print    [setting | connection]  :: afdruk eiendom (instelling/verbinding) "
"waarde(s)\n"
"back                             :: gaan na boonste vlak\n"
"help/?   [<command>]             :: afdruk hierdie hulp of bevel beskrywing\n"
"quit                             :: uitgang nmcli\n"

#: src/nmcli/connections.c:7281
msgid ""
"set [<value>]  :: set new value\n"
"\n"
"This command sets provided <value> to this property\n"
msgstr ""
"set [<value>]  :: stel nuwe waarde\n"
"\n"
"Hierdie bevel stelle verskafde <value> na hierdie eiendom\n"

#: src/nmcli/connections.c:7285
msgid ""
"add [<value>]  :: append new value to the property\n"
"\n"
"This command adds provided <value> to this property, if the property is of a "
"container type. For single-valued properties the property value is replaced "
"(same as 'set').\n"
msgstr ""
"add [<value>]  :: append nuwe waarde vir die eiendom\n"
"\n"
"Hierdie bevel voeg verskafde <value> na hierdie eiendom, indien die eiendom "
"is van 'n houer tipe. Vir enkelwaarde eiendomme word die eiendom waarde "
"vervang (dieselfde as 'set').\n"

#: src/nmcli/connections.c:7291
msgid ""
"change  :: change current value\n"
"\n"
"Displays current value and allows editing it.\n"
msgstr ""
"change  :: verander huidige waarde\n"
"\n"
"Vertoon huidige waarde en laat dit toe om dit te redigering.\n"

#: src/nmcli/connections.c:7296
msgid ""
"remove [<value>|<index>|<option name>]  :: delete the value\n"
"\n"
"Removes the property value. For single-valued properties, this sets the\n"
"property back to its default value. For container-type properties, this "
"removes\n"
"all the values of that property or you can specify an argument to remove "
"just\n"
"a single item or option. The argument is either a value or index of the item "
"to\n"
"remove, or an option name (for properties with named options).\n"
"\n"
"Examples: nmcli ipv4.dns> remove 8.8.8.8\n"
"          nmcli ipv4.dns> remove 2\n"
"          nmcli bond.options> remove downdelay\n"
"\n"
msgstr ""
"remove [<value>|<index>|<option name>]  :: skrap die waarde\n"
"\n"
"Verwyders die eiendom waarde. Vir enkel-gewaarde eiendomme, hierdie stel "
"die\n"
"eiendom terug na sy verstek waarde. Vir houer-tipe eiendomme, dit verwyders\n"
"alle die waardes van daardie eiendom of jy kan 'n argument spesifiseer om "
"net te verwyder\n"
"'n enkele item of opsie. Die argument is óf 'n waarde óf indeks van die item "
"na\n"
"verwyder, of 'n opsienaam (vir eiendomme met benoemde opsies).\n"
"\n"
"Voorbeelde: nmcli ipv4.dns> remove 8.8.8.8\n"
"          nmcli ipv4.dns> remove 2\n"
"          nmcli bond.options> remove downdelay\n"
"\n"

#: src/nmcli/connections.c:7307
msgid ""
"describe  :: describe property\n"
"\n"
"Shows property description. You can consult nm-settings(5) manual page to "
"see all NM settings and properties.\n"
msgstr ""
"describe  :: beskryf eiendom\n"
"\n"
"Wys eiendom beskrywing. Jy kan nm-instellings(5) handleiding bladsy "
"raadpleeg om alle NM instellings en  eienskappe te sien.\n"

#: src/nmcli/connections.c:7312
msgid ""
"print [property|setting|connection]  :: print property (setting, connection) "
"value(s)\n"
"\n"
"Shows property value. Providing an argument you can also display values for "
"the whole setting or connection.\n"
msgstr ""
"print [property|setting|connection]  :: druk eiendom (instelling, "
"verbinding) waarde(s)\n"
"\n"
"Wys eiendom waarde. Verskaf 'n argument, kan jy ook waardes vir die hele "
"instelling of verbinding vertoon.\n"

#: src/nmcli/connections.c:7321
msgid ""
"help/? [<command>]  :: help for nmcli commands\n"
"\n"
msgstr ""
"help/? [<command>]  :: hulp vir nmcli bevele\n"
"\n"

