#: src/utils/pacat.c:676
#, c-format
msgid ""
"%s [options]\n"
"%s\n"
"\n"
"  -h, --help                            Show this help\n"
"      --version                         Show version\n"
"\n"
"  -r, --record                          Create a connection for recording\n"
"  -p, --playback                        Create a connection for playback\n"
"\n"
"  -v, --verbose                         Enable verbose operations\n"
"\n"
"  -s, --server=SERVER                   The name of the server to connect "
"to\n"
"  -d, --device=DEVICE                   The name of the sink/source to "
"connect to\n"
"  -n, --client-name=NAME                How to call this client on the "
"server\n"
"      --stream-name=NAME                How to call this stream on the "
"server\n"
"      --volume=VOLUME                   Specify the initial (linear) volume "
"in range 0...65536\n"
"      --rate=SAMPLERATE                 The sample rate in Hz (defaults to "
"44100)\n"
"      --format=SAMPLEFORMAT             The sample format, see\n"
"                                        "
"https://www.freedesktop.org/wiki/Software/PulseAudio/Documentation/User/Suppo"
"rtedAudioFormats/\n"
"                                        for possible values (defaults to "
"s16ne)\n"
"      --channels=CHANNELS               The number of channels, 1 for mono, "
"2 for stereo\n"
"                                        (defaults to 2)\n"
"      --channel-map=CHANNELMAP          Channel map to use instead of the "
"default\n"
"      --fix-format                      Take the sample format from the "
"sink/source the stream is\n"
"                                        being connected to.\n"
"      --fix-rate                        Take the sampling rate from the "
"sink/source the stream is\n"
"                                        being connected to.\n"
"      --fix-channels                    Take the number of channels and the "
"channel map\n"
"                                        from the sink/source the stream is "
"being connected to.\n"
"      --no-remix                        Don't upmix or downmix channels.\n"
"      --no-remap                        Map channels by index instead of "
"name.\n"
"      --latency=BYTES                   Request the specified latency in "
"bytes.\n"
"      --process-time=BYTES              Request the specified process time "
"per request in bytes.\n"
"      --latency-msec=MSEC               Request the specified latency in "
"msec.\n"
"      --process-time-msec=MSEC          Request the specified process time "
"per request in msec.\n"
"      --property=PROPERTY=VALUE         Set the specified property to the "
"specified value.\n"
"      --raw                             Record/play raw PCM data.\n"
"      --passthrough                     Passthrough data.\n"
"      --file-format[=FFORMAT]           Record/play formatted PCM data.\n"
"      --list-file-formats               List available file formats.\n"
"      --monitor-stream=INDEX            Record from the sink input with "
"index INDEX.\n"
msgstr ""
"%s [options]\n"
"%s\n"
"\n"
"  -h, --help                            Wys hierdie hulp\n"
"      --version                         Wys weergawe\n"
"\n"
"  -r, --record                          Skep 'n verbinding vir opname\n"
"  -p, --playback                        Skep 'n konneksie vir terugspeel\n"
"\n"
"  -v, --verbose                         In staat te stel verbose operasies\n"
"\n"
"  -s, --server=SERVER                   Die naam van die bediener om aan te "
"sluit op\n"
"  -d, --device=DEVICE                   Die naam van die wasbak/bron om aan "
"te sluit\n"
"  -n, --client-name=NAME                Hoe om hierdie klient op die "
"bediener te call\n"
"      --stream-name=NAME                Hoe om hierdie stroom op die "
"bediener te call\n"
"      --volume=VOLUME                   Spesifiseer die aanvanklike "
"(lineêre) volume in die reeks 0 ... 65536\n"
"      --rate=SAMPLERATE                 Die steekproef tempo in Hz (verstek "
"44100)\n"
"      --format=SAMPLEFORMAT             Die voorbeeld formaat, sien\n"
"                                        "
"https://www.freedesktop.org/wiki/Software/PulseAudio/Documentation/User/Suppo"
"rtedAudioFormats/\n"
"                                        vir moontlike waardes (verstek na "
"s16ne)\n"
"      --channels=CHANNELS               Die aantal kanale, 1 vir mono, 2 vir "
"stereo \n"
"                                        (Verstek na 2)\n"
"      --channel-map=CHANNELMAP          Kanaal karteer om plaas te gebruik "
"van die verstek\n"
"      --fix-format                      Neem die voorbeeldformaat uit die "
"wasbak/bron wat die stroom is\n"
"                                        verbonde wees aan.\n"
"      --fix-rate                        Neem die bemonsteringsnelheid van "
"die wasbak/bron wat die stroom is\n"
"                                        verbonde wees aan.\n"
"      --fix-channels                    Neem die aantal kanale en die "
"kanaalkaart\n"
"                                        vanaf die wasbak/bron waaraan die "
"stroom gekoppel is te.\n"
"      --no-remix                        Moenie kanale upmix of downmix nie. "
"\n"
"      --no-remap                        Kaart kanale volgens indeks in plaas "
"van naam.\n"
"      --latency=BYTES                   Versoek die gespesifiseerde latency "
"in grepe.\n"
"      --process-time=BYTES              Versoek die gespesifiseerde "
"prosesstyd per versoek in grepe.\n"
"      --latency-msec=MSEC               Versoek die gespesifiseerde "
"vertraging in msek.\n"
"      --process-time-msec=MSEC          Versoek die gespesifiseerde "
"prosesstyd per versoek in msek.\n"
"      --property=PROPERTY=VALUE         Stel die gespesifiseerde eienskap op "
"die gespesifiseerde waarde.\n"
"      --raw                             Rekord/speel rou PCM data.\n"
"      --passthrough                     Passthrough data.\n"
"      --file-format[=FFORMAT]           Rekord/speel geformaatde PCM data.\n"
"      --list-file-formats               Lys beskikbare lêer formate.\n"
"      --monitor-stream=INDEX            Teken op vanaf die wasbak inset met "
"indeks INDEKS.\n"

