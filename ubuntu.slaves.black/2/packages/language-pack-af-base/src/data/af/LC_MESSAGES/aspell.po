"Die sleutel \"%key:1\" neem nie parameters as die prefiks \"reset-\" gebruik "
"word nie."

#: common/errors.cpp:203
msgid ""
"The key \"%key:1\" does not take any parameters when prefixed by an \"enable-"
"\"."
msgstr ""
"Die sleutel \"%key:1\" neem nie parameters as die prefiks \"enable-\" "
"gebruik word nie."

#: common/errors.cpp:211
msgid ""
"The key \"%key:1\" does not take any parameters when prefixed by a \"dont-\" "
"or \"disable-\"."
msgstr ""
"Die sleutel \"%key:1\" neem nie parameters as die prefiks \"dont-\" of "
"\"disable-\" gebruik word nie."

#: common/errors.cpp:219
msgid ""
"The key \"%key:1\" does not take any parameters when prefixed by a \"clear-"
