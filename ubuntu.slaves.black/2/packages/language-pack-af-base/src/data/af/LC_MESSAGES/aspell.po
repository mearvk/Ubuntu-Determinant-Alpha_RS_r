#: common/config.cpp:1418
msgid "keyboard definition to use for typo analysis"
msgstr "sleutelborddefinisie vir tikfoutanalise"

#: common/config.cpp:1420
msgid "language code"
msgstr "taalkode"

#: common/config.cpp:1422
msgid "deprecated, use lang instead"
