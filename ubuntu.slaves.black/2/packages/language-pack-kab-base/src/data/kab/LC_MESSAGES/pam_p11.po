#: src/pam_p11.c:205
msgid "Error loading PKCS#11 module"
msgstr "Tuccḍa lawan n usali n uzegri PKCS # 11"

#: src/pam_p11.c:213 src/pam_p11.c:265
msgid "Error initializing PKCS#11 module"
msgstr "Tuccḍa lawan n uwennez n uzegrir PKCS#11"

#: src/pam_p11.c:333
msgid " (last try)"
msgstr " (aneɛruḍ aneggaru)"

#: src/pam_p11.c:340
#, c-format
msgid "Login on PIN pad with %s%s"
msgstr "Kcem ɣerunasiw PIN  akked %s%s"

#: src/pam_p11.c:346
#, c-format
msgid "Login with %s%s: "
msgstr "Kcem akked %s%s "

#: src/pam_p11.c:370
msgid "Invalid PIN"
msgstr "Pin ur iṣeḥḥa ara"

#: src/pam_p11.c:378
msgid "PIN not verified; PIN locked"
msgstr "Pin ur yettusenqed ara; Pin isekkeṛ"

#: src/pam_p11.c:380
msgid "PIN not verified; one try remaining"
msgstr "pin ur yettusenqed ara; mazal yiwen n uneɛruḍ"

#: src/pam_p11.c:382
msgid "PIN not verified"
msgstr "Pin ur yettwasenqed ara"

#: src/pam_p11.c:424
#, c-format
msgid "Change PIN with PUK on PIN pad for %s"
msgstr "Senfel Pin s Puk ɣef unasiw Pin i %s"

#: src/pam_p11.c:428
#, c-format
msgid "Change PIN on PIN pad for %s"
msgstr "Senfel PIN ɣef unasiw PIN i %s"

#: src/pam_p11.c:435
#, c-format
msgid "PUK for %s: "
msgstr "PUK i %s: "

#: src/pam_p11.c:446
msgid "Current PIN: "
msgstr "PIN amiran: "

#: src/pam_p11.c:464
msgid "Enter new PIN: "
msgstr "Sekcem PIN amaynut "

#: src/pam_p11.c:467
msgid "Retype new PIN: "
msgstr "Ɛawed tira n PIN: "

#: src/pam_p11.c:471
msgid "PINs don't match"
msgstr "PINs ur meɣrin"

#: src/pam_p11.c:478
msgid "PIN not changed; PIN locked"
msgstr "PIN ur yettubeddel ara; PIN isekkeṛ"

#: src/pam_p11.c:480
msgid "PIN not changed; one try remaining"
msgstr "PIN ur yettubeddel ara; mazal aneɛruḍ aneggaru"

#: src/pam_p11.c:482
msgid "PIN not changed"
msgstr "PIN ur yettubeddel ara"

#: src/pam_p11.c:610
msgid "No token found"
msgstr "Ulac ajuṭun yettwafen"

#: src/pam_p11.c:612
msgid "No authorized keys on token"
msgstr "Ur tettusireg ula d yiwet n tsarut ɣef ujiṭun"

#: src/pam_p11.c:674
msgid "Error verifying key"
msgstr "Tella-d tuccḍa deg usenqed n tsarut"
