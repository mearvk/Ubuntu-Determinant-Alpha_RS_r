msgid "Byobu Help"
msgstr "Tallelt n Byobu"

#: byobu-config:144 byobu-config:161 byobu-config:195 byobu-config:335
#: byobu-config:376 byobu-config:449
msgid "Apply"
msgstr "Snes"

#: byobu-config:146
msgid "Which profile would you like to use?"
msgstr "Anwa amaɣnu i tebɣiḍ ad tesqedceḍ?"

#: byobu-config:162
msgid "Which set of keybindings would you like to use?"
msgstr "Anwa agraw n yinegzumen n unasiw i tebɣiḍ ad tesqedceḍ?"

#: byobu-config:175
msgid "Title: "
msgstr "Azwel: "

#: byobu-config:177
msgid "Command: "
msgstr "Taludna: "

#: byobu-config:179
msgid "Presets: "
msgstr "Izwirfranen: "

#: byobu-config:193
msgid "Add to default windows"
msgstr "Rnu ɣer yisfuyla n umezwer"

#: byobu-config:197
msgid "Create new window(s):"
msgstr "Rnu asfaylu (isfuyla) amaynut (imaynuten):"

#: byobu-config:336
msgid "Toggle status notifications:"
msgstr "Qluqel talɣutin n waddad:"

#: byobu-config:368
msgid "Windows:"
msgstr "Isfuyla:"

#: byobu-config:378
msgid "Select window(s) to create by default:"
msgstr "Fren asfaylu (isfuyla) ara ternuḍ s wudem amezwer:"

#: byobu-config:398
msgid "Byobu will be launched automatically next time you login."
msgstr "Byobu ad ikker s wudem awurman tikkelt-nniḍen mi ara teqqneḍ."

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "Byobu ur yettwaseqdac ara tikkelt-nniḍen mi ara teqqneḍ."

#: byobu-config:408
msgid "Message"
msgstr "Izen"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "Taqeffalt n unsar: ctrl-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "Snifel taluddayt n unsar"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr "<Tab>/<Alt-Tab> gar yiferdisen  | <Enter> iferren | <Esc> itteffeɣ"
