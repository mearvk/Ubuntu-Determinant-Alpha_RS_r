#: byobu-select-profile:107
msgid "Choose"
msgstr "Fren"

#: byobu-export:171
msgid "File exists"
msgstr "Afaylu yella"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "Tukksa n ufaylu? [y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "Fren ini: "

#: byobu-export:240
msgid "Profile"
msgstr "Amaɣnu"

#: byobu-export:241
msgid "Archive"
msgstr "Aɣbar"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Kkes-d aɣbar deg ukaram-ik udmawan ɣef unagraw i tebɣiḍ."

#: byobu-select-profile:49
msgid "Error:"
msgstr "Tuccḍa:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " afaylu yella, maca mačči d aseɣwen azamulan"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "Fren amaɣnu n ugdil: "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "TUCCḌA: Afran d arameɣtu"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"Ma tesseqdaceḍ agraw n yinegzumen n unasiw n umezwer, sit ɣef \\n<F5> akken "
"ad tremdeḍ isenfal-a. \\n\\nMa ulac, ffeɣ seg tɣimit-a n ugdil tebduḍ yiwet "
"d tamaynut."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Sker \"byobu\" i urmad"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu ha-t-an ittekker deg tuqqna (sens)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu ha-t-an ur ittekker ara deg tuqqna (rmed)"

#: byobu-config:89
msgid "Help"
msgstr "Tallelt"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "Beddel initen n Byobu"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Qluqel talɣutin n waddad"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Snifel agraw n unegzum n unasiw"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Snifel taluddayt n unsar"

#: byobu-config:94
msgid "Create new windows"
msgstr "Rnu asfaylu amaynut"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Sefrek isfuyla n umezwer"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " Umuɣ n twila n Byobu"

#: byobu-config:110
msgid "Okay"
msgstr "Ih"

