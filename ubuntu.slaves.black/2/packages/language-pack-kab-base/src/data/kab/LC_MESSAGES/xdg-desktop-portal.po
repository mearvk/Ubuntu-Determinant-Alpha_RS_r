#: src/background.c:260
#, c-format
msgid "Allow %s to run in the background?"
msgstr "Sireg %s akken ad ittuselkem deg ugilal?"

#: src/background.c:264
#, c-format
msgid "%s requests to be started automatically and run in the background."
msgstr "%s yesra ad yekker s wudem awurman rnu ad yeddu deg ugilal."

#: src/background.c:266
#, c-format
msgid "%s requests to run in the background."
msgstr "%s yesra ad yettuselkem deg ugilal"

#: src/background.c:267
msgid ""
"The ‘run in background’ permission can be changed at any time from the "
"application settings."
msgstr ""
"Aɛemmed i 'aselkem deg ugilal' yezmer ad ttubeddel melmi tebɣiḍ seg "
"yiɣewwaren n usnas."

#: src/background.c:272
msgid "Don't allow"
msgstr "Ur sirig ara"

#: src/background.c:273 src/wallpaper.c:165
msgid "Allow"
msgstr "Sireg"

#: src/device.c:115
msgid "Turn On Microphone?"
msgstr "Cɛel asawaḍ?"

#: src/device.c:116
msgid ""
"Access to your microphone can be changed at any time from the privacy "
"settings."
msgstr ""
"Abrid ar usawaḍ-inek yezmer ad yettubeddel melmi tebɣiḍ seg yiɣewwaren n "
"tbaḍnit."

#: src/device.c:120
msgid "An application wants to use your microphone."
msgstr "Yella usnas yesran ad iseqdec asawaḍ-inek."

#: src/device.c:122
#, c-format
msgid "%s wants to use your microphone."
msgstr "%s yesra ad iseqdec asawaḍ-inek."

#: src/device.c:128
msgid "Turn On Speakers?"
msgstr "Cɛel isemɣaren n ṣṣut?"

#: src/device.c:129
msgid ""
"Access to your speakers can be changed at any time from the privacy settings."
msgstr ""
"Abrid ɣer yisemɣaren-inek n ṣṣut yezmer ad yettubeddel melmi i tebɣiḍ seg "
"yiɣewwaren n tbaḍnit."

#: src/device.c:133
msgid "An application wants to play sound."
msgstr "Yella usnas yesran taɣuri n yimesli."

#: src/device.c:135
#, c-format
msgid "%s wants to play sound."
msgstr "%s yesra taɣuri n yimesli."

#: src/device.c:141
msgid "Turn On Camera?"
msgstr "Cɛel takamiṛat?"

#: src/device.c:142
msgid ""
"Access to your camera can be changed at any time from the privacy settings."
msgstr ""
"Aɛeddi ɣer tkamiṛat-inek yezmer ad yettubeddel melmi i tebɣiḍ seg yiɣewwaren "
"n tbaḍnit."

#: src/device.c:146
msgid "An application wants to use your camera."
msgstr "Yella usnas i yesran aseqdec n tkamiṛat-inek."

#: src/device.c:148
#, c-format
msgid "%s wants to use your camera."
msgstr "%s yesra aseqdec n tkamiṛat-inek."

#: src/location.c:526
msgid "Deny Access"
msgstr "Seḥbes aɛeddi"

#: src/location.c:528
msgid "Grant Access"
msgstr "Ɛemmed aɛeddi"

#: src/location.c:534
msgid "Grant Access to Your Location?"
msgstr "Ɛemmed i unekcum ɣer wadeg-inek?"

#: src/location.c:535
msgid "An application wants to use your location."
msgstr "Yella usnas yesran aseqdec n wadeg-inek."

#: src/location.c:547
#, c-format
msgid "Give %s Access to Your Location?"
msgstr "Serraḥ i %s ad yekcem ɣer wadeg-inek?"

#: src/location.c:551
#, c-format
msgid "%s wants to use your location."
msgstr "%s yesra aseqdec n wadeg-inek."

#: src/location.c:554
msgid "Location access can be changed at any time from the privacy settings."
msgstr ""
"Anekcum ɣer wadeg yezmer ad yettubeddel melmi tebɣiḍ seg yiɣewwaren n "
"tbaḍnit."

#: src/settings.c:124
msgid "Requested setting not found"
msgstr "Iɣewwaren yettwasutren ulac-iten"

#: src/wallpaper.c:163
msgid "Deny"
msgstr "Nkeṛ"

#: src/wallpaper.c:171
msgid "Allow Applications to Set Backgrounds?"
msgstr "Ɛemmed i yisnasen ad sbadun igilal?"

#: src/wallpaper.c:172
msgid ""
"An application is requesting to be able to change the background image."
msgstr "Yella usnas yesra ad yizmir ad ibeddel tugna n ugilal."

#: src/wallpaper.c:184
#, c-format
msgid "Allow %s to Set Backgrounds?"
msgstr "Sireg %s ad isbadu igilal?"

#: src/wallpaper.c:185
#, c-format
msgid "%s is requesting to be able to change the background image."
msgstr "%s yesra ad yizmir ad ibeddel tugna n ugilal."

#: src/wallpaper.c:188
msgid "This permission can be changed at any time from the privacy settings."
msgstr ""
"Tisiregt tezmer ad tettubeddel melmi i tebɣiḍ seg yiɣewwaren n tbaḍnit."
