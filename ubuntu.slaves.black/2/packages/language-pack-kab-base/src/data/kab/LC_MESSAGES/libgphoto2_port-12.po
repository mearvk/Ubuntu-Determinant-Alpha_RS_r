#, c-format
msgid "Failed to lock '%s' (%m)."
msgstr "Asekkeṛ n '%s' (%m) d awezɣi."

#: usbscsi/linux.c:113
#, c-format
msgid "Failed to unlock '%s' (%m)."
msgstr "Tawaldyawt n  '%s' (%m) d tawezɣit."

