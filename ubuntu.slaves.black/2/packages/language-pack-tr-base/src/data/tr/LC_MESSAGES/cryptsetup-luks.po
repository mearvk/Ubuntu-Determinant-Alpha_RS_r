#: luks/keyencryption.c:61
#, c-format
msgid "Unable to obtain sector size for %s"
msgstr "%s için sektör boyutu alınamadı"

#: luks/keyencryption.c:109
msgid "Failed to obtain device mapper directory."
msgstr "Aygıt eşleyici dizini alınamadı."

#: luks/keymanage.c:79 luks/keymanage.c:120 luks/keymanage.c:390
#, c-format
msgid "Can't open device: %s\n"
msgstr "Aygıt açılamıyor: %s\n"

#: luks/keymanage.c:86
#, c-format
msgid "%s is not a LUKS partition\n"
msgstr "%sbir LUKS bölümü değil\n"

#: luks/keymanage.c:89
msgid "unknown hash spec in phdr"
msgstr "phdr'de bilinmeyen hash belirtimi"

#: luks/keymanage.c:92
#, c-format
msgid "unknown version %d\n"
msgstr "bilinmeyen sürüm: %d\n"

#: luks/keymanage.c:213
#, c-format
msgid "key %d active, purge first.\n"
msgstr "Anahtar %d etkin, önce boşaltın.\n"

#: luks/keymanage.c:218
#, c-format
msgid ""
"key material section %d includes too few stripes. Header manipulation?\n"
msgstr ""
"anahtar malzeme bölümü %d çok az şerit içeriyor. Başlık manipülasyonu mu ?\n"

#: luks/keymanage.c:281
#, c-format
msgid "key %d is disabled.\n"
msgstr "%d tuşu etkisizleştirildi.\n"

#: luks/keymanage.c:427
#, c-format
msgid "Key %d not active. Can't wipe.\n"
msgstr "%d tuşu etkin değil. Silinemiyor.\n"

#: src/cryptsetup.c:56
msgid "<name> <device>"
msgstr "<ad> <aygıt>"

#: src/cryptsetup.c:56
msgid "create device"
msgstr "aygıt oluştur"

#: src/cryptsetup.c:57 src/cryptsetup.c:58 src/cryptsetup.c:59
#: src/cryptsetup.c:60 src/cryptsetup.c:67
msgid "<name>"
msgstr "<ad>"

#: src/cryptsetup.c:57
msgid "remove device"
msgstr "aygıt kaldır"

#: src/cryptsetup.c:58
msgid "modify active device"
msgstr "etkin aygıtı değiştir"

#: src/cryptsetup.c:59
msgid "resize active device"
msgstr "etkin aygıtı yeniden boyutlandır"

#: src/cryptsetup.c:60
msgid "show device status"
msgstr "aygıt durumunu göster"

#: src/cryptsetup.c:61 src/cryptsetup.c:64
msgid "<device> [<new key file>]"
msgstr "<aygıt> [<yeni anahtar dosyası>]"

#: src/cryptsetup.c:61
msgid "formats a LUKS device"
msgstr "Bir LUKS aygıtını biçimlendirir"

#: src/cryptsetup.c:62
msgid "<device> <name> "
msgstr "<aygıt> <ad> "

#: src/cryptsetup.c:62
msgid "open LUKS device as mapping <name>"
msgstr "LUKS cihazını haritalama <isim> olarak aç"

#: src/cryptsetup.c:63
msgid "<device> <key slot>"
msgstr "<aygıt> <anahtar yuvası>"

#: src/cryptsetup.c:63
msgid "wipes key with number <key slot> from LUKS device"
msgstr "LUKS cihazından <key slot> numaralı silme mendilleri"

#: src/cryptsetup.c:64
msgid "add key to LUKS device"
msgstr "LUKS aygıtına anahtar ekle"

#: src/cryptsetup.c:65 src/cryptsetup.c:66 src/cryptsetup.c:68
msgid "<device>"
msgstr "<aygıt>"

#: src/cryptsetup.c:65
msgid "print UUID of LUKS device"
msgstr "LUKS aygıtının UUID'sini yazdır"

#: src/cryptsetup.c:66
msgid "tests <device> for LUKS partition header"
msgstr "LUKS bölüm üstbilgisi için <device> sınamaları"

#: src/cryptsetup.c:67
msgid "remove LUKS mapping"
msgstr "LUKS haritalama kaldır"

#: src/cryptsetup.c:68
msgid "dump LUKS partition information"
msgstr "LUKS bölüm bilgisini dökme"

#: src/cryptsetup.c:77
#, c-format
msgid "Command successful.\n"
msgstr "komut başarılı.\n"

#: src/cryptsetup.c:90
#, c-format
msgid "Command failed"
msgstr "Komut başarısız oldu"

#: src/cryptsetup.c:226
#, c-format
msgid "This will overwrite data on %s irrevocably."
msgstr "Bu,%s üzerindeki verilerin geri alınamaz şekilde üzerine yazacaktır."

#: src/cryptsetup.c:227
msgid "memory allocation error in action_luksFormat"
msgstr "action_luksFormat'ta bellek ayırma hatası"

#: src/cryptsetup.c:269
msgid ""
"This is the last keyslot. Device will become unusable after purging this key."
msgstr ""
"Bu son anahtar yadigarı. Bu anahtarı temizledikten sonra cihaz kullanılamaz "
"hale gelecektir."

#: src/cryptsetup.c:349
#, c-format
msgid ""
"\n"
"<action> is one of:\n"
msgstr ""
"\n"
"<action>biri:\n"

#: src/cryptsetup.c:355
#, c-format
msgid ""
"\n"
"<name> is the device to create under %s\n"
"<device> is the encrypted device\n"
"<key slot> is the LUKS key slot number to modify\n"
"<key file> optional key file for the new key for luksAddKey action\n"
msgstr ""
"\n"
"<name>,%s altında oluşturulacak cihazdır\n"
"<cihaz>, şifrelenmiş cihazdır.\n"
"<anahtar yuvası>, değiştirilecek LUKS anahtar yuvası numaradır\n"
"<anahtar dosyası> luksAddKey eylemi için yeni anahtar için isteğe bağlı "
"anahtar dosyası\n"

#: src/cryptsetup.c:371
msgid "Show this help message"
msgstr "Bu yardım iletisini göster"

#: src/cryptsetup.c:372
msgid "Display brief usage"
msgstr "Kısaca kullanımını gösterir"

#: src/cryptsetup.c:376
msgid "Help options:"
msgstr "Yardım seçenekleri:"

#: src/cryptsetup.c:377
msgid "Shows more detailed error messages"
msgstr "Daha ayrıntılı hata iletileri göster"

#: src/cryptsetup.c:378
msgid "The cipher used to encrypt the disk (see /proc/crypto)"
msgstr "Diski şifrelemek için kullanılan şifre (bkz. /proc/crypto)"

#: src/cryptsetup.c:379
msgid "The hash used to create the encryption key from the passphrase"
msgstr "Karma, paroladan şifreleme anahtarı yaratmak için kullanılır"

#: src/cryptsetup.c:380
msgid "Verifies the passphrase by asking for it twice"
msgstr "Parolayı, iki kez isteyerek doğrula."

#: src/cryptsetup.c:381
msgid "Read the key from a file (can be /dev/random)"
msgstr "Anahtarı bir dosyadan okuyun (/dev/random olabilir)"

#: src/cryptsetup.c:382
msgid "The size of the encryption key"
msgstr "Şifreleme anahtarının boyutu"

#: src/cryptsetup.c:382
msgid "BITS"
msgstr "BITS"

#: src/cryptsetup.c:383
msgid "The size of the device"
msgstr "Aygıtın boyutları"

#: src/cryptsetup.c:383 src/cryptsetup.c:384 src/cryptsetup.c:385
#: src/cryptsetup.c:393
msgid "SECTORS"
msgstr "BÖLÜMLER"

#: src/cryptsetup.c:384
msgid "The start offset in the backend device"
msgstr "Arka plandaki aygıta başlangıç kayması"

#: src/cryptsetup.c:385
msgid "How many sectors of the encrypted data to skip at the beginning"
msgstr "Şifrelenmiş verilerin kaç tane sektör başında atlamak için"

#: src/cryptsetup.c:386
msgid "Create a readonly mapping"
msgstr "Salt okunur bir haritalama oluşturma"

#: src/cryptsetup.c:387
msgid "PBKDF2 iteration time for LUKS (in ms)"
msgstr "PBKDF2 LUKS'ler için iterasyon süresi (ms cinsinden)"

#: src/cryptsetup.c:388
msgid "msecs"
msgstr "milisaniye"

#: src/cryptsetup.c:389
msgid "Do not ask for confirmation"
msgstr "Onaylamak için sorma"

#: src/cryptsetup.c:390
msgid "Print package version"
msgstr "Paket sürümünü yazdır"

#: src/cryptsetup.c:391
msgid "Timeout for interactive passphrase prompt (in seconds)"
msgstr "Etkileşimli şifre deyimi istemi için zamanaşımı (saniye olarak)"

#: src/cryptsetup.c:391
msgid "secs"
msgstr "saniye"

#: src/cryptsetup.c:392
msgid "How often the input of the passphrase can be retried"
msgstr "Parolanın girişi ne sıklıkta tekrar denenebilir"

#: src/cryptsetup.c:393
msgid "Align payload at <n> sector boundaries - for luksFormat"
msgstr "<n> bölüm sınırlarında yükü hizalayın - luksFormat için"

#: src/cryptsetup.c:409
msgid "[OPTION...] <action> <action-specific>]"
msgstr "[OPTION...] <action> <action-specific>]"

#: src/cryptsetup.c:445
msgid "Key size must be a multiple of 8 bits"
msgstr "Anahtar boyutu, 8 bitlik katlar arasında olmalıdır."

#: src/cryptsetup.c:449
msgid "Argument <action> missing."
msgstr "Argüman <action> eksik."

#: src/cryptsetup.c:455
msgid "Unknown action."
msgstr "Bilinmeyen eylem."

#: src/cryptsetup.c:470
#, c-format
msgid "%s: requires %s as arguments"
msgstr "%s: %s argüman olarak gerekli"
