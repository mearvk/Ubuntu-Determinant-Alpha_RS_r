msgid ""
"Folder '%s' only contains %i files, but you requested a file with number %i."
msgstr ""
"Klasör '%s' yalnızca %i dosyaları içeriyor, ancak %i numaralı bir dosya "
"istediniz."

#: libgphoto2/gphoto2-filesys.c:1395
#, c-format
msgid "File '%s' could not be found in folder '%s'."
msgstr "'%s' klasöründe '%s' dosyası bulunmuyor."

#: libgphoto2/gphoto2-filesys.c:1512
#, c-format
msgid "Could not find file '%s'."
msgstr "'%s' dosyası bulunamadı."

#: libgphoto2/gphoto2-filesys.c:1536
msgid "The filesystem doesn't support getting files"
msgstr "Dosya sistemi dosya alma özelliğini desteklemez"

#: libgphoto2/gphoto2-filesys.c:1570 libgphoto2/gphoto2-filesys.c:2101
#: libgphoto2/gphoto2-filesys.c:2257
#, c-format
msgid "Unknown file type %i."
msgstr "Bilinmeyen dosya türü %i."

#: libgphoto2/gphoto2-filesys.c:1861
msgid "The filesystem doesn't support getting file information"
msgstr "Dosya sistemi dosya bilgisi almayı desteklemiyor"

#: libgphoto2/gphoto2-filesys.c:2397
msgid "The filesystem doesn't support setting file information"
msgstr "Dosya sistemi, dosya bilgilerini ayarlamayı desteklemez"

#: libgphoto2/gphoto2-filesys.c:2419
msgid "Read-only file attributes like width and height can not be changed."
msgstr ""
"Genişlik ve yükseklik gibi salt okunur dosya öznitelikleri değiştirilemez."

#: libgphoto2/gphoto2-filesys.c:2476
msgid "The filesystem doesn't support getting storage information"
msgstr "Dosya sistemi, depolama bilgisi alımı desteklemez"

