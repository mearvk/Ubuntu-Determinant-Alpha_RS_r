#: gl/lib/argp-help.c:158
#, c-format
msgid "ARGP_HELP_FMT: %s value is less than or equal to %s"
msgstr "ARGP_HELP_FMT: %s değeri %s değerinden küçük veya eşit"

#: gl/lib/argp-help.c:234
#, c-format
msgid "%.*s: ARGP_HELP_FMT parameter requires a value"
msgstr "%.*s: ARGP_HELP_FMT parametresi bir değer gerektirir"

#: gl/lib/argp-help.c:244
#, c-format
msgid "%.*s: Unknown ARGP_HELP_FMT parameter"
msgstr "%.*s: Bilinmeyen  ARGP_HELP_FMT parametresi"

#: gl/lib/argp-help.c:257
#, c-format
msgid "Garbage in ARGP_HELP_FMT: %s"
msgstr "ARGP_HELP_FMT içinde bozulma saptandı: %s"

#: gl/lib/argp-help.c:1238
msgid ""
"Mandatory or optional arguments to long options are also mandatory or "
"optional for any corresponding short options."
msgstr ""
"Uzun seçeneklerdeki argümanlar zorunlu olsun olmasın kısa seçeneklerde de "
"geçerlidir."

#: gl/lib/argp-help.c:1627
msgid "Usage:"
msgstr "Kullanım:"

#: gl/lib/argp-help.c:1631
msgid "  or: "
msgstr "  veya: "

#: gl/lib/argp-help.c:1643
msgid " [OPTION...]"
msgstr " [SEÇENEK...]"

#: gl/lib/argp-help.c:1670
#, c-format
msgid "Try '%s --help' or '%s --usage' for more information.\n"
msgstr "Daha fazla bilgi için '%s --help' veya '%s --usage' deneyin.\n"

#: gl/lib/argp-help.c:1698
#, c-format
msgid "Report bugs to %s.\n"
msgstr "Yazılım hatalarını <%s> adresine  bildiriniz.\n"

#: gl/lib/argp-help.c:1898 gl/lib/error.c:195
msgid "Unknown system error"
msgstr "Bilinmeyen sistem hatası"

#: gl/lib/argp-parse.c:91
msgid "give this help list"
msgstr "bu yardım listesini ver"

#: gl/lib/argp-parse.c:92
msgid "give a short usage message"
msgstr "kısa kullanım mesajı ver"

#: gl/lib/argp-parse.c:93
msgid "NAME"
msgstr "İSİM"

#: gl/lib/argp-parse.c:94
msgid "set the program name"
msgstr "program adını ayarla"

#: gl/lib/argp-parse.c:95
msgid "SECS"
msgstr "SN"

#: gl/lib/argp-parse.c:96
msgid "hang for SECS seconds (default 3600)"
msgstr "SANİYE saniye bekler (öntanımlı 3600)"

#: gl/lib/argp-parse.c:154
msgid "print program version"
msgstr "programın sürümünü yazdır"

#: gl/lib/argp-parse.c:171
msgid "(PROGRAM ERROR) No version known!?"
msgstr "(PROGRAM HATASI) Sürüm bilinmiyor!?"

#: gl/lib/argp-parse.c:624
#, c-format
msgid "%s: Too many arguments\n"
msgstr "%s: Çok fazla argüman\n"

#: gl/lib/argp-parse.c:770
msgid "(PROGRAM ERROR) Option should have been recognized!?"
msgstr "(PROGRAM HATASI) Seçenek tanınmalı mı!?"

#: gl/lib/getopt.c:278
#, c-format
msgid "%s: option '%s%s' is ambiguous\n"
msgstr "%s: '%s%s' seçeneği belirsiz\n"

#: gl/lib/getopt.c:284
#, c-format
msgid "%s: option '%s%s' is ambiguous; possibilities:"
msgstr "%s: '%s%s' seçeneği belirsiz; olasılıklar:"

#: gl/lib/getopt.c:319
#, c-format
msgid "%s: unrecognized option '%s%s'\n"
msgstr "%s: '%s%s' seçeneği bilinmiyor\n"

#: gl/lib/getopt.c:345
#, c-format
msgid "%s: option '%s%s' doesn't allow an argument\n"
msgstr "%s: '%s%s' seçeneği bağımsız değişkene izin vermiyor\n"

#: gl/lib/getopt.c:360
#, c-format
msgid "%s: option '%s%s' requires an argument\n"
msgstr "%s: '%s%s' seçeneği bağımsız bir değişken gerektiriyor\n"

#: gl/lib/getopt.c:621
#, c-format
msgid "%s: invalid option -- '%c'\n"
msgstr "%s: geçersiz seçenek -- '%c'\n"

#: gl/lib/getopt.c:636 gl/lib/getopt.c:682
#, c-format
msgid "%s: option requires an argument -- '%c'\n"
msgstr "%s:  -- '%c' seçeneği bir argüman gerektiriyor\n"

#: gl/lib/openat-die.c:38
#, c-format
msgid "unable to record current working directory"
msgstr "Geçerli çalışan dizin kaydedilemiyor"

#: gl/lib/openat-die.c:57
#, c-format
msgid "failed to return to initial working directory"
msgstr "başlangıç çalışma dizinine geri dönülemedi"

#: gl/lib/regcomp.c:135
msgid "Success"
msgstr "Başarılı"

#: gl/lib/regcomp.c:138
msgid "No match"
msgstr "Eşleşme yok"

#: gl/lib/regcomp.c:141
msgid "Invalid regular expression"
msgstr "Geçersiz düzenli ifade"

#: gl/lib/regcomp.c:144
msgid "Invalid collation character"
msgstr "Geçersiz karşılaştırma karakteri"

#: gl/lib/regcomp.c:147
msgid "Invalid character class name"
msgstr "Geçersiz karakter sınıfı adı"

#: gl/lib/regcomp.c:150
msgid "Trailing backslash"
msgstr "İzleyen tersbölü"

#: gl/lib/regcomp.c:153
msgid "Invalid back reference"
msgstr "Geçersiz geri başvurusu"

#: gl/lib/regcomp.c:156
msgid "Unmatched [, [^, [:, [., or [="
msgstr "[, [^, [:, [., or [= eşleşmiyor"

#: gl/lib/regcomp.c:159
msgid "Unmatched ( or \\("
msgstr "( ya da \\( eşleşmiyor"

#: gl/lib/regcomp.c:162
msgid "Unmatched \\{"
msgstr "\\{ eşleşmiyor"

#: gl/lib/regcomp.c:165
msgid "Invalid content of \\{\\}"
msgstr "\\{\\} içeriği geçersiz"

#: gl/lib/regcomp.c:168
msgid "Invalid range end"
msgstr "Geçersiz aralık sonu"

#: gl/lib/regcomp.c:171
msgid "Memory exhausted"
msgstr "Bellek tükendi"

#: gl/lib/regcomp.c:174
msgid "Invalid preceding regular expression"
msgstr "Önceleme düzenli ifadesi geçersiz"

#: gl/lib/regcomp.c:177
msgid "Premature end of regular expression"
msgstr "Düzenli ifadenin sonu eksik"

#: gl/lib/regcomp.c:180
msgid "Regular expression too big"
msgstr "Düzenli ifade çok büyük"

#: gl/lib/regcomp.c:183
msgid "Unmatched ) or \\)"
msgstr ") ya da  \\) eşleşmiyor"

#: gl/lib/regcomp.c:676
msgid "No previous regular expression"
msgstr "Öncesinde düzenli ifade yok"

#: gl/lib/xalloc-die.c:34
msgid "memory exhausted"
msgstr "bellek tükendi"

#: gl/lib/xstdopen.c:34
#, c-format
msgid "standard file descriptors"
msgstr "standart dosya tanımlayıcıları"
