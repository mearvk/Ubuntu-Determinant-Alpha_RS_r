#: src/com.canonical.UbuntuAdvantage.policy.in:10
msgid "Attach machine to Ubuntu Pro"
msgstr "Cihazı Ubuntu Pro'ya ekle"

#: src/com.canonical.UbuntuAdvantage.policy.in:11
msgid "Authentication is required to attach this machine to Ubuntu Pro"
msgstr "Bu cihazı Ubuntu Pro'ya eklemek için kimlik doğrulama gerekli"

#: src/com.canonical.UbuntuAdvantage.policy.in:20
msgid "Detach machine from Ubuntu Pro"
msgstr "Cihazı Ubuntu Pro'dan çıkar"

#: src/com.canonical.UbuntuAdvantage.policy.in:21
msgid "Authentication is required to detach this machine from Ubuntu Pro"
msgstr "Bu cihazı Ubuntu Pro'dan çıkarmak için kimlik doğrulama gerekli"

#: src/com.canonical.UbuntuAdvantage.policy.in:30
msgid "Enable Ubuntu Pro service"
msgstr "Ubuntu Pro servisini aktifleştir"

#: src/com.canonical.UbuntuAdvantage.policy.in:31
msgid "Authentication is required to enable an Ubuntu Pro service"
msgstr ""
"Bir Ubuntu Pro servisini aktifleştirmek için kimlik doğrulama gerekli"

#: src/com.canonical.UbuntuAdvantage.policy.in:40
msgid "Disable Ubuntu Pro service"
msgstr "Ubuntu Pro servisini devre dışı bırak"

#: src/com.canonical.UbuntuAdvantage.policy.in:41
msgid "Authentication is required to disable an Ubuntu Pro service"
msgstr ""
"Bir Ubuntu Pro servisini devre dışı bırakmak için kimlik doğrulama gerekli"

#: src/main.c:21
msgid "Replace current daemon"
msgstr "Geçerli arka plan programını değiştir"

#: src/main.c:23
msgid "Path to status file"
msgstr "Durum dosyasına giden yol"

#: src/main.c:25
msgid "Show daemon version"
msgstr "Arka plan programının sürümünü göster"
