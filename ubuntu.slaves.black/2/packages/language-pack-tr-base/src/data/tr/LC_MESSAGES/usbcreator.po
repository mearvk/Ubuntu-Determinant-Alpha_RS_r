#, python-format
msgid "%d%% complete"
msgstr "%%%d tamamlandı"

#: .././usbcreator/install.py:92
#, python-format
msgid "The extension \"%s\" is not supported."
msgstr "\"%s\" uzantısı desteklenmiyor."

