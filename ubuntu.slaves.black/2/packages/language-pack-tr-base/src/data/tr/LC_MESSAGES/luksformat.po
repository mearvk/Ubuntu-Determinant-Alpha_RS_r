#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Bu programı yönetici olarak başlatmalısınız\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Şifrelenmiş bir LUKS aygıtı oluştur ve biçimlendir\n"
"Kullanım: luksformat [-t <dosya sistemi>] <aygıt> [ mkfs seçenekleri ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Hata: Cihaz takılı: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Hata: geçersiz dosya sistemi: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Hata: Geçici eşlenen sürücü ismi yaratılamadı"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "%s üzerinde şifreli cihaz oluşturuluyor...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "%s LUKS aygıtı oluşturulamadı"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Lütfen doğrulamak için parolanızı tekrar giriniz\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Girmiş olduğunuz parolalar aynı değil\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "%s dosya sisteminde aygıt biçimlendirilemedi"
