msgstr "  -P, -p ile aynı\n"

#: src/unify.c:291
msgid "  -s, --strip-comments   strip comment lines\n"
msgstr "  -s, --strip-comments   yorum satırlarını ayır\n"

#: src/unify.c:292
msgid "  -u, --unidiffs         force output to unidiffs\n"
msgstr ""

#: src/unify.c:293
