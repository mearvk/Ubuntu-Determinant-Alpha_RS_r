#: src/wdiff2.c:177
msgid ""
"wdiff - Compute word differences by internally launching `mdiff -W'.\n"
"This program exists mainly to support the now oldish `wdiff' syntax.\n"
msgstr ""
"wdiff - `mdiff -W' yi içten başlatarak kelime farklılıklarını hesapla.\n"
"Bu program temel olarak eski `wdiff' sözdizimini desteklemek için var.\n"

#: src/wdiff2.c:182
#, c-format
msgid "Usage: %s [OPTION]... FILE1 FILE2\n"
msgstr "Kullanım: %s [SEÇENEK]... DOSYA1 DOSYA2\n"

#: src/wdiff2.c:199
msgid "  -q, --quiet                inhibit the `mdiff' call message\n"
msgstr ""

#: src/wdiff2.c:208
msgid ""
"This program also tells how `mdiff' could have been called directly.\n"
msgstr "Bu program ayrıca `mdiff' in nasıl direk çağrılabildiğini anlatır.\n"

#. TRANSLATORS: This and the next string are one message.
#: src/wdiff2.c:332
#, c-format
msgid "Launching `%s"
msgstr "`%s başlatılıyor"

#: src/wdiff2.c:335
#, c-format
msgid "'\n"
msgstr "'\n"
