msgstr ""

#: src/unify.c:287
msgid "  -e, --echo-comments    echo comments to standard error\n"
msgstr ""

#: src/unify.c:288
msgid "  -o, --old-diffs        output old-style diffs, no matter what\n"
msgstr ""

#: src/unify.c:289
msgid "  -p, --patch-format     generate patch format\n"
msgstr ""

#: src/unify.c:290
