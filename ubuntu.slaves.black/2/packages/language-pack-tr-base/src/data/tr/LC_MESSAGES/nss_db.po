#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "Anahtarı küçük harfe dönüştür"

#: src/makedb.c:69
msgid "NAME"
msgstr "AD"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "Çıktıyı AD dosyasına yaz"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "Veritabanını oluştururken ileti verme"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr ""
"Veritabanı dosyasının içeriğini, her satıra bir girdi gelecek şekilde yazdır"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "Metinsel girdilerden basit DB veritabanı oluşturun."

#. Strings for arguments in help texts.
#: src/makedb.c:81
msgid ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"
msgstr ""
"GİRDİ-DOSYASI ÇIKTI-DOSYASI\n"
"-o ÇIKTI-DOSYASI GİRDİ-DOSYASI\n"
"-u GİRDİ-DOSYASI"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "yanlış argüman sayısı"

#: src/makedb.c:154
#, c-format
msgid "cannot open database file `%s': %s"
msgstr "'%s' veritabanı dosyası açılamıyor: %s"

#: src/makedb.c:173
#, c-format
msgid "cannot open input file `%s'"
msgstr "`%s' girdi dosyası açılamıyor"

#: src/makedb.c:187
#, c-format
