#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "İç hata: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Bu harita %(1)s -> %(2)s'lik kısımı kapsamaktadır."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Bu metodun %(1)s'lik kısmı desteklenmemektedir."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr ""
"Bu metod %(1)s kısmı alıp %(2)s argüman(lar)ın  (%(3)s kısmını içerir)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "İzin verilmedi."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"%(1)s için olan \"%(2)s\" değeri bu sunucu tarafından desteklenmemektedir. "
"Sunucu \"%(3)s\" diye belirtiyor."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "%(1)s'lik kısmın %(2)s kısmı geçersizdir."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "İzin verilmeyen bir işlem yapmaya kalktınız."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Belirtmiş olduğunuz ağda şu an bir PIF eklentisi bulunmaktadır ve başka bir "
"eklenti eklenemez."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
