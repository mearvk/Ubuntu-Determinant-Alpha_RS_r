#: swift/auth/server.py:152
#, python-format
msgid ""
"\n"
"THERE ARE ACCOUNTS IN YOUR auth.db THAT DO NOT BEGIN WITH YOUR NEW RESELLER\n"
"PREFIX OF \"%(reseller)s\".\n"
"YOU HAVE A FEW OPTIONS:\n"
"    1. RUN \"swift-auth-update-reseller-prefixes %(db_file)s "
"%(reseller)s\",\n"
"       \"swift-init auth-server restart\", AND\n"
"       \"swift-auth-recreate-accounts -K ...\" TO CREATE FRESH ACCOUNTS.\n"
"    OR\n"
"    2. REMOVE %(db_file)s, RUN \"swift-init auth-server restart\", AND RUN\n"
"       \"swift-auth-add-user ...\" TO CREATE BRAND NEW ACCOUNTS THAT WAY.\n"
"    OR\n"
"    3. ADD \"reseller_prefix = %(previous)s\" (WITHOUT THE QUOTES) TO YOUR\n"
"       proxy-server.conf IN THE [filter:auth] SECTION AND TO YOUR\n"
"       auth-server.conf IN THE [app:auth-server] SECTION AND RUN\n"
"       \"swift-init proxy-server restart\" AND \"swift-init auth-server "
"restart\"\n"
"       TO REVERT BACK TO YOUR PREVIOUS RESELLER PREFIX.\n"
"\n"
"    %(note)s\n"
"                    "
msgstr ""
"\n"
"CI SONO ACCOUNT NEL TUO auth.db CHE NON INIZIANO CON IL TUO NUOVO "
"RIVENDITORE\n"
"PREFISSO DI \"%(reseller)s\".\n"
"HAI POCHE OPZIONI:\n"
"    1. ESEGUI \"swift-auth-update-reseller-prefixes %(db_file)s "
"%(reseller)s\",\n"
"       \"riavvio rapido del server di autenticazione\", AND\n"
"       \"swift-auth-recreate-accounts -K ...\" PER CREARE ACCOUNT NUOVI.\n"
"    O\n"
"    2. RIMUOVI %(db_file)s, ESEGUI \"swift-init auth-server restart\" E "
"ESEGUI\n"
"       \"swift-auth-add-user ...\" PER CREARE ACCOUNT NUOVISSIMI IN QUESTO "
"MODO.\n"
"    O\n"
"    3. AGGIUNGI \"reseller_prefix = %(previous)s\" (SENZA LE CITAZIONI) AL "
"TUO\n"
"       proxy-server.conf NELLA SEZIONE [filter:auth] E AL TUO\n"
"       auth-server.conf NELLA SEZIONE [app:auth-server] ED ESEGUI\n"
"       \"riavvio del server proxy swift-init\" E \"riavvio del server auth-"
"init rapido\"\n"
"       PER TORNARE AL PRECEDENTE PREFISSO DEL RIVENDITORE.\n"
"\n"
"    %(note)s\n"
"                    "

#: swift/auth/server.py:173
msgid ""
"\n"
"    SINCE YOUR PREVIOUS RESELLER PREFIX WAS AN EMPTY STRING, IT IS NOT\n"
"    RECOMMENDED TO PERFORM OPTION 3 AS THAT WOULD MAKE SUPPORTING MULTIPLE\n"
"    RESELLERS MORE DIFFICULT.\n"
"                    "
msgstr ""
"\n"
"    POICHÉ IL PRECEDENTE PREFISSO DEL RIVENDITORE ERA UNA STRINGA VUOTA, NON "
"LO È\n"
"    SI CONSIGLIA DI ESEGUIRE L'OPZIONE 3 IN QUANTO QUESTO EFFETTUEBBE "
"MOLTEPLICI SUPPORTI\n"
"    RIVENDITORI PIU' DIFFICILI.\n"
"                    "

