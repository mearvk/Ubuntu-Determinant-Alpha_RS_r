msgid ""
"Option --veracrypt-pim is supported only for VeraCrypt compatible devices."
msgstr ""
"L'opzione --veracrypt-pim è supportata solo per i dispositivi compatibili "
"con VeraCrypt."

#: src/cryptsetup.c:2993
msgid ""
"Option --veracrypt-query-pim is supported only for VeraCrypt compatible "
"devices."
msgstr ""
"L'opzione --veracrypt-query-pim è supportata solo per i dispositivi "
"compatibili con VeraCrypt."

