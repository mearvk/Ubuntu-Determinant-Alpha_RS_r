#: p11-kit/rpc-server.c:1939
msgid "out of memory responding with error"
msgstr "fuori memoria che risponde con errore"

#: p11-kit/rpc-server.c:1985
#, c-format
msgid "unsupported version received: %d"
msgstr "versione non supportata ricevuta: %d"

