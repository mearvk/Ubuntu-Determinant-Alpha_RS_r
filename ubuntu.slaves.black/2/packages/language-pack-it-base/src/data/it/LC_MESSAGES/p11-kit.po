msgid "couldn't read credential byte"
msgstr "Non ho potuto leggere il byte credenziale"

#: p11-kit/rpc-server.c:2003
msgid "couldn't write credential byte"
msgstr "Impossibile scrivere byte credenziale"

#: p11-kit/rpc-server.c:2026
msgid "failed to read rpc message"
msgstr "Impossibile leggere il messaggio RPC"

#: p11-kit/rpc-server.c:2031
msgid "unexpected error handling rpc message"
msgstr "Errore imprevisto che gestisce il messaggio RPC"

#: p11-kit/rpc-server.c:2049
msgid "failed to write rpc message"
msgstr "Impossibile scrivere il messaggio RPC"

#: p11-kit/rpc-transport.c:208
msgid "couldn't send data: closed connection"
msgstr "Impossibile inviare dati: connessione chiusa"

#: p11-kit/rpc-transport.c:211
msgid "couldn't send data"
msgstr "Impossibile inviare dati"

#: p11-kit/rpc-transport.c:234
msgid "couldn't receive data: closed connection"
msgstr "Impossibile ricevere dati: connessione chiusa"

#: p11-kit/rpc-transport.c:238
msgid "couldn't receive data"
msgstr "non poteva ricevere dati"

#: p11-kit/rpc-transport.c:648
msgid "couldn't send socket credentials"
msgstr "Impossibile inviare credenziali di socket"

#: p11-kit/rpc-transport.c:416
