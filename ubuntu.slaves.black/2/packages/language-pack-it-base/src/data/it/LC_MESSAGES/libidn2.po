#: lib/error.c:54
msgid "success"
msgstr "azione riuscita"

#: lib/error.c:56
msgid "out of memory"
msgstr "memoria esaurita"

#: lib/error.c:58
msgid "could not determine locale encoding format"
msgstr "non è stato possibile determinare il formato di codifica locale"

#: lib/error.c:60
msgid "could not convert string to UTF-8"
msgstr "impossibile convertire la stringa in UTF-8"

#: lib/error.c:62
msgid "string encoding error"
msgstr "errore di codifica delle stringhe"

#: lib/error.c:64
msgid "string could not be NFC normalized"
msgstr "non è stato possibile normalizzare la stringa NFC"

#: lib/error.c:66
msgid "string contains invalid punycode data"
msgstr "string contiene dati punycode non validi"

#: lib/error.c:68
msgid "punycode encoded data will be too large"
msgstr "i dati codificati punycode saranno troppo grandi"

#: lib/error.c:70
msgid "punycode conversion resulted in overflow"
msgstr "la conversione di punycode ha provocato un overflow"

#: lib/error.c:72
msgid "domain name longer than 255 characters"
msgstr "nome di dominio più lungo di 255 caratteri"

#: lib/error.c:74
msgid "domain label longer than 63 characters"
msgstr "etichetta di dominio più lunga di 63 caratteri"

#: lib/error.c:76
msgid "input A-label is not valid"
msgstr "l'etichetta A di input non è valida"

#: lib/error.c:78
msgid "input A-label and U-label does not match"
msgstr "l'etichetta A e l'etichetta U di input non corrispondono"

#: lib/error.c:80
msgid "string is not in Unicode NFC format"
msgstr "la stringa non è in formato NFC Unicode"

#: lib/error.c:82
msgid "string contains forbidden two hyphens pattern"
msgstr "string contiene due trattini proibiti"

#: lib/error.c:84
msgid "string start/ends with forbidden hyphen"
msgstr "inizio/fine stringa con trattino proibito"

#: lib/error.c:86
msgid "string contains a forbidden leading combining character"
msgstr "string contiene un carattere di combinazione iniziale vietato"

#: lib/error.c:88
msgid "string contains a disallowed character"
msgstr "string contiene un carattere non consentito"

#: lib/error.c:90
msgid "string contains a forbidden context-j character"
msgstr "string contiene un carattere di contesto-j proibito"

#: lib/error.c:92
msgid "string contains a context-j character with null rule"
msgstr "string contiene un carattere context-j con regola nulla"

#: lib/error.c:94
msgid "string contains a forbidden context-o character"
msgstr "string contiene un carattere di contesto-o proibito"

#: lib/error.c:96
msgid "string contains a context-o character with null rule"
msgstr "string contiene un carattere di contesto-o con regola nulla"

#: lib/error.c:98
msgid "string contains unassigned code point"
msgstr "la stringa contiene un punto di codice non assegnato"

#: lib/error.c:100
msgid "string has forbidden bi-directional properties"
msgstr "stringa ha proprietà bidirezionali proibite"

#: lib/error.c:102
msgid "domain label has forbidden dot (TR46)"
msgstr "l'etichetta del dominio ha un punto proibito (TR46)"

#: lib/error.c:105
msgid "domain label has character forbidden in transitional mode (TR46)"
msgstr ""
"l'etichetta del dominio ha un carattere vietato in modalità di transizione "
"(TR46)"

#: lib/error.c:109
msgid "domain label has character forbidden in non-transitional mode (TR46)"
msgstr ""
"l'etichetta del dominio ha un carattere vietato in modalità non transitoria "
"(TR46)"

#: lib/error.c:111
msgid "A-label roundtrip failed"
msgstr "Andata e ritorno con etichetta A non riuscita"

#: lib/error.c:113
msgid "Unknown error"
msgstr "Errore sconosciuto"

#: src/idn2.c:57
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Usare \"%s --help\" per maggiori informazioni.\n"

#: src/idn2.c:61
#, c-format
msgid "Usage: %s [OPTION]... [STRINGS]...\n"
msgstr "Uso: %s [OPZIONI]... [STRINGHE]...\n"

#: src/idn2.c:64
msgid ""
"Internationalized Domain Name (IDNA2008) convert STRINGS, or standard "
"input.\n"
"\n"
msgstr ""
"Nome di dominio internazionalizzato (IDNA2008) converte STRINGS o input "
"standard.\n"
"\n"

#: src/idn2.c:68
msgid ""
"Command line interface to the Libidn2 implementation of IDNA2008.\n"
"\n"
"All strings are expected to be encoded in the locale charset.\n"
"\n"
"To process a string that starts with `-', for example `-foo', use `--'\n"
"to signal the end of parameters, as in `idn2 --quiet -- -foo'.\n"
"\n"
"Mandatory arguments to long options are mandatory for short options too.\n"
msgstr ""
"Interfaccia a riga di comando per l'implementazione Libidn2 di IDNA2008.\n"
"\n"
"Tutte le stringhe dovrebbero essere codificate nel set di caratteri della "
"locale.\n"
"\n"
"Per elaborare una stringa che inizia con `-', ad esempio `-pippo', usa `--'\n"
"per segnalare la fine dei parametri, come in `idn2 --quiet -- -foo'.\n"

#: src/idn2.c:78
msgid ""
"  -h, --help                Print help and exit\n"
"  -V, --version             Print version and exit\n"
msgstr ""
"  -h, --help Stampa la guida ed esci\n"
"  -V, --version Stampa la versione ed esci\n"

#: src/idn2.c:82
msgid ""
"  -d, --decode              Decode (punycode) domain name\n"
"  -l, --lookup              Lookup domain name (default)\n"
"  -r, --register            Register label\n"
msgstr ""
"  -d, --decode Decodifica il nome di dominio (punycode).\n"
"  -l, --lookup Cerca nome dominio (predefinito)\n"
"  -r, --register Etichetta del registro\n"

#: src/idn2.c:87
msgid ""
"  -T, --tr46t               Enable TR46 transitional processing\n"
"  -N, --tr46nt              Enable TR46 non-transitional processing\n"
"      --no-tr46             Disable TR46 processing\n"
msgstr ""
"  -T, --tr46t Abilita l'elaborazione di transizione TR46\n"
"  -N, --tr46nt Abilita l'elaborazione non transitoria TR46\n"
"      --no-tr46 Disabilita l'elaborazione TR46\n"

#: src/idn2.c:92
msgid ""
"      --usestd3asciirules   Enable STD3 ASCII rules\n"
"      --no-alabelroundtrip  Disable A-label roundtrip for lookups\n"
"      --debug               Print debugging information\n"
"      --quiet               Silent operation\n"
msgstr ""
"      --usestd3asciirules Abilita le regole ASCII STD3\n"
"      --no-alabelroundtrip Disabilita il roundtrip dell'etichetta A per le "
"ricerche\n"
"      --debug Stampa le informazioni di debug\n"
"      --silenzioso Funzionamento silenzioso\n"

#: src/idn2.c:207
#, c-format
msgid "Charset: %s\n"
msgstr "Set di caratteri: %s\n"

#: src/idn2.c:217
msgid ""
"Type each input string on a line by itself, terminated by a newline "
"character.\n"
msgstr ""
"Scrivere ogni stringa di input in una riga a sé, terminata da un carattere "
"di newline.\n"

#: src/idn2.c:248
msgid "input error"
msgstr "errore di input"
