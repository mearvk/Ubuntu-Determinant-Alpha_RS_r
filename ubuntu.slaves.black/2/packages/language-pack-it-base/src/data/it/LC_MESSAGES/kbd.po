#: src/dumpkeys.c:57
#, c-format
msgid ""
"Available shapes:\n"
"  2  - default output;\n"
"  4  - one line for each keycode;\n"
"  8  - one line for each (modifier,keycode) pair;\n"
"  16 - one line for each keycode until 1st hole.\n"
msgstr ""
"Forme disponibili:\n"
"  2 - output predefinito;\n"
"  4 - una riga per ogni codice di comando;\n"
"  8 - una riga per ogni coppia (modificatore,codice);\n"
"  16 - una riga per ogni codice fino al 1° foro.\n"

#: src/dumpkeys.c:108
msgid "display information about keyboard driver."
msgstr "visualizzare le informazioni sul driver della tastiera."

#: src/dumpkeys.c:109
msgid "display above and symbols known to loadkeys."
msgstr "e i simboli noti per i tasti di caricamento."

#: src/dumpkeys.c:110
msgid "display keytable in hexadecimal notation."
msgstr "visualizza la tabella delle chiavi in notazione esadecimale."

#: src/dumpkeys.c:111
msgid "don't use short-hand notations, one row per keycode."
msgstr "non usare notazioni abbreviate, una riga per ogni codice."

#: src/dumpkeys.c:112
msgid "one line per (modifier,keycode) pair."
msgstr "una riga per ogni coppia (modificatore, codice chiave)."

#: src/dumpkeys.c:114
msgid "display only the function key strings."
msgstr "visualizzare solo le stringhe dei tasti funzione."

#: src/dumpkeys.c:115
msgid "display only key bindings."
msgstr "visualizzare solo i collegamenti dei tasti."

#: src/dumpkeys.c:116
msgid "display only compose key combinations."
msgstr "visualizzare solo le combinazioni di tasti di composizione."

#: src/dumpkeys.c:117
msgid ""
"interpret character action codes to be from the specified character set."
msgstr ""
"interpreta i codici di azione dei caratteri come appartenenti all'insieme di "
"caratteri specificato."

