#: src/rrd_tool.c:49
#, c-format
msgid ""
"RRDtool %s  Copyright by Tobias Oetiker <tobi@oetiker.ch>\n"
"               Compiled %s %s\n"
"\n"
"Usage: rrdtool [options] command command_options\n"
msgstr ""
"RRDtool %s  Copyright by Tobias Oetiker <tobi@oetiker.ch>\n"
"               Compilato %s %s\n"
"\n"
"Uso: rrdtool [opzioni] comando opzioni_comando\n"

#: src/rrd_tool.c:56
msgid ""
"Valid commands: create, update, updatev, graph, graphv,  dump, restore,\n"
"\t\tlast, lastupdate, first, info, list, fetch, tune,\n"
"\t\tresize, xport, flushcached\n"
msgstr ""
"Comandi validi: create, update, updatev, graph, graphv, dump, restore,\n"
"\t\tlast, lastupdate, first, info, list, fetch, tune,\n"
"\t\tridimensiona, xport, svuota la cache\n"

#: src/rrd_tool.c:61
msgid "Valid remote commands: quit, ls, cd, mkdir, pwd\n"
msgstr "Comandi remoti validi: quit, ls, cd, mkdir, pwd\n"

#: src/rrd_tool.c:65
msgid ""
"* create - create a new RRD\n"
"\n"
"\trrdtool create filename [--start|-b start time]\n"
"\t\t[--step|-s step]\n"
"\t\t[--template|-t template-file]\n"
"\t\t[--source|-r source-file]\n"
"\t\t[--no-overwrite|-O]\n"
"\t\t[--daemon|-d address]\n"
"\t\t[DS:ds-name:DST:dst arguments]\n"
"\t\t[RRA:CF:cf arguments]\n"
msgstr ""
"* crea - crea un nuovo RRD\n"
"\n"
"\trrdtool crea nome file [--start|-b ora di inizio]\n"
"\t\t[--step|-s step]\n"
"\t\t[--template|-t file-modello]\n"
"\t\t[--source|-r file-sorgente]\n"
"\t\t[--nessuna sovrascrittura|-O]\n"
"\t\t[--daemon|-d indirizzo]\n"
"[scheda][scheda][DS:ds-name:DST:argomenti dst]\n"
"[scheda][scheda][RRA:CF:cf argomenti]\n"

#: src/rrd_tool.c:76
msgid ""
"* dump - dump an RRD to XML\n"
"\n"
"\trrdtool dump [--header|-h {none,xsd,dtd}]\n"
"\t\t[--no-header|-n]\n"
"\t\t[--daemon|-d address]\n"
"\t\tfile.rrd [file.xml]"
msgstr ""
"* dump - esegue il dump di un RRD in XML\n"
"\n"
"\trrdtool dump [--header|-h {none,xsd,dtd}]\n"
"\t\t[--nessuna intestazione|-n]\n"
"\t\t[--daemon|-d indirizzo]\n"
"[scheda][scheda]file.rrd [file.xml]"

#: src/rrd_tool.c:83
msgid ""
"* info - returns the configuration and status of the RRD\n"
"\n"
"\trrdtool info [--daemon|-d <addr> [--noflush|-F]] filename.rrd\n"
msgstr ""
"* info - restituisce la configurazione e lo stato dell'RRD\n"
"\n"
"\trrdtool info [--daemon|-d <addr> [--noflush|-F]] nomefile.rrd\n"

#: src/rrd_tool.c:87
msgid ""
"* list - returns the list of RRDs\n"
"\n"
"\trrdtool list [--daemon <address>] [--noflush] <dirname>\n"
msgstr ""
"* list - restituisce l'elenco degli RRD\n"
"\n"
"\tlista rrdtool [--daemon <indirizzo>] [--noflush] <dirname>\n"

#: src/rrd_tool.c:91
msgid ""
"* restore - restore an RRD file from its XML form\n"
"\n"
"\trrdtool restore [--range-check|-r] [--force-overwrite|-f] filename.xml "
"filename.rrd\n"
msgstr ""
"* restore - ripristina un file RRD  dal formato XML dello stesso\n"
"\n"
"\trrdtool restore [--range-check|-r] [--force-overwrite|-f] nome_file.xml "
"nome_file.rrd\n"

#: src/rrd_tool.c:95
msgid ""
"* last - show last update time for RRD\n"
"\n"
"\trrdtool last filename.rrd\n"
"\t\t[--daemon|-d address]\n"
msgstr ""
"* last - mostra l'ora dell'ultimo aggiornamento per RRD\n"
"\n"
"\trrdtool ultimo nomefile.rrd\n"
"\t\t[--daemon|-d indirizzo]\n"

#: src/rrd_tool.c:100
msgid ""
"* lastupdate - returns the most recent datum stored for\n"
"  each DS in an RRD\n"
"\n"
"\trrdtool lastupdate filename.rrd\n"
"\t\t[--daemon|-d address]\n"
msgstr ""
"* lastupdate - restituisce il dato più recente memorizzato per\n"
"  ogni DS in un RRD\n"
"\n"
"\trrdtool ultimo aggiornamento nomefile.rrd\n"
"\t\t[--daemon|-d indirizzo]\n"

#: src/rrd_tool.c:106
msgid ""
"* first - show first update time for RRA within an RRD\n"
"\n"
"\trrdtool first filename.rrd [--rraindex number] [--daemon|-d address]\n"
msgstr ""
"* first - mostra il primo tempo di aggiornamento per RRA all'interno di un "
"RRD\n"
"\n"
"\trrdtool first filename.rrd [--rraindex numero] [--daemon|-d indirizzo]\n"

#: src/rrd_tool.c:110
msgid ""
"* update - update an RRD\n"
"\n"
"\trrdtool update filename\n"
"\t\t[--template|-t ds-name:ds-name:...]\n"
"\t\t[--skip-past-updates|-s]\n"
"\t\t[--daemon|-d <address>]\n"
"\t\ttime|N:value[:value...]\n"
"\n"
"\t\tat-time@value[:value...]\n"
"\n"
"\t\t[ time:value[:value...] ..]\n"
msgstr ""
"* aggiornamento - aggiorna un RRD\n"
"\n"
"\trrdtool aggiorna il nome del file\n"
"\t\t[--template|-t ds-name:ds-name:...]\n"
"\t\t[--salta-aggiornamenti-passati|-s]\n"
"\t\t[--daemon|-d <indirizzo>]\n"
"\t\tora|N:valore[:valore...]\n"
"\n"
"\t\tat-time@value[:value...]\n"
"\n"
"\t\t[ tempo:valore[:valore...] ..]\n"

#: src/rrd_tool.c:120
msgid ""
"* updatev - a verbose version of update\n"
"\treturns information about values, RRAs, and datasources updated\n"
"\n"
"\trrdtool updatev filename\n"
"\t\t[--template|-t ds-name:ds-name:...]\n"
"\t\t[--skip-past-updates|-s]\n"
"\t\ttime|N:value[:value...]\n"
"\n"
"\t\tat-time@value[:value...]\n"
"\n"
"\t\t[ time:value[:value...] ..]\n"
msgstr ""
"* updatev - una versione dettagliata dell'aggiornamento\n"
"\trestituisce informazioni su valori, RRA e origini dati aggiornati\n"
"\n"
"\trrdtool updatev nome file\n"
"\t\t[--template|-t ds-name:ds-name:...]\n"
"\t\t[--salta-aggiornamenti-passati|-s]\n"
"\t\tora|N:valore[:valore...]\n"
"\n"
"\t\tat-time@value[:value...]\n"
"\n"
"\t\t[ tempo:valore[:valore...] ..]\n"

#: src/rrd_tool.c:130
msgid ""
"* fetch - fetch data out of an RRD\n"
"\n"
"\trrdtool fetch filename.rrd CF\n"
"\t\t[-r|--resolution resolution]\n"
"\t\t[-s|--start start] [-e|--end end]\n"
"\t\t[-a|--align-start]\n"
"\t\t[-d|--daemon <address>]\n"
msgstr ""
"* fetch - recupera i dati da un RRD\n"
"\n"
"\trrdtool recupera nomefile.rrd CF\n"
"\t\t[-r|--risoluzione risoluzione]\n"
"\t\t[-s|--inizio inizio] [-e|--fine fine]\n"
"\t\t[-a|--align-start]\n"
"\t\t[-d|--daemon <indirizzo>]\n"

#: src/rrd_tool.c:138
msgid ""
"* flushcached - flush cached data out to an RRD file\n"
"\n"
"\trrdtool flushcached filename.rrd\n"
"\t\t[-d|--daemon <address>]\n"
msgstr ""
"* flushcached - svuota i dati memorizzati nella cache in un file RRD\n"
"\n"
"\trrdtool flushcached nomefile.rrd\n"
"\t\t[-d|--daemon <indirizzo>]\n"

#: src/rrd_tool.c:145
msgid ""
"* graph - generate a graph from one or several RRD\n"
"\n"
"\trrdtool graph filename [-s|--start seconds] [-e|--end seconds]\n"
msgstr ""
"* graph - genera un grafico da una o più RRD\n"
"\n"
"\trrdtool graph nomefile [-s|--start secondi] [-e|--end secondi]\n"

#: src/rrd_tool.c:148
msgid ""
"* graphv - generate a graph from one or several RRD\n"
"           with meta data printed before the graph\n"
"\n"
"\trrdtool graphv filename [-s|--start seconds] [-e|--end seconds]\n"
msgstr ""
"* graphv - genera un grafico da una o più RRD\n"
"          con i meta-dati stampati prima del grafico\n"
"\n"
"\trrdtool graphv nomefile [-s|--start secondi] [-e|--end secondi]\n"

