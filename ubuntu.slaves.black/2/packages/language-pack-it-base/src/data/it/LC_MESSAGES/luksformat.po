#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Questo programma deve essere avviato come root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Crea e formatta un device LUKS cifrato\n"
"Uso: luksformat [-t <file system>] <device> [ opzioni mkfs ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Errore: device montato: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Errore: file system non valido: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Errore: impossibile generare nomi temporanei di device mappati"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Creazione del device cifrato su %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Impossibile creare il device LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Inserire nuovamente la passphrase per verificarla\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Le passphrase inserite non erano identiche\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Impossibile formattare il device con il file system %s"
