"\n"
msgstr ""
"uudecode (GNU sharutils) - decodifica un file codificato\n"
"Utilizzo: uudecode [ -<flag> [<val>] | --<nome>[{=| }<val>] ]... "
"[<file>...]\n"
"\n"

#: src/uudecode-opts.c:752
msgid "   -o, --output-file=str      direct output to file\n"
msgstr "   -o, --output-file=str invia l'output al file\n"

#: src/uudecode-opts.c:753
