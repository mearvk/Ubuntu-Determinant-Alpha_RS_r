#: src/shar-opts.c:2276
#, c-format
msgid ""
"shar (GNU sharutils) - create a shell archive\n"
"Usage:  %s [ -<flag> [<val>] | --<name>[{=| }<val>] ]... [<file>...]\n"
msgstr ""
"shar (GNU sharutils) - crea un archivio shell\n"
"Utilizzo: %s [ -<flag> [<val>] | --<nome>[{=| }<val>] ]... [<file>...]\n"

#: src/shar-opts.c:2280
msgid ""
"If no 'file's are specified, the list of input files is read from standard\n"
"input.  Standard input must not be a terminal.\n"
msgstr ""
"Se non vengono specificati 'file', l'elenco dei file di input viene letto "
"dallo standard\n"
"ingresso. L'input standard non deve essere un terminale.\n"

#: src/shar-opts.c:2284
msgid ""
"'shar' creates \"shell archives\" (or shar files) which are in text format\n"
"and can be emailed.  These files may be unpacked later by executing them\n"
"with '/bin/sh'.  The resulting archive is sent to standard out unless the\n"
"'-o' option is given.  A wide range of features provide extensive\n"
"flexibility in manufacturing shars and in specifying 'shar' \"smartness\".\n"
"Archives may be fairly simple ('--vanilla-operation') or essentially a\n"
"mailable 'tar' archive.\n"
"\n"
msgstr ""
"'shar' crea \"archivi shell\" (o file shar) che sono in formato testo\n"
"e può essere inviato via e-mail. Questi file possono essere decompressi in "
"seguito eseguendoli\n"
"con '/bin/sh'. L'archivio risultante viene inviato allo standard out a meno "
"che il\n"
"Viene fornita l'opzione '-o'. Una vasta gamma di funzionalità fornisce "
"un'ampia\n"
"flessibilità nella produzione di shars e nello specificare "
"l'\"intelligenza\" 'shar'.\n"
"Gli archivi possono essere abbastanza semplici (\"--vanilla-operation\") o "
"essenzialmente a\n"
"archivio 'tar' inviabile per posta.\n"
"\n"

#: src/shar-opts.c:2291 src/shar-opts.c:2385
msgid ""
"Options may be specified in any order until a 'file' argument is\n"
"recognized.  If the '--intermix-type' option has been specified, more\n"
"compression and encoding options will be recognized between the 'file'\n"
"arguments.\n"
"\n"
msgstr ""
"Le opzioni possono essere specificate in qualsiasi ordine fino a quando non "
"viene visualizzato un argomento 'file'\n"
"riconosciuto. Se è stata specificata l'opzione '--intermix-type', more\n"
"le opzioni di compressione e codifica verranno riconosciute tra il 'file'\n"
"argomenti.\n"
"\n"

#: src/shar-opts.c:2295
msgid ""
"Though this program supports 'uuencode'-d files, they are deprecated.  If\n"
"you are emailing files, please consider mime-encoded files.  If you do\n"
"'uuencode', base64 is the preferred encoding method.\n"
msgstr ""
"Sebbene questo programma supporti i file 'uuencode'-d, sono obsoleti. Se\n"
"stai inviando file tramite e-mail, considera i file con codifica MIME. Se "
"fate\n"
"'uuencode', base64 è il metodo di codifica preferito.\n"

#: src/shar-opts.c:2300
msgid "shar (GNU sharutils) 4.15.2"
msgstr "shar (GNU sharutils) 4.15.2"

#: src/shar-opts.c:2303
msgid ""
"shar (GNU sharutils) - create a shell archive\n"
"Usage:  shar [ -<flag> [<val>] | --<name>[{=| }<val>] ]... [<file>...]\n"
"\n"
msgstr ""
"Shar (GNU Sharitils) - Crea Un Archivio Conchiglia\n"
"Utilizzo: shar [ -<flag> [<val>] | -<nome> [{= |} <val>]] ... [<segna> ...]\n"
"\n"

#: src/shar-opts.c:2305
msgid ""
"Specify compression:\n"
"   -p, --intermix-type        specify compression for input files\n"
"                                - prohibits the option 'vanilla-operation'\n"
msgstr ""
"Specificare la compressione:\n"
"   -p,--intermix specificare la compressione per i file di input\n"
"                                - Proibisce l'opzione \"Operazione alla "
"vaniglia\"\n"

#: src/shar-opts.c:2308
msgid ""
"   -C, --compactor=PROG       specify compaction (compression) program PROG\n"
"                                - prohibits the option 'vanilla-operation'\n"
"                                - may appear multiple times\n"
"                                - it must be known to shar: xz gzip bzip2\n"
msgstr ""
"   -C, --Compactor = Prog Specify Compaction (Compression) Programma Prog\n"
"                                - Proibisce l'opzione \"Operazione alla "
"vaniglia\"\n"
"                                - Può apparire più volte\n"
"                                - Deve essere noto a Shar: XZ GZIP BZIP2\n"

#: src/shar-opts.c:2312
msgid ""
"   -g, --level-of-compression=LEVEL\n"
"                              pass LEVEL for compression\n"
"                                - it must be in the range: 1 to 9\n"
"\n"
msgstr ""
"   -G,-Level-of-Compression = Level\n"
"                              Livello di passaggio per la compressione\n"
"                                - Deve essere nell'intervallo: da 1 a 9\n"
"\n"

#: src/shar-opts.c:2315
msgid ""
"Specify file encoding methodology:\n"
"   -M, --mixed-uuencode       decide uuencoding for each file\n"
msgstr ""
"Specificare la metodologia di codifica dei file:\n"
"   -M,-Mixed-Uuencode Decidi l'uuencoding per ogni file\n"

#: src/shar-opts.c:2317
msgid ""
"   -B, --uuencode             treat all files as binary\n"
"                                - an alternate for mixed-uuencode\n"
msgstr ""
"   -B, --Uencode Tratta tutti i file come binari\n"
"                                - Un alternativo per la Uuencode mista\n"

#: src/shar-opts.c:2319
msgid ""
"   -T, --text-files           treat all files as text\n"
"                                - an alternate for mixed-uuencode\n"
"\n"
msgstr ""
"   -T,--text-files tratta tutti i file come testo\n"
"                                - Un alternativo per la Uuencode mista\n"
"\n"

#: src/shar-opts.c:2321
msgid "Specifying file selection and output modes:\n"
msgstr "Specifica delle modalità di selezione e output dei file:\n"

#: src/shar-opts.c:2322
msgid "   -o, --output-prefix=str    print output to file PREFIX.nn\n"
msgstr "   -o, --Output-prefix = STR Stampa output su file prefix.nn\n"

#: src/shar-opts.c:2323
msgid ""
"   -l, --whole-size-limit=SIZE\n"
"                              split archive, not files, to SIZE\n"
"                                - requires the option 'output-prefix'\n"
"                                - is scalable with a suffix: "
"k/K/m/M/g/G/t/T\n"
"                                - it must lie in one of the ranges:\n"
"                                  8 to 1023, or 8192 to 4194304\n"
msgstr ""
"   -l, --whole-size-limit=DIMENSIONE\n"
"                              dividere l'archivio, non i file, in SIZE\n"
"                                - richiede l'opzione 'output-prefix'\n"
"                                - è scalabile con un suffisso: "
"k/K/m/M/g/G/t/T\n"
"                                - deve trovarsi in uno degli intervalli:\n"
"                                  da 8 a 1023 o da 8192 a 4194304\n"

#: src/shar-opts.c:2329
msgid ""
"   -L, --split-size-limit=SIZE\n"
"                              split archive or files to SIZE\n"
"                                - requires the option 'output-prefix'\n"
"                                - is scalable with a suffix: "
"k/K/m/M/g/G/t/T\n"
"                                - it must lie in one of the ranges:\n"
"                                  8 to 1023, or 8192 to 4194304\n"
"                                - an alternate for 'whole-size-limit'\n"
msgstr ""
"   -L, --split-size-limit=DIMENSIONE\n"
"                              dividere l'archivio oi file in SIZE\n"
"                                - richiede l'opzione 'output-prefix'\n"
"                                - è scalabile con un suffisso: "
"k/K/m/M/g/G/t/T\n"
"                                - deve trovarsi in uno degli intervalli:\n"
"                                  da 8 a 1023 o da 8192 a 4194304\n"
"                                - un'alternativa per \"limite di dimensioni "
"intere\"\n"

#: src/shar-opts.c:2336
msgid ""
"   -I, --input-file-list=FILE read file list from FILE\n"
"\n"
msgstr ""
"   -I, --input-file-list=FILE legge l'elenco dei file da FILE\n"
"\n"

#: src/shar-opts.c:2337
msgid ""
"Controlling the shar headers:\n"
"   -n, --archive-name=NAME    use NAME to document the archive\n"
msgstr ""
"Controllo delle intestazioni shar:\n"
"   -n, --archive-name=NOME usa NOME per documentare l'archivio\n"

#: src/shar-opts.c:2339
msgid "   -s, --submitter=NAME       override the submitter name with NAME\n"
msgstr "   -s, --submitter=NOME sovrascrive il nome del mittente con NOME\n"

#: src/shar-opts.c:2340
msgid ""
"   -a, --net-headers          output Submitted-by: & Archive-name: headers\n"
"                                - requires the option 'archive-name'\n"
msgstr ""
"   -a, --net-headers output Inviato da: & Nome archivio: intestazioni\n"
"                                - richiede l'opzione 'nome-archivio'\n"

#: src/shar-opts.c:2342
msgid "   -c, --cut-mark             start the shar with a cut line\n"
msgstr "   -c, --cut-mark inizia lo shar con una linea di taglio\n"

#: src/shar-opts.c:2343
msgid ""
"   -t, --translate            translate messages in the script\n"
"\n"
msgstr ""
"   -t, --translate traduce i messaggi nello script\n"
"\n"

#: src/shar-opts.c:2344
msgid ""
"Protecting against transmission issues:\n"
"       --no-character-count   do not use `wc -c' to check size\n"
msgstr ""
"Protezione da problemi di trasmissione:\n"
"       --no-character-count non usa `wc -c' per controllare la dimensione\n"

#: src/shar-opts.c:2346
msgid "   -D, --no-md5-digest        do not use md5sum digest to verify\n"
msgstr "   -D, --no-md5-digest non usa md5sum digest per verificare\n"

#: src/shar-opts.c:2347
msgid ""
"   -F, --force-prefix         apply the prefix character on every line\n"
msgstr "   -F, --force-prefix applica il carattere prefisso su ogni riga\n"

#: src/shar-opts.c:2348
msgid ""
"   -d, --here-delimiter=DELIM use DELIM to delimit the files\n"
"\n"
msgstr ""
"   -d, --here-delimiter=DELIM usa DELIM per delimitare i file\n"
"\n"

#: src/shar-opts.c:2349
msgid ""
"Producing different kinds of shars:\n"
"   -V, --vanilla-operation    produce very simple shars\n"
msgstr ""
"Produrre diversi tipi di shar:\n"
"   -V, --vanilla-operation produce shar molto semplici\n"

#: src/shar-opts.c:2351
msgid "   -P, --no-piping            use temporary files between programs\n"
msgstr "   -P, --no-piping usa file temporanei tra i programmi\n"

#: src/shar-opts.c:2352
msgid "   -x, --no-check-existing    blindly overwrite existing files\n"
msgstr "   -x, --no-check-existing sovrascrive ciecamente i file esistenti\n"

#: src/shar-opts.c:2353
msgid ""
"   -X, --query-user           ask user before overwriting files\n"
"                                - prohibits the option 'vanilla-operation'\n"
msgstr ""
"   -X, --query-user chiede all'utente prima di sovrascrivere i file\n"
"                                - vieta l'opzione 'operazione vaniglia'\n"

#: src/shar-opts.c:2355
msgid "   -m, --no-timestamp         do not restore modification times\n"
msgstr "   -m, --no-timestamp non ripristina i tempi di modifica\n"

#: src/shar-opts.c:2356
msgid "   -Q, --quiet-unshar         avoid verbose messages at unshar time\n"
msgstr ""
"   -Q, --quiet-unshar evita i messaggi prolissi al momento dell'unshar\n"

#: src/shar-opts.c:2357
msgid ""
"   -f, --basename             restore in one directory, despite hierarchy\n"
"\n"
msgstr ""
"   -f, --basename ripristina in una directory, nonostante la gerarchia\n"
"\n"

#: src/shar-opts.c:2358
msgid ""
"Internationalization options:\n"
"       --no-i18n              do not internationalize\n"
msgstr ""
"Opzioni di internazionalizzazione:\n"
"       --no-i18n non internazionalizza\n"

#: src/shar-opts.c:2360
msgid ""
"       --print-text-domain-dir  print directory with shar messages\n"
"\n"
msgstr ""
"       --print-text-domain-dir directory di stampa con messaggi shar\n"
"\n"

#: src/shar-opts.c:2361
msgid ""
"User feedback/entertainment:\n"
"   -q, --quiet                do not output verbose messages\n"
msgstr ""
"Feedback/intrattenimento degli utenti:\n"
"   -q, --quiet non emette messaggi dettagliati\n"

#: src/shar-opts.c:2363
msgid ""
"       --silent               an alias for the 'quiet' option\n"
"\n"
msgstr ""
