#. Type: title
#. Description
#: ../needrestart.templates:1001
msgid "Daemons using outdated libraries"
msgstr "Demoni che utilizzano librerie obsolete"

#. Type: multiselect
#. Description
#: ../needrestart.templates:2001
msgid "Which services should be restarted?"
msgstr "Quali servizi devono essere riavviati?"

#. Type: note
#. Description
#. Type: note
#. Description
#: ../needrestart.templates:3001 ../needrestart.templates:4001
msgid "Newer kernel available"
msgstr "Kernel più recente disponibile"

#. Type: note
#. Description
#: ../needrestart.templates:3001
msgid ""
"The currently running kernel version is ${KVERSION} and there is an ABI "
"compatible upgrade pending."
msgstr ""
"La versione del kernel attualmente in esecuzione è ${KVERSION} ed è in "
"sospeso un aggiornamento compatibile con ABI."

#. Type: note
#. Description
#. Type: note
#. Description
#: ../needrestart.templates:3001 ../needrestart.templates:4001
msgid ""
"Restarting the system to load the new kernel will not be handled "
"automatically, so you should consider rebooting."
msgstr ""
"Il riavvio del sistema per caricare il nuovo kernel non verrà gestito "
"automaticamente, quindi dovresti considerare di riavviare."

#. Type: note
#. Description
#: ../needrestart.templates:4001
msgid ""
"The currently running kernel version is ${KVERSION} which is not the "
"expected kernel version ${EVERSION}."
msgstr ""
"La versione del kernel attualmente in esecuzione è ${KVERSION} che non è la "
"versione del kernel prevista ${EVERSION}."

#. Type: title
#. Description
#: ../needrestart.templates:5001
msgid "Pending kernel upgrade"
msgstr "Aggiornamento del kernel in attesa"

#. Type: title
#. Description
#: ../needrestart.templates:6001
msgid "Restart pending..."
msgstr "Riavvia in attesa..."

#. Type: note
#. Description
#: ../needrestart.templates:7001
msgid "This system runs ${EHINT} - you should consider rebooting!"
msgstr "Questo sistema esegue ${EHINT} - dovresti considerare di riavviare!"

#. Type: note
#. Description
#: ../needrestart.templates:7001
msgid "For more details, run «needrestart -m a»."
msgstr "Per maggiori dettagli, esegui «needrestart -m a»."

#. Type: title
#. Description
#: ../needrestart.templates:8001
msgid "Outdated processor microcode"
msgstr "Microcodice processore obsoleto"

#. Type: note
#. Description
#: ../needrestart.templates:9001
msgid "Processor microcode update"
msgstr "Aggiornamento del microcodice del processore"

#. Type: note
#. Description
#: ../needrestart.templates:9001
msgid ""
"The currently running processor microcode revision is ${CURRENT} which is "
"not the expected microcode revision ${AVAIL}."
msgstr ""
"La revisione del microcodice del processore attualmente in esecuzione è "
"${CURRENT} che non è la revisione del microcodice prevista ${AVAIL}."

#. Type: note
#. Description
#: ../needrestart.templates:9001
msgid ""
"Restarting the system to load the new processor microcode will not be "
"handled automatically, so you should consider rebooting."
msgstr ""
"Il riavvio del sistema per caricare il nuovo microcodice del processore non "
"verrà gestito automaticamente, quindi dovresti considerare il riavvio."

#. Type: title
#. Description
#: ../needrestart.templates:10001
msgid "Containers using outdated libraries"
msgstr "Contenitori che utilizzano librerie obsolete"

#. Type: multiselect
#. Description
#: ../needrestart.templates:11001
msgid "Which containers should be restarted?"
msgstr "Quali contenitori devono essere riavviati?"
