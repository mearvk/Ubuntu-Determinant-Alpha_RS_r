#: tools/hangul.c:72
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Uso: %s [OPZIONI]... [FILE]...\n"

#: tools/hangul.c:76
msgid ""
"Convert string into korean characters according to korean keyboard layout.\n"
"\n"
"Mandatory arguments to long options are mandatory for short options too.\n"
"  -k, --keyboard=KEYBOARDID   select keyboard layout by KEYBOARDID\n"
"  -l, --list                  list available keyboard and exit\n"
"  -i, --input=STRING          use STRING as input instead of standard input\n"
"  -o, --output=FILE           write result to FILE instead of standard "
"output\n"
"  -s, --strict-order          do not allow wrong input sequence\n"
msgstr ""
"Converti la stringa in caratteri coreani in base al layout della tastiera "
"coreana.\n"
"\n"
"Gli argomenti obbligatori per le opzioni lunghe sono obbligatori anche per "
"le opzioni brevi.\n"
"   -k, --keyboard=KEYBOARDID seleziona il layout della tastiera per "
"KEYBOARDID\n"
"   -l, --list elenca la tastiera disponibile ed esce\n"
"   -i, --input=STRING usa STRING come input invece dell'input standard\n"
"   -o, --output=FILE scrive il risultato su FILE invece che sull'output "
"standard\n"
"   -s, --strict-order non consente una sequenza di input errata\n"

#: tools/hangul.c:87
msgid ""
"      --help                  display this help and exit\n"
"      --version               output version information and exit\n"
msgstr ""
"      --help visualizza questa guida ed esce\n"
"      --version emette informazioni sulla versione ed esce\n"

#: tools/hangul.c:92
msgid ""
"\n"
"With no FILE, or when FILE is -, read standard input.\n"
msgstr ""
"\n"
"Senza FILE, o quando FILE è -, legge lo standard input.\n"

#: tools/hangul.c:97
#, c-format
msgid ""
"\n"
"Examples:\n"
"  %s -i gksrmfdlqfur  Convert specified string into korean characters\n"
"                          and print them to standard output.\n"
"  %s                  Convert standard input into korean characters\n"
"                          and print them to standard output.\n"
msgstr ""
"\n"
"Esempi:\n"
"   %s -i gksrmfdlqfur Converte la stringa specificata in caratteri coreani\n"
"                           e stamparli su output standard.\n"
"   %s Converti l'input standard in caratteri coreani\n"
"                           e stamparli su output standard.\n"

#: tools/hangul.c:107
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Usare \"%s --help\" per maggiori informazioni.\n"

#: tools/hangul.c:237 tools/hangul.c:276
msgid "standard output"
msgstr "standard output"

