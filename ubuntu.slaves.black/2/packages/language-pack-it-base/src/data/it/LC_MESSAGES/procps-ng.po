#: src/ps/help.c:98
#, c-format
msgid ""
"\n"
"Usage:\n"
" %s [options]\n"
msgstr ""
"\n"
"Uso:\n"
" %s [opzioni]\n"

#: src/ps/help.c:103
msgid ""
"\n"
"Basic options:\n"
msgstr ""
"\n"
"Opzioni di base:\n"

#: src/ps/help.c:104
msgid " -A, -e               all processes\n"
msgstr " -A, -e tutti i processi\n"

#: src/ps/help.c:105
msgid " -a                   all with tty, except session leaders\n"
msgstr " -a tutti con tty, tranne i leader di sessione\n"

#: src/ps/help.c:106
msgid "  a                   all with tty, including other users\n"
msgstr "  a tutti con tty, compresi gli altri utenti\n"

#: src/ps/help.c:107
msgid " -d                   all except session leaders\n"
msgstr " -d tutti, tranne gli animatori di sessione\n"

#: src/ps/help.c:108
msgid " -N, --deselect       negate selection\n"
msgstr " -N, --deselezione nega la selezione\n"

#: src/ps/help.c:109
msgid "  r                   only running processes\n"
msgstr "  r solo i processi in esecuzione\n"

#: src/ps/help.c:110
msgid "  T                   all processes on this terminal\n"
msgstr "  T tutti i processi su questo terminale\n"

#: src/ps/help.c:111
msgid "  x                   processes without controlling ttys\n"
msgstr "  processi x senza controllare le ttys\n"

#: src/ps/help.c:114
msgid ""
"\n"
"Selection by list:\n"
msgstr ""
"\n"
"Selezione per elenco:\n"

#: src/ps/help.c:115
msgid " -C <command>         command name\n"
msgstr " -C <comando> nome del comando\n"

#: src/ps/help.c:116
msgid " -G, --Group <GID>    real group id or name\n"
msgstr " -G, --Gruppo <GID> id o nome reale del gruppo\n"

#: src/ps/help.c:117
msgid " -g, --group <group>  session or effective group name\n"
msgstr " -g, --gruppo <gruppo> nome della sessione o del gruppo effettivo\n"

#: src/ps/help.c:118
msgid " -p, p, --pid <PID>   process id\n"
msgstr " -p, p, --pid <PID> id del processo\n"

#: src/ps/help.c:119
msgid "        --ppid <PID>  parent process id\n"
msgstr "        --ppid <PID> id del processo padre\n"

#: src/ps/help.c:120
msgid ""
" -q, q, --quick-pid <PID>\n"
"                      process id (quick mode)\n"
msgstr ""
" -q, q, --quick-pid <PID>\n"
"                      id del processo (modalità rapida)\n"

#: src/ps/help.c:122
msgid " -s, --sid <session>  session id\n"
msgstr " -s, --sid <sessione> id della sessione\n"

#: src/ps/help.c:123
msgid " -t, t, --tty <tty>   terminal\n"
msgstr " -t, t, --tty <tty> terminale\n"

#: src/ps/help.c:124
msgid " -u, U, --user <UID>  effective user id or name\n"
msgstr " -u, U, --user <UID> id o nome utente effettivo\n"

#: src/ps/help.c:125
msgid " -U, --User <UID>     real user id or name\n"
msgstr " -U, --User <UID> id o nome dell'utente reale\n"

#: src/ps/help.c:126
msgid ""
"\n"
"  The selection options take as their argument either:\n"
"    a comma-separated list e.g. '-u root,nobody' or\n"
"    a blank-separated list e.g. '-p 123 4567'\n"
msgstr ""
"\n"
"  Le opzioni di selezione hanno come argomento\n"
"    un elenco separato da virgole, ad esempio '-u root,nobody' o\n"
"    un elenco separato da virgole, ad esempio \"-p 123 4567\"\n"

#: src/ps/help.c:132
msgid ""
"\n"
"Output formats:\n"
msgstr ""
"\n"
"Formati di uscita:\n"

#: src/ps/help.c:134
msgid " -F                   extra full\n"
msgstr " -F extra pieno\n"

#: src/ps/help.c:135
msgid " -f                   full-format, including command lines\n"
msgstr " -f formato completo, comprese le righe di comando\n"

#: src/ps/help.c:136
msgid "  f, --forest         ascii art process tree\n"
msgstr "  f, --albero di processo dell'arte ascii forestale\n"

#: src/ps/help.c:137
msgid " -H                   show process hierarchy\n"
msgstr " -H mostra la gerarchia dei processi\n"

#: src/ps/help.c:138
msgid " -j                   jobs format\n"
msgstr " -j formato lavori\n"

#: src/ps/help.c:139
msgid "  j                   BSD job control format\n"
msgstr "  j Formato di controllo del lavoro BSD\n"

#: src/ps/help.c:140
msgid " -l                   long format\n"
msgstr " -l formato lungo\n"

#: src/ps/help.c:141
msgid "  l                   BSD long format\n"
msgstr "  l Formato lungo BSD\n"

#: src/ps/help.c:142
msgid " -M, Z                add security data (for SELinux)\n"
msgstr " -M, Z aggiungere dati di sicurezza (per SELinux)\n"

#: src/ps/help.c:143
msgid " -O <format>          preloaded with default columns\n"
msgstr " -O <formato> precaricato con colonne predefinite\n"

#: src/ps/help.c:144
msgid "  O <format>          as -O, with BSD personality\n"
msgstr "  O <formato> come -O, con personalità BSD\n"

#: src/ps/help.c:145
msgid ""
" -o, o, --format <format>\n"
"                      user-defined format\n"
msgstr ""
" -o, o, --formato <formato>\n"
"                      formato definito dall'utente\n"

#: src/ps/help.c:148
msgid "  s                   signal format\n"
msgstr "  formato del segnale s\n"

#: src/ps/help.c:149
msgid "  u                   user-oriented format\n"
msgstr "  u formato orientato all'utente\n"

#: src/ps/help.c:150
msgid "  v                   virtual memory format\n"
msgstr "  v formato di memoria virtuale\n"

#: src/ps/help.c:151
msgid "  X                   register format\n"
msgstr "  Formato del registro X\n"

#: src/ps/help.c:152
msgid ""
" -y                   do not show flags, show rss vs. addr (used with -l)\n"
msgstr " -y non mostra i flag, mostra rss vs. addr (usato con -l)\n"

#: src/ps/help.c:153
msgid "     --context        display security context (for SELinux)\n"
msgstr "     --contesto visualizza il contesto di sicurezza (per SELinux)\n"

#: src/ps/help.c:154
msgid "     --headers        repeat header lines, one per page\n"
msgstr "     --headers ripete le righe di intestazione, una per pagina\n"

#: src/ps/help.c:155
msgid "     --no-headers     do not print header at all\n"
msgstr "     --no-headers non stampa affatto le intestazioni\n"

#: src/ps/help.c:156
msgid ""
"     --cols, --columns, --width <num>\n"
"                      set screen width\n"
msgstr ""
"     --cols, --colonne, --larghezza <num>\n"
"                      imposta la larghezza dello schermo\n"

#: src/ps/help.c:158
msgid ""
"     --rows, --lines <num>\n"
"                      set screen height\n"
msgstr ""
"     --riga, --riga <num>\n"
"                      imposta l'altezza dello schermo\n"

#: src/ps/help.c:162
msgid ""
"\n"
"Show threads:\n"
msgstr ""
"\n"
"Mostra i fili:\n"

#: src/ps/help.c:163
msgid "  H                   as if they were processes\n"
msgstr "  H come se fossero processi\n"

#: src/ps/help.c:164
msgid " -L                   possibly with LWP and NLWP columns\n"
msgstr " -L eventualmente con colonne LWP e NLWP\n"

#: src/ps/help.c:165
msgid " -m, m                after processes\n"
msgstr " -m, m dopo i processi\n"

#: src/ps/help.c:166
msgid " -T                   possibly with SPID column\n"
msgstr " -T eventualmente con colonna SPID\n"

#: src/ps/help.c:169
msgid ""
"\n"
"Miscellaneous options:\n"
msgstr ""
"\n"
"Opzioni varie:\n"

#: src/ps/help.c:170
msgid " -c                   show scheduling class with -l option\n"
msgstr " -c mostra la classe di programmazione con l'opzione -l\n"

#: src/ps/help.c:171
msgid "  c                   show true command name\n"
msgstr "  c mostra il nome del comando true\n"

#: src/ps/help.c:172
msgid "  e                   show the environment after command\n"
msgstr "  e mostra l'ambiente dopo il comando\n"

#: src/ps/help.c:173
msgid ""
"  k,    --sort        specify sort order as: [+|-]key[,[+|-]key[,...]]\n"
msgstr ""
"  k, --sort specifica l'ordine di ordinamento come: [+|-]key[,[+|-"
"]key[,...]]\n"

#: src/ps/help.c:174
msgid "  L                   show format specifiers\n"
msgstr "  L mostra gli specificatori di formato\n"

#: src/ps/help.c:175
msgid "  n                   display numeric uid and wchan\n"
msgstr "  n visualizzazione di uid e wchan numerici\n"

#: src/ps/help.c:176
msgid "  S,    --cumulative  include some dead child process data\n"
msgstr "  S, --cumulativo include i dati di alcuni processi figli morti\n"

#: src/ps/help.c:177
msgid " -y                   do not show flags, show rss (only with -l)\n"
msgstr " -y non mostra i flag, mostra i rss (solo con -l)\n"

#: src/ps/help.c:178
msgid " -V, V, --version     display version information and exit\n"
msgstr ""
" -V, V, --versione visualizza le informazioni sulla versione ed esce.\n"

#: src/ps/help.c:179
msgid " -w, w                unlimited output width\n"
msgstr " -w, w larghezza di uscita illimitata\n"

#: src/ps/help.c:180
#, c-format
msgid ""
"\n"
"        --%s <%s|%s|%s|%s|%s|%s>\n"
"                      display help and exit\n"
msgstr ""
"\n"
"        --%s <%s|%s|%s|%s|%s|%s>\n"
"                      visualizzare la guida e uscire\n"

