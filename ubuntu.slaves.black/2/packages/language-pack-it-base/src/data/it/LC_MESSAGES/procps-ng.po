#: src/pgrep.c:155
#, c-format
msgid " %s [options] <pattern>\n"
msgstr " %s [options] <pattern>\n"

#: src/pgrep.c:159
msgid " -d, --delimiter <string>  specify output delimiter\n"
msgstr " -d, --delimiter <string>  specificare uscita delimitatore\n"

#: src/pgrep.c:160
msgid " -l, --list-name           list PID and process name\n"
msgstr " -l, --list-name lista PID e nome processo\n"

#: src/pgrep.c:161
msgid " -a, --list-full           list PID and full command line\n"
msgstr " -a, --list-full list PID e riga di comando completa\n"

#: src/pgrep.c:162
msgid " -v, --inverse             negates the matching\n"
msgstr " -v, --inverse nega l'abbinamento\n"

#: src/pgrep.c:163
msgid " -w, --lightweight         list all TID\n"
msgstr " -w, --lightweight elenca tutti i TID\n"

#: src/pgrep.c:176
msgid " -<sig>, --signal <sig>    signal to send (either number or name)\n"
msgstr " -<sig>, --signal <sig> segnale da inviare (numero o nome)\n"

#: src/pgrep.c:167
msgid " -q, --queue <value>       integer value to be sent with the signal\n"
msgstr " -q, --queue <valore> valore intero da inviare con il segnale\n"

#: src/pgrep.c:168
msgid " -e, --echo                display what is killed\n"
msgstr " -e, --echo visualizza cosa viene terminato\n"

#: src/pgrep.c:172
msgid " -e, --echo                display PIDs before waiting\n"
msgstr " -e, --echo visualizza i PID prima di attendere\n"

#: src/pgrep.c:177
msgid " -c, --count               count of matching processes\n"
msgstr " -c, --count numero di processi corrispondenti\n"

#: src/pgrep.c:178
msgid " -f, --full                use full process name to match\n"
msgstr " -f, --full usare il nome completo del processo da confrontare\n"

#: src/pgrep.c:179
msgid " -g, --pgroup <PGID,...>   match listed process group IDs\n"
msgstr ""
" -g, --pgroup <PGID,...> corrisponde agli ID dei gruppi di processi "
"elencati\n"

#: src/pgrep.c:180
msgid " -G, --group <GID,...>     match real group IDs\n"
msgstr " -G, --group <GID,...> corrisponde agli ID di gruppo reali\n"

#: src/pgrep.c:181
msgid " -i, --ignore-case         match case insensitively\n"
msgstr ""
" -i, --ignore-case trova la corrispondenza tra maiuscole e minuscole\n"

#: src/pgrep.c:182
msgid " -n, --newest              select most recently started\n"
msgstr " -n, --newest seleziona avviato più recente\n"

#: src/pgrep.c:183
msgid " -o, --oldest              select least recently started\n"
msgstr " -o, --oldest seleziona avviato meno recente\n"

#: src/pgrep.c:184
msgid " -O, --older <seconds>     select where older than seconds\n"
msgstr " -O, --older <secondi> seleziona dove è più vecchio di secondi\n"

#: src/pgrep.c:185
msgid ""
" -P, --parent <PPID,...>   match only child processes of the given parent\n"
msgstr ""
" -P, --parent <PPID,...> corrisponde solo ai processi figlio del genitore "
"specificato\n"

#: src/pgrep.c:186
msgid " -s, --session <SID,...>   match session IDs\n"
msgstr " -s, --session <SID,...> abbina gli ID di sessione\n"

#: src/pgrep.c:187
msgid " -t, --terminal <tty,...>  match by controlling terminal\n"
msgstr " -t, --terminal <tty,...> corrisponde controllando il terminale\n"

#: src/pgrep.c:188
msgid " -u, --euid <ID,...>       match by effective IDs\n"
msgstr " -u, --euid <ID,...> corrisponde a ID effettivi\n"

#: src/pgrep.c:189
msgid " -U, --uid <ID,...>        match by real IDs\n"
msgstr " -U, --uid <ID,...> corrispondono agli ID reali\n"

#: src/pgrep.c:190
msgid " -x, --exact               match exactly with the command name\n"
msgstr " -x, --exact corrispondente esattamente al nome comando\n"

#: src/pgrep.c:191
msgid " -F, --pidfile <file>      read PIDs from file\n"
msgstr " -F, --pidfile <file> leggere il PID dal file\n"

#: src/pgrep.c:192
msgid " -L, --logpidfile          fail if PID file is not locked\n"
msgstr " -L, --logpidfile uscire se il PID del file non è bloccato\n"

#: src/pgrep.c:193
msgid " -r, --runstates <state>   match runstates [D,S,Z,...]\n"
msgstr " -r, --runstates <state> corrisponde a runstates [D,S,Z,...]\n"

#: src/pgrep.c:196
msgid ""
" --ns <PID>                match the processes that belong to the same\n"
"                           namespace as <pid>\n"
msgstr ""
" --ns <PID> corrisponde ai processi che appartengono allo stesso\n"
"                           spazio dei nomi di <pid>\n"

#: src/pgrep.c:198
msgid ""
" --nslist <ns,...>         list which namespaces will be considered for\n"
"                           the --ns option.\n"
"                           Available namespaces: ipc, mnt, net, pid, user, "
"uts\n"
msgstr ""
" --nslist <ns,...> elenca quali spazi dei nomi saranno considerati per "
"l'opzione\n"
"                           l'opzione --ns.\n"
"                           Spazi dei nomi disponibili: ipc, mnt, net, pid, "
"user, uts\n"

