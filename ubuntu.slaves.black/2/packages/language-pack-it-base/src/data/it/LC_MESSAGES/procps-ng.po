#: src/free.c:75
msgid " -b, --bytes         show output in bytes\n"
msgstr " -b, --bytes mostra l'output in byte\n"

#: src/free.c:76
msgid "     --kilo          show output in kilobytes\n"
msgstr "     --kilo mostra l'output in kilobyte\n"

#: src/free.c:77
msgid "     --mega          show output in megabytes\n"
msgstr "     --mega mostra l'output in megabyte\n"

#: src/free.c:78
msgid "     --giga          show output in gigabytes\n"
msgstr "     --giga mostra l'output in gigabyte\n"

#: src/free.c:79
msgid "     --tera          show output in terabytes\n"
msgstr "     --tera mostra l'output in terabyte\n"

#: src/free.c:80
msgid "     --peta          show output in petabytes\n"
msgstr "     --peta mostra l'output in petabyte\n"

#: src/free.c:81
msgid " -k, --kibi          show output in kibibytes\n"
msgstr " -k, --kibi mostra l'output in kibibyte\n"

#: src/free.c:82
msgid " -m, --mebi          show output in mebibytes\n"
msgstr " -m, --mebi mostra l'output in mebibyte\n"

#: src/free.c:83
msgid " -g, --gibi          show output in gibibytes\n"
msgstr " -g, --gibi mostra l'output in gibibyte\n"

#: src/free.c:84
msgid "     --tebi          show output in tebibytes\n"
msgstr "     --tebi mostra l'output in tebibyte\n"

#: src/free.c:85
msgid "     --pebi          show output in pebibytes\n"
msgstr "     --pebi mostra l'output in pebibyte\n"

#: src/free.c:86
msgid " -h, --human         show human-readable output\n"
msgstr " -h, --human mostra l'output in formato leggibile\n"

#: src/free.c:87
msgid "     --si            use powers of 1000 not 1024\n"
msgstr "     --si utilizzare i multipli di 1000 non 1024\n"

#: src/free.c:88
msgid " -l, --lohi          show detailed low and high memory statistics\n"
msgstr ""
" -l, - lohi mostra le statistiche dettagliate della memoria bassa e alta\n"

#: src/free.c:89
msgid " -t, --total         show total for RAM + swap\n"
msgstr " -t, --total mostra il totale di RAM + swap\n"

#: src/free.c:91
msgid " -s N, --seconds N   repeat printing every N seconds\n"
msgstr " -s N, --seconds N ripetere la stampa ogni N secondi\n"

#: src/free.c:92
msgid " -c N, --count N     repeat printing N times, then exit\n"
msgstr " -c N, --count N ripetere la stampa N volte, quindi uscire\n"

#: src/free.c:93
msgid " -w, --wide          wide output\n"
msgstr " -w, --wide wide output\n"

#: src/free.c:95 src/w.c:553
msgid "     --help     display this help and exit\n"
msgstr "     --help visualizza gli aiuti e esci\n"

#: free.c:191
msgid "Multiple unit options doesn't make sense."
msgstr "Le opzioni di unità multiple non hanno senso."

