#: lib/sorter.c:49
msgid "Parse error in field."
msgstr "Trovato un errore nel campo."

#: grep-dctrl/grep-dctrl.c:50
msgid "grep-dctrl -- grep Debian control files"
msgstr "grep-dctrl -- ricerca globale tra i files di controllo di Debian"

#: grep-dctrl/grep-dctrl.c:52
msgid "FILTER [FILENAME...]"
msgstr "FILTRO [NOME FILE...]"

#: grep-dctrl/grep-dctrl.c:71 sort-dctrl/sort-dctrl.c:39
#: tbl-dctrl/tbl-dctrl.c:43 join-dctrl/join-dctrl.c:45
msgid "LEVEL"
msgstr "LIVELLO"

#: grep-dctrl/grep-dctrl.c:71
msgid "Set log level to LEVEL."
msgstr "Imposta il livello di registro su LIVELLO."

#: grep-dctrl/grep-dctrl.c:72 grep-dctrl/grep-dctrl.c:75
msgid "FIELD,FIELD,..."
msgstr "CAMPO,CAMPO,..."

#: grep-dctrl/grep-dctrl.c:72
msgid "Restrict pattern matching to the FIELDs given."
msgstr "Cerca le corrispondenze solo all'interno dei campi specificati."

#: grep-dctrl/grep-dctrl.c:73
msgid "This is a shorthand for -FPackage."
msgstr "Questa è una forma abbreviata per «-FPackage»."

#: grep-dctrl/grep-dctrl.c:74
msgid "This is a shorthand for -FSource:Package."
msgstr "Si riferisce al pacchetto sorgente -FSource:Package."

# NdT: era msgstr "Mostra solo i campi specificati anziché l'intero "
#: grep-dctrl/grep-dctrl.c:75
msgid "Show only the body of these fields from the matching paragraphs."
msgstr ""
"Mostra solo il valore dei campi selezionati del paragrafo corrispondente."

#: grep-dctrl/grep-dctrl.c:76
msgid ""
"Show only the first line of the \"Description\" field from the matching "
"paragraphs."
msgstr ""
"Mostra solo la prima riga del campo «Description» dai paragrafi "
"corrispondenti."

#: grep-dctrl/grep-dctrl.c:77
msgid "Suppress field names when showing specified fields."
msgstr "Mostra solo il contenuto (e non il nome) dei campi specificati."

#: grep-dctrl/grep-dctrl.c:78
msgid "Show only the names of the files that contain matching paragraphs."
msgstr "Mostra solo i nomi dei file che contengono paragrafi corrispondenti."

#: grep-dctrl/grep-dctrl.c:79
msgid ""
"Show only the names of the files that do not contain matching paragraphs."
msgstr ""
"Mostra solo i nomi dei file che non contengono paragrafi corrispondenti."

#: grep-dctrl/grep-dctrl.c:80
msgid "Regard the pattern as an extended POSIX regular expression."
msgstr "Considera il modello come un'espressione regolare POSIX estesa."

#: grep-dctrl/grep-dctrl.c:81
msgid "Regard the pattern as a standard POSIX regular expression."
msgstr "Considera il modello come un'espressione regolare POSIX standard."

#: grep-dctrl/grep-dctrl.c:82
msgid "Ignore case when looking for a match."
msgstr "Ignora maiuscole/minuscole durante il confronto."

#: grep-dctrl/grep-dctrl.c:83
msgid "Show only paragraphs that do not match."
msgstr "Mostra solo i paragrafi che non coincidono."

#: grep-dctrl/grep-dctrl.c:84
msgid "Show those fields that have NOT been selected with -s"
msgstr "Visualizza questi campi che NON sono stati selezionati con -s"

#: grep-dctrl/grep-dctrl.c:85
msgid "Show only the count of matching paragraphs."
msgstr "Mostra solo il conteggio dei paragrafi che coincidono."

#: grep-dctrl/grep-dctrl.c:86
msgid "Do an exact match."
msgstr "Cerca solo corrispondenze esatte."

#: grep-dctrl/grep-dctrl.c:87 sort-dctrl/sort-dctrl.c:38
#: tbl-dctrl/tbl-dctrl.c:42 join-dctrl/join-dctrl.c:44
msgid "Print out the copyright license."
msgstr "Evidenzia l'Autorizzazione del copyright."

#: grep-dctrl/grep-dctrl.c:88
msgid "Conjunct filters."
msgstr "Filtri congiunti."

#: grep-dctrl/grep-dctrl.c:89
msgid "Disjunct filters."
msgstr "Filtri disgiunti."

#: grep-dctrl/grep-dctrl.c:90
msgid "Negate the following filters."
msgstr "Annulla i seguenti filtri."

#: grep-dctrl/grep-dctrl.c:91
msgid "Test for version number equality."
msgstr "Controlla la congruenza del numero di versione."

#: grep-dctrl/grep-dctrl.c:92
msgid "Version number comparison: <<."
msgstr "Confronto del numero di versione: <<."

#: grep-dctrl/grep-dctrl.c:93
msgid "Version number comparison: <=."
msgstr "Comparazione del numero versione: <."

#: grep-dctrl/grep-dctrl.c:94
msgid "Version number comparison: >>."
msgstr "Confronto del numero di versione: >>."

#: grep-dctrl/grep-dctrl.c:95
msgid "Version number comparison: >=."
msgstr "Comparazione del numero versione: >=."

#: grep-dctrl/grep-dctrl.c:96
msgid "Debug option parsing."
msgstr "Verifica delle opzioni in corso."

#: grep-dctrl/grep-dctrl.c:97 grep-dctrl/grep-dctrl.c:98
msgid "Do not output to stdout."
msgstr "Non eseguire l'output su stdout."

#: grep-dctrl/grep-dctrl.c:99 sort-dctrl/sort-dctrl.c:41
#: tbl-dctrl/tbl-dctrl.c:44 join-dctrl/join-dctrl.c:46
msgid "Attempt mmapping input files"
msgstr "Tenta di eseguire mmap sui file di input"

#: grep-dctrl/grep-dctrl.c:100
msgid "Ignore parse errors"
msgstr "Ignora erorri di analisi"

#: grep-dctrl/grep-dctrl.c:101
msgid "PATTERN"
msgstr "SCHEMA"

#: grep-dctrl/grep-dctrl.c:101
msgid "Specify the pattern to search for"
msgstr "Specificare il modulo da cercare"

#: grep-dctrl/grep-dctrl.c:102
msgid "Match only whole package names (this implies -e)"
msgstr "Corrisponde solamente i nomi di pacchetti interi (implica -e)"

#: grep-dctrl/grep-dctrl.c:103
msgid "Ensure that the output is in dctrl format (overridden by -n)"
msgstr "Assicurati che l'output sia in formato dctrl (sostituito da -n)"

#: grep-dctrl/grep-dctrl.c:104
msgid "Override the effect of an earlier --ensure-dctrl"
msgstr "Sostituisci l'effetto di un precedente --ensure-dctrl"

#: grep-dctrl/grep-dctrl.c:185
msgid "filter is too long"
msgstr "il filtro è troppo lungo"

#: grep-dctrl/grep-dctrl.c:219
msgid "-v is incompatible with -L"
msgstr "-v è incompatibile con -L"

#: grep-dctrl/grep-dctrl.c:220
msgid "-v is incompatible with -l"
msgstr "-v è incompatibile con -l"

#: grep-dctrl/grep-dctrl.c:239 grep-dctrl/grep-dctrl.c:251
msgid "only one -l or -L is allowed"
msgstr "è consentito un solo -l o -L"

#: grep-dctrl/grep-dctrl.c:243
msgid "-l is incompatible with -v"
msgstr "-l è incompatibile con -v"

#: grep-dctrl/grep-dctrl.c:255
msgid "-L is incompatible with -v"
msgstr "-L è incompatibile con -v"

#: grep-dctrl/grep-dctrl.c:278 grep-dctrl/grep-dctrl.c:890
#: join-dctrl/join-dctrl.c:113
msgid "too many output fields"
msgstr "troppi campi da visualizzare"

#: grep-dctrl/grep-dctrl.c:302 sort-dctrl/sort-dctrl.c:104
#: tbl-dctrl/tbl-dctrl.c:305 join-dctrl/join-dctrl.c:168
#, c-format
msgid "no such log level '%s'"
msgstr "livello di registro \"%s\" inesistente"

#: grep-dctrl/grep-dctrl.c:509
#, c-format
msgid "internal error: unknown token %d"
msgstr "errore interno: token sconosciuto %d"

#: grep-dctrl/grep-dctrl.c:518
msgid "unexpected end of filter"
msgstr "fine inaspettata del filtro"

#: grep-dctrl/grep-dctrl.c:521
msgid "unexpected pattern in command line"
msgstr "modello imprevisto nella riga di comando"

#: grep-dctrl/grep-dctrl.c:524
msgid "unexpected string in command line"
msgstr "stringa imprevista nella riga di comando"

#: grep-dctrl/grep-dctrl.c:528
#, c-format
msgid "unexpected '%s' in command line"
msgstr "'%s' imprevisto nella riga di comando"

#: grep-dctrl/grep-dctrl.c:632
msgid "missing ')' in command line"
msgstr "manca «)» sulla riga di comando"

#: grep-dctrl/grep-dctrl.c:640
msgid "Multiple patterns for the same simple filter are not allowed"
msgstr "Non sono consentiti più modelli per lo stesso filtro semplice"

#: grep-dctrl/grep-dctrl.c:660
msgid "A pattern is mandatory"
msgstr "Obbligatorio un modello di ricerca"

#: grep-dctrl/grep-dctrl.c:688
msgid "inconsistent modifiers of simple filters"
msgstr "modificatori incoerenti di filtri semplici"

#: grep-dctrl/grep-dctrl.c:761 sort-dctrl/sort-dctrl.c:120
#: tbl-dctrl/tbl-dctrl.c:317 join-dctrl/join-dctrl.c:180
msgid "too many file names"
msgstr "troppi nomi di file"

#: grep-dctrl/grep-dctrl.c:770
msgid "file names are not allowed within the filter"
msgstr "i nomi di file non sono consentiti all'interno del filtro"

#: grep-dctrl/grep-dctrl.c:884
msgid "malformed filter"
msgstr "filtro malformato"

#: grep-dctrl/grep-dctrl.c:894
msgid "Adding \"Description\" to selected output fields because of -d"
msgstr "È stato aggiunto «Description» ai campi da mostrare a causa di -d"

#: grep-dctrl/grep-dctrl.c:902
msgid "-I requires at least one instance of -s"
msgstr "-l richiede almeno un'istanza di -s"

#: grep-dctrl/grep-dctrl.c:908
msgid "cannot suppress field names when showing whole paragraphs"
msgstr ""
"impossibile eliminare i nomi dei campi quando significativi per interi "
"paragrafi"

#: grep-dctrl/grep-dctrl.c:940
#, c-format
msgid "executable name '%s' is not recognised"
msgstr "il nome eseguibile '%s' non è riconosciuto"

#: sort-dctrl/sort-dctrl.c:39 tbl-dctrl/tbl-dctrl.c:43
#: join-dctrl/join-dctrl.c:45
msgid "Set debugging level to LEVEL."
msgstr "Imposta il livello di debug a LIVELLO."

#: sort-dctrl/sort-dctrl.c:40
msgid "KEYSPEC"
msgstr "SPECCHIAVI"

#: sort-dctrl/sort-dctrl.c:40
msgid "Specify sort keys."
msgstr "Specifica le chiavi di ordinamento"

#: sort-dctrl/sort-dctrl.c:88
msgid "invalid key flag"
msgstr "Flag della chiave non valido"

#: sort-dctrl/sort-dctrl.c:140
msgid "sort-dctrl -- sort Debian control files"
msgstr "sort-dctrl -- ordina i file di controllo di Debian"

#: tbl-dctrl/tbl-dctrl.c:39
msgid "DELIM"
msgstr "DELIM"

#: tbl-dctrl/tbl-dctrl.c:39
msgid "Specify a delimiter."
msgstr "Specificare un delimitatore."

#: tbl-dctrl/tbl-dctrl.c:40
msgid "Do not print a table heading"
msgstr "Non stampa l'intestazione di tabella"

#: tbl-dctrl/tbl-dctrl.c:41
msgid "SPEC"
msgstr "SPEC"

#: tbl-dctrl/tbl-dctrl.c:41
msgid "Append the specified column."
msgstr "Accoda la colonna specificata"

#: tbl-dctrl/tbl-dctrl.c:288
msgid "invalid column length"
msgstr "lunghezza colonna non valida"

#: tbl-dctrl/tbl-dctrl.c:342
msgid "tbl-dctrl -- tabularize Debian control files"
msgstr "tbl-dctrl -- Rende i file di controllo Debian tabellari"

#: tbl-dctrl/tbl-dctrl.c:364
msgid "bad multibyte character"
msgstr "carattere multibyte errato"

#: join-dctrl/join-dctrl.c:39 join-dctrl/join-dctrl.c:40
#: join-dctrl/join-dctrl.c:41
msgid "FIELD"
msgstr "CAMPO"

#: join-dctrl/join-dctrl.c:39
msgid "Specify the join field to use for the first file"
msgstr "Specifica il campo di unione per il primo file"

#: join-dctrl/join-dctrl.c:40
msgid "Specify the join field to use for the second file"
msgstr "Specifica il campo di unione per il secondo file"

#: join-dctrl/join-dctrl.c:41
msgid "Specify the common join field"
msgstr "Specifica il campo di unione comune"

#: join-dctrl/join-dctrl.c:42
msgid "FIELDNO"
msgstr "NUMCAMPO"

#: join-dctrl/join-dctrl.c:42
msgid "Print unpairable records from the indicated file (either 1 or 2)"
msgstr "Stampa i record non associabili dal file indicato (1 o 2)"

#: join-dctrl/join-dctrl.c:43
msgid "FIELDSPEC"
msgstr "SPECCAMPO"

#: join-dctrl/join-dctrl.c:43
msgid "Specify the format of the output file"
msgstr "Specifica il formato del file di output"

#: join-dctrl/join-dctrl.c:81
msgid "malformed argument to '-a'"
msgstr "argomento non corretto per \"-a\""

#: join-dctrl/join-dctrl.c:88
msgid "the join field of the first file has already been specified"
msgstr "il campo di unione per il primo file è già stato specificato"

#: join-dctrl/join-dctrl.c:89
msgid "the join field of the second file has already been specified"
msgstr "il campo di unione per il secondo file è già stato specificato"

#: join-dctrl/join-dctrl.c:128
msgid "missing '.' in output field specification"
msgstr "\".\" mancante nella specifica del campo di output"

#: join-dctrl/join-dctrl.c:146
msgid "expected either '1.' or '2.' at the start of the field specification"
msgstr "atteso \"1.\" o \"2.\" all'inizio della specifica di campo"

#: join-dctrl/join-dctrl.c:267
msgid "join-dctrl -- join two Debian control files"
msgstr "join-dctrl -- Unisce due file di controllo di Debian"

#: join-dctrl/join-dctrl.c:286
msgid "need exactly two input files"
msgstr "richiesti esattamente due file di input"

#: join-dctrl/join-dctrl.c:311
msgid "cannot join a stream with itself"
msgstr "impossibile unire un flusso con se stesso"

#: lib/msg.h:52
msgid "I'm broken - please report this bug."
msgstr "Sono rotto - per favore segnala questo bug."

