msgstr ""
"utilizzo: %s [-vbqVh] [-f FORMAT] [--verbose] [--brief] [--format=FORMAT] [--"
"quiet] [--version] [--help] [pattern] {element ...} \n"

#: fc-list/fc-list.c:86
#, c-format
msgid "usage: %s [-vbqVh] [-f FORMAT] [pattern] {element ...} \n"
msgstr "utilizzo: %s [-vbqVh] [-f FORMAT] [motivo] {elemento ...} \n"

