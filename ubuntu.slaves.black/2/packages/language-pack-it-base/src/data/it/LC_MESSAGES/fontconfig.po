#: fc-validate/fc-validate.c:89
#, c-format
msgid "usage: %s [-Vhv] [-i index] [-l LANG] font-file...\n"
msgstr "utilizzo: %s [-Vhv] [-i index] [-l LANG] font-file...\n"

