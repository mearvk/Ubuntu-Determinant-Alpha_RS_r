#: fc-cache/fc-cache.c:107
#, c-format
msgid ""
"usage: %s [-EfrsvVh] [-y SYSROOT] [--error-on-no-fonts] [--force|--really-"
"force] [--sysroot=SYSROOT] [--system-only] [--verbose] [--version] [--help] "
"[dirs]\n"
msgstr ""
"utilizzo: %s [-EfrsvVh] [-y SYSROOT] [--error-on-no-fonts] [--force|--really-"
"force] [--sysroot=SYSROOT] [--solo-sistema] [ --verbose] [--version] [--"
"help] [dirs]\n"

#: fc-cache/fc-cache.c:110
#, c-format
msgid "usage: %s [-EfrsvVh] [-y SYSROOT] [dirs]\n"
msgstr "utilizzo: %s [-EfrsvVh] [-y SYSROOT] [dirs]\n"

#: fc-cache/fc-cache.c:113
#, c-format
msgid ""
"Build font information caches in [dirs]\n"
"(all directories in font configuration by default).\n"
msgstr ""
"Crea cache di informazioni sui caratteri in [dirs]\n"
"(tutte le directory nella configurazione dei caratteri per impostazione "
"predefinita).\n"

#: fc-cache/fc-cache.c:117
#, c-format
msgid ""
"  -E, --error-on-no-fonts  raise an error if no fonts in a directory\n"
msgstr ""
"  -E, --error-on-no-fonts genera un errore se non ci sono font in una "
"directory\n"

#: fc-cache/fc-cache.c:118
#, c-format
msgid ""
"  -f, --force              scan directories with apparently valid caches\n"
msgstr ""
"  -f, --force scansiona le directory con cache apparentemente valide\n"

#: fc-cache/fc-cache.c:119
#, c-format
msgid "  -r, --really-force       erase all existing caches, then rescan\n"
msgstr ""
"  -r, --really-force cancella tutte le cache esistenti, quindi esegue "
"nuovamente la scansione\n"

#: fc-cache/fc-cache.c:120
#, c-format
msgid "  -s, --system-only        scan system-wide directories only\n"
msgstr ""
"  -s, --system-only esegue la scansione solo delle directory a livello di "
"sistema\n"

#: fc-cache/fc-cache.c:121
#, c-format
msgid ""
"  -y, --sysroot=SYSROOT    prepend SYSROOT to all paths for scanning\n"
msgstr ""
"  -y, --sysroot=SYSROOT antepone SYSROOT a tutti i percorsi per la "
"scansione\n"

#: fc-cache/fc-cache.c:122
#, c-format
msgid "  -v, --verbose            display status information while busy\n"
msgstr ""
"  -v, --verbose mostra le informazioni sullo stato mentre è occupato\n"

#: fc-cache/fc-cache.c:123
#, c-format
msgid "  -V, --version            display font config version and exit\n"
msgstr ""
"  -V, --version visualizza la versione di configurazione del carattere ed "
"esce\n"

#: fc-cache/fc-cache.c:124
#, c-format
msgid "  -h, --help               display this help and exit\n"
msgstr "  -h, --help visualizza questa guida ed esce\n"

#: fc-cache/fc-cache.c:126
#, c-format
msgid "  -E         (error-on-no-fonts)\n"
msgstr "  -E (errore su nessun font)\n"

#: fc-cache/fc-cache.c:127
#, c-format
msgid "                       raise an error if no fonts in a directory\n"
msgstr ""
"                       genera un errore se non ci sono font in una "
"directory\n"

#: fc-cache/fc-cache.c:128
#, c-format
msgid ""
"  -f         (force)   scan directories with apparently valid caches\n"
msgstr ""
"  -f (forza) scansiona le directory con cache apparentemente valide\n"

#: fc-cache/fc-cache.c:129
#, c-format
msgid "  -r,   (really force) erase all existing caches, then rescan\n"
msgstr ""
"  -r, (veramente forzato) cancella tutte le cache esistenti, quindi "
"scansiona nuovamente\n"

#: fc-cache/fc-cache.c:130
#, c-format
msgid "  -s         (system)  scan system-wide directories only\n"
msgstr ""
"  -s (sistema) esegue la scansione solo delle directory a livello di "
"sistema\n"

#: fc-cache/fc-cache.c:131
#, c-format
msgid "  -y SYSROOT (sysroot) prepend SYSROOT to all paths for scanning\n"
msgstr ""
"  -y SYSROOT (sysroot) antepone SYSROOT a tutti i percorsi per la scansione\n"

#: fc-cache/fc-cache.c:132
#, c-format
msgid "  -v         (verbose) display status information while busy\n"
msgstr ""
"  -v (dettagliato) visualizza le informazioni sullo stato mentre è occupato\n"

#: fc-cache/fc-cache.c:133 fc-cat/fc-cat.c:181 fc-list/fc-list.c:103
#: fc-match/fc-match.c:107 fc-pattern/fc-pattern.c:101
#, c-format
msgid "  -V         (version) display font config version and exit\n"
msgstr ""
"  -V (versione) visualizza la versione della configurazione del carattere ed "
"esce\n"

#: fc-cache/fc-cache.c:134 fc-cat/fc-cat.c:182 fc-list/fc-list.c:104
#: fc-match/fc-match.c:108 fc-pattern/fc-pattern.c:102
#, c-format
msgid "  -h         (help)    display this help and exit\n"
msgstr "  -h (aiuto) visualizza questo aiuto ed esce\n"

#: fc-cache/fc-cache.c:171
#, c-format
msgid "skipping, looped directory detected\n"
msgstr "saltando, è stata rilevata una directory in loop\n"

#: fc-cache/fc-cache.c:190
#, c-format
msgid "skipping, no such directory\n"
msgstr "saltando, nessuna directory del genere\n"

#: fc-cache/fc-cache.c:208
#, c-format
msgid "\"%s\": not a directory, skipping\n"
msgstr "\"%s\": non una directory, sto saltando\n"

#: fc-cache/fc-cache.c:232
#, c-format
msgid "\"%s\": scanning error\n"
msgstr "\"%s\": errore di scansione\n"

#: fc-cache/fc-cache.c:241
#, c-format
msgid "skipping, existing cache is valid: %d fonts, %d dirs\n"
msgstr "saltando, la cache esistente è valida: %d font, %d dir\n"

#: fc-cache/fc-cache.c:247
#, c-format
msgid "caching, new cache contents: %d fonts, %d dirs\n"
msgstr "cache, nuovo contenuto della cache: %d font, %d directory\n"

#: fc-cache/fc-cache.c:252
#, c-format
msgid "%s: failed to write cache\n"
msgstr "%s: impossibile scrivere la cache\n"

#: fc-cache/fc-cache.c:261
#, c-format
msgid "%s: Can't create subdir set\n"
msgstr "%s: Impossibile creare il set di sottodirectory\n"

#: fc-cache/fc-cache.c:275
#, c-format
msgid "%s: Can't create subdir list\n"
msgstr "%s: Impossibile creare l'elenco delle sottodirectory\n"

#: fc-cache/fc-cache.c:383 fc-cat/fc-cat.c:309
#, c-format
msgid "%s: Can't initialize font config library\n"
msgstr ""
"%s: Impossibile inizializzare la libreria di configurazione dei caratteri\n"

#: fc-cache/fc-cache.c:393
#, c-format
msgid "%s: Can't create list of directories\n"
msgstr "%s: Impossibile creare un elenco di directory\n"

#: fc-cache/fc-cache.c:401
#, c-format
msgid "%s: Can't add directory\n"
msgstr "%s: Impossibile aggiungere la directory\n"

#: fc-cache/fc-cache.c:413
#, c-format
msgid "Out of Memory\n"
msgstr "Memoria esaurita\n"

#: fc-cache/fc-cache.c:456
msgid "failed"
msgstr "fallito"

#: fc-cache/fc-cache.c:456
msgid "succeeded"
msgstr "riuscito"

