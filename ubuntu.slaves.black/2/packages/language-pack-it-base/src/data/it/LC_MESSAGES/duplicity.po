#: ../duplicity/commandline.py:79
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"Use of default filenames is strongly suggested."
msgstr ""
"Attenzione: l'opzione %s è in attesa di essere deprecata e verrà rimossa nei "
"rilasci futuri.\n"
"L'uso del nome file predefinito è fortemente raccomandato."

#: ../duplicity/commandline.py:86
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"--include-filelist and --exclude-filelist now accept globbing characters and "
"should be used instead."
msgstr ""
"Avviso: l'opzione %s è in attesa di ritiro e verrà rimossa in una versione "
"futura.\n"
"--include-filelist e --exclude-filelist ora accettano caratteri di globbing "
"e dovrebbero essere usati al loro posto."

#: ../duplicity/commandline.py:96
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"On many GNU/Linux systems, stdin is represented by /dev/stdin and\n"
"--include-filelist=/dev/stdin or --exclude-filelist=/dev/stdin could\n"
"be used as a substitute."
msgstr ""
"Avviso: l'opzione %s è in attesa di ritiro e verrà rimossa in una versione "
"futura.\n"
"Su molti sistemi GNU/Linux, stdin è rappresentato da /dev/stdin e\n"
"--include-filelist=/dev/stdin o --exclude-filelist=/dev/stdin potrebbe\n"
"essere usato come sostituto."

