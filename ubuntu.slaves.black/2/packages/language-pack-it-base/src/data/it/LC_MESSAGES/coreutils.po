msgstr "Utilizzo: %s [OPZIONE]... [NUMERO]...\n"

#: src/numfmt.c:887
msgid ""
"Reformat NUMBER(s), or the numbers from standard input if none are "
"specified.\n"
msgstr ""
"Riformattare NUMBER(s), o i numeri dallo standard input se non ne sono "
"specificati.\n"

#: src/numfmt.c:891
msgid "      --debug          print warnings about invalid input\n"
msgstr "      --debug stampa avvisi sull'input non valido\n"

#: src/numfmt.c:894
msgid ""
"  -d, --delimiter=X    use X instead of whitespace for field delimiter\n"
msgstr ""
"  -d, --delimiter=X usa X invece di uno spazio bianco per delimitare il "
"campo\n"

#: src/numfmt.c:897
msgid ""
"      --field=FIELDS   replace the numbers in these input fields "
"(default=1)\n"
"                         see FIELDS below\n"
msgstr ""
"      --field=FIELDS sostituisce i numeri in questi campi di input "
"(default=1)\n"
"                         vedi CAMPI di seguito\n"

#: src/numfmt.c:901
msgid ""
"      --format=FORMAT  use printf style floating-point FORMAT;\n"
"                         see FORMAT below for details\n"
msgstr ""
"      --format=FORMAT usa il formato a virgola mobile in stile printf;\n"
"                         vedere FORMATO di seguito per i dettagli\n"

#: src/numfmt.c:905
msgid ""
"      --from=UNIT      auto-scale input numbers to UNITs; default is "
"'none';\n"
"                         see UNIT below\n"
msgstr ""
"      --from=UNIT ridimensiona automaticamente i numeri di input in UNIT; il "
"valore predefinito è 'nessuno';\n"
"                         vedere UNITÀ di seguito\n"

#: src/numfmt.c:909
msgid ""
"      --from-unit=N    specify the input unit size (instead of the default "
"1)\n"
msgstr ""
"      --from-unit=N specifica la dimensione dell'unità di input (invece del "
"valore predefinito 1)\n"

#: src/numfmt.c:912
msgid ""
"      --grouping       use locale-defined grouping of digits, e.g. "
"1,000,000\n"
"                         (which means it has no effect in the C/POSIX "
"locale)\n"
msgstr ""
"      --grouping usa il raggruppamento di cifre definito dalla locale, ad "
"es. 1.000.000\n"
"                         (il che significa che non ha alcun effetto nella "
"locale C/POSIX)\n"

#: src/numfmt.c:916
msgid ""
"      --header[=N]     print (without converting) the first N header lines;\n"
"                         N defaults to 1 if not specified\n"
msgstr ""
"      --header[=N] stampa (senza convertire) le prime N righe di "
"intestazione;\n"
"                         Il valore predefinito di N è 1 se non specificato\n"

#: src/numfmt.c:920
msgid ""
"      --invalid=MODE   failure mode for invalid numbers: MODE can be:\n"
"                         abort (default), fail, warn, ignore\n"
msgstr ""
"      --invalid=MODE modalità di errore per numeri non validi: MODE può "
"essere:\n"
"                         abort (predefinito), fallire, avvertire, ignorare\n"

#: src/numfmt.c:924
msgid ""
"      --padding=N      pad the output to N characters; positive N will\n"
"                         right-align; negative N will left-align;\n"
"                         padding is ignored if the output is wider than N;\n"
"                         the default is to automatically pad if a "
"whitespace\n"
"                         is found\n"
msgstr ""
"      --padding=N riempie l'output con N caratteri; volontà N positiva\n"
"                         allineare a destra; negativo N si allineerà a "
"sinistra;\n"
"                         il riempimento viene ignorato se l'output è più "
"largo di N;\n"
"                         l'impostazione predefinita è riempire "
"automaticamente se uno spazio bianco\n"
"                         è stato trovato\n"

#: src/numfmt.c:931
msgid ""
"      --round=METHOD   use METHOD for rounding when scaling; METHOD can be:\n"
"                         up, down, from-zero (default), towards-zero, "
"nearest\n"
msgstr ""
"      --round=METHOD usa METHOD per arrotondare durante il "
"ridimensionamento; IL METODO può essere:\n"
"                         su, giù, da zero (predefinito), verso zero, più "
"vicino\n"

#: src/numfmt.c:935
msgid ""
"      --suffix=SUFFIX  add SUFFIX to output numbers, and accept optional\n"
"                         SUFFIX in input numbers\n"
msgstr ""
"      --suffix=SUFFIX aggiunge SUFFIX ai numeri di output e accetta "
"facoltativo\n"
"                         SUFFIX nei numeri di input\n"

#: src/numfmt.c:939
msgid ""
"      --to=UNIT        auto-scale output numbers to UNITs; see UNIT below\n"
msgstr ""
"      --to=UNIT ridimensiona automaticamente i numeri di output in UNIT; "
"vedere UNITÀ di seguito\n"

#: src/numfmt.c:942
msgid ""
"      --to-unit=N      the output unit size (instead of the default 1)\n"
msgstr ""
"      --to-unit=N la dimensione dell'unità di output (invece del valore "
"predefinito 1)\n"

#: src/numfmt.c:951
msgid ""
"\n"
"UNIT options:\n"
msgstr ""
"\n"
"Opzioni UNITÀ:\n"

#: src/numfmt.c:954
msgid ""
"  none       no auto-scaling is done; suffixes will trigger an error\n"
msgstr ""
"  nessuno non viene eseguito il ridimensionamento automatico; i suffissi "
"attiveranno un errore\n"

#: src/numfmt.c:957
msgid ""
"  auto       accept optional single/two letter suffix:\n"
"               1K = 1000,\n"
"               1Ki = 1024,\n"
"               1M = 1000000,\n"
"               1Mi = 1048576,\n"
msgstr ""
"  accetta automaticamente il suffisso di una/due lettere opzionale:\n"
"               1K = 1000,\n"
"               1Ki = 1024,\n"
"               1M = 1000000,\n"
"               1Mi = 1048576,\n"

#: src/numfmt.c:963
msgid ""
"  si         accept optional single letter suffix:\n"
"               1K = 1000,\n"
"               1M = 1000000,\n"
"               ...\n"
msgstr ""
"  si accetta un suffisso di lettera singola opzionale:\n"
"               1K = 1000,\n"
"               1M = 1000000,\n"
"               ...\n"

#: src/numfmt.c:968
msgid ""
"  iec        accept optional single letter suffix:\n"
"               1K = 1024,\n"
"               1M = 1048576,\n"
"               ...\n"
msgstr ""
"  iec accetta un suffisso di lettera singola opzionale:\n"
"               1K = 1024,\n"
"               1M = 1048576,\n"
"               ...\n"

#: src/numfmt.c:973
msgid ""
"  iec-i      accept optional two-letter suffix:\n"
"               1Ki = 1024,\n"
"               1Mi = 1048576,\n"
"               ...\n"
msgstr ""
"  iec-accetto il suffisso di due lettere opzionale:\n"
"               1Ki = 1024,\n"
"               1Mi = 1048576,\n"
"               ...\n"

#: src/numfmt.c:979
msgid ""
"\n"
"FIELDS supports cut(1) style field ranges:\n"
"  N    N'th field, counted from 1\n"
"  N-   from N'th field, to end of line\n"
"  N-M  from N'th to M'th field (inclusive)\n"
"  -M   from first to M'th field (inclusive)\n"
"  -    all fields\n"
"Multiple fields/ranges can be separated with commas\n"
msgstr ""
"\n"
"FIELDS supporta gli intervalli di campi in stile cut(1):\n"
"  N N° campo, contato da 1\n"
"  N- dall'N-esimo campo, a fine riga\n"
"  N-M da N'th a M'th campo (incluso)\n"
"  -M dal primo al Mesimo campo (compreso)\n"
"  - tutti i campi\n"
"È possibile separare più campi/intervalli con virgole\n"

#: src/numfmt.c:989
#, c-format
msgid ""
"\n"
"FORMAT must be suitable for printing one floating-point argument '%f'.\n"
"Optional quote (%'f) will enable --grouping (if supported by current "
"locale).\n"
"Optional width value (%10f) will pad output. Optional zero (%010f) width\n"
"will zero pad the number. Optional negative values (%-10f) will left align.\n"
"Optional precision (%.1f) will override the input determined precision.\n"
msgstr ""
"\n"
"FORMAT deve essere adatto per stampare un argomento a virgola mobile '%f'.\n"
"La virgoletta opzionale (%'f) abiliterà --grouping (se supportato dalla "
"locale corrente).\n"
"Il valore di larghezza opzionale (%10f) riempirà l'output. Larghezza "
"opzionale zero (%010f).\n"
"azzererà il numero. I valori negativi opzionali (%-10f) verranno allineati a "
"sinistra.\n"
"La precisione opzionale (%.1f) sovrascriverà la precisione determinata "
"dall'input.\n"

#: src/numfmt.c:997
#, c-format
msgid ""
"\n"
"Exit status is 0 if all input numbers were successfully converted.\n"
"By default, %s will stop at the first conversion error with exit status 2.\n"
"With --invalid='fail' a warning is printed for each conversion error\n"
"and the exit status is 2.  With --invalid='warn' each conversion error is\n"
"diagnosed, but the exit status is 0.  With --invalid='ignore' conversion\n"
"errors are not diagnosed and the exit status is 0.\n"
msgstr ""
"\n"
"Lo stato di uscita è 0 se tutti i numeri di input sono stati convertiti "
"correttamente.\n"
"Per impostazione predefinita, %s si fermerà al primo errore di conversione "
"con stato di uscita 2.\n"
"Con --invalid='fail' viene stampato un avviso per ogni errore di "
"conversione\n"
"e lo stato di uscita è 2. Con --invalid='warn' ogni errore di conversione è\n"
"diagnosticato, ma lo stato di uscita è 0. Con la conversione --"
"invalid='ignore'\n"
"gli errori non vengono diagnosticati e lo stato di uscita è 0.\n"

#: src/numfmt.c:1006
#, c-format
msgid ""
"\n"
"Examples:\n"
"  $ %s --to=si 1000\n"
"            -> \"1.0K\"\n"
"  $ %s --to=iec 2048\n"
"           -> \"2.0K\"\n"
"  $ %s --to=iec-i 4096\n"
"           -> \"4.0Ki\"\n"
"  $ echo 1K | %s --from=si\n"
"           -> \"1000\"\n"
"  $ echo 1K | %s --from=iec\n"
"           -> \"1024\"\n"
"  $ df -B1 | %s --header --field 2-4 --to=si\n"
"  $ ls -l  | %s --header --field 5 --to=iec\n"
"  $ ls -lh | %s --header --field 5 --from=iec --padding=10\n"
"  $ ls -lh | %s --header --field 5 --from=iec --format %%10f\n"
msgstr ""
"\n"
"Esempi:\n"
"  $ %s --to=si 1000\n"
"            -> \"1.0K\"\n"
"  $ %s --to=iec 2048\n"
"           -> \"2.0K\"\n"
"  $ %s --to=iec-i 4096\n"
"           -> \"4.0Ki\"\n"
"  $ eco 1K | %s --da=si\n"
"           -> \"1000\"\n"
"  $ eco 1K | %s --from=iec\n"
"           -> \"1024\"\n"
"  $ df -B1 | %s --header --field 2-4 --to=si\n"
"  $ ls -l | %s --header --field 5 --to=iec\n"
"  $ ls -lh | %s --header --field 5 --from=iec --padding=10\n"
"  $ ls -lh | %s --header --field 5 --from=iec --format %%10f\n"

