#: src/basenc.c:107
msgid ""
"basenc encode or decode FILE, or standard input, to standard output.\n"
msgstr ""
"basenc codifica o decodifica FILE, o input standard, in output standard.\n"

#: src/basenc.c:111
#, c-format
msgid ""
"Base%d encode or decode FILE, or standard input, to standard output.\n"
msgstr ""
"Base%d codifica o decodifica FILE, o input standard, in output standard.\n"

#: src/basenc.c:119
msgid ""
"      --base64          same as 'base64' program (RFC4648 section 4)\n"
msgstr "      --base64 uguale al programma 'base64' (RFC4648 sezione 4)\n"

#: src/basenc.c:122
msgid ""
"      --base64url       file- and url-safe base64 (RFC4648 section 5)\n"
msgstr "      --base64url file- e url-safe base64 (RFC4648 sezione 5)\n"

#: src/basenc.c:125
msgid ""
"      --base32          same as 'base32' program (RFC4648 section 6)\n"
msgstr "      --base32 uguale al programma 'base32' (RFC4648 sezione 6)\n"

#: src/basenc.c:128
msgid ""
"      --base32hex       extended hex alphabet base32 (RFC4648 section 7)\n"
msgstr ""
"      --base32hex alfabeto esadecimale esteso base32 (RFC4648 sezione 7)\n"

#: src/basenc.c:131
msgid "      --base16          hex encoding (RFC4648 section 8)\n"
msgstr "      --codifica esadecimale base16 (RFC4648 sezione 8)\n"

#: src/basenc.c:134
msgid ""
"      --base2msbf       bit string with most significant bit (msb) first\n"
msgstr ""
"      --base2msbf stringa di bit con prima il bit più significativo (msb).\n"

#: src/basenc.c:137
msgid ""
"      --base2lsbf       bit string with least significant bit (lsb) first\n"
msgstr ""
"      --base2lsbf stringa di bit con prima il bit meno significativo (lsb).\n"

#: src/basenc.c:140
msgid ""
"  -d, --decode          decode data\n"
"  -i, --ignore-garbage  when decoding, ignore non-alphabet characters\n"
"  -w, --wrap=COLS       wrap encoded lines after COLS character (default "
"76).\n"
"                          Use 0 to disable line wrapping\n"
"\n"
msgstr ""
"  -d, --decode          decodifica i dati\n"
"  -i, --ignore-garbage  durante la decodifica ignora i caratteri non "
"alfabetici\n"
"  -w, --wrap=COL        manda a capo le righe codificate dopo COL caratteri "
"(predefinito 76).\n"
"                          Usare 0 per disabilitare l'andata a capo\n"
"\n"

#: src/basenc.c:148
msgid ""
"      --z85             ascii85-like encoding (ZeroMQ spec:32/Z85);\n"
"                        when encoding, input length must be a multiple of "
"4;\n"
"                        when decoding, input length must be a multiple of 5\n"
msgstr ""
"      --z85 codifica simile a ascii85 (specifica ZeroMQ: 32/Z85);\n"
"                         durante la codifica, la lunghezza dell'input deve "
"essere un multiplo di 4;\n"
"                         durante la decodifica, la lunghezza dell'input deve "
"essere un multiplo di 5\n"

#: src/basenc.c:157
msgid ""
"\n"
"When decoding, the input may contain newlines in addition to the bytes of\n"
"the formal alphabet.  Use --ignore-garbage to attempt to recover\n"
"from any other non-alphabet bytes in the encoded stream.\n"
msgstr ""
"\n"
"Durante la decodifica, l'input può contenere newline oltre ai byte di\n"
"l'alfabeto formale. Usa --ignore-garbage per tentare il ripristino\n"
"da qualsiasi altro byte non alfabetico nel flusso codificato.\n"

#: src/basenc.c:164
#, c-format
msgid ""
"\n"
"The data are encoded as described for the %s alphabet in RFC 4648.\n"
"When decoding, the input may contain newlines in addition to the bytes of\n"
"the formal %s alphabet.  Use --ignore-garbage to attempt to recover\n"
"from any other non-alphabet bytes in the encoded stream.\n"
msgstr ""
"\n"
"I dati sono codificati come descritto per l'alfabeto %s in RFC 4648.\n"
"Durante la decodifica, l'input può contenere newline oltre ai byte di\n"
"l'alfabeto formale %s. Usa --ignore-garbage per tentare il ripristino\n"
"da qualsiasi altro byte non alfabetico nel flusso codificato.\n"

#: src/basenc.c:618
msgid "invalid input (length must be multiple of 4 characters)"
msgstr "input non valido (la lunghezza deve essere multiplo di 4 caratteri)"

