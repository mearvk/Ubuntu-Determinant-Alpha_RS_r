#: src/sleep.c:44
#, c-format
msgid ""
"Usage: %s NUMBER[SUFFIX]...\n"
"  or:  %s OPTION\n"
"Pause for NUMBER seconds.  SUFFIX may be 's' for seconds (the default),\n"
"'m' for minutes, 'h' for hours or 'd' for days.  NUMBER need not be an\n"
"integer.  Given two or more arguments, pause for the amount of time\n"
"specified by the sum of their values.\n"
"\n"
msgstr ""
"Utilizzo: %s NUMBER[SUFFIX]...\n"
"  oppure: %s OPZIONE\n"
"Pausa per NUMBER secondi. SUFFIX può essere 's' per secondi (l'impostazione "
"predefinita),\n"
"'m' per minuti, 'h' per ore o 'd' per giorni. NUMERO non deve essere un\n"
"numero intero. Dati due o più argomenti, fai una pausa per la quantità di "
"tempo\n"
"specificati dalla somma dei loro valori.\n"
"\n"

#: src/sleep.c:132 src/timeout.c:365
#, c-format
msgid "invalid time interval %s"
msgstr "intervallo di tempo non valido: %s"

#: src/sleep.c:143 src/tail.c:1314
