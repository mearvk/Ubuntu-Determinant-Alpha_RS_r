#: tools/appstreamcli.c:1312
msgid "Convert collection XML to YAML or vice versa."
msgstr "Converte la collezione XML in YAML o vice versa"

#. TRANSLATORS: `appstreamcli vercmp` command description.
#: tools/appstreamcli.c:1386
msgid "Compare two version numbers."
msgstr "Confronta due numeri di versione."

