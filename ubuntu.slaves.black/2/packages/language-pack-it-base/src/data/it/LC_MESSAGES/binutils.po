#, c-format
msgid "  [T]          - deprecated, use --thin instead\n"
msgstr "  [T] - deprecato, usa invece --thin\n"

#: ar.c:342
#, c-format
msgid "  [v]          - be verbose\n"
msgstr "  [v]          - Modo prolisso\n"

#: ar.c:343
#, c-format
