#, c-format
msgid ""
"Usage: %s [emulation options] [-]{dmpqrstx}[abcDfilMNoOPsSTuvV] [member-"
"name] [count] archive-file file...\n"
msgstr ""
"Utilizzo: %s [opzioni di emulazione] [-]{dmpqrstx}[abcDfilMNoOPsSTuvV] [nome-"
"membro] [conteggio] file di archivio...\n"

#: ar.c:303
#, c-format
msgid "       %s -M [<mri-script]\n"
msgstr "       %s -M [<script-mri]\n"

#: ar.c:304
#, c-format
msgid " commands:\n"
msgstr " comandi:\n"

#: ar.c:305
#, c-format
msgid "  d            - delete file(s) from the archive\n"
msgstr "  d            - Elimina i file dall'archivio\n"

#: ar.c:306
#, c-format
msgid "  m[ab]        - move file(s) in the archive\n"
msgstr "  m[ab]        - Sposta i file nell'archivio\n"

#: ar.c:307
#, c-format
msgid "  p            - print file(s) found in the archive\n"
msgstr "  p            - Stampa i file trovati nell'archivio\n"

#: ar.c:308
#, c-format
msgid "  q[f]         - quick append file(s) to the archive\n"
msgstr "  q[f]         - Aggiunge rapidamente i file all'archivio\n"

#: ar.c:309
#, c-format
msgid ""
"  r[ab][f][u]  - replace existing or insert new file(s) into the archive\n"
msgstr ""
"  r[ab][f][u]  - Sostituisce i file esistenti o ne aggiunge di nuovi dentro "
"all'archivio\n"

#: ar.c:310
#, c-format
msgid "  s            - act as ranlib\n"
msgstr "  s            - Agisce come ranlib\n"

#: ar.c:311
#, c-format
msgid "  t[O][v]      - display contents of the archive\n"
msgstr "  t[O][v] - visualizza il contenuto dell'archivio\n"

#: ar.c:312
#, c-format
msgid "  x[o]         - extract file(s) from the archive\n"
msgstr "  x[o]         - Estrae i file dall'archivio\n"

#: ar.c:313
#, c-format
msgid " command specific modifiers:\n"
msgstr " modificatori specifici del comando:\n"

#: ar.c:314
#, c-format
msgid "  [a]          - put file(s) after [member-name]\n"
msgstr "  [a]          - Posiziona i file dopo [nome-membro]\n"

#: ar.c:315
#, c-format
msgid "  [b]          - put file(s) before [member-name] (same as [i])\n"
msgstr ""
"  [b]          - Posiziona i file prima di [nome-membro] (come [i])\n"

#: ar.c:318
#, c-format
msgid "  [D]          - use zero for timestamps and uids/gids (default)\n"
msgstr "  [D] - usa zero per timestamp e uid/gid (predefinito)\n"

#: ar.c:320
#, c-format
msgid "  [U]          - use actual timestamps and uids/gids\n"
msgstr "  [U] - usa timestamp e uid/gid effettivi\n"

#: ar.c:325
#, c-format
msgid "  [D]          - use zero for timestamps and uids/gids\n"
msgstr "  [D]          - Usa zero per le marcature temporali e gli uid/gid\n"

#: ar.c:327
#, c-format
msgid "  [U]          - use actual timestamps and uids/gids (default)\n"
msgstr "  [U] - usa timestamp e uid/gid effettivi (predefinito)\n"

#: ar.c:330
#, c-format
msgid "  [N]          - use instance [count] of name\n"
msgstr "  [N]          - Usa la richiesta [numero] del nome\n"

#: ar.c:331
#, c-format
msgid "  [f]          - truncate inserted file names\n"
msgstr "  [f]          - Tronca i nomi dei file inseriti\n"

#: ar.c:332
#, c-format
msgid "  [P]          - use full path names when matching\n"
msgstr ""
"  [P]          - Usa i nomi di percorso completi quando ricerca "
"corrispondenze\n"

#: ar.c:333
#, c-format
msgid "  [o]          - preserve original dates\n"
msgstr "  [o]          - Mantiene le date originali\n"

#: ar.c:334
#, c-format
msgid "  [O]          - display offsets of files in the archive\n"
msgstr "  [O] - visualizza gli offset dei file nell'archivio\n"

#: ar.c:335
#, c-format
msgid ""
"  [u]          - only replace files that are newer than current archive "
"contents\n"
msgstr ""
"  [u]          - Sostituisce solo i file che sono più recenti di quelli "
"attualmente presenti nell'archivio\n"

#: ar.c:336
#, c-format
msgid " generic modifiers:\n"
msgstr " modificatori generici:\n"

#: ar.c:337
#, c-format
msgid "  [c]          - do not warn if the library had to be created\n"
msgstr "  [c]          - Non avverte in caso di creazione della libreria\n"

#: ar.c:338
#, c-format
msgid "  [s]          - create an archive index (cf. ranlib)\n"
msgstr "  [s]          - Crea un indice di archivio (cfr. ranlib)\n"

#: ar.c:339
#, c-format
msgid "  [l <text> ]  - specify the dependencies of this library\n"
msgstr "  [l <testo> ] - specifica le dipendenze di questa libreria\n"

#: ar.c:340
#, c-format
msgid "  [S]          - do not build a symbol table\n"
msgstr "  [S]          - Non crea una tabella dei simboli\n"

