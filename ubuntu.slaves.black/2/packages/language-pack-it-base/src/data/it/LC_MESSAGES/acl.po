#: tools/chacl.c:146
#, c-format
msgid "%s: error removing access acl on \"%s\": %s\n"
msgstr "%s: errore nel rimuovere acl di accesso su \"%s\": %s\n"

# Da http://www.suse.de/~agruen/acl/linux-acls/online/
#
# A second type called default ACL is also defined. They define the permissions a file system object inherits from its parent directory at the time of its creation. Only directories can be associated with default ACLs. Default ACLs for non-directories would be of no use, because no other file system objects can be created inside non-directories. Default ACLs play no direct role in access checks.
#
# "ACL predefinita" mi pare una buona traduzione -Luca
#: tools/chacl.c:153
#, c-format
msgid "%s: error removing default acl on \"%s\": %s\n"
msgstr "%s: errore nel rimuovere acl predefinita su \"%s\": %s\n"

