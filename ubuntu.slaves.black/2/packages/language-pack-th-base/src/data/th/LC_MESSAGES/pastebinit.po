#: ../pastebinit:126
msgid "%s: no section [pastebin]"
msgstr "%s: ไม่มีส่วน [pastebin]"

#: ../pastebinit:131
msgid "%s: no 'basename' in [pastebin]"
msgstr "%s: ไม่มี 'basename' ใน [pastebin]"

#: ../pastebinit:139
#, docstring
msgid "Return the parameters array for the selected pastebin"
msgstr "ส่งกลับอาร์เรย์พารามิเตอร์สำหรับ pastebin ที่เลือก"

#: ../pastebinit:154
msgid ""
"Unknown website, please post a bugreport to request this pastebin to be "
"added (%s)"
msgstr ""
"ไม่ทราบเว็บไซต์ โปรดโพสต์รายงานบั๊กเพื่อขอให้มีการเพิ่ม pastebin นี้ (%s)"

#: ../pastebinit:204
msgid "Reads on stdin for input or takes a list of filenames as parameters"
msgstr "อ่านบน stdin เพื่อป้อนเข้าหรือดึงชื่อไฟล์มาเป็นพารามิเตอร์"

#: ../pastebinit:206
msgid "Optional arguments (not supported by all pastebins):"
msgstr "อาร์กิวเมนต์ที่เลือกได้ (ไม่รองรับโดย pastebin ทั้งหมด):"

#: ../pastebinit:208
msgid "\t-a <author:default is '%s'>"
msgstr "\t-a <ผู้สร้าง:ค่าเริ่มต้นคือ '%s'>"

#: ../pastebinit:209
msgid "\t-b <pastebin url:default is '%s'>"
msgstr "\t-b <url ของ pastebin:ค่าเริ่มต้นคือ '%s'>"

#: ../pastebinit:210
msgid "\t-f <format of paste:default is '%s'>"
msgstr "\t-f <รูปแบบการวาง:ค่าเริ่มต้นคือ '%s'>"

#: ../pastebinit:211
msgid "\t-h This help screen"
msgstr "\t-h หน้าจอวิธีใช้นี้"

#: ../pastebinit:197
msgid "\t-i <input file>"
msgstr "\t-i <ไฟล์ที่ป้อนเข้า>"

#: ../pastebinit:198
msgid "\t-l List all supported pastebins"
msgstr "\t-l รายการ pastebin ที่รองรับทั้งหมด"

#: ../pastebinit:214
msgid "\t-j <jabberid for notifications:default is '%s'>"
msgstr "\t-j <jabberid สำหรับการแจ้งเตือน:ค่าเริ่มต้นคือ '%s'>"

#: ../pastebinit:216
msgid "\t-m <permatag for all versions of a post:default is blank>"
msgstr "\t-m <permatag สำหรับเวอร์ชันทั้งหมดของโพสต์:ค่าเริ่มต้นคือว่าง>"

#: ../pastebinit:218
msgid "\t-r <parent posts ID:defaults to none>"
msgstr "\t-r <ID โพสต์แม่:ค่าเริ่มต้นคือไม่มี>"

#: ../pastebinit:219
msgid "\t-t <title of paste:default is blank>"
msgstr "\t-t <ชื่อเรื่องของการวาง:ค่าเริ่มต้นคือว่าง>"

#: ../pastebinit:216
msgid "\t-u <username> -p <password>"
msgstr "\t-u <ชื่อผู้ใช้> -p <รหัสผ่าน>"

#: ../pastebinit:201
msgid "\t-v Print the version number"
msgstr "\t-v แสดงหมายเลขเวอร์ชัน"

#: ../pastebinit:254 ../pastebinit:277 ../pastebinit:291 ../pastebinit:362
#: ../pastebinit:464 ../pastebinit:473
msgid "KeyboardInterrupt caught."
msgstr "พบการขัดจังหวะแป้นพิมพ์"

#: ../pastebinit:280
msgid "Error parsing configuration file!"
msgstr "เกิดข้อผิดพลาดในการแจงไฟล์การกำหนดค่า!"

#: ../pastebinit:281
msgid ""
"Please ensure that your configuration file looks similar to the following:"
msgstr "โปรดตรวจสอบให้แน่ใจว่าไฟล์การกำหนดค่าของคุณคล้ายกับต่อไปนี้:"

#: ../pastebinit:288
msgid "Invalid arguments!\n"
msgstr "อาร์กิวเมนต์ไม่ถูกต้อง!\n"

#: ../pastebinit:310
msgid "Supported pastebins:"
msgstr "pastebin ที่รองรับ:"

#: ../pastebinit:365
msgid "Unable to read from: %s"
msgstr "ไม่สามารถอ่านจาก: %s"

#: ../pastebinit:369
msgid "You are trying to send an empty document, exiting."
msgstr "คุณกำลังพยายามที่จะส่งเอกสารเปล่า กำลังออก"

#: ../pastebinit:414
msgid "The content you are trying to send exceeds the pastebin's size limit."
msgstr "เนื้อหาที่คุณกำลังพยายามส่งมีขนาดเกินขนาดจำกัดของ pastebin"

#: ../pastebinit:403
msgid "Could not find any json library."
msgstr "ไม่พบไลบรารี JSON ใดๆ"

#: ../pastebinit:438
msgid "Failed to contact the server: %s"
msgstr "ไม่สามารถติดต่อเซิร์ฟเวอร์: %s"

#: ../pastebinit:467
msgid ""
"Unable to read or parse the result page, it could be a server timeout or a "
"change server side, try with another pastebin."
msgstr ""
"ไม่สามารถอ่านหรือแจงหน้าผลลัพธ์ได้ "
"อาจเป็นเพราะเซิร์ฟเวอร์หมดเวลาหรือมีการเปลี่ยนฝั่งเซิร์ฟเวอร์ โปรดลองกับ "
"pastebin อื่น"
