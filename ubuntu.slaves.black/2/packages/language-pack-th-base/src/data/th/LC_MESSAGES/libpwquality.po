#: src/pam_pwquality.c:244
#, c-format
msgid "BAD PASSWORD: %s"
msgstr "รหัสผ่านไม่ถูกต้อง: %s"

#: src/pwscore.c:22
#, c-format
msgid "Usage: %s [user]\n"
msgstr "วิธีใช้: %s [user]\n"

#: src/pwscore.c:23
#, c-format
msgid ""
"       The command reads the password to be scored from the standard input.\n"
msgstr "       คำสั่งนี้อ่านรหัสผ่านที่จะให้คะแนนจากอินพุตมาตรฐาน\n"

#: src/pwscore.c:53 src/pwscore.c:61 src/pwscore.c:67
#, c-format
msgid "Error: %s\n"
msgstr "ข้อผิดพลาด: %s\n"

#: src/pwscore.c:53
msgid "Could not obtain the password to be scored"
msgstr "ไม่สามารถรับรหัสผ่านที่จะให้คะแนนได้"

#: src/pwscore.c:75
#, c-format
msgid ""
"Password quality check failed:\n"
" %s\n"
msgstr ""
"การตรวจสอบคุณภาพรหัสผ่านล้มเหลว:\n"
" %s\n"

#: src/pwmake.c:23
#, c-format
msgid "Usage: %s <entropy-bits>\n"
msgstr "วิธีใช้: %s <entropy-bits>\n"

#: src/pwmake.c:58
#, c-format
msgid ""
"Warning: Value %ld is outside of the allowed entropy range, adjusting it.\n"
msgstr "คำเตือน: ค่า %ld อยู่นอกช่วงเอนโทรปีที่อนุญาต กำลังปรับค่าใหม่\n"

#: src/error.c:31
msgid "Memory allocation error when setting"
msgstr "เกิดข้อผิดพลาดในการจัดสรรหน่วยความจำขณะตั้งค่า"

#: src/error.c:35
msgid "Memory allocation error"
msgstr "เกิดข้อผิดพลาดในการจัดสรรหน่วยความจำ"

#: src/error.c:37
msgid "The password is the same as the old one"
msgstr "รหัสผ่านนี้เหมือนกับรหัสผ่านเดิม"

#: src/error.c:39
msgid "The password is a palindrome"
msgstr "รหัสผ่านนี้เป็นพาลินโดรม"

#: src/error.c:41
msgid "The password differs with case changes only"
msgstr "รหัสผ่านนี้ต่างกันเพียงการเปลี่ยนตัวพิมพ์ใหญ่/เล็กเท่านั้น"

#: src/error.c:43
msgid "The password is too similar to the old one"
msgstr "รหัสผ่านนี้คล้ายกับรหัสผ่านเดิมเกินไป"

#: src/error.c:45
msgid "The password contains the user name in some form"
msgstr "รหัสผ่านนี้มีชื่อผู้ใช้ในบางรูปแบบ"

#: src/error.c:47
msgid ""
"The password contains words from the real name of the user in some form"
msgstr "รหัสผ่านนี้มีคำที่มาจากชื่อจริงของผู้ใช้ในบางรูปแบบ"

#: src/error.c:49
msgid "The password contains forbidden words in some form"
msgstr "รหัสผ่านนี้มีคำต้องห้ามในบางรูปแบบ"

#: src/error.c:52
#, c-format
msgid "The password contains less than %ld digits"
msgstr "รหัสผ่านนี้มีตัวเลขน้อยกว่า %ld ตัว"

#: src/error.c:55
msgid "The password contains too few digits"
msgstr "รหัสผ่านนี้มีตัวเลขน้อยเกินไป"

#: src/error.c:58
#, c-format
msgid "The password contains less than %ld uppercase letters"
msgstr "รหัสผ่านนี้มีตัวอักษรพิมพ์ใหญ่น้อยกว่า %ld ตัว"

#: src/error.c:61
msgid "The password contains too few uppercase letters"
msgstr "รหัสผ่านนี้มีตัวอักษรพิมพ์ใหญ่น้อยเกินไป"

#: src/error.c:64
#, c-format
msgid "The password contains less than %ld lowercase letters"
msgstr "รหัสผ่านนี้มีตัวอักษรพิมพ์เล็กน้อยกว่า %ld ตัว"

#: src/error.c:67
msgid "The password contains too few lowercase letters"
msgstr "รหัสผ่านนี้มีตัวอักษรพิมพ์เล็กน้อยเกินไป"

#: src/error.c:70
#, c-format
msgid "The password contains less than %ld non-alphanumeric characters"
msgstr "รหัสผ่านนี้มีอักขระที่ไม่ใช่ทั้งตัวอักษรและตัวเลขน้อยกว่า %ld ตัว"

#: src/error.c:73
msgid "The password contains too few non-alphanumeric characters"
msgstr "รหัสผ่านนี้มีอักขระที่ไม่ใช่ทั้งตัวอักษรและตัวเลขน้อยเกินไป"

#: src/error.c:76
#, c-format
msgid "The password is shorter than %ld characters"
msgstr "รหัสผ่านนี้มีอักขระสั้นกว่า %ld ตัว"

#: src/error.c:79
msgid "The password is too short"
msgstr "รหัสผ่านนี้สั้นเกินไป"

#: src/error.c:81
msgid "The password is just rotated old one"
msgstr "รหัสผ่านนี้เป็นรหัสผ่านเก่าที่เคยเปลี่ยนมาก่อนแล้ว"

#: src/error.c:84
#, c-format
msgid "The password contains less than %ld character classes"
msgstr "รหัสผ่านนี้มีประเภทของอักขระน้อยกว่า %ld ประเภท"

#: src/error.c:87
msgid "The password does not contain enough character classes"
msgstr "รหัสผ่านนี้มีประเภทของอักขระไม่พอ"

#: src/error.c:90
#, c-format
msgid "The password contains more than %ld same characters consecutively"
msgstr "รหัสผ่านนี้มีอักขระที่เหมือนกันมากกว่า %ld ตัวอยู่ติดกัน"

#: src/error.c:93
msgid "The password contains too many same characters consecutively"
msgstr "รหัสผ่านนี้มีอักขระที่เหมือนกันอยู่ติดกันมากเกินไป"

#: src/error.c:96
#, c-format
msgid ""
"The password contains more than %ld characters of the same class "
"consecutively"
msgstr "รหัสผ่านนี้มีอักขระที่เป็นประเภทเดียวกันมากกว่า %ld ตัวอยู่ติดกัน"

#: src/error.c:99
msgid ""
"The password contains too many characters of the same class consecutively"
msgstr "รหัสผ่านนี้มีอักขระที่เป็นประเภทเดียวกันอยู่ติดกันมากเกินไป"

#: src/error.c:102
#, c-format
msgid "The password contains monotonic sequence longer than %ld characters"
msgstr "รหัสผ่านนี้มีลำดับทางเดียวที่มีอักขระยาวกว่า %ld ตัว"

#: src/error.c:105
msgid "The password contains too long of a monotonic character sequence"
msgstr "รหัสผ่านนี้มีลำดับอักขระทางเดียวยาวเกินไป"

#: src/error.c:107
msgid "No password supplied"
msgstr "ไม่ได้ป้อนรหัสผ่าน"

#: src/error.c:109
msgid "Cannot obtain random numbers from the RNG device"
msgstr "ไม่สามารถรับข้อมูลของตัวเลขสุ่มจากอุปกรณ์ RNG"

#: src/error.c:111
msgid "Password generation failed - required entropy too low for settings"
msgstr ""
"การสร้างรหัสผ่านล้มเหลว - เอนโทรปีที่ต้องการต่ำเกินไปสำหรับการตั้งค่า"

#: src/error.c:114 src/error.c:117
msgid "The password fails the dictionary check"
msgstr "รหัสผ่านนี้ไม่ผ่านการตรวจสอบด้วยพจนานุกรม"

#: src/error.c:120 src/error.c:124
msgid "Unknown setting"
msgstr "ไม่รู้จักการตั้งค่า"

#: src/error.c:127
msgid "Bad integer value of setting"
msgstr "ค่าจำนวนเต็มของการตั้งค่าไม่ถูกต้อง"

#: src/error.c:131
msgid "Bad integer value"
msgstr "ค่าจำนวนเต็มไม่ถูกต้อง"

#: src/error.c:134
#, c-format
msgid "Setting %s is not of integer type"
msgstr "การตั้งค่า %s ไม่เป็นชนิดจำนวนเต็ม"

#: src/error.c:138
msgid "Setting is not of integer type"
msgstr "การตั้งค่าไม่เป็นชนิดจำนวนเต็ม"

#: src/error.c:141
#, c-format
msgid "Setting %s is not of string type"
msgstr "การตั้งค่า %s ไม่เป็นชนิดสตริง"

#: src/error.c:145
msgid "Setting is not of string type"
msgstr "การตั้งค่าไม่เป็นชนิดสตริง"

#: src/error.c:147
msgid "Opening the configuration file failed"
msgstr "การเปิดแฟ้มกำหนดค่าล้มเหลว"

#: src/error.c:149
msgid "The configuration file is malformed"
msgstr "แฟ้มกำหนดค่าผิดรูปแบบ"

#: src/error.c:151
msgid "Fatal failure"
msgstr "เกิดความล้มเหลวร้ายแรง"

#: src/error.c:153
msgid "Unknown error"
msgstr "เกิดข้อผิดพลาดที่ไม่ทราบสาเหตุ"
