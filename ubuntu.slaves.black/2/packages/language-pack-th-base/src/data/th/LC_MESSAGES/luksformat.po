#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "จำเป็นต้องเริ่มโปรแกรมนี้ด้วยสิทธิ์ราก\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - สร้างและฟอร์แมตอุปกรณ์ LUKS ที่ถูกเข้ารหัส\n"
"วิธีใช้: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "ข้อผิดพลาด: อุปกรณ์ถูกต่อเชื่อมแล้ว: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "ข้อผิดพลาด: ระบบไฟล์ไม่ถูกต้อง: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "ข้อผิดพลาด: ไม่สามารถสร้างชื่ออุปกรณ์ที่ถูกแมปชั่วคราว"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "กำลังสร้างอุปกรณ์ที่ถูกเข้ารหัสบน %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "ไม่สามารถสร้างอุปกรณ์ LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "โปรดป้อนวลีรหัสผ่านของคุณอีกครั้งเพื่อยืนยัน\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "วลีรหัสผ่านที่คุณป้อนไม่ตรงกัน\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "ไม่สามารถฟอร์แมตอุปกรณ์ที่มีระบบไฟล์ %s"
