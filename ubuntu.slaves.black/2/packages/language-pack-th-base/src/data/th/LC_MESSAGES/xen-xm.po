#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "ข้อผิดพลาดภายใน: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "แมปนี้มี %(1)s -> %(2)s อยู่แล้ว"

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "ไม่รองรับวิธี %(1)s"

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "วิธี %(1)s ใช้ %(2)s อาร์กิวเมนต์ (%(3)s ถูกระบุไว้)"

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "ไม่ได้รับอนุญาต"

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"ค่า \"%(2)s\" สำหรับ %(1)s ไม่รองรับโดยเซิร์ฟเวอร์นี้ เซิร์ฟเวอร์บอกว่า "
"\"%(3)s\""

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "%(1)s จัดการ %(2)s ไม่ถูกต้อง"

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "คุณพยายามดำเนินการที่ไม่ได้รับอนุญาต"

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"เครือข่ายที่คุณระบุมี PIF แนบมาอยู่แล้ว และอาจไม่แนบไปกับเครือข่ายอื่นอีก"

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
