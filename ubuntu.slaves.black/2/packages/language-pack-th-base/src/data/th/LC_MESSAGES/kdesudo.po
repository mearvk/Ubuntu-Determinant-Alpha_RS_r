#: kdesudo/main.cpp:66 kdesudo/main.cpp:85
msgid "The command to execute"
msgstr "คำสั่งที่จะเรียกใช้"

#: kdesudo/main.cpp:67
msgid "Forget passwords"
msgstr "ลืมรหัสผ่าน"

#: kdesudo/main.cpp:68
msgid "Specify icon to use in the password dialog"
msgstr "ระบุไอคอนที่จะใช้ในกล่องรหัสผ่าน"

#: kdesudo/main.cpp:70
msgid "Do not show the command to be run in the dialog"
msgstr "ไม่ต้องแสดงคำสั่งที่จะใช้ประมวลผลในกล่อง"

#: kdesudo/main.cpp:71
msgid "Process priority, between 0 and 100, 0 the lowest [50]"
msgstr "ความสำคัญของโปรเซส ระหว่าง 0 ถึง 100 0 คือค่าต่ำสุด [0]"

#: kdesudo/main.cpp:73
msgid "Use realtime scheduling"
msgstr "ใช้ลำดับการทำงานแบบตามเวลาจริง"

#: kdesudo/main.cpp:74
msgid "Use target UID if <file> is not writeable"
msgstr "ใช้ UID ปลายทางเมื่อ <file> ไม่สามารถเขียนได้"

#: kdesudo/main.cpp:75
msgid "Fake option for KDE's KdeSu compatibility"
msgstr "ปลอมแปลงตัวเลือกสำหรับความเข้ากันได้ KdeSu ของ KDE"

#: kdesudo/main.cpp:76
msgid "Do not keep password"
msgstr "ไม่ต้องจดจำรหัสผ่าน"

#: kdesudo/main.cpp:77
msgid "Use existing DCOP server"
msgstr "ใช้เซิร์ฟเวอร์ DCOP ที่มีอยู่แล้ว"

#: kdesudo/main.cpp:78
msgid "The comment that should be displayed in the dialog"
msgstr "หมายเหตุประกอบที่ควรจะแสดงในกล่องโต้ตอบ"

#: kdesudo/main.cpp:80
msgid "Do not display « ignore » button"
msgstr "ไม่ต้องแสดงปุ่ม « เพิกเฉย »"

#: kdesudo/main.cpp:81
msgid "Makes the dialog transient for an X app specified by winid"
msgstr ""
"สร้างกล่องโต้ตอบชั่วคราวให้กับโปรแกรมของ X ที่ระบุด้วยหมายเลขหน้าต่าง (winid)"

#: kdesudo/main.cpp:82
msgid "Manual override for automatic desktop file detection"
msgstr "การแทนที่ด้วยตนเองสำหรับการตรวจหาแฟ้มเดสก์ท็อปอัตโนมัติ"
