#: ../libs/net/grl-net-mock.c:86
msgid "No mock definition found"
msgstr "ไม่พบนิยามจำลอง"

#: ../libs/net/grl-net-mock.c:98
#, c-format
msgid "Could not find mock content %s"
msgstr "ไม่พบเนื้อหาจำลอง %s"

#: ../libs/net/grl-net-mock.c:116
#, c-format
msgid "Could not access mock content: %s"
msgstr "ไม่สามารถเข้าถึงเนื้อหาจำลอง: %s"

#: ../libs/net/grl-net-wc.c:450
msgid "Cannot connect to the server"
msgstr "ไม่สามารถเชื่อมต่อไปยังเซิร์ฟเวอร์"

#: ../libs/net/grl-net-wc.c:456
msgid "Cannot connect to the proxy server"
msgstr "ไม่สามารถเชื่อมต่อไปยังเซิร์ฟเวอร์พร็อกซี"

#: ../libs/net/grl-net-wc.c:463
#, c-format
msgid "Invalid request URI or header: %s"
msgstr "URI คำขอหรือส่วนหัวไม่ถูกต้อง: %s"

#: ../libs/net/grl-net-wc.c:470
#, c-format
msgid "Authentication required: %s"
msgstr "ต้องยืนยันตัวบุคคล: %s"

#: ../libs/net/grl-net-wc.c:475
#, c-format
msgid "The requested resource was not found: %s"
msgstr "ไม่พบทรัพยากรที่ร้องขอ: %s"

#: ../libs/net/grl-net-wc.c:482
#, c-format
msgid "The entry has been modified since it was downloaded: %s"
msgstr "ข้อมูลมีการเปลี่ยนแปลงหลังจากที่ดาวน์โหลดมา: %s"

#: ../libs/net/grl-net-wc.c:488 ../libs/net/grl-net-wc.c:600
#: ../libs/pls/grl-pls.c:490 ../src/grl-source.c:1828 ../src/grl-source.c:1928
#: ../src/grl-source.c:2075 ../src/grl-source.c:2332 ../src/grl-source.c:2453
#, c-format
msgid "Operation was cancelled"
msgstr "ปฏิบัติการถูกยกเลิก"

#: ../libs/net/grl-net-wc.c:604 ../libs/net/grl-net-wc.c:648
msgid "Data not available"
msgstr "ข้อมูลไม่พร้อมใช้"

#: ../libs/net/grl-net-wc.c:699
#, c-format
msgid "Invalid URL %s"
msgstr "URL ไม่ถูกต้อง %s"

#: ../src/grilo.c:218
msgid "Semicolon-separated paths containing Grilo plugins"
msgstr "พาธที่คั่นด้วยอัฒภาคซึ่งมีปลั๊กอิน Grilo"

#: ../src/grilo.c:220
msgid "Colon-separated paths containing Grilo plugins"
msgstr "พาธที่คั่นด้วยทวิภาคซึ่งมีปลั๊กอิน Grilo"

#: ../src/grilo.c:223
msgid "Colon-separated list of Grilo plugins to use"
msgstr "รายชื่อปลั๊กอิน Grilo ที่คั่นด้วยทวิภาคที่จะใช้"

#: ../src/grilo.c:228
msgid "Grilo Options"
msgstr "ตัวเลือกของ Grilo"

#: ../src/grilo.c:229
msgid "Show Grilo Options"
msgstr "แสดงตัวเลือกของ Grilo"

#: ../src/grl-multiple.c:134
#, c-format
msgid "No searchable sources available"
msgstr "ไม่มีแหล่งข้อมูลที่ค้นหาได้พร้อมใช้งาน"

#: ../src/grl-multiple.c:511
#, c-format
msgid "Could not resolve media for URI “%s”"
msgstr "ไม่สามารถแปลงที่อยู่สื่อสำหรับ URI “%s” ได้"

#: ../src/grl-registry.c:457 ../src/grl-registry.c:1438
#, c-format
msgid "Plugin “%s” is already loaded"
msgstr "ปลั๊กอิน “%s” ถูกโหลดไปแล้ว"

#: ../src/grl-registry.c:488
#, c-format
msgid "Failed to initialize plugin from %s"
msgstr "ไม่สามารถตั้งต้นปลั๊กอินจาก %s"

#: ../src/grl-registry.c:523
#, c-format
msgid "Metadata key “%s” already registered in different format"
msgstr "คีย์ข้อมูลกำกับ “%s” ถูกลงทะเบียนไปแล้วในรูปแบบอื่น"

#: ../src/grl-registry.c:536
#, c-format
msgid "Metadata key “%s” cannot be registered"
msgstr "ไม่สามารถลงทะเบียนคีย์ข้อมูลกำกับ “%s” ได้"

#: ../src/grl-registry.c:1044
#, c-format
msgid "Source with id “%s” was not found"
msgstr "ไม่พบแหล่งข้อมูลรหัส “%s”"

#: ../src/grl-registry.c:1057
#, c-format
msgid "Failed to load plugin from %s"
msgstr "ไม่สามารถโหลดปลั๊กอินจาก %s ได้"

#: ../src/grl-registry.c:1066
#, c-format
msgid "Invalid plugin file %s"
msgstr "แฟ้มปลั๊กอิน %s ไม่ถูกต้อง"

#: ../src/grl-registry.c:1138
#, c-format
msgid "“%s” is not a valid plugin file"
msgstr "“%s” ไม่ใช่แฟ้มปลั๊กอินที่ถูกต้อง"

#: ../src/grl-registry.c:1157
#, c-format
msgid "Plugin “%s” already exists"
msgstr "มีปลั๊กอิน “%s” อยู่แล้ว"

#: ../src/grl-registry.c:1259
#, c-format
msgid "Invalid path %s"
msgstr "พาธ %s ไม่ถูกต้อง"

#: ../src/grl-registry.c:1326
#, c-format
msgid "All configured plugin paths are invalid"
msgstr "พาธของปลั๊กอินที่กำหนดค่าแล้วทั้งหมดใช้ไม่ได้"

#: ../src/grl-registry.c:1427
#, c-format
msgid "Plugin “%s” not available"
msgstr "ปลั๊กอิน “%s” ไม่สามารถใช้ได้"

#: ../src/grl-registry.c:1655
#, c-format
msgid "Plugin not found: “%s”"
msgstr "ไม่พบปลั๊กอิน: “%s”"

#: ../src/grl-registry.c:1966
#, c-format
msgid "Plugin configuration does not contain “plugin-id” reference"
msgstr "การกำหนดค่าปลั๊กอินไม่มีส่วนอ้างอิง “plugin-id”"

#: ../src/grl-source.c:2782
#, c-format
msgid "Some keys could not be written"
msgstr "ไม่สามารถเขียนกุญแจบางอันได้"

#: ../src/grl-source.c:2855
#, c-format
msgid "None of the specified keys are writable"
msgstr "ไม่มีกุญแจใดในกุญแจที่ระบุที่สามารถเขียนได้"

#: ../src/grl-source.c:4191
#, c-format
msgid "Media has no “id”, cannot remove"
msgstr "สื่อไม่มี “id” และไม่สามารถลบออกได้"
