#: ../src/crash.c:46 ../src/system-crash.c:20
msgid "System program problem detected"
msgstr "Aptikta sisteminės programos klaida"

#: ../src/crash.c:47 ../src/system-crash.c:21
msgid "Do you want to report the problem now?"
msgstr "Ar norite pranešti apie problemą dabar?"

#: ../src/crash.c:57 ../src/system-crash.c:31
msgid "Report problem…"
msgstr "Pranešti apie problemą..."

#: ../src/crash.c:99 ../src/crash.c:206
msgid "Crash report detected"
msgstr "Aptiktas strigties pranešimas"

#: ../src/crash.c:100
msgid ""
"An application has crashed on your system (now or in the past). Click on the "
"notification icon to display details. "
msgstr ""
"Jūsų sistemoje užstrigo programa (dabar arba anksčiau). Kad pamatytumėte "
"išsamią informaciją, spustelėkite pranešimo piktogramą. "

#: ../src/cdroms.c:48
msgid "Software Packages Volume Detected"
msgstr "Aptiktas programinės įrangos paketų tomas"

#: ../src/cdroms.c:49
msgid ""
"<span weight=\"bold\" size=\"larger\">A volume with software packages has "
"been detected.</span>\n"
"\n"
"Would you like to open it with the package manager?"
msgstr ""
"<span weight=\"bold\" size=\"larger\">Atrastas programinės įrangos paketų "
"tomas.</span>\n"
"\n"
"Ar norėtumėte atverti jų, naudojant paketų tvarkytuvę?"

#: ../src/cdroms.c:57
msgid "Start Package Manager"
msgstr "Paleisti paketų tvarkytuvę"

#: ../src/cdroms.c:63
msgid "Upgrade volume detected"
msgstr "Rastas atnaujinimų tomas"

#: ../src/cdroms.c:64
msgid ""
"<span weight=\"bold\" size=\"larger\">A distribution volume with software "
"packages has been detected.</span>\n"
"\n"
"Would you like to try to upgrade from it automatically? "
msgstr ""
"<span weight=\"bold\" size=\"larger\">Aptikta laikmena su programinės "
"įrangos paketais operacinei sistemai.</span>\n"
"\n"
"Ar norėtumėte atnaujinti automatiškai naudodami šią laikmeną? "

#: ../src/cdroms.c:71
msgid "Run upgrade"
msgstr "Pradėti atnaujinimą"

#: ../src/cdroms.c:79
msgid "APTonCD volume detected"
msgstr "Aptikta APTonCD tomas"

#: ../src/cdroms.c:80
msgid ""
"<span weight=\"bold\" size=\"larger\">A volume with unofficial software "
"packages has been detected.</span>\n"
"\n"
"Would you like to open it with the package manager?"
msgstr ""
"<span weight=\"bold\" size=\"larger\">Rastas tomas su neoficialia programine "
"įranga.</span>\n"
"\n"
"Ar norėtumėte jį atverti, naudojant paketų tvarkytuvę?"

