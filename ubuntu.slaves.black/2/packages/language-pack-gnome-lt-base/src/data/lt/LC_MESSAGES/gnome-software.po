#. TRANSLATORS: only able to install files as root
#: gs-install-appstream/gs-install-appstream.c:201
msgid "This program can only be used by the root user"
msgstr "Šią programą gali naudoti tik root naudotojas"

#. TRANSLATORS: error details
#: gs-install-appstream/gs-install-appstream.c:209
#, c-format
msgid "Failed to validate content type: %s"
msgstr "Nepavyko patikrinti turinio tipo: %s"

#. TRANSLATORS: error details
#: gs-install-appstream/gs-install-appstream.c:178
#, c-format
msgid "Failed to copy: %s"
msgstr "Nepavyko nukopijuoti: %s"

