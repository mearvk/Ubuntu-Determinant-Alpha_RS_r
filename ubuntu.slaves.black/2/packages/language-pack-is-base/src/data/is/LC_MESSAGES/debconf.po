msgstr "Athugið: Debconf keyrir í vefham. Farið á http://localhost:%i/"

#: ../Debconf/FrontEnd/Web.pm:166
msgid "Back"
msgstr "Til baka"

#: ../Debconf/FrontEnd/Web.pm:168
msgid "Next"
msgstr "Áfram"

#: ../Debconf/Template.pm:96
#, perl-format
msgid ""
"warning: possible database corruption. Will attempt to repair by adding back "
"missing question %s."
msgstr ""
"aðvörun: hugsanlega skemmdur gagnagrunnur. Reyni að gera við með því að bæta "
"við spurningu sem vantar: %s."

#: ../Debconf/Template.pm:211
#, perl-format
msgid ""
"Template #%s in %s has a duplicate field \"%s\" with new value \"%s\". "
"Probably two templates are not properly separated by a lone newline.\n"
msgstr ""
"Snið #%s í %s er með tvífalt svið „%s“ með nýju gildi „%s“. Sennilega eru "
"tvö snið sem eru ekki aðskilin á réttan hátt með einni nýlínu.\n"

#: ../Debconf/Template.pm:236
#, perl-format
msgid "Unknown template field '%s', in stanza #%s of %s\n"
msgstr "Óþekkt sniðmátssvið ‚%s‘, í versi #%s af %s\n"

#: ../Debconf/Template.pm:262
#, perl-format
msgid "Template parse error near `%s', in stanza #%s of %s\n"
msgstr "Sniðþáttunarvilla nærri ‚%s‘, í versi #%s af %s\n"

#: ../Debconf/Template.pm:268
#, perl-format
msgid "Template #%s in %s does not contain a 'Template:' line\n"
msgstr "Snið #%s í %s inniheldur ekki ‚Snið‘ línu\n"

