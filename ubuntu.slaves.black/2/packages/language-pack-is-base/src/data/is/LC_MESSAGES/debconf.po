msgstr "%s er óskýr við bæti %s: %s; sleppi því"

#: ../debconf-mergetemplate:168
#, perl-format
msgid "%s is outdated"
msgstr "%s er úrelt"

#: ../debconf-mergetemplate:173
#, perl-format
msgid "%s is outdated; dropping whole template!"
msgstr "%s er úrelt; sleppi öllu sniðinu!"

