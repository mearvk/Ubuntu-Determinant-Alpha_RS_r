Patch to add missing $(LDFLAGS) to Makefile
Added by Luis Uribe <acme@eviled.org>  Thu, 16 Aug 2012 21:12:59 -0500
--- a/Makefile.in
+++ b/Makefile.in
@@ -272,7 +272,7 @@
 
 libmxml.so.1.6:	$(LIBOBJS)
 	echo Creating $@...
-	$(DSO) $(DSOFLAGS) $(LDFLAGS) -o libmxml.so.1.6 $(LIBOBJS) $(LIBS)
+	$(DSO) $(DSOFLAGS) $(LDFLAGS) -o libmxml.so.1.6 $(LIBOBJS) $(LIBS) $(LDFLAGS)
 	$(RM) libmxml.so libmxml.so.1
 	$(LN) libmxml.so.1.6 libmxml.so
 	$(LN) libmxml.so.1.6 libmxml.so.1
