#: data/org.freedesktop.Tracker.DB.gschema.xml:24
msgid "Maximum size of journal"
msgstr "Maksimum grootte van joernaal"

#: data/org.freedesktop.Tracker.DB.gschema.xml:25
msgid "Size of the journal at rotation in MB. Use -1 to disable rotating."
msgstr ""
"Grootte van die joernaal by rotasie in MB. Gebruik -1 om rotasie uit te "
"skakel."

#: data/org.freedesktop.Tracker.DB.gschema.xml:29
msgid "Location of journal pieces"
msgstr "Ligging van joernaal stukke"

#: data/org.freedesktop.Tracker.DB.gschema.xml:30
msgid "Where to store a journal chunk when it hits the max size."
msgstr ""
"Waar om 'n joernaal chunk te stoor as dit wanneer die maksimum grootte tref"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:26
msgid "Maximum length of a word to be indexed"
msgstr "Maksimum lengte van 'n woord wat om wees geïndekseer"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:27
msgid ""
"Words with more characters than this length will be ignored by the indexer."
msgstr ""
"Woorde met meer karakters as hierdie lengte sal deur die indekseerder "
"geïgnoreer word."

#: data/org.freedesktop.Tracker.FTS.gschema.xml:32
msgid "Maximum number of words to index in a document"
msgstr "Maksimum aantal woorde wat u in 'n dokument moet indekseer"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:33
msgid ""
"Indexer will read only this maximum number of words from a single document."
msgstr ""
"Indexer sal slegs hierdie maksimum aantal woorde uit 'n enkele dokument lees."

#: data/org.freedesktop.Tracker.FTS.gschema.xml:37
msgid "Enable stemmer"
msgstr "In staat te stel stemmer"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:38
msgid ""
"Simplify the words to their root to provide more results. E.g. “shelves” and "
"“shelf” to “shel”"
msgstr ""
"Vereenvoudig die woorde tot in hul wortel om meer resultate te lewer. Bv. "
"“shelves” en “shelf” om “shel”"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:43
msgid "Enable unaccent"
msgstr "In staat stel unaccent"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:44
msgid ""
"Translate accented characters to the equivalent unaccented. E.g. “Idéa” to "
"“Idea” for improved matching."
msgstr ""
"Vertaal geaksent karakters na die ekwivalent ongeaksentueerde. Bv. “Idéa” "
"tot “Idea” vir verbeterde bypassende."

#: data/org.freedesktop.Tracker.FTS.gschema.xml:49
msgid "Ignore numbers"
msgstr "ignoreer nommers"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:50
msgid "If enabled, numbers will not be indexed."
msgstr "Indien in staat gestel, nommers sal nie geïndekseer."

#: data/org.freedesktop.Tracker.FTS.gschema.xml:55
msgid "Ignore stop words"
msgstr "Ignoreer stop woorde"

#: data/org.freedesktop.Tracker.FTS.gschema.xml:56
msgid ""
"If enabled, the words listed in the stop-words list are ignored. E.g. common "
"words like “the”, “yes”, “no”, etc."
msgstr ""
"Indien in staat gestel, die woorde wat in die stop-woorde lys gelys word, "
"word geïgnoreer. Bv. algemene woorde soos “the”, “yes”, “no”, ens."

#: data/org.freedesktop.Tracker.Store.gschema.xml:24
msgid "Log verbosity"
msgstr "Log verbosity"

#: data/org.freedesktop.Tracker.Store.gschema.xml:25
msgid "Log verbosity."
msgstr "Log verbosity."

#: data/org.freedesktop.Tracker.Store.gschema.xml:29
msgid "GraphUpdated delay"
msgstr "GraphOpdateerde- vertraging"

#: data/org.freedesktop.Tracker.Store.gschema.xml:30
msgid ""
"Period in milliseconds between GraphUpdated signals being emitted when "
"indexed data has changed inside the database."
msgstr ""
"Tydperk in millisekondes tussen GraphOpdateerde seine wat uitgestraal word "
"wanneer geïndekseer data het verander in die databasis."

