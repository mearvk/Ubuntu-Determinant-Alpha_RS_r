#: data/org.gnome.Logs.appdata.xml.in:7 data/org.gnome.Logs.desktop.in:3
#: src/gl-application.c:107 src/gl-eventtoolbar.c:144
msgid "Logs"
msgstr "Logs"

#: data/org.gnome.Logs.appdata.xml.in:8 data/org.gnome.Logs.desktop.in:5
msgid "View detailed event logs for the system"
msgstr "Beskou gedetailleerde gebeurtenis logs vir die stelsel"

#: data/org.gnome.Logs.appdata.xml.in:10
msgid ""
"Logs shows events from the systemd journal, and sorts them into categories, "
"such as hardware and applications."
msgstr ""
"Logs wys gebeure uit die systemd joernaal, en sorteer hulle inte kategorieë, "
"soos hardeware en toepassings."

#: data/org.gnome.Logs.appdata.xml.in:12
msgid ""
"Using Logs you can search your logs by typing a search term, and view "
"detailed information about each event by clicking on it."
msgstr ""
"Gebruik van Logs jy kan soek jou logs deur tipe 'n soek termyn, en beskou "
"gedetailleerde inligting omtrent elke gebeurtenis deur klik op dit."

#: data/org.gnome.Logs.appdata.xml.in:38 src/gl-application.c:109
msgid "The GNOME Project"
msgstr "Die GNOME Projek"

#: data/org.gnome.Logs.desktop.in:4
msgid "Log Viewer"
msgstr "Log Beskouer"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.Logs.desktop.in:7
msgid "log;journal;debug;error;"
msgstr "log;joernaal;debug;fout;"

#: data/org.gnome.Logs.gschema.xml:5
msgid "Ignore warning"
msgstr "Ignoreer waarskuwing"

#: data/org.gnome.Logs.gschema.xml:6
msgid ""
"Whether to ignore the warning that says you don’t have sufficient permission "
"to view logs. If ignored, the warning won’t show up again."
msgstr ""
"Whether om ignoreer die waarskuwing dat sê jy hoef nie voldoende toestemming "
"om beskou logs. Indien geïgnoreer, die waarskuwing sal nie weer opdaag."

#: data/org.gnome.Logs.gschema.xml:10
msgid "How to sort list rows in the event view list"
msgstr "Hoe om lys-rye in die gebeurtenis beskou lys te sorteer"

#: data/org.gnome.Logs.gschema.xml:11
msgid "Sort list rows in ascending or descending order for the selected type"
msgstr "Sorteer lys rye in stygende of dalende orde vir die gekose tipe"

