#: Settings.ui.h:126
msgid "Only maximized windows"
msgstr "Slegs maksimum vensters"

#: Settings.ui.h:127
msgid "Always on top"
msgstr "Altyd op bopunt"

#: Settings.ui.h:128
msgid "Animation duration (s)"
msgstr "Animasie duration (s)"

#: Settings.ui.h:129
msgid "Show timeout (s)"
