#: data/org.gnome.mousetweaks.gschema.xml:5
msgid "Click-type window style"
msgstr "Klik-tipe venster styl"

#: data/org.gnome.mousetweaks.gschema.xml:6
msgid "Button style of the click-type window."
msgstr "Knoppie styl van die klik-tipe venster."

#: data/org.gnome.mousetweaks.gschema.xml:10
msgid "Click-type window orientation"
msgstr "Klik-tipe venster oriëntasie"

#: data/org.gnome.mousetweaks.gschema.xml:11
msgid "Orientation of the click-type window."
msgstr "Oriëntasie van die klik-tipe venster."

#: data/org.gnome.mousetweaks.gschema.xml:15 src/mt-main.c:638
msgid "Click-type window geometry"
msgstr "Klik-tipe venster meetkunde"

#: data/org.gnome.mousetweaks.gschema.xml:16
msgid ""
"Size and position of the click-type window. The format is a standard X "
"Window System geometry string."
msgstr ""
"Grootte en posisie van die klik-tipe venster. Die formaat is 'n standaard X "
"Venster Stelsel meetkunde toutjie."

#: src/mt-main.c:624
msgid "Enable dwell click"
msgstr "In staat stel dwell kliek"

#: src/mt-main.c:626
msgid "Enable simulated secondary click"
msgstr "In staat stel gesimuleerde sekondêre kliek"

#: src/mt-main.c:628
msgid "Time to wait before a dwell click"
msgstr "Tyd om te wag voordat 'n dwell kliek"

#: src/mt-main.c:630
msgid "Time to wait before a simulated secondary click"
msgstr "Tyd om te wag voordat 'n gesimuleerde sekondêre kliek"

#: src/mt-main.c:632
msgid "Set the active dwell mode"
msgstr "Stel die aktiewe dwell modus"

#: src/mt-main.c:634
msgid "Hide the click-type window"
msgstr "Versteek die klik-tipe venster"

#: src/mt-main.c:636
msgid "Ignore small pointer movements"
msgstr "Ignoreer klein wyser bewegings"

#: src/mt-main.c:640
msgid "Shut down mousetweaks"
msgstr "Skakel muis-tweaks af"

#: src/mt-main.c:642
msgid "Start mousetweaks as a daemon"
msgstr "Begin muis-tweaks as 'n deamon"

#: src/mt-main.c:644
msgid "Start mousetweaks in login mode"
msgstr "Begin mousetweaks in login af modus"

#: src/mt-main.c:662
msgid "- GNOME mouse accessibility daemon"
msgstr "- GNOME muis toeganklikheid daemon"

#: src/mt-main.c:814
msgid "Shutdown failed or nothing to shut down.\n"
msgstr "Afsluit versuim of niks om af te sluit.\n"

#: src/mt-main.c:816
msgid "Shutdown successful.\n"
msgstr "Afsluitaf suksesvolle.\n"

#: src/mt-main.c:824
#, c-format
msgid "Mousetweaks is already running. (PID %u)\n"
msgstr "Mousetweaks is reeds hardloop. (PID %u)\n"

#: src/mt-main.c:830
msgid "Starting daemon.\n"
msgstr "Begin daemon.\n"

