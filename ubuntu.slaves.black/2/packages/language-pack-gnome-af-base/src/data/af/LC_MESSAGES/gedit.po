#| msgid "_Cancel Logout"
msgid "_Cancel"
msgstr "_Kanselleer"

#: gedit/gedit-close-confirmation-dialog.c:295 gedit/resources/gtk/menus.ui:37
#: gedit/resources/gtk/menus-traditional.ui:33
#| msgid "Save As…"
msgid "_Save As…"
msgstr "_Stoor As…"

