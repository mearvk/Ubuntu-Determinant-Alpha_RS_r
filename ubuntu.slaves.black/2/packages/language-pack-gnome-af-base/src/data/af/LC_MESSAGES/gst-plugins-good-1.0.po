#: sys/v4l2/gstv4l2videodec.c:322
#, c-format
msgid "Decoder on device %s has no supported output format"
msgstr "Dekodeerder op toestel %s het geen ondersteunde uitvoer formaat nie"

#: sys/v4l2/gstv4l2videodec.c:1078
