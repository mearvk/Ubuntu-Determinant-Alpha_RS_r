#: ext/jack/gstjackaudiosink.c:359 ext/jack/gstjackaudiosrc.c:364
msgid "Jack server not found"
msgstr "Jack-bediener nie gevind nie"

#: ext/jpeg/gstjpegdec.c:983 ext/jpeg/gstjpegdec.c:1255
#: ext/jpeg/gstjpegdec.c:1264 ext/jpeg/gstjpegdec.c:1274
#: ext/jpeg/gstjpegdec.c:1283 ext/jpeg/gstjpegdec.c:1567
#: ext/jpeg/gstjpegdec.c:1595
msgid "Failed to decode JPEG image"
msgstr "Mislukte JPEG beeld dekodeer"

#: ext/jpeg/gstjpegdec.c:1555
msgid "Failed to read memory"
msgstr "Mislukte om lees geheue"

#: ext/lame/gstlamemp3enc.c:407
msgid ""
"Failed to configure LAME mp3 audio encoder. Check your encoding parameters."
msgstr ""
"Mislukte om konfigurasie LAME mp3 oudio enkodeerder. Kontroleer jou "
"enkodering parameters."

#. <php-emulation-mode>three underscores for ___rate is really really really
#. * private as opposed to one underscore<php-emulation-mode>
#. call this MACRO outside of the NULL state so that we have a higher chance
#. * of actually having a pipeline and bus to get the message through
#: ext/lame/gstlamemp3enc.c:439 ext/twolame/gsttwolamemp2enc.c:494
#, c-format
msgid ""
"The requested bitrate %d kbit/s for property '%s' is not allowed. The "
"bitrate was changed to %d kbit/s."
msgstr ""
"Die gevraagde bitsnelheid %d kbit/s vir eiendom '%s' Is nie toegelaat. Die "
"bitsnelheid is verander na %d kbit/s."

#. TRANSLATORS: 'song title' by 'artist name'
#: ext/pulse/pulsesink.c:3132
#, c-format
msgid "'%s' by '%s'"
msgstr "'%s' deur '%s'"

#: ext/shout2/gstshout2.c:706 ext/shout2/gstshout2.c:716
msgid "Could not connect to server"
msgstr "Kon nie aan bediener verbind nie"

#: ext/soup/gstsouphttpsrc.c:1108
msgid "No URL set."
msgstr "Geen URL gestel nie."

#: ext/soup/gstsouphttpsrc.c:1623
msgid "Could not resolve server name."
msgstr "Kon nie bedienernaam oplos nie."

#: ext/soup/gstsouphttpsrc.c:1628
msgid "Could not establish connection to server."
msgstr "Kon nie verbinding met bediener tot stand bring nie."

#: ext/soup/gstsouphttpsrc.c:1632
msgid "Secure connection setup failed."
msgstr "Veilige verbinding opstelling het misluk."

#: ext/soup/gstsouphttpsrc.c:1638
msgid ""
"A network error occurred, or the server closed the connection unexpectedly."
msgstr ""
"'n Netwerk fout voorgekom, of die bediener het die verbinding onverwags "
"gesluit."

#: ext/soup/gstsouphttpsrc.c:1643
msgid "Server sent bad data."
msgstr "Bediener het slegte data gestuur."

#: ext/soup/gstsouphttpsrc.c:1949
msgid "Server does not support seeking."
msgstr "Bediener ondersteun nie seeking nie."

#: ext/twolame/gsttwolamemp2enc.c:417
msgid "Failed to configure TwoLAME encoder. Check your encoding parameters."
msgstr ""
"Mislukte om konfigureer TwoLAME enkodeerder. Kontroleer jou enkodering "
"parameters."

#: gst/avi/gstavimux.c:1946
msgid "No or invalid input audio, AVI stream will be corrupt."
msgstr "Geen of ongeldige invoeroudio, AVI stroom sal korrup wees."

#: gst/isomp4/qtdemux.c:505 gst/isomp4/qtdemux.c:510
msgid "This file contains no playable streams."
msgstr "Hierdie lêer bevat geen speelbare strome."

#: gst/isomp4/qtdemux.c:556 gst/isomp4/qtdemux.c:7363 gst/isomp4/qtdemux.c:7432
#: gst/isomp4/qtdemux.c:7738 gst/isomp4/qtdemux.c:9134
msgid "This file is invalid and cannot be played."
msgstr "Hierdie lêer is ongeldig en kan nie gespeel word nie."

#: gst/isomp4/qtdemux.c:3045
msgid "Cannot play stream because it is encrypted with PlayReady DRM."
msgstr ""
"Kan nie stroom speel nie, want dit is geïnkripteer met PlayReady DRM."

#: gst/isomp4/qtdemux.c:4364 gst/isomp4/qtdemux.c:8521
#: gst/isomp4/qtdemux.c:8528 gst/isomp4/qtdemux.c:9836
#: gst/isomp4/qtdemux.c:10278 gst/isomp4/qtdemux.c:10285
#: gst/isomp4/qtdemux.c:13522
msgid "This file is corrupt and cannot be played."
msgstr "Hierdie lêer is korrup en kan nie gespeel word nie."

#: gst/isomp4/qtdemux.c:4606
msgid "Invalid atom size."
msgstr "Ongeldige atoom grootte"

#: gst/isomp4/qtdemux.c:4715
msgid "This file is incomplete and cannot be played."
msgstr "Hierdie lêer is onvolledig en kan nie gespeel word nie."

#: gst/isomp4/qtdemux.c:11419
msgid "The video in this file might not play correctly."
msgstr "Die video in hierdie lêer sal dalk nie reg speel nie."

#: gst/rtsp/gstrtspsrc.c:7894
msgid ""
"No supported stream was found. You might need to install a GStreamer RTSP "
"extension plugin for Real media streams."
msgstr ""
"Geen gesteunde stroom is gekry nie. Jy sal dalk 'n GStreamer RTSP "
"uitbreiding-inprop vir Regte mediastrome moet installeer."

#: gst/rtsp/gstrtspsrc.c:7899
msgid ""
"No supported stream was found. You might need to allow more transport "
"protocols or may otherwise be missing the right GStreamer RTSP extension "
"plugin."
msgstr ""
"Geen gesteunde stroom is gekry nie. Jy sal dalk meer vervoerprotokolle moet "
"toelaat of andersins vermis die reg GStreamer RTSP uitbreiding inprop."

#: sys/oss4/oss4-sink.c:495 sys/oss4/oss4-source.c:360 sys/oss/gstosssink.c:387
msgid ""
"Could not open audio device for playback. Device is being used by another "
"application."
msgstr ""
"Kon nie oudiotoestel oopmaak vir terugspeel nie. Toestel word deur 'n ander "
"toepassing gebruik."

#: sys/oss4/oss4-sink.c:505 sys/oss4/oss4-source.c:370 sys/oss/gstosssink.c:394
msgid ""
"Could not open audio device for playback. You don't have permission to open "
"the device."
msgstr ""
"Kon nie oudiotoestel oopmaak vir terugspeel nie. Jy het nie toestemming om "
"die toestel oop te maak nie."

#: sys/oss4/oss4-sink.c:516 sys/oss4/oss4-source.c:381 sys/oss/gstosssink.c:402
msgid "Could not open audio device for playback."
msgstr "Kon nie oudiotoestel oopmaak vir terugspeel nie."

#: sys/oss4/oss4-sink.c:525 sys/oss4/oss4-source.c:391
msgid ""
"Could not open audio device for playback. This version of the Open Sound "
"System is not supported by this element."
msgstr ""
"Kon nie oudiotoestel oopmaak vir terugspeel nie. Hierdie weergawe van die "
"Oop Klank Stelsel word nie deur hierdie element ondersteun nie."

#: sys/oss4/oss4-sink.c:648
msgid "Playback is not supported by this audio device."
msgstr "Terugspeel word nie deur hierdie oudiotoestel ondersteun nie."

#: sys/oss4/oss4-sink.c:655
msgid "Audio playback error."
msgstr "Oudio terugspeel fout."

#: sys/oss4/oss4-source.c:505
msgid "Recording is not supported by this audio device."
msgstr "Opname word nie deur hierdie oudiotoestel ondersteun nie."

#: sys/oss4/oss4-source.c:512
msgid "Error recording from audio device."
msgstr "Fout opneem vanaf oudio toestel nie."

#: sys/oss/gstosssrc.c:379
msgid ""
"Could not open audio device for recording. You don't have permission to open "
"the device."
msgstr ""
"Kon nie oudiotoestel oopmaak vir opname nie. Jy het nie toestemming om die "
"toestel oop te maak nie."

#: sys/oss/gstosssrc.c:387
msgid "Could not open audio device for recording."
msgstr "Kon nie oudiotoestel oopmaak vir opname nie."

#: sys/osxaudio/gstosxaudioringbuffer.c:149
msgid "CoreAudio device not found"
msgstr "Kern-Oudio toestel nie gevind nie"

#: sys/osxaudio/gstosxaudioringbuffer.c:155
msgid "CoreAudio device could not be opened"
msgstr "Kern-Oudio toestel kon nie oopgemaak word nie"

#: sys/rpicamsrc/gstrpicamsrcdeviceprovider.c:148
msgid "Raspberry Pi Camera Module"
msgstr "Raspberry Pi Kamera Module"

#: sys/v4l2/gstv4l2bufferpool.c:1845
#, c-format
msgid "Error reading %d bytes from device '%s'."
msgstr "Fout leesstuk %d bytes vanaf toestel '%s'."

#: sys/v4l2/gstv4l2object.c:1267
#, c-format
msgid "Failed to enumerate possible video formats device '%s' can work with"
msgstr ""
"Mislukte om te enumerate moontlike video formate toestel '%s' kan werk met"

#: sys/v4l2/gstv4l2object.c:3238
#, c-format
msgid "Could not map buffers from device '%s'"
msgstr "Kon nie buffers vanaf toestel af kaart '%s'"

#: sys/v4l2/gstv4l2object.c:3246
#, c-format
msgid "The driver of device '%s' does not support the IO method %d"
msgstr "Die drywer van toestel '%s' ondersteun nie die IO metode %d"

#: sys/v4l2/gstv4l2object.c:3253
#, c-format
msgid "The driver of device '%s' does not support any known IO method."
msgstr "Die drywer van toestel '%s' ondersteun nie enige bekende IO metode."

#: sys/v4l2/gstv4l2object.c:4125
msgid "Invalid caps"
msgstr "Ongeldige pette"

#: sys/v4l2/gstv4l2object.c:4132 sys/v4l2/gstv4l2object.c:4156
#, c-format
msgid "Device '%s' has no supported format"
msgstr "Toestel '%s' het geen ondersteunde formaat"

#: sys/v4l2/gstv4l2object.c:4138 sys/v4l2/gstv4l2object.c:4162
#, c-format
msgid "Device '%s' failed during initialization"
msgstr "Toestel '%s' mislukte tydens inisialisering"

#: sys/v4l2/gstv4l2object.c:4150
#, c-format
msgid "Device '%s' is busy"
msgstr "Toestel '%s' is besig"

#: sys/v4l2/gstv4l2object.c:4173
#, c-format
msgid "Device '%s' cannot capture at %dx%d"
msgstr "Toestel '%s' kan nie vasvang by %dx%d"

#: sys/v4l2/gstv4l2object.c:4182
#, c-format
msgid "Device '%s' cannot capture in the specified format"
msgstr "Toestel '%s' kan nie in die gespesifiseerde formaat vasvang nie"

#: sys/v4l2/gstv4l2object.c:4193
#, c-format
msgid "Device '%s' does support non-contiguous planes"
msgstr "Toestel '%s' ondersteun nie-aaneengeslote vliegtuie"

#: sys/v4l2/gstv4l2object.c:4208
#, c-format
msgid "Device '%s' does not support %s interlacing"
msgstr "Toestel '%s' ondersteun nie %s interlacing"

#: sys/v4l2/gstv4l2object.c:4222
#, c-format
msgid "Device '%s' does not support %s colorimetry"
msgstr "Toestel '%s' ondersteun nie %s colorimetry"

#: sys/v4l2/gstv4l2object.c:4234
#, c-format
msgid "Could not get parameters on device '%s'"
msgstr "Kon nie parameters op toestel kry nie '%s'"

#: sys/v4l2/gstv4l2object.c:4242
msgid "Video device did not accept new frame rate setting."
msgstr "Video toestel het nie nuwe raamtempo-instelling aanvaar nie."

#: sys/v4l2/gstv4l2object.c:4383
msgid "Video device did not provide output format."
msgstr "Video toestel het nie afvoer formaat verskaf nie."

#: sys/v4l2/gstv4l2object.c:4389
msgid "Video device returned invalid dimensions."
msgstr "Video toestel het ongeldige afmetings teruggestuur."

#: sys/v4l2/gstv4l2object.c:4397
msgid "Video device uses an unsupported interlacing method."
msgstr "Video toestel gebruik 'n nie-ondersteunde interlacing metode."

#: sys/v4l2/gstv4l2object.c:4404
msgid "Video device uses an unsupported pixel format."
msgstr "Videotoestel gebruik 'n nie-ondersteunde pixel formaat."

#: sys/v4l2/gstv4l2object.c:5319
msgid "Failed to configure internal buffer pool."
msgstr "Mislukte om interne buffer poel te konfigureer."

#: sys/v4l2/gstv4l2object.c:5325
msgid "Video device did not suggest any buffer size."
msgstr "Video toestel het geen buffer grootte voorgestel nie."

#: sys/v4l2/gstv4l2object.c:5331
msgid "No downstream pool to import from."
msgstr "Geen stroomaf poel om van in te voer nie."

#: sys/v4l2/gstv4l2radio.c:144
#, c-format
msgid "Failed to get settings of tuner %d on device '%s'."
