msgstr "Mislukte om navraag norm op toestel '%s'."

#: sys/v4l2/v4l2_calls.c:421
#, c-format
msgid "Failed getting controls attributes on device '%s'."
msgstr "Mislukte kry kontrole attribuute op toestel '%s'."

#: sys/v4l2/v4l2_calls.c:613
#, c-format
msgid "Cannot identify device '%s'."
msgstr "Kon nie identifiseer toestel '%s'."

#: sys/v4l2/v4l2_calls.c:620
#, c-format
msgid "This isn't a device '%s'."
msgstr "Hierdie is nie 'n toestel '%s'."

#: sys/v4l2/v4l2_calls.c:627
#, c-format
msgid "Could not open device '%s' for reading and writing."
msgstr "Kon nie toestel oopmaak '%s' vir lees en skryf."

#: sys/v4l2/v4l2_calls.c:634
#, c-format
msgid "Device '%s' is not a capture device."
msgstr "Toestel '%s' is nie 'n vaslegging toestel nie."

#: sys/v4l2/v4l2_calls.c:641
#, c-format
msgid "Device '%s' is not a output device."
msgstr "Toestel '%s' is nie 'n uitset toestel nie."

#: sys/v4l2/v4l2_calls.c:648
#, c-format
msgid "Device '%s' is not a M2M device."
msgstr "Toestel '%s' is nie 'n M2M toestel nie."

#: sys/v4l2/v4l2_calls.c:700
#, c-format
msgid "Could not dup device '%s' for reading and writing."
msgstr "Kon nie dup toestel '%s' vir lees en skryf."

#: sys/v4l2/v4l2_calls.c:784
#, c-format
msgid "Failed to set norm for device '%s'."
msgstr "Mislukte om norm vir toestel te stel '%s'."

#: sys/v4l2/v4l2_calls.c:822
#, c-format
msgid "Failed to get current tuner frequency for device '%s'."
msgstr "Mislukte om huidige ontvangerfrekwensie vir toestel te kry '%s'."

#: sys/v4l2/v4l2_calls.c:864
