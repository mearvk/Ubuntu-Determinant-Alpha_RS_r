#: sys/v4l2/gstv4l2videoenc.c:874
msgid "Failed to start encoding thread."
msgstr "Mislukte om draad te begin enkodeer."

#: sys/v4l2/v4l2_calls.c:92
#, c-format
msgid ""
"Error getting capabilities for device '%s': It isn't a v4l2 driver. Check if "
"it is a v4l1 driver."
msgstr ""
"Fout kry vermoëns vir toestel '%s': Dit is nie 'n v4l2 drywer. Tjeck indien "
"dit is 'n v4l1 drywer."

