#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:242
msgid ""
"⚫ This website presented identification that belongs to a different website."
msgstr ""
"⚫ Hierdie webwerf aangebied identifikasie wat hoort na 'n ander webwerf."

#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:247
msgid ""
"⚫ This website’s identification is too old to trust. Check the date on your "
"computer’s calendar."
msgstr ""
"⚫ Hierdie webwerf is identifikasie is te oud te vertrou. Kyk op die datum op "
"u rekenaar se kalender."

#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:252
msgid ""
"⚫ This website’s identification was not issued by a trusted organization."
msgstr ""
"⚫ Hierdie webwerf is identifikasie is nie uitgereik deur 'n betroubare "
"organisasie nie."

#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:257
msgid ""
"⚫ This website’s identification could not be processed. It may be corrupted."
msgstr ""
"⚫ Hierdie webwerf is identifikasie kon nie verwerk word nie. Dit kan "
"beskadig word."

#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:262
msgid ""
"⚫ This website’s identification has been revoked by the trusted organization "
"that issued it."
msgstr ""
"⚫ Hierdie webwerf is identifikasie is herroep deur die betroubare "
"organisasie wat dit uitgereik het."

#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:267
msgid ""
"⚫ This website’s identification cannot be trusted because it uses very weak "
"encryption."
msgstr ""
"⚫ Hierdie webwerf is identifikasie kan nie vertrou word nie, omdat dit baie "
"swak enkripsie gebruik."

#. Possible error message when a site presents a bad certificate.
#: plugins/common/RESTSupport.vala:272
msgid ""
"⚫ This website’s identification is only valid for future dates. Check the "
"date on your computer’s calendar."
msgstr ""
"⚫ Hierdie webwerf is identifikasie is slegs geldig vir toekomstige datums. "
"Kyk op die datum op u rekenaar se kalender."

