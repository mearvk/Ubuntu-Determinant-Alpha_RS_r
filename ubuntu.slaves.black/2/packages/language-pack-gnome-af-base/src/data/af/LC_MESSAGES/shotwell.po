msgstr "gebruikers token, as dit onthou word."

#: data/gsettings/org.gnome.shotwell.gschema.xml:520
msgid "last category"
msgstr "laaste kategorie"

#: misc/org.yorba.shotwell-extras.gschema.xml:59
msgid "The last selected Rajce category."
msgstr "Die laaste gekose Rajce kategorie."

#: data/gsettings/org.gnome.shotwell.gschema.xml:532
msgid "last photo size"
msgstr "laaste foto grootte"

#: misc/org.yorba.shotwell-extras.gschema.xml:65
msgid ""
"A numeric code representing the last photo size preset used when publishing "
"to Rajce."
msgstr ""
"'N Numeriese kode wat die vooraf ingestelde fotogrootte voorstel wat gebruik "
"is by publikasie aan Rajce."

#: misc/org.yorba.shotwell-extras.gschema.xml:70
msgid "remember"
msgstr "onthou"

#: misc/org.yorba.shotwell-extras.gschema.xml:71
msgid "If true, remember last login."
msgstr "Indien waar, onthou laaste aanteken."

#: misc/org.yorba.shotwell-extras.gschema.xml:76
msgid "hide album"
msgstr "versteek album"

#: misc/org.yorba.shotwell-extras.gschema.xml:77
msgid "If true, hide the newly created Rajce album."
msgstr "Indien waar, versteek die nuut geskepte Rajce album."

#: misc/org.yorba.shotwell-extras.gschema.xml:82
msgid "open album in web browser"
msgstr "oop album in web blaaier"

#: misc/org.yorba.shotwell-extras.gschema.xml:83
msgid ""
"If true, open target album in the web browser just after uploading photos"
msgstr ""
"Indien waar, open die teiken album in die web blaaier net nadat jy foto's "
"opgelaai het"

#: data/gsettings/org.gnome.shotwell.gschema.xml:462
#: data/gsettings/org.gnome.shotwell.gschema.xml:488
#: data/gsettings/org.gnome.shotwell.gschema.xml:538
#: data/gsettings/org.gnome.shotwell.gschema.xml:588
msgid "remove sensitive info from uploads"
msgstr "verwyder sensitiewe inligting uit oplaaie"

#: misc/org.yorba.shotwell-extras.gschema.xml:89
msgid ""
"Whether images being uploaded to Rajce should have their metadata removed "
"first"
msgstr "Of beelde synde opgelaai na Rajce moet hun metadata verwyder eerste"

#: data/gsettings/org.gnome.shotwell.gschema.xml:22
msgid "display basic properties"
msgstr "vertoon basiese eienskappe"

#: misc/org.yorba.shotwell.gschema.xml:23
msgid ""
"True if the basic properties pane is to be displayed, false otherwise."
msgstr ""
"Waar indien die basiese eienskappe paneel is om vertoon te word, onwaar "
"ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:28
msgid "display extended properties"
msgstr "Wys uitgebreide eienskappe"

#: misc/org.yorba.shotwell.gschema.xml:29
msgid ""
"True if the extended properties window is to be displayed, false otherwise."
msgstr ""
"Waar indien die uitgebreide eienskappe venster is om wees vertoon, onwaar "
"ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:34
msgid "display sidebar"
msgstr "Wys Kantbalk"

#: misc/org.yorba.shotwell.gschema.xml:35
msgid "True if the sidebar is to be displayed, false otherwise."
msgstr "Waar indien die kantbar is om wees vertoon, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:40
msgid "display toolbar"
msgstr "Wys nutsbalk"

#: misc/org.yorba.shotwell.gschema.xml:41
msgid "True if the bottom toolbar is to be displayed, false otherwise."
msgstr ""
"Waar indien die onderste nutsbalk is om wees vertoon, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:52
msgid "display search bar"
msgstr "vertoon soekbalk"

#: misc/org.yorba.shotwell.gschema.xml:47
msgid ""
"True if the Search/Filter Toolbar is to be displayed, false otherwise."
msgstr ""
"Waar indien die Soek/Filter Nutsbalk is om wees vertoon, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:58
msgid "display photo titles"
msgstr "Wys foto titels"

#: misc/org.yorba.shotwell.gschema.xml:53
msgid ""
"True if photo titles are to be displayed beneath thumbnails in collection "
"views, false otherwise."
msgstr ""
"Waar indien foto titels is om wees vertoon onder posseëlprentjies in "
"versameling sienings, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:64
msgid "display photo comments"
msgstr "Wys foto kommentaar"

#: misc/org.yorba.shotwell.gschema.xml:59
msgid ""
"True if photo comments are to be displayed beneath thumbnails in collection "
"views, false otherwise."
msgstr ""
"Waar indien foto kommentaar is om wees vertoon onder posseëlprentjies in "
"versameling aansigte, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:70
msgid "display event comments"
msgstr "wys gebeurtenis opmerkings"

#: misc/org.yorba.shotwell.gschema.xml:65
msgid ""
"True if event comments are to be displayed beneath thumbnails in event "
"views, false otherwise."
msgstr ""
"Waar indien gebeurtenis kommentaar is om word vertoon onder posseëlprentjies "
"in gebeurtenis sienings, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:76
msgid "display photo tags"
msgstr "wys foto etikette"

#: misc/org.yorba.shotwell.gschema.xml:71
msgid ""
"True if photo tags are to be listed beneath thumbnails in collection views, "
"false otherwise."
msgstr ""
"Waar indien foto merkers is om word gelys onder posseëlprentjies in "
"versameling sienings, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:82
msgid "display photo ratings"
msgstr "wys foto graderings"

#: misc/org.yorba.shotwell.gschema.xml:77
msgid ""
"True if a photo’s rating should be displayed as overlaid trinket, false "
"otherwise."
msgstr ""
"Waar indien 'n foto's gradering moet vertoon word as oorgelê trinket, onwaar "
"ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:88
msgid "rating filter level"
msgstr "gradering filter vlak"

#: misc/org.yorba.shotwell.gschema.xml:83
msgid ""
"Determines how to filter photos based on their ratings. 1: Rejected or "
"better, 2: Unrated or better, 3: One or better, 4: Two or better, 5: Three "
"or better, 6: Four or better, 7: Five or better."
msgstr ""
"Bepaal hoe om foto's te filter op grond van hul graderings. 1: verwerp of "
"beter, 2: ongegradeer of beter, 3: een of beter, 4: twee of beter, 5: drie "
"of beter, 6: vier of beter, 7: vyf of beter."

#: data/gsettings/org.gnome.shotwell.gschema.xml:94
msgid "sort events ascending"
msgstr "sorteer gebeurtenisse stygende"

#: misc/org.yorba.shotwell.gschema.xml:89
msgid "True if events should be sorted ascending, false if descending."
msgstr ""
"Waar indien gebeure behoort wees gesorteer stygende, onwaar indien aflopende."

#: data/gsettings/org.gnome.shotwell.gschema.xml:100
msgid "sort library photos ascending"
msgstr "sorteer biblioteek foto's stygende"

#: misc/org.yorba.shotwell.gschema.xml:95
msgid ""
"True if library photos should be sorted ascending, false if descending."
msgstr ""
"Waar indien biblioteek foto's behoort wees gesorteer stygende, onwaar indien "
"aflopende."

#: data/gsettings/org.gnome.shotwell.gschema.xml:106
msgid "sort library photos criteria"
msgstr "sorteer biblioteek foto's kriteria"

#: misc/org.yorba.shotwell.gschema.xml:101
msgid ""
"A numeric code that specifies the sort criteria for photos in library views."
msgstr ""
"'N numeriese kode wat spesifiseer die kriteria vir foto's in biblioteek "
"aansigte."

#: data/gsettings/org.gnome.shotwell.gschema.xml:112
msgid "sort event photos ascending"
msgstr "sorteer gebeurtenis foto's stygende"

#: misc/org.yorba.shotwell.gschema.xml:107
msgid "True if event photos should be sorted ascending, false if descending."
msgstr ""
"Waar indien gebeurtenis foto's behoort wees gesorteer stygende, onwaar "
"indien aflopende."

#: data/gsettings/org.gnome.shotwell.gschema.xml:118
msgid "sort event photos criteria"
msgstr "sorteer gebeurtenis foto's kriteria"

#: misc/org.yorba.shotwell.gschema.xml:113
msgid "Specifies the sort criteria for event photos."
msgstr "Spesifiseer die soort kriteria vir gebeurtenis foto's."

#: data/gsettings/org.gnome.shotwell.gschema.xml:124
msgid "use 24 hour time"
msgstr "gebruik 24 uur tyd"

#: misc/org.yorba.shotwell.gschema.xml:119
msgid ""
"True if should display times with a 24 hour clock, false if times should use "
"AM/PM notation."
msgstr ""
"Waar indien behoort vertoning keer met 'n 24 uur klok, onwaar indien keer "
"behoort gebruik AM/PM notasie."

#: data/gsettings/org.gnome.shotwell.gschema.xml:130
msgid "keep relative time between photos"
msgstr "hou relatiewe tyd tussen foto's"

#: misc/org.yorba.shotwell.gschema.xml:125
msgid ""
"True if when adjusting time/date of photos, relative time should be "
"maintained. False if all photos should be set to the same time."
msgstr ""
"Waar indien wanneer aanpassing tyd/datum van foto's, relatiewe tyd behoort "
"wees gehandhaaf. Onwaar indien almal foto's moet wees ingestel op die "
"dieselfde tyd."

#: data/gsettings/org.gnome.shotwell.gschema.xml:136
msgid "modify original photo files"
msgstr "wysig oor spronklike foto lêers"

#: misc/org.yorba.shotwell.gschema.xml:131
msgid ""
"True if when adjusting time/date of photos, the original files should be "
"modified as well. False if changes are made only in the database."
msgstr ""
"Waar indien wanneer aanpassing tyd/datum van foto's, die oorspronklike lêers "
"moet ook verander as goed. Onwaar indien veranderinge is gemaak slegs in die "
"databasis."

#: data/gsettings/org.gnome.shotwell.gschema.xml:142
msgid "show welcome dialog on startup"
msgstr "show welcome dialog on startup"

#: misc/org.yorba.shotwell.gschema.xml:137
msgid ""
"True if, when on startup, a welcome dialog should be shown. False if it "
"should not be shown."
msgstr ""
"Dit is waar as 'n welkome dialoog getoon moet word wanneer dit begin word. "
"Onwaar as dit nie getoon moet word nie."

#: data/gsettings/org.gnome.shotwell.gschema.xml:148
msgid "sidebar position"
msgstr "sybalk posisie"

#: data/gsettings/org.gnome.shotwell.gschema.xml:149
msgid "The width, in pixels, of the sidebar"
msgstr "Die breedte, in pixels, van die sybalk"

#: data/gsettings/org.gnome.shotwell.gschema.xml:154
msgid "photo thumbnail scale"
msgstr "foto kleinkiekie skaal"

#: misc/org.yorba.shotwell.gschema.xml:149
msgid "The scale of photo thumbnails, ranging from 72 to 360."
msgstr "Die skaal van foto-kleinkiekies, wat wissel van 72 tot 360."

#: data/gsettings/org.gnome.shotwell.gschema.xml:160
msgid "pin toolbar state"
msgstr "pin toolbar state"

#: misc/org.yorba.shotwell.gschema.xml:155
msgid "Pin toolbar in fullscreen, or not."
msgstr "Speld die werkbalk in die volskerm vas, al dan nie."

#: data/gsettings/org.gnome.shotwell.gschema.xml:166
msgid "prefer GTK+’s dark theme"
msgstr "verkies GTK + se donker tema"

#: misc/org.yorba.shotwell.gschema.xml:161
msgid "Whether to use the dark theme of GTK+ for Shotwell or not."
msgstr "Of om gebruik die donker tema van GTK + vir Shotwell of nie."

#: data/gsettings/org.gnome.shotwell.gschema.xml:172
msgid "background for transparent images"
msgstr "agtergrond vir deursigtige beelde"

#: misc/org.yorba.shotwell.gschema.xml:167
msgid "The background to use for transparent images."
msgstr "Die agtergrond om te gebruik vir deursigtige beelde."

#: data/gsettings/org.gnome.shotwell.gschema.xml:178
msgid "color for solid transparency background"
msgstr "kleur vir 'n soliede deursigtigheid agtergrond"

#: data/gsettings/org.gnome.shotwell.gschema.xml:179
msgid ""
"Color to use if background for transparent images is set to solid color"
msgstr ""
"Kleur om te gebruik as die agtergrond vir deursigtige beelde op vaste kleur "
"is"

#: data/gsettings/org.gnome.shotwell.gschema.xml:184
msgid "Selection state of “hide photos” option"
msgstr "Die seleksie-staat van die opsie \"verberg foto's\""

#: misc/org.yorba.shotwell.gschema.xml:179
msgid ""
"Last used selection state of the “hide photos already imported” option in "
"the import page."
msgstr ""
"Laaste gebruikte keuringstoestand van die opsie “verberg foto's wat reeds "
"ingevoer is” op die invoerbladsy."

#: misc/org.yorba.shotwell.gschema.xml:186
msgid "delay"
msgstr "vertraging"

#: misc/org.yorba.shotwell.gschema.xml:187
msgid "Delay (in seconds) between photos in the slideshow."
msgstr "Vertraag (in sekondes) tussen foto's in die skyfievertoning."

#: misc/org.yorba.shotwell.gschema.xml:192
msgid "transition delay"
msgstr "oorgang vertraging"

#: data/gsettings/org.gnome.shotwell.gschema.xml:199
msgid ""
"The time (in seconds) that a transition runs between photos in a slideshow"
msgstr ""
"Die tyd (in sekondes) dat 'n oorgang tussen foto's in 'n skyfievertoning "
"verloop"

#: data/gsettings/org.gnome.shotwell.gschema.xml:204
msgid "transition effect id"
msgstr "oorgangs effek id"

#: misc/org.yorba.shotwell.gschema.xml:199
msgid ""
"The name of the transition effect that will be used between photos when "
"running a slideshow"
msgstr ""
"Die naam van die oorgangseffek wat tussen foto's gebruik sal word by die "
"uitvoering van 'n skyfievertoning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:210
msgid "Show title"
msgstr "Wys titel"

#: data/gsettings/org.gnome.shotwell.gschema.xml:211
msgid "Whether to show the title of a photo during the slideshow"
msgstr ""
"Of die titel van 'n foto tydens die skyfievertoning vertoon moet word"

#: data/gsettings/org.gnome.shotwell.gschema.xml:218
msgid "maximize library window"
msgstr "maksimeer biblioteek venster"

#: misc/org.yorba.shotwell.gschema.xml:213
msgid "True if library application is maximized, false otherwise."
msgstr ""
"Waar indien biblioteek toepassing gemaksimeer word, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:224
msgid "width of library window"
msgstr "breedte van die biblioteek venster"

#: misc/org.yorba.shotwell.gschema.xml:219
msgid "The last recorded width of the library application window."
msgstr ""
"Die laaste aangetekende breedte van die biblioteek toepassings venster."

#: data/gsettings/org.gnome.shotwell.gschema.xml:230
msgid "height of library window"
msgstr "hoogte van die biblioteek venster"

#: misc/org.yorba.shotwell.gschema.xml:225
msgid "The last recorded height of the library application window."
msgstr ""
"Die laaste aangetekende hoogte van die biblioteek toepassings venster."

#: data/gsettings/org.gnome.shotwell.gschema.xml:236
msgid "maximize direct-edit window"
msgstr "maksimeer regstreekse-wysig venster"

#: misc/org.yorba.shotwell.gschema.xml:231
msgid "True if direct-edit application is maximized, false otherwise."
msgstr ""
"Waar indien regstreekse-wysig toepassings is gemaksimeer, onwaar ander wyse."

#: data/gsettings/org.gnome.shotwell.gschema.xml:242
msgid "width of direct-edit window"
msgstr "breedte van regstreekse-wysig venster"

#: misc/org.yorba.shotwell.gschema.xml:237
msgid "The last recorded width of the direct-edit application window."
msgstr ""
"Die laaste aangetekende breedte van die regstreekse-wysig toepassings "
"venster."

#: data/gsettings/org.gnome.shotwell.gschema.xml:248
msgid "height of direct-edit window"
msgstr "hoogte van regstreekse-wysig venster"

#: misc/org.yorba.shotwell.gschema.xml:243
msgid "The last recorded height of the direct-edit application window."
msgstr ""
"Die laaste aangetekende hoogte van die direkte-wysig toepassings venster."

#: data/gsettings/org.gnome.shotwell.gschema.xml:254
msgid "sidebar divider position"
msgstr "sybalk verdeel posisie"

#: misc/org.yorba.shotwell.gschema.xml:249
msgid ""
"The last recorded position of the divider between the sidebar and view in "
"library application window."
msgstr ""
"Die laaste aangetekende posisie van die verdeler tussen die sybalk en die "
"aansig in die biblioteektoepassingsvenster."

#: data/gsettings/org.gnome.shotwell.gschema.xml:262
msgid "import directory"
msgstr "invoer gids"

#: misc/org.yorba.shotwell.gschema.xml:257
msgid "Directory in which imported photo files are placed."
msgstr "Gids waarin ingevoerde fotolêers geplaas is."

#: data/gsettings/org.gnome.shotwell.gschema.xml:268
