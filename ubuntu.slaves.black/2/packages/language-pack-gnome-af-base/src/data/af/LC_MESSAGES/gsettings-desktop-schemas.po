msgid "Move window one workspace to the left"
msgstr "Skuif venster een werkspasie na links"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:252
msgid "Move window one workspace to the right"
msgstr "Skuif venster een werkspasie na regs"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:256
msgid "Move window one workspace up"
msgstr "Skuif venster een werkspasie na bo"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:260
msgid "Move window one workspace down"
msgstr "Skuif venster een werkspasie na onder"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:264
msgid "Move window to the next monitor on the left"
msgstr "Skuif venster na die volgende monitor aan die linkerkant"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:268
msgid "Move window to the next monitor on the right"
msgstr "Skuif venster na die volgende monitor aan die regterkant"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:272
msgid "Move window to the next monitor above"
msgstr "Skuif venster na die volgende monitor hierbo"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:276
msgid "Move window to the next monitor below"
msgstr "Skuif venster na die volgende monitor hieronder"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:280
msgid "Raise window if covered, otherwise lower it"
msgstr "Verhoog venster as gedek, anders verlaag dit"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:284
msgid "Raise window above other windows"
msgstr "Verhoog venster bo ander vensters"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:288
msgid "Lower window below other windows"
msgstr "Laat sak venster hieronder ander vensters"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:292
msgid "Maximize window vertically"
msgstr "Maksimeer venster vertikaal"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:296
msgid "Maximize window horizontally"
msgstr "Maksimeer venster horisontaal"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:300
msgid "Move window to top left corner"
msgstr "Skuif venster na boonste linkerhoek"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:304
msgid "Move window to top right corner"
msgstr "Skuif die venster na die regter boonste hoek"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:308
msgid "Move window to bottom left corner"
msgstr "Skuif venster na bodem linkerhoek"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:312
msgid "Move window to bottom right corner"
msgstr "Skuif venster na bodem regterhoek"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:316
msgid "Move window to top edge of screen"
msgstr "Skuif venster na boonste rand van skerm"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:320
msgid "Move window to bottom edge of screen"
msgstr "Skuif venster na onderkant van skerm"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:324
msgid "Move window to right side of screen"
msgstr "Skuif die venster na die regterkant van die skerm"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:328
msgid "Move window to left side of screen"
msgstr "Skuif venster na die linkerkant van die skerm"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:332
msgid "Move window to center of screen"
msgstr "Skuif venster na middel van skerm"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:336
msgid "Switch input source"
msgstr "Shakelaar insetbron"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:337
msgid "Binding to select the next input source"
msgstr "Binding om die volgende invoerbron te kies"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:341
msgid "Switch input source backward"
msgstr "Shakelaar invoerbron terug-waart"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:342
msgid "Binding to select the previous input source"
msgstr "Binding om die vorige invoerbron te kies"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:346
msgid "Toggle window to be always on top"
msgstr "Wissel venster om te wees altyd bo"

#: schemas/org.gnome.desktop.wm.keybindings.gschema.xml.in:347
msgid "Set or unset window to appear always on top"
msgstr "Stel of unstel venster om altyd bo te verskyn"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:8
msgid "Modifier to use for modified window click actions"
msgstr "Wysiger om te gebruik vir gewysigde venster klik aksies"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:9
msgid ""
"Clicking a window while holding down this modifier key will move the window "
"(left click), resize the window (middle click), or show the window menu "
"(right click). The middle and right click operations may be swapped using "
"the “resize-with-right-button” key. Modifier is expressed as “<Alt>” or "
"“<Super>” for example."
msgstr ""
"Deur 'n venster te klik terwyl hierdie wysiging sleutel ingedruk word, sal "
"die venster skuif (links klik), verander die grootte van die venster "
"(middelste klik), of wys die vensterkieslys (regs kliek). Die middel- en "
"regsklik-bewerkings kan omgeruil word met die “resize-with-right-button” "
"sleutel. Wysiger word uitgedruk as “<Alt>” of “<Super>” byvoorbeeld."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:19
msgid "Whether to resize with the right button"
msgstr "Whether om die grootte te verander met die regte knoppie"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:20
msgid ""
"Set this to true to resize with the right button and show a menu with the "
"middle button while holding down the key given in “mouse-button-modifier”; "
"set it to false to make it work the opposite way around."
msgstr ""
"Stel hierdie op waar om die grootte te verander met die regterknoppie en 'n "
"spyskaart met die middelknoppie te wys terwyl jy die sleutel ingedruk hou "
"gegee in “mouse-button-modifier”; stel dit op vals om dit in die "
"teenoorgestelde rigting te laat werk."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:29
msgid "Arrangement of buttons on the titlebar"
msgstr "Rangskikking van knoppies op die titelbalk"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:30
msgid ""
"Arrangement of buttons on the titlebar. The value should be a string, such "
"as “menu:minimize,maximize,spacer,close”; the colon separates the left "
"corner of the window from the right corner, and the button names are comma-"
"separated. Duplicate buttons are not allowed. Unknown button names are "
"silently ignored so that buttons can be added in future metacity versions "
"without breaking older versions. A special spacer tag can be used to insert "
"some space between two adjacent buttons."
msgstr ""
"Rangskikking van knoppies op die titelbalk. Die waarde behoort 'n string "
"wees, soos “menu:minimize,maximize,spacer,close”; die dubbelpunt skei die "
"linkerhoek van die venster van die regterhoek, en die knoppiename word deur "
"kommas geskei. Duplikaat knoppies word nie toegelaat nie. Onbekende "
"knoppiename word stilweg geïgnoreer sodat knoppies in die toekoms bygevoeg "
"kan word metacity weergawes sonder om ouer weergawes te breek. 'n Spesiale "
"spasieer tag kan gebruik word om 'n spasie tussen twee aangrensende knoppies "
"in te voeg."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:43
msgid "Window focus mode"
msgstr "Venster fokus modus"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:44
msgid ""
"The window focus mode indicates how windows are activated. It has three "
"possible values; “click” means windows must be clicked in order to focus "
"them, “sloppy” means windows are focused when the mouse enters the window, "
"and “mouse” means windows are focused when the mouse enters the window and "
"unfocused when the mouse leaves the window."
msgstr ""
"Die vensterfokusmodus dui aan hoe vensters geaktiveer word. Dit het drie "
"moontlike waardes; “click” beteken vensters moet geklik word om hulle te "
"fokus, “sloppy” beteken vensters is gefokus wanneer die muis die venster "
"binnegaan, en “mouse” beteken vensters is gefokus wanneer die muis die "
"venster binnegaan en ongefokus wanneer die muis die venster verlaat."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:55
msgid "Control how new windows get focus"
msgstr "Beheer hoe nuwe vensters kry fokus"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:56
msgid ""
"This option provides additional control over how newly created windows get "
"focus. It has two possible values; “smart” applies the user’s normal focus "
"mode, and “strict” results in windows started from a terminal not being "
"given focus."
msgstr ""
"Hierdie opsie bied addisionele beheer oor hoe nuutgeskepte vensters kry-"
"fokus. Dit het twee moontlike waardes; “smart” pas die gebruiker se normale "
"fokusmodus toe, en “strict” lei tot vensters wat begin het vanaf 'n "
"terminaal wat nie fokus gegee word nie."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:65
msgid "Whether windows should be raised when their client area is clicked"
msgstr ""
"Whether vensters moet verhoog word wanneer hul klient gebied geklik word"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:68
msgid ""
"The default, true, indicates that a window will be raised whenever its "
"client area or its frame is clicked. Setting this to false means that a "
"window will not be raised if it is clicked on the client area. To raise it, "
"one can click anywhere in the window’s frame, or Super-click on any part of "
"the window. This mode is useful if one uses many overlapping windows."
msgstr ""
"Die verstek, waar, dui aan dat 'n venster verhoog sal word wanneer ook al sy "
"klient-gebied of sy raam word geklik. Om dit op vals te stel, beteken dat 'n "
"venster nie verhoog sal word as dit op die klient-gebied geklik word nie. Om "
"dit te verhoog, kan 'n mens enige plek in die venster se raam klik, of Super-"
"klik op enige deel van die venster. Hierdie modus is nuttig as 'n mens baie "
"oorvleuelende vensters gebruik."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:82
msgid "Action on title bar double-click"
msgstr "Handeling op titelbalk dubbelklik"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:83
msgid ""
"This option determines the effects of double-clicking on the title bar. "
"Current valid options are “toggle-shade”, which will shade/unshade the "
"window, “toggle-maximize” which will maximize/unmaximize the window, “toggle-"
"maximize-horizontally” and “toggle-maximize-vertically” which will "
"maximize/unmaximize the window in that direction only, “minimize” which will "
"minimize the window, “shade” which will roll the window up, “menu” which "
"will display the window menu, “lower” which will put the window behind all "
"the others, and “none” which will not do anything."
msgstr ""
"Hierdie opsie bepaal die effek van dubbelklik op die titelbalk. Huidige "
"geldige opsies is “toggle-shade”, wat die venster sal skadu/ontskadu, "
"“toggle-maximize” wat die venster sal maksimeer/ontmaksimeer, “toggle-"
"maximize-horizontally” en “toggle-maximize-vertically” wat die venster slegs "
"in daardie rigting sal maksimeer/ontmaksimeer, “minimize” wat die venster "
"sal minimaliseer, “shade” wat die venster sal oprol, “menu” wat die venster "
"spyskaart sal vertoon, “lower” wat die venster agter alle die ander sal sit, "
"en “none” wat niks sal doen nie."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:108
msgid "Action on title bar middle-click"
msgstr "Handeling op titelbalk middel-klik"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:109
msgid ""
"This option determines the effects of middle-clicking on the title bar. "
"Current valid options are “toggle-shade”, which will shade/unshade the "
"window, “toggle-maximize” which will maximize/unmaximize the window, “toggle-"
"maximize-horizontally” and “toggle-maximize-vertically” which will "
"maximize/unmaximize the window in that direction only, “minimize” which will "
"minimize the window, “shade” which will roll the window up, “menu” which "
"will display the window menu, “lower” which will put the window behind all "
"the others, and “none” which will not do anything."
msgstr ""
"Hierdie opsie bepaal die uitwerking van middel-kliek op die titelbalk. "
"Huidige geldige opsies is “toggle-shade”, wat die venster sal "
"skadu/ontskadu, “toggle-maximize” wat die venster sal "
"maksimeer/ontmaksimeer, “toggle-maximize-horizontally” en “toggle-maximize-"
"vertically” wat slegs die venster in daardie rigting sal "
"maksimeer/ontmaksimeer, “minimize” wat die venster sal minimaliseer, “shade” "
"wat die venster sal oprol, “menu” wat die vensterkieslys sal vertoon, "
"“lower” wat die venster agter al die ander sal sit, en “none” wat niks sal "
"doen nie."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:134
msgid "Action on title bar right-click"
msgstr "Aksie op titelbalk regskliek"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:135
msgid ""
"This option determines the effects of right-clicking on the title bar. "
"Current valid options are “toggle-shade”, which will shade/unshade the "
"window, “toggle-maximize” which will maximize/unmaximize the window, “toggle-"
"maximize-horizontally” and “toggle-maximize-vertically” which will "
"maximize/unmaximize the window in that direction only, “minimize” which will "
"minimize the window, “shade” which will roll the window up, “menu” which "
"will display the window menu, “lower” which will put the window behind all "
"the others, and “none” which will not do anything."
msgstr ""
"Hierdie opsie bepaal die effek van regskliek op die titelbalk. Huidige "
"geldige opsies is “toggle-shade”, wat die venster sal skadu/ontskadu, "
"“toggle-maximize” wat die venster sal maksimeer/ontmaksimeer, “toggle-"
"maximize-horizontally” en “toggle-maximize-vertically” wat slegs die venster "
"in daardie rigting sal maksimeer/ontmaksimeer, “minimize” wat die venster "
"sal minimaliseer, “shade” wat die venster sal oprol, “menu” wat die "
"vensterkieslys sal vertoon, “lower” wat die venster agter al die ander sal "
"sit, en “none” wat niks sal doen nie."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:159
msgid "Automatically raises the focused window"
msgstr "Verhoog die gefokuste venster outomaties"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:160
msgid ""
"If set to true, and the focus mode is either “sloppy” or “mouse” then the "
"focused window will be automatically raised after a delay specified by the "
"auto-raise-delay key. This is not related to clicking on a window to raise "
"it, nor to entering a window during drag-and-drop."
msgstr ""
"Indien op waar gestel, en die fokusmodus is óf “sloppy” of “mouse” dan sal "
"die gefokusde venster outomaties verhoog word na 'n vertraging gespesifiseer "
"deur die outo-verhoging-vertraging sleutel. Dit hou nie verband met die klik "
"op 'n venster om dit op te lig nie, en ook nie om 'n venster binne te gaan "
"tydens sleep-en-los nie."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:170
msgid "Delay in milliseconds for the auto raise option"
msgstr "Vertraging in millisekondes vir die outo verhoog opsie"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:171
msgid ""
"The time delay before raising a window if auto-raise is set to true. The "
"delay is given in thousandths of a second."
msgstr ""
"Die tydsvertraging voordat 'n venster verhoog word as outo-verhoging op waar "
"gestel is. Die vertraging word in duisendstes van 'n sekonde gegee."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:178
msgid "Current theme"
msgstr "Huidige tema"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:179
msgid ""
"The theme determines the appearance of window borders, titlebar, and so "
"forth. DEPRECATED: This key is deprecated and ignored."
msgstr ""
"Die tema bepaal die voorkoms van venstergrense, titelbalk, ensovoorts. "
"DEPRECATED: Hierdie sleutel is deprecated en geïgnoreer."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:188
msgid "Use standard system font in window titles"
msgstr "Gebruik standaard stelsel font in venster titels"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:189
msgid ""
"If true, ignore the titlebar-font option, and use the standard application "
"font for window titles."
msgstr ""
"Indien waar, ignoreer die titelbalk-lettertipe-opsie, en gebruik die "
"standaard toepassing lettertipe vir venster titels."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:196
msgid "Window title font"
msgstr "Venster titel lettertipe"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:197
msgid ""
"A font description string describing a font for window titlebars. The size "
"from the description will only be used if the titlebar-font-size option is "
"set to 0. Also, this option is disabled if the titlebar-uses-desktop-font "
"option is set to true."
msgstr ""
"'n Lettertipe beskrywing toutjie wat 'n lettertipe vir venster titelbalke "
"beskryf. Die grootte van die beskrywing sal slegs gebruik word as die "
"titelbalk-lettertipe-opsie op 0 gestel is. Hierdie opsie is ook gedeaktiveer "
"as die titelbalk-gebruik-lessenaar-lettertipe-opsie op waar gestel is."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:207
msgid "Number of workspaces"
msgstr "Aantal werkruimtes"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:208
msgid ""
"Number of workspaces. Must be more than zero, and has a fixed maximum to "
"prevent making the desktop unusable by accidentally asking for too many "
"workspaces."
msgstr ""
"Aantal werkruimtes. Moet meer as nul wees en het 'n vaste maksimum om te "
"verhoed dat die lessenaar onbruikbaar word deur per ongeluk te veel "
"werkspasies te vra."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:216
msgid "System Bell is Audible"
msgstr "Stelsel Bell is Hoorbaar"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:217
msgid ""
"Determines whether applications or the system can generate audible “beeps”; "
"may be used in conjunction with “visual bell” to allow silent “beeps”."
msgstr ""
"Bepaal of toepassings of die stelsel hoorbaar kan genereer “beeps”; mag "
"gebruik word in samewerking met “visual bell” om toelaat stilte “beeps”."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:225
msgid "Enable Visual Bell"
msgstr "Aktiveer Visuele Bell"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:226
msgid ""
"Turns on a visual indication when an application or the system issues a "
"“bell” or “beep”; useful for the hard-of-hearing and for use in noisy "
"environments."
msgstr ""
"Skakel 'n visuele aanduiding aan wanneer 'n toepassing of die stelsel 'n "
"uitreik “bell” of “beep”; nuttig vir hardhorendes en vir gebruik in "
"lawaaierige omgewings."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:235
msgid "Visual Bell Type"
msgstr "Visuele Klokkie Tipe"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:236
msgid ""
"Tells the WM how to implement the visual indication that the system bell or "
"another application “bell” indicator has been rung. Currently there are two "
"valid values, “fullscreen-flash”, which causes a fullscreen white-black "
"flash, and “frame-flash” which causes the titlebar of the application which "
"sent the bell signal to flash. If the application which sent the bell is "
"unknown (as is usually the case for the default “system beep”), the "
"currently focused window’s titlebar is flashed."
msgstr ""
"Vertel die WM hoe om die visuele aanduiding dat die stelsel bell of 'n ander "
"toepassing te implementeer “bell” aanwyser gelui het. Tans is daar twee "
"geldige waardes, “fullscreen-flash”, wat 'n volskerm wit-swart flits "
"veroorsaak, en “frame-flash” wat veroorsaak dat die titelbalk van die "
"toepassing wat die bell sein gestuur het, flikker. Indien die toepassing wat "
"die bell gestuur het, onbekend is (soos gewoonlik die geval is vir die "
"verstek “system beep”), die venstertitelbalk wat tans gefokus is, flits."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:257
msgid "Disable misfeatures that are required by old or broken applications"
msgstr ""
"Deaktiveer mis kenmerke wat deur ou of stukkende toepassings vereis word"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:260
msgid ""
"Some applications disregard specifications in ways that result in window "
"manager misfeatures. This option puts the WM in a rigorously correct mode, "
"which gives a more consistent user interface, provided one does not need to "
"run any misbehaving applications."
msgstr ""
"Sommige toepassings verontagsaam spesifikasies op maniere wat lei tot "
"wanfunksies van vensterbestuurder. Hierdie opsie plaas die WM in 'n streng "
"korrekte modus, wat 'n meer konsekwente gebruikerskoppelvlak gee, mits 'n "
"mens nie nodig het om enige wangedrag toepassings te laat loop nie."

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:270
msgid "The names of the workspaces"
msgstr "Die name van die werkspasies"

#: schemas/org.gnome.desktop.wm.preferences.gschema.xml.in:271
msgid ""
"Defines the names that should be assigned to workspaces. If the list is too "
"long for the current number of workspaces, names in excess will be ignored. "
"If the list is too short, or includes empty names, missing values will be "
"replaced with the default (“Workspace N”)."
msgstr ""
"Definieer die name wat aan werkspasies toegeken moet word. As die lys te "
"lank is vir die huidige aantal werkspasies, sal oortollige name geïgnoreer "
"word. As die lys te kort is, of leë name insluit, sal ontbrekende waardes "
"met die verstek vervang word (“Workspace N”)."

#: schemas/org.gnome.system.locale.gschema.xml.in:6
msgid "The locale to use for dates / numbers formats"
msgstr "Die plek om te gebruik vir datums/getalleformate"

#: schemas/org.gnome.system.locale.gschema.xml.in:7
msgid ""
"Specify the locale to be used for displaying dates, times and numbers "
"formats."
msgstr ""
"Spesifiseer die plek wat gebruik moet word vir die vertoon van datums, tye "
"en syferformate."

#: schemas/org.gnome.system.location.gschema.xml.in:7
msgid "Geolocation services are enabled."
msgstr "Geografiese liggingdienste is geaktiveer."

#: schemas/org.gnome.system.location.gschema.xml.in:8
msgid "If true, applications are allowed to access location information."
msgstr ""
"Indien waar, word toepassings toegelaat om toegang tot ligginginligting te "
"verkry."

#: schemas/org.gnome.system.location.gschema.xml.in:14
msgid "The maximum accuracy level of location."
msgstr "Die maksimum akkuraatheid vlak van ligging."

#: schemas/org.gnome.system.location.gschema.xml.in:15
msgid ""
"Configures the maximum level of location accuracy applications are allowed "
"to see. Valid options are “country”, “city”, “neighborhood”, “street”, and "
"“exact” (typically requires GPS receiver). Please keep in mind that this "
"only controls what GeoClue will allow applications to see and they can find "
"user’s location on their own using network resources (albeit with street-"
"level accuracy at best)."
msgstr ""
"Stel die maksimum vlak van liggingakkuraatheid op wat toepassings toegelaat "
"word om te sien. Geldige opsies is “country”, “city”, “neighborhood”, "
"“street”, en “exact” (vereis tipies GPS ontvanger). Hou asseblief in gedagte "
"dat dit net beheer wat GeoClue sal toepassings toelaat om te sien en hulle "
"kan gebruiker se ligging vind op hul eie met behulp van netwerk hulpbronne "
"(alhoewel met akkuraatheid op straatvlak op sy beste)."

#: schemas/org.gnome.system.proxy.gschema.xml.in:10
msgid "Proxy configuration mode"
msgstr "Proxy konfigurasie modus"

#: schemas/org.gnome.system.proxy.gschema.xml.in:11
msgid ""
"Select the proxy configuration mode. Supported values are “none”, “manual”, "
"“auto”. If this is “none”, then proxies are not used. If it is “auto”, the "
"autoconfiguration URL described by the “autoconfig-url” key is used. If it "
"is “manual”, then the proxies described by “/system/proxy/http”, "
"“/system/proxy/https”, “/system/proxy/ftp” and “/system/proxy/socks” will be "
"used. Each of the 4 proxy types is enabled if its “host” key is non-empty "
"and its “port” key is non-0. If an http proxy is configured, but an https "
"proxy is not, then the http proxy is also used for https. If a SOCKS proxy "
"is configured, it is used for all protocols, except that the http, https, "
"and ftp proxy settings override it for those protocols only."
msgstr ""
"Kies die proxy konfigurasie modus. Ondersteunde waardes is “none”, “manual”, "
"“auto”. As dit is “none”,dan word volmagte nie gebruik nie. As dit is "
"“auto”, die outo konfigurasie URL beskryf deur die “autoconfig-url” sleutel "
"gebruik word. Indien dit is “manual”, dan die gevolmagtigdes beskryf deur "
"“/system/proxy/http”, “/system/proxy/https”, “/system/proxy/ftp” en "
"“/system/proxy/socks” sal gebruik word. Elk van die 4 volmagtipes is "
"geaktiveer as dit “host” sleutel is nie-leeg en sy “port” sleutel is nie-0. "
"As 'n http-instaanbediener opgestel is, maar 'n https-instaanbediener nie, "
"word die http-instaanbediener ook vir https gebruik. As 'n SOCKS-"
"instaanbediener opgestel is, word dit vir alle protokolle gebruik, behalwe "
"dat die http-, https- en ftp-instaanbedienerinstellings dit slegs vir "
"daardie protokolle ignoreer."

#: schemas/org.gnome.system.proxy.gschema.xml.in:36
msgid "Automatic proxy configuration URL"
msgstr "Outomatiese proxy konfigurasie URL"

#: schemas/org.gnome.system.proxy.gschema.xml.in:37
msgid ""
"URL that provides proxy configuration values. When mode is “auto”, this URL "
"is used to look up proxy information for all protocols."
msgstr ""
"URL wat proxy opstellingwaardes verskaf. Wanneer modus is “auto”, hierdie "
"URL word gebruik om instaanbedienerinligting vir alle protokolle op te soek."

#: schemas/org.gnome.system.proxy.gschema.xml.in:45
msgid "Non-proxy hosts"
msgstr "Nie-instaanbediener gashere"

#: schemas/org.gnome.system.proxy.gschema.xml.in:46
msgid ""
"This key contains a list of hosts which are connected to directly, rather "
"than via the proxy (if it is active). The values can be hostnames, domains "
"(using an initial wildcard like *.foo.com), IP host addresses (both IPv4 and "
"IPv6) and network addresses with a netmask (something like 192.168.0.0/24)."
msgstr ""
"Hierdie sleutel bevat 'n lys gashere wat direk in plaas van deur die "
"instaanbediener (indien dit aktief is) gekoppel is. Die waardes kan "
"gasheername, domeine (met 'n aanvanklike instaankarakter soos *.foo.com), IP-"
"gasheeradresse (beide IPv4 en IPv6) en netwerkadresse met 'n netmasker (iets "
"soos 192.168.0.0/24) wees."

#: schemas/org.gnome.system.proxy.gschema.xml.in:65
msgid "Unused; ignore"
msgstr "Ongebruik; ignoreer"

#: schemas/org.gnome.system.proxy.gschema.xml.in:57
msgid "This key is not used, and should not be read or modified."
msgstr ""

#: schemas/org.gnome.system.proxy.gschema.xml.in:66
msgid ""
"This key is not used; HTTP proxying is enabled when the host key is non-"
"empty and the port is non-0."
msgstr ""
"Hierdie sleutel word nie gebruik nie; HTTP-instaanbediener is geaktiveer "
"wanneer die gasheersleutel nie leeg is nie en die poort nie-0 is nie."

#: schemas/org.gnome.system.proxy.gschema.xml.in:73
msgid "HTTP proxy host name"
msgstr "HTTP instaanbediener gasheer naam"

#: schemas/org.gnome.system.proxy.gschema.xml.in:74
msgid "The machine name to proxy HTTP through."
msgstr "Die masjien naam om HTTP deur te proxy."

#: schemas/org.gnome.system.proxy.gschema.xml.in:81
msgid "HTTP proxy port"
msgstr "HTTP proxy poort"

#: schemas/org.gnome.system.proxy.gschema.xml.in:82
msgid ""
"The port on the machine defined by “/system/proxy/http/host” that you proxy "
"through."
msgstr ""
"Die poort op die masjien gedefinieer deur “/system/proxy/http/host” dat jy "
"proxy deur."

#: schemas/org.gnome.system.proxy.gschema.xml.in:89
msgid "Authenticate proxy server connections"
msgstr "Outentiseer proxy bediener konneksies"

#: schemas/org.gnome.system.proxy.gschema.xml.in:90
msgid ""
"If true, then connections to the proxy server require authentication. The "
"username/password combo is defined by “/system/proxy/http/authentication-"
"user” and “/system/proxy/http/authentication-password”. This applies only to "
"the http proxy; when using a separate https proxy, there is currently no way "
"to specify that it should use authentication."
msgstr ""
"As dit waar is, is verbindings met die instaanbediener nodig waarmerking. "
"Die gebruikersnaam/wagwoord kombinasie word gedefinieer deur "
"“/system/proxy/http/authentication-user” en "
"“/system/proxy/http/authentication-password”. Dit is slegs van toepassing op "
"die http-instaanbediener; wanneer 'n aparte https-instaanbediener gebruik "
"word, is daar tans geen manier om te spesifiseer wat dit moet gebruik "
"waarmerking."

#: schemas/org.gnome.system.proxy.gschema.xml.in:103
msgid "HTTP proxy username"
msgstr "HTTP proxy gebruikersnaam"

#: schemas/org.gnome.system.proxy.gschema.xml.in:104
msgid "User name to pass as authentication when doing HTTP proxying."
msgstr ""
"Gebruikernaam wat as geldigheidsvasstelling gevoer moet word wanneer HTTP-"
"instanery gedoen word."

#: schemas/org.gnome.system.proxy.gschema.xml.in:110
msgid "HTTP proxy password"
msgstr "HTTP proxy wagwoord"

#: schemas/org.gnome.system.proxy.gschema.xml.in:111
msgid "Password to pass as authentication when doing HTTP proxying."
msgstr ""
"Wagwoord wat as geldigheidsvasstelling gevoer moet word wanneer HTTP-"
"instanery gedoen word."

#: schemas/org.gnome.system.proxy.gschema.xml.in:119
msgid "Secure HTTP proxy host name"
msgstr "Veilige-HTTP-instaangasheernaam"

#: schemas/org.gnome.system.proxy.gschema.xml.in:120
msgid "The machine name to proxy secure HTTP through."
msgstr "Die masjiennaam waardeur veilige HTTP ingestaan moet word."

#: schemas/org.gnome.system.proxy.gschema.xml.in:127
msgid "Secure HTTP proxy port"
msgstr "Veilige-HTTP-instaanpoort"

#: schemas/org.gnome.system.proxy.gschema.xml.in:128
msgid ""
"The port on the machine defined by “/system/proxy/https/host” that you proxy "
"through."
msgstr ""
"Die poort op die masjien gedefinieer deur “/system/proxy/https/host”dat jy "
"proxy deur."

#: schemas/org.gnome.system.proxy.gschema.xml.in:137
msgid "FTP proxy host name"
msgstr "FTP-instaangasheernaam"

#: schemas/org.gnome.system.proxy.gschema.xml.in:138
msgid "The machine name to proxy FTP through."
msgstr "Die masjiennaam waardeur FTP ingestaan moet word."

#: schemas/org.gnome.system.proxy.gschema.xml.in:145
msgid "FTP proxy port"
msgstr "FTP proxy poort"

#: schemas/org.gnome.system.proxy.gschema.xml.in:146
msgid ""
"The port on the machine defined by “/system/proxy/ftp/host” that you proxy "
"through."
msgstr ""
"Die poort op die masjien gedefinieer deur “/system/proxy/ftp/host” dat jy "
"proxy deur."

#: schemas/org.gnome.system.proxy.gschema.xml.in:155
msgid "SOCKS proxy host name"
msgstr "SOCKS-instaangasheernaam"

#: schemas/org.gnome.system.proxy.gschema.xml.in:156
msgid "The machine name to use as a SOCKS proxy."
msgstr "Die masjiennaam om te gebruik as 'n SOCKS-instaanbediener."

#: schemas/org.gnome.system.proxy.gschema.xml.in:163
msgid "SOCKS proxy port"
msgstr "SOCKS instaanbedienerpoort"

#: schemas/org.gnome.system.proxy.gschema.xml.in:164
msgid ""
"The port on the machine defined by “/system/proxy/socks/host” that you proxy "
"through."
msgstr ""
"Die poort op die masjien gedefinieer deur “/system/proxy/socks/host” dat jy "
"proxy deur."
