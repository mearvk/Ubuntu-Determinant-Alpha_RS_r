#, c-format
msgid "error parsing action parameter: %s\n"
msgstr "fout met die ontleding van aksie parameter: %s\n"

#: gio/gapplication-tool.c:363
#, c-format
msgid "actions accept a maximum of one parameter\n"
msgstr "aksies aanvaar 'n maksimum van een parameter\n"

#: gio/gapplication-tool.c:418
#, c-format
msgid "list-actions command takes only the application id"
msgstr "lys-aksies opdrag neem slegs die toepassing id"

#: gio/gapplication-tool.c:428
#, c-format
msgid "unable to find desktop file for application %s\n"
msgstr "nie in staat om lessenaar lêer vir toepassing te vind nie %s\n"

#: gio/gapplication-tool.c:473
#, c-format
msgid ""
"unrecognised command: %s\n"
"\n"
msgstr ""
"onherkende opdrag: %s\n"
"\n"

