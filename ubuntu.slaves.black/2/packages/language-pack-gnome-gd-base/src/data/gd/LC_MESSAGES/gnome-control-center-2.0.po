msgstr "Cuir an comas stiùireadh dhathan airson %s"

#: panels/color/cc-color-device.c:92
#, c-format
msgid "Show color profiles for %s"
msgstr "Seall na pròifilean dhathan airson %s"

#. not calibrated
#: panels/color/cc-color-device.c:291
