#: data/org.gnome.settings-daemon.plugins.media-keys.gschema.xml.in:190
#| msgid "Launch media player"
msgid "Binding to launch the media player."
msgstr "Nasgadh gus an cluicheadair mheadhanan a chur gu dol."

