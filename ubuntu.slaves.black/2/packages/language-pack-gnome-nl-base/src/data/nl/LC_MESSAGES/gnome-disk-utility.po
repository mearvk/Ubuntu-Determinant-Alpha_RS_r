msgstr ""
"disk;drive;volume;harddisk;hdd;disc;cdrom;dvd;partition;iso;image;backup;rest"
"ore;benchmark;raid;luks;encryption;S.M.A.R.T.;smart;schijf;herstellen;terugze"
"tten;"

