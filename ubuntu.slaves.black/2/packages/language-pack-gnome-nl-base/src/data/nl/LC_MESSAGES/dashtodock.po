#: Settings.ui.h:33
msgid ""
"Hide the dock when it obstructs a window of the current application. More "
"refined settings are available."
msgstr ""
"Het dok verbergen wanneer het een venster van de huidige toepassing in de "
"weg zit. Er zijn ook gedetailleerde instellingen hiervoor beschikbaar."

#: Settings.ui.h:34
msgid "Intelligent autohide"
msgstr "Slim verbergen"

#: Settings.ui.h:35
msgid "Dock size limit"
msgstr "Maximale dokgrootte"

#: Settings.ui.h:36
msgid "Panel mode: extend to the screen edge"
msgstr "Paneelmodus: uitrekken tot aan de schermrand"

#: Settings.ui.h:38
msgid "Icon size limit"
msgstr "Maximale pictogramgrootte"

#: Settings.ui.h:39
msgid "Fixed icon size: scroll to reveal other icons"
msgstr ""
"Vastgezette pictogramgrootte: verschuif om meer pictogrammen weer te geven"

#: Settings.ui.h:40
msgid "Preview size scale"
msgstr ""

#: Settings.ui.h:41
msgid "Position and size"
msgstr "Positie en grootte"

