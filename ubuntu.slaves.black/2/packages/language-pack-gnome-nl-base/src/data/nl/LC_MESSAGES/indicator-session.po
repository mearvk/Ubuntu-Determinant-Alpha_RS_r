msgid "Cancel"
msgstr "Annuleren"

#: ../src/backend-dbus/actions.c:819 ../src/backend-dbus/actions.c:821
#: ../src/service.c:848
msgid "Restart"
msgstr "Herstarten"

#: ../src/backend-dbus/actions.c:820
msgid "Are you sure you want to close all programs and restart the computer?"
msgstr ""
"Weet u zeker dat u alle programma's wilt afsluiten en de computer wilt "
"herstarten?"

#: ../src/backend-dbus/actions.c:849 ../src/backend-dbus/actions.c:851
#: ../src/service.c:855
msgid "Shut Down"
msgstr "Afsluiten"

#: ../src/backend-dbus/actions.c:850
msgid ""
"Are you sure you want to close all programs and shut down the computer?"
msgstr ""
"Weet u zeker dat u alle programma's wilt afsluiten en de computer wilt "
"uitzetten?"

