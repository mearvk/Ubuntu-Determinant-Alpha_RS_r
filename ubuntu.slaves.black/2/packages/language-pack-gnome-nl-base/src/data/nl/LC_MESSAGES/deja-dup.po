msgstr ""
"De mapstructuur waar reservekopieën worden opgeslagen. Het pad is relatief "
"aan de schijf."

#: data/app.gschema.xml.in:168
msgid "The server address"
msgstr "Het serveradres"

#: data/app.gschema.xml.in:169
msgid "The URI of the remote server location."
msgstr "De URI van de serverlocatie op afstand."

#: data/app.gschema.xml.in:174
msgid ""
"The folder hierarchy where backups are stored. Paths can be absolute or "
"relative to the host."
msgstr ""
"De mapstructuur waar reservekopieën worden opgeslagen. Het pad kan absoluut "
"zijn maar ook relatief aan de gastcomputer."

#: data/org.gnome.DejaDup.gschema.xml.in:192
