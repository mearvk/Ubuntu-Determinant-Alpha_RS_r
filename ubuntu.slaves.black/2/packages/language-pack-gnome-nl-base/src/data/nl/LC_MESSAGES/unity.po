#: ../plugins/unity-mt-grab-handles/unitymtgrabhandles.xml.in.h:5
msgid "Show Handles"
msgstr "Handvatten tonen"

#: ../plugins/unity-mt-grab-handles/unitymtgrabhandles.xml.in.h:6
