#: src/vte.cc:7612
msgid "WARNING"
msgstr "သတိပေးချက်"

#: src/vte.cc:7614
msgid "GnuTLS not enabled; data will be written to disk unencrypted!"
msgstr ""
"GnuTLS ကိုဖွင့်မထားဘူး။ အချက်အလက်များကို disk "
"ထဲသို့စာဝှက်ဖြင့်ရေးသားလိမ့်မည်။"

#: src/spawn.cc:124
#, c-format
msgid "Failed to set pipe nonblocking: %s"
msgstr "Pipe ပိတ်ဆို့ခြင်းကိုသတ်မှတ်ရန်မအောင်မြင်ပါ။ % s"

#: src/spawn.cc:169
#, c-format
msgid "poll error: %s"
msgstr "စစ်တမ်းအမှား -% s"

#: src/spawn.cc:176
msgid "Operation timed out"
msgstr "Operation အချိန်ပြည့်ပါပြီ"

#: src/spawn.cc:186
msgid "Operation was cancelled"
msgstr "operation ကိုပယ်ဖျက်ထားသည်"

#: src/spawn.cc:204
#, c-format
msgid "Failed to read from child pipe (%s)"
msgstr "child pipe(%s) မှ ဖတ်ရန်မအောင်မြင်ပါ"

#: src/spawn.cc:639
#, c-format
msgid "Failed to change to directory “%s”: %s"
msgstr "%s ဖိုင်တွဲကို%s သို့ပြောင်းရန်မအောင်မြင်ပါ"

#: src/spawn.cc:708
#, c-format
msgid "Failed to execute child process “%s”: "
msgstr "child လုပ်ငန်းစဉ်အား%s ခ လုပ်၍ မအောင်မြင်ပါ။ "
