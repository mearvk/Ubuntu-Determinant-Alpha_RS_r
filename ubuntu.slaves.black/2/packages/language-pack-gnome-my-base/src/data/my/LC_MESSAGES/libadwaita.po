#: src/adw-inspector-page.c:75
msgid "No Preference"
msgstr "ဦးစားပေးမရှိပါ။"

#: src/adw-inspector-page.c:77
msgid "Prefer Dark"
msgstr "အမှောင်ကို ဦးစားပေးပါ။"

#: src/adw-inspector-page.c:79
msgid "Prefer Light"
msgstr "အလင်းကို ဦးစားပေးပါ။"

#. Translators: The name of the library, not the stylesheet
#: src/adw-inspector-page.c:97
msgid "Adwaita"
msgstr "Adwaita"

#: src/adw-inspector-page.ui:10
msgid "System Appearance"
msgstr "စနစ်ပုံပန်းသဏ္ဍာန်"

#: src/adw-inspector-page.ui:11
msgid ""
"Override settings for this application. They will be reset upon closing the "
"inspector."
msgstr ""
"ဤအက်ပလီကေးရှင်းအတွက် သတ်မှတ်ချက်များကို အစားထိုးပါ။ Inspector ကို "
"ပိတ်ပြီးပါက ၎င်းတို့ကို ပြန်လည်သတ်မှတ်မည်ဖြစ်သည်။"

#: src/adw-inspector-page.ui:14
msgid "System Supports Color Schemes"
msgstr "စနစ်သည် အရောင်အစီအစဥ်များကို ပံ့ပိုးပေးသည်။"

#: src/adw-inspector-page.ui:26
msgid "Preferred Color Scheme"
msgstr "နှစ်သက်ရာအရောင်အစီအစဥ်"

#: src/adw-inspector-page.ui:43
msgid "High Contrast"
msgstr "အလင်းအမှောင် မြင့်မားခြင်း။"

#: src/adw-preferences-window.c:251
msgid "Untitled page"
msgstr "အမည်မရှိစာမျက်နှာ"

#: src/adw-preferences-window.ui:8
msgid "Preferences"
msgstr "ဦးစားပေးများ"

#: src/adw-preferences-window.ui:69
msgid "Search"
msgstr "ရှာရန်"

#: src/adw-preferences-window.ui:139
msgid "No Results Found"
msgstr "မည်သည့်ရလဒ်မှ မတွေ့ပါ။"

#: src/adw-preferences-window.ui:140 src/adw-tab-overview.ui:113
msgid "Try a different search."
msgstr "နောက်တစ်နည်းဖြင့်ရှာပါ။"
