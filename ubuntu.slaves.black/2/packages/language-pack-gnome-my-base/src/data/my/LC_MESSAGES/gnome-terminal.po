#: src/org.gnome.Terminal.gschema.xml:625
msgid "Keyboard shortcut to make font larger"
msgstr "စာလုံးကြီးစေရန်အတွက် ကီးဘုတ်ဖြတ်လမ်းခလုတ်"

#: src/org.gnome.Terminal.gschema.xml:629
