#: prefs.js:618
msgid "Managed by GNOME Multitasking's Application Switching setting"
msgstr ""
"Gestionat per la configuració de la Commutació d'Aplicacions Multitasca del "
"GNOME"

#: prefs.js:849
msgid "Show dock and application numbers"
msgstr "Mostra l'acoblador i números d'aplicacions"

#: prefs.js:908
msgid "Customize middle-click behavior"
msgstr "Personalitza el comportament del clic central"

#: prefs.js:1005
msgid "Customize running indicators"
msgstr "Personalitza els indicadors en execució"

#: prefs.js:1120 Settings.ui.h:95
msgid "Customize opacity"
msgstr "Personalitza l'opacitat"

