#: locations.js:529
msgid "Mount"
msgstr "Munta"

#: locations.js:531
msgid "Unmount"
msgstr "Desmunta"

#: locations.js:533
msgid "Eject"
msgstr "Expulsa"

#: locations.js:592
#, javascript-format
msgid "Failed to mount “%s”"
msgstr "No s'ha pogut muntar «%s»"

