msgstr "/org/gnome/Sysprof3/Profiler"

#: src/tools/sysprof-profiler-ctl.c:50
msgid "Timeout in seconds"
msgstr "Temps d'espera en segons"

#: src/tools/sysprof-profiler-ctl.c:51
