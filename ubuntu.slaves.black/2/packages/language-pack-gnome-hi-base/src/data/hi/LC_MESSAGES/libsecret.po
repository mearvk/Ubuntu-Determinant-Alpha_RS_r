#: libsecret/secret-item.c:1106
#, c-format
msgid "Received invalid secret from the secret storage"
msgstr "गुप्त भंडारण से अमान्य रहस्य प्राप्त किया"

#: libsecret/secret-methods.c:1060
msgid "Default keyring"
msgstr "डिफ़ॉल्ट कीरिंग"

#: libsecret/secret-session.c:243 libsecret/secret-session.c:279
msgid "Couldn’t communicate with the secret storage"
msgstr "गुप्त भंडारण के साथ संवाद नहीं कर सका"

#: tool/secret-tool.c:42
msgid "the label for the new stored item"
msgstr "नए संग्रहीत आइटम के लिए लेबल"

#: tool/secret-tool.c:44
msgid "the collection in which to place the stored item"
msgstr "वह संग्रह जिसमें संग्रहित वस्तु को रखना है"

#: tool/secret-tool.c:46 tool/secret-tool.c:53 tool/secret-tool.c:458
msgid "attribute value pairs of item to lookup"
msgstr "देखने के लिए आइटम के मूल्य जोड़े को विशेषता"

#: tool/secret-tool.c:60
msgid "attribute value pairs which match items to clear"
msgstr "मूल्य जोड़े जो स्पष्ट करने के लिए आइटम मैच विशेषता"

#: tool/secret-tool.c:67
msgid "collection in which to lock"
msgstr ""

#: tool/secret-tool.c:454
msgid "return all results, instead of just first one"
msgstr "केवल पहले एक के बजाय सभी परिणाम लौटाएं"

#: tool/secret-tool.c:456
msgid "unlock item results if necessary"
msgstr "यदि आवश्यक हो तो आइटम परिणाम अनलॉक करें"
