msgid "Text only"
msgstr "Nur Text"

#: data/mousetweaks.ui:267
msgid "Icons only"
msgstr "Nur Symbole"

#: data/mousetweaks.ui:277
msgid "Text and Icons"
msgstr "Text und Symbole"

#: data/mousetweaks.ui:287
msgid "Orientation"
msgstr "Orientierung"

