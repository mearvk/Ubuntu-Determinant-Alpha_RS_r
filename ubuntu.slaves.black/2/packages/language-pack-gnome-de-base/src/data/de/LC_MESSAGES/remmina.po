msgstr "Stark (+256 Mib, ~2009 CPU)"

#: ../data/ui/remmina_preferences.glade.h:130
msgid "Sensitive (+1 GiB, ~2014 CPU)"
msgstr "Sehr stark (+1 Gib, ~2014 CPU)"

