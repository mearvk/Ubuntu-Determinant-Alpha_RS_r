msgid "Cancel"
msgstr "Abbrechen"

#: ../src/backend-dbus/actions.c:819 ../src/backend-dbus/actions.c:821
#: ../src/service.c:848
msgid "Restart"
msgstr "Neustarten"

#: ../src/backend-dbus/actions.c:820
msgid "Are you sure you want to close all programs and restart the computer?"
msgstr ""
"Sind Sie sicher, dass Sie alle Programme schließen und einen Neustart des "
"Rechners durchführen möchten?"

#: ../src/backend-dbus/actions.c:849 ../src/backend-dbus/actions.c:851
#: ../src/service.c:855
msgid "Shut Down"
msgstr "Herunterfahren"

#: ../src/backend-dbus/actions.c:850
msgid ""
"Are you sure you want to close all programs and shut down the computer?"
msgstr ""
"Sind Sie sicher, dass Sie alle Programme schließen und den Rechner "
"herunterfahren möchten?"

