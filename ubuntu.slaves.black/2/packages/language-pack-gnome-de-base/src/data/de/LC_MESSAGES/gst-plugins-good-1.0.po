msgstr "Gerät »%s« konnte nicht zum Lesen oder Schreiben geöffnet werden."

#: sys/v4l2/v4l2_calls.c:784
#, c-format
msgid "Failed to set norm for device '%s'."
msgstr "Festlegen der Norm auf Gerät »%s« schlug fehl."

