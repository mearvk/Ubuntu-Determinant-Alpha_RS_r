#: src/org.gnome.Terminal.gschema.xml:133
msgctxt "visible-name"
msgid "'Unnamed'"
msgstr "'Bez miana'"

#: src/org.gnome.Terminal.gschema.xml:134
msgid "Human-readable name of the profile"
msgstr "Czytelne miano profilu"

#: src/org.gnome.Terminal.gschema.xml:135
msgid "Human-readable name of the profile."
msgstr "Czytelne miano profilu."

#: src/org.gnome.Terminal.gschema.xml:139
msgid "Default color of text in the terminal"
msgstr "Wychodno farba tekstu w terminalu"

#: src/org.gnome.Terminal.gschema.xml:140
msgid ""
"Default color of text in the terminal, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr ""
"Wychodno farba tekstu w terminalu wkludzano we formie specyfikacyje farby "
"(zopis szesnostkowy HTML abo angelske miano farby, bp. „red”)."

#: src/org.gnome.Terminal.gschema.xml:144
msgid "Default color of terminal background"
msgstr "Wychodno farba zadku w terminalu"

#: src/org.gnome.Terminal.gschema.xml:145
msgid ""
"Default color of terminal background, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr ""
"Wychodno farba zadku w terminalu wkludzano we formie specyfikacyje farby "
"(zopis szesnostkowy HTML abo angelske miano farby, bp. „red”)."

#: src/org.gnome.Terminal.gschema.xml:149
msgid "Default color of bold text in the terminal"
msgstr "Wychodno farba porubiōnego tekstu w terminalu"

#: src/org.gnome.Terminal.gschema.xml:150
msgid ""
"Default color of bold text in the terminal, as a color specification (can be "
"HTML-style hex digits, or a color name such as “red”). This is ignored if "
"bold-color-same-as-fg is true."
msgstr ""
"Wychodno farba porubiōnego tekstu w terminalu wkludzano we formie "
"specyfikacyje farby (zopis szesnostkowy HTML abo angelske miano farby, bp. "
"„red”). Ignorowane, jeźli werta „bold-color-same-as-fg” je nasztelowano na "
"„true”."

#: src/org.gnome.Terminal.gschema.xml:154
msgid "Whether bold text should use the same color as normal text"
msgstr ""
"Ôkryślo, czy porubiōny tekst mo używać tyj samyj farby, co normalny tekst"

#: src/org.gnome.Terminal.gschema.xml:155
msgid ""
"If true, boldface text will be rendered using the same color as normal text."
msgstr ""
"Okryślo, czy porubiōny tekst bydzie pokazowany ze pōmocōm tyj samyj farby, "
"co normalny tekst."

#: src/org.gnome.Terminal.gschema.xml:160
msgid ""
"Scale factor for the cell height to increase line spacing. (Does not "
"increase the font’s height.)"
msgstr ""
"Spōłczynnik skalowanio wysokości kōmōrek do zwiynkszynio ôdstympōw miyndzy "
"wierszami (niy zwiynkszo wysokości fōnta)."

#: src/org.gnome.Terminal.gschema.xml:165
msgid ""
"Scale factor for the cell width to increase letter spacing. (Does not "
"increase the font’s width.)"
msgstr ""
"Spōłczynnik skalowanio szyrokości kōmōrek do zwiynkszynio ôdstympōw miyndzy "
"literami (niy zwiynkszo szyrokości fōnta)."

#: src/org.gnome.Terminal.gschema.xml:169
msgid "Whether to use custom cursor colors"
msgstr "Ôkryslo, czy używać niysztandardowych farbōw kursora"

#: src/org.gnome.Terminal.gschema.xml:170
msgid "If true, use the cursor colors from the profile."
msgstr "Jeźli prowda, używej farbōw kursora z profilu."

#: src/org.gnome.Terminal.gschema.xml:174
msgid "Cursor background color"
msgstr "Farba zadku kursora"

#: src/org.gnome.Terminal.gschema.xml:175
msgid ""
"Custom color of the background of the terminal’s cursor, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”). "
"This is ignored if cursor-colors-set is false."
msgstr ""
"Niysztandardowo farba zadku kursora terminala wkludzano we formie "
"specyfikacyje farby (zopis szesnostkowy HTML abo angelske miano farby, bp. "
"„red”). Ignorowane, jeźli „cursor-colors-set” je nasztalowano na „false”."

#: src/org.gnome.Terminal.gschema.xml:179
msgid "Cursor foreground colour"
msgstr "Farba kursora"

#: src/org.gnome.Terminal.gschema.xml:180
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"cursor position, as a color specification (can be HTML-style hex digits, or "
"a color name such as “red”). This is ignored if cursor-colors-set is false."
msgstr ""
"Niysztandardowo farba znaku kursora terminala wkludzano we formie "
"specyfikacyje farby (zopis szesnostkowy HTML abo angelske miano farby, bp. "
"„red”). Ignorowane, jak „cursor-colors-set” je nasztalowane na „false”."

#: src/org.gnome.Terminal.gschema.xml:184
msgid "Whether to use custom highlight colors"
msgstr "Ôkryslo, czy używać niysztandardowych farbōw wyrōżniynio"

#: src/org.gnome.Terminal.gschema.xml:185
msgid "If true, use the highlight colors from the profile."
msgstr "Jeźli prowda, to używej farbōw wyrōżniynio z profilu."

#: src/org.gnome.Terminal.gschema.xml:189
msgid "Highlight background color"
msgstr "Farba zadku wyrōżniynio"

#: src/org.gnome.Terminal.gschema.xml:190
msgid ""
"Custom color of the background of the terminal’s highlight, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”). "
"This is ignored if highlight-colors-set is false."
msgstr ""
"Niysztandardowo farba zadku wyrōżniynio terminala wkludzano we wzroście "
"specyfikacyje farby (zopis szesnostkowy HTML abo angelske miano farby, bp. "
"„red”). Ignorowane, jeźli „cursor-colors-set” je nasztalowano na „false”."

#: src/org.gnome.Terminal.gschema.xml:194
msgid "Highlight foreground colour"
msgstr "Farba tekstu wyrōżniynio"

#: src/org.gnome.Terminal.gschema.xml:195
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"highlight position, as a color specification (can be HTML-style hex digits, "
"or a color name such as “red”). This is ignored if highlight-colors-set is "
"false."
msgstr ""
"Niysztandardowo farba tekstu terminala wkludzano we formie specyfikacyje "
"farby (zopis szesnostkowy HTML abo angelske miano farby, bp. „red”). "
"Ignorowane, jak „cursor-colors-set” je nasztalowane na „false”."

#: src/org.gnome.Terminal.gschema.xml:199
msgid "Whether to perform bidirectional text rendering"
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:200
msgid "If true, perform bidirectional text rendering (“BiDi”)."
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:204
msgid "Whether to perform Arabic shaping"
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:205
msgid "If true, shape Arabic text."
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:209
msgid "Whether to enable SIXEL images"
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:210
msgid "If true, SIXEL sequences are parsed and images are rendered."
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:214
msgid "Whether bold is also bright"
msgstr "Ôkryślo, czy porubiōny tekst je tyż jasny"

#: src/org.gnome.Terminal.gschema.xml:215
msgid ""
"If true, setting bold on the first 8 colors also switches to their bright "
"variants."
msgstr ""
"Ôkryślo, czy sztelōnek porubiōnych piyrszych ôźmiu farbōw szaltruje je tyż "
"na jejich jasne warianty."

#: src/org.gnome.Terminal.gschema.xml:219
msgid "Whether to ring the terminal bell"
msgstr "Ôkryslo, czy używać zwōnka terminala"

#: src/org.gnome.Terminal.gschema.xml:223
msgid ""
"List of ASCII punctuation characters that are not to be treated as part of a "
"word when doing word-wise selection"
msgstr ""
"Lista znakōw interpunkcyjnych ASCII, co niy majōm być traktowane za tajla "
"wyrazu w czasie zaznaczanio wyrazōw"

#: src/org.gnome.Terminal.gschema.xml:228
msgid "Default number of columns"
msgstr "Wychodno wielość kolumn"

#: src/org.gnome.Terminal.gschema.xml:229
msgid ""
"Number of columns in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr ""
"Wielość kolumn w nowo utworzōnych ôknach terminala. Nic niy zmiynio, jeźli "
"„use_custom_default_size” niyma włōnczōne."

#: src/org.gnome.Terminal.gschema.xml:234
msgid "Default number of rows"
msgstr "Wychodno wielość rzyndōw"

#: src/org.gnome.Terminal.gschema.xml:235
msgid ""
"Number of rows in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr ""
"Wielość rzyndōw w nowo utworzōnych ôknach terminala. Nic niy zmiynio, jeźli "
"„use_custom_default_size” niyma włōnczōne."

#: src/org.gnome.Terminal.gschema.xml:239
msgid "When to show the scrollbar"
msgstr "Kedy pokazować posek przewijanio"

#: src/org.gnome.Terminal.gschema.xml:243
msgid "Number of lines to keep in scrollback"
msgstr "Wielość wierszōw do zachowanio w buforze przewijanio"

#: src/org.gnome.Terminal.gschema.xml:244
msgid ""
"Number of scrollback lines to keep around. You can scroll back in the "
"terminal by this number of lines; lines that don’t fit in the scrollback are "
"discarded. If scrollback_unlimited is true, this value is ignored."
msgstr ""
"Wielość zachowowanych wierszōw bufora przewijanio. Idzie przewijać nazod "
"zawartość terminala ô podano wielość wierszōw; te, co sie niy mieszczōm w "
"buforze, sōm pōmijane. Jeźli „scrollback_unlimited” je nasztelowane na werta "
"„true”, ta werta bydzie zignorowano."

#: src/org.gnome.Terminal.gschema.xml:248
msgid "Whether an unlimited number of lines should be kept in scrollback"
msgstr ""
"Ôkryślo, czy zachowano ôstanie niyôgraniczōno wielość wierszōw w buforze "
"przewijanio"

#: src/org.gnome.Terminal.gschema.xml:249
msgid ""
"If true, scrollback lines will never be discarded. The scrollback history is "
"stored on disk temporarily, so this may cause the system to run out of disk "
"space if there is a lot of output to the terminal."
msgstr ""
"Ôkryślo, czy wiersze w buforze przewijanio nigdy niy bydōm pociepniynte. "
"Historyjo przewijanio je tymczasowo przechowowano na dysku, tōż może to "
"sprawić jego zapołniynie, jeźli wystōmpi dużo tekstu w terminalu."

#: src/org.gnome.Terminal.gschema.xml:253
msgid "Whether to scroll to the bottom when a key is pressed"
msgstr ""
"Ôkryślo, czy przewinōńć do kōńca zawartość terminala, jak bydzie naciśniynty "
"knefel"

#: src/org.gnome.Terminal.gschema.xml:254
msgid "If true, pressing a key jumps the scrollbar to the bottom."
msgstr ""
"Ôkryślo, czy po naciśniyńciu knefla przewinōńć zawartość terminala na sōm "
"kōniec."

#: src/org.gnome.Terminal.gschema.xml:258
msgid "Whether to scroll to the bottom when there’s new output"
msgstr ""
"Ôkryślo, czy przewinōńć do kōńca zawartość terminala, jak pokożōm sie nowe "
"dane"

#: src/org.gnome.Terminal.gschema.xml:259
msgid ""
"If true, whenever there’s new output the terminal will scroll to the bottom."
msgstr ""
"Jeźli prowda, to zawartość terminala sie przewinie do kōńca, kej pokożōm sie "
"nowe dane."

#: src/org.gnome.Terminal.gschema.xml:263
msgid "What to do with the terminal when the child command exits"
msgstr "Ôkryślo, co zrobić z terminalym, jak kōmynda potōmno sie zawrzi"

#: src/org.gnome.Terminal.gschema.xml:264
msgid ""
"Possible values are “close” to close the terminal, “restart” to restart the "
"command, and “hold” to keep the terminal open with no command running inside."
msgstr ""
"Możliwymi wertami sōm „close”, coby zawrzić terminal, „resztart”, coby zaś "
"sztartnōńć kōmynda jak tyż „hold”, coby ôstawić ôtwarty terminal bez "
"wykōnowanyj w nim kōmyndy."

#: src/org.gnome.Terminal.gschema.xml:268
msgid "Whether to launch the command in the terminal as a login shell"
msgstr "Ôkryslo, czy sztartnōńć kōmynda w terminalu za powłōka logowanio"

#: src/org.gnome.Terminal.gschema.xml:269
msgid ""
"If true, the command inside the terminal will be launched as a login shell "
"(argv[0] will have a hyphen in front of it)."
msgstr ""
"Ôkryślo, czy kōmynda we postrzodku terminala bydzie sztartniynto za powłōka "
"logowanio (argv[0] bydzie miało łōncznik na poczōntku)."

#: src/org.gnome.Terminal.gschema.xml:273
msgid "Whether to preserve the working directory when opening a new terminal"
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:274
msgid ""
"Controls when opening a new terminal from a previous one carries over the "
"working directory of the opening terminal to the new one."
msgstr ""

#: src/org.gnome.Terminal.gschema.xml:280
msgid "Whether to run a custom command instead of the shell"
msgstr "Ôkryślo, czy sztartnōńć niysztandardowo kōmynda zamiast powłōki"

#: src/org.gnome.Terminal.gschema.xml:281
msgid ""
"If true, the value of the custom_command setting will be used in place of "
"running a shell."
msgstr ""
"Ôkryślo, czy werta sztelōnku „custom_command” bydzie sztartniynto zamiast "
"powłōki."

#: src/org.gnome.Terminal.gschema.xml:285
msgid "Whether to blink the cursor"
msgstr "Ôkryślo, czy kursōr mo migać"

#: src/org.gnome.Terminal.gschema.xml:286
msgid ""
"The possible values are “system” to use the global cursor blinking settings, "
"or “on” or “off” to set the mode explicitly."
msgstr ""
"Dostympne werty to „system”, coby użyć globalnych ustawiyń miganio kursora, "
"abo „on” (włōncz) i „off” (zastow), coby je wymusić."

#: src/org.gnome.Terminal.gschema.xml:290
msgid "The cursor appearance"
msgstr "Wyglōnd kursora"

#: src/org.gnome.Terminal.gschema.xml:294
msgid ""
"Possible values are “always” or “never” allow blinking text, or only when "
"the terminal is “focused” or “unfocused”."
msgstr ""
"Możliwe werty miganio kursora to „always” (dycki) abo „never” (nigdy), abo "
"„focused” (ino jak terminal je aktywny) abo „unfocused” (ino jak terminal je "
"niyaktywny)."

#: src/org.gnome.Terminal.gschema.xml:298
msgid "Custom command to use instead of the shell"
msgstr "Niysztandardowo kōmynda do użycio w zastympstwie powłōki"

#: src/org.gnome.Terminal.gschema.xml:299
msgid ""
"Run this command in place of the shell, if use_custom_command is true."
msgstr ""
"Sztartuje to kōmynda zamiast powłōki, jeźli je nasztelowano ôpcyjo "
"„use_custom_command”."

#: src/org.gnome.Terminal.gschema.xml:318
msgid "Palette for terminal applications"
msgstr "Paleta dlo programōw terminala"

#: src/org.gnome.Terminal.gschema.xml:322
msgid "A Pango font name and size"
msgstr "Miano i srogość fōnta bibliotyki Pango"

#: src/org.gnome.Terminal.gschema.xml:326
msgid "The code sequence the Backspace key generates"
msgstr "Sekwyncyjo znakōw gynerowano ôd knefla Backspace"

#: src/org.gnome.Terminal.gschema.xml:330
msgid "The code sequence the Delete key generates"
msgstr "Sekwyncyjo znakōw gynerowano ôd knefla Delete"

#: src/org.gnome.Terminal.gschema.xml:334
msgid "Whether to use the colors from the theme for the terminal widget"
msgstr "Ôkryślo, czy użyć farbōw z tymatu widżetu terminala"

#: src/org.gnome.Terminal.gschema.xml:338
msgid "Whether to use the system monospace font"
msgstr "Ôkryslo, czy używać systymowego fōnta ô stałyj szyrokości"

#: src/org.gnome.Terminal.gschema.xml:342
msgid "Whether to rewrap the terminal contents on window resize"
msgstr ""
"Ôkryślo, czy swijać zawartość terminala w czasie zmiany srogości ôkna"

#: src/org.gnome.Terminal.gschema.xml:346
msgid "Which encoding to use"
msgstr "Kerego kodowanio używać"

#: src/org.gnome.Terminal.gschema.xml:350
msgid ""
"Whether ambiguous-width characters are narrow or wide when using UTF-8 "
"encoding"
msgstr ""
"Ôkryślo, czy znaki ô niyjednoznacznyj szyrokości sōm wōnske abo szyroke w "
"czasie używanio kodowanio UTF-8"

#: src/org.gnome.Terminal.gschema.xml:354
msgid "Whether to use a transparent background"
msgstr "Ôkryslo, czy używać przejzdrzistego zadku"

#: src/org.gnome.Terminal.gschema.xml:358
msgid ""
"Whether to use the value of TerminalScreen-background-darkness, if "
"available, from the theme for the transparency value."
msgstr ""
"Ôkryślo, czy użyć werty TerminalScreen-background-darkness, jeźli je "
"dostympno, z tymatu dlo werty przejzdrzistości."

#: src/org.gnome.Terminal.gschema.xml:363
msgid "Adjust the amount of transparency"
