msgid "['attachment','attaching','attached','enclosed']"
msgstr ""
"['attachment','attaching','attached','enclosed','załącznik','załączam','załąc"
"zyłam','załączyłem','załączono','dołączyłam','dołączyłem','dołączono','załōnc"
"zōm','załōnczyłach','załōnczōłch','załōnczōno','przidałach','przidołch','przi"
"dano','przidała','przidoł','przidala','przidol','zalonczom','zalonczylach','z"
"alonczolch','zalonczono','przidalach','zalacznik','zalaczam','zalaczylam','za"
"laczylem','zalaczono','dolaczylam','dolaczylem','dolaczono','bajlaga','bajlad"
"ze','bajlagōm','bajlagom','bajlagi','przidowek','przidowku','przidowka','przi"
"dowkym','przidowki']"

#: ../data/org.gnome.evolution.plugin.attachment-reminder.gschema.xml.in.h:5
msgid ""
"List of clues for the attachment reminder plugin to look for in a message "
"body"
msgstr ""
"Lista słōw do wyszukowanio w wiadōmości dlo rozszyrzynio spōminanio ô "
"przidowku"

#: ../data/org.gnome.evolution.plugin.attachment-reminder.gschema.xml.in.h:6
msgid ""
"List of clues for the attachment reminder plugin to look for in a message "
"body."
msgstr ""
"Lista słōw-kluczy dlo rozszyrzynio spōminanio ô przidowku do wyszukowanio w "
"treści wiadōmości."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:1
msgid "Address book source"
msgstr "Zdrzōdło ksiōnżki adresowyj"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:2
msgid "Address book to use for storing automatically synced contacts."
msgstr ""
"Ksiōnżka adresowo używano do przechowowanio autōmatycznie synchrōnizowanych "
"kōntaktōw."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:3
msgid "Auto sync Pidgin contacts"
msgstr "Autōmatyczne synchrōnizowanie kōntaktōw programu Pidgin"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:4
msgid "Whether Pidgin contacts should be automatically synced."
msgstr ""
"Ôkryślo, eli kōntakty programu Pidgin majōm być autōmatycznie "
"synchrōnizowane."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:5
msgid "Enable autocontacts"
msgstr "Włōnczynie autōmatycznych kōntaktōw"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:6
msgid ""
"Whether contacts should be automatically added to the user’s address book."
msgstr ""
"Ôkryślo, czy majōm kōntakty być autōmatycznie przidowane do ksiōnżki "
"adresowyj używocza."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:7
msgid "Whether to set “File under” field as “First Last”"
msgstr "Ôkryślo, czy sztelować pole „Widzialny za” za „Miano Nazwisko”"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:8
msgid "Set File under as “First Last”, instead of “Last, First”."
msgstr ""
"Sztelowanie widzialności za „Miano Nazwisko” zamiast „Nazwisko, Miano”"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:9
msgid "Pidgin address book source"
msgstr "Zdrzōdło ksiōnżki adresowyj programu Pidgin"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:10
msgid ""
"Address book to use for storing automatically synced contacts from Pidgin."
msgstr ""
"Ksiōnżka adresowo używano do przechowowanio autōmatycznie "
"zesynchrōnizowanych kōntaktōw programu Pidgin."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:11
msgid "Pidgin check interval"
msgstr "Interwał wyszukowanio kōntaktōw programu Pidgin"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:12
msgid "Check interval for Pidgin syncing of contacts."
msgstr "Czas miyndzy synchrōnizacyjami kōntaktōw programu Pidgin."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:13
msgid "Pidgin last sync MD5"
msgstr "Suma MD5 ôstatnigo synchrōnizowanio kōntaktōw programu Pidgin"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:14
msgid "Pidgin last sync MD5."
msgstr "Suma MD5 ôstatnigo synchrōnizowanio kōntaktōw programu Pidgin."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:15
msgid "Pidgin last sync time"
msgstr "Czas ôstatnigo synchrōnizowanio kōntaktōw programu Pidgin"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:16
msgid "Pidgin last sync time."
msgstr "Czas ôstatnigo synchrōnizowanio kōntaktōw programu Pidgin."

#: ../data/org.gnome.evolution.plugin.email-custom-header.gschema.xml.in.h:1
msgid "List of Custom Headers"
msgstr "Lista włosnych nogōwkōw"

#: ../data/org.gnome.evolution.plugin.email-custom-header.gschema.xml.in.h:2
msgid ""
"The key specifies the list of custom headers that you can add to an outgoing "
"message. The format for specifying a Header and Header value is: Name of the "
"custom header followed by “=” and the values separated by “;”"
msgstr ""
"Tyn klucz ôkryślo lista nogōwkōw używocza, co bydōm przidowane do "
"wiadōmości, jak wychodzōm. Format werty to: miano nogōwka, werta „=” jak tyż "
"werty rozdzielōne znakami „;”"

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:1
msgid "Default External Editor"
msgstr "Wychodny zewnyntrzny edytōr"

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:2
msgid "The default command that must be used as the editor."
msgstr "Wychodno kōmynda używano do sztartniyńcio edytora."

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:3
msgid "Automatically launch when a new mail is edited"
msgstr "Autōmatyczne sztartowanie w czasie edycyje nowyj wiadōmości"

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:4
msgid "Automatically launch editor when key is pressed in the mail composer."
msgstr ""
"Autōmatyczne sztartowanie edytora po naciśniyńciu knefla w ôknie tworzynio "
"wiadōmości."

#: ../data/org.gnome.evolution.plugin.face-picture.gschema.xml.in.h:1
msgid "Insert Face picture by default"
msgstr "Wychodnie wstawio ôbroz gymby"

#: ../data/org.gnome.evolution.plugin.face-picture.gschema.xml.in.h:2
msgid ""
"Whether insert Face picture to outgoing messages by default. The picture "
"should be set before checking this, otherwise nothing happens."
msgstr ""
"Ôkryślo, eli wychodnie wstawiać ôbroz gymby do wiadōmości, co wychodzōm. "
"Ôbroz winiyn być nasztalowany przed zaznaczyniym tyj ôpcyje, inakszyj nic "
"sie niy stanie."

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:1
msgid "Delete processed"
msgstr "Kasowanie przetworzōnych"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:2
msgid "Whether to delete processed iTip objects"
msgstr "Ôkryślo, czy kasować przetworzōne ôbiekty iTip"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:3
msgid "Preserve existing reminder by default"
msgstr ""

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:4
msgid "Whether to preset option to preserve existing reminder by default"
msgstr ""

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:5
msgid "Show invitation description provided by the sender"
msgstr ""

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:6
msgid ""
"Set to true to show invitation description as provided by the sender, if "
"such is available"
msgstr ""

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:1
msgid "Notify new messages for Inbox only."
msgstr "Powiadōmianie ino z katalogu Ôdebrane."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:2
msgid "Whether to notify new messages in Inbox folder only."
msgstr ""
"Ôkryślo, czy powiadōmiać ô nowych wiadōmościach ino z katalogu Ôdebrane."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:3
msgid "Enable D-Bus messages."
msgstr "Włōnczynie kōmunikatōw D-Bus."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:4
msgid "Generates a D-Bus message when new mail messages arrive."
msgstr "Tworzi kōmunikat D-Bus po nadejściu nowych wiadōmości."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:5
msgid "Enable icon in notification area."
msgstr "Włōnczynie ikōny w przestrzyni powiadōmianio."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:6
msgid "Show new mail icon in notification area when new messages arrive."
msgstr ""
"Powiadōmio ô nowych wiadōmościach ze pōmocōm ikōny w przestrzyni "
"powiadōmianio."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:7
msgid "Popup message together with the icon."
msgstr "Kōmunikat popup społym z ikōnōm."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:8
msgid "Whether show message over the icon when new messages arrive."
msgstr ""
"Ôkryślo, czy pokozać kōmunikat nad ikōnōm po przijściu nowyj wiadōmości."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:9
msgid "Enable audible notifications when new messages arrive."
msgstr "Włōnczynie źwiynkowego powiadōmianio ô nowych wiadōmościach."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:10
msgid ""
"Whether to make a sound of any kind when new messages arrive. If “false”, "
"the “notify-sound-beep”, “notify-sound-file”, “notify-sound-play-file” and "
"“notify-sound-use-theme” keys are disregarded."
msgstr ""
"Ôkryślo, czy robić klang po przijściu nowyj wiadōmości. Jeźli „false”, to "
"klucze „notify-sound-beep”, „notify-sound-file”, „notify-sound-play-file” "
"i „notify-sound-use-theme” niy sōm używane."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:11
msgid "Whether to emit a beep."
msgstr "Ôkryślo, czy grać klang."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:12
msgid "Whether to emit a beep when new messages arrive."
msgstr "Ôkryślo, eli po dostaniu nowyj wiadōmości grać klang."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:13
msgid "Sound filename to be played."
msgstr "Miano zbioru źwiynkowego do granio."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:14
msgid ""
"Sound file to be played when new messages arrive, if “notify-sound-play-"
"file” is “true”."
msgstr ""
"Miano zbioru źwiynkowego do granio po dostaniu nowyj wiadōmości, jeźli "
"“notify-sound-play-file” je “true”."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:15
msgid "Whether to play a sound file."
msgstr "Ôkryślo, czy grać zbiōr źwiynkowy."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:16
msgid ""
"Whether to play a sound file when new messages arrive. The name of the sound "
"file is given by the “notify-sound-file” key."
msgstr ""
"Ôkryślo, czy grać zbiōr źwiynkowy po przijściu nowyj wiadōmości. Miano "
"zbioru je podowano bez klucz „notify-sound-file”."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:17
msgid "Use sound theme"
msgstr "Używo tymatu źwiynkowego"

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:18
msgid "Play themed sound when new messages arrive, if not in beep mode."
msgstr ""
"Gro źwiynk z tymatu po dostaniu nowyj wiadōmości, jeźli niyma aktywny zwōnek "
"systymowy."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:19
msgid "Do not notify for these accounts"
msgstr "Bez powiadōmianio dlo tych kōnt"

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:20
msgid ""
"Contains UIDs of accounts for which the notifications should be avoided."
msgstr "Zawiyro UID kōnt, dlo kerych unikać powiadōmiyń."

#: ../data/org.gnome.evolution.plugin.prefer-plain.gschema.xml.in.h:1
msgid "Mode to use when displaying mails"
msgstr "Tryb używany do pokazowanio wiadōmości"

#: ../data/org.gnome.evolution.plugin.prefer-plain.gschema.xml.in.h:2
msgid ""
"The mode to use for displaying mails. “normal” makes Evolution choose the "
"best part to show, “prefer_plain” makes it use the text part, if present, "
"“prefer_source” makes it use the text part, if present, otherwise shows HTML "
"source, and “only_plain” forces Evolution to only show plain text"
msgstr ""
"Tryb używany do pokazowanio poczty. Werta „normal” powoduje autōmatyczne "
"ôbranie nojlepszyj czyńści do pokozanio, werta „prefer_plain” powoduje "
"użycie czyńści tekstowyj, jeźli je teroźno (w inkszym przipadku pokazuje kod "
"zdrzōdłowy HTML), a werta „only_plain” wymuszo pokazowanie ajnfachowego "
"tekstu"

#: ../data/org.gnome.evolution.plugin.prefer-plain.gschema.xml.in.h:3
msgid "Whether to show suppressed HTML output"
msgstr "Ôkryślo, czy pokazować ôgraniczōny wychōd HTML"

#: ../data/org.gnome.evolution.plugin.publish-calendar.gschema.xml.in.h:1
msgid "List of Destinations for publishing"
msgstr "Lista placōw docylowych publikowanio"

#: ../data/org.gnome.evolution.plugin.publish-calendar.gschema.xml.in.h:2
msgid ""
"The key specifies the list of destinations to where publish calendars. Each "
"values specifies an XML with setup for publishing to one destination."
msgstr ""
"Klucz, co ôkryślo lista placōw docylowych, w kerych publikować kalyndorze. "
"Kożdo werta ôkryślo kod XML ze sztelōnkami do publikowanio w jednym placu."

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:1
msgid "[]"
msgstr ""

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:2
msgid "List of assignments for recipient and the address to be used with it"
msgstr ""

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:3
msgid ""
"The list is of format 'recipient&lt;tab&gt;sender', where the recipient can "
"be part of the address only and the sender is a full email address, which "
"should match the From address precisely."
msgstr ""

#: ../data/org.gnome.evolution.plugin.templates.gschema.xml.in.h:1
msgid ""
"List of keyword/value pairs for the Templates plugin to substitute in a "
"message body."
msgstr ""
"Lista por klucz/werta dlo rozszyrzynio szymlōw do podmiany we wiadōmości."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:1
msgid "Skip development warning dialog"
msgstr "Pōminiyńcie ôstrzegawczego ôkna ô wersyji roboczyj programu"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:2
msgid ""
"Whether the warning dialog in development versions of Evolution is skipped."
msgstr ""
"Ôkryślo, eli ôkno ôstrzeżynio ô roboczyj wersyji programu Evolution niy "
"bydzie pokazowane."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:3
msgid "Initial attachment view"
msgstr "Poczōntkowy widok przidowka"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:4
msgid ""
"Initial view for attachment bar widgets. “0” is Icon View, “1” is List View."
msgstr ""
"Poczōntkowy widok poska przidowkōw. „0” — widok ikōn, „1” — widok listy."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:5
msgid "Initial file chooser folder"
msgstr "Poczōntkowy katalog ôkna ôbiyranio zbiorōw"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:6
msgid "Initial folder for GtkFileChooser dialogs."
msgstr "Katalog poczōntkowy dlo ôkyn dialogowych GtkFileChooser."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:7
msgid "Compression format used by autoar"
msgstr "Format kōmpresyje używany ôd bibliotyki autoar"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:8
msgid ""
"Compression format used when compressing attached directories with autoar."
msgstr ""
"Format kōmpresyje używany w czasie kōmpresowanio przidanych katalogōw ze "
"pōmocōm bibliotyki autoar."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:9
msgid "Compression filter used by autoar"
msgstr "Filter kōmpresyje używany ôd bibliotyki autoar"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:10
msgid ""
"Compression filter used when compressing attached directories with autoar."
msgstr ""
"Filter kōmpresyje używany w czasie kōmpresowanio przidanych katalogōw ze "
"pōmocōm bibliotyki autoar."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:11
#: ../src/shell/main.c:425
msgid "Start in offline mode"
msgstr "Zaczyno w trybie offline"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:12
msgid ""
"Whether Evolution will start up in offline mode instead of online mode."
msgstr ""
"Ôkryślo, eli program Evolution bydzie ôtwiyrany w trybie offline zamiast w "
"trybie online."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:13
msgid "Offline folder paths"
msgstr "Drōgi do katalogōw offline"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:14
msgid ""
"List of paths for the folders to be synchronized to disk for offline usage."
msgstr ""
"Lista drōg do katalogōw synchrōnizowanych na dysk, do użytku w trybie "
"offline."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:15
msgid "Enable express mode"
msgstr "Włōnczynie trybu ekspresowego"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:16
msgid "Flag that enables a much simplified user interface."
msgstr "Fana, co włōnczo moc uproszczōny interfejs używocza."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:17
msgid "List of button names to hide in the window switcher"
msgstr "Lista mian knefli krytych we szaltrze ôkyn"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:18
msgid ""
"Valid values are “mail”, “addressbook”, “calendar”, “tasks” and “memos”. "
"Change of this requires restart of the application."
msgstr ""
"Noleżne werty to „mail” (poczta), „addressbook” (ksiōnżka adresowo), "
"„calendar” (kalyndorz), „tasks” (zadania) i „memos” (zopiski). Zmiana wymogo "
"sztartniyńcio programu na nowo."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:19
msgid "Window buttons are visible"
msgstr "Knefle ôkna sōm widzialne"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:20
msgid "Whether the window buttons should be visible."
msgstr "Ôkryślo, eli knefle ôkna sōm widzialne."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:21
msgid "Window button style"
msgstr "Styl knefli ôkna"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:22
msgid ""
"The style of the window buttons. Can be “text”, “icons”, “both”, “toolbar”. "
"If “toolbar” is set, the style of the buttons is determined by the GNOME "
"toolbar setting."
msgstr ""
"Styl knefli ôkna. Może być „text” (tekst), „icons” (ikōny), „both” (ôba), "
"„toolbar” (posek noczyniowy). Jeźli nasztalowane je „toolbar”, styl knefli "
"je ôkryślany bez sztelōnki poska noczyniowego GNOME."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:23
msgid "Menubar is visible"
msgstr "Posek myni je widzialny"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:24
msgid "Whether the menubar should be visible."
msgstr "Ôkryślo, eli posek myni je widzialny."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:25
msgid "Toolbar is visible"
msgstr "Widzialność poska noczyniowego"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:26
msgid "Whether the toolbar should be visible."
msgstr "Ôkryślo, eli posek noczyniowy je widzialny."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:27
msgid "Sidebar is visible"
msgstr "Panel boczny je widzialny"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:28
msgid "Whether the sidebar should be visible."
msgstr "Ôkryślo, eli panel boczny je widzialny."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:29
msgid "Statusbar is visible"
msgstr "Posek sztandu je widzialny"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:30
msgid "Whether the status bar should be visible."
msgstr "Ôkryślo, eli posek sztandu je widzialny."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:31
msgid "ID or alias of the component to be shown by default at start-up."
msgstr ""
"Idyntyfikatōr abo alias skłodnika wychodnie pokazowanego przi sztartowaniu."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:32
msgid "Default sidebar width"
msgstr "Wychodno szyrokość poska bocznego"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:33
msgid "The default width for the sidebar, in pixels."
msgstr "Wychodno szyrokość poska bocznego, w pikselach."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:34
msgid "Enable special WebKit developer features"
msgstr "Włōnczynie ekstra funkcyji bibliotyki WebKit dlo programistōw"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:35
msgid "Any change of this option requires restart of Evolution."
msgstr ""
"Kożdo zmiana tyj ôpcyje wymogo sztartniyńcio programu Evolution na nowo."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:36
msgid "The last extension being used when backing up Evolution data."
msgstr ""
"Ôstatnie rozszyrzynie używane w czasie tworzynio kopije ibrycznyj danych "
"programu Evolution."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:37
msgid ""
"It can be either “.gz” or “.xz” and it influences what extension will be "
"preselected in the file chooser."
msgstr ""
"Może wynosić „.gz” abo „.xz” i wpływo na autōmatycznie ôbrane rozszyrzynie w "
"ôknie ôbiyranio zbioru."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:38
msgid "Prefix of the URI to use to search the web with selected text."
msgstr ""
"Prefiks adresy URI do używanio, żeby wyszukować ôbranego tekstu we "
"internecie."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:39
msgid ""
"The prefix of a URL to be used for searches on the web. The actual text "
"selection is escaped and appended to this string. The URI should start with "
"https://."
msgstr ""
"Prefiks adresy URL do używanio przi wyszukowaniu we necu. Zaznaczynie tekstu "
"je dodowane do tego cugu. URI powiniyn sie zaczynać ôd https://."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:40
msgid "Minimum font size to be used by WebKitGTK"
msgstr ""

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:41
msgid ""
"The minimum font size in pixels used to display text in WebKitGTK. This "
"setting controls the absolute smallest size. Values other than 0 can "
"potentially break page layouts. Negative values are treated as 0."
msgstr ""

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:42
msgid "Set of additional illegal characters in the filename"
msgstr ""

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:43
msgid ""
"When generating file names from custom strings some non-printable or "
"reserved characters are replaced with an underscore. Here's a set of "
"additional characters to be replaced."
msgstr ""

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:1
msgid "Use only local spam tests."
msgstr "Użycie ino lokalnych testōw niychcianych wiadōmości."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:2
msgid "Use only the local spam tests (no DNS)."
msgstr "Użycie ino lokalnych testōw niychcianych wiadōmości (bez DNS)."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:3
msgid "Full path command to run spamassassin"
msgstr "Połno drōga do kōmyndy, co sztartuje program spamassassin"

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:4
msgid ""
"Full path to a spamassassin command. If not set, then a compile-time path is "
"used, usually /usr/bin/spamassassin. The command should not contain any "
"other arguments."
msgstr ""
"Połno drōga do kōmyndy programu spamassassin. Jeźli niyma nasztalowano, to "
"użyto bydzie drōga podano w czasie kōmpilacyje (porzōnd "
"/usr/bin/spamassassin). Kōmynda niy może zawiyrać żodnych ekstra parametrōw."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:5
msgid "Full path command to run sa-learn"
msgstr "Połno drōga do kōmyndy, co sztartuje sa-learn"

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:6
msgid ""
"Full path to a sa-learn command. If not set, then a compile-time path is "
"used, usually /usr/bin/sa-learn. The command should not contain any other "
"arguments."
msgstr ""
"Połno drōga do kōmyndy programu sa-learn. Jeźli niyma nasztalowano, to użyto "
"ôstanie drōga podano w czasie kōmpilacyje (porzōnd /usr/bin/sa-learn). "
"Kōmynda niy może zawiyrać żodnych ekstra parametrōw."

#: ../data/org.gnome.evolution.text-highlight.gschema.xml.in.h:1
msgid "Whether the text-highlight module is enabled"
msgstr "Ôkryślo, eli moduł wyrōżnianio tekstu je włōnczōny"

#: ../data/org.gnome.evolution.text-highlight.gschema.xml.in.h:2
msgid "Theme name to use, defaults to “bclear”"
msgstr "Miano używanego motywu, wychodnie „bclear”"

#: ../data/org.gnome.evolution.text-highlight.gschema.xml.in.h:3
msgid ""
"Use “highlight --list-scripts=themes” to get the list of installed themes "
"and then the value to one of them. The change requires only re-format of the "
"message part to take into effect, like using right-click→Format As→...."
msgstr ""
"Użycie „highlight --list-scripts=themes” pokoże lista zainstalowanych "
"tymatōw i werta jednego z nich. Zmiana wymogo sformatowanio na nowo ino "
"czyńści wiadōmości, tak jak użycie prawego klikniyńcio → Formatowanie za → …."

#: ../data/org.gnome.Evolution.appdata.xml.in.in.h:1
#: ../data/org.gnome.Evolution.desktop.in.in.h:1
#: ../src/mail/e-mail-browser.c:1293
#: ../src/modules/mailto-handler/evolution-mailto-handler.c:208
#: ../src/shell/e-shell-window-private.c:241
msgid "Evolution"
msgstr "Evolution"

#: ../data/org.gnome.Evolution.appdata.xml.in.in.h:2
#: ../data/org.gnome.Evolution.desktop.in.in.h:4
msgid "Manage your email, contacts and schedule"
msgstr "Zarzōndzanie wiadōmościami, kōntaktami i terminorzym"

#: ../data/org.gnome.Evolution.appdata.xml.in.in.h:3
msgid ""
"Evolution is a personal information management application that provides "
"integrated mail, calendaring and address book functionality."
msgstr ""
"Program Evolution pōmogo zarzōndzać informacyjami ôsobistymi i dowo funkcyje "
"klijynta poczty e-mail, kalyndorza jak tyż ksiōnżki adresowyj."

#: ../data/org.gnome.Evolution.appdata.xml.in.in.h:4
msgid ""
"Evolution supports a wide range of industry standard data formats and "
"network protocols for information exchange, with an emphasis on standards "
"compliance and security. Evolution can also integrate smoothly with "
"Microsoft Exchange by way of the “Exchange Web Services” (EWS) extension."
msgstr ""
"Program Evolution ôbsuguje szyroko gama sztandardowych formatōw "
"spamiyntowanio danych i protokołōw necowych do wymiany informacyji. Ekstra "
"dany bōł pozōr na zgodliwość ze sztandardami i bezpiyczyństwo. Program idzie "
"tyż leko zintegrować z systymym pocztowym Microsoft Exchange ze pōmocōm "
"rozszyrzynio „Exchange Web Services” (EWS)."

#: ../data/org.gnome.Evolution.appdata.xml.in.in.h:5
msgid "The Evolution Team"
msgstr "Zespōł Evolution"

#: ../data/org.gnome.Evolution.desktop.in.in.h:2
#: ../src/shell/e-shell-utils.c:358
msgid "Groupware Suite"
msgstr "Paket do roboty grupowyj"

#: ../data/org.gnome.Evolution.desktop.in.in.h:3
msgid "Evolution Mail and Calendar"
msgstr "Poczta i kalyndorz Evolution"

#: ../data/org.gnome.Evolution.desktop.in.in.h:5
msgid "email;calendar;contact;addressbook;task;"
msgstr ""
"email;mail;poczta;kalyndorz;kōntakt;ksiōnżka adresowo;zadanie;zadania;"

#: ../data/org.gnome.Evolution.desktop.in.in.h:6
msgid "New Window"
msgstr "Nowe ôkno"

#: ../data/org.gnome.Evolution.desktop.in.in.h:7
