msgstr "Podłōnczo abo mōntuje jedyn abo wiyncyj zbiorōw ôbrazōw dyskōw."

#: src/disk-image-mounter/main.c:198
#, c-format
msgid "Cannot open “%s” — maybe the volume isn’t mounted?"
msgstr "Niy idzie ôtworzić „%s”. Wolumin niyma zamōntowany?"

#: src/disk-image-mounter/main.c:205
#, c-format
