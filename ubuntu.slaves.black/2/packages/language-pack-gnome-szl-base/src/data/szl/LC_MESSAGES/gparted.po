msgstr ""
"Włōnczynie grupy woluminōw niy może być wykōnane, jak sōm zaplanowane "
"ôperacyje dlo partycyje."

#: ../src/Win_GParted.cc:2699
msgid "Activating Volume Group %1"
msgstr "Włōnczanie grupy woluminōw %1"

#. VGNAME from point point
