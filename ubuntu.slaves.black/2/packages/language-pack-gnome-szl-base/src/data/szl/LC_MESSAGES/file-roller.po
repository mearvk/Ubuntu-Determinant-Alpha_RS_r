#: data/org.gnome.FileRoller.appdata.xml.in:9
msgid "File Roller"
msgstr "File Roller"

#: data/org.gnome.FileRoller.appdata.xml.in:10
msgid "Open, modify and create compressed archive files"
msgstr ""
"Ôtwiyranie, modyfikowanie i tworzynie skōmpresowanych zbiorōw archiwōw"

#: data/org.gnome.FileRoller.appdata.xml.in:12
msgid ""
"Archive Manager (also known as File Roller) is the default GNOME application "
"for opening, creating, and modifying archive and compressed archive files."
msgstr ""
"Mynedżer archiwōw (znany tyż pod mianym File Roller) je wychodny program "
"GNOME do ôtwiyranio, tworzynio i modyfikowanio archiwōw i skōmpresowanych "
"zbiorōw archiwōw."

#: data/org.gnome.FileRoller.appdata.xml.in:16
msgid ""
"Archive Manager supports a wide range of different archive files, including:"
msgstr "Mynedżer archiwōw spiyro szyroki zakres zbiorōw archiwōw, w tym:"

#: data/org.gnome.FileRoller.appdata.xml.in:20
msgid "gzip archives (.tar.gz, .tgz)"
msgstr "archiwa gzip (.tar.gz, .tgz)"

#: data/org.gnome.FileRoller.appdata.xml.in:21
msgid "bzip archives (.tar.bz, .tbz)"
msgstr "archiwa bzip (.tar.bz, .tbz)"

#: data/org.gnome.FileRoller.appdata.xml.in:22
msgid "zip archives (.zip)"
msgstr "archiwa zip (.zip)"

#: data/org.gnome.FileRoller.appdata.xml.in:23
msgid "xz archives (.tar.xz)"
msgstr "archiwa xz (.tar.xz)"

#: data/org.gnome.FileRoller.desktop.in.in:3 src/fr-application.c:479
#: src/fr-window.c:2001 src/fr-window.c:5563
msgid "Archive Manager"
msgstr "Archiwa"

#: data/org.gnome.FileRoller.desktop.in.in:4
msgid "Create and modify an archive"
msgstr "Tworzynie i modyfikowanie archiwōw"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.FileRoller.desktop.in.in:6
msgid "zip;tar;extract;unpack;"
msgstr ""
"zip;tar;rozpakuj;rozpakowanie;rozpakowowanie;dekōmpresyjo;dekōmpresowanie;zde"
"kōmpresować;archiwum;"

#: data/org.gnome.FileRoller.gschema.xml:58
msgid "How to sort files"
msgstr "Jak zortować zbiory"

#: data/org.gnome.FileRoller.gschema.xml:59
msgid ""
"What criteria must be used to arrange files. Possible values: name, size, "
"type, time, path."
msgstr ""
"Jakich kryteriōw używać do zortowanio zbiorōw. Możliwe werty: name, size, "
"type, time, path."

#: data/org.gnome.FileRoller.gschema.xml:63
msgid "Sort type"
msgstr "Typ zortowanio"

#: data/org.gnome.FileRoller.gschema.xml:64
msgid ""
"Whether to sort in ascending or descending direction. Possible values: "
"ascending, descending."
msgstr ""
"Ôkryślo, eli porzōndkować w ôd nojmyńszych abo ôd nojsrogszych. Możliwe "
"werty: ascending, descending."

#: data/org.gnome.FileRoller.gschema.xml:68
msgid "List Mode"
msgstr "Tryb listy"

#: data/org.gnome.FileRoller.gschema.xml:69
msgid ""
"Use “all-files” to view all the files in the archive in a single list, use "
"“as-folder” to navigate the archive as a folder."
msgstr ""
"Użycie werty „all-files” pokoże wszyjske zbiory w archiwum na pojedynczym "
"wykazie, użycie werty „as-folder” pokoże archiwum jak katalog."

#: data/org.gnome.FileRoller.gschema.xml:73
msgid "Display type"
msgstr "Pokazowanie zorty"

#: data/org.gnome.FileRoller.gschema.xml:74
msgid "Display the type column in the main window."
msgstr "Pokazowanie kolumny zorty w głōwnym ôknie."

#: data/org.gnome.FileRoller.gschema.xml:78
msgid "Display size"
msgstr "Pokazowanie srogości"

#: data/org.gnome.FileRoller.gschema.xml:79
msgid "Display the size column in the main window."
msgstr "Pokazowanie kolumny srogości w głōwnym ôknie."

#: data/org.gnome.FileRoller.gschema.xml:83
msgid "Display time"
msgstr "Pokazowanie daty"

#: data/org.gnome.FileRoller.gschema.xml:84
msgid "Display the time column in the main window."
msgstr "Pokazowanie kolumny daty w głōwnym ôknie."

#: data/org.gnome.FileRoller.gschema.xml:88
msgid "Display path"
msgstr "Pokazowanie drōgi"

#: data/org.gnome.FileRoller.gschema.xml:89
msgid "Display the path column in the main window."
msgstr "Pokazowanie kolumny drōgi w głōwnym ôknie."

#: data/org.gnome.FileRoller.gschema.xml:93
msgid "Name column width"
msgstr "Szyrokość kolumny miana"

#: data/org.gnome.FileRoller.gschema.xml:94
msgid "The default width of the name column in the file list."
msgstr "Wychodno szyrokość kolumny miana na wykazie zbiorōw."

#: data/org.gnome.FileRoller.gschema.xml:110
msgid "View the sidebar"
msgstr "Pokazowanie panelu bocznego"

#: data/org.gnome.FileRoller.gschema.xml:111
msgid "Whether to display the sidebar."
msgstr "Ôkryślo, eli pokazować panel boczny."

#: data/org.gnome.FileRoller.gschema.xml:130
msgid "Editors"
msgstr "Edytory"

#: data/org.gnome.FileRoller.gschema.xml:131
msgid ""
"List of applications entered in the “Open File” dialog and not associated "
"with the file type."
msgstr ""
"Wykoz programōw podanych w ôknie „Ôtwōrz zbiōr” i niyzwiōnzanych ze zortōm "
"zbioru."

#: data/org.gnome.FileRoller.gschema.xml:135
msgid "Compression level"
msgstr "Poziōm kōmpresyje"

#: data/org.gnome.FileRoller.gschema.xml:136
msgid ""
"Compression level used when adding files to an archive. Possible values: "
"very-fast, fast, normal, maximum."
msgstr ""
"Poziōm kōmpresyje używany przi przidowaniu zbiorōw do archiwum. Możliwe "
"werty: very-fast, fast, normal, maximum."

#: data/org.gnome.FileRoller.gschema.xml:140
#: data/org.gnome.FileRoller.gschema.xml:172
msgid "Encrypt the archive header"
msgstr "Szyfrowanie nogōwka archiwum"

#: data/org.gnome.FileRoller.gschema.xml:141
#: data/org.gnome.FileRoller.gschema.xml:173
msgid ""
"Whether to encrypt the archive header. If the header is encrypted the "
"password will be required to list the archive content as well."
msgstr ""
"Ôkryślo, eli szyfrować nogōwek archiwum. Jeźli nogōwek je szyfrowany, to do "
"pokozanio zawartości archiwum bydzie wymogane hasło."

#: data/org.gnome.FileRoller.gschema.xml:155
msgid "Do not overwrite newer files"
msgstr "Bez zastympowanio nowszych zbiorōw"

#: data/org.gnome.FileRoller.gschema.xml:159
msgid "Recreate the folders stored in the archive"
msgstr "Ôdtworzanie katalogōw w archiwum"

#: data/org.gnome.FileRoller.gschema.xml:177
msgid "Show/hide the extra options"
msgstr ""

#: data/org.gnome.FileRoller.gschema.xml:178
msgid ""
"Whether to show other options. If set the extra options will be shown."
msgstr ""

#: data/org.gnome.FileRoller.gschema.xml:182
msgid "Default volume size"
msgstr "Wychodno srogość woluminu"

#: data/org.gnome.FileRoller.gschema.xml:183
msgid "The default size for volumes."
msgstr "Wychodno srogość woluminōw."

