#: lib/bluetooth-pairing-dialog.c:153 lib/bluetooth-pairing-dialog.c:306
msgid "Cancel"
msgstr "Pociep"

#. OK button
#: lib/bluetooth-pairing-dialog.c:287 lib/bluetooth-settings-obexpush.c:245
msgid "Accept"
msgstr "Zaakceptuj"

