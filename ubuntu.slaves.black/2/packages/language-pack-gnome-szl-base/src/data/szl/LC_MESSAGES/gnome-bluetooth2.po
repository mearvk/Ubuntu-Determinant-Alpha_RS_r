msgstr "Suchawki, zestawy suchawkowe i inksze masziny źwiynkowe"

#: lib/bluetooth-pairing-dialog.c:83 lib/bluetooth-pairing-dialog.c:90
#: lib/bluetooth-pairing-dialog.c:104
msgid "Confirm Bluetooth PIN"
msgstr "Potwierdzanie kodu PIN Bluetooth"

#: lib/bluetooth-pairing-dialog.c:84
#, c-format
msgid "Please confirm the PIN that was entered on “%s”."
msgstr "Potwiyrdź kod PIN, co bōł wkludzōny na maszinie „%s”."

#: lib/bluetooth-pairing-dialog.c:88 lib/bluetooth-pairing-dialog.c:101
#: lib/bluetooth-pairing-dialog.c:149
msgid "Confirm"
msgstr "Potwiyrdź"

#: lib/bluetooth-pairing-dialog.c:91
#, c-format
msgid ""
"Confirm the Bluetooth PIN for “%s”. This can usually be found in the "
"device’s manual."
msgstr ""
"Trzeba potwierdzić kod PIN Bluetooth dlo masziny „%s”. Idzie go znojś w "
"instrukcyji masziny."

#: lib/bluetooth-pairing-dialog.c:97
#, c-format
msgid "Pairing “%s”"
msgstr "Porowanie „%s”"

#: lib/bluetooth-pairing-dialog.c:105
#, c-format
msgid ""
"Please confirm that the following PIN matches the one displayed on “%s”."
msgstr ""
"Potwiyrdź, iże tyn kod PIN je idyntyczny z kodym pokozanym na maszinie „%s”."

#: lib/bluetooth-pairing-dialog.c:110
msgid "Bluetooth Pairing Request"
msgstr "Prośba połōnczynio Bluetooth"

#: lib/bluetooth-pairing-dialog.c:111
#, c-format
msgid "“%s” wants to pair with this device. Do you want to allow pairing?"
msgstr "„%s” chce połōnczyć sie z tōm maszinōm. Przizwolić na połōnczynie?"

#: lib/bluetooth-pairing-dialog.c:116
msgid "Confirm Bluetooth Connection"
msgstr "Potwierdzynie połōnczynio Bluetooth"

#: lib/bluetooth-pairing-dialog.c:117
#, c-format
msgid "“%s” wants to connect with this device. Do you want to allow it?"
msgstr "„%s” chce połōnczyć sie z tōm maszinōm. Przizwolić na to?"

#: lib/bluetooth-pairing-dialog.c:125
#, c-format
msgid "Please enter the following PIN on “%s”."
msgstr "Wkludź tyn kod PIN na maszinie „%s”."

#: lib/bluetooth-pairing-dialog.c:128
#, c-format
msgid ""
"Please enter the following PIN on “%s”. Then press “Return” on the keyboard."
msgstr ""
"Wkludź tyn kod PIN na maszinie „%s” i naciś knefel Enter na tastaturze."

#: lib/bluetooth-pairing-dialog.c:131
msgid ""
"Please move the joystick of your iCade in the following directions. Then "
"press any of the white buttons."
msgstr ""
"Pōnknij joystick masziny iCade we tych rychtōnkach i naciś leda kery "
"z biołych knefli."

#: lib/bluetooth-pairing-dialog.c:139
msgid "Allow"
msgstr "Przizwōl"

#: lib/bluetooth-pairing-dialog.c:143
msgid "Dismiss"
msgstr "Ôdciep"

