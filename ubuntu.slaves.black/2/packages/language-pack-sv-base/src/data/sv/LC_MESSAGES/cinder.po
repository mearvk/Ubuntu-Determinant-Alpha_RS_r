msgstr "Ogiltig inloggning: %(reason)s"

#: cinder/exception.py:201
#, python-format
msgid ""
"Value \"%(value)s\" is not valid for configuration option \"%(option)s\""
msgstr ""
"Värdet \"%(value)s\" är inte giltigt för konfigurationsalternativet "
"\"%(option)s\""

#: cinder/exception.py:206
msgid "Service is unavailable at this time."
msgstr "Tjänsten är otillgänglig för närvarande."

