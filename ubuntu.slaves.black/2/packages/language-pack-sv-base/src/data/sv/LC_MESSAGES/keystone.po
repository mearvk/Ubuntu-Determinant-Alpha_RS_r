#: keystone/exception.py:83
#, python-format
msgid ""
"Expecting to find %(attribute)s in %(target)s - the server could not comply "
"with the request since it is either malformed or otherwise incorrect. The "
"client is assumed to be in error."
msgstr ""
"Förväntades hitta %(attribute)s i %(target)s - servern kunde inte utföra "
"begäran eftersom den antingen är felformad eller felaktig på annat sätt. "
"Klienten antas ha fel."

#: keystone/exception.py:92
#, python-format
msgid "Cannot create an endpoint with an invalid URL: %(url)s"
msgstr "Kan inte skapa slutpunkt med en ogiltig URL: %(url)s"

#: keystone/exception.py:99
#, python-format
msgid "%(detail)s"
msgstr "%(detail)s"

#: keystone/exception.py:103
msgid ""
"Timestamp not in expected format. The server could not comply with the "
"request since it is either malformed or otherwise incorrect. The client is "
"assumed to be in error."
msgstr ""
"Tidsstämpel inte i förväntat format. Servern kunde inte utföra begäran "
"eftersom den antingen är felformad eller felaktig på annat sätt. Klienten "
"antas ha fel."

#: keystone/exception.py:112
msgid ""
"The 'expires_at' must not be before now. The server could not comply with "
"the request since it is either malformed or otherwise incorrect. The client "
"is assumed to be in error."
msgstr ""
"\"expires_at\" får inte vara innan nu. Servern kunde inte utföra begäran "
"eftersom den antingen är felformad eller felaktig på annat sätt. Klienten "
"antas ha fel."

#: keystone/exception.py:121
#, python-format
msgid ""
"String length exceeded.The length of string '%(string)s' exceeded the limit "
"of column %(type)s(CHAR(%(length)d))."
msgstr ""
"Stränglängd överskriden.Stränglängden \"%(string)s\" överskred kolumngränsen "
"%(type)s(TKN(%(length)d))."

#: keystone/exception.py:127
#, python-format
msgid ""
"Request attribute %(attribute)s must be less than or equal to %(size)i. The "
"server could not comply with the request because the attribute size is "
"invalid (too large). The client is assumed to be in error."
msgstr ""
"Begärans attribut %(attribute)s måste vara mindre än eller lika med "
"%(size)i. Servern kunde inte utföra begäran eftersom attributstorleken är "
"ogiltig (för stor). Klienten antas ha fel."

#: keystone/exception.py:137
#, python-format
msgid ""
"The specified parent region %(parent_region_id)s would create a circular "
"region hierarchy."
msgstr ""
"Den angivna föräldraregionen %(parent_region_id)s skulle skapa en cirkulär "
"regionhierarki."

#: keystone/exception.py:156
#, python-format
msgid ""
"The password length must be less than or equal to %(size)i. The server could "
"not comply with the request because the password is invalid."
msgstr ""
"Lösenordets längd måste vara mindre än eller lika med %(size)i. Servern "
"kunde inte utföra begäran eftersom lösenordet är ogiltigt."

#: keystone/exception.py:162
#, python-format
msgid ""
"Unable to delete region %(region_id)s because it or its child regions have "
"associated endpoints."
msgstr ""
"Kunde inte radera regionen %(region_id)s eftersom den eller dess delregioner "
"har associerade slutpunkter."

#: keystone/exception.py:167
msgid ""
"The certificates you requested are not available. It is likely that this "
"server does not use PKI tokens otherwise this is the result of "
"misconfiguration."
msgstr ""
"Certifikaten du begärde är inte tillgängliga. Troligtvis använder den här "
"servern inte PKI-tokens, annars beror det här på felaktig konfiguration."

#: keystone/exception.py:179
msgid "(Disable insecure_debug mode to suppress these details.)"
msgstr "(Avaktivera insecure_debug-läge för att blockera dessa detaljer.)"

#: keystone/exception.py:189
#, python-format
msgid "%(message)s %(amendment)s"
msgstr "%(message)s %(amendment)s"

#: keystone/exception.py:197
msgid "The request you have made requires authentication."
msgstr "Din begäran kräver autentisering."

#: keystone/exception.py:203
msgid "Authentication plugin error."
msgstr "Fel i autentiseringsinstick."

#: keystone/exception.py:211
#, python-format
msgid "Unable to find valid groups while using mapping %(mapping_id)s"
msgstr ""
"Kunde inte hitta giltiga grupper när mappning %(mapping_id)s användes"

#: keystone/exception.py:216
msgid "Attempted to authenticate with an unsupported method."
msgstr "Försökte autentisera med en metod som inte stöds."

#: keystone/exception.py:224
msgid "Additional authentications steps required."
msgstr "Ytterligare autentiseringssteg krävs."

#: keystone/exception.py:232
msgid "You are not authorized to perform the requested action."
msgstr "Du har inte tillstånd att utföra den begärda åtgärden."

#: keystone/exception.py:239
#, python-format
msgid "You are not authorized to perform the requested action: %(action)s"
msgstr "Du har inte tillstånd att utföra den begärda åtgärden: %(action)s"

#: keystone/exception.py:244
#, python-format
msgid ""
"Could not change immutable attribute(s) '%(attributes)s' in target %(target)s"
msgstr ""
"Kunde inte ändra oföränderliga/t attribut \"%(attributes)s\" i destination "
"%(target)s"

#: keystone/exception.py:249
#, python-format
msgid ""
"Group membership across backend boundaries is not allowed, group in question "
"is %(group_id)s, user is %(user_id)s"
msgstr ""
"Gruppmedlemskap över olika bakändar tillåts inte, gruppen ifråga är "
"%(group_id)s, användaren är %(user_id)s"

#: keystone/exception.py:255
#, python-format
msgid ""
"Invalid mix of entities for policy association - only Endpoint, Service or "
"Region+Service allowed. Request was - Endpoint: %(endpoint_id)s, Service: "
"%(service_id)s, Region: %(region_id)s"
msgstr ""
"Ogiltig blandning av objekt för policy-associering - endast Slutpunkt, "
"Tjänst, eller Region+Tjänst tillåts. Begäran var - Slutpunkt: "
"%(endpoint_id)s, Tjänst: %(service_id)s, Region: %(region_id)s"

#: keystone/exception.py:262
#, python-format
msgid "Invalid domain specific configuration: %(reason)s"
msgstr "Ogiltig domänspecifik konfiguration: %(reason)s"

#: keystone/exception.py:266
#, python-format
msgid "Could not find: %(target)s"
msgstr "Kunde inte hitta: %(target)s"

#: keystone/exception.py:272
#, python-format
msgid "Could not find endpoint: %(endpoint_id)s"
msgstr "Kunde inte hitta slutpunkt: %(endpoint_id)s"

#: keystone/exception.py:279
msgid "An unhandled exception has occurred: Could not find metadata."
msgstr "Ett ohanterat undantag inträffade: Kunde inte hitta metadata."

#: keystone/exception.py:284
#, python-format
msgid "Could not find policy: %(policy_id)s"
msgstr "Kunde inte hitta policy: %(policy_id)s"

#: keystone/exception.py:288
msgid "Could not find policy association"
msgstr "Kunde inte hitta policy-associering"

#: keystone/exception.py:292
#, python-format
msgid "Could not find role: %(role_id)s"
msgstr "Kunde inte hitta roll: %(role_id)s"

#: keystone/exception.py:296
#, python-format
msgid "%(prior_role_id)s does not imply %(implied_role_id)s"
msgstr "%(prior_role_id)s antyder inte %(implied_role_id)s"

#: keystone/exception.py:300
#, python-format
msgid "%(role_id)s cannot be an implied roles"
msgstr "%(role_id)s får inte vara en antydd roll"

#: keystone/exception.py:304
#, python-format
msgid ""
"Could not find role assignment with role: %(role_id)s, user or group: "
"%(actor_id)s, project or domain: %(target_id)s"
msgstr ""
"Kunde inte hitta rolltilldelning med rollen: %(role_id)s, användare eller "
"grupp: %(actor_id)s, projekt eller domän: %(target_id)s"

#: keystone/exception.py:310
#, python-format
msgid "Could not find region: %(region_id)s"
msgstr "Kunde inte hitta regionen: %(region_id)s"

#: keystone/exception.py:314
#, python-format
msgid "Could not find service: %(service_id)s"
msgstr "Kunde inte hitta tjänsten: %(service_id)s"

#: keystone/exception.py:318
#, python-format
msgid "Could not find domain: %(domain_id)s"
msgstr "Kunde inte hitta domänen: %(domain_id)s"

#: keystone/exception.py:322
#, python-format
msgid "Could not find project: %(project_id)s"
msgstr "Kunde inte hitta projektet: %(project_id)s"

#: keystone/exception.py:326
#, python-format
msgid "Cannot create project with parent: %(project_id)s"
msgstr "Kan inte skapa projekt med förälder: %(project_id)s"

#: keystone/exception.py:330
#, python-format
msgid "Could not find token: %(token_id)s"
msgstr "Kunte inte hitta token: %(token_id)s"

#: keystone/exception.py:334
#, python-format
msgid "Could not find user: %(user_id)s"
msgstr "Kunde inte hitta användaren: %(user_id)s"

#: keystone/exception.py:338
#, python-format
msgid "Could not find group: %(group_id)s"
msgstr "Kunde inte hitta gruppen: %(group_id)s"

#: keystone/exception.py:342
#, python-format
msgid "Could not find mapping: %(mapping_id)s"
msgstr "Kunde inte hitta mappning: %(mapping_id)s"

#: keystone/exception.py:346
#, python-format
msgid "Could not find trust: %(trust_id)s"
msgstr "Kunte inte hitta tillit: %(trust_id)s"

#: keystone/exception.py:350
#, python-format
msgid "No remaining uses for trust: %(trust_id)s"
msgstr "Inga återstående bruk för tillit: %(trust_id)s"

#: keystone/exception.py:354
#, python-format
msgid "Could not find credential: %(credential_id)s"
msgstr "Kunde inte hitta inloggningsinformation: %(credential_id)s"

#: keystone/exception.py:358
#, python-format
msgid "Could not find version: %(version)s"
msgstr "Kunde inte hitta versionen: %(version)s"

#: keystone/exception.py:362
#, python-format
msgid "Could not find Endpoint Group: %(endpoint_group_id)s"
msgstr "Kunte inte hitta slutpunktsgrupp: %(endpoint_group_id)s"

#: keystone/exception.py:366
#, python-format
msgid "Could not find Identity Provider: %(idp_id)s"
msgstr "Kunde inte hitta identitetsleverantör: %(idp_id)s"

#: keystone/exception.py:370
#, python-format
msgid "Could not find Service Provider: %(sp_id)s"
msgstr "Kunde inte hitta tjänsteleverantör: %(sp_id)s"

#: keystone/exception.py:374
#, python-format
msgid ""
"Could not find federated protocol %(protocol_id)s for Identity Provider: "
"%(idp_id)s"
msgstr ""
"Kunde inte hitta federalt protokoll %(protocol_id)s för "
"identitetsleverantören: %(idp_id)s"

#: keystone/exception.py:385
#, python-format
msgid ""
"Could not find %(group_or_option)s in domain configuration for domain "
"%(domain_id)s"
msgstr ""
"Kunte inte hitta %(group_or_option)s i domänkonfigurationen för domänen "
"%(domain_id)s"

#: keystone/exception.py:403
#, python-format
msgid "Conflict occurred attempting to store %(type)s - %(details)s"
msgstr "Konflikt uppstod vid försök att lagra %(type)s - %(details)s"

#: keystone/exception.py:412
msgid ""
"An unexpected error prevented the server from fulfilling your request."
msgstr "Ett oväntat fel hindrade servern från att fullfölja din begäran."

#: keystone/exception.py:415
#, python-format
msgid ""
"An unexpected error prevented the server from fulfilling your request: "
"%(exception)s"
msgstr ""
"Ett oväntat fel hindrade servern från att fullfölja din begäran: "
"%(exception)s"

#: keystone/exception.py:433
#, python-format
msgid "Unable to consume trust %(trust_id)s, unable to acquire lock."
msgstr "Kunde inte konsumera tillit %(trust_id)s, kunde inte få lås."

#: keystone/exception.py:438
msgid ""
"Expected signing certificates are not available on the server. Please check "
"Keystone configuration."
msgstr ""
"Förväntade signeringscertifikat är inte tillgängliga på servern. Kontrollera "
"din Keystone-konfiguration."

#: keystone/exception.py:444
#, python-format
msgid "Malformed endpoint URL (%(endpoint)s), see ERROR log for details."
msgstr ""
"Felformad slutpunkts-URL (%(endpoint)s), se FEL-logg för vidare detaljer."

#: keystone/exception.py:449
#, python-format
msgid ""
"Group %(group_id)s returned by mapping %(mapping_id)s was not found in the "
"backend."
msgstr ""
"Gruppen %(group_id)s som returnerades av mappning %(mapping_id)s hittades "
"inte i bakänden."

#: keystone/exception.py:454
#, python-format
msgid "Error while reading metadata file, %(reason)s"
msgstr "Fel när metadatafil lästes, %(reason)s"

#: keystone/exception.py:458
#, python-format
msgid ""
"Local section in mapping %(mapping_id)s refers to a remote match that "
"doesn't exist (e.g. {0} in a local section)."
msgstr ""
"Lokalt avsnitt i mappning %(mapping_id)s refererar till en fjärrmatchning "
"som inte finns (t.ex. {0} i ett lokalt avsnitt)."

#: keystone/exception.py:464
#, python-format
msgid ""
"Unexpected combination of grant attributes - User: %(user_id)s, Group: "
"%(group_id)s, Project: %(project_id)s, Domain: %(domain_id)s"
msgstr ""
"Oväntad kombination av tilldela attribut - Användare: %(user_id)s, Grupp: "
"%(group_id)s, Projekt: %(project_id)s, Domän: %(domain_id)s"

#: keystone/exception.py:471
msgid "The action you have requested has not been implemented."
msgstr "Åtgärden du begärde har inte implementerats."

#: keystone/exception.py:478
msgid "The service you have requested is no longer available on this server."
msgstr "Tjänsten du begärde är inte längre tillgänglig på den här servern."

#: keystone/exception.py:485
#, python-format
msgid "The Keystone configuration file %(config_file)s could not be found."
msgstr "Keystone-konfigurationsfilen %(config_file)s hittades inte."

#: keystone/exception.py:490
msgid ""
"No encryption keys found; run keystone-manage fernet_setup to bootstrap one."
msgstr ""
"Inga krypteringsnycklar hittades; kör keystone-manage fernet_setup för att "
"skapa en tillfällig nyckel."

#: keystone/exception.py:495
#, python-format
msgid ""
"The Keystone domain-specific configuration has specified more than one SQL "
"driver (only one is permitted): %(source)s."
msgstr ""
"Den Keystone-domänspecifika konfigurationen har angivit fler än en SQL-"
"drivrutin (endast en tillåts): %(source)s."

#: keystone/exception.py:502
#, python-format
msgid ""
"%(mod_name)s doesn't provide database migrations. The migration repository "
"path at %(path)s doesn't exist or isn't a directory."
msgstr ""
"%(mod_name)s tillhandahåller inte databasmigreringar. Migreringsarkivets "
"sökväg i %(path)s finns inte eller är inte en katalog."

#: keystone/exception.py:509
msgid "Token version is unrecognizable or unsupported."
msgstr "Token-version känns inte igen eller stöds inte."

#: keystone/exception.py:514
#, python-format
msgid ""
"Unable to sign SAML assertion. It is likely that this server does not have "
"xmlsec1 installed, or this is the result of misconfiguration. Reason "
"%(reason)s"
msgstr ""
"Kunde inte signera SAML-sats. Troligtvis har den här servern inte "
"installerat xmlsec1, annars beror det här på felkonfigurering. Anledning "
"%(reason)s"

#: keystone/exception.py:521
msgid ""
"No Authorization headers found, cannot proceed with OAuth related calls, if "
"running under HTTPd or Apache, ensure WSGIPassAuthorization is set to On."
msgstr ""
"Inga autoriseringshuvuden hittades, kan inte fortsätta med OAuth-relaterade "
"anrop, om du kör under HTTPd eller Apache, kontrollera att "
"WSGIPassAuthorization är satt till On."

#: keystone/exception.py:528
#, python-format
msgid ""
"Could not determine Identity Provider ID. The configuration option "
"%(issuer_attribute)s was not found in the request environment."
msgstr ""
"Kunde inte bestämma identitetsleverantörens ID. Konfigurationsalternativet "
"%(issuer_attribute)s hittades inte i begärans miljö."

#: keystone/exception.py:536
#, python-format
msgid ""
"The %s extension has been moved into keystone core and as such its "
"migrations are maintained by the main keystone database control. Use the "
"command: keystone-manage db_sync"
msgstr ""
"Utökningen %s har flyttats till keystones kärna och av den anledningen "
"underhålls dess migreringar av den huvudsakliga keystone-databasens "
"kontroll. Använd kommandot: keystone-manage db_sync"

#: keystone/exception.py:544
#, python-format
msgid "%(driver)s is not supported driver version"
msgstr "%(driver)s är en drivrutinsversion som inte stöds"

#: keystone/notifications.py:232
#, python-format
msgid ""
"%(event)s is not a valid notification event, must be one of: %(actions)s"
msgstr ""
"%(event)s är inte en giltig aviseringshändelse, måste vara en av: %(actions)s"

#: keystone/notifications.py:241
#, python-format
msgid "Method not callable: %s"
msgstr "Metod kan inte anropas: %s"

#: keystone/assignment/controllers.py:100 keystone/identity/controllers.py:71
#: keystone/resource/controllers.py:90
msgid "Name field is required and cannot be empty"
msgstr "Namnfältet krävs och får inte vara tomt"

#: keystone/assignment/controllers.py:146
#: keystone/assignment/controllers.py:163
#: keystone/assignment/controllers.py:182
msgid "User roles not supported: tenant_id required"
msgstr "Användarroller stöds inte: tenant_id krävs"

#: keystone/assignment/controllers.py:567
#: keystone/assignment/controllers.py:856
msgid "Specify a domain or project, not both"
msgstr "Ange en domän eller ett projekt, inte båda"

#: keystone/assignment/controllers.py:570
msgid "Specify one of domain or project"
msgstr "Ange antingen domän eller projekt"

#: keystone/assignment/controllers.py:575
#: keystone/assignment/controllers.py:861
msgid "Specify a user or group, not both"
msgstr "Ange en användare eller en grupp, inte båda"

#: keystone/assignment/controllers.py:578
msgid "Specify one of user or group"
msgstr "Ange antingen användare eller grupp"

#: keystone/assignment/controllers.py:845
msgid ""
"Combining effective and group filter will always result in an empty list."
msgstr ""
"Kombinering av effektivt och gruppfilter kommer alltid resultera i en tom "
"lista."

#: keystone/assignment/controllers.py:850
msgid ""
"Combining effective, domain and inherited filters will always result in an "
"empty list."
msgstr ""
"Kombinering av effektivt, domän- och nedärvda filter kommer alltid resultera "
"i en tom lista."

#: keystone/assignment/controllers.py:952
msgid ""
"scope.project.id must be specified if include_subtree is also specified"
msgstr "scope-project.id måste anges om include_subtree också anges"

#: keystone/assignment/core.py:77
msgid ""
"Use of the identity driver config to automatically configure the same "
"assignment driver has been deprecated, in the \"O\" release, the assignment "
"driver will need to be expicitly configured if different than the default "
"(SQL)."
msgstr ""
"Att använda identitetsdrivrutinens konfig för att automatiskt konfigurera "
"samma tilldelningsdrivrutin har föråldrats, i \"O\"-versionen kommer "
"tilldelningsdrivrutinen behöva konfigureras explicit om den skiljer sig från "
"förvalet (SQL)."

#: keystone/assignment/core.py:88
#, python-format
msgid ""
"Attempted automatic driver selection for assignment based upon [identity]\\"
"driver option failed since driver %s is not found. Set [assignment]/driver "
"to a valid driver in keystone config."
msgstr ""
"Försökte med automatiskt drivrutinsval för tilldelning baserad på "
"alternativet [identitet]\\drivrutin misslyckades eftersom drivrutinen %s "
"inte hittades. Sätt [tilldelning]/drivrutin till en giltig drivrutin i "
"keystone-konfig."

#: keystone/assignment/core.py:179
msgid "Must specify either domain or project"
msgstr "Måste ange antingen domän eller projekt"

#: keystone/assignment/core.py:848
msgid "Cannot list assignments sourced from groups and filtered by user ID."
msgstr ""
"Kan inte lista tilldelningar hämtade från grupper som sedan filtreras på "
"användar-ID."

#: keystone/assignment/core.py:1058
#, python-format
msgid "Project (%s)"
msgstr "Projekt (%s)"

#: keystone/assignment/core.py:1060
#, python-format
msgid "Domain (%s)"
msgstr "Domän (%s)"

#: keystone/assignment/core.py:1062
msgid "Unknown Target"
msgstr "Okänd destination"

#: keystone/assignment/core.py:1518
msgid "Update of `domain_id` is not allowed."
msgstr "Uppdatering av \"domain_id\" tillåts inte."

#: keystone/assignment/core.py:1743
msgid "Domain specific roles are not supported in the V8 role driver"
msgstr "Domänspecifika roller stöds inte i rolldrivrutin V8"

#: keystone/assignment/V8_backends/sql.py:287
#: keystone/assignment/backends/sql.py:137
#, python-format
msgid "Cannot remove role that has not been granted, %s"
msgstr "Kan inte ta bort roll som inte tilldelats, %s"

#: keystone/assignment/V8_backends/sql.py:363
#: keystone/assignment/backends/sql.py:213
#, python-format
msgid "Unexpected assignment type encountered, %s"
msgstr "Oväntad tilldelningstyp påträffad, %s"

#: keystone/auth/controllers.py:60
#, python-format
msgid ""
"Direct import of auth plugin %(name)r is deprecated as of Liberty in favor "
"of its entrypoint from %(namespace)r and may be removed in N."
msgstr ""
"Direkt import av aut.-instick %(name)r föråldrades redan i Liberty till "
"förmån för dess ingångspunkt från %(namespace)r och kan tas bort i N."

#: keystone/auth/controllers.py:121
#, python-format
msgid ""
"Unable to reconcile identity attribute %(attribute)s as it has conflicting "
"values %(new)s and %(old)s"
msgstr ""
"Kunde inte tillfredsställa identitetsattributet %(attribute)s eftersom de "
"har motstridiga värden %(new)s och %(old)s"

#: keystone/auth/controllers.py:182
msgid "Domain name cannot contain reserved characters."
msgstr "Domännamn får inte innehålla reserverade tecken."

#: keystone/auth/controllers.py:205
msgid "Project name cannot contain reserved characters."
msgstr "Projektnamn får inte innehålla reserverade tecken."

#: keystone/auth/controllers.py:355 keystone/middleware/auth.py:130
msgid "Scoping to both domain and project is not allowed"
msgstr "Scoping till både domän och projekt tillåts inte"

#: keystone/auth/controllers.py:358
msgid "Scoping to both domain and trust is not allowed"
msgstr "Scoping till både domän och tillit tillåts inte"

#: keystone/auth/controllers.py:361
msgid "Scoping to both project and trust is not allowed"
msgstr "Scoping till både projekt och tillit tillåts inte"

#: keystone/auth/controllers.py:530
msgid "User not found"
msgstr "Användaren hittades inte"

#: keystone/auth/controllers.py:644
msgid "A project-scoped token is required to produce a service catalog."
msgstr "En projekt-scopad token krävs för att skapa en tjänstkatalog."

#: keystone/auth/plugins/external.py:42
msgid "No authenticated user"
msgstr "Inte en behörig användare"

#: keystone/auth/plugins/external.py:52
#, python-format
msgid "Unable to lookup user %s"
msgstr "Kunde inte slå upp användaren %s"

