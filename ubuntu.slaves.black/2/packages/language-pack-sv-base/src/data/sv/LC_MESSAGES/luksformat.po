#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Detta program måste startas som root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Skapa och formatera en krypterad LUKS-enhet\n"
"Användning: luksformat [-t <filsystem>] <enhet> [ mkfs-alternativ ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Fel: enhet monterad: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Fel: ogiltigt filsystem: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Fel: kunde inte generera tillfälligt namn för mappad enhet"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Skapar en krypterad enhet på %s…\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Kunde inte skapa LUKS-enhet %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Var god skriv in din lösenordsfras igen för att verifiera den\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Lösenordsfraserna du skrev in var inte identiska\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Kunde inte formatera enheten med filsystemet %s"
