#: ../duplicity/dup_time.py:63
#, python-format
msgid ""
"Bad interval string \"%s\"\n"
"\n"
"Intervals are specified like 2Y (2 years) or 2h30m (2.5 hours).  The\n"
"allowed special characters are s, m, h, D, W, M, and Y.  See the man\n"
"page for more information."
msgstr ""
"Dålig intervallsträng \"%s\"\n"
"\n"
"Intervall specificeras som 2Y (2 år) eller 2h30m (2,5 timmar).\n"
"Tillåtna specialtecken är s, m, h, D, W, M och Å. Se manualsidan\n"
"för mer information."

#: ../duplicity/dup_time.py:69
#, python-format
msgid ""
"Bad time string \"%s\"\n"
"\n"
"The acceptible time strings are intervals (like \"3D64s\"), w3-datetime\n"
"strings, like \"2002-04-26T04:22:01-07:00\" (strings like\n"
"\"2002-04-26T04:22:01\" are also acceptable - duplicity will use the\n"
"current time zone), or ordinary dates like 2/4/1997 or 2001-04-23\n"
"(various combinations are acceptable, but the month always precedes\n"
"the day)."
msgstr ""
"Dålig tidssträng \"%s\"\n"
"\n"
"Acceptabla tidssträngar är intervall (som \"3D64s\"), w3-datetime-\n"
"strängar, som \"2002-04-26T04:22:01-07:00\" (strängar som\n"
"\"2002-04-26T04:22:01\" går också bra - duplicity kommer att\n"
"använda aktuell tidszon), eller vanliga datum som 2/4/1997 eller\n"
"2001-04-23 (olika kombinationer går, men månad läses alltid före\n"
"dag)."

