#: ../duplicity/commandline.py:79
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"Use of default filenames is strongly suggested."
msgstr ""
"Varning: Alternativet %s håller på att avvecklas och kommer att tas bort i "
"en kommande\n"
"utgåva. Vi rekommenderar starkt att förvalda filnamn används."

#: ../duplicity/commandline.py:86
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"--include-filelist and --exclude-filelist now accept globbing characters and "
"should be used instead."
msgstr ""
"Varning: Alternativet %s håller på att avvecklas och kommer att tas bort i "
"en kommande\n"
"utgåva. --include-filelist och --exclude-filelist accepterar nu globbande "
"tecken och bör användas\n"
"istället."

#: ../duplicity/commandline.py:96
#, python-format
msgid ""
"Warning: Option %s is pending deprecation and will be removed in a future "
"release.\n"
"On many GNU/Linux systems, stdin is represented by /dev/stdin and\n"
"--include-filelist=/dev/stdin or --exclude-filelist=/dev/stdin could\n"
"be used as a substitute."
msgstr ""
"Varning: Alternativet %s håller på att avvecklas och kommer att tas bort i "
"en kommande\n"
"utgåva. På många GNU/Linux-system representeras stdin av /dev/stdin, och\n"
"--include-filelist=/dev/stdin eller --exclude-filelist)/dev/stdin kan "
"användas\n"
"istället."

