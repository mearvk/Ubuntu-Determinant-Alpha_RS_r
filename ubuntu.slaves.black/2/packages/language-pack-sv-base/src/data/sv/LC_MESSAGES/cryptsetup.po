msgstr "Hashalgoritmen %s stöds inte."

#: lib/setup.c:271 lib/loopaes/loopaes.c:90
#, c-format
msgid "Key processing error (using hash %s)."
msgstr "Fel vid nyckelbearbetning (använder hash %s)."

