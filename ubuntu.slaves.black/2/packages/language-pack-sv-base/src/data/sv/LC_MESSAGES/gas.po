#, c-format
msgid ""
"  -mQ - enable relaxation at assembly time. DANGEROUS!\n"
"  -mP - enable polymorph instructions\n"
msgstr ""
"  -mQ - aktivera lättnad i assembleringstid. FARLIGT!\n"
