msgstr "Daoust hag-eñ e tleer ober un trouz pa gevreer ouzh ur rouedad"

#: ../data/org.gnome.Empathy.gschema.xml.h:44
msgid "Play a sound when we log out"
msgstr "Seniñ ur son evit an dilugañ"

#: ../data/org.gnome.Empathy.gschema.xml.h:45
msgid "Whether to play a sound when logging out of a network."
msgstr "Daoust hag-eñ e tleer ober un trouz pa digevreer diouzh ur rouedad"

#: ../data/org.gnome.Empathy.gschema.xml.h:46
msgid "Enable popup notifications for new messages"
msgstr "Gweredekaat lagadennoù-kemenn evit ar c'hemennadoù nevez"

#: ../data/org.gnome.Empathy.gschema.xml.h:47
