msgstr "Jinak může dojít ke ztrátě neuloženého postupu."

#: ../DistUpgrade/DistUpgradeView.py:439
msgid "WSL restart required"
msgstr "Je vyžadován restart WSL"

#: ../DistUpgrade/DistUpgradeView.py:440
msgid "Exit this instance of Ubuntu WSL."
msgstr "Ukončit tuto instanci Ubuntu WSL."

#: ../DistUpgrade/DistUpgradeView.py:441
