#: src/exm-application.c:118
msgid ""
"A very simple tool for browsing, downloading, and managing GNOME shell "
"extensions."
msgstr ""
"Velmi jednoduchý nástroj na procházení, stahování a správu rozšíření GNOME "
"Shellu."

