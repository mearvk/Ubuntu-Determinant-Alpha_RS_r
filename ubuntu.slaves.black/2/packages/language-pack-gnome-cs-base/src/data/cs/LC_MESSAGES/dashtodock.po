#: Settings.ui.h:1
msgid ""
"When set to minimize, double clicking minimizes all the windows of the "
"application."
msgstr ""
"Pokud je nastavena minimalizace, dvojklik minimalizuje všechna okna aplikace."

#: Settings.ui.h:2
msgid "Shift+Click action"
msgstr "Shift + levé tlačítko"

#: Settings.ui.h:3
msgid "Raise window"
msgstr "Přenést okno do popředí"

#: Settings.ui.h:4
msgid "Minimize window"
msgstr "Minimalizovat okno"

#: Settings.ui.h:5
msgid "Launch new instance"
msgstr "Spustit novou instanci"

#: Settings.ui.h:6
msgid "Cycle through windows"
msgstr "Přepínat mezi okny"

#: Settings.ui.h:7
msgid "Minimize or overview"
msgstr "Minimalizovat nebo zobrazit přehled"

#: Settings.ui.h:8
msgid "Show window previews"
msgstr "Zobrazit náhledy oken"

#: Settings.ui.h:9
msgid "Minimize or show previews"
msgstr "Minimalizovat nebo zobrazit náhledy oken"

#: Settings.ui.h:10
msgid "Focus or show previews"
msgstr "Zaměřit nebo zobrazit náhledy oken"

#: Settings.ui.h:12
msgid "Focus, minimize or show previews"
msgstr "Zaměření, minimalizování nebo zobrazení náhledů"

#: Settings.ui.h:14
msgid "Quit"
msgstr "Ukončit"

#: Settings.ui.h:15
msgid "Behavior for Middle-Click."
msgstr "Chování při kliknutím prostředního tlačítka."

#: Settings.ui.h:16
msgid "Middle-Click action"
msgstr "Prostřední tlačítko"

#: Settings.ui.h:17
msgid "Behavior for Shift+Middle-Click."
msgstr ""
"Chování při kliknutím prostředního tlačítka a stiknuté klávese Shift."

#: Settings.ui.h:18
msgid "Shift+Middle-Click action"
msgstr "Shift + prostřední tlačítko"

#: Settings.ui.h:19
msgid "Enable Unity7 like glossy backlit items"
msgstr "Podsvícení ikon jako v Unity 7"

#: Settings.ui.h:20
msgid "Apply glossy effect."
msgstr "Uplatnit efekt lesku."

#: Settings.ui.h:21
msgid "Use dominant color"
msgstr "Použít převládající barvu ikony"

#: Settings.ui.h:22
msgid "Customize indicator style"
msgstr "Vlastní styl indikátorů"

#: Settings.ui.h:23
msgid "Color"
msgstr "Barva"

#: Settings.ui.h:24
msgid "Border color"
msgstr "Barva ohraničení"

#: Settings.ui.h:25
msgid "Border width"
msgstr "Šířka ohraničení"

#: Settings.ui.h:26
msgid "Show the dock on"
msgstr "Kde zobrazit dok"

#: Settings.ui.h:25
msgid "Show on all monitors."
msgstr "Zobrazit na všech obrazovkách"

#: Settings.ui.h:28
msgid "Position on screen"
msgstr "Umístění na obrazovce"

#: Settings.ui.h:30
msgid "Bottom"
msgstr "Dole"

#: Settings.ui.h:31
msgid "Top"
msgstr "Nahoře"

#: Settings.ui.h:33
msgid ""
"Hide the dock when it obstructs a window of the current application. More "
"refined settings are available."
msgstr ""
"Skrýt dok, pokud překáží oknu aktivní aplikace. K dispozici jsou podrobnější "
"nastavení."

#: Settings.ui.h:34
msgid "Intelligent autohide"
msgstr "Chytré skrývání"

#: Settings.ui.h:35
msgid "Dock size limit"
msgstr "Maximální velikost doku"

#: Settings.ui.h:36
msgid "Panel mode: extend to the screen edge"
msgstr "Režim panelu (roztáhnout dok po celé délce obrazovky)"

#: Settings.ui.h:38
msgid "Icon size limit"
msgstr "Maximální velikost ikon"

#: Settings.ui.h:39
msgid "Fixed icon size: scroll to reveal other icons"
msgstr ""
"Neměnná velikost ikon (rolováním na doku je možné zobrazit další ikony)"

#: Settings.ui.h:40
msgid "Preview size scale"
msgstr "Náhled velikosti měřítka"

#: Settings.ui.h:41
msgid "Position and size"
msgstr "Umístění a velikost"

#: prefs.js:242
msgid "Show favorite applications"
msgstr "Zobrazit oblíbené aplikace"

#: Settings.ui.h:43
msgid "Show running applications"
msgstr "Zobrazit spuštěné aplikace"

#: Settings.ui.h:41
msgid "Isolate workspaces."
msgstr "Izolovat pracovní plochy."

#: Settings.ui.h:42
msgid "Show urgent windows despite current workspace."
msgstr "Zobrazit naléhavá okna navzdory aktuální pracovní ploše."

#: Settings.ui.h:43
msgid "Isolate monitors."
msgstr "Izolovat obrazovky."

#: Settings.ui.h:44
msgid "Show open windows previews."
msgstr "Zobrazit náhledy otevřených oken."

#: Settings.ui.h:48
msgid "Keep the focused application always visible in the dash"
msgstr "Udržovat zaostřenou aplikaci vždy viditelnou na dash panelu"

#: Settings.ui.h:49
msgid ""
"If disabled, these settings are accessible from gnome-tweak-tool or the "
"extension website."
msgstr ""
"Pokud je zakázáno, jsou tato nastavení dostupná z GNOME Tweaks nebo z webové "
"stránky GNOME Shell Extensions."

#: Settings.ui.h:50
msgid "Show <i>Applications</i> icon"
msgstr "Tlačítko přístupu ke všem aplikacím"

#: Settings.ui.h:48
msgid "Move the applications button at the beginning of the dock."
msgstr "Přesunout tlačítko přístupu ke všem aplikacím na začátek doku"

#: Settings.ui.h:49
msgid "Animate <i>Show Applications</i>."
msgstr "Animace při zobrazení všech aplikací"

#: Settings.ui.h:54
msgid "Show trash can"
msgstr "Zobrazit koš"

#: Settings.ui.h:55
msgid "Show volumes and devices"
msgstr "Zobrazit svazky a zařízení"

#: Settings.ui.h:56
msgid "Only if mounted"
msgstr "Pouze pokud jsou připojeny"

#: Settings.ui.h:57
msgid "Include network volumes"
msgstr "Zahrnout síťové svazky"

#: Settings.ui.h:58
msgid "Isolate volumes, devices and trash windows from file manager"
msgstr "Oddělit svazky, zařízení a koše ze správce souborů"

#: Settings.ui.h:65
msgid "Launchers"
msgstr "Spouštěče"

#: Settings.ui.h:66
msgid ""
"Enable Super+(0-9) as shortcuts to activate apps. It can also be used "
"together with Shift and Ctrl."
msgstr ""
"Povolit klávesovou zkratku Super+[0-9] pro spuštění aplikací; tuto "
"klávesovou zkratku lze též použít s klávesami Shift a Ctrl."

#: Settings.ui.h:67
msgid "Use keyboard shortcuts to activate apps"
msgstr "Klávesová zkratka pro aktivaci aplikací"

#: Settings.ui.h:68
msgid "Behaviour when clicking on the icon of a running application."
msgstr "Chování při kliknutí na ikonu spuštěné aplikace."

#: Settings.ui.h:69
msgid "Click action"
msgstr "Kliknutí tlačítkem myši"

#: Settings.ui.h:70
msgid "Minimize"
msgstr "Minimalizovat"

#: Settings.ui.h:71
msgid "Behaviour when scrolling on the icon of an application."
msgstr "Chování při rolování na ikoně aplikace."

#: Settings.ui.h:72
msgid "Scroll action"
msgstr "Rolování kolečkem myši"

#: Settings.ui.h:73
msgid "Do nothing"
msgstr "Nedělat nic"

#: Settings.ui.h:74
msgid "Switch workspace"
msgstr "Přepnout pracovní plochu"

#: Settings.ui.h:75
msgid "Behavior"
msgstr "Chování"

#: Settings.ui.h:80
msgid ""
"Few customizations meant to integrate the dock with the default GNOME theme. "
"Alternatively, specific options can be enabled below."
msgstr ""
"Nastavení kvůli integraci doku s výchozím motivem GNOME; jinak lze použít "
"samostatné předvolby níže."

#: Settings.ui.h:81
msgid "Use built-in theme"
msgstr "Použít výchozí motiv doku"

#: Settings.ui.h:76
msgid "Save space reducing padding and border radius."
msgstr ""
"Prostorově méně náročné zobrazení (zmenšení volného místa kolem ikon)"

#: Settings.ui.h:77
msgid "Shrink the dash"
msgstr "Zmenšený dok"

#: Settings.ui.h:82
msgid "Customize windows counter indicators"
msgstr "Indikátory počtu otevřených oken"

#: Settings.ui.h:83
msgid "Default"
msgstr "Výchozí"

#: Settings.ui.h:84
msgid "Dots"
msgstr "Tečky"

#: Settings.ui.h:85
msgid "Squares"
msgstr "Čtverečky"

#: Settings.ui.h:86
msgid "Dashes"
msgstr "Čárky"

#: Settings.ui.h:87
msgid "Segmented"
msgstr "Dělená linka"

#: Settings.ui.h:88
msgid "Solid"
msgstr "Plná linka"

#: Settings.ui.h:89
msgid "Ciliora"
msgstr "Styl Ciliora"

#: Settings.ui.h:90
msgid "Metro"
msgstr "Styl Metro"

#: Settings.ui.h:92
msgid "Set the background color for the dash."
msgstr "Nastavit barvu pozadí doku."

#: Settings.ui.h:93
msgid "Customize the dash color"
msgstr "Vlastní barva doku"

#: Settings.ui.h:94
msgid "Tune the dash background opacity."
msgstr "Nastavit průhlednost doku."

#: Settings.ui.h:96
msgid "Fixed"
msgstr "Neměnná"

#: Settings.ui.h:97
msgid "Dynamic"
msgstr "Dynamická"

#: Settings.ui.h:98
msgid "Opacity"
msgstr "Průhlednost"

#: Settings.ui.h:78
msgid "Force straight corner"
msgstr "Zakázat zaoblené rohy"

#: Settings.ui.h:79
msgid "Show overview on startup"
msgstr "Zobrazit přehled při spuštění"

#: Settings.ui.h:99
msgid "Appearance"
msgstr "Vzhled"

#: Settings.ui.h:100
msgid "version: "
msgstr "verze: "

#: Settings.ui.h:101
msgid "Moves the dash out of the overview transforming it in a dock"
msgstr "Vytvoří dok z přehledu činností a oblíbených aplikací"

#: Settings.ui.h:102
msgid "Created by"
