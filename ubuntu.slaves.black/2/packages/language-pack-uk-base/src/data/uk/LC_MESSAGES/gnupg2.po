#, c-format
msgid "SETERROR %s (try %d of %d)"
msgstr "SETERROR %s (спроба %d з %d)"

#: agent/call-pinentry.c:1468 agent/call-pinentry.c:1732
msgid "Repeat:"
msgstr "Повторіть:"

#: agent/call-pinentry.c:1480 agent/call-pinentry.c:1492
