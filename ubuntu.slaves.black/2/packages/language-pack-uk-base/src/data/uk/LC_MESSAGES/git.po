#: git-add--interactive.perl:1251
msgid ""
"y - stage this hunk\n"
"n - do not stage this hunk\n"
"q - quit; do not stage this hunk or any of the remaining ones\n"
"a - stage this hunk and all later hunks in the file\n"
"d - do not stage this hunk or any of the later hunks in the file"
msgstr ""
"y - спорядити цей блок змін\n"
"n - не споряджати цей блок змін\n"
"q - вихід; не споряджати цей і наступні блоки змін\n"
"a - спорядити цей і всі наступні блоки змін у файлі\n"
"d - не споряджати цей і наступні блоки змін у файлі"

#: git-add--interactive.perl:1257
msgid ""
"y - stash this hunk\n"
"n - do not stash this hunk\n"
"q - quit; do not stash this hunk or any of the remaining ones\n"
"a - stash this hunk and all later hunks in the file\n"
"d - do not stash this hunk or any of the later hunks in the file"
msgstr ""
"y - сховати зміни цього блоку\n"
"q - вихід; не ховати зміни цього і наступних блоків\n"
"a - сховати цей і всі наступні блоки змін у файлі\n"
"d - не ховати цей і наступні блоки змін у файлі"

#: git-add--interactive.perl:1263
msgid ""
"y - unstage this hunk\n"
"n - do not unstage this hunk\n"
"q - quit; do not unstage this hunk or any of the remaining ones\n"
"a - unstage this hunk and all later hunks in the file\n"
"d - do not unstage this hunk or any of the later hunks in the file"
msgstr ""
"y - скасувати спорядження цього блоку змін\n"
"n - не скасовувати спорядження цього блоку змін\n"
"q - вихід; не скасовувати спорядження цього і наступних блоків змін\n"
"a - скасувати спорядження цього і всіх наступних блоків змін у файлі\n"
"d - не скасовувати спорядження цього або будь-яких наступних блоків змін у "
"файлі"

#: git-add--interactive.perl:1269
msgid ""
"y - apply this hunk to index\n"
"n - do not apply this hunk to index\n"
"q - quit; do not apply this hunk or any of the remaining ones\n"
"a - apply this hunk and all later hunks in the file\n"
"d - do not apply this hunk or any of the later hunks in the file"
msgstr ""
"y - застосувати цей блок змін до індексу\n"
"n - не застосовувати цей блок змін до індексу\n"
"q - вихід; не не застосовувати цей і наступні блоки змін\n"
"a - застосувати цей і всі наступні блоки змін у файлі\n"
"d - не застосовувати цей і всі наступні блоки змін у файлі"

#: git-add--interactive.perl:1275 git-add--interactive.perl:1293
msgid ""
"y - discard this hunk from worktree\n"
"n - do not discard this hunk from worktree\n"
"q - quit; do not discard this hunk or any of the remaining ones\n"
"a - discard this hunk and all later hunks in the file\n"
"d - do not discard this hunk or any of the later hunks in the file"
msgstr ""
"y - скасувати зміни цього блоку в робочому каталозі\n"
"n - не скасовувати зміни цього блоку в робочому каталозі\n"
"q - вихід; не скасовувати зміни цього блоку і всіх наступних\n"
"a - скасувати зміни цього і всіх наступних блоків змін у файлі\n"
"d - не скасовувати зміни цього і всіх наступних блоків змін у файлі"

#: git-add--interactive.perl:1281
msgid ""
"y - discard this hunk from index and worktree\n"
"n - do not discard this hunk from index and worktree\n"
"q - quit; do not discard this hunk or any of the remaining ones\n"
"a - discard this hunk and all later hunks in the file\n"
"d - do not discard this hunk or any of the later hunks in the file"
msgstr ""
"y - скасувати зміни цього блоку в індексі і робочому каталозі\n"
"n - не скасовувати зміни цього блоку в індексі і робочому каталозі\n"
"q - вихід; не скасовувати зміни цього блоку і всіх наступних\n"
"a - скасувати зміни цього і всіх наступних блоків змін у файлі\n"
"d - не скасовувати зміни цього і всіх наступних блоків змін у файлі"

#: git-add--interactive.perl:1287
msgid ""
"y - apply this hunk to index and worktree\n"
"n - do not apply this hunk to index and worktree\n"
"q - quit; do not apply this hunk or any of the remaining ones\n"
"a - apply this hunk and all later hunks in the file\n"
"d - do not apply this hunk or any of the later hunks in the file"
msgstr ""
"y - застосувати зміни цього блоку до індексу та робочого каталогу\n"
"n - не застосувати зміни цього блоку до індексу та робочого каталогу\n"
"q - вихід; не застосовувати зміни цього і всіх наступних блоків\n"
"a - застосувати зміни цього і всіх наступних блоків змін у файлі\n"
"d - не застосовувати зміни цього і всіх наступних блоків змін у файлі"

#: git-add--interactive.perl:1299
msgid ""
"y - apply this hunk to worktree\n"
"n - do not apply this hunk to worktree\n"
"q - quit; do not apply this hunk or any of the remaining ones\n"
"a - apply this hunk and all later hunks in the file\n"
"d - do not apply this hunk or any of the later hunks in the file"
msgstr ""

#: git-add--interactive.perl:1314
msgid ""
"g - select a hunk to go to\n"
"/ - search for a hunk matching the given regex\n"
"j - leave this hunk undecided, see next undecided hunk\n"
"J - leave this hunk undecided, see next hunk\n"
"k - leave this hunk undecided, see previous undecided hunk\n"
"K - leave this hunk undecided, see previous hunk\n"
"s - split the current hunk into smaller hunks\n"
"e - manually edit the current hunk\n"
"? - print help\n"
msgstr ""
"g - вибрати блок змін, на котрий потрібно перейти\n"
"/ - пошук блоку змін, що відповідає регулярному виразу\n"
"j - не приймати рішення по цьому блоку, перейти до наступного невирішеного "
"блоку\n"
"J - не  приймати рішення по цьому блоку, перейти до наступного блоку змін\n"
"k - не  приймати рішення по цьому блоку, перейти до попереднього "
"невирішеного блоку\n"
"K - не  приймати рішення по цьому блоку, перейти до попереднього блоку змін\n"
"s - розбити поточний блок змін на блоки меншого розміру\n"
"e - вручну відредагувати поточний блок змін\n"
"? - вивести довідку\n"

