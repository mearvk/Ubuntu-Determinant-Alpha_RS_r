msgid "Passphrase too long"
msgstr "Frase contraseña demasiado larga"

#: agent/call-pinentry.c:1489 agent/call-pinentry.c:1753
msgid "Invalid characters in PIN"
msgstr "Caracteres inválidos en el PIN"

