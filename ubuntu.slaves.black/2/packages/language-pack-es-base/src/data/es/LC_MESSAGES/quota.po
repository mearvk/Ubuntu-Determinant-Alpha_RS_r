#: rquota_svc.c:86
#, c-format
msgid ""
"Usage: %s [options]\n"
"Options are:\n"
" -h --help             shows this text\n"
" -V --version          shows version information\n"
" -F --foreground       starts the quota service in foreground\n"
" -I --autofs           do not ignore mountpoints mounted by automounter\n"
" -p --port <port>      listen on given port\n"
" -s --no-setquota      disables remote calls to setquota (default)\n"
" -S --setquota         enables remote calls to setquota\n"
" -x --xtab <path>      set an alternative file with NFSD export table\n"
msgstr ""
"Uso: %s [OPCIONES]\n"
"Opciones disponibles:\n"
" -h --help muestra este texto\n"
" -V --version muestra información sobre la versión\n"
" -F --foreground inicia el servicio de cuota en segundo plano\n"
" -l --autofs no ignora los puntos de montaje montados por automounter\n"
" -p --port <puerto> escucha en el puerto especificado\n"
" -s --no-setquota deshabilita las llamadas remotas a setquota "
"(predeterminado)\n"
" -S --setquota habilita llamadas remotas a setquota\n"
" -x --xtab <ruta> establece un archivo alternativo con tabla de exportación "
"NFSD\n"

