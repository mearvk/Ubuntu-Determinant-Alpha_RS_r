#: src/main.cc:191
#, c-format
msgid "Usage: aptitude [-S fname] [-u|-i]"
msgstr "Uso: aptitude [-S nombre_archivo] [-u|-i]"

#: src/main.cc:193
#, c-format
msgid "       aptitude [options] <action> ..."
msgstr "       aptitude [opciones] <acción> ..."

#: src/main.cc:196
#, c-format
msgid ""
"Actions (if none is specified, aptitude will enter interactive mode):\n"
"\n"
msgstr ""
"Acciones (si no se especifica ninguna, aptitude entrará al modo "
"interactivo):\n"
"\n"

#: src/main.cc:197
#, c-format
msgid " install         Install/upgrade packages.\n"
msgstr " install         Instalar/actualizar paquetes.\n"

#: src/main.cc:198
#, c-format
msgid " remove          Remove packages.\n"
msgstr " remove          Eliminar paquetes.\n"

#: src/main.cc:199
#, c-format
msgid " purge           Remove packages and their configuration files.\n"
msgstr ""
" purge           Eliminar paquetes y sus archivos de configuración.\n"

#: src/main.cc:200
#, c-format
msgid " hold            Place packages on hold.\n"
msgstr " hold            Situar los paquetes en bloqueo.\n"

#: src/main.cc:201
#, c-format
msgid " unhold          Cancel a hold command for a package.\n"
msgstr " unhold          Cancelar un comando de bloqueo para un paquete.\n"

#: src/main.cc:202
#, c-format
msgid ""
" markauto        Mark packages as having been automatically installed.\n"
msgstr ""
" markauto        Marcar los paquetes como si se hubieran instalado "
"automáticamente.\n"

#: src/main.cc:203
#, c-format
msgid " unmarkauto      Mark packages as having been manually installed.\n"
msgstr ""
" unmarkauto      Marcar los paquetes como si se hubieran instalado "
"manualmente.\n"

#: src/main.cc:204
#, c-format
msgid ""
" forbid-version  Forbid aptitude from upgrading to a specific package "
"version.\n"
msgstr ""
" forbid-version  Prohibir a aptitude actualizar a una versión de paquete "
"específica.\n"

#: src/main.cc:205
#, c-format
msgid " update          Download lists of new/upgradable packages.\n"
msgstr ""
" update          Descargar listas de paquetes nuevos/actualizables.\n"

#: src/main.cc:206
#, c-format
msgid " safe-upgrade    Perform a safe upgrade.\n"
msgstr " safe-upgrade    Realizar una actualización segura.\n"

#: src/main.cc:207
#, c-format
msgid ""
" full-upgrade    Perform an upgrade, possibly installing and removing "
"packages.\n"
msgstr ""
" full-upgrade    Realizar una actualización, posiblemente instalando y "
"eliminando paquetes.\n"

#: src/main.cc:208
#, c-format
msgid " build-dep       Install the build-dependencies of packages.\n"
msgstr ""
" build-dep       Instalar las dependencias de compilación de paquetes.\n"

#: src/main.cc:209
#, c-format
msgid " forget-new      Forget what packages are \"new\".\n"
msgstr " forget-new      Olvidar qué paquetes son «nuevos».\n"

#: src/main.cc:210
#, c-format
msgid " search          Search for a package by name and/or expression.\n"
msgstr " search          Buscar un paquete por nombre y/o expresión.\n"

#: src/main.cc:211
#, c-format
msgid " show            Display detailed info about a package.\n"
msgstr " show            Mostrar información detallada sobre un paquete.\n"

#: src/main.cc:212
#, c-format
msgid ""
" showsrc         Display detailed info about a source package (apt "
"wrapper).\n"
msgstr ""
" showsrc         Muestra información detallada sobre un paquete origen "
"(envoltorio de apt).\n"

#: src/main.cc:213
#, c-format
msgid " versions        Displays the versions of specified packages.\n"
msgstr " versions        Mostrar las versiones de paquetes especificados.\n"

#: src/main.cc:214
#, c-format
msgid " clean           Erase downloaded package files.\n"
msgstr " clean           Borrar los archivos del paquetes descargados.\n"

#: src/main.cc:215
#, c-format
msgid " autoclean       Erase old downloaded package files.\n"
msgstr ""
" autoclean       Borrar los archivos viejos de paquetes descargados.\n"

#: src/main.cc:216
#, c-format
msgid " changelog       View a package's changelog.\n"
msgstr " changelog       Ver el registro de cambios de un paquete.\n"

#: src/main.cc:217
#, c-format
msgid ""
" download        Download the .deb file for a package (apt wrapper).\n"
msgstr ""
" download        Descarga el archivo .deb de un paquete (envoltorio de "
"apt).\n"

#: src/main.cc:218
#, c-format
msgid " source          Download source package (apt wrapper).\n"
msgstr " source          Descarga el paquete origen (envoltorio de apt).\n"

#: src/main.cc:219
#, c-format
msgid " reinstall       Reinstall a currently installed package.\n"
msgstr " reinstall       Reinstalar un paquete actualmente instalado.\n"

#: src/main.cc:220
#, c-format
msgid ""
" why             Explain why a particular package should be installed.\n"
msgstr ""
" why             Explicar por qué se debe instalar un paquete en "
"particular.\n"

#: src/main.cc:221
#, c-format
msgid ""
" why-not         Explain why a particular package cannot be installed.\n"
msgstr ""
" why-not         Explicar por qué no se puede instalar un paquete en "
"particular.\n"

#: src/main.cc:223
#, c-format
msgid " add-user-tag    Add user tag to packages/patterns.\n"
msgstr ""
" add-user-tag    Añadir la etiqueta de usuario a paquetes/patrones.\n"

#: src/main.cc:224
#, c-format
msgid " remove-user-tag Remove user tag from packages/patterns.\n"
msgstr ""
" remove-user-tag Eliminar la etiqueta de usuario de paquetes/patrones.\n"

#: src/main.cc:226
#, c-format
msgid "Options:\n"
msgstr "Opciones:\n"

#: src/main.cc:227
#, c-format
msgid " -h              This help text.\n"
msgstr " -h              Este texto de ayuda.\n"

#: src/main.cc:229
#, c-format
msgid ""
" --gui           Use the GTK GUI even if disabled in the configuration.\n"
msgstr ""
" --gui           Usar la GUI GTK incluso si está desactivada en la "
"configuración.\n"

#: src/main.cc:231
#, c-format
msgid " --no-gui        Do not use the GTK GUI even if available.\n"
msgstr " --no-gui        No usar la GUI GTK incluso si está disponible.\n"

#: src/main.cc:233
#, c-format
msgid " --qt            Use the Qt GUI.\n"
msgstr " --qt            Usar la GUI Qt.\n"

#: src/main.cc:234
#, c-format
msgid ""
" --no-qt         Do not use the Qt GUI even if enabled in the "
"configuration.\n"
msgstr ""
" --no-qt         No usar la GUI Qt incluso si está activada en la "
"configuración.\n"

#: src/main.cc:236
#, c-format
msgid ""
" -s              Simulate actions, but do not actually perform them.\n"
msgstr " -s              Simular las acciones, pero no realizarlas.\n"

#: src/main.cc:237
#, c-format
msgid ""
" -d              Only download packages, do not install or remove anything.\n"
msgstr ""
" -d              Solo paquetes descargados, no instalar o eliminar nada.\n"

#: src/main.cc:238
#, c-format
msgid " -P              Always prompt for confirmation of actions.\n"
msgstr " -P              Solicitar siempre la confirmación de acciones.\n"

#: src/main.cc:239
#, c-format
msgid ""
" -y              Assume that the answer to simple yes/no questions is "
"'yes'.\n"
msgstr ""
" -y              Asumir que la respuesta a preguntas simples de si/no es "
"«si».\n"

#: src/main.cc:240
#, c-format
msgid ""
" -F format       Specify a format for displaying search results; see the "
"manual.\n"
msgstr ""
" -F format       Especificar un formato para mostrar resultados de búsqueda; "
"vea el manual.\n"

#: src/main.cc:241
#, c-format
msgid ""
" -O order        Specify how search results should be sorted; see the "
"manual.\n"
msgstr ""
" -O order        Especificar cómo deben ordenarse los resultados de "
"búsqueda; vea el manual.\n"

#: src/main.cc:242
#, c-format
msgid ""
" -w width        Specify the display width for formatting search results.\n"
msgstr ""
" -w width        Especificar el ancho de visualización para formatear los "
"resultados de búsqueda.\n"

#: src/main.cc:243
#, c-format
msgid " -f              Aggressively try to fix broken packages.\n"
msgstr ""
" -f              Tratar de arreglar los paquetes rotos de forma agresiva.\n"

#: src/main.cc:244
#, c-format
msgid ""
" -V              Show which versions of packages are to be installed.\n"
msgstr " -V              Mostrar qué versiones de paquetes se instalarán.\n"

#: src/main.cc:245
#, c-format
msgid ""
" -D              Show the dependencies of automatically changed packages.\n"
msgstr ""
" -D              Mostrar las dependencias de paquetes cambiados "
"automáticamente.\n"

#: src/main.cc:246
#, c-format
msgid " -Z              Show the change in installed size of each package.\n"
msgstr ""
" -Z              Mostrar el cambio en el tamaño instalado de cada paquete.\n"

#: src/main.cc:247
#, c-format
msgid ""
" -v              Display extra information. (may be supplied multiple "
"times).\n"
msgstr ""
" -v              Mostrar información extra (se puede suministrar varias "
"veces).\n"

#: src/main.cc:248
#, c-format
msgid ""
" -t [release]    Set the release from which packages should be installed.\n"
msgstr ""
" -t [release]    Establecer la versión desde la que se instalarán los "
"paquetes.\n"

#: src/main.cc:249
#, c-format
msgid ""
" -q              In command-line mode, suppress the incremental progress\n"
"                  indicators.\n"
msgstr ""
" -q              En modo de línea de comandos, suprimir los indicadores\n"
"                  incrementales de progreso.\n"

#: src/main.cc:251
#, c-format
msgid " -o key=val      Directly set the configuration option named 'key'.\n"
msgstr ""
" -o key=val      Establecer directamente la opción de configuración llamada "
"«key».\n"

#: src/main.cc:252
#, c-format
msgid ""
" --with(out)-recommends     Specify whether or not to treat recommends as\n"
"                            strong dependencies.\n"
msgstr ""
" --with(out)-recommends     Especificar si tratar o no las recomendaciones "
"como\n"
"                            dependencias fuertes.\n"

#: src/main.cc:254
#, c-format
msgid " -S fname        Read the aptitude extended status info from fname.\n"
msgstr ""
" -S fname        Leer la información de estado extendido de aptitude de "
"fname.\n"

#: src/main.cc:255
#, c-format
msgid " -u              Download new package lists on startup.\n"
msgstr " -u              Descargar nuevas listas de paquetes al inicio.\n"

#: src/main.cc:256 src/main.cc:258
#, c-format
msgid "                  (terminal interface only)\n"
msgstr "                  (solo interfaz de terminal)\n"

#: src/main.cc:257
#, c-format
msgid " -i              Perform an install run on startup.\n"
msgstr " -i              Realizar una instalación al inicio.\n"

