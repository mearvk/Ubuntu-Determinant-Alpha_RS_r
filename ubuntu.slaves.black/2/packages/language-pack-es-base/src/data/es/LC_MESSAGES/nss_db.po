"ARCHIVO-ENTRADA ARCHIVO-SALIDA\n"
"-o ARCHIVO-SALIDA ARCHIVO-ENTRADA\n"
"-u ARCHIVO-ENTRADA"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "número de argumentos erróneo"

