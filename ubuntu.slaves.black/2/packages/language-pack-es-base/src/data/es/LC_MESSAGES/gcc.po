msgstr "-fdiagnostics-color=[never|always|auto]\tColorea los diagnósticos."

#: common.opt:1306
#, no-c-format
msgid "-fdiagnostics-urls=[never|always|auto]\tEmbed URLs in diagnostics."
msgstr ""

#: common.opt:1326
#, no-c-format
msgid "-fdiagnostics-format=[text|json]\tSelect output format."
msgstr ""

