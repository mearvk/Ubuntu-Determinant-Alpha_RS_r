#, no-c-format
msgid "Use f2c calling convention."
msgstr "Usar el convenio de llamada f2c."

#: fortran/lang.opt:546
#, no-c-format
msgid "Assume that the source file is fixed form."
msgstr "Asume que el fichero fuente es de formato fijo."

