msgid "  or: "
msgstr "  o: "

#: gl/lib/argp-help.c:1643
msgid " [OPTION...]"
msgstr " [OPCIÓN...]"

#: gl/lib/argp-help.c:1670
#, c-format
msgid "Try '%s --help' or '%s --usage' for more information.\n"
msgstr "Pruebe «%s --help» o «%s --usage» para más información.\n"

