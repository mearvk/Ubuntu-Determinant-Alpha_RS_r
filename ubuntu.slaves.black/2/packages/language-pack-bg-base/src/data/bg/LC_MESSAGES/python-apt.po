#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Сървър за %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Основен сървър"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Сървъри по избор"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr ""

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Невалиден уникод в описанието за «%s» (%s). Моля докладвайте."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Дневника с промени е недостъпен"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Дневника с промени все още не е достъпен.\n"
"\n"
"Моля, използвайте http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"докато не стане достъпен дневника с промените или опитайте отново по-късно."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Неуспешно изтегляне на дневника с промени. \n"
"Моля, проверете интернет връзката си."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Списъкът с файлове за «%s» не може да бъде прочетен"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Списъкът с контролните файлове за «%s» не може да бъде прочетен"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Зависимостите не са изпълними: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "В противоречие с инсталирания пакет «%s»"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Чупи съществуващият пакет «%(pkgname)s», който е зависимост %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Чупи съществуващият пакет «%(pkgname)s», който е в конфликт с: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Чупи съществуващият пакет «%(pkgname)s», който е в конфликт с: "
"«%(targetpkg)s». Но «%(debfile)s» го осигурява чрез: «%(provides)s»"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Няма поле за архитектура в пакета"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Вече е инсталирана по-нова версия"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Неуспешен опит да изпълни всички зависимости (счупен кеш)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Не може да се инсталира «%s»"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Автоматично разархивиран:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Автоматично преобразуван в ASCII данни за печат:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Инсталирай зависимостите за пакета с изходен код «%s», който събира %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Ще бъде премахнат важен пакет"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Готово"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Поп "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Игн "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Грш "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Получено:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [В процес на работа]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Смяна на носител: сложете диска с етикет\n"
" «%s»\n"
"в устройството «%s» и натиснете «Enter»\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Изтеглени са %sБ за %s (%sБ/сек)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
