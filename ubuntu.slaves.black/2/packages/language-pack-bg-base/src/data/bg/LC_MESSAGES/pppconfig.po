#: pppconfig:255
msgid "Create a connection"
msgstr "Създаване на връзка"

#: pppconfig:259
#, perl-format
msgid "Change the connection named %s"
msgstr "Промяна на връзка с името %s"

#: pppconfig:262
#, perl-format
