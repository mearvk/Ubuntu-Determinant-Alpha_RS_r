#. everyone can issue "--help" and "--version", but only root can go on
#: ../adduser:161
msgid "Only root may add a user or group to the system.\n"
msgstr ""
"ફક્ત મુખ્ય વપરાશકર્તા જ નવો વપરાશકર્તા અથવા નવું વપરાશકર્તાઓનું જૂથ ઉમેરી "
"શકે છે.\n"

#: ../adduser:191 ../deluser:145
msgid "Only one or two names allowed.\n"
msgstr "આપ માત્ર એક અથવા વધુમા વધુ બે નામ આપી શકો છો.\n"

#: ../adduser:197
msgid "Specify only one name in this mode.\n"
msgstr "આ કાર્યપ્રકાર(mode)માં માત્ર એક જ નામ આપો.\n"

#: ../adduser:224
msgid "The --group, --ingroup, and --gid options are mutually exclusive.\n"
msgstr ""
"આપ --group, --ingroup અને --gid વિકલ્પોમાંથી કોઇપણ એક જ વિકલ્પ પસંદ કરી શકો "
"છો.\n"

#: ../adduser:229
msgid "The home dir must be an absolute path.\n"
msgstr "હોમ ફોલ્ડરનો પૂરેપૂરો પાથ આપો.\n"

#: ../adduser:233
#, perl-format
msgid "Warning: The home dir %s you specified already exists.\n"
msgstr "ચેતવણી: તમે દર્શાવેલી ઘર ડિરેક્ટરી %s પહેલેથી જ મૌજૂદ છે.\n"

#: ../adduser:235
#, perl-format
msgid "Warning: The home dir %s you specified can't be accessed: %s\n"
msgstr "ચેતવણી: તમે દર્શાવેલી ઘર ડિરેક્ટરી %s સુધી પહોચી શકાતુ નથી: %s\n"

#: ../adduser:305
#, perl-format
msgid "The group `%s' already exists as a system group. Exiting.\n"
msgstr ""
"`%s' જૂથ (ગ્રુપ) પહેલેથી સિસ્ટમ જૂથ(ગ્રુપ) તરીકે અસ્તિત્વ ધરાવે છે. કાર્ય "
"અપૂર્ણ.\n"

#: ../adduser:310
#, perl-format
msgid "The group `%s' already exists and is not a system group. Exiting.\n"
msgstr ""
"`%s' જૂથ(ગ્રુપ) પહેલેથી અસ્તિત્વમાં છે પરંતુ એ સિસ્ટમ જૂથ(ગ્રુપ) નથી. કાર્ય "
"અપૂર્ણ.\n"

#: ../adduser:315
#, perl-format
msgid "The group `%s' already exists, but has a different GID. Exiting.\n"
msgstr ""
"`%s' જૂથ(ગ્રુપ) પહેલેથી અસ્તિત્વમાં છે પરંતુ અલગ GID ધરાવે છે. કાર્ય "
"અપૂર્ણ.\n"

#: ../adduser:320 ../adduser:354
#, perl-format
msgid "The GID `%s' is already in use.\n"
msgstr "GID `%s' હાલમાં વપરાશમાં છે.\n"

#: ../adduser:330
#, perl-format
msgid ""
"No GID is available in the range %d-%d (FIRST_SYS_GID - LAST_SYS_GID).\n"
msgstr "%d-%d (FIRST_SYS_GID - LAST_SYS_GID) ની વચ્ચે એકપણ GID ઉપલબ્ધ નથી.\n"

#: ../adduser:331 ../adduser:372
#, perl-format
msgid "The group `%s' was not created.\n"
msgstr "`%s' જૂથ(ગ્રુપ) બની શક્યુ નથી.\n"

#: ../adduser:336 ../adduser:376
#, perl-format
msgid "Adding group `%s' (GID %d) ...\n"
msgstr "`%s' (GID %d) જૂથ(ગ્રુપ) ઉમેરવામા આવી રહ્યું છે ...\n"

#: ../adduser:340 ../adduser:380 ../adduser:404 ../deluser:366 ../deluser:400
#: ../deluser:440
msgid "Done.\n"
msgstr "સમાપ્ત.\n"

#: ../adduser:351 ../adduser:991
#, perl-format
msgid "The group `%s' already exists.\n"
msgstr "જૂથ `%s' પહેલેથી અસ્તિત્વમાં છે.\n"

#: ../adduser:371
#, perl-format
msgid "No GID is available in the range %d-%d (FIRST_GID - LAST_GID).\n"
msgstr "%d-%d (FIRST_GID - LAST_GID) ની વચ્ચે એકપણ GID  ઉપલબ્ધ નથી.\n"

#: ../deluser:447
#, perl-format
msgid "The user `%s' does not exist.\n"
msgstr "વપરાશકર્તા `%s' નું આ કોમ્પુટર સિસ્ટમમાં અસ્તિત્વ નથી.\n"

#: ../deluser:451
#, perl-format
msgid "The group `%s' does not exist.\n"
msgstr "જૂથ `%s' નું આ કોમ્પુટર સિસ્ટમમાં અસ્તિત્વ નથી.\n"

#: ../adduser:394 ../adduser:788
#, perl-format
