msgstr "GID %d નું અસ્તિત્વ નથી.\n"

#: ../adduser:1043
#, perl-format
msgid ""
"Cannot deal with %s.\n"
"It is not a dir, file, or symlink.\n"
msgstr ""
"%s સાથે કામ ના કરી શકાયું.\n"
"આવી કોઇ ડીરેક્ટરી, ફાઇલ કે સાંકેતિક કડી(symlink) નથી.\n"

#: ../adduser:915
#, perl-format
msgid ""
"%s: To avoid problems, the username should consist only of\n"
"letters, digits, underscores, periods, at signs and dashes, and not start "
"with\n"
"a dash (as defined by IEEE Std 1003.1-2001). For compatibility with Samba\n"
"machine accounts $ is also supported at the end of the username\n"
msgstr ""
"%s: તકલીફો નિવારવા માટે, વપરાશકર્તાના નામ(username)માં માત્ર\n"
"અક્ષરો, અંકો, અંડરસ્કોર(underscores), પૂર્ણવિરામ, @ નિશાની અને ડેશ(-) જ હોવા "
"જોઇએ\n"
"અને ડેશથી શરુ ના થવું જોઇએ (IEEE Std 1003.1-2001 પ્રમાણે નિર્ધારિત). Samba "
"મશીનનાં\n"
"ખાતાંઓનાં સુમેલ માટે $ પણ વપરાશકર્તાના નામ(username)ના અંતે વાપરી શકાય.\n"

#: ../adduser:1104
msgid "Allowing use of questionable username.\n"
msgstr "વાંધાજનક વપરાશકર્તા નામનો વપરાશ ચલાવી રહ્યા છીએ.\n"

#: ../adduser:929
#, perl-format
msgid ""
"%s: Please enter a username matching the regular expression configured\n"
"via the NAME_REGEX[_SYSTEM] configuration variable.  Use the `--force-"
"badname'\n"
"option to relax this check or reconfigure NAME_REGEX.\n"
msgstr ""

