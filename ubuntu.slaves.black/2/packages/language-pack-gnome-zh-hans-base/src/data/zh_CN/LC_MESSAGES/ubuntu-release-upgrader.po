msgid "In /etc/update-manager/release-upgrades Prompt "
msgstr "在 /etc/update-manager/release-upgrades 中提示 "

#: ../do-release-upgrade:160
msgid "is set to never so upgrading is not possible."
msgstr "因为被设定成永不执行所以无法升级"

