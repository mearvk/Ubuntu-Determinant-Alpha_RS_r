msgid "Failed to allocated required memory."
msgstr "分配请求的内存失败。"

#: sys/v4l2/gstv4l2src.c:977 sys/v4l2/gstv4l2videodec.c:695
#: sys/v4l2/gstv4l2videodec.c:1064 sys/v4l2/gstv4l2videoenc.c:861
