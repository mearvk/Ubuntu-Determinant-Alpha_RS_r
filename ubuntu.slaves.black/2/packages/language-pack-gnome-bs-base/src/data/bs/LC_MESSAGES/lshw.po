#: ../lshw.cc:24
#, c-format
msgid "usage: %s [-format] [-options ...]\n"
msgstr "upotreba: %s [-format] [-opcije ...]\n"

#: ../lshw.cc:25
#, c-format
msgid "       %s -version\n"
msgstr "       %s -version\n"

#: ../lshw.cc:27
#, c-format
msgid "\t-version        print program version (%s)\n"
msgstr "\t-version        prikaži verziju programa (%s)\n"

#: ../lshw.cc:28
#, c-format
msgid ""
"\n"
"format can be\n"
msgstr ""
"\n"
"format može biti\n"

#: ../lshw.cc:29
#, c-format
msgid "\t-html           output hardware tree as HTML\n"
msgstr "\t-html           prikaži harversko stablo kao HTML\n"

#: ../lshw.cc:30
#, c-format
msgid "\t-xml            output hardware tree as XML\n"
msgstr "\t-xml            prikaži harversko stablo kao XML\n"

#: ../lshw.cc:31
#, c-format
msgid "\t-short          output hardware paths\n"
msgstr "\t-short          prikaži harverske putanje\n"

#: ../lshw.cc:32
#, c-format
msgid "\t-businfo        output bus information\n"
msgstr "\t-businfo        informacije o izlaznoj sabirnici\n"

#: ../lshw.cc:34
#, c-format
msgid "\t-X              use graphical interface\n"
msgstr "\t-X              koristi grafički interfejs\n"

#: ../lshw.cc:35
#, c-format
msgid ""
"\n"
"options can be\n"
msgstr ""
"\n"
"opcije mogu biti\n"

#: ../lshw.cc:37
#, c-format
msgid "\t-class CLASS    only show a certain class of hardware\n"
msgstr "\t-class KLASA    prikaži samo određenu klasu hardvera\n"

#: ../lshw.cc:38
#, c-format
msgid "\t-C CLASS        same as '-class CLASS'\n"
msgstr "\t-C KLASA        isto kao '-class KLASA'\n"

#: ../lshw.cc:39
#, c-format
msgid "\t-c CLASS        same as '-class CLASS'\n"
msgstr "\t-c KLASA        isto kao '-class KLASA'\n"

#: ../lshw.cc:41
#, c-format
msgid "\t-disable TEST   disable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr "\t-disable TEST   onemogući test (poput pci, isapnp, cpuid, itd. )\n"

#: ../lshw.cc:43
#, c-format
msgid "\t-enable TEST    enable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr "\t-enable TEST    onmogući test (poput pci, isapnp, cpuid, itd. )\n"

#: ../lshw.cc:44
#, c-format
msgid "\t-quiet          don't display status\n"
msgstr "\t-quiet          ne prikazuj status\n"

#: ../lshw.cc:45
#, c-format
msgid ""
"\t-sanitize       sanitize output (remove sensitive information like serial "
"numbers, etc.)\n"
msgstr ""
"\t-sanitize       sredi izlaz (ukloni osjetljive informacije poput serijskih "
"brojeva.)\n"

#: ../lshw.cc:46
#, c-format
msgid "\t-numeric        output numeric IDs (for PCI, USB, etc.)\n"
msgstr "\t-numeric        prikaz numeričkih ID (za PCI, USB, itd.)\n"

#: ../lshw.cc:119
#, c-format
msgid "the latest version is %s\n"
msgstr "zadnja verzija je %s\n"

