msgid "Choose"
msgstr "Valitse"

#: byobu-export:171
msgid "File exists"
msgstr "Tiedosto on jo olemassa"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "Poista tiedosto? [y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "Valitse väri: "

#: byobu-export:240
msgid "Profile"
msgstr "Profiili"

#: byobu-export:241
msgid "Archive"
msgstr "Arkisto"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Pura arkisto kotihakemistoosi kohdejärjestelmässä"

#: byobu-select-profile:49
msgid "Error:"
msgstr "Virhe:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " tiedosto on olemassa, mutta ei ole symbolinen linkki"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "Valitse screen-profiili: "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "Virhe: epäkelpo valinta"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"Jos käytät oletuspikanäppäimiä, paina <F5>\\n\r\n"
"aktivoidaksesi nämä muutokset.\\n\\nMuussa tapauksessa poistu tästä screen-"
"istunnosta ja käynnistä uusi."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Suorita ”byobu” aktivoidaksesi"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu käynnistyy tällä hetkellä kirjauduttaessa (kytke pois)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu ei tällä hetkellä käynnisty kirjauduttaessa (kytke päälle)"

#: byobu-config:89
msgid "Help"
msgstr "Ohje"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "Muuta Byobun värejä"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Kytke tilailmoitukset päälle tai pois"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Muuta pikanäppäimiä"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Muuta ohjausmerkkejä"

#: byobu-config:94
msgid "Create new windows"
msgstr "Luo uusia ikkunoita"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Hallitse oletusikkunoita"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " Byobun asetusvalikko"

#: byobu-config:110
msgid "Okay"
