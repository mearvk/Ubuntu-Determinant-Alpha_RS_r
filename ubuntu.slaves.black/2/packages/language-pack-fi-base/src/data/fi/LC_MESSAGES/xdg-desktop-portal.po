#: src/background.c:260
#, c-format
msgid "Allow %s to run in the background?"
msgstr "Sallitaanko että %s suoritetaan taustalla?"

#: src/background.c:264
#, c-format
msgid "%s requests to be started automatically and run in the background."
msgstr ""
"%s pyytää automaattista käynnistymistä ja lupaa tulla suoritetuksi taustalla."

#: src/background.c:266
#, c-format
msgid "%s requests to run in the background."
msgstr "%s pyytää lupaa tulla suoritetuksi taustalla."

#: src/background.c:267
msgid ""
"The ‘run in background’ permission can be changed at any time from the "
"application settings."
msgstr ""
"Kohteen 'suorita taustalla' lupa voidaan muuttaa milloin tahansa "
"sovellusasetuksista."

#: src/background.c:272
msgid "Don't allow"
msgstr "Älä salli"

#: src/background.c:273 src/wallpaper.c:165
msgid "Allow"
msgstr "Salli"

#: src/device.c:115
msgid "Turn On Microphone?"
msgstr "Kytketäänkö mikrofoni?"

#: src/device.c:116
msgid ""
"Access to your microphone can be changed at any time from the privacy "
"settings."
msgstr ""
"Pääsy mikrofoniisi voidaan muuttaa milloin tahansa yksityisyysasetuksista."

#: src/device.c:120
msgid "An application wants to use your microphone."
msgstr "Sovellus haluaa käyttää mikrofoniasi."

#: src/device.c:122
#, c-format
msgid "%s wants to use your microphone."
msgstr "%s haluaa käyttää mikrofoniasi."

#: src/device.c:128
msgid "Turn On Speakers?"
msgstr "Kytke kaiuttimet?"

#: src/device.c:129
msgid ""
"Access to your speakers can be changed at any time from the privacy settings."
msgstr ""
"Pääsy kaiuttimiisi voidaan muuttaa milloin tahansa yksityisyysasetuksista."

#: src/device.c:133
msgid "An application wants to play sound."
msgstr "Sovellus haluaa toistaa ääntä."

#: src/device.c:135
#, c-format
msgid "%s wants to play sound."
msgstr "%s haluaa toistaa ääntä."

#: src/device.c:141
msgid "Turn On Camera?"
msgstr "Kytke kamera?"

#: src/device.c:142
msgid ""
"Access to your camera can be changed at any time from the privacy settings."
msgstr ""
"Pääsy kameraasi voidaan muuttaa milloin tahansa yksityisyysasetuksista."

#: src/device.c:146
msgid "An application wants to use your camera."
msgstr "Sovellus haluaa käyttää kameraasi."

#: src/device.c:148
#, c-format
msgid "%s wants to use your camera."
msgstr "%s haluaa käyttää kameraasi."

#: src/location.c:526
msgid "Deny Access"
msgstr "Estä pääsy"

#: src/location.c:528
msgid "Grant Access"
msgstr "Salli pääsy"

#: src/location.c:534
msgid "Grant Access to Your Location?"
msgstr "Salli pääsy sijaintiisi?"

#: src/location.c:535
msgid "An application wants to use your location."
msgstr "Sovellus haluaa käyttää sijaintiasi."

#: src/location.c:547
#, c-format
msgid "Give %s Access to Your Location?"
msgstr "Anna %s pääsy sijaintiisi?"

#: src/location.c:551
#, c-format
msgid "%s wants to use your location."
msgstr "%s haluaa käyttää sijaintiasi."

#: src/location.c:554
msgid "Location access can be changed at any time from the privacy settings."
msgstr ""
"Sijaintitiedon käyttöoikeuksia voi muuttaa milloin tahansa "
"yksityisyysasetuksista."

#: src/settings.c:124
msgid "Requested setting not found"
msgstr "Pyydettyä asetusta ei löydy"

#: src/wallpaper.c:163
msgid "Deny"
msgstr "Estä"

#: src/wallpaper.c:171
msgid "Allow Applications to Set Backgrounds?"
msgstr "Sallitaanko sovellusten asettaa taustakuvia?"

#: src/wallpaper.c:172
msgid ""
"An application is requesting to be able to change the background image."
msgstr "Sovellus pyytää lupaa vaihtaa taustakuvaa."

#: src/wallpaper.c:184
#, c-format
msgid "Allow %s to Set Backgrounds?"
msgstr "Saako %s asettaa taustakuvia?"

#: src/wallpaper.c:185
#, c-format
msgid "%s is requesting to be able to change the background image."
msgstr "%s pyytää lupaa vaihtaa taustakuvaa."

#: src/wallpaper.c:188
msgid "This permission can be changed at any time from the privacy settings."
msgstr ""
"Tämän käyttöoikeuden voi muuttaa milloin tahansa yksityisyysasetuksista."
