#: luks/keyencryption.c:61
#, c-format
msgid "Unable to obtain sector size for %s"
msgstr "Ei kyetä saamaan sektorikokoa kohteelle %s"

#: luks/keyencryption.c:109
msgid "Failed to obtain device mapper directory."
msgstr "Laitekuvaajahakemiston hankkiminen epäonnistui."

#: luks/keymanage.c:79 luks/keymanage.c:120 luks/keymanage.c:390
#, c-format
msgid "Can't open device: %s\n"
msgstr "Laitetta ei voi avata: %s\n"

#: luks/keymanage.c:86
#, c-format
msgid "%s is not a LUKS partition\n"
msgstr "%s ei ole LUKS-osio\n"

#: luks/keymanage.c:89
msgid "unknown hash spec in phdr"
msgstr ""

#: luks/keymanage.c:92
#, c-format
msgid "unknown version %d\n"
msgstr "tuntematon versio %d\n"

#: luks/keymanage.c:213
#, c-format
msgid "key %d active, purge first.\n"
msgstr "avain %d on aktiivinen, poista ensin.\n"

#: luks/keymanage.c:218
#, c-format
msgid ""
"key material section %d includes too few stripes. Header manipulation?\n"
msgstr ""

#: luks/keymanage.c:281
#, c-format
msgid "key %d is disabled.\n"
msgstr "avain %d on pois käytöstä.\n"

#: luks/keymanage.c:427
#, c-format
msgid "Key %d not active. Can't wipe.\n"
msgstr "Avain %d ei ole käytössä. Ei voida pyyhkiä pois.\n"

#: src/cryptsetup.c:56
msgid "<name> <device>"
msgstr "<nimi> <laite>"

#: src/cryptsetup.c:56
msgid "create device"
msgstr "luo laite"

#: src/cryptsetup.c:57 src/cryptsetup.c:58 src/cryptsetup.c:59
#: src/cryptsetup.c:60 src/cryptsetup.c:67
msgid "<name>"
msgstr "<nimi>"

#: src/cryptsetup.c:57
msgid "remove device"
msgstr "poista laite"

#: src/cryptsetup.c:58
msgid "modify active device"
msgstr "muokkaa aktiivista laitetta"

#: src/cryptsetup.c:59
msgid "resize active device"
msgstr "muuta aktiivisen laitteen kokoa"

#: src/cryptsetup.c:60
msgid "show device status"
msgstr "näytä laitteen tila"

#: src/cryptsetup.c:61 src/cryptsetup.c:64
msgid "<device> [<new key file>]"
msgstr "<laite> [<uusi avaintiedosto>]"

#: src/cryptsetup.c:61
msgid "formats a LUKS device"
msgstr "alustaa LUKS-laitteen"

#: src/cryptsetup.c:62
msgid "<device> <name> "
msgstr "<laite> <nimi> "

#: src/cryptsetup.c:62
msgid "open LUKS device as mapping <name>"
msgstr ""

#: src/cryptsetup.c:63
msgid "<device> <key slot>"
msgstr "<laite> <avainväli>"

#: src/cryptsetup.c:63
msgid "wipes key with number <key slot> from LUKS device"
msgstr "pyyhkäisee pois avaimen numerolla <avainväli> LUKS-laitteesta"

#: src/cryptsetup.c:64
msgid "add key to LUKS device"
msgstr "lisää avain LUKS-laitteeseen"

#: src/cryptsetup.c:65 src/cryptsetup.c:66 src/cryptsetup.c:68
msgid "<device>"
msgstr "<laite>"

#: src/cryptsetup.c:65
msgid "print UUID of LUKS device"
msgstr "tulostaa LUKS-laitteen UUID-tunnuksen"

#: src/cryptsetup.c:66
msgid "tests <device> for LUKS partition header"
msgstr "testaa <laite> LUKS-osio-otsakkeen osalta"

#: src/cryptsetup.c:67
msgid "remove LUKS mapping"
msgstr "poista LUKS-kuvaus"

#: src/cryptsetup.c:68
msgid "dump LUKS partition information"
msgstr "vedosta LUKS-osiotiedot"

#: src/cryptsetup.c:77
#, c-format
msgid "Command successful.\n"
msgstr "Komento onnistui.\n"

#: src/cryptsetup.c:90
#, c-format
msgid "Command failed"
msgstr "Komento epäonnistui"

#: src/cryptsetup.c:226
#, c-format
msgid "This will overwrite data on %s irrevocably."
msgstr "Tämä korvaa tiedot kohteella %s peruuttamattomasti."

#: src/cryptsetup.c:227
msgid "memory allocation error in action_luksFormat"
msgstr "muistivarausvirhe kohteessa action_luksFormat"

#: src/cryptsetup.c:269
msgid ""
"This is the last keyslot. Device will become unusable after purging this key."
msgstr ""
"Tämä on viimeinen avainväli. Laite tulee käyttökelvottomaksi tämän avaimen "
"poistamisen jälkeen."

#: src/cryptsetup.c:349
#, c-format
msgid ""
"\n"
"<action> is one of:\n"
msgstr ""
"\n"
"<toiminto> on yksi seuraavista:\n"

#: src/cryptsetup.c:355
#, c-format
msgid ""
"\n"
"<name> is the device to create under %s\n"
"<device> is the encrypted device\n"
"<key slot> is the LUKS key slot number to modify\n"
"<key file> optional key file for the new key for luksAddKey action\n"
msgstr ""
"\n"
"<nimi> on laite, joka luodaan kohteen %s alaisena\n"
"<laite> on salaussuojattu laite\n"
"<avainväli> on LUKS-avainväli muokattavaksi\n"
"<avaintiedosto> valinnainen avaintiedosto uudelle avaimelle luksAddKey-"
"toimintoa varten\n"

#: src/cryptsetup.c:371
msgid "Show this help message"
msgstr "Näytä tämä ohje"

#: src/cryptsetup.c:372
msgid "Display brief usage"
msgstr "Näytä lyhyt käyttöohje"

#: src/cryptsetup.c:376
msgid "Help options:"
msgstr "Ohjevalitsimet:"

#: src/cryptsetup.c:377
msgid "Shows more detailed error messages"
msgstr "Näyttää yksityiskohtaisemmat virheviestit"

#: src/cryptsetup.c:378
msgid "The cipher used to encrypt the disk (see /proc/crypto)"
msgstr ""
"Salakirjoitusmenetelmä, jota käytetään salaamaan levy (katso /proc/crypto)"

#: src/cryptsetup.c:379
msgid "The hash used to create the encryption key from the passphrase"
msgstr ""
"Tiivisteavain, jota käytetään salausavaimen luomiseen salasanalauseesta"

#: src/cryptsetup.c:380
msgid "Verifies the passphrase by asking for it twice"
msgstr "Todentaa salasanalauseen kysymällä kahdesti"

#: src/cryptsetup.c:381
msgid "Read the key from a file (can be /dev/random)"
msgstr "Lue avain tiedostosta (voi olla /dev/random)"

#: src/cryptsetup.c:382
msgid "The size of the encryption key"
msgstr "Salausavaimen koko"

#: src/cryptsetup.c:382
msgid "BITS"
msgstr "BITTIÄ"

#: src/cryptsetup.c:383
msgid "The size of the device"
msgstr "Laitteen koko"

#: src/cryptsetup.c:383 src/cryptsetup.c:384 src/cryptsetup.c:385
#: src/cryptsetup.c:393
msgid "SECTORS"
msgstr "SEKTORIA"

#: src/cryptsetup.c:384
msgid "The start offset in the backend device"
msgstr "Alkusiirrososoite taustalaitteessa"

#: src/cryptsetup.c:385
msgid "How many sectors of the encrypted data to skip at the beginning"
msgstr "Kuinka monta salaustietojen sektoria ohitetaan alussa"

#: src/cryptsetup.c:386
msgid "Create a readonly mapping"
msgstr "Luo kirjoitussuojattu kuvaus"

#: src/cryptsetup.c:387
msgid "PBKDF2 iteration time for LUKS (in ms)"
msgstr "PBKDF2-iterointiaika kohteelle LUKS (millisekunneissa)"

#: src/cryptsetup.c:388
msgid "msecs"
msgstr "ms"

#: src/cryptsetup.c:389
msgid "Do not ask for confirmation"
msgstr "Älä pyydä vahvistusta"

#: src/cryptsetup.c:390
msgid "Print package version"
msgstr "Tulosta paketin versio"

#: src/cryptsetup.c:391
msgid "Timeout for interactive passphrase prompt (in seconds)"
msgstr "Aikakatkaisu vuorovaikutteiselle salasanalausekyselylle (sekunteina)"

#: src/cryptsetup.c:391
msgid "secs"
msgstr "sek"

#: src/cryptsetup.c:392
msgid "How often the input of the passphrase can be retried"
msgstr "Kuinka usein salasanasyötettä voidaan yrittää uudelleen"

#: src/cryptsetup.c:393
msgid "Align payload at <n> sector boundaries - for luksFormat"
msgstr ""
"Tasaa tietosisältö osoitteessa <n> sektorirajoihin - kohdetta luksFormat "
"varten"

#: src/cryptsetup.c:409
msgid "[OPTION...] <action> <action-specific>]"
msgstr ""

#: src/cryptsetup.c:445
msgid "Key size must be a multiple of 8 bits"
msgstr "Avainkoon on oltava 8 bitin monikerta"

#: src/cryptsetup.c:449
msgid "Argument <action> missing."
msgstr "Argumentti <toiminto> puuttuu."

#: src/cryptsetup.c:455
msgid "Unknown action."
msgstr "Tuntematon toiminto."

#: src/cryptsetup.c:470
#, c-format
msgid "%s: requires %s as arguments"
msgstr "%s: vaatii %s argumentteina"
