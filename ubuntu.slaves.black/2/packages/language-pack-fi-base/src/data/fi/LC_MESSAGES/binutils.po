msgstr "Mikään tiedostonimi ei seuraa valitsinta -fo.\n"

#: windres.c:960
#, c-format
msgid ""
"Option -I is deprecated for setting the input format, please use -J "
"instead.\n"
msgstr ""
"Valitsin -I on vanhentunut syötemuodon asetukseen, käytä sen sijaan "
"valitsinta -J.\n"

