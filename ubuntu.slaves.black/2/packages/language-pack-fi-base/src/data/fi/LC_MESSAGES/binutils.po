#: ar.c:289
#, c-format
msgid ""
"Usage: %s [emulation options] [-]{dmpqrstx}[abcDfilMNoOPsSTuvV] [--plugin "
"<name>] [member-name] [count] archive-file file...\n"
msgstr ""

#: ar.c:295
#, c-format
msgid ""
"Usage: %s [emulation options] [-]{dmpqrstx}[abcDfilMNoOPsSTuvV] [member-"
"name] [count] archive-file file...\n"
msgstr ""

#: ar.c:303
#, c-format
msgid "       %s -M [<mri-script]\n"
msgstr "       %s -M [<mri-skripti]\n"

#: ar.c:304
#, c-format
msgid " commands:\n"
msgstr " komennot:\n"

#: ar.c:305
#, c-format
msgid "  d            - delete file(s) from the archive\n"
msgstr "  d            - poista tiedosto(t) arkistosta\n"

#: ar.c:306
#, c-format
msgid "  m[ab]        - move file(s) in the archive\n"
msgstr "  m[ab]        - siirrä tiedosto(t) arkistoon\n"

#: ar.c:307
#, c-format
msgid "  p            - print file(s) found in the archive\n"
msgstr "  p            - tulosta arkistosta löytyvät tiedosto(t)\n"

#: ar.c:308
#, c-format
msgid "  q[f]         - quick append file(s) to the archive\n"
msgstr "  q[f]         - liitä tiedosto(t) nopeasti arkiston loppuun\n"

#: ar.c:309
#, c-format
msgid ""
"  r[ab][f][u]  - replace existing or insert new file(s) into the archive\n"
msgstr ""
"  r[ab][f][u]  - korvaa olemassa oleva(t) tai lisää uudet tiedosto(t) "
"arkistoon\n"

#: ar.c:310
#, c-format
msgid "  s            - act as ranlib\n"
msgstr "  s            - toimi kuten ranlib\n"

#: ar.c:311
#, c-format
msgid "  t[O][v]      - display contents of the archive\n"
msgstr ""

#: ar.c:312
#, c-format
msgid "  x[o]         - extract file(s) from the archive\n"
msgstr "  x[o]         - pura tiedosto(t) arkistosta\n"

# modifiers on tässä sama kuin options
#: ar.c:313
#, c-format
msgid " command specific modifiers:\n"
msgstr " komentokohtaiset valitsimet:\n"

#: ar.c:314
#, c-format
msgid "  [a]          - put file(s) after [member-name]\n"
msgstr "  [a]          - sijoita tiedosto(t) kohteen [jäsennimi] jälkeen\n"

#: ar.c:315
#, c-format
msgid "  [b]          - put file(s) before [member-name] (same as [i])\n"
msgstr ""
"  [b]          - laita tiedosto(t) kohteen [jäsennimi] edelle (sama kuin "
"[i])\n"

#: ar.c:318
#, c-format
msgid "  [D]          - use zero for timestamps and uids/gids (default)\n"
msgstr ""
"  [D]          - käytä nollaa aikaleimoille ja uid-käyttäjätunnisteisiin/gid-"
"ryhmätunnisteisiin (oletus)\n"

#: ar.c:320
#, c-format
msgid "  [U]          - use actual timestamps and uids/gids\n"
msgstr ""
"  [U]          - käytä todellisia aikaleimoja ja uid-käyttäjätunnisteita/gid-"
"ryhmätunnisteita\n"

#: ar.c:325
#, c-format
msgid "  [D]          - use zero for timestamps and uids/gids\n"
msgstr ""
"  [D]          - käytä nollaa aikaleimoille ja uid-käyttäjätunnisteisiin/gid-"
"ryhmätunnisteisiin\n"

#: ar.c:327
#, c-format
msgid "  [U]          - use actual timestamps and uids/gids (default)\n"
msgstr ""
"  [U]          - käytä todellisia aikaleimoja ja uid-käyttäjätunnisteita/gid-"
"ryhmätunnisteita (oletus)\n"

#  Otaksun, että kyse on jostain taulukkomuotoisesta oliosta, jossa on lukumäärän osoittama määrä alkioita. Ohjelmointikielissä se merkataan yleensä olio[5] tai nimi[5]. Valitsimella valitaan ilmeisesti tämän muotoinen ilmentymä.
#: ar.c:330
#, c-format
msgid "  [N]          - use instance [count] of name\n"
msgstr "  [N]          - käytä nimen[lukumäärä]-ilmentymää\n"

#: ar.c:331
#, c-format
msgid "  [f]          - truncate inserted file names\n"
msgstr "  [f]          - katkaise lisätyt tiedostonimet\n"

#: ar.c:332
#, c-format
msgid "  [P]          - use full path names when matching\n"
msgstr "  [P]          - käytä täyttä polkunimeä, kun se täsmää\n"

#: ar.c:333
#, c-format
msgid "  [o]          - preserve original dates\n"
msgstr "  [o]          - säilytä alkuperäiset päiväykset\n"

#: ar.c:334
#, c-format
msgid "  [O]          - display offsets of files in the archive\n"
msgstr ""

#: ar.c:335
#, c-format
msgid ""
"  [u]          - only replace files that are newer than current archive "
"contents\n"
msgstr ""
"  [u]          - korvaa vain tiedostot, jotka ovat arkiston nykysisältöä "
"uudempia\n"

