msgstr "%s (syynä %s)"

#: apt-private/private-output.cc:612
msgid ""
"WARNING: The following essential packages will be removed.\n"
"This should NOT be done unless you know exactly what you are doing!"
msgstr ""
"VAROITUS: Seuraavat välttämättömät paketit poistetaan.\n"
"Näin EI PITÄISI tehdä jos ei aivan tarkkaan tiedä mitä tekee!"

#: apt-private/private-output.cc:643
#, c-format
msgid "%lu upgraded, %lu newly installed, "
msgstr "%lu päivitetty, %lu uutta asennusta, "

#: apt-private/private-output.cc:647
#, c-format
msgid "%lu reinstalled, "
msgstr "%lu uudelleen asennettua, "

#: apt-private/private-output.cc:649
#, c-format
msgid "%lu downgraded, "
msgstr "%lu varhennettua, "

#: apt-private/private-output.cc:651
#, c-format
msgid "%lu to remove and %lu not upgraded.\n"
msgstr "%lu poistettavaa ja %lu päivittämätöntä.\n"

#: apt-private/private-output.cc:655
#, c-format
msgid "%lu not fully installed or removed.\n"
msgstr "%lu ei asennettu kokonaan tai poistettiin.\n"

#. TRANSLATOR: Yes/No question help-text: defaulting to Y[es]
