#: ../adduser:915
#, perl-format
msgid ""
"%s: To avoid problems, the username should consist only of\n"
"letters, digits, underscores, periods, at signs and dashes, and not start "
"with\n"
"a dash (as defined by IEEE Std 1003.1-2001). For compatibility with Samba\n"
"machine accounts $ is also supported at the end of the username\n"
msgstr ""
"%s: Ongelmien välttämiseksi, käyttäjänimen tulisi sisältää vain \n"
"kirjaimia (a-z), numeroita (0-9), alaviivoja (_), pisteitä, at-merkkejä ja "
"väliviivoja (-). \n"
"Nimen ei tulisi myöskään alkaa väliviivalla. Samban kanssa yhteensopivuuden "
"takia\n"
"myös $-merkki on hyväksytty käyttäjänimen lopussa.\n"

#: ../adduser:1104
msgid "Allowing use of questionable username.\n"
msgstr "Sallitaan kyseenalaisen käyttäjänimen käyttö.\n"

#: ../adduser:929
#, perl-format
msgid ""
"%s: Please enter a username matching the regular expression configured\n"
"via the NAME_REGEX[_SYSTEM] configuration variable.  Use the `--force-"
"badname'\n"
"option to relax this check or reconfigure NAME_REGEX.\n"
msgstr ""
"%s: Anna käyttäjänimi, joka sopii säännölliseen lausekkeeseen, joka on "
"asetettu\n"
"NAME_REGEX[_SYSTEM] asetusmuuttujassa. Käytä '--force-badname' -valintaa\n"
"jättääksesi tämän tarkistuksen huomiotta tai määritä uudelleen NAME_REGEX.\n"

