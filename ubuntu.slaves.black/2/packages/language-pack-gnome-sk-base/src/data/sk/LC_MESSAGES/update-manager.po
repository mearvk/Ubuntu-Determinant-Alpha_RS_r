msgid "Not all updates can be installed"
msgstr "Nie všetky aktualizácie je možno nainštalovať"

#: ../UpdateManager/Dialogs.py:319
msgid ""
"Run a partial upgrade, to install as many updates as possible.\n"
"\n"
"    This can be caused by:\n"
"     * A previous upgrade which didn't complete\n"
"     * Problems with some of the installed software\n"
"     * Unofficial software packages not provided by Ubuntu\n"
"     * Normal changes of a pre-release version of Ubuntu"
msgstr ""
"Spustiť čiastočnú aktualizáciu, nainštalovať toľko aktualizácií, koľko sa "
"dá.\n"
"\n"
"    Toto mohlo nastať v dôsledku:\n"
"     * predošlej aktualizácie, ktorá nebola dokončená\n"
"     * problému s niektorým nainštalovaným softvérom\n"
"     * neoficiálnych balíkov softvéru, ktoré neposkytuje Ubuntu\n"
"     * bežných zmien v zatiaľ nevydanej verzii Ubuntu"

