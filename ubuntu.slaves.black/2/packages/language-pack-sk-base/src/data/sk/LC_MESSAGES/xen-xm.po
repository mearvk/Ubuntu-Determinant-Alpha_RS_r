#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Vnútorná chyba: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Toto rozdelenie už obsahuje %(1)s -> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Postup %(1)s je nepodporovaný."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Postup %(1)s berie %(2)s argument(y) (%(3)s dané)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Prístup zamietnutý."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Hodnota \"%(2)s\" pre %(1)s je nepodporovaná podľa tohto servera.  Server "
"uviedol \"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "%(1)s Spracovanie %(2)s je neplatné."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Pokus na túto manipuláciu nebol povolený."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Sieť ste zadali ako PIF pripojenú ale aj tak nemusíte byť k nej pripojený."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
