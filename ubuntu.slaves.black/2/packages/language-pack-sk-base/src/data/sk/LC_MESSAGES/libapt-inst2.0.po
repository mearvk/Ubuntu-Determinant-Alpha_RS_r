#: apt-inst/contrib/arfile.cc:76
msgid "Invalid archive signature"
msgstr "Neplatný podpis archívu"

#: apt-inst/contrib/arfile.cc:84
msgid "Error reading archive member header"
msgstr "Chyba pri čítaní záhlavia prvku archívu"

#: apt-inst/contrib/arfile.cc:95
#, c-format
msgid "Invalid archive member header %s"
msgstr "Neplatná hlavička prvku archívu %s"

#: apt-inst/contrib/arfile.cc:96 apt-inst/contrib/arfile.cc:102
#: apt-inst/contrib/arfile.cc:113 apt-inst/contrib/arfile.cc:119
#: apt-inst/contrib/arfile.cc:140
msgid "Invalid archive member header"
msgstr "Neplatné záhlavie prvku archívu"

#: apt-inst/contrib/arfile.cc:156
msgid "Archive is too short"
msgstr "Archív je príliš krátky"

#: apt-inst/contrib/arfile.cc:160
msgid "Failed to read the archive headers"
msgstr "Chyba pri čítaní hlavičiek archívu"

#: apt-inst/contrib/extracttar.cc:120
#, c-format
msgid "Cannot find a configured compressor for '%s'"
msgstr ""

#: apt-inst/contrib/extracttar.cc:152 apt-inst/contrib/extracttar.cc:182
msgid "Corrupted archive"
msgstr "Porušený archív"

#: apt-inst/contrib/extracttar.cc:167
msgid "Tar checksum failed, archive corrupted"
msgstr "Kontrolný súčet pre tar zlyhal, archív je poškodený"

#: apt-inst/contrib/extracttar.cc:261
#, c-format
msgid "Unknown TAR header type %u, member %s"
msgstr "Neznáma TAR hlavička typu %u, člen %s"

#: apt-inst/deb/debfile.cc:47 apt-inst/deb/debfile.cc:56
#: apt-inst/deb/debfile.cc:67
#, c-format
msgid "This is not a valid DEB archive, missing '%s' member"
msgstr "Toto nie je platný DEB archív, chýba časť „%s“"

#: apt-inst/deb/debfile.cc:136
#, c-format
msgid "Internal error, could not locate member %s"
msgstr "Vnútorná chyba, nedá sa nájsť časť %s"

#: apt-inst/deb/debfile.cc:243
msgid "Unparsable control file"
msgstr "Nespracovateľný riadiaci súbor"

#: apt-inst/dirstream.cc:42 apt-inst/dirstream.cc:49 apt-inst/dirstream.cc:54
#, c-format
msgid "Failed to write file %s"
msgstr "Zápis súboru %s zlyhal"

#: apt-inst/dirstream.cc:104
#, c-format
msgid "Failed to close file %s"
msgstr "Zatvorenie súboru %s zlyhalo"

#: apt-inst/extract.cc:100 apt-inst/extract.cc:171
#, c-format
msgid "The path %s is too long"
msgstr "Cesta %s je príliš dlhá"

#: apt-inst/extract.cc:131
#, c-format
msgid "Unpacking %s more than once"
msgstr "%s sa rozbaľuje viackrát"

#: apt-inst/extract.cc:141
#, c-format
msgid "The directory %s is diverted"
msgstr "Adresár %s je divertovaný"

#: apt-inst/extract.cc:151
#, c-format
msgid "The package is trying to write to the diversion target %s/%s"
msgstr "Balík sa pokúša zapisovať do diverzného cieľa %s/%s"

#: apt-inst/extract.cc:161 apt-inst/extract.cc:305
msgid "The diversion path is too long"
msgstr "Diverzná cesta je príliš dlhá"

#: apt-inst/extract.cc:185 apt-inst/extract.cc:198 apt-inst/extract.cc:215
#, c-format
msgid "Failed to stat %s"
msgstr "%s sa nedá vyhodnotiť"

#: apt-inst/extract.cc:193
#, c-format
msgid "Failed to rename %s to %s"
msgstr "Premenovanie %s na %s zlyhalo"

#: apt-inst/extract.cc:248
#, c-format
msgid "The directory %s is being replaced by a non-directory"
msgstr "Adresár %s sa nahradí neadresárom"

#: apt-inst/extract.cc:288
msgid "Failed to locate node in its hash bucket"
msgstr "Nedá sa nájsť uzol na adrese jeho hašu"

#: apt-inst/extract.cc:292
msgid "The path is too long"
msgstr "Cesta je príliš dlhá"

#: apt-inst/extract.cc:420
#, c-format
msgid "Overwrite package match with no version for %s"
msgstr "Prepísať zodpovedajúci balík bez udania verzie pre %s"

#: apt-inst/extract.cc:437
#, c-format
msgid "File %s/%s overwrites the one in the package %s"
msgstr "Súbor %s/%s prepisuje ten z balíka %s"

#: apt-inst/extract.cc:470
#, c-format
msgid "Unable to read %s"
msgstr "Nedá sa načítať %s"

#: apt-inst/extract.cc:497
#, c-format
msgid "Unable to stat %s"
msgstr "Nedá sa vyhodnotiť %s"

#: apt-inst/filelist.cc:380
msgid "DropNode called on still linked node"
msgstr "Pokus o uvoľnenie uzla (DropNode) na stále prepojenom uzle"

#: apt-inst/filelist.cc:412
msgid "Failed to locate the hash element!"
msgstr "Hašovací prvok sa nedá nájsť!"

#: apt-inst/filelist.cc:459
msgid "Failed to allocate diversion"
msgstr "Nedá sa alokovať diverzia"

#: apt-inst/filelist.cc:464
msgid "Internal error in AddDiversion"
msgstr "Vnútorná chyba pri AddDiversion"

#: apt-inst/filelist.cc:477
#, c-format
msgid "Trying to overwrite a diversion, %s -> %s and %s/%s"
msgstr "Pokus o prepísanie diverzie, %s -> %s a %s/%s"

#: apt-inst/filelist.cc:506
#, c-format
msgid "Double add of diversion %s -> %s"
msgstr "Dvojité pridanie diverzie %s -> %s"

#: apt-inst/filelist.cc:549
#, c-format
msgid "Duplicate conf file %s/%s"
msgstr "Duplicitný konfiguračný súbor %s/%s"
