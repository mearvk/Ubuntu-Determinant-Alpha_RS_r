#: src/gtd-window.c:793
msgid "Click a task list to select"
msgstr "Ttekki ɣef tebdart n twuriwin akken ad tferneḍ"

#. 
#. * If there's no task available, draw a "No tasks" string at
#. * the middle of the list thumbnail.
#. 
#: src/views/gtd-list-selector-grid-item.c:250
msgid "No tasks"
msgstr "Ulac tiwuriwin"

#: src/views/gtd-list-selector-panel.c:381
msgid "Remove the selected task lists?"
msgstr "Tukksa n tebdarin n twuriwin i yettwafernen?"

#: src/views/gtd-list-selector-panel.c:384
msgid "Once removed, the task lists cannot be recovered."
msgstr "Mi ttwakksent, tibdarin n twuriwin ur zmirent ara ad d-ttwarrent."

#: src/views/gtd-list-selector-panel.c:396
msgid "Remove task lists"
msgstr "Tukksa n tebdarin n twuriwin"

#: src/views/gtd-list-selector-panel.c:709
msgid "Clear completed tasks"
msgstr "Sfeḍ tiwuriwin ifukken"
