#: data/org.gnome.FileRoller.appdata.xml.in:10
msgid "Open, modify and create compressed archive files"
msgstr "Ldi, beddel u snulfu-d iɣbaṛen n yifuyla yessden"

#: data/org.gnome.FileRoller.appdata.xml.in:12
msgid ""
"Archive Manager (also known as File Roller) is the default GNOME application "
"for opening, creating, and modifying archive and compressed archive files."
msgstr ""
"Amsefrak n yiɣbaṛen (yettwassen daɣen s yisem File Roller) d asnas n lexṣas "
"n Gnome i welday, asnulfu, akked ubeddel n yiɣbaṛen akked yiɣbaṛen n yifuyla "
"yettwassden."

#: data/org.gnome.FileRoller.appdata.xml.in:16
msgid ""
"Archive Manager supports a wide range of different archive files, including:"
msgstr "Amsefrak n yiɣebaren yedhel aṭas n yifuyla iɣbaṛen, akked wigi:"

#: data/org.gnome.FileRoller.appdata.xml.in:20
msgid "gzip archives (.tar.gz, .tgz)"
msgstr "iɣbaṛen gzip (.tar.gz, .tgz)"

#: data/org.gnome.FileRoller.appdata.xml.in:21
msgid "bzip archives (.tar.bz, .tbz)"
msgstr "iɣbaṛen bzip (.tar.bz, .tbz)"

#: data/org.gnome.FileRoller.appdata.xml.in:22
msgid "zip archives (.zip)"
msgstr "iɣbaṛen zip (.zip)"

#: data/org.gnome.FileRoller.appdata.xml.in:23
msgid "xz archives (.tar.xz)"
msgstr "iɣbaṛen xz (.tar.xz)"

#: data/org.gnome.FileRoller.desktop.in.in:3 src/fr-application.c:479
