msgid "<small><b>_Details</b></small>"
msgstr "<small><b>_Ifatusen</b></small>"

#: ../src/polkitgnomeauthenticationdialog.c:796
msgid "<small><b>Action:</b></small>"
msgstr "<small><b>Tigawt:</b></small>"

#: ../src/polkitgnomeauthenticationdialog.c:799
#, c-format
msgid "Click to edit %s"
msgstr "Sit ad tẓergeḍ %s"

#: ../src/polkitgnomeauthenticationdialog.c:813
msgid "<small><b>Vendor:</b></small>"
msgstr "<small><b>Amsenzi:<b></small>"

#: ../src/polkitgnomeauthenticationdialog.c:815
#, c-format
msgid "Click to open %s"
msgstr "Sit ad teldiḍ %s"

#: ../src/polkitgnomeauthenticationdialog.c:975
msgid "Authenticate"
msgstr "Sesteb"

#: ../src/polkitgnomeauthenticator.c:297
#, c-format
msgid "_Password for %s:"
msgstr "_Awal n uɛeddi i %s:"

#: ../src/polkitgnomeauthenticator.c:458
msgid "Your authentication attempt was unsuccessful. Please try again."
msgstr "Aɛraḍ-ik n usesteb ur yemmug ara akken iwata. Ɛreḍ tikkelt-nniḍen."

#: ../src/polkitgnomelistener.c:164
msgid "Authentication dialog was dismissed by the user"
msgstr "Asesteb n udiwenni ur yettwaqbel ara sɣur useqdac"
