#: ../src/polkitgnomeauthenticationdialog.c:255
msgid "Select user..."
msgstr "Fren aseqdac..."

#: ../src/polkitgnomeauthenticationdialog.c:290
#, c-format
msgid "%s (%s)"
msgstr "%s (%s)"

#: ../src/polkitgnomeauthenticationdialog.c:632
msgid "_Authenticate"
msgstr "_Sesteb"

#: ../src/polkitgnomeauthenticationdialog.c:672
msgid ""
"An application is attempting to perform an action that requires privileges. "
"Authentication as one of the users below is required to perform this action."
msgstr ""
"Yiwen n usnas iɛerreḍ ad yeg tigawt i yesran tiseglutin. Asesteb am yiwen "
"seg yiseqdacen seddaw ilaq i uselkem n tigawt-a."

#: ../src/polkitgnomeauthenticationdialog.c:680
msgid ""
"An application is attempting to perform an action that requires privileges. "
"Authentication is required to perform this action."
msgstr ""
"Yiwen n usnas iɛerreḍ ad yeg tigawt i yesran tiseglutin. Ilaq usesteb i "
"uselkem n tigawt-a."

#: ../src/polkitgnomeauthenticationdialog.c:686
msgid ""
"An application is attempting to perform an action that requires privileges. "
"Authentication as the super user is required to perform this action."
msgstr ""
"Yiwen n usnas iɛerreḍ ad yeg tigawt i yesran tiseglutin. Asesteb am useqdac "
"ifazen  ilaq i uselkem n tigawt-a."

#: ../src/polkitgnomeauthenticationdialog.c:722
#: ../src/polkitgnomeauthenticator.c:301
msgid "_Password:"
msgstr "_Awal n uɛeddi:"

