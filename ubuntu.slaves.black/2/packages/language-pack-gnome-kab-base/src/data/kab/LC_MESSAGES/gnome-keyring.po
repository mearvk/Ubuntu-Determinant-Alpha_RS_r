#: pkcs11/wrap-layer/gkm-wrap-prompt.c:590
msgid "Unlock Login Keyring"
msgstr "Tukksa n usekkeṛ i Keyring n tuqqna"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:591
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:615
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:691
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:767
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1250
msgid "Authentication required"
msgstr "Asesteb yettwasra"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:594
msgid ""
"The password you use to log in to your computer no longer matches that of "
"your login keyring."
msgstr ""
"Awal uffir i tsseqdaceḍ akken ad tkecmeḍ s aselkim-inek m ur yenmeɣra ara "
"akked wawal uffir n uzebg n tsura inek m."

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:596
msgid ""
"The login keyring did not get unlocked when you logged into your computer."
msgstr ""
"Azebg n tsura ur s-yettwakkes ara usekkeṛ mi tkecmeḍ s aselkim-inek m."

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:614
msgid "Unlock Keyring"
msgstr "Kkes asekkeṛ i uzebg n tsura"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:617
#, c-format
msgid "An application wants access to the keyring “%s”, but it is locked"
msgstr "Yella usnas yebɣan ad yaddef s azebg n tsura “%s”, maca yettusekkeṛ"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:623
msgid "Automatically unlock this keyring whenever I’m logged in"
msgstr "Kkes aseḍru i uzebg-agi n tsura s wudem awurman melmi kecmeɣ"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:636
msgid "Unlock certificate"
msgstr "Kkes aseḍru i uselkin"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:638
msgid "Unlock public key"
msgstr "Kkes aseḍru i tsarut tazayezt"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:652
msgid "Automatically unlock this certificate whenever I’m logged in"
msgstr "Kkes aseḍru i uselkin-agi s wudem awurman melmi kecmeɣ"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:654
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:776
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1140
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1289
msgid "Automatically unlock whenever I’m logged in"
msgstr "Kkes aseḍru s wudem awurman melmi kecmeɣ"

#. TRANSLATORS: The certificate is locked
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:668
#, c-format
msgid "An application wants access to the certificate “%s”, but it is locked"
msgstr "Yella usnas yebɣan ad yaddef aselkin “%s”, maca yettusekkeṛ"

#. TRANSLATORS: The public key is locked
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:671
#, c-format
msgid "An application wants access to the public key “%s”, but it is locked"
msgstr "Yella usnas yebɣan ad yaddef tasarut tazayezt “%s”, maca tettusekkeṛ"

#. TRANSLATORS: The object '%s' is locked
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:674
#, c-format
msgid "An application wants access to “%s”, but it is locked"
msgstr "Yella usnas yebɣan ad yaddef “%s”, maca yettusekkeṛ"

#. Build up the prompt
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:766
msgid "Unlock certificate/key storage"
msgstr "Kkes asekkeṛ i uselkin/aḥraz n tsura"

#. TRANSLATORS: The storage is locked, and needs unlocking before the application can use it.
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:770
#, c-format
msgid ""
"An application wants access to the certificate/key storage “%s”, but it is "
"locked"
msgstr ""
"Yella usnas yebɣan ad yaddef s aselkin/aḥraz n tsura “%s”, maca yettwasekkeṛ"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1131
msgid "New Password Required"
msgstr "Yettwasra wawal uffir amaynut"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1132
msgid "New password required"
msgstr "Yettwasra wawal uffir amaynut"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1134
#, c-format
msgid ""
"In order to prepare “%s” for storage of certificates or keys, a password is "
"required"
msgstr ""
"Akken ad yettwaheyyi “%s” i weḥraz n yiselkinen akked tsura, yettwasra wawal "
"uffir"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1249
#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1280
msgid "Change Password"
msgstr "Snifel awal uffir"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1252
#, c-format
msgid "To change the password for “%s”, the original password is required"
msgstr "Akken ad tbeddeleḍ awal uffir i “%s”, yettwasra wawal uffir amezwaru"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1281
msgid "Change password"
msgstr "Snifel awal uffir"

#: pkcs11/wrap-layer/gkm-wrap-prompt.c:1283
#, c-format
msgid "Type a new password for “%s”"
msgstr "Aru awal uffir amaynut i “%s”"

