msgstr "Id n tsarut armeɣtu: %s"

#: ../aptdaemon/worker/aptworker.py:594
#, python-format
msgid ""
"Failed to download and install the key %s from %s:\n"
"%s"
msgstr ""
"Ulamek asider akked usbeddi n tsarut %s si %s:\n"
"%s"

#: ../aptdaemon/worker/aptworker.py:611
#, python-format
msgid "Key file %s couldn't be installed: %s"
msgstr "Ulamek asbeddi n ufaylu tasarut %s: %s"

#: ../aptdaemon/worker/aptworker.py:635
#, python-format
msgid "Key with fingerprint %s couldn't be removed: %s"
msgstr "Tasarut s udriz n uḍad %s ulamek ara yettwakkes: %s"

#: ../aptdaemon/worker/aptworker.py:686
#, python-format
msgid "Package %s cannot be removed."
msgstr "Akemmus %sulamek ara yettwakkes."

#: ../aptdaemon/worker/aptworker.py:690
#, python-format
msgid "The version %s of %s is not installed"
msgstr "Lqem %s n %s ur yettwasbedd ara"

#: ../aptdaemon/worker/aptworker.py:767
#, python-format
msgid "The former version %s of %s is already installed"
msgstr "Lqem aqbur %s n %s yettusebded yakan"

#: ../aptdaemon/worker/aptworker.py:772 ../aptdaemon/worker/aptworker.py:820
#, python-format
msgid "The version %s of %s is already installed"
msgstr "Lqem %s n %s yettwasbedd yakan"

#: ../aptdaemon/worker/aptworker.py:779
#, python-format
msgid "The version %s of %s isn't available"
msgstr "Lqem %s n %s ur yewjid ara"

#: ../aptdaemon/worker/aptworker.py:783
#, python-format
msgid "You need to specify a version to downgrade %s to"
msgstr "Isefk ad d-tefkeḍ lqem wuɣur ara tuɣaleḍ i %s"

#: ../aptdaemon/worker/aptworker.py:813
#, python-format
msgid "The later version %s of %s is already installed"
msgstr "Lqem aneggaru %s n %s yettwasbedd yakan"

#: ../aptdaemon/worker/aptworker.py:849
#, python-format
msgid "The package %s isn't available in the %s release."
msgstr "Akemmus %s ur yewjid ara di lqem %s."

#: ../aptdaemon/worker/aptworker.py:1037
#, python-format
msgid "Package %s cannot be removed"
msgstr "Akemmus %s ulamek ara yettwakkes"

#: ../aptdaemon/worker/aptworker.py:1139
msgid ""
"The package doesn't provide a valid Installed-Size control field. See Debian "
"Policy 5.6.20."
msgstr ""
"Akemmus ur d-imudd ara urti n usenqed ameɣtu n teɣzi yettusbedden. Wali "
"tasertit n Debian 5.6.20."

#: ../aptdaemon/worker/aptworker.py:1278
msgid "The license key is empty"
msgstr "Tasarut-agi n turagt d tilemt"

#: ../aptdaemon/worker/aptworker.py:1294
msgid "The license key is not allowed to contain executable code."
msgstr ""
"Tasarut n turagt ur turig ara akken ad tegber tangalt yettwaselkamen."

#: ../aptdaemon/worker/aptworker.py:1303
#, python-format
msgid "The license key path %s is invalid"
msgstr "Abrid n tsarut n turagt %s d armeɣtu"

#: ../aptdaemon/worker/aptworker.py:1307
#, python-format
msgid "The license key already exists: %s"
msgstr "Tasarut n turagt tella yakan: %s"

#: ../aptdaemon/worker/aptworker.py:1312
#, python-format
msgid ""
"The location of the license key is unsecure since it contains symbolic "
"links. The path %s maps to %s"
msgstr ""
"Adeg n tsarut n turagt d taraɣelsant acku deg-s iseɣwan izamalen. Abrid %s "
"yettakk acbi ɣer %s"

#: ../aptdaemon/worker/aptworker.py:1320
#, python-format
msgid "The directory where to install the key to doesn't exist yet: %s"
msgstr "Akaram ideg ara tesbeddeḍ tasarut ulac-it akka tura: %s"

#: ../aptdaemon/worker/aptworker.py:1331
#, python-format
msgid "Failed to write key file to: %s"
msgstr "Tuccḍa di tira n ufaylu tasarut di: %s"

#: ../aptdaemon/worker/aptworker.py:1366
msgid "The following packages have unmet dependencies:"
msgstr "Ikemmusen-a ɣur-sen tugal ur lhint ara:"

#: ../aptdaemon/worker/aptworker.py:1419
msgid "but it is a virtual package"
msgstr "maca d akemmus uhlis"

#: ../aptdaemon/worker/aptworker.py:1422
msgid "but it is not installed"
msgstr "maca ur yettwasbedd ara"

#: ../aptdaemon/worker/aptworker.py:1424
msgid "but it is not going to be installed"
msgstr "maca ur d-yettili ara usbeddi-ines"

#. TRANSLATORS: %s is a version number
#: ../aptdaemon/worker/aptworker.py:1428
#, python-format
msgid "but %s is installed"
msgstr "maca %s yettwasbedd"

#. TRANSLATORS: %s is a version number
#: ../aptdaemon/worker/aptworker.py:1432
#, python-format
msgid "but %s is to be installed"
msgstr "maca %s ur yettwasbedd ara"
