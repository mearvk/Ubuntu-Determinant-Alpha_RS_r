msgstr ""
"Asebded neɣ tukksa n yal aseɣzan d awezɣi. Ttxil-k·m seqdec amsefrak n "
"ukemmus \"synaptic\" neɣ selkem \"sudo apt-get install -f\" deg yixef i "
"wakken ad tseɣtiḍ ugur-a ddeg tazwara."

#: ../UpdateManager/UpdateManager.py:440
msgid "Could not initialize the package information"
msgstr "D awezɣi ad tettuwennez telɣut n ukemmus"

