#: ../UpdateManager/UpdatesAvailable.py:690
msgid "_Deselect All"
msgstr "Tout _désélectionner"

#: ../UpdateManager/UpdatesAvailable.py:697
msgid "Select _All"
msgstr "Tout _sélectionner"

