msgstr "AVERTISSEMENT"

#: src/vte.cc:7614
#| msgid "GNUTLS not enabled; data will be written to disk unencrypted!"
msgid "GnuTLS not enabled; data will be written to disk unencrypted!"
msgstr ""
"GnuTLS n’est pas activé ; les données seront écrites sur le disque sans être "
"chiffrées !"

