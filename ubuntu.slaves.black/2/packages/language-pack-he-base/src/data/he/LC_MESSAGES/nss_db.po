#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "המר את המפתח לאותיות קטנות"

#: src/makedb.c:69
msgid "NAME"
msgstr "שם"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "כתוב את הפלט לקובץ בשם"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "אל תציג את ההודעות בזמן בניית מסד הנתונים"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr "הצג את תוכן קובץ מסד הנתונים, רשומה בכל שורה"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "צור מסד נתונים פשוט מקלט טקסטואלי."

#. Strings for arguments in help texts.
#: src/makedb.c:81
msgid ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"
msgstr ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "מספר הארגומנטים שגוי"

#: src/makedb.c:154
#, c-format
msgid "cannot open database file `%s': %s"
msgstr "לא ניתן לפתוח את קובץ מסד הנתונים `%s': %s"

#: src/makedb.c:173
#, c-format
msgid "cannot open input file `%s'"
msgstr "לא ניתן לפתוח את קובץ הקלט `%s'"

#: src/makedb.c:187
#, c-format
msgid "cannot open output file `%s': %s"
msgstr "לא ניתן לפתוח את קובץ הפלט `%s': %s"

#. We print some extra information.
#: src/makedb.c:235
msgid "Report bugs using the `glibcbug' script to <bugs@gnu.org>.\n"
msgstr "דווח על באגים באמצעות הסקריפט `glibcbug' אל <bugs@gnu.org>.\n"

