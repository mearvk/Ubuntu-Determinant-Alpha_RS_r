msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr " ,Launchpad Contributions:,Yaron"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ",,sh.yaron@gmail.com"

