msgstr "Андоза"

#: .././usbcreator/frontends/gtk/frontend.py:500
msgid "Device"
msgstr "Дастгоҳ"

#: .././usbcreator/frontends/gtk/frontend.py:516
msgid "Label"
msgstr "Барчасп"

#: .././usbcreator/frontends/gtk/frontend.py:526
msgid "Capacity"
msgstr "Қобилият"

#: .././usbcreator/frontends/gtk/frontend.py:584
msgid "Starting up..."
msgstr "Оғозшавӣ рафта истодааст..."

