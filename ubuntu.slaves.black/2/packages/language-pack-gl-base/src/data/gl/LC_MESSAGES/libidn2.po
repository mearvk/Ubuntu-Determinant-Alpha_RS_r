#: lib/error.c:54
msgid "success"
msgstr "correcto"

#: lib/error.c:56
msgid "out of memory"
msgstr "memoria esgotada"

#: lib/error.c:58
msgid "could not determine locale encoding format"
msgstr "non foi posíbel determinar o formato de codificación do idioma"

#: lib/error.c:60
msgid "could not convert string to UTF-8"
msgstr "non foi posíbel converter a cadea a UTF-8"

#: lib/error.c:62
msgid "string encoding error"
msgstr "erro de codificación da cadea"

#: lib/error.c:64
msgid "string could not be NFC normalized"
msgstr "non foi posíbel normalizar a NFC a cadea"

#: lib/error.c:66
msgid "string contains invalid punycode data"
msgstr "a cadea contén datos «punycode» non válidos"

#: lib/error.c:68
msgid "punycode encoded data will be too large"
msgstr "os datos codificados en «punycode» serán grandes de máis"

#: lib/error.c:70
msgid "punycode conversion resulted in overflow"
msgstr "a conversión de punycode rematou nun desbordamento"

#: lib/error.c:72
msgid "domain name longer than 255 characters"
msgstr "nome do dominio maior de 255 caracteres"

#: lib/error.c:74
msgid "domain label longer than 63 characters"
msgstr "a etiqueta do dominio supera os 63 caracteres"

#: lib/error.c:76
msgid "input A-label is not valid"
msgstr "a entrada A-label non é válida"

#: lib/error.c:78
msgid "input A-label and U-label does not match"
msgstr "a entrada A-label e a U-label non coinciden"

#: lib/error.c:80
msgid "string is not in Unicode NFC format"
msgstr "a cadea non está en formato Unicode NFC"

#: lib/error.c:82
msgid "string contains forbidden two hyphens pattern"
msgstr "a cadea contén un patrón prohibido de dous guións"

#: lib/error.c:84
msgid "string start/ends with forbidden hyphen"
msgstr "a cadea inicia/remata cun guión prohibido"

#: lib/error.c:86
msgid "string contains a forbidden leading combining character"
msgstr "a cadea contén ao inicio un signo combinado prohibido"

#: lib/error.c:88
msgid "string contains a disallowed character"
msgstr "a cadea contén un carácter non permitido"

#: lib/error.c:90
msgid "string contains a forbidden context-j character"
msgstr "a cadea contén un carácter context-j prohibido"

#: lib/error.c:92
msgid "string contains a context-j character with null rule"
msgstr "a cadea contén un carácter context-j coa regra baleira"

#: lib/error.c:94
msgid "string contains a forbidden context-o character"
msgstr "a cadea contén un carácter context-o prohibido"

#: lib/error.c:96
msgid "string contains a context-o character with null rule"
msgstr "a cadea contén un carácter context-o coa regra baleira"

#: lib/error.c:98
msgid "string contains unassigned code point"
msgstr "a cadea contén un pundo de código sen asignar"

#: lib/error.c:100
msgid "string has forbidden bi-directional properties"
msgstr "a cadea ten propiedades bidireccionais prohibidas"

#: lib/error.c:102
msgid "domain label has forbidden dot (TR46)"
msgstr ""

#: lib/error.c:105
msgid "domain label has character forbidden in transitional mode (TR46)"
msgstr ""

#: lib/error.c:109
msgid "domain label has character forbidden in non-transitional mode (TR46)"
msgstr ""

#: lib/error.c:111
msgid "A-label roundtrip failed"
msgstr ""

#: lib/error.c:113
msgid "Unknown error"
msgstr "Erro descoñecido"

#: src/idn2.c:57
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Escriba «%s --help» para obter máis información.\n"

#: src/idn2.c:61
#, c-format
msgid "Usage: %s [OPTION]... [STRINGS]...\n"
msgstr "Uso: %s [OPCIÓN]... [CADEAS]...\n"

#: src/idn2.c:64
msgid ""
"Internationalized Domain Name (IDNA2008) convert STRINGS, or standard "
"input.\n"
"\n"
msgstr ""
"CADEAS convertidas ao Nome de Dominio Internacionalizado (IDNA2008) ou "
"entrada estándar.\n"
"\n"

#: src/idn2.c:68
msgid ""
"Command line interface to the Libidn2 implementation of IDNA2008.\n"
"\n"
"All strings are expected to be encoded in the locale charset.\n"
"\n"
"To process a string that starts with `-', for example `-foo', use `--'\n"
"to signal the end of parameters, as in `idn2 --quiet -- -foo'.\n"
"\n"
"Mandatory arguments to long options are mandatory for short options too.\n"
msgstr ""
"Interface por liña de ordes para a implementación Libidn2 do IDNA2008.\n"
"\n"
"Agarda que todas as cadeas estean codificadas no conxunto de caracteres "
"local.\n"
"\n"
"Para procesar unha cadea que comece con «-», por exemplo «-foo», use «--»\n"
"para marcar o remate dos parámetros como en «idn2 --quiet -- -foo».\n"
"\n"
"Os argumentos obrigatorios para as opcións longas tamén o son para as "
"curtas.\n"

#: src/idn2.c:78
msgid ""
"  -h, --help                Print help and exit\n"
"  -V, --version             Print version and exit\n"
msgstr ""

#: src/idn2.c:82
msgid ""
"  -d, --decode              Decode (punycode) domain name\n"
"  -l, --lookup              Lookup domain name (default)\n"
"  -r, --register            Register label\n"
msgstr ""

#: src/idn2.c:87
msgid ""
"  -T, --tr46t               Enable TR46 transitional processing\n"
"  -N, --tr46nt              Enable TR46 non-transitional processing\n"
"      --no-tr46             Disable TR46 processing\n"
msgstr ""

#: src/idn2.c:92
msgid ""
"      --usestd3asciirules   Enable STD3 ASCII rules\n"
"      --no-alabelroundtrip  Disable A-label roundtrip for lookups\n"
"      --debug               Print debugging information\n"
"      --quiet               Silent operation\n"
msgstr ""

#: src/idn2.c:207
#, c-format
msgid "Charset: %s\n"
msgstr "Conxunto de caracteres: %s\n"

#: src/idn2.c:217
msgid ""
"Type each input string on a line by itself, terminated by a newline "
"character.\n"
msgstr ""
"Escriba cada cadea de entrada nunha única liña, rematada por un carácter de "
"liña nova.\n"

#: src/idn2.c:248
msgid "input error"
msgstr "erro de entrada"
