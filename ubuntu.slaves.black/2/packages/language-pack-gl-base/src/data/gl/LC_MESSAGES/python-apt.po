#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Servidor desde %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Servidor principal"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Servidores personalizados"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Falta a descrición de «%s». Informe desta incidencia."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Unicode incorrecto na descrición de «%s» (%s). Por favor, informe disto."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Non se dispón da lista de cambios"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"A lista de cambios aínda non está dispoñíbel.\n"
"\n"
"Utilice http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"até que os cambios estean dispoñíbeis ou tente máis tarde."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Non foi posíbel descargar a lista de cambios.\n"
"Comprobe a súa conexión á Internet."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Non foi posíbel ler a lista de ficheiros de «%s»"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Non foi posíbel cargar a lista dos ficheiros de control de «%s»"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Non se pode satisfacer a dependencia: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Conflitos co paquete instalado «%s»"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Racha o paquete xa existente «%(pkgname)s» pola dependencia %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"O paquete «%(pkgname)s» entra en conflito con %(targetpkg)s (%(comptype)s "
"%(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Racha o paquete existente «%(pkgname)s», que ten conflitos con: "
"«%(targetpkg)s». Pero o «%(debfile)s» fornéceo mediante: «%(provides)s»"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Non hai un campo Arquitectura no paquete"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"A arquitectura é incorrecta «%s». Execute dpkg --add-architecture para "
"engadila e actualice despois."

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Xa está instalada unha versión máis recente"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr ""
"Produciuse un erro ao tentar satisfacer todas as dependencias (a caché está "
"danada)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Non é posíbel instalar «%s»"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Descomprimido automaticamente:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Convertido automaticamente en ASCII imprimíbel:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Instalar Build-Dependencies para o paquete orixe «%s» que compila %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Eliminaríase un paquete esencial"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Feito"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Prema "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Obt:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Traballando]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Cambio de soporte: introduza o disco etiquetado\n"
" «%s»\n"
"na unidade «%s» e prema Intro\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Recibíronse %sB en %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr "Indique un nome para este recurso, como «Debian 2.1r1 Disk 1»"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Insira un recurso de instalación e prema en Intro"
