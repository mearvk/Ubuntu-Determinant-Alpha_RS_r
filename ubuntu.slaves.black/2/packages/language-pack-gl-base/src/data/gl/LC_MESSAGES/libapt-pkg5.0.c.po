msgstr ""
"Rexistro incorrecto no ficheiro de preferencias %s; falta a cabeceira Package"

#: apt-pkg/policy.cc:398
#, c-format
msgid "Did not understand pin type %s"
msgstr "Non se entendeu o tipo de inmobilización %s"

#: apt-pkg/policy.cc:410
#, c-format
msgid ""
"%s: The special 'Pin-Priority: %s' can only be used for 'Package: *' records"
msgstr ""
"%s: A «Pin-Priority: %s» especial só se pode usar para os rexistros de "
"«Package: *»"

#: apt-pkg/policy.cc:418
#, c-format
msgid "%s: Value %s is outside the range of valid pin priorities (%d to %d)"
msgstr ""
"%s: O valor %s fica fóra do intervalo de prioridades de inmobilización "
"válido (%d a %d)"

#: apt-pkg/policy.cc:425
msgid "No priority (or zero) specified for pin"
msgstr ""
"Non se indicou unha prioridade (ou indicouse cero) para a inmobilización"

