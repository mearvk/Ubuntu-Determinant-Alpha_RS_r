#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Erro interno: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Este mapa xa contén %(1)s -> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "O método %(1)s non é compatíbel."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "O método %(1)s emprega %(2)s parametro(s) (%(3)s dados)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Permiso denegado."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"O valor\" %(2)s\" para %(1)s non se acepta neste servidor. O servidor dixo "
"\"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "O %(1)s manexando %(2)s é incorrecto."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Está tentando facer unha operación non permitida."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"A rede que especificou xa ten un PIF asociado, e polo tanto non se pode "
"asociar outro."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
