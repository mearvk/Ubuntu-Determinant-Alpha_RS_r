#: src/pam_pwquality.c:244
#, c-format
msgid "BAD PASSWORD: %s"
msgstr "CONTRASINAL INCORRECTO: %s"

#: src/pwscore.c:22
#, c-format
msgid "Usage: %s [user]\n"
msgstr "Uso: %s [user]\n"

#: src/pwscore.c:23
#, c-format
msgid ""
"       The command reads the password to be scored from the standard input.\n"
msgstr ""
"       A orde le o contrasinal para o avaliar desde a entrada estándar.\n"

#: src/pwscore.c:53 src/pwscore.c:61 src/pwscore.c:67
#, c-format
msgid "Error: %s\n"
msgstr "Erro: %s\n"

#: src/pwscore.c:53
msgid "Could not obtain the password to be scored"
msgstr "Non se puido obter o contrasinal para o avaliar"

#: src/pwscore.c:75
#, c-format
msgid ""
"Password quality check failed:\n"
" %s\n"
msgstr ""
"O contrasinal non pasou a avaliación de calidade:\n"
" %s\n"

#: src/pwmake.c:23
#, c-format
msgid "Usage: %s <entropy-bits>\n"
msgstr "Uso: %s <bits-entropía>\n"

#: src/pwmake.c:58
#, c-format
msgid ""
"Warning: Value %ld is outside of the allowed entropy range, adjusting it.\n"
msgstr ""
"Advertencia: O valor %ld está fóra do intervalo de entropía permitido; "
"axústase.\n"

#: src/error.c:31
msgid "Memory allocation error when setting"
msgstr "Produciuse un erro de asignación de memoria durante a configuración"

#: src/error.c:35
msgid "Memory allocation error"
msgstr "Produciuse un erro de asignación de memoria"

#: src/error.c:37
msgid "The password is the same as the old one"
msgstr "O contrasinal novo é o mesmo ca o vello"

#: src/error.c:39
msgid "The password is a palindrome"
msgstr "O contrasinal é un palíndromo"

#: src/error.c:41
msgid "The password differs with case changes only"
msgstr "O contrasinal só se diferencia en maiúsculas e minúsculas"

#: src/error.c:43
msgid "The password is too similar to the old one"
msgstr "O contrasinal novo é moi parecido ao antigo"

#: src/error.c:45
msgid "The password contains the user name in some form"
msgstr ""
"O contrasinal contén o nome de persoa usuaria (completa ou parcialmente)"

#: src/error.c:47
msgid ""
"The password contains words from the real name of the user in some form"
msgstr "O contrasinal contén palabras do nome real da persoa usuaria"

#: src/error.c:49
msgid "The password contains forbidden words in some form"
msgstr "O contrasinal contén palabras prohibidas"

#: src/error.c:52
#, c-format
msgid "The password contains less than %ld digits"
msgstr "O contrasinal contén menos de %ld díxitos"

#: src/error.c:55
msgid "The password contains too few digits"
msgstr "O contrasinal contén moi poucos díxitos"

#: src/error.c:58
#, c-format
msgid "The password contains less than %ld uppercase letters"
msgstr "O contrasinal contén menos de %ld letras maiúsculas"

#: src/error.c:61
msgid "The password contains too few uppercase letters"
msgstr "O contrasinal contén moi poucas letras maiúsculas"

#: src/error.c:64
#, c-format
msgid "The password contains less than %ld lowercase letters"
msgstr "O contrasinal contén menos de %ld letras minúsculas"

#: src/error.c:67
msgid "The password contains too few lowercase letters"
msgstr "O contrasinal contén moi poucas letras minúsculas"

#: src/error.c:70
#, c-format
msgid "The password contains less than %ld non-alphanumeric characters"
msgstr "O contrasinal contén menos de %ld caracteres non alfanuméricos"

#: src/error.c:73
msgid "The password contains too few non-alphanumeric characters"
msgstr "O contrasinal contén moi poucos caracteres alfanuméricos"

#: src/error.c:76
#, c-format
msgid "The password is shorter than %ld characters"
msgstr "O contrasinal ten menos de %ld caracteres"

#: src/error.c:79
msgid "The password is too short"
msgstr "O contrasinal é curto de máis"

#: src/error.c:81
msgid "The password is just rotated old one"
msgstr "O contrasinal é igual ca o antigo do revés"

#: src/error.c:84
#, c-format
msgid "The password contains less than %ld character classes"
msgstr "O contrasinal contén menos de %ld tipos de caracteres"

#: src/error.c:87
msgid "The password does not contain enough character classes"
msgstr "O contrasinal non contén suficientes tipos de caracteres"

#: src/error.c:90
#, c-format
msgid "The password contains more than %ld same characters consecutively"
msgstr "O contrasinal contén máis de %ld caracteres iguais consecutivos"

#: src/error.c:93
msgid "The password contains too many same characters consecutively"
msgstr "O contrasinal contén demasiados caracteres iguais consecutivos"

#: src/error.c:96
#, c-format
msgid ""
"The password contains more than %ld characters of the same class "
"consecutively"
msgstr ""
"O contrasinal contén máis de %ld caracteres do mesmo tipo consecutivos"

#: src/error.c:99
msgid ""
"The password contains too many characters of the same class consecutively"
msgstr ""
"O contrasinal contén demasiados caracteres do mesmo tipo consecutivos"

#: src/error.c:102
#, c-format
msgid "The password contains monotonic sequence longer than %ld characters"
msgstr ""
"O contrasinal contén unha secuencia monotónica de máis de %ld caracteres"

#: src/error.c:105
msgid "The password contains too long of a monotonic character sequence"
msgstr ""
"O contrasinal contén unha secuencia de caracteres monotónica demasiado longa"

#: src/error.c:107
msgid "No password supplied"
msgstr "Non se introduciu contrasinal ningún"

#: src/error.c:109
msgid "Cannot obtain random numbers from the RNG device"
msgstr "Non se poden obter números aleatorios do dispositivo RNG"

#: src/error.c:111
msgid "Password generation failed - required entropy too low for settings"
msgstr ""
"Produciuse un erro na xeración do contrasinal - a entropía necesaria é "
"demasiado baixa para as configuracións"

#: src/error.c:114 src/error.c:117
msgid "The password fails the dictionary check"
msgstr "O contrasinal non pasou a avaliación do dicionario"

#: src/error.c:120 src/error.c:124
msgid "Unknown setting"
msgstr "Parámetro descoñecido"

#: src/error.c:127
msgid "Bad integer value of setting"
msgstr "Valor enteiro incorrecto na configuración"

#: src/error.c:131
msgid "Bad integer value"
msgstr "Valor enteiro incorrecto"

#: src/error.c:134
#, c-format
msgid "Setting %s is not of integer type"
msgstr "O parámetro %s non é un número enteiro"

#: src/error.c:138
msgid "Setting is not of integer type"
msgstr "O parámetro non é un número enteiro"

#: src/error.c:141
#, c-format
msgid "Setting %s is not of string type"
msgstr "O parámetro %s non é unha cadea de texto"

#: src/error.c:145
msgid "Setting is not of string type"
msgstr "O parámetro non é unha cadea de texto"

#: src/error.c:147
msgid "Opening the configuration file failed"
msgstr "Produciuse un erro ao abrir o ficheiro de configuración"

#: src/error.c:149
msgid "The configuration file is malformed"
msgstr "O ficheiro de configuración é incorrecto"

#: src/error.c:151
msgid "Fatal failure"
msgstr "Produciuse un erro grave"

#: src/error.c:153
msgid "Unknown error"
msgstr "Produciuse un erro descoñecido"
