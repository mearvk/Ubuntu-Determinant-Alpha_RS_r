#, c-format
msgid "Report bugs to <%s> (in English or Finnish).\n"
msgstr "Informar dos erros  a <%s> (en inglés ou finlandés)\n"

#: src/xz/message.c:1138
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s páxina de inicio: <%s>\n"

#: src/xz/message.c:1142
msgid "THIS IS A DEVELOPMENT VERSION NOT INTENDED FOR PRODUCTION USE."
msgstr ""
"ESTA É UNHA VERSIÓN DE DESENVOLVEMENTO NON DESTINADA A UN USO DE PRODUCIÓN."

#: src/xz/options.c:86
#, c-format
msgid "%s: Options must be `name=value' pairs separated with commas"
msgstr "%s: As opcións deben ser parellas «nome=valor» separadas por comas"

#: src/xz/options.c:93
#, c-format
msgid "%s: Invalid option name"
msgstr "%s: Nome de opción incorrecto"

#: src/xz/options.c:113
#, c-format
msgid "%s: Invalid option value"
msgstr "%s: Valor de opción incorrecto"

#: src/xz/options.c:247
#, c-format
msgid "Unsupported LZMA1/LZMA2 preset: %s"
msgstr "Parámetro LZMA1/LZMA2 non admitido: %s"

#: src/xz/options.c:355
msgid "The sum of lc and lp must not exceed 4"
msgstr "A suma de lc y lp non debe exceder de 4"

#: src/xz/options.c:359
#, c-format
msgid "The selected match finder requires at least nice=%<PRIu32>"
msgstr ""
"O buscador de coincidencias que se seleccionou precisa polo menos "
"nice=%<PRIu32>"

#: src/xz/suffix.c:137 src/xz/suffix.c:268
#, c-format
msgid ""
"%s: With --format=raw, --suffix=.SUF is required unless writing to stdout"
msgstr ""
"%s: con --format=raw, é necesario --suffix=.SUF agás que se estea a escribir "
"en stdout"

#: src/xz/suffix.c:168
#, c-format
msgid "%s: Filename has an unknown suffix, skipping"
msgstr "%s: o nome do ficheiro non ten un sufixo coñecido, omitindo"

#: src/xz/suffix.c:189
#, c-format
msgid "%s: File already has `%s' suffix, skipping"
msgstr "%s: o ficheiro xa ten o sufixo «%s», omitindo"

#: src/xz/suffix.c:405
#, c-format
msgid "%s: Invalid filename suffix"
msgstr "%s: o sufixo do nome de ficheiro non é válido"

#: src/xz/util.c:71
#, c-format
msgid "%s: Value is not a non-negative decimal integer"
msgstr "%s: o valor non é un enteiro decimal non negativo"

#: src/xz/util.c:113
#, c-format
msgid "%s: Invalid multiplier suffix"
msgstr "%s: sufixo multiplicador non válido"

#: src/xz/util.c:115
msgid "Valid suffixes are `KiB' (2^10), `MiB' (2^20), and `GiB' (2^30)."
msgstr "Os sufixos válidos son «KiB» (2^10), «MiB» (2^20) e «GiB» (2^30)"

#: src/xz/util.c:132
#, c-format
msgid "Value of the option `%s' must be in the range [%<PRIu64>, %<PRIu64>]"
msgstr "O valor da opción «%s» debe estar no rango [%<PRIu64>, %<PRIu64>]"

#: src/xz/file_io.c:763
msgid "Empty filename, skipping"
msgstr "Nome de ficheiro baleiro, omitindo"

#: src/xz/util.c:269
msgid "Compressed data cannot be read from a terminal"
msgstr "Os datos comprimidos non poden lerse desde unha terminal"

#: src/xz/util.c:282
msgid "Compressed data cannot be written to a terminal"
msgstr "Os datos comprimidos non poden escribirse nunha terminal"

#: src/common/tuklib_exit.c:40
msgid "Writing to standard output failed"
msgstr "Produciuse un fallo de escritura na saída estándar"

#: src/common/tuklib_exit.c:43
msgid "Unknown error"
msgstr "Erro descoñecido"
