#: src/xz/args.c:77
#, c-format
msgid "%s: Invalid argument to --block-list"
msgstr "%s: Argumento incorrecto para --block-list"

#: src/xz/args.c:87
#, c-format
msgid "%s: Too many arguments to --block-list"
msgstr "%s: Demasiados argumentos para --block-list"

#: src/xz/args.c:116
msgid "0 can only be used as the last element in --block-list"
msgstr "0 unicamente se pode usar como argumento en --block-list"

#: src/xz/args.c:451
#, c-format
msgid "%s: Unknown file format type"
msgstr "%s: tipo de formato de ficheiro descoñecido"

#: src/xz/args.c:474 src/xz/args.c:482
#, c-format
msgid "%s: Unsupported integrity check type"
msgstr "%s: tipo de comprobación de integridade non admitido"

#: src/xz/args.c:518
msgid "Only one file can be specified with `--files' or `--files0'."
msgstr "Só pode especificar un ficheiro con «--files» ou «--files0»."

#: src/xz/args.c:586
#, c-format
msgid "The environment variable %s contains too many arguments"
msgstr "A variábel de contorno %s contene demasiados argumentos"

#: src/xz/args.c:688
msgid "Compression support was disabled at build time"
msgstr ""
"A compatibilidade coa compresión foi desactivada no momento da construción."

#: src/xz/args.c:695
msgid "Decompression support was disabled at build time"
msgstr ""
"A compatibilidade coa descompresión foi desactivada no momento da "
"construción."

#: src/xz/coder.c:115
msgid "Maximum number of filters is four"
msgstr "O número máximo de filtros é de catro"

#: src/xz/coder.c:134
msgid "Memory usage limit is too low for the given filter setup."
msgstr ""
"O límite de uso de memoria é demasiado baixo para a configuración do fitro."

#: src/xz/coder.c:169
msgid "Using a preset in raw mode is discouraged."
msgstr "Desaconséllase a utilización de parámetros no modo en bruto."

#: src/xz/coder.c:171
msgid "The exact options of the presets may vary between software versions."
msgstr ""
"As opcións exactas dos parámetros poden variar entre versións do software."

#: src/xz/coder.c:194
msgid "The .lzma format supports only the LZMA1 filter"
msgstr "O formato .lzma soamente permite o filtro LZMA1"

#: src/xz/coder.c:202
msgid "LZMA1 cannot be used with the .xz format"
msgstr "LZMA1 non pode usarse co formato .xz"

#: src/xz/coder.c:219
msgid "The filter chain is incompatible with --flush-timeout"
msgstr "A cadea do filtro é incompatíbel con --flush-timeout"

#: src/xz/coder.c:225
msgid "Switching to single-threaded mode due to --flush-timeout"
msgstr "Cambiando ao modo de fío único debido a --flush-timeout"

#: src/xz/coder.c:249
#, c-format
msgid "Using up to %<PRIu32> threads."
msgstr "Usar até %<PRIu32> fíos."

#: src/xz/coder.c:265
msgid "Unsupported filter chain or filter options"
msgstr "Cadea de filtro ou opcións de filtro non admitida"

#: src/xz/coder.c:277
#, c-format
msgid "Decompression will need %s MiB of memory."
msgstr "A descompresión precisa de %s MiB de memoria"

#: src/xz/coder.c:300
#, c-format
msgid ""
"Adjusted the number of threads from %s to %s to not exceed the memory usage "
"limit of %s MiB"
msgstr ""
"Axustado o número de fíos de %s a %s para non exceder o límite de uso da "
"memoria de %s MiB"

#: src/xz/coder.c:411
#, c-format
msgid ""
"Adjusted LZMA%c dictionary size from %s MiB to %s MiB to not exceed the "
"memory usage limit of %s MiB"
msgstr ""
"Tamaño de dicionario LZMA%c axustado desde %s MiB a %s MiB para non exceder "
"o límite de uso de memoria de %s MiB"

#: src/xz/file_io.c:110 src/xz/file_io.c:118
#, c-format
msgid "Error creating a pipe: %s"
msgstr "Produciuse un erro creando a canalización: %s"

#: src/xz/file_io.c:235
msgid "Failed to enable the sandbox"
msgstr ""

#: src/xz/file_io.c:277
#, c-format
msgid "%s: poll() failed: %s"
msgstr "%s: poll() fallou: %s"

#. TRANSLATORS: When compression or decompression finishes,
#. and xz is going to remove the source file, xz first checks
#. if the source file still exists, and if it does, does its
#. device and inode numbers match what xz saw when it opened
#. the source file. If these checks fail, this message is
#. shown, %s being the filename, and the file is not deleted.
#. The check for device and inode numbers is there, because
#. it is possible that the user has put a new file in place
#. of the original file, and in that case it obviously
#. shouldn't be removed.
#: src/xz/file_io.c:344
#, c-format
msgid "%s: File seems to have been moved, not removing"
msgstr "%s: Semella que se moveu o ficheiro, non retirado"

#: src/xz/file_io.c:351 src/xz/file_io.c:907
#, c-format
msgid "%s: Cannot remove: %s"
msgstr "%s: non é posíbel retirar: %s"

#: src/xz/file_io.c:377
#, c-format
msgid "%s: Cannot set the file owner: %s"
msgstr "%s: non é posíbel definir o propietario do ficheiro: %s"

#: src/xz/file_io.c:390
#, c-format
msgid "%s: Cannot set the file group: %s"
msgstr "%s: non é posíbel definir o grupo do ficheiro: %s"

#: src/xz/file_io.c:409
#, c-format
msgid "%s: Cannot set the file permissions: %s"
msgstr "%s: non é posíbel definir os permisos do ficheiro: %s"

#: src/xz/file_io.c:535
#, c-format
msgid "Error getting the file status flags from standard input: %s"
msgstr ""
"Produciuse un erro obtendo as bandeiras do estado do ficheiro desde a "
"entrada estándar: %s"

#: src/xz/file_io.c:593 src/xz/file_io.c:655
#, c-format
msgid "%s: Is a symbolic link, skipping"
msgstr "%s: é unha ligazón simbólica, omitindo"

#: src/xz/file_io.c:684
#, c-format
msgid "%s: Is a directory, skipping"
msgstr "%s: é un directorio, omitindo"

#: src/xz/file_io.c:690
#, c-format
msgid "%s: Not a regular file, skipping"
msgstr "%s: non é un ficheiro regular, omitindo"

#: src/xz/file_io.c:707
#, c-format
msgid "%s: File has setuid or setgid bit set, skipping"
msgstr "%s: o ficheiro posúe o bit setuid ou setgid activo, omitindo"

#: src/xz/file_io.c:714
#, c-format
msgid "%s: File has sticky bit set, skipping"
msgstr "%s: o ficheiro posúe o bit pegañento activo, omitindo"

#: src/xz/file_io.c:721
#, c-format
msgid "%s: Input file has more than one hard link, skipping"
msgstr "%s: o ficheiro de entrada posúe máis de unha ligazón dura, omitindo"

#: src/xz/file_io.c:817
#, c-format
msgid "Error restoring the status flags to standard input: %s"
msgstr ""
"Produciuse un erro restabelecendo as bandeiras do estado á entrada estándar: "
"%s"

#: src/xz/file_io.c:865
#, c-format
msgid "Error getting the file status flags from standard output: %s"
msgstr ""
"Produciuse un erro obtendo as bandeiras do estado do ficheiro desde a "
"entrada estándar: %s"

#: src/xz/file_io.c:1043
#, c-format
msgid "Error restoring the O_APPEND flag to standard output: %s"
msgstr ""
"Produciuse un erro ao restaurar a opción O_APPEND á saída estándar: %s"

#: src/xz/file_io.c:1055
#, c-format
msgid "%s: Closing the file failed: %s"
msgstr "%s: produciuse un fallo ao pechar o ficheiro: %s"

#: src/xz/file_io.c:1091 src/xz/file_io.c:1354
#, c-format
msgid "%s: Seeking failed when trying to create a sparse file: %s"
msgstr "%s: a busca fallou ao tentar crear un ficheiro «sparse»: %s"

#: src/xz/file_io.c:1192
#, c-format
msgid "%s: Read error: %s"
msgstr "%s: producíuse un erro de lectura: %s"

#: src/xz/file_io.c:1222
#, c-format
msgid "%s: Error seeking the file: %s"
msgstr "%s: produciuse un erro ao buscar o ficheiro: %s"

#: src/xz/file_io.c:1246
#, c-format
msgid "%s: Unexpected end of file"
msgstr "%s: fin de ficheiro non agardado"

#: src/xz/file_io.c:1305
#, c-format
msgid "%s: Write error: %s"
msgstr "%s: producíuse un erro de escritura: %s"

