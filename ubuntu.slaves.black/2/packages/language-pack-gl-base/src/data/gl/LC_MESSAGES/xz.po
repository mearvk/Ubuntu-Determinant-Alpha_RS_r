#. TRANSLATORS: These are column headings. From Strms (Streams)
#. to Ratio, the columns are right aligned. Check and Filename
#. are left aligned. If you need longer words, it's OK to
#. use two lines here. Test with "xz -l foo.xz".
#: src/xz/list.c:730
msgid "Strms  Blocks   Compressed Uncompressed  Ratio  Check   Filename"
msgstr "Fluxos Bloques  Comprimido Descomprimido Relac. Proba   NomeFich"

#: src/xz/list.c:717
#, c-format
msgid "  Streams:            %s\n"
msgstr "  Fluxos:                 %s\n"

#: src/xz/list.c:719
#, c-format
msgid "  Blocks:             %s\n"
msgstr "  Bloques:                %s\n"

#: src/xz/list.c:721
#, c-format
msgid "  Compressed size:    %s\n"
msgstr "  Tamaño comprimido:      %s\n"

#: src/xz/list.c:724
#, c-format
msgid "  Uncompressed size:  %s\n"
msgstr "  Tamaño descomprimido:   %s\n"

#: src/xz/list.c:727
#, c-format
msgid "  Ratio:              %s\n"
msgstr "  Relación:               %s\n"

#: src/xz/list.c:729
#, c-format
msgid "  Check:              %s\n"
msgstr "  Proba:                  %s\n"

#: src/xz/list.c:730
#, c-format
msgid "  Stream padding:     %s\n"
msgstr "  Fluxos de recheo:       %s\n"

#. TRANSLATORS: The second line is column headings. All except
#. Check are right aligned; Check is left aligned. Test with
#. "xz -lv foo.xz".
#: src/xz/list.c:758
msgid ""
"  Streams:\n"
"    Stream    Blocks      CompOffset    UncompOffset        CompSize      "
"UncompSize  Ratio  Check      Padding"
msgstr ""
"  Fluxos:\n"
"    Fluxo     Bloques     DesprCompr    DesprDescompr       TamCompri     "
"TamDescomp  Relac. Proba      Recheo"

#. TRANSLATORS: The second line is column headings. All
#. except Check are right aligned; Check is left aligned.
#: src/xz/list.c:813
#, c-format
msgid ""
"  Blocks:\n"
"    Stream     Block      CompOffset    UncompOffset       TotalSize      "
"UncompSize  Ratio  Check"
msgstr ""
"  Bloques:\n"
"    Fluxo  Bloqu DesprCompr DesprDescomp TamTotal  TamDescomp Relac. Proba"

#. TRANSLATORS: These are additional column headings
#. for the most verbose listing mode. CheckVal
#. (Check value), Flags, and Filters are left aligned.
#. Header (Block Header Size), CompSize, and MemUsage
#. are right aligned. %*s is replaced with 0-120
#. spaces to make the CheckVal column wide enough.
#. Test with "xz -lvv foo.xz".
#: src/xz/list.c:825
#, c-format
msgid "      CheckVal %*s Header  Flags        CompSize    MemUsage  Filters"
msgstr "      ProbaVal %*s Cabece Marca TamCompr UsoMemor Filtros"

#: src/xz/list.c:903 src/xz/list.c:1078
#, c-format
msgid "  Memory needed:      %s MiB\n"
msgstr "  Memoria necesaria:      %s MiB\n"

#: src/xz/list.c:905 src/xz/list.c:1080
#, c-format
msgid "  Sizes in headers:   %s\n"
msgstr "  Tamaños nas cabeceiras: %s\n"

#: src/xz/list.c:1025 src/xz/list.c:1203
msgid "Yes"
msgstr "Si"

#: src/xz/list.c:1025 src/xz/list.c:1203
msgid "No"
msgstr "Non"

#: src/xz/list.c:1027 src/xz/list.c:1205
#, c-format
msgid "  Minimum XZ Utils version: %s\n"
msgstr "  Versión mínima de XZ Utils: %s\n"

#. TRANSLATORS: %s is an integer. Only the plural form of this
#. message is used (e.g. "2 files"). Test with "xz -l foo.xz bar.xz".
#: src/xz/list.c:1178
#, c-format
msgid "%s file\n"
msgid_plural "%s files\n"
msgstr[0] "%s ficheiro\n"
msgstr[1] "%s ficheiros\n"

#: src/xz/list.c:1191
msgid "Totals:"
msgstr "Totais:"

#: src/xz/list.c:1071
#, c-format
msgid "  Number of files:    %s\n"
msgstr "  Número de ficheiros:    %s\n"

#: src/xz/list.c:1269
msgid "--list works only on .xz files (--format=xz or --format=auto)"
msgstr "--list traballa só con ficheiros .xz (--format=xz ou --format=auto)"

#: src/xz/list.c:1275
msgid "--list does not support reading from standard input"
msgstr "--list non é compatíbel coa lectura da entrada estándar"

#: src/xz/main.c:89
#, c-format
msgid "%s: Error reading filenames: %s"
msgstr "%s: producíuse un erro ao ler os nomes de ficheiros: %s"

#: src/xz/main.c:96
#, c-format
msgid "%s: Unexpected end of input when reading filenames"
msgstr "%s: fin de entrada non agardado cando se lían os nomes de ficheiro"

#: src/xz/main.c:120
#, c-format
msgid ""
"%s: Null character found when reading filenames; maybe you meant to use `--"
"files0' instead of `--files'?"
msgstr ""
"%s: atopouse o carácter nulo cando se lían os nomes de ficheiro, quixo "
"empregar «--files0» no canto de «--files»?"

#: src/xz/main.c:188
msgid "Compression and decompression with --robot are not supported yet."
msgstr "A compresión e descompresión con --robot aínda non están admitidas."

#: src/xz/main.c:266
msgid ""
"Cannot read data from standard input when reading filenames from standard "
"input"
msgstr ""
"Non é posíbel ler os datos desde a entrada estándar cando se len os nomes de "
"ficheiro da entrada estándar"

#. TRANSLATORS: This is the program name in the beginning
#. of the line in messages. Usually it becomes "xz: ".
#. This is a translatable string because French needs
#. a space before a colon.
#: src/xz/message.c:725
#, c-format
msgid "%s: "
msgstr "%s: "

#: src/xz/message.c:797 src/xz/message.c:856
msgid "Internal error (bug)"
msgstr "Erro interno (bug)"

#: src/xz/message.c:804
msgid "Cannot establish signal handlers"
msgstr "Non é posíbel estabelecer os manexadores de sinal"

#: src/xz/message.c:813
msgid "No integrity check; not verifying file integrity"
msgstr ""
"Non se comproba a integridade; non se verifica a integridade do ficheiro"

#: src/xz/message.c:816
msgid "Unsupported type of integrity check; not verifying file integrity"
msgstr ""
"Tipo de integridade non admitido; non se verifica a integridade do ficheiro"

#: src/xz/message.c:823
msgid "Memory usage limit reached"
msgstr "Acadado o límite de uso da memoria"

#: src/xz/message.c:826
msgid "File format not recognized"
msgstr "Non se recoñece o formato de ficheiro"

#: src/xz/message.c:829
msgid "Unsupported options"
msgstr "Opcións non admitidas"

#: src/xz/message.c:832
msgid "Compressed data is corrupt"
msgstr "Os datos comprimidos están danados"

#: src/xz/message.c:835
msgid "Unexpected end of input"
msgstr "Fin de datos non agardado"

#: src/xz/message.c:877
#, c-format
msgid "%s MiB of memory is required. The limiter is disabled."
msgstr "Requírense %s MiB de memoria. O limitador está desactivado."

#: src/xz/message.c:905
#, c-format
msgid "%s MiB of memory is required. The limit is %s."
msgstr "Requírense %s MiB de memoria. O límite é %s."

#: src/xz/message.c:924
#, c-format
msgid "%s: Filter chain: %s\n"
msgstr "%s: Cadea de filtros: %s\n"

#: src/xz/message.c:935
#, c-format
msgid "Try `%s --help' for more information."
msgstr "Probe «%s --help» para obter máis información."

#: src/xz/message.c:961
#, c-format
msgid ""
"Usage: %s [OPTION]... [FILE]...\n"
"Compress or decompress FILEs in the .xz format.\n"
"\n"
msgstr ""
"Uso: %s [OPCIÓN]... [FICHEIRO]...\n"
"Comprimir ou descomprimir FICHEIROs no formato .xz.\n"
"\n"

#: src/xz/message.c:968
msgid ""
"Mandatory arguments to long options are mandatory for short options too.\n"
msgstr ""
"Os argumentos obrigatorios para as opcións longas son tamén obrigatorios "
"para\n"
"as opcións curtas.\n"

#: src/xz/message.c:972
msgid " Operation mode:\n"
msgstr " Modo de operación:\n"

#: src/xz/message.c:975
msgid ""
"  -z, --compress      force compression\n"
"  -d, --decompress    force decompression\n"
"  -t, --test          test compressed file integrity\n"
"  -l, --list          list information about .xz files"
msgstr ""
"  -z, --compress      forza a compresión\n"
"  -d, --decompress    forza a descompresión\n"
"  -t, --test          proba a integridade do ficheiro comprimido\n"
"  -l, --list          lista información sobre arquivos .xz"

#: src/xz/message.c:981
msgid ""
"\n"
" Operation modifiers:\n"
msgstr ""
"\n"
" Modificadores de operación:\n"

#: src/xz/message.c:984
msgid ""
"  -k, --keep          keep (don't delete) input files\n"
"  -f, --force         force overwrite of output file and (de)compress links\n"
"  -c, --stdout        write to standard output and don't delete input files"
msgstr ""
"  -k, --keep Manter (non borrar) os ficheiro de entrada\n"
"  -f, --force  Forza a sobrescritura do ficheiro de saída e (des)comprime "
"ligazóns\n"
"  -c, --stdout Escribe sobre a saída estándar e non borra os ficheiros de "
"entrada"

#: src/xz/message.c:993
msgid ""
"      --single-stream decompress only the first stream, and silently\n"
"                      ignore possible remaining input data"
msgstr ""
"      --single-stream descomprime soamente o primeiro fluxo, e ignora\n"
"                      silenciosamente posíbeis datos de entrada que falten"

#: src/xz/message.c:996
msgid ""
"      --no-sparse     do not create sparse files when decompressing\n"
"  -S, --suffix=.SUF   use the suffix `.SUF' on compressed files\n"
"      --files[=FILE]  read filenames to process from FILE; if FILE is\n"
"                      omitted, filenames are read from the standard input;\n"
"                      filenames must be terminated with the newline "
"character\n"
"      --files0[=FILE] like --files but use the null character as terminator"
msgstr ""
"      --no-sparse     non crear ficheiros dispersos ao descomprimir\n"
"  -S, --suffix=.SUF   empregar o sufixo «.SUF» nos ficheiros comprimidos\n"
"      --files[=FICH]  ler os nomes de ficheiro de proceso de FICH; se FICH "
"é\n"
"                      omitido, os nomes de ficheiro lense da entrada "
"estándar;\n"
"                      os nomes de ficheiro deben rematar co carácter de nova "
"liña\n"
"      --files0[=FICH] como --files mais empregando o carácter nulo na fin"

#: src/xz/message.c:1005
msgid ""
"\n"
" Basic file format and compression options:\n"
msgstr ""
"\n"
" Formato de ficheiro básico e opcións de compresión:\n"

#: src/xz/message.c:1136
msgid ""
"  -F, --format=FMT    file format to encode or decode; possible values are\n"
"                      `auto' (default), `xz', `lzma', and `raw'\n"
"  -C, --check=CHECK   integrity check type: `none' (use with caution),\n"
"                      `crc32', `crc64' (default), or `sha256'"
msgstr ""
"  -F, --format=FORMATO    formato do ficheiro a codificar ou descodificar; "
"os poaíbeis valores son\n"
"                      «auto» (predeterminado), «xz», «lzma», e «raw»\n"
"  -C, --check=PROBA   tipo de proba de integridade: «none» (usar con tino),\n"
"                      «crc32», «crc64» (pedeterminado), ou «sha256»"

#: src/xz/message.c:1012
msgid ""
"      --ignore-check  don't verify the integrity check when decompressing"
msgstr ""
"      --ignore-check  non verificar a comprobación da integridade ao "
"descomprimir"

#: src/xz/message.c:1016
msgid ""
"  -0 ... -9           compression preset; default is 6; take compressor "
"*and*\n"
"                      decompressor memory usage into account before using 7-"
"9!"
msgstr ""
"  -0 ... -9           compresión predetrminada; a predeterminada é 6; "
"indicar o uso de\n"
"                      memoria antes de comprimir *e* descomprimir empregando "
"7-9!"

#: src/xz/message.c:1020
msgid ""
"  -e, --extreme       try to improve compression ratio by using more CPU "
"time;\n"
"                      does not affect decompressor memory requirements"
msgstr ""
"  -e, --extreme       tentar mellorar a relación de compresión empregando "
"máis tempo de CPU;\n"
"                      non afecta aos requisitos de memoria do descompresor"

#: src/xz/message.c:1024
msgid ""
"  -T, --threads=NUM   use at most NUM threads; the default is 1; set to 0\n"
"                      to use as many threads as there are processor cores"
msgstr ""
"  -T, --threads=NUM   empregar un NUM máximo de fíos; por omisión 1; "
"configure 0\n"
"                      para empregar tantos fíos como núcleos de procesador "
"haxa"

#: src/xz/message.c:1029
msgid ""
"      --block-size=SIZE\n"
"                      start a new .xz block after every SIZE bytes of "
"input;\n"
"                      use this to set the block size for threaded compression"
msgstr ""
"      --block-size=TAMAÑO\n"
"                      iniciar un bloque .xz novo despois de cada TAMAÑo "
"bytes de entrada;\n"
"                      empregue isto para indicar o tamaño dos bloques na "
"comprensión con fíos"

#: src/xz/message.c:1033
msgid ""
"      --block-list=SIZES\n"
"                      start a new .xz block after the given comma-separated\n"
"                      intervals of uncompressed data"
msgstr ""
"      --block-list=TAMAÑOS\n"
"                      iniciar un bloque .xz novo despois dos intervalos\n"
"                      separados por vírgulas de datos sen comprimir"

#: src/xz/message.c:1037
msgid ""
"      --flush-timeout=TIMEOUT\n"
"                      when compressing, if more than TIMEOUT milliseconds "
"has\n"
"                      passed since the previous flush and reading more "
"input\n"
"                      would block, all pending data is flushed out"
msgstr ""
"      --flush-timeout=TEMPO_LÍMITE\n"
"                      na compresión, se pasaron máis de TEMPO_LÍMITE "
"milisegundos\n"
"                      desde a transferencia anterior e ler máis entradas "
"produciría un bloqueo,\n"
"                      todos os datos pendentes se desaloxan."

#: src/xz/message.c:1172
#, no-c-format
msgid ""
"      --memlimit-compress=LIMIT\n"
"      --memlimit-decompress=LIMIT\n"
"  -M, --memlimit=LIMIT\n"
"                      set memory usage limit for compression, "
"decompression,\n"
"                      or both; LIMIT is in bytes, % of RAM, or 0 for defaults"
msgstr ""
"      --memlimit-compress=LIMITE\n"
"      --memlimit-decompress=LIMITE\n"
"  -M, --memlimit=LIMITE\n"
"                      estabelece o límite de uso de memoria para a "
"compresión, descompresión,\n"
"                      ou ambas; LIMITE indicase en bytes, % de RAM, ou 0 "
"para predeterminado"

#: src/xz/message.c:1052
msgid ""
"      --no-adjust     if compression settings exceed the memory usage "
"limit,\n"
"                      give an error instead of adjusting the settings "
"downwards"
msgstr ""
"      --no-adjust     se os axustes de compresión exceden o límite de uso de "
"memoria,\n"
"                      devolverá un erro no canto de axustar á baixa a "
"configuración"

#: src/xz/message.c:1058
msgid ""
"\n"
" Custom filter chain for compression (alternative for using presets):"
msgstr ""
"\n"
" Cadea de filtrado personalizada para compresión (alternativa ao uso de "
"parámetros):"

#: src/xz/message.c:1067
msgid ""
"\n"
"  --lzma1[=OPTS]      LZMA1 or LZMA2; OPTS is a comma-separated list of zero "
"or\n"
"  --lzma2[=OPTS]      more of the following options (valid values; "
"default):\n"
"                        preset=PRE reset options to a preset (0-9[e])\n"
"                        dict=NUM   dictionary size (4KiB - 1536MiB; 8MiB)\n"
"                        lc=NUM     number of literal context bits (0-4; 3)\n"
"                        lp=NUM     number of literal position bits (0-4; 0)\n"
"                        pb=NUM     number of position bits (0-4; 2)\n"
"                        mode=MODE  compression mode (fast, normal; normal)\n"
"                        nice=NUM   nice length of a match (2-273; 64)\n"
"                        mf=NAME    match finder (hc3, hc4, bt2, bt3, bt4; "
"bt4)\n"
"                        depth=NUM  maximum search depth; 0=automatic "
"(default)"
msgstr ""
"\n"
"  --lzma1[=OPCIÓNS]      LZMA1 ou LZMA2; OPCIÓNS é unha lista de ceros "
"separados por comas ou\n"
"  --lzma2[=OPCIÓNS]      algunha das seguintes opcións (valores válidos; "
"predeterminado):\n"
"                        preset=PRE restabelece as opcións a predefinidas (0-"
"9[e])\n"
"                        dict=NÚM   tamaño do dicionario (4KiB - 1536MiB; "
"8MiB)\n"
"                        lc=NÚM     número de bits do contexto literal (0-4; "
"3)\n"
"                        lp=NÚM     número de bits da posición literal (0-4; "
"0)\n"
"                        pb=NÚM     número de bits da posición (0-4; 2)\n"
"                        mode=MODO  modo de compresión (fast, normal; "
"normal)\n"
"                        nice=NÚM   lonxitude ideal dunha coincidencia (2-"
"273; 64)\n"
"                        mf=NOME   buscador de coincidencias (hc3, hc4, bt2, "
"bt3, bt4; bt4)\n"
"                        depth=NÚM  máxima profundidade de busca; "
"0=automático (predeterminado)"

#: src/xz/message.c:1209
msgid ""
"\n"
"  --x86[=OPTS]        x86 BCJ filter (32-bit and 64-bit)\n"
"  --powerpc[=OPTS]    PowerPC BCJ filter (big endian only)\n"
"  --ia64[=OPTS]       IA-64 (Itanium) BCJ filter\n"
"  --arm[=OPTS]        ARM BCJ filter (little endian only)\n"
"  --armthumb[=OPTS]   ARM-Thumb BCJ filter (little endian only)\n"
"  --sparc[=OPTS]      SPARC BCJ filter\n"
"                      Valid OPTS for all BCJ filters:\n"
"                        start=NUM  start offset for conversions (default=0)"
msgstr ""
"\n"
"  --x86[=OPCIÓNS]        filtro BCJ x86 (32-bit e 64-bit)\n"
"  --powerpc[=OPCIÓNS]    filtro BCJ PowerPC (só big endian)\n"
"  --ia64[=OPCIÓNS]       filtro BCJ IA-64 (Itanium)\n"
"  --arm[=OPCIÓNS]        filtro BCJ ARM (só little endian)\n"
"  --armthumb[=OPCIÓNS]   filtro BCJ ARM-Thumb (só little endian)\n"
"  --sparc[=OPCIÓNS]      filtro BCJ SPARC\n"
"                      OPCIÓNS válidas para todos os filtros BCJ:\n"
"                        start=NUM  desprazamento inicial para conversións "
"(predeterminado=0)"

#: src/xz/message.c:1095
msgid ""
"\n"
"  --delta[=OPTS]      Delta filter; valid OPTS (valid values; default):\n"
"                        dist=NUM   distance between bytes being subtracted\n"
"                                   from each other (1-256; 1)"
msgstr ""
"\n"
"  --delta[= OPCNS]      filtro Delta; OPCNS válidas (valores válidos; "
"predeterminado):\n"
"                        dist=NUM   distancia entre os bytes que se van "
"subtraer\n"
"                                   entre si (1-256; 1)"

#: src/xz/message.c:1103
msgid ""
"\n"
" Other options:\n"
msgstr ""
"\n"
" Outras opcións:\n"

#: src/xz/message.c:1106
msgid ""
"  -q, --quiet         suppress warnings; specify twice to suppress errors "
"too\n"
"  -v, --verbose       be verbose; specify twice for even more verbose"
msgstr ""
"  -q, --quiet         suprimir os avisos; especificar dúas veces para "
"suprimir tamén os erros\n"
"  -v, --verbose       detallar; especificar dúas veces para que sexa aínda "
"máis detallado"

#: src/xz/message.c:1111
msgid "  -Q, --no-warn       make warnings not affect the exit status"
msgstr ""
"  -Q, --no-warn       facer que os avisos non afecten o estado de saída"

#: src/xz/message.c:1113
msgid ""
"      --robot         use machine-parsable messages (useful for scripts)"
msgstr ""
"      --robot         empregar mensaxes que poida analizar o computador "
"(útil para scripts)"

#: src/xz/message.c:1116
msgid ""
"      --info-memory   display the total amount of RAM and the currently "
"active\n"
"                      memory usage limits, and exit"
msgstr ""
"      --info-memory   mostra a cantidade de RAM e o límite de uso de\n"
"                      memoria activa e sae"

#: src/xz/message.c:1119
msgid ""
"  -h, --help          display the short help (lists only the basic options)\n"
"  -H, --long-help     display this long help and exit"
msgstr ""
"  -h, --help          mostrar a axuda curta (lista só as opcións básicas)\n"
"  -H, --long-help     mostrar esta axuda longa e saír"

#: src/xz/message.c:1123
msgid ""
"  -h, --help          display this short help and exit\n"
"  -H, --long-help     display the long help (lists also the advanced options)"
msgstr ""
"  -h, --help          mostrar esta axuda curta e saír\n"
"  -H, --long-help     mostrar a axuda longa (tamén lista as opcións "
"avanzadas)"

#: src/xz/message.c:1128
msgid "  -V, --version       display the version number and exit"
msgstr "  -V, --version       mostrar o número de versión e saír"

#: src/xz/message.c:1130
msgid ""
"\n"
"With no FILE, or when FILE is -, read standard input.\n"
msgstr ""
"\n"
"Sen FICHEIRO, ou cando FICHEIRO é -, lese da entrada estándar.\n"

