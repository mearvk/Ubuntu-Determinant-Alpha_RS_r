#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Este programa necesita iniciarse como root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Crear e formatar un dispositivo LUKS cifrado\n"
"Uso: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Erro: dispositivo montado: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Erro:sistema de ficheiros incorrecto: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr ""
"Erro: non foi posíbel xerar temporalmente o nome do ficheiro conectado"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Creando un dispositivo cifrado en %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Non foi posíbel crear o dispositivo LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Introduza a súa frase de paso de novo para verificalo\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "As frases de paso introducidas non son idénticas\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Non foi posíbel formatar o dispositivo co sistema de ficheiros %s"
