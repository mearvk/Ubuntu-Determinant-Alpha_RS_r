msgstr "Cambie as cores de Byobu"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Activar/desactivar notificacións"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Cambiar o conxunto de atallos de teclado"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Cambiar a secuencia de escape"

#: byobu-config:94
msgid "Create new windows"
msgstr "Crear novas xanelas"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Administrar as xanelas predeterminadas"

