#: ../data/local.scope.in.in.h:1
msgid "Videos"
msgstr "Bideoak"

#: ../data/local.scope.in.in.h:2
msgid ""
"This is an Ubuntu search plugin that enables local videos to be searched and "
"displayed in the Dash underneath the Video header. If you do not wish to "
"search this content source, you can disable this search plugin."
msgstr ""
"Ubunturen bilaketa-plugin bat da, bideo lokalak bilatu eta abio-leihoan "
"bistaratzea ahalbidetzeko, Bideoak izenburupean. Bilaketa-jatorri hau "
"erabiltzerik nahi ez baduzu, bilaketarako plugin hau desgaitu dezakezu."

#: ../data/remote.scope.in.in.h:1
msgid "Remote videos"
msgstr "Urruneko bideoak"

#: ../data/remote.scope.in.in.h:2
msgid ""
"This is an Ubuntu search plugin that enables information from various video "
"providers to be searched and displayed in the Dash underneath the Video "
"header. If you do not wish to search these content sources, you can disable "
"this search plugin."
msgstr ""
"Ubunturen bilaketa-plugin bat da, hainbat bideo-hornitzaileren informazioa "
"bilatu eta abio-leihoan bistaratzea ahalbidetzeko, Bideoak izenburupean. "
"Bilaketa-jatorri hau erabiltzerik nahi ez baduzu, bilaketarako plugin hau "
"desgaitu dezakezu."
