msgid "devhelp;dev;help;doc;"
msgstr "devhelp;garapena;laguntza;dokumentazioa;"

#: ../data/devhelp.scope.in.h:2
msgid "Devhelp"
msgstr "Devhelp"

#: ../data/devhelp.scope.in.h:3
msgid ""
"This is an Ubuntu search plugin that enables information from Devhelp to be "
"searched and displayed in the Dash underneath the Code header. If you do not "
"wish to search this content source, you can disable this search plugin."
msgstr ""
"Ubunturen bilaketa-plugin bat da, Devhelp-eko informazioa bilatu eta "
"emaitzak abio-leihoan bistaratzea ahalbidetzeko, Kodea izenburupean. "
"Bilaketa-jatorri hau erabiltzerik nahi ez baduzu, bilaketarako plugin hau "
"desgaitu dezakezu."
