msgstr "Eguneraketa guztiak instalatu"

#: ../src/update.c:36
msgid "Check for updates"
msgstr "Eguneraketarik dagoen egiaztatu"

#: ../src/update.c:83
#, c-format
msgid "There is %i update available"
msgid_plural "There are %i updates available"
msgstr[0] "Eguneraketa %i dago eskuragarri"
msgstr[1] "%i eguneraketa daude eskuragarri"

#: ../src/update.c:147
msgid "Show notifications"
msgstr "Jakinarazpenak erakutsi"

#. and update the tooltip
#: ../src/update.c:203
msgid "A package manager is working"
msgstr "Pakete-kudeatzailea dagoeneko abiarazita dago"

#: ../src/update.c:235
#, c-format
msgid ""
"There is %i update available. Click on the notification icon to show the "
"available update."
msgid_plural ""
"There are %i updates available. Click on the notification icon to show the "
"available updates."
msgstr[0] ""
"Eguneraketa %i dago eskuragarri. Klikatu jakinarazpen-ikonoan eguneraketa "
"eskuragarria ikusteko."
msgstr[1] ""
"%i eguneraketa daude eskuragarri. Klikatu jakinarazpen-ikonoan eguneraketa "
"eskuragarriak ikusteko."

#: ../src/update.c:246
msgid "Software updates available"
msgstr "Software eguneraketak daude eskuragarri"

#: ../src/update.c:284
msgid ""
"The update information is outdated. This may be caused by network problems "
"or by a repository that is no longer available. Please update manually by "
"selecting 'Show updates' from the indicator menu, and watching for any "
"failing repositories."
msgstr ""
"Eguneratze-informazioa zaharkitua dago. Hau sareko arazoen ondorioz gerta "
"daiteke, edo dagoeneko eskuragarri ez dagoen errepositorio batengatik. "
"Eguneratu eskuz adierazle-menuan 'Erakutsi eguneratzeak' hautatuz, eta "
"errepositorioren batek huts egin duen begiratuz."

#: ../src/update.c:594
#, c-format
msgid ""
"An error occurred, please run Package Manager from the right-click menu or "
"apt-get in a terminal to see what is wrong.\n"
"The error message was: '%s'. "
msgstr ""
"Errore bat gertatu da, arazoa zein den ikusteko, abiarazi pakete-"
"kudeatzailea saguaren eskumako botoiarekin klikatuz azaltzen den menutik, "
"edo terminal batean apt-get erabiliz.\n"
"Errore mezua: '%s'. "

#: ../src/update.c:601
msgid ""
"An error occurred, please run Package Manager from the right-click menu or "
"apt-get in a terminal to see what is wrong."
msgstr ""
"Errore bat gertatu da, arazoa zein den ikusteko, abiarazi pakete-"
"kudeatzailea saguaren eskumako botoiarekin klikatuz azaltzen den menutik, "
"edo terminal batean apt-get erabiliz."

#: ../src/update.c:605
msgid ""
"This usually means that your installed packages have unmet dependencies"
msgstr ""
"Honek normalean adierazi ohi du instalatutako paketeek bete gabeko "
"mendekotasunak dituztela."

#: ../src/update.c:618
msgid "A problem occurred when checking for the updates."
msgstr "Errore bat gertatu da eguneraketarik badagoen egiaztatzean."

#: ../src/update-notifier.c:609
msgid "- inform about updates"
msgstr "- eguneraketen berri eman"

#: ../src/update-notifier.c:611
#, c-format
msgid "Failed to init the UI: %s\n"
msgstr "Ezin izan da interfazea abiarazi: %s\n"

#: ../src/update-notifier.c:612
msgid "unknown error"
msgstr "errore ezezaguna"

#: ../src/update-notifier.c:639
msgid "update-notifier"
msgstr "eguneraketa-jakinarazlea"

#: ../ui/hooks-dialog.ui.h:1
