msgid "An update has just been applied."
msgstr "Eguneratze bat aplikatu berri da."

#: ../src/livepatch-tray.c:85
msgid "Livepatch Settings…"
msgstr "Livepatch ezarpenak…"

#: ../src/livepatch-tray.c:118
