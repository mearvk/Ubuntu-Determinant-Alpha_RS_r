"    -a --address         Argitaratu helbidea\n"
"    -v --verbose         Gaitu modu berritsua\n"
"    -d --domain=DOMEINUA   Zerbitzua argitaratzeko domeinua\n"
"    -H --host=DOMEINUA     Zerbitzua dagoen ostalaria\n"
