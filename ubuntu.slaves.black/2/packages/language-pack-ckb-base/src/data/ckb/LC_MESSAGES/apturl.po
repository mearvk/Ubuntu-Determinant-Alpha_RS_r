#: ../apturl-gtk:49 ../apturl-kde:52
msgid "User requested interrupt."
msgstr "بەکارهێنەر داوای وەستاندنی کرد."

#: ../AptUrl/Parser.py:85
msgid "Non whitelist char in the uri"
msgstr "لیستی سپی نوێ لە ناو uri"

#: ../AptUrl/Parser.py:93
msgid "Whitespace in key=value"
msgstr "بۆشای بەتاڵ لە کلیلدا = نرخ"

#: ../AptUrl/Parser.py:99
#, python-format
msgid "Exception '%s'"
msgstr "بەدەر  لە  '%s'."

#: ../AptUrl/Parser.py:109
#, python-format
msgid "Url string '%s' too long"
msgstr "ئەدرەسی  زنجیرەی  '%s' زۆر درێژە."

#: ../AptUrl/Parser.py:115
msgid "No ':' in the uri"
msgstr "هێمای ':' نیە لە ناو uri"

#: ../AptUrl/AptUrl.py:73
#, python-format
msgid "Enabling '%s' failed"
msgstr "چالاککردنی  '%s'   سەرکەوتو نەبوو"

#: ../AptUrl/AptUrl.py:91
#, python-format
msgid "Unknown channel '%s'"
msgstr "کەناڵی نەناسراو '%s'"

#: ../AptUrl/AptUrl.py:92
#, python-format
msgid "The channel '%s' is not known"
msgstr "کەناڵی  '%s'  ناسراو نیە"

#: ../AptUrl/AptUrl.py:100
#, python-format
msgid "Enabling channel '%s' failed"
msgstr "چالاککردنی کەناڵی '%s'  سەرکەوتو نەبوو"

#: ../AptUrl/AptUrl.py:112
msgid "Invalid /etc/apt/sources.list file"
msgstr "پەڕگەی  /etc/apt/sources.list نادروستە"

#: ../AptUrl/AptUrl.py:115
msgid "Software index is broken"
msgstr "نوانەی نەرمەکاڵا پچڕاوە"

#: ../AptUrl/AptUrl.py:116
msgid ""
"This is a major failure of your software management system. Please check for "
"broken packages with synaptic, check the file permissions and correctness of "
"the file '/etc/apt/sources.list' and reload the software information with: "
"'sudo apt-get update' and 'sudo apt-get install -f'."
msgstr ""
"ئەمە هەڵەیەکی باوی سیستەمی بەڕێوەبەری نەرمەواڵەیە. تکایە لە ڕێگەی (synaptic) "
"هەوڵ بدە گورزەکە بپشکنیت، بزانە ڕێ پێدراوی پەڕگەکان بکاربهێنی و پەڕگەی "
"'/etc/apt/sources.list'  دروستە و هەروەها هەوڵ بدە زانیاریی سیستەمەکە نار "
"بکەیتەوە بە فرمانی  'sudo apt-get update' و 'sudo apt-get install -f'."

#: ../AptUrl/AptUrl.py:144
msgid "Need a url to continue, exiting"
msgstr "پێویستت بە  ئەدرەسێک  هەیە بۆ بەردەوام بوون ، دەرچوون"

#: ../AptUrl/AptUrl.py:147
#, python-format
msgid "Invalid url: '%s' given, exiting"
msgstr "ئەدرەسێکی نادروست :  '%s' دراوە ، دەرچوون"

#: ../AptUrl/AptUrl.py:183
#, python-format
msgid "Can not deal with protocol '%s' "
msgstr "ناتوانرێ مامەڵە لەگەڵ پڕۆتۆکۆڵی  '%s' بکرێت "

#: ../AptUrl/AptUrl.py:205
#, python-format
msgid "Package '%s' is virtual."
msgstr "بوخچەی '%s'  گریمانەییە."

#: ../AptUrl/AptUrl.py:208
#, python-format
msgid "Could not find package '%s'."
msgstr "نەتوانرا گورزەی  '%s'  بدۆزرێتەوە."

#: ../AptUrl/AptUrl.py:214
#, python-format
msgid "Package '%s' is already installed"
msgstr "گورزەی '%s' پێشتر دامەزرێنراوە"

#: ../AptUrl/AptUrl.py:229
#, python-format
msgid "Can not install '%s' (%s) "
msgstr "ناتوانرێت %s' (%s) دابمەزرێنرێت "

#: ../AptUrl/AptUrl.py:235
#, python-format
msgid ""
"Package '%s' requests minimal version '%s', but only '%s' is available"
msgstr "گورزەی '%s' پێویستی بە وەشانی '%s' ، بەڵام تەنها '%s' بەردەستە"

#: ../AptUrl/UI.py:16
msgid "Enable additional components"
msgstr "چالاککردنی پێکهاتەی زیاتر"

#: ../AptUrl/UI.py:24 ../AptUrl/gtk/GtkUI.py:102 ../AptUrl/kde/KdeUI.py:80
msgid "Enable additional software channel"
msgstr "چالاککردنی کەناڵی نەرمەواڵەی زیاتر"

#: ../AptUrl/UI.py:25 ../AptUrl/gtk/GtkUI.py:103 ../AptUrl/kde/KdeUI.py:81
#, python-format
msgid "Do you want to enable the following software channel: '%s'?"
msgstr "ئایا دەتەوێت ئەم کەناڵی نەرمەواڵەیە چالاکبکرێت: '%s'؟"

#: ../AptUrl/gtk/GtkUI.py:156 ../AptUrl/kde/KdeUI.py:133
msgid "Install additional software?"
msgstr "ئایا دەتەوێت نەرمەواڵە دیادکراوەکان دابمەزرێنرێن؟"

#: ../AptUrl/gtk/GtkUI.py:157 ../AptUrl/kde/KdeUI.py:134
#, python-format
msgid "Do you want to install package '%s'?"
msgstr "ئایا دەتەوێ گورزەی  '%s' دابمەزرێنیت؟"

#. kate: space-indent on; indent-width 4; mixedindent off; indent-mode python;
#: ../data/apturl-gtk.ui.h:1
msgid "Description"
msgstr "كورتەیەک"

#: ../data/apturl-gtk.ui.h:2
msgid "_Install"
msgstr "_دامه‌زراندن"

#: ../data/apturl.schemas.in.h:1
msgid "Whether the specified command should handle \"apt\" URLs"
msgstr "چی کاتێک فرمانێکی دیاریکراو بەستەری  \"apt\"  بەردەستبخات"

#: ../data/apturl.schemas.in.h:2
msgid ""
"True if the command specified in the \"command\" key should handle \"apt\" "
"URLs."
msgstr ""
"ڕاستە، ئەگەر لە فرمانەکەی پێیدراوە لە \"command\" دا شوێندۆزی  \"apt\" "
"لەگەڵدا بێ"

#: ../data/apturl.schemas.in.h:3
msgid "The handler for \"apt\" URLs"
msgstr "بەدەستخەری بەستەرەکانی  \"apt\""

#: ../data/apturl.schemas.in.h:4
msgid "The command used to handle \"apt\" URLs, if enabled."
msgstr "فرمان بۆ بەدەستخستنی بەستەری  \"apt\"، ئەگەر جالاک کرابوو."

#: ../data/apturl.schemas.in.h:5
msgid "Run the command in a terminal"
msgstr "فرمان جێبەجێبکە لە تێرمیناڵ"

#: ../data/apturl.schemas.in.h:6
msgid ""
"True if the command used to handle this type of URL should be run in a "
"terminal."
msgstr ""
"True ئەگەر فرمان بەکارهێنرا بۆ بەدەستهێنانی بەستەری لەم جۆرە دەبێت "
"جێبەجێبکرێت لە تێرمیناڵ."
