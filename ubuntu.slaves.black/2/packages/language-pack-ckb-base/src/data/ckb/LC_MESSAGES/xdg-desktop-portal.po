#: src/background.c:260
#, c-format
msgid "Allow %s to run in the background?"
msgstr "ڕێگە دەدەی %s کاربکات لە پشتەوە؟"

#: src/background.c:264
#, c-format
msgid "%s requests to be started automatically and run in the background."
msgstr "%s داوادەکات خۆکارانە کاربکات لە پشتەوە بێت."

#: src/background.c:266
#, c-format
msgid "%s requests to run in the background."
msgstr "%s داوادەکات لە پشتەوە کاربکات."

#: src/background.c:267
msgid ""
"The ‘run in background’ permission can be changed at any time from the "
"application settings."
msgstr ""

#: src/background.c:272
msgid "Don't allow"
msgstr "ڕێگەی پێ مەدە"

#: src/background.c:273 src/wallpaper.c:165
msgid "Allow"
msgstr "ڕێدان"

#: src/device.c:115
msgid "Turn On Microphone?"
msgstr "مایکرۆفۆن کارا دەکەی؟"

#: src/device.c:116
msgid ""
"Access to your microphone can be changed at any time from the privacy "
"settings."
msgstr ""
"چوونەناوی مایکرۆفۆن دەتوانرێت بگۆڕدرێت لە بەشی ڕێکخستنەکانی تایبەتمەندی."

#: src/device.c:120
msgid "An application wants to use your microphone."
msgstr "نەرمەکاڵایەک دەیەوێت مایکرۆفۆن بەکاربێنێت."

#: src/device.c:122
#, c-format
msgid "%s wants to use your microphone."
msgstr "%s دەیەوێت مایکرۆفۆن بەکاربێنێت."

#: src/device.c:128
msgid "Turn On Speakers?"
msgstr "بڵندگۆ کارا دەکەی؟"

#: src/device.c:129
msgid ""
"Access to your speakers can be changed at any time from the privacy settings."
msgstr ""
"چوونەناوی بڵندگۆ دەتوانرێت بگۆڕدرێت لە بەشی ڕێکخستنەکانی تایبەتمەندی."

#: src/device.c:133
msgid "An application wants to play sound."
msgstr "داوانامەیەک دەیەوێت دەنگێک لێبدات."

#: src/device.c:135
#, c-format
msgid "%s wants to play sound."
msgstr "%s دەیەوێت دەنگێک لێبدات."

#: src/device.c:141
msgid "Turn On Camera?"
msgstr "کامێرا کارا دەکەیتەوە؟"

#: src/device.c:142
msgid ""
"Access to your camera can be changed at any time from the privacy settings."
msgstr ""
"چوونەناوی کامێرا دەتوانرێت بگۆڕدرێت لە بەشی  ڕێکخستنەکانی تایبەتمەندی."

#: src/device.c:146
msgid "An application wants to use your camera."
msgstr "نەرمەکاڵایەک دەیەوێت کامێرا بەکاربێنێت."

#: src/device.c:148
#, c-format
msgid "%s wants to use your camera."
msgstr "%s  دەیەوێت کامێرا بەکاربێنێت."

#: src/location.c:526
msgid "Deny Access"
msgstr "چوونەناو رەتبکەرەوە"

#: src/location.c:528
msgid "Grant Access"
msgstr "چوونەناو بەدەستبهێنە"

#: src/location.c:534
msgid "Grant Access to Your Location?"
msgstr "بەدەستهێنانی چوونەناو بۆ شوێنەکەت ڕێگە دەدەی؟"

#: src/location.c:535
msgid "An application wants to use your location."
msgstr "نەرمەکاڵایەک دەیەوێت شوێنەکەت بەکاربێنێ."

#: src/location.c:547
#, c-format
msgid "Give %s Access to Your Location?"
msgstr "دەسەڵات دەدەی بە %s بۆ ئەوەی شوێنەکەت بەکاربێنێت؟"

#: src/location.c:551
#, c-format
msgid "%s wants to use your location."
msgstr "%s دەیوێت شوێنەکەت بەکاربێنێت."

#: src/location.c:554
msgid "Location access can be changed at any time from the privacy settings."
msgstr "چوونەناوی شوێن دەتوانرێت بگۆڕدرێت لە بەشی ڕێکخستنەکانی تایبەتمەندی."

#: src/settings.c:124
msgid "Requested setting not found"
msgstr "ڕێکخستنی داواکراو نە دۆزرایەوە"

#: src/wallpaper.c:163
msgid "Deny"
msgstr "رەتیبکەرەوە"

#: src/wallpaper.c:171
msgid "Allow Applications to Set Backgrounds?"
msgstr "ڕێگە دەدەی داوانامە پاشبنەما دابنێ؟"

#: src/wallpaper.c:172
msgid ""
"An application is requesting to be able to change the background image."
msgstr ""
"داوانامەیەک داوادەکات بۆ ئەوەی بتوانێت گۆڕانکاری لە وێنەی پاشبنەما بکات."

#: src/wallpaper.c:184
#, c-format
msgid "Allow %s to Set Backgrounds?"
msgstr "ڕێگە دەدەی %s پاشبنەما دابنێ؟"

#: src/wallpaper.c:185
#, c-format
msgid "%s is requesting to be able to change the background image."
msgstr "%s  داوادەکات بۆ ئەوەی بتوانێت گۆڕانکاری لە وێنەی پاشبنەما بکات."

#: src/wallpaper.c:188
msgid "This permission can be changed at any time from the privacy settings."
msgstr ""
"ڕێپێدانەکانی دەتوانرێت هەرکاتێک بتەوێ بیگۆڕی لەبەشی ڕێکخستنەکانی تایبەتمەندی."
