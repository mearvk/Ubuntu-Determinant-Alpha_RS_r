#. Description
#: ../data/templates/Debian.info.in:25
msgid "Debian {version} '{codename}'"
msgstr "Debian {version} „{codename}“"

#. Description
#: ../data/templates/Debian.info.in:47
msgid "Security updates"
msgstr "Aktualizace zabezpečení"

#. Description
#: ../data/templates/Debian.info.in:59
msgid "Proposed updates"
msgstr "Navržené aktualizace"

#. Description
#: ../data/templates/Debian.info.in:66
msgid "Debian current stable release"
msgstr "Současná stabilní verze Debianu"

#. Description
#: ../data/templates/Debian.info.in:81
msgid "Debian testing"
msgstr "Debian testing"

#. Description
#: ../data/templates/Debian.info.in:111
msgid "Debian 'Sid' (unstable)"
msgstr "Debian 'Sid' (unstable)"

#. CompDescription
#: ../data/templates/Debian.info.in:115
msgid "DFSG-compatible Software with Non-Free Dependencies"
msgstr ""
"Software kompatibilní s DFSG, ale závisející na nesvobodných balících"

#. CompDescription
#: ../data/templates/Debian.info.in:119
msgid "Non-DFSG-compatible Software"
msgstr "Software nekompatibilní s DFSG"

#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Server pro zemi \"%s\""

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Hlavní server"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Uživatelem vybrané servery"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Chybějící popis pro '%s'.Prosím, nahlaste."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Neplatný unicode v popisu pro '% s' (%s). Prosím zašlete oznámení."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Seznam změn není dostupný."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Seznam změn není ještě dostupný.\n"
"\n"
"Prosím použijte http://launchpad.net/ubuntu/+source/%s/%s/+changelog,\n"
"dokud nebudou změny dostupné, nebo to zkuste znovu později."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Stažení seznamu změn selhalo. \n"
"Prosím zkontrolujte své internetové připojení."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Seznam souborů pro '%s' nelze přečíst"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Seznam kontrolních souborů pro '%s' nemohl být úřečten"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Závislost nemůže být splněna: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Je v konfliktu s nainstalovaným balíkem \"%s\""

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Poškodí stávající balík '%(pkgname)s' závislost %(depname)s (%(deprelation)s "
"%(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Poškodí stávající balík '%(pkgname)s' je v konfliktu: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Poškodí stávající balík '%(pkgname)s', který je v konfliktu: "
"'%(targetpkg)s'. '%(debfile)s' jej poskytuje pomocí: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "V balíku není položka Architektura"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Nesprávná architektura '%s' -- Pro její přidání spusťte dpkg --add-"
"architecture a poté proveďte aktualizaci"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Novější verze je již nainstalována"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Není možné splnit všechny závislosti (porušená vyrovnávací paměť)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Nelze nainstalovat \"%s\""

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Automaticky rozbaleno:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Automaticky převedeno na tisknutelné ASCII:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Nainstalovat závislosti potřebné pro překlad zdrojového balíku '%s', který "
"přeloží %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Stěžejní balík by byl odstraněn"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s… Hotovo"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Cíl "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Získáno:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Pracuje se]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Výměna média: Vložte disk nazvaný\n"
" „%s“\n"
"do mechaniky „%s“ a stiskněte Enter\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Staženo %s B za %s (%s B/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr "Zadejte název pro toto médium, jako například „Debian 2.1r1 Disk 1“"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Vložte instalační médium a stiskněte klávesu Enter"
