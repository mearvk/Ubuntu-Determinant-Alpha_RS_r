#: apt-inst/contrib/arfile.cc:75
msgid "Invalid archive signature"
msgstr "Neplatný podpis archivu"

#: apt-inst/contrib/arfile.cc:83
msgid "Error reading archive member header"
msgstr "Chyba při čtení záhlaví prvku archívu"

#: apt-inst/contrib/arfile.cc:95
#, c-format
msgid "Invalid archive member header %s"
msgstr "Neplatné záhlaví prvku archivu %s"

#: apt-inst/contrib/arfile.cc:107
msgid "Invalid archive member header"
msgstr "Neplatné záhlaví prvku archívu"

#: apt-inst/contrib/arfile.cc:136
msgid "Archive is too short"
msgstr "Archiv je příliš krátký"

#: apt-inst/contrib/arfile.cc:140
msgid "Failed to read the archive headers"
msgstr "Chyba při čtení hlaviček archívu"

#: apt-inst/contrib/extracttar.cc:109
#, c-format
msgid "Cannot find a configured compressor for '%s'"
msgstr "Nelze najít zadaný komprimační program „%s“"

#: apt-inst/contrib/extracttar.cc:141 apt-inst/contrib/extracttar.cc:171
msgid "Corrupted archive"
msgstr "Porušený archív"

#: apt-inst/contrib/extracttar.cc:156
msgid "Tar checksum failed, archive corrupted"
msgstr "Kontrolní součet taru selhal, archiv je poškozený"

#: apt-inst/contrib/extracttar.cc:261
#, c-format
msgid "Unknown TAR header type %u, member %s"
msgstr "Neznámá hlavička TARu typ %u, člen %s"

#: apt-inst/deb/debfile.cc:46 apt-inst/deb/debfile.cc:55
#: apt-inst/deb/debfile.cc:66
#, c-format
msgid "This is not a valid DEB archive, missing '%s' member"
msgstr "Toto není platný DEB archiv, chybí část „%s“"

#: apt-inst/deb/debfile.cc:135
#, c-format
msgid "Internal error, could not locate member %s"
msgstr "Vnitřní chyba, nelze najít část %s"

#: apt-inst/deb/debfile.cc:230
msgid "Unparsable control file"
msgstr "Nezpracovatelný kontrolní soubor"

#: apt-inst/dirstream.cc:41 apt-inst/dirstream.cc:48 apt-inst/dirstream.cc:53
#, c-format
msgid "Failed to write file %s"
msgstr "Selhal zápis souboru %s"

#: apt-inst/dirstream.cc:103
#, c-format
msgid "Failed to close file %s"
msgstr "Selhalo zavření souboru %s"

#: apt-inst/extract.cc:99 apt-inst/extract.cc:170
#, c-format
msgid "The path %s is too long"
msgstr "Cesta %s je příliš dlouhá"

#: apt-inst/extract.cc:130
#, c-format
msgid "Unpacking %s more than once"
msgstr "%s se rozbaluje vícekrát"

#: apt-inst/extract.cc:140
#, c-format
msgid "The directory %s is diverted"
msgstr "Adresář %s je odkloněn"

#: apt-inst/extract.cc:150
#, c-format
msgid "The package is trying to write to the diversion target %s/%s"
msgstr "Balík se pokouší zapisovat do diverzního cíle %s/%s"

#: apt-inst/extract.cc:160 apt-inst/extract.cc:304
msgid "The diversion path is too long"
msgstr "Diverzní cesta je příliš dlouhá"

#: apt-inst/extract.cc:184 apt-inst/extract.cc:197 apt-inst/extract.cc:214
#, c-format
msgid "Failed to stat %s"
msgstr "Nelze vyhodnotit %s"

#: apt-inst/extract.cc:192
#, c-format
msgid "Failed to rename %s to %s"
msgstr "Selhalo přejmenování %s na %s"

#: apt-inst/extract.cc:247
#, c-format
msgid "The directory %s is being replaced by a non-directory"
msgstr "Adresář %s bude nahrazen neadresářem"

#: apt-inst/extract.cc:287
msgid "Failed to locate node in its hash bucket"
msgstr "Nelze nalézt uzel v jeho hashovacím kbelíku"

#: apt-inst/extract.cc:291
msgid "The path is too long"
msgstr "Cesta je příliš dlouhá"

#: apt-inst/extract.cc:419
#, c-format
msgid "Overwrite package match with no version for %s"
msgstr "Přepsat vyhovující balík bez udání verze pro %s"

#: apt-inst/extract.cc:436
#, c-format
msgid "File %s/%s overwrites the one in the package %s"
msgstr "Soubor %s/%s přepisuje ten z balíku %s"

#: apt-inst/extract.cc:469
#, c-format
msgid "Unable to read %s"
msgstr "Nelze číst %s"

#: apt-inst/extract.cc:496
#, c-format
msgid "Unable to stat %s"
msgstr "Nelze vyhodnotit %s"

#: apt-inst/filelist.cc:379
msgid "DropNode called on still linked node"
msgstr "Pokus o uvolnění uzlu (DropNode) na stále propojeném uzlu"

#: apt-inst/filelist.cc:411
msgid "Failed to locate the hash element!"
msgstr "Nelze lokalizovat hashovací prvek!"

#: apt-inst/filelist.cc:458
msgid "Failed to allocate diversion"
msgstr "Nelze alokovat diverzi"

#: apt-inst/filelist.cc:463
msgid "Internal error in AddDiversion"
msgstr "Vnitřní chyba při AddDiversion"

#: apt-inst/filelist.cc:476
#, c-format
msgid "Trying to overwrite a diversion, %s -> %s and %s/%s"
msgstr "Pokus o přepsání diverze, %s -> %s a %s/%s"

#: apt-inst/filelist.cc:505
#, c-format
msgid "Double add of diversion %s -> %s"
msgstr "Dvojí přidání diverze %s -> %s"

#: apt-inst/filelist.cc:548
#, c-format
msgid "Duplicate conf file %s/%s"
msgstr "Duplicitní konfigurační soubor %s/%s"
