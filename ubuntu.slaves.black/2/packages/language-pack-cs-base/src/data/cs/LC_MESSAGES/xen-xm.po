#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Vnitřní chyba: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Toto mapování již obsahuje %(1)s -> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Metoda %(1)s není podporována."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Metoda %(1)s přebírá %(2)s argument(y) (%(3)s předány)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Přístup odepřen."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Hodnota \"%(2)s\" pro %(1)s není tímto serverem podporována.  Server "
"odpověděl \"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr ""

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Pokoušíte se o nepovolenou operaci."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Vámi specifikovaná síť již má přiřazen PIF a proto žádný další nemůže být "
"přiřazen."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
