#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "Přepiš klíč na malá písmena"

#: src/makedb.c:69
msgid "NAME"
msgstr "NÁZEV"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "Zapiš výstup do souboru NÁZEV"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "Nevypisuj zprávy při tvoření databáze"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr "Vypiš obsah databázového soubory, jednu položku na řádek"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "Vytvoř jednoduchou DB databázi z textového vstupu."

#. Strings for arguments in help texts.
#: src/makedb.c:81
msgid ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"
msgstr ""
"VSTUPNÍ-SOUBOR VÝSTUPNÍ-SOUBOR\n"
"-o VÝSTUPNÍ-SOUBOR VSTUPNÍ-SOUBOR\n"
"-u VSTUPNÍ-SOUBOR"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "špatný počet parametrů"

#: src/makedb.c:154
#, c-format
msgid "cannot open database file `%s': %s"
msgstr "nelze otevřít databázový soubor \"%s\": %s"

#: src/makedb.c:173
#, c-format
msgid "cannot open input file `%s'"
msgstr "nelze otevřít vstupní soubor \"%s\""

#: src/makedb.c:187
#, c-format
msgid "cannot open output file `%s': %s"
msgstr "nelze otevřít výstupní soubor \"%s\": %s"

#. We print some extra information.
#: src/makedb.c:235
msgid "Report bugs using the `glibcbug' script to <bugs@gnu.org>.\n"
msgstr "Nahlašte chyby pomocí \"glibcbug\" skriptu na <bugs@gnu.org>\n"

