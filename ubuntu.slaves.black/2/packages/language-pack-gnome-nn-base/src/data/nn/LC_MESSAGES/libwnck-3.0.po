msgstr "Endra X-koordinaten for vindauget til X"

#
#: libwnck/wnckprop.c:275
msgid "Change the Y coordinate of the window to Y"
msgstr "Endra Y-koordinaten for vindauget til Y"

#
#: libwnck/wnckprop.c:277
