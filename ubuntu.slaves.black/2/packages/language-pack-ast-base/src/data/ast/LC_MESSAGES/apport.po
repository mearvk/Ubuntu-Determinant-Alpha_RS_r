msgstr ""
"Instaleste dos versiones d'esta aplicación. ¿De cuála ye l'informe del fallu "
"que vas crear?"

#: ../apport/ui.py:1594
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:1594
#, python-format
msgid "%s snap"
msgstr "«Snap» de %s"

#: ../apport/ui.py:1595
