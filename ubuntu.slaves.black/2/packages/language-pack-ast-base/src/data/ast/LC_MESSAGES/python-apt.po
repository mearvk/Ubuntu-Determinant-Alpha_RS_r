#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Sirvidores pa %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Sirvidor principal"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Sirvidores personalizaos"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Descripción ausente pa «%s». Unvíanos un informe de fallu."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Unicode incorreutu na descripción de «%s» (%s). Por favor, informe."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "La llista de cambeos nun ta disponible."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"La llista de cambeos nun ta disponible entá.\n"
"\n"
"Por favor, use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"hasta que los cambeos tean disponibles, o téntelo más sero."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Hebo un fallu al descargar la llista de cambeos. \n"
"Comprebe la so conexón a Internet."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Nun puede lleese la llista de ficheros pa '%s'"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "La llista de ficheros de control pa «%s» nun pue lleese"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "La dependencia nun puede cubrise: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Conflictos col paquete instaláu '%s'"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Frañe paquete esistente '%(pkgname)s' dependencia %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Frañe un conflictu del paquete esistente '%(pkgname)s': %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Frañe'l paquete esistente «%(pkgname)s» que tien conflictu con: "
"«%(targetpkg)s». Pero «%(debfile)s» proporciónalu vía: «%(provides)s»'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Nun hai campu d'Arquiteutura nel paquete"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Arquitectura «%s» enquivocada -- Executa dpkg --add-architecture p'amestala "
"y anueva darréu"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Yá ta instalada una versión postrera"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Hebo un fallu al tentar satisfacer toles dependencies (caché toyíu)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Nun puede instalase '%s'"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Descomprimíu automáticamente:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Convertíu automáticamente nun ASCII imprentable:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Instala dependencies de compilación pal paquete fonte «%s» que compila %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Desinstalaríase un paquete esencial"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Fecho"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Oxe "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Inor "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Des:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Trabayando]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Cambéu de mediu: Por favor meti'l discu etiquetáu\n"
" '%s'\n"
"na unidá '%s' y calca Intro\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Descargaos %sB en %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr "Apurri un nome pa esti mediu, como «Debian 2.1r1 Disk 1»"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Inxer un mediu d'instalación y calca intro"
