#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "Colar dempués d'un retrasu pequeñu"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "Salir llueu de que tea cargáu'l motor"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr "Cambia l'antiguu demoniu"

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "Amosar información estra de depuración"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "Numberar caminos d'oxetos pa preseos"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "Volquiar tolos parametros pa tolos oxetos"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "Obtener los datos de reanudación"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "Monitorizar l'actividá del degorriu d'enerxía"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "Monitorizar con detalle"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "Amosar información tocante al camín del oxetu"
