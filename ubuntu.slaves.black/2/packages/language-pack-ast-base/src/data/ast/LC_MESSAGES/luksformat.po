#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Esti programa tien de ser aniciáu como root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Crea  y formatea un dispositivu LUKS cifráu\n"
"Usu: luksformat [-t <sistema de ficheros] <preséu> [ opciones mkfs ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Fallu: dispositivu desmontáu: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Fallu: sistema de ficheros non válidu: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Fallu: nun pudo xenerase'l nome del preséu asignáu temporal"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Creando preséu cifráu en %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Nun pue crease'l preséu LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Por favor, escribe la to contraseña otra vuelta pa validala\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Les contraseñes qu'escribiste nun son idéntiques\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Nun pue formatease'l preséu col sistema de ficheros %s"
