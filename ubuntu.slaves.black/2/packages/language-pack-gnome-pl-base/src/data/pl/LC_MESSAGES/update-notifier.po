msgid "Show Settings…"
msgstr "Pokaż ustawienia"

#: ../src/livepatch.c:135
msgid "An update has just been applied."
msgstr "Aktualizacja właśnie została zastosowana."

#: ../src/livepatch-tray.c:85
msgid "Livepatch Settings…"
msgstr "Ustawienia Livepatch…"

#: ../src/livepatch-tray.c:118
msgid "Livepatch is on"
msgstr "Funkcja Livepatch jest włączona"

#: ../src/livepatch-tray.c:146
msgid "No current updates"
msgstr "Brak bieżących aktualizacji"

#: ../src/livepatch-tray.c:148
#, c-format
msgid "%zd current update"
msgid_plural "%zd current updates"
msgstr[0] "%zd bieżąca aktualizacja"
msgstr[1] "%zd bieżące aktualizacje"
msgstr[2] "%zd bieżących aktualizacji"

#: ../src/livepatch-tray.c:168
msgid "An error occured when checking for Livepatch updates."
msgstr "Wystąpił błąd podczas wyszukiwania aktualizacji Livepatch."

#: ../src/livepatch-tray.c:173
msgid "An error occured when applying Livepatch updates."
msgstr "Wystąpił błąd podczas stosowania aktualizacji Livepatch."

