msgstr "སྔོན་བལྟའི་ཚད་ འབད་བཤོལ་སྔོན་རབས་ནང་ལུ་ གཞི་སྒྲིག་འབདཝ་ཨིན།"

#: ../app/config/gimprc-blurbs.h:720
msgid "When enabled, pressing F1 will open the help browser."
msgstr ""
