#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr ""
"འགྲུལ་ལམ་གཡི་དོན་ལུ་རུབ་སྤྱོད་འབད་ནི་འདི་རྩ་བསྐྲད་གཏང་མི་ཚུགས %s: "
"འགྲུལ་ལམ་དེ་རུབ་སྤྱོད་འབད་མེདཔ།"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"གནས་ཡོད་པའི་རུབ་སྤྱོད་འབད་ནི་གི་འགྲུལ་ལམ་འདི་བསྒྱུརལ་བཅོས་འབད་མི་ཚུགས་ "
"རུབ་སྤྱོད་འབད་ནི་རྙིངམ་འདི་རྩ་བསྐྲད་གཏང་ནི་དང་གསརཔ་ཅིག་ཁ་སྐོང་འབད་གནང་།"

