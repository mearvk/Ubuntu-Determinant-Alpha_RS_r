#, c-format
msgid "The repository '%s' provides only weak security information."
msgstr "Το αποθετήριο '%s' παρέχει μόνο ισχνές πληροφορίες ασφαλείας."

#: apt-pkg/acquire-item.cc:589
#, c-format
msgid "Failed to readlink %s"
msgstr "Αποτυχία ανάγνωσης του %s"

#: apt-pkg/acquire-item.cc:598
#, c-format
msgid "Failed to stat %s"
msgstr "Αποτυχία εύρεσης της κατάστασης του %s"

#: apt-pkg/acquire-item.cc:941 apt-pkg/acquire-item.cc:1081
msgid "Hash Sum mismatch"
msgstr "Ανόμοιο MD5Sum"

#: apt-pkg/acquire-item.cc:944
msgid "Insufficient information available to perform this download securely"
msgstr ""

#: apt-pkg/acquire-item.cc:1056 apt-pkg/contrib/fileutl.cc:3199
#, c-format
msgid "rename failed, %s (%s -> %s)."
msgstr "απέτυχε η μετονομασία, %s (%s -> %s)."

#: apt-pkg/acquire-item.cc:1084
msgid "Size mismatch"
msgstr "Ανόμοιο μέγεθος"

#: apt-pkg/acquire-item.cc:1088
msgid "Invalid file format"
msgstr "Άκυρη μορφή αρχείου"

#: apt-pkg/acquire-item.cc:1093
msgid "Signature error"
msgstr "Σφάλμα υπογραφής"

#: apt-pkg/acquire-item.cc:1097
#, c-format
msgid ""
"Clearsigned file isn't valid, got '%s' (does the network require "
"authentication?)"
msgstr ""

#: apt-pkg/acquire-item.cc:1346
#, c-format
msgid ""
"An error occurred during the signature verification. The repository is not "
"updated and the previous index files will be used. GPG error: %s: %s"
msgstr ""

