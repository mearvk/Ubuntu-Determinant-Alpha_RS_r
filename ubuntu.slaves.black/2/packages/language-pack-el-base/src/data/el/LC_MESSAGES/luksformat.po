#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Αυτό το πρόγραμμα χρειάζεται να εκκινηθεί σαν root.\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Δημιουργία και διαμόρφωση μιας κρυπτογραφημένης συσκευής LUKS\n"
"Χρήση: luksformat [-t <σύστημα αρχείων>] <συσκευή> [ επιλογές mkfs ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Σφάλμα: προσαρτημένη συσκευή: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Σφάλμα: μη έγκυρο σύστημα αρχείων: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr ""
"Σφάλμα: δεν μπορεί να δημιουργηθεί προσωρινά αντιστοιχισμένο όνομα συσκευής"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Δημιουργία κρυπτογραφημένης συσκευής στο %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Δεν ήταν δυνατή η δημιουργία της συσκευής LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Εισάγετε το συνθηματικό σας ξανά για να τo επαληθεύσετε\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Οι συνθηματικές φράσεις που εισάγατε δεν ήταν όμοιες\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Δεν ήταν δυνατή η μορφοποίηση της συσκευής με το σύστημα αρχείων %s"
