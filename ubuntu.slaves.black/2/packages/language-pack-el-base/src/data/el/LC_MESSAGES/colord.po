msgstr "Οθόνη Υγρών Κρυστάλλων (LCD)"

#. TRANSLATORS: if the sensor supports calibrating a CRT display
#: ../client/cd-util.c:420
msgid "CRT"
msgstr "CRT"

#. TRANSLATORS: if the sensor supports calibrating a printer
#: ../client/cd-util.c:424
msgid "Printer"
