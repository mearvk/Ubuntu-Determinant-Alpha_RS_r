#: ../client/cd-util.c:86
msgid "%B %e %Y, %I:%M:%S %p"
msgstr "%B %e %Y, %I:%M:%S %p"

#. TRANSLATORS: profile owner
#: ../client/cd-util.c:101
msgid "Owner"
msgstr "Ιδιοκτήτης"

