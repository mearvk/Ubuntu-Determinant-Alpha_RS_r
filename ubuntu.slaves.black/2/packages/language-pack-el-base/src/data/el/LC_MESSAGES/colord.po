#: ../client/cd-util.c:164
msgid "Filename"
msgstr "Όνομα αρχείου"

#. TRANSLATORS: profile identifier
#: ../client/cd-util.c:168
msgid "Profile ID"
msgstr "Αναγνωστικό προφίλ"

