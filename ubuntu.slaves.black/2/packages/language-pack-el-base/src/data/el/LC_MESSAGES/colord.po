msgstr "Αναφορά"

#. TRANSLATORS: sensor serial
#: ../client/cd-util.c:369
msgid "Serial number"
msgstr "Σειριακός αριθμός"

#. TRANSLATORS: the options for the sensor
#: ../client/cd-util.c:403
msgid "Options"
msgstr "Επιλογές"

#. TRANSLATORS: if the sensor has a colord native driver
#: ../client/cd-util.c:408
