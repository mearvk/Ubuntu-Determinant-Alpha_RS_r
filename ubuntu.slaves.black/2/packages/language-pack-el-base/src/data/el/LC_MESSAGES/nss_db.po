#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "Μετατροπή κλειδιού σε πεζά γράμματα"

#: src/makedb.c:69
msgid "NAME"
msgstr "Όνομα"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "Εγγραφή εξόδου στο αρχείο ΟΝΟΜΑ"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "Απόκρυψη μηνυμάτων κατά την δημιουργία βάσης δεδομένων"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr ""
"Προβολή του περιεχομένου του αρχείου βάσης δεδομένων, μία καταχώρηση ανά "
"γραμμή"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "Δημιουργία απλής βάσης DB από εισαγωγή κειμένου."

