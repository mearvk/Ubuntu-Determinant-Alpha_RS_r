#: src/utils/pax11publish.c:58
#, c-format
msgid ""
"%s [-D display] [-S server] [-O sink] [-I source] [-c file]  [-d|-e|-i|-r]\n"
"\n"
" -d    Show current PulseAudio data attached to X11 display (default)\n"
" -e    Export local PulseAudio data to X11 display\n"
" -i    Import PulseAudio data from X11 display to local environment "
"variables and cookie file.\n"
" -r    Remove PulseAudio data from X11 display\n"
msgstr ""
"%s [-D display] [-S server] [-O sink] [-I source] [-c file]  [-d|-e|-i|-r]\n"
"\n"
" -d    X11 كۆرسەتكۈچىگە قېتىلغان نۆۋەتتىكى PulseAudio نىڭ سانلىق-"
"مەلۇماتلىرىنى كۆرسىتىدۇ (كۆڭۈلدىكى)\n"
" -e    X11 كۆرسەتكۈچىگە يەرلىك PulseAudio نىڭ سانلىق-مەلۇماتلىرىنى ئېكسپورت "
"قىلىدۇ\n"
" -i    X11 كۆرسەتكۈچىدىن PulseAudio سانلىق-مەلۇماتلىرىنى ئىمپورت قىلىپ ئۇنى "
"يەرلىك مۇھىت ئۆزگەرگۈچى قىممىتى ۋە  cookie ھۆججىتى قىلىپ ئىشلىتىدۇ  \n"
" -r    X11 كۆرسەتكۈچىدىن PulseAudio سانلىق-مەلۇماتلىرىنى ئۆچۈرىدۇ\n"

