msgid "Byobu will be launched automatically next time you login."
msgstr "كىيىنكى قېتىم كىرگەندەByobu ئاپتوماتىك قوزغىلىدۇ."

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "كىيىنكى قېتىم كىرگەندە Byobu قوزغالمايدۇ"

#: byobu-config:408
msgid "Message"
msgstr "ئۇچۇر"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "چېكىنىش كونۇپكىسى: ctrl-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "قېچىش تەرتىپىنى ئۆزگەرتىش:"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr "<Tab>/<Alt-Tab>ئېلېمېنت ئارىسىدا | <Enter> تاللاش<Esc> چېكىنىش"
