#: bin/menu:34 byobu-config:129 byobu-config:401 byobu-config:409
msgid "Menu"
msgstr "تىزىملىك"

#: byobu-export:68 byobu-export:71 byobu-select-profile:104
#: byobu-select-profile:107
msgid "Choose"
msgstr "تاللا"

#: byobu-export:171
msgid "File exists"
msgstr "ھۆججەت مەۋجۇت"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "ھۆججەت چىقىرىۋەت؟[y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "رەڭ تاللاش: "

#: byobu-export:240
msgid "Profile"
msgstr "سەپلىمە ھۆججەت"

#: byobu-export:241
msgid "Archive"
msgstr "ئارخىپلاش"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr ""
"ئارخىپنىhome مۇندەرىجىدىن  نىشان سىستېمىغا ئاجرات\r\n"
"\r\n"
"提取目标系统上的档案在你的home目录。"

#: byobu-select-profile:49
msgid "Error:"
msgstr "خاتالىق:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " ھۆججەت مەۋجۇت،بىراق ئۇ بەلگە ئۇلانمىسى ئەمەس"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "ئىكران رۇيخەت(profile)تاللا "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "خاتالىق:ئىناۋەتسىز تاللاش"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"كۆڭۈلدىكى بىرلەشمە كونۇپكىنى ئىشلىتىۋاتقان بولسىڭىز،\\n<F5>نى بېسىپ كۈچكە "
"ئىگە قىلىڭ،\\n\\nبولمىسا، بۇ سۆزلىشىش ئىكرانىدىن چېكىنىپ، يېڭىدىن بىرنى "
"قوزغىتىڭ"

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "\"byobu\" نى ئىجرا قىلىپ ئاكتىپلاڭ"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr ""
"Byobu نۆۋەتتە تىزىمغا كىرگەندە ئۆزلۈكىدىن قوزغىلىدۇ(تاقاشقا ئالمىشىدۇ)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr ""
"Byobu نۆۋەتتە تىزىمغا كىرگەندە ئۆزلۈكىدىن قوزغالمايدۇ(تاقاشقا ئالمىشىدۇ)"

