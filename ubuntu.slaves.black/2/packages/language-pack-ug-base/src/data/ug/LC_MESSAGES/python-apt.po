msgstr "Get:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [ئىشلەۋاتىدۇ]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"دىسكا ئالماشتۇرۇش: ئەن سېلىنغان دىسكىنى سېلىڭ\n"
" '%s'\n"
"قوزغاتقۇچ '%s' نىڭ سېلىپ قايتۇرۇش كۇنۇپكىسىنى بېسىڭ\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "ئوقۇدى: %sB / %s (%sB/s)\n"

