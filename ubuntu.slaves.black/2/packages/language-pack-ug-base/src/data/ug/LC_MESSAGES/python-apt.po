#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "%s نىڭ مۇلازىمېتىرى"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "باش مۇلازىمېتىر"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Custom مۇلازىمېتىرلار"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr ""

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "'%s' (%s) نىڭ چۈشەندۈرۈشىدىكى unicode خاتا. مەلۇم قىلىڭ."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "ئۆزگىرىشلەرنىڭ تىزىملىكىنى ئىشلەتكىلى بولمايدۇ"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"ئۆزگىرىشلەرنىڭ تىزىملىكىنى تېخى ئىشلەتكىلى بولمايدۇ.\n"
"\n"
"http://launchpad.net/ubuntu/+source/%s/%s/+changelog نىڭغا بېرىڭ\n"
"ئۆزگىرىشلەرنىڭ تىزىملىكى تەييار بولغۇچە ساقلاڭ ياكى كېيىن يەنە سىناپ كۆرۈڭ."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"ئۆزگىرىشلەرنىڭ تىزىملىكىنى چۈشۈرۈش مەغلۇپ بولدى. \n"
"ئىنتېرنېت باغلىنىشىنى تەكشۈرۈڭ."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "ھۆججەت تىزىملىكى '%s' نى  ئوقۇيالمىدى."

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "'%s' نىڭ كونترول ھۆججەت تىزىملىكىنى ئوقۇيالمىدى"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Dependency يېتەرلىك ئەمەس: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "ئورنىتىلىپ بولۇنغان بولاق '%s' نىڭ بىلەن توقۇنۇشۇپ قالدى"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"مەۋجۇت '%(pkgname)s' بوغچىسىنىڭ بېقىندىلىرى %(depname)s (%(deprelation)s "
"%(depversion)s) بىلەن بولغان باغلىنىشلىرى ئۈزۈلىدۇ"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"مەۋجۇت '%(pkgname)s' بوغچىنىڭ توقۇنۇشىنى ئۈزىدۇ: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"مەۋجۇت '%(pkgname)s' بوغچىنىڭ %(targetpkg)s' بىلەن بولغان توقۇنۇشىنى ئۈزىدۇ. "
"بىراق بۇ  '%(debfile)s' ھۆججىتى '%(provides)s' تەرىپىدىن تەمىنلەنگەن"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "بولاقتا Architecture field يوق ئىكەن"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr "قۇرۇلما ‹%s› خاتا -- بۇيرۇققا --add-architecture نى قوشۇپ  يېڭىلاڭ"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "يېڭى نەشرى ئاللىقاچان ئورنىتىلغان ئىكەن."

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "dependencies نى قاندۇرۇش مەغلۇپ بولدى (بۇزۇلغان غەملەك)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "'%s' نى ئورناتقىلى بولمىدى"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"ئاپتوماتىك يېيىلدى:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "printable ascii غا ئاپتوماتىك ئايلاندۇرۇلدى:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr "Install Build-Dependencies for source package '%s' that builds %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "مۇھىم بولغان بولاق ئۆچۈرۈلمەكچى"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... تامام"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Hit "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
