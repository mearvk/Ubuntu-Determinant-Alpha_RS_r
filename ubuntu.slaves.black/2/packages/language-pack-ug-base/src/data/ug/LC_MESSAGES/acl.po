msgstr "\t%s -b acl dacl يول ئاتى…\n"

#: tools/chacl.c:49
#, c-format
msgid "\t%s -d dacl pathname...\n"
msgstr "\t%s -d dacl يول ئاتى…\n"

#: tools/chacl.c:50
#, c-format
msgid "\t%s -R pathname...\n"
msgstr "\t%s -R يول ئاتى…\n"

#: tools/chacl.c:51
#, c-format
