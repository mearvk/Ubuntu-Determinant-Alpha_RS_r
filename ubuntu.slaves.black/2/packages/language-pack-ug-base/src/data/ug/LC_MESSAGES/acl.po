#: tools/chacl.c:146
#, c-format
msgid "%s: error removing access acl on \"%s\": %s\n"
msgstr "%s: «%s» نىڭدىكى زىيارەت acl نى چىقىرىۋېتىشتە خاتالىق كۆرۈلدى:%s\n"

#: tools/chacl.c:153
#, c-format
msgid "%s: error removing default acl on \"%s\": %s\n"
msgstr "%s: «%s» نىڭدىكى كۆڭۈلدىكى acl نى چىقىرىۋېتىشتە خاتالىق كۆرۈلدى:%s\n"

#: tools/chacl.c:172 tools/chacl.c:191
#, c-format
msgid "%s: access ACL '%s': %s at entry %d\n"
msgstr "%s: زىيارەت ACL ‹%s›: %s بولسا %d دىكى كىرگۈ\n"

#: tools/chacl.c:259
#, c-format
msgid "%s: cannot get access ACL on '%s': %s\n"
msgstr "%s: ‹%s› نىڭ زىيارەت acl نى ئالغىلى بولمىدى:%s\n"

#: tools/chacl.c:265
#, c-format
msgid "%s: cannot get default ACL on '%s': %s\n"
msgstr "%s: ‹%s› نىڭ كۆڭۈلدىكى acl نى ئالغىلى بولمىدى:%s\n"

#: tools/chacl.c:271
#, c-format
msgid "%s: cannot get access ACL text on '%s': %s\n"
msgstr "%s: ‹%s› نىڭ زىيارەت acl تېكىستىنى ئالغىلى بولمىدى:%s\n"

#: tools/chacl.c:278
#, c-format
msgid "%s: cannot get default ACL text on '%s': %s\n"
msgstr "%s: ‹%s› نىڭ كۆڭۈلدىكى acl تېكىستىنى ئالغىلى بولمىدى:%s\n"

#: tools/chacl.c:304
#, c-format
msgid "%s: cannot set access acl on \"%s\": %s\n"
msgstr "%s: زىيارەت acl نى «%s» غا بەلگىلىگىلى بولمىدى:%s\n"

#: tools/chacl.c:310
#, c-format
msgid "%s: cannot set default acl on \"%s\": %s\n"
msgstr "%s: كۆڭۈلدىكى acl نى «%s» غا بەلگىلىگىلى بولمىدى:%s\n"

#: tools/chacl.c:328
#, c-format
msgid "%s: opendir failed: %s\n"
msgstr "%s: opendir مەغلۇپ بولدى: %s\n"

#: tools/chacl.c:342
#, c-format
msgid "%s: malloc failed: %s\n"
msgstr "%s: malloc مەغلۇپ بولدى: %s\n"

#: tools/do_set.c:410
#, c-format
msgid "%s: %s: Malformed access ACL `%s': %s at entry %d\n"
msgstr ""
"%s: %s: ‹%s› بولسا نورمال بولمىغان زىيارەت ACL دۇر: %s بولسا %d دىكى كىرگۈ\n"

#: tools/do_set.c:437
#, c-format
msgid "%s: %s: Malformed default ACL `%s': %s at entry %d\n"
msgstr ""
"%s: %s: ‹%s› بولسا نورمال بولمىغان كۆڭۈلدىكى ACL دۇر: %s بولسا %d دىكى "
"كىرگۈ\n"

#: tools/do_set.c:508
#, c-format
msgid "%s: %s: Only directories can have default ACLs\n"
msgstr "%s: %s: پەقەت مۇندەرىجىلەرنىڭلا كۆڭۈلدىكى ACL ئى بار\n"

#: tools/setfacl.c:147
#, c-format
msgid "%s: %s: No filename found in line %d, aborting\n"
msgstr "%s: %s: قۇر %d نىڭدا ھۆججەت ئاتى يوق، توختىتىلدى\n"

#: tools/setfacl.c:152
#, c-format
msgid "%s: No filename found in line %d of standard input, aborting\n"
msgstr ""
"%s: ئۆلچەملىك كىرگۈزۈشتىكى قۇر %d نىڭدا ھۆججەت ئاتى يوق، توختىتىلدى\n"

#: tools/setfacl.c:173
#, c-format
msgid "%s: %s: %s in line %d\n"
msgstr "%s: %s: %s، %d قۇردا\n"

#: tools/setfacl.c:205
#, c-format
msgid "%s: %s: Cannot change owner/group: %s\n"
msgstr "%s: %s: ئىگىسى/گۇرۇپپىنى ئۆزگەرتكىلى بولمىدى %s\n"

#: tools/setfacl.c:224
#, c-format
msgid "%s: %s: Cannot change mode: %s\n"
msgstr "%s: %s: ھالىتىنى ئۆزگەرتكىلى بولمىدى: %s\n"

#: tools/setfacl.c:266
#, c-format
msgid "%s %s -- set file access control lists\n"
msgstr "%s %s -- ھۆججەت زىيارەت تىزگىن تىزىمىنى بەلگىلەيدۇ\n"

#: tools/setfacl.c:268 tools/setfacl.c:653
#, c-format
msgid "Usage: %s %s\n"
msgstr "ئىشلىتىش ئۇسۇلى: %s %s\n"

#: tools/setfacl.c:271
#, c-format
msgid ""
"  -m, --modify=acl        modify the current ACL(s) of file(s)\n"
"  -M, --modify-file=file  read ACL entries to modify from file\n"
"  -x, --remove=acl        remove entries from the ACL(s) of file(s)\n"
"  -X, --remove-file=file  read ACL entries to remove from file\n"
"  -b, --remove-all        remove all extended ACL entries\n"
"  -k, --remove-default    remove the default ACL\n"
msgstr ""
"  -m, --modify=acl        ھۆججەت(لەر)نىڭ نۆۋەتتىكى ACL(لىرى) نى ئۆزگەرتىدۇ\n"
"  -M, --modify-file=file  read ACL entries to modify from file\n"
"  -x, --remove=acl        remove entries from the ACL(s) of file(s)\n"
"  -X, --remove-file=file  read ACL entries to remove from file\n"
"  -b, --remove-all        بارلىق كېڭەيتىلگەن ACL كىرگۈلىرىنى ئۆچۈرىدۇ\n"
"  -k, --remove-default    كۆڭۈلدىكى ACL نى ئۆچۈرىدۇ\n"

#: tools/setfacl.c:280
#, c-format
msgid ""
"      --set=acl           set the ACL of file(s), replacing the current ACL\n"
"      --set-file=file     read ACL entries to set from file\n"
"      --mask              do recalculate the effective rights mask\n"
msgstr ""
"      --set=acl           ھۆججەت(لەر)نىڭ ACL نى بەلگىلەيدۇ، نۆۋەتتىكى ACL نى "
"قاپلىۋېتىدۇ\n"
"      --set-file=file     read ACL entries to set from file\n"
"      --mask              do recalculate the effective rights mask\n"

#: tools/setfacl.c:286
#, c-format
msgid ""
"  -n, --no-mask           don't recalculate the effective rights mask\n"
"  -d, --default           operations apply to the default ACL\n"
msgstr ""
"  -n, --no-mask           ئىناۋەتلىك mask تەڭشىكى ھاسىل قىلمايدۇ\n"
"  -d, --default           كۆڭۈلدىكى ACL تەڭشىكىنى ئىشلىتىدۇ\n"

#: tools/setfacl.c:291
#, c-format
msgid ""
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"      --restore=file      restore ACLs (inverse of `getfacl -R')\n"
"      --test              test mode (ACLs are not modified)\n"
msgstr ""

#: tools/setfacl.c:299 tools/getfacl.c:597
#, c-format
msgid ""
"  -v, --version           print version and exit\n"
"  -h, --help              this help text\n"
msgstr ""
"  -v, --version           نەشر ئۇچۇرىنى بېسىپ چىقىرىپ ئاخىرلاشتۇرىدۇ\n"
"  -h, --help              مەزكۇر ياردەم ئۇچۇرىنى كۆرسىتىدۇ\n"

#: tools/setfacl.c:316 tools/getfacl.c:743
#, c-format
msgid "%s: Standard input: %s\n"
msgstr "%s: ئۆلچەملىك كىرگۈزۈش: %s\n"

#: tools/setfacl.c:452
#, c-format
msgid "%s: Option -%c incomplete\n"
msgstr "%s: تاللانما -%c چالا\n"

#: tools/setfacl.c:457
#, c-format
msgid "%s: Option -%c: %s near character %d\n"
msgstr "%s: تاللانما -%c: %s  %d نىڭ يېنى\n"

#: tools/setfacl.c:533
#, c-format
msgid "%s: %s in line %d of file %s\n"
msgstr "%s: %s بولسا قۇر %d، ھۆججەت %s\n"

#: tools/setfacl.c:541
#, c-format
msgid "%s: %s in line %d of standard input\n"
msgstr "%s: %s بولسا ئۆلچەملىك كىرگۈزۈشنىڭ %d-قۇرىدا\n"

#: tools/setfacl.c:655 tools/getfacl.c:758
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "تېخىمۇ كۆپ ئۇچۇر ئۈچۈن ‹%s --help› نى سىناپ كۆرۈڭ.\n"

#: tools/getfacl.c:498
#, c-format
msgid "%s: Removing leading '/' from absolute path names\n"
msgstr "%s: مۇتلەق يولىنىڭ بەشىدىكى ‹/› نى چىقىرىۋېتىدۇ\n"

#: tools/getfacl.c:569
#, c-format
msgid "%s %s -- get file access control lists\n"
msgstr "%s %s -- ھۆججەت زىيارەت تىزگىن تىزىمىنى ئوقۇيدۇ\n"

#: tools/getfacl.c:571 tools/getfacl.c:756
#, c-format
msgid "Usage: %s [-%s] file ...\n"
msgstr "ئىشلىتىش ئۇسۇلى: %s [-%s] file …\n"

#: tools/getfacl.c:577
#, c-format
msgid "  -d, --default           display the default access control list\n"
msgstr ""
"  -d, --default           كۆڭۈلدىكى ھۆججەت زىيارەت تىزگىن تىزىمىنى "
"كۆرسىتىدۇ\n"

#: tools/getfacl.c:581
#, c-format
msgid ""
"  -a, --access            display the file access control list only\n"
"  -d, --default           display the default access control list only\n"
"  -c, --omit-header       do not display the comment header\n"
"  -e, --all-effective     print all effective rights\n"
"  -E, --no-effective      print no effective rights\n"
"  -s, --skip-base         skip files that only have the base entries\n"
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"  -t, --tabular           use tabular output format\n"
"  -n, --numeric           print numeric user/group identifiers\n"
"      --one-file-system   skip files on different filesystems\n"
"  -p, --absolute-names    don't strip leading '/' in pathnames\n"
msgstr ""
