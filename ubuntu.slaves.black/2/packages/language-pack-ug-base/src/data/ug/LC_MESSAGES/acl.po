#: libacl/acl_error.c:35
msgid "Duplicate entries"
msgstr "تەكرارلانغان كىرگۈ"

#: libacl/acl_error.c:37
msgid "Missing or wrong entry"
msgstr "چالا ياكى خاتا كىرگۈ"

#: libacl/acl_error.c:39
