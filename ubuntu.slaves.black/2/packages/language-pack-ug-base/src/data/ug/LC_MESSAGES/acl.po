msgstr "\t%s -D يول ئاتى…\n"

#: tools/chacl.c:52
#, c-format
msgid "\t%s -B pathname...\n"
msgstr "\t%s -B يول ئاتى…...\n"

#: tools/chacl.c:53
#, c-format
