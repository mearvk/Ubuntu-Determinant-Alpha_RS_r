#: ../lshw.cc:24
#, c-format
msgid "usage: %s [-format] [-options ...]\n"
msgstr "utilizzo: %s [-formato] [-opzioni ...]\n"

#: ../lshw.cc:25
#, c-format
msgid "       %s -version\n"
msgstr "       %s -versione\n"

#: ../lshw.cc:27
#, c-format
msgid "\t-version        print program version (%s)\n"
msgstr "\t-versione stampa la versione del programma (%s)\n"

#: ../lshw.cc:28
#, c-format
msgid ""
"\n"
"format can be\n"
msgstr ""
"\n"
"formato può essere\n"

#: ../lshw.cc:29
#, c-format
msgid "\t-html           output hardware tree as HTML\n"
msgstr "\t-html output albero hardware come HTML\n"

#: ../lshw.cc:30
#, c-format
msgid "\t-xml            output hardware tree as XML\n"
msgstr "\t-xml output albero hardware come XML\n"

#: ../lshw.cc:31
#, c-format
msgid "\t-short          output hardware paths\n"
msgstr "\t-percorsi hardware di uscita brevi\n"

#: ../lshw.cc:32
#, c-format
msgid "\t-businfo        output bus information\n"
msgstr "\t-businfo uscita informazioni sul bus\n"

#: ../lshw.cc:34
#, c-format
msgid "\t-X              use graphical interface\n"
msgstr "\t-X usa interfaccia grafica\n"

#: ../lshw.cc:35
#, c-format
msgid ""
"\n"
"options can be\n"
msgstr ""
"\n"
"Le opzioni possono essere\n"

#: ../lshw.cc:37
#, c-format
msgid "\t-class CLASS    only show a certain class of hardware\n"
msgstr "\t-class CLASS mostra solo una certa classe di hardware\n"

#: ../lshw.cc:38
#, c-format
msgid "\t-C CLASS        same as '-class CLASS'\n"
msgstr "\t-C CLASSE è uguale a '-class CLASSE'.\n"

#: ../lshw.cc:39
#, c-format
msgid "\t-c CLASS        same as '-class CLASS'\n"
msgstr "\t-c CLASSE è uguale a '-class CLASSE'.\n"

#: ../lshw.cc:41
#, c-format
msgid "\t-disable TEST   disable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr ""
"\t-disable TEST disabilita un test (come pci, isapnp, cpuid, ecc.).\n"

#: ../lshw.cc:43
#, c-format
msgid "\t-enable TEST    enable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr "\t-enable TEST abilita un test (come pci, isapnp, cpuid, ecc.).\n"

#: ../lshw.cc:44
#, c-format
msgid "\t-quiet          don't display status\n"
msgstr "\t-silenzioso non visualizza lo stato\n"

#: ../lshw.cc:45
#, c-format
msgid ""
"\t-sanitize       sanitize output (remove sensitive information like serial "
"numbers, etc.)\n"
msgstr ""
"\t-sanitize sanitizza l'output (rimuove informazioni sensibili come numeri "
"di serie, ecc.).\n"

#: ../lshw.cc:46
#, c-format
msgid "\t-numeric        output numeric IDs (for PCI, USB, etc.)\n"
msgstr "\t-numerico produce gli ID numerici (per PCI, USB, ecc.).\n"

#: ../lshw.cc:119
#, c-format
msgid "the latest version is %s\n"
msgstr "la versione più recente è %s\n"

#: ../lshw.cc:215
#, c-format
msgid "WARNING: you should run this program as super-user.\n"
msgstr ""
"ATTENZIONE: questo programma deve essere eseguito come superutente.\n"

#: ../lshw.cc:243
#, c-format
msgid ""
"WARNING: output may be incomplete or inaccurate, you should run this program "
"as super-user.\n"
msgstr ""
"ATTENZIONE: l'output potrebbe essere incompleto o impreciso; è necessario "
"eseguire questo programma come super-utente.\n"
