#: src/vte.cc:7612
msgid "WARNING"
msgstr "ਸਾਵਾਧਾਨ"

#: src/vte.cc:7614
msgid "GnuTLS not enabled; data will be written to disk unencrypted!"
msgstr ""
"GnuTLS ਸਮਰੱਥ ਨਹੀਂ ਹੈ; ਡਿਸਕ ਉੱਤੇ ਲਿਖਿਆ ਡਾਟਾ ਬਿਨਾਂ-ਇੰਕ੍ਰਿਪਸ਼ਨ ਦੇ ਲਿਖਿਆ ਜਾਵੇਗਾ!"

#: src/spawn.cc:124
#, c-format
msgid "Failed to set pipe nonblocking: %s"
msgstr "ਪਾਈਪ ਬਿਨ-ਬਲਾਕਿੰਗ ਸੈੱਟ ਕਰਨ ਲਈ ਫੇਲ੍ਹ ਹੈ: %s"

#: src/spawn.cc:169
#, c-format
msgid "poll error: %s"
msgstr "ਪੋਲ ਗਲਤੀ: %s"

#: src/spawn.cc:176
msgid "Operation timed out"
msgstr "ਕਾਰਵਾਈ ਲਈ ਸਮਾਂ ਸਮਾਪਤ"

#: src/spawn.cc:186
msgid "Operation was cancelled"
msgstr "ਕਾਰਵਾਈ ਰੱਦ ਕੀਤੀ ਗਈ ਸੀ"

#: src/spawn.cc:204
#, c-format
#| msgid "Error reading from child: %s."
msgid "Failed to read from child pipe (%s)"
msgstr "ਚਲਾਈਡ ਪਾਈਪ (%s) ਤੋਂ ਪੜ੍ਹਨ ਦੌਰਾਨ ਫੇਲ੍ਹ ਹੈ"

#: src/spawn.cc:639
#, c-format
msgid "Failed to change to directory “%s”: %s"
msgstr "ਡਾਇਰੈਕਟਰੀ “%s” ਬਦਲਣ ਲਈ ਅਸਫ਼ਲ ਹੈ: %s"

#: src/spawn.cc:708
#, c-format
msgid "Failed to execute child process “%s”: "
msgstr "“%s” ਚਲਾਈਡ ਪਰੋਸੈਸ ਚਲਾਉਣ ਲਈ ਅਸਫ਼ਲ ਹੈ: "
