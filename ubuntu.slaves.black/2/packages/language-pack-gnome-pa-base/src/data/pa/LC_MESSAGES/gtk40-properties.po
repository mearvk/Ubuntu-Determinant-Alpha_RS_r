#: gtk/gtkcellview.c:243
msgid "The GtkCellAreaContext used to compute the geometry of the cell view"
msgstr "ਸੈੱਲ ਝਲਕ ਦੀ ਜੁਮੈਟਰੀ ਕੱਢਣ ਲਈ ਵਰਤਣ ਵਾਸਤੇ GtkCellAreaContext"

#: gtk/gtkcellview.c:260
