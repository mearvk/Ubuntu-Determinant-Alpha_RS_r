"ਹੋ।"

#: ../src/mail/mail.error.xml.h:40
msgid "_Expunge"
msgstr "ਸੁੰਘੜੋ(_E)"

#: ../src/mail/mail.error.xml.h:41
msgid ""
"Are you sure you want to permanently remove all the deleted messages in all "
