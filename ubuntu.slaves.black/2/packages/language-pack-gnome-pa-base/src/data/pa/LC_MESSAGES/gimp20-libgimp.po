#, c-format
msgid "%s plug-in can't handle transparent layers"
msgstr ""

#: ../libgimp/gimpexport.c:358
#, c-format
msgid "%s plug-in can't handle layer masks"
msgstr "%s ਪਲੱਗਇਨ ਮਾਸਕ ਲੇਅਰ ਹੈਂਡਲ ਨਹੀਂ ਕਰ ਸਕਦੀ"

