msgid "Flatten Image"
msgstr "ਫੈਲਿਆ ਚਿੱਤਰ"

#: ../libgimp/gimpexport.c:340
#, c-format
msgid "%s plug-in can't handle transparency"
msgstr "%s ਪਲੱਗਇਨ ਪਾਰਦਰਸ਼ਤਾ ਹੈਂਡਲ ਨਹੀਂ ਕਰ ਸਕਦੀ"

