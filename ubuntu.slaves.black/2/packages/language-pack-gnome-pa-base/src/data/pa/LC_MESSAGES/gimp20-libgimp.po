#: ../libgimp/gimpexport.c:295 ../libgimp/gimpexport.c:331
#, c-format
msgid "%s plug-in can't handle layers"
msgstr "%s ਪਲੱਗਇਨ ਲੇਅਰ ਹੈਂਡਲ ਨਹੀਂ ਕਰ ਸਕਦੀ"

