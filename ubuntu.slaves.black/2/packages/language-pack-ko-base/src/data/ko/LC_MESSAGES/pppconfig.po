msgstr "%s 인증 방법"

#: pppconfig:322
msgid "Advanced Options"
msgstr "고급 옵션"

#: pppconfig:324
msgid "Write files and return to main menu."
msgstr "파일을 쓰고 주 메뉴로 돌아갑니다."

