#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "소문자로 키 변환하기"

#: src/makedb.c:69
msgid "NAME"
msgstr "이름"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "파일 이름으로 출력하기"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "데이타베이스를 빌드하는 동안 메세지를 표시하지 않기"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr "한줄에 하나씩 데이터베이스 내용을 출력"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "텍스트 방식의 입력으로 간단한 DB 데이타베이스를 생성합니다."

#. Strings for arguments in help texts.
#: src/makedb.c:81
msgid ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"
msgstr ""
"<입력-파일> <출력-파일>\n"
"-o <출력-파일> <입력-파일>\n"
"-u <입력-파일>"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "인수의 수가 잘못되었습니다."

#: src/makedb.c:154
#, c-format
msgid "cannot open database file `%s': %s"
msgstr "데이타베이스 파일 `%s': %s 를(을) 열 수 없습니다."

#: src/makedb.c:173
#, c-format
msgid "cannot open input file `%s'"
msgstr "입력 파일 `%s' 를(을) 열 수 없습니다."

#: src/makedb.c:187
#, c-format
msgid "cannot open output file `%s': %s"
msgstr "출력 파일 `%s': %s 를(을) 열수 없습니다."

#. We print some extra information.
#: src/makedb.c:235
msgid "Report bugs using the `glibcbug' script to <bugs@gnu.org>.\n"
msgstr "`glibcbug' 스크립을 사용해서 <bugs@gnu.org>로 버그 리포팅을 하세요.\n"

