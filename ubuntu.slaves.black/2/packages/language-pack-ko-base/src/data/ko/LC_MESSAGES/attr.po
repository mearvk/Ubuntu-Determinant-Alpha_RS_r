msgstr "%s를 위한 어트리뷰트 설정 중"

#: libattr/attr_copy_fd.c:152 libattr/attr_copy_file.c:150
#, c-format
msgid "setting attribute %s for %s"
msgstr "%s의 %s 어트리뷰트 설정 중"

#: tools/setfattr.c:75 tools/getfattr.c:100
msgid "No such attribute"
msgstr "그런 어트리뷰트는 없습니다"

#: tools/setfattr.c:129
#, c-format
msgid "%s: %s: No filename found in line %d, aborting\n"
msgstr "%s: %s: %d번째 줄에서 파일명을 찾을 수 없음, 중단함\n"

#: tools/setfattr.c:133
#, c-format
msgid "%s: No filename found in line %d of standard input, aborting\n"
msgstr "%s: 표준 입력 %d번째 줄에서 파일명을 찾을 수 없음, 중단함\n"

#: tools/setfattr.c:180
#, c-format
msgid "%s %s -- set extended attributes\n"
msgstr "%s %s -- 확장 어트리뷰트 설정\n"

#: tools/setfattr.c:181 tools/getfattr.c:385
#, c-format
msgid "Usage: %s %s\n"
msgstr "사용법: %s %s\n"

#: tools/setfattr.c:182
#, c-format
msgid "       %s %s\n"
msgstr "       %s %s\n"

#: tools/setfattr.c:184
#, c-format
msgid ""
"  -n, --name=name         set the value of the named extended attribute\n"
"  -x, --remove=name       remove the named extended attribute\n"
"  -v, --value=value       use value as the attribute value\n"
"  -h, --no-dereference    do not dereference symbolic links\n"
"      --restore=file      restore extended attributes\n"
"      --raw               attribute value is not encoded\n"
"      --version           print version and exit\n"
"      --help              this help text\n"
msgstr ""

#: tools/setfattr.c:264
#, c-format
msgid ""
"Usage: %s %s\n"
"       %s %s\n"
"Try `%s --help' for more information.\n"
msgstr ""
"사용법: %s %s\n"
"       %s %s\n"
"'%s --help'를 입력하면 더 많은 정보를 얻을 수 있습니다.\n"

#: tools/getfattr.c:265
#, c-format
msgid "%s: Removing leading '/' from absolute path names\n"
msgstr "%s: 절대 패스명 앞에 있는 '/'를 제거합니다.\n"

#: tools/getfattr.c:383
#, c-format
msgid "%s %s -- get extended attributes\n"
msgstr "%s %s -- 확장 어트리뷰트 가져오기\n"

#: tools/getfattr.c:388
#, c-format
msgid ""
"  -n, --name=name         get the named extended attribute value\n"
"  -d, --dump              get all extended attribute values\n"
"  -e, --encoding=...      encode values (as 'text', 'hex' or 'base64')\n"
"      --match=pattern     only get attributes with names matching pattern\n"
"      --only-values       print the bare values only\n"
"  -h, --no-dereference    do not dereference symbolic links\n"
"      --one-file-system   skip files on different filesystems\n"
"      --absolute-names    don't strip leading '/' in pathnames\n"
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P  --physical          physical walk, do not follow symbolic links\n"
"      --version           print version and exit\n"
"      --help              this help text\n"
msgstr ""

#: tools/getfattr.c:489
#, c-format
msgid "%s: invalid regular expression \"%s\"\n"
msgstr "%s: 잘못된 정규 표현식 \"%s\"\n"

#: tools/getfattr.c:503
#, c-format
msgid ""
"Usage: %s %s\n"
"Try `%s --help' for more information.\n"
msgstr ""
"사용법: %s %s\n"
"'%s --help'를 입력하면 더 많은 정보를 얻을 수 있습니다.\n"

#: tools/attr.c:49
#, c-format
msgid ""
"Usage: %s [-LRSq] -s attrname [-V attrvalue] pathname  # set value\n"
"       %s [-LRSq] -g attrname pathname                 # get value\n"
"       %s [-LRSq] -r attrname pathname                 # remove attr\n"
"       %s [-LRq]  -l pathname                          # list attrs \n"
"      -s reads a value from stdin and -g writes a value to stdout\n"
msgstr ""
"사용법: %s [-LRSq] -s attrname [-V attrvalue] pathname # 설정값 입력\n"
"%s [-LRSq] -g attrname pathname # 설정값 가져오기\n"
"%s [-LRSq] -r attrname pathname # 어트리뷰트 제거\n"
"%s [-LRq] -l pathname # 어트리뷰트 리스트 보이기\n"

#: tools/attr.c:87 tools/attr.c:104 tools/attr.c:113 tools/attr.c:122
#, c-format
msgid "Only one of -s, -g, -r, or -l allowed\n"
msgstr "다음 중 -s, -g, -r, -l 오직 한가지만 가능\n"

#: tools/attr.c:95 tools/attr.c:161
#, c-format
msgid "-V only allowed with -s\n"
msgstr "-s에는 -V만 가능\n"

#: tools/attr.c:140
#, c-format
msgid "Unrecognized option: %c\n"
msgstr "알수 없는 옵션: %c\n"

#: tools/attr.c:147
#, c-format
msgid "A filename to operate on is required\n"
msgstr "적용될 파일 이름이 필요합니다.\n"

#: tools/attr.c:179
#, c-format
msgid "Could not set \"%s\" for %s\n"
msgstr "%s를 위한 \"%s\" 설정 불가\n"

#: tools/attr.c:184
#, c-format
msgid "Attribute \"%s\" set to a %d byte value for %s:\n"
msgstr ""

#: tools/attr.c:202
#, c-format
msgid "Could not get \"%s\" for %s\n"
msgstr "%s를 위한 \"%s\" 가져오기 불가\n"

#: tools/attr.c:207
#, c-format
msgid "Attribute \"%s\" had a %d byte value for %s:\n"
msgstr ""

#: tools/attr.c:220
#, c-format
msgid "Could not remove \"%s\" for %s\n"
msgstr "%s를 위한 \"%s\" 제거 불가\n"

#: tools/attr.c:238
#, c-format
msgid "Could not list %s\n"
msgstr "%s 을(를) 리스트하지 못했습니다\n"

#: tools/attr.c:248
#, c-format
msgid "Attribute \"%s\" has a %d byte value for %s\n"
msgstr "특성 \"%s\"의 %d 바이트 값은 %s 입니다\n"

#: tools/attr.c:260
#, c-format
msgid "At least one of -s, -g, -r, or -l is required\n"
msgstr "-s, -g, -r, -l 중 적어도 한가지 필요\n"
