#: ../adduser:1091
msgid ""
"adduser [--home DIR] [--shell SHELL] [--no-create-home] [--uid ID]\n"
"[--firstuid ID] [--lastuid ID] [--gecos GECOS] [--ingroup GROUP | --gid ID]\n"
"[--disabled-password] [--disabled-login] [--add_extra_groups]\n"
"[--encrypt-home] USER\n"
"   Add a normal user\n"
"\n"
"adduser --system [--home DIR] [--shell SHELL] [--no-create-home] [--uid ID]\n"
"[--gecos GECOS] [--group | --ingroup GROUP | --gid ID] [--disabled-"
"password]\n"
"[--disabled-login] [--add_extra_groups] USER\n"
"   Add a system user\n"
"\n"
"adduser --group [--gid ID] GROUP\n"
"addgroup [--gid ID] GROUP\n"
"   Add a user group\n"
"\n"
"addgroup --system [--gid ID] GROUP\n"
"   Add a system group\n"
"\n"
"adduser USER GROUP\n"
"   Add an existing user to an existing group\n"
"\n"
"general options:\n"
"  --quiet | -q      don't give process information to stdout\n"
"  --force-badname   allow usernames which do not match the\n"
"                    NAME_REGEX[_SYSTEM] configuration variable\n"
"  --extrausers      uses extra users as the database\n"
"  --help | -h       usage message\n"
"  --version | -v    version number and copyright\n"
"  --conf | -c FILE  use FILE as configuration file\n"
"\n"
msgstr ""
"adduser [--home DIR] [--shell SHELL] [--no-create-home] [--uid ID]\n"
"[--firstuid ID] [--lastuid ID] [--gecos GECOS] [--ingroup GROUP | --gid ID]\n"
"[--disabled-password] [--disabled-login] [--add_extra_groups]\n"
"[--encrypt-home] USER\n"
"   일반 사용자를 추가합니다\n"
"\n"
"adduser --system [--home DIR] [--shell SHELL] [--no-create-home] [--uid ID]\n"
"[--gecos GECOS] [--group | --ingroup GROUP | --gid ID] [--disabled-"
"password]\n"
"[--disabled-login] [--add_extra_groups] USER\n"
"   시스템 사용자를 추가합니다\n"
"\n"
"adduser --group [--gid ID] GROUP\n"
"addgroup [--gid ID] GROUP\n"
"   사용자 그룹을 추가합니다\n"
"\n"
"addgroup --system [--gid ID] GROUP\n"
"   시스템 그룹을 추가합니다\n"
"\n"
"adduser USER GROUP\n"
"   존재하는 사용자를 존재하는 그룹에 추가합니다\n"
"\n"
"일반 옵션:\n"
"  --quiet | -q      실행 정보를 표준 출력으로 내보내지 않습니다\n"
"  --force-badname   NAME_REGEX[_SYSTEM] 구성 변수애\n"
"                    맞지 않는 사용자명을 허용합니다\n"
"  --extrausers      기타 사용자를 데이터베이스로 사용합니다\n"
"  --help | -h       사용법 메시지\n"
"  --version | -v    버전 숫자와 저작권\n"
"  --conf | -c FILE  FILE을 구성 파일로 사용합니다\n"
"\n"

#. everyone can issue "--help" and "--version", but only root can go on
#: ../deluser:107
msgid "Only root may remove a user or group from the system.\n"
msgstr "루트만 사용자나 그룹을 제거할 수 있습니다.\n"

#: ../deluser:128
msgid "No options allowed after names.\n"
msgstr "이름 다음에 옵션을 쓸 수 없습니다.\n"

#: ../deluser:167
msgid "Enter a group name to remove: "
msgstr "제거할 그룹 이름을 입력: "

#: ../deluser:169
msgid "Enter a user name to remove: "
msgstr "제거할 사용자 이름 입력: "

#: ../deluser:180
msgid ""
"In order to use the --remove-home, --remove-all-files, and --backup "
"features,\n"
"you need to install the `perl' package. To accomplish that, run\n"
"apt-get install perl.\n"
msgstr ""
"--remove-home, --remove-all-files, 그리고 --backup features를 사용하기\n"
"위해서는 `perl'  패키지를 설치해야 합니다. 이를 위해 apt-get install perl를\n"
"실행하시오.\n"

#: ../deluser:225
#, perl-format
msgid "The user `%s' is not a system user. Exiting.\n"
msgstr "'%s' 사용자는 시스템 사용자가 아닙니다.  종료합니다.\n"

#: ../deluser:229
#, perl-format
msgid "The user `%s' does not exist, but --system was given. Exiting.\n"
msgstr "--system에 주어진 '%s' 사용자는 존재하지 않습니다.  종료합니다.\n"

#: ../deluser:240
msgid "WARNING: You are just about to delete the root account (uid 0)\n"
msgstr "*경고*: 방금 루트 계정(uid 0)을 삭제했습니다.\n"

#: ../deluser:241
msgid ""
"Usually this is never required as it may render the whole system unusable\n"
msgstr "일반적으로 전체시스템을 불안정할게 만드는것을 절대 요구하지 않습니다.\n"

#: ../deluser:236
msgid "If you really want this, call deluser with parameter --force\n"
msgstr "정말 하시려면, deluser -force를 실행하십시오.\n"

#: ../deluser:243
msgid "Stopping now without having performed any action\n"
msgstr "아무 동작 없이 바로 즉시 중지\n"

#: ../deluser:254
msgid "Looking for files to backup/remove ...\n"
msgstr "백업/제거할 파일들을 찾는 중...\n"

#: ../deluser:247
#, perl-format
msgid "fork for `mount' to parse mount points failed: %s\n"
msgstr "'mount'용 마운트위치 분석 실패: %s\n"

#: ../deluser:257
#, perl-format
msgid "pipe of command `mount' could not be closed: %s\n"
msgstr "'mount'명령의 파이프를 닫을 수 없음: %s\n"

#: ../deluser:291
#, perl-format
msgid "Not backing up/removing `%s', it is a mount point.\n"
msgstr "'%s'는 마운트포인터라 백업/제거 안됨.\n"

#: ../deluser:298
#, perl-format
msgid "Not backing up/removing `%s', it matches %s.\n"
msgstr "'%s'가  '%s'일치해서 백업/제거 안됨.\n"

#: ../deluser:312
#, perl-format
msgid "Cannot handle special file %s\n"
msgstr "특정 %s 파일을 조작할 수 없습니다.\n"

#: ../deluser:320
#, perl-format
msgid "Backing up files to be removed to %s ...\n"
msgstr "%s에서 삭제할 백업파일들 ...\n"

#: ../deluser:339
msgid "Removing files ...\n"
msgstr "파일 제거중 ...\n"

#: ../deluser:348
msgid "Removing crontab ...\n"
msgstr "crontab 제거중 ...\n"

#: ../deluser:378
#, perl-format
msgid "Warning: group `%s' has no more members.\n"
msgstr "경고: '%s'그룹이 회원목록에 더이상 없음.\n"

#: ../deluser:380
#, perl-format
msgid "getgrnam `%s' failed. This shouldn't happen.\n"
msgstr "'%s' getgrnam 실패. 이것은 문제가 아님.\n"

#: ../deluser:385
#, perl-format
msgid "The group `%s' is not a system group. Exiting.\n"
msgstr "'%s'그룹이 시스템그룹이 아님. 종료함.\n"

#: ../deluser:389
#, perl-format
msgid "The group `%s' is not empty!\n"
msgstr "'%s'그룹이 비어있지 않음.\n"

#: ../deluser:413
#, perl-format
msgid "`%s' still has `%s' as their primary group!\n"
msgstr "'%s'는 아직 우선그룹 '%s'을 가지고 있음.\n"

#: ../deluser:414
msgid "You may not remove the user from their primary group.\n"
msgstr "우선그룹에서 사용자를 삭제할 수 없음.\n"

#: ../deluser:431
#, perl-format
msgid "The user `%s' is not a member of group `%s'.\n"
msgstr "'%s'사용자는 '%s'그룹의 일원이 아님.\n"

#: ../deluser:434
#, perl-format
msgid "Removing user `%s' from group `%s' ...\n"
msgstr "'%s'그룹에서 '%s'사용자 제거중 ...\n"

#: ../deluser:488
#, perl-format
msgid ""
"deluser version %s\n"
"\n"
msgstr ""
"deluser %s 버전\n"
"\n"

#: ../deluser:474
msgid "Removes users and groups from the system.\n"
msgstr "시스템에서 그룹과 사용자를 제거.\n"

