#: ../adduser:805
#, perl-format
msgid "Setting quota for user `%s' to values of user `%s' ...\n"
msgstr "%s 사용자에게 사용량을 %s 사용자 값 만큼으로 설정 중...\n"

#: ../adduser:846
#, perl-format
msgid "Not creating home directory `%s'.\n"
msgstr "홈 디렉토리 '%s' 을(를) 만들지 않습니다.\n"

