#. everyone can issue "--help" and "--version", but only root can go on
#: ../adduser:161
msgid "Only root may add a user or group to the system.\n"
msgstr "루트만이 사용자나 그룹을 시스템에 추가할 수 있습니다.\n"

#: ../adduser:191 ../deluser:145
msgid "Only one or two names allowed.\n"
msgstr "하나 혹은 두 개의 이름만 지정할 수 있습니다.\n"

#: ../adduser:197
msgid "Specify only one name in this mode.\n"
msgstr "이 경우에는 한 개의 이름만 지정할 수 있습니다.\n"

#: ../adduser:224
msgid "The --group, --ingroup, and --gid options are mutually exclusive.\n"
msgstr "--group, --ingroup, 그리고 --gid 옵션은 한 번에 한 개만 쓸 수 있습니다.\n"

#: ../adduser:229
msgid "The home dir must be an absolute path.\n"
msgstr "홈 디렉토리는 절대 경로를 써야 합니다.\n"

#: ../adduser:233
#, perl-format
msgid "Warning: The home dir %s you specified already exists.\n"
msgstr "경고: 지정한 %s 홈 디렉터리는 이미 존재합니다.\n"

#: ../adduser:235
#, perl-format
msgid "Warning: The home dir %s you specified can't be accessed: %s\n"
msgstr "경고: 지정한 %s 홈 디렉터리로 접근 불가: %s\n"

#: ../adduser:305
#, perl-format
msgid "The group `%s' already exists as a system group. Exiting.\n"
msgstr "'%s' 그룹은 이미 시스템 그룹에 존재합니다.  종료합니다.\n"

#: ../adduser:310
#, perl-format
msgid "The group `%s' already exists and is not a system group. Exiting.\n"
msgstr "'%s' 그룹은 이미 존재하며 시스템 그룹이 아닙니다.  종료합니다.\n"

#: ../adduser:315
#, perl-format
msgid "The group `%s' already exists, but has a different GID. Exiting.\n"
msgstr "'%s' 그룹은 이미 존재하며 다른 GID를 가지고 있습니다.  종료합니다.\n"

#: ../adduser:320 ../adduser:354
#, perl-format
msgid "The GID `%s' is already in use.\n"
msgstr "'%s' GID는 이미 사용하고 있습니다.\n"

#: ../adduser:330
#, perl-format
msgid ""
"No GID is available in the range %d-%d (FIRST_SYS_GID - LAST_SYS_GID).\n"
msgstr "범위 %d-%d (FIRST_SYS_GID - LAST_SYS_GID) 내에 남아 있는 GID가 없습니다.\n"

#: ../adduser:331 ../adduser:372
#, perl-format
msgid "The group `%s' was not created.\n"
msgstr "`%s' 그룹이 만들어지지 않았습니다.\n"

#: ../adduser:336 ../adduser:376
#, perl-format
msgid "Adding group `%s' (GID %d) ...\n"
msgstr "그룹 `%s' (GID %d) 추가 ...\n"

#: ../adduser:340 ../adduser:380 ../adduser:404 ../deluser:366 ../deluser:400
#: ../deluser:440
msgid "Done.\n"
msgstr "완료.\n"

#: ../adduser:351 ../adduser:991
#, perl-format
msgid "The group `%s' already exists.\n"
msgstr "`%s' 그룹은 이미 존재합니다.\n"

#: ../adduser:371
#, perl-format
msgid "No GID is available in the range %d-%d (FIRST_GID - LAST_GID).\n"
msgstr "범위 %d-%d (FIRST_GID - LAST_GID) 내에 남아 있는 GID가 없습니다.\n"

#: ../deluser:447
#, perl-format
msgid "The user `%s' does not exist.\n"
msgstr "`%s' 사용자가 없습니다.\n"

#: ../deluser:451
#, perl-format
msgid "The group `%s' does not exist.\n"
msgstr "`%s' 그룹이 없습니다.\n"

#: ../adduser:394 ../adduser:788
#, perl-format
msgid "The user `%s' is already a member of `%s'.\n"
msgstr "`%s' 사용자는 이미 %s의 일원입니다.\n"

#: ../adduser:398 ../adduser:794
#, perl-format
msgid "Adding user `%s' to group `%s' ...\n"
msgstr "'%s' 사용자를 '%s' 그룹에 추가 중...\n"

#: ../adduser:469
#, perl-format
msgid "The system user `%s' already exists. Exiting.\n"
msgstr "'%s' 시스템 사용자는 이미 존재합니다.  종료합니다.\n"

#: ../adduser:421
#, perl-format
msgid "The user `%s' already exists, but is not a system user. Exiting.\n"
msgstr "사용자 '%s'가 이미 존재하지만 시스템 사용자는 아닙니다. 종료합니다.\n"

#: ../adduser:425
#, perl-format
msgid "The user `%s' already exists with a different UID. Exiting.\n"
msgstr "'%s' 사용자는 다른 UID로 이미 존재합니다.  종료합니다.\n"

#: ../adduser:439
#, perl-format
msgid ""
"No UID/GID pair is available in the range %d-%d (FIRST_SYS_UID - "
"LAST_SYS_UID).\n"
msgstr "범위 %d-%d (FIRST_SYS_UID - LAST_SYS_UID) 내에 남아 있는 UID/GID 짝이 없습니다.\n"

#: ../adduser:440 ../adduser:453 ../adduser:523 ../adduser:635 ../adduser:640
#, perl-format
msgid "The user `%s' was not created.\n"
msgstr "`%s' 사용자가 만들어지지 않았습니다.\n"

#: ../adduser:452
#, perl-format
msgid ""
"No UID is available in the range %d-%d (FIRST_SYS_UID - LAST_SYS_UID).\n"
msgstr "범위 %d-%d (FIRST_SYS_UID - LAST_SYS_UID) 내에 남아 있는 UID가 없습니다.\n"

#: ../adduser:517 ../adduser:529
msgid "Internal error"
msgstr "내부 오류"

#: ../adduser:465
#, perl-format
msgid "Adding system user `%s' (UID %d) ...\n"
msgstr "시스템 사용자 `%s' (%d) 추가 ...\n"

#: ../adduser:469
#, perl-format
msgid "Adding new group `%s' (GID %d) ...\n"
msgstr "새 그룹 `%s' (%d) 추가 ...\n"

#: ../adduser:475
#, perl-format
msgid "Adding new user `%s' (UID %d) with group `%s' ...\n"
msgstr "새로운 사용자 `%s' (%d) 을(를) 그룹 `%s'(으)로 추가 ...\n"

#: ../AdduserCommon.pm:212
#, perl-format
msgid "`%s' returned error code %d. Exiting.\n"
msgstr "'%s'가 오류 코드 %d를 반환했습니다.  종료합니다.\n"

#: ../AdduserCommon.pm:214
#, perl-format
msgid "`%s' exited from signal %d. Exiting.\n"
msgstr "'%s'가 %d 신호로 종료했습니다.  종료합니다.\n"

#: ../adduser:483
#, perl-format
msgid ""
"%s failed with return code 15, shadow not enabled, password aging cannot be "
"set. Continuing.\n"
msgstr "%s가 반환 코드 15로 실패했으며, 쉐도우는 활성화되지 않았고, 암호 사용기간은 설정될 수 없습니다.  계속합니다.\n"

#: ../adduser:611
#, perl-format
msgid "Adding user `%s' ...\n"
msgstr "'%s' 사용자를 추가 중...\n"

#: ../adduser:634
#, perl-format
msgid ""
"No UID/GID pair is available in the range %d-%d (FIRST_UID - LAST_UID).\n"
msgstr "범위 %d-%d (FIRST_UID - LAST_UID) 내에 남아 있는 UID/GID 짝이 없습니다.\n"

#: ../adduser:506
#, perl-format
msgid "No UID is available in the range %d-%d (FIRST_UID - LAST_UID).\n"
msgstr "범위 %d-%d (FIRST_UID - LAST_UID) 내에 남아 있는 UID가 없습니다.\n"

#: ../adduser:687
#, perl-format
msgid "Adding new group `%s' (%d) ...\n"
msgstr "새 그룹 '%s' (%d) 추가 ...\n"

#: ../adduser:533
#, perl-format
msgid "Adding new user `%s' (%d) with group `%s' ...\n"
msgstr "새 사용자 '%s' (%d) 을(를) 그룹 '%s' (으)로 추가 ...\n"

