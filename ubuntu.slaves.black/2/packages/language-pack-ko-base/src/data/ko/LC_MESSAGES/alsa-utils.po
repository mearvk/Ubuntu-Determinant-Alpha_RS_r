#: seq/aconnect/aconnect.c:49
#, c-format
msgid "aconnect - ALSA sequencer connection manager\n"
msgstr "aconnect - ALSA 시퀀서 연결 관리자입니다\n"

#: seq/aconnect/aconnect.c:50
#, c-format
msgid "Copyright (C) 1999-2000 Takashi Iwai\n"
msgstr "저작권(C) 1999-2000 Takashi Iwai\n"

#: seq/aconnect/aconnect.c:51
#, c-format
msgid "Usage:\n"
msgstr "사용법:\n"

#: seq/aconnect/aconnect.c:52
#, c-format
msgid " * Connection/disconnection between two ports\n"
msgstr " * 두 포트 사이에서 연결/연결 끊기를 합니다\n"

#: seq/aconnect/aconnect.c:53
#, c-format
msgid "   aconnect [-options] sender receiver\n"
msgstr "   aconnect [-선택 사항] 송신자 수신자\n"

#: seq/aconnect/aconnect.c:54
#, c-format
msgid "     sender, receiver = client:port pair\n"
msgstr "     송신자, 수신자 = 클라이언트:포트 쌍\n"

#: seq/aconnect/aconnect.c:55
#, c-format
msgid "     -d,--disconnect     disconnect\n"
msgstr "     -d,--disconnect     연결을 끊습니다\n"

#: seq/aconnect/aconnect.c:56
#, c-format
msgid "     -e,--exclusive      exclusive connection\n"
msgstr "     -e,--exclusive      독점 연결을 합니다\n"

#: seq/aconnect/aconnect.c:57
#, c-format
msgid "     -r,--real #         convert real-time-stamp on queue\n"
msgstr "     -r,--real #         대기열에 있는 실-시간-스탬프를 변환합니다\n"

#: seq/aconnect/aconnect.c:58
#, c-format
msgid "     -t,--tick #         convert tick-time-stamp on queue\n"
msgstr "     -t,--tick #         대기열에 있는 틱-타임-스탬프를 변환합니다\n"

#: seq/aconnect/aconnect.c:59
#, c-format
msgid " * List connected ports (no subscription action)\n"
msgstr " * 연결된 포트 목록을 봅니다(구독 조치 없이)\n"

#: seq/aconnect/aconnect.c:60
#, c-format
msgid "   aconnect -i|-o [-options]\n"
msgstr "   aconnect -i|-o [-선택 사항]\n"

#: seq/aconnect/aconnect.c:61
#, c-format
msgid "     -i,--input          list input (readable) ports\n"
msgstr "     -i,--input          입력(읽기 가능한) 포트 목록을 봅니다\n"

#: seq/aconnect/aconnect.c:62
#, c-format
msgid "     -o,--output         list output (writable) ports\n"
msgstr "     -o,--output         출력(쓰기 가능한) 포트 목록을 봅니다\n"

#: seq/aconnect/aconnect.c:63
#, c-format
msgid "     -l,--list           list current connections of each port\n"
msgstr "     -l,--list           각각 포트의 현재 연결 목록을 봅니다\n"

#: seq/aconnect/aconnect.c:64
#, c-format
msgid " * Remove all exported connections\n"
msgstr " * 모든 내보낸 연결을 제거합니다\n"

#: seq/aconnect/aconnect.c:65
#, c-format
msgid "     -x, --removeall\n"
msgstr "     -x, --removeall\n"

