#: seq/aseqnet/aseqnet.c:171
#, c-format
msgid "aseqnet - network client/server on ALSA sequencer\n"
msgstr "aseqnet - ALSA 시퀀서에 있는 네트워크 클라이언트/서버입니다\n"

#: seq/aseqnet/aseqnet.c:172
#, c-format
msgid "  Copyright (C) 1999 Takashi Iwai\n"
msgstr "  저작권(C) 1999 Takashi Iwai\n"

#: seq/aseqnet/aseqnet.c:173
#, c-format
msgid "usage:\n"
msgstr "사용법:\n"

#: seq/aseqnet/aseqnet.c:174
#, c-format
msgid "  server mode: aseqnet [-options]\n"
msgstr "  서버 모드: aseqnet [-선택 사항]\n"

#: seq/aseqnet/aseqnet.c:175
#, c-format
msgid "  client mode: aseqnet [-options] server_host\n"
msgstr "  클라이언트 모드: aseqnet [-선택 사항] 서버_호스트\n"

#: seq/aseqnet/aseqnet.c:176
#, c-format
msgid "options:\n"
msgstr "선택 사항:\n"

#: seq/aseqnet/aseqnet.c:177
#, c-format
msgid "  -6,--ipv6 : use IPv6 TCP protocol\n"
msgstr ""

#: seq/aseqnet/aseqnet.c:178
#, c-format
msgid "  -p,--port # : specify TCP port (digit or service name)\n"
msgstr "  -p,--port # : TCP 포트를 지정합니다(숫자나 서비스 이름)\n"

#: seq/aseqnet/aseqnet.c:179
#, c-format
msgid "  -s,--source addr : read from given addr (client:port)\n"
msgstr "  -s,--source addr : 주어진 주소에서 읽어옵니다(클라이언트:포트)\n"

#: seq/aseqnet/aseqnet.c:180
#, c-format
msgid "  -d,--dest addr : write to given addr (client:port)\n"
msgstr "  -d,--dest addr : 주어진 주소에 작성합니다(클라이언트:포트)\n"

#: seq/aseqnet/aseqnet.c:181
#, c-format
msgid "  -n,--name value : use a specific midi process name\n"
msgstr ""

#: seq/aseqnet/aseqnet.c:182
#, c-format
msgid "  -v, --verbose : print verbose messages\n"
msgstr "  -v, --verbose : 상세 메시지를 출력합니다\n"

#: seq/aseqnet/aseqnet.c:183
#, c-format
msgid "  -i, --info : print certain received events\n"
msgstr "  -i, --info : 몇몇 받은 이벤트를 출력합니다\n"

