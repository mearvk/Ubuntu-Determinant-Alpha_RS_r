#: ../plugins/unityshell/unityshell.xml.in.h:25
msgid "Background color override for the Dash, Launcher and Switcher."
msgstr "डॅश, लाँन्चर आणि स्वीचर यांचा पार्श्वभाग रंग दुर्लक्षित करा."

