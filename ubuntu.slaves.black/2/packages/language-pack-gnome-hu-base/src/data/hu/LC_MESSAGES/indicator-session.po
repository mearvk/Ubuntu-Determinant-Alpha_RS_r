#: ../src/backend-dbus/actions.c:776
msgid "Are you sure you want to close all programs and log out?"
msgstr "Biztos, hogy minden programot bezár és kijelentkezik?"

#: ../src/backend-dbus/actions.c:777
msgid ""
"Some software updates won't be applied until the computer next restarts."
msgstr ""
"Néhány szoftverfrissítés nem kerül alkalmazásra a számítógép következő "
"újraindításáig."

#: ../src/backend-dbus/actions.c:782 ../src/backend-dbus/actions.c:784
#: ../src/service.c:822
msgid "Log Out"
msgstr "Kijelentkezés"

#: ../src/backend-dbus/actions.c:785 ../src/backend-dbus/actions.c:822
#: ../src/backend-dbus/actions.c:852
msgid "Cancel"
msgstr "Mégse"

#: ../src/backend-dbus/actions.c:819 ../src/backend-dbus/actions.c:821
#: ../src/service.c:848
msgid "Restart"
msgstr "Újraindítás"

#: ../src/backend-dbus/actions.c:820
msgid "Are you sure you want to close all programs and restart the computer?"
msgstr ""
"Biztos, hogy bezárja az összes programot, és újraindítja a számítógépet?"

#: ../src/backend-dbus/actions.c:849 ../src/backend-dbus/actions.c:851
#: ../src/service.c:855
msgid "Shut Down"
msgstr "Leállítás"

#: ../src/backend-dbus/actions.c:850
msgid ""
"Are you sure you want to close all programs and shut down the computer?"
msgstr ""
"Biztos, hogy bezárja az összes programot, és kikapcsolja a számítógépet?"

