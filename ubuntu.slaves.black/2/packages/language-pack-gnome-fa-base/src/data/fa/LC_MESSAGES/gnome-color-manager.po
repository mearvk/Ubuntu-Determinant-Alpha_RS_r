#: src/gcm-viewer.c:665
msgid "Mapping format"
msgstr "درحال هدایت قالب"

#. TRANSLATORS: The qualifiers for the profile, e.g. 'RGB.Glossy.300dpi'
#: src/gcm-viewer.c:667
