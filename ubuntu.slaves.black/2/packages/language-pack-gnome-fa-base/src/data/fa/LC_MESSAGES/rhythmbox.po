#: plugins/audioscrobbler/rb-audioscrobbler-radio-source.c:761
#, c-format
msgid "This station is only available to %s subscribers"
msgstr "این ایستگاه فقط برای استفاده کنندگان %s قابل دسترسی است"

#. Not enough content
#: plugins/audioscrobbler/rb-audioscrobbler-radio-source.c:765
msgid "Not enough content to play station"
msgstr "محتویات کافی برای پخش ایستگاه وجود ندارد"

#. Deprecated station
#. Translators: %s is the name of the audioscrobbler service, for example "Last.fm".
#. * This message indicates that the service has deprecated this type of station.
#: plugins/audioscrobbler/rb-audioscrobbler-radio-source.c:770
#, c-format
msgid "%s no longer supports this type of station"
msgstr "%s دیگر از این نوع ایستگاه پشتیبانی نمی‌کند"

#. Other error
#: plugins/audioscrobbler/rb-audioscrobbler-radio-source.c:774
#, c-format
msgid "Error tuning station: %i - %s"
msgstr "خطا در تنظیم ایستگاه: %Ii - %s"

#: plugins/audioscrobbler/rb-audioscrobbler-radio-source.c:784
msgid "Error tuning station: unexpected response"
msgstr "خطا در تنظیم ایستگاه: پاسخ غیرمنتظره"

