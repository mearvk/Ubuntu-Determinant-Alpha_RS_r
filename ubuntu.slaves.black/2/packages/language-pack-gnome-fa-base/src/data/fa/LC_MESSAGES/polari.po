#. commands that would be nice to support:
#. 
#. AWAY: N_("/AWAY [<message>] — sets or unsets away message"),
#. LIST: N_("/LIST [<channel>] — lists stats on <channel>, or all channels on the server"),
#. MODE: "/MODE <mode> <nick|channel> — ",
#. NOTICE: N_("/NOTICE <nick|channel> <message> — sends notice to <nick|channel>"),
#. OP: N_("/OP <nick> — gives channel operator status to <nick>"),
#. 
#. 
#: src/ircParser.js:31
msgid ""
"/CLOSE [<channel>] [<reason>] — closes <channel>, by default the current one"
msgstr ""
"فرمان ‪/CLOSE [<کانال>] [<دلیل>]‬ — <کانال> را می‌بندد، به صورت پیش‌گزیده "
"کانال فعلی"

#: src/ircParser.js:32
msgid ""
"/HELP [<command>] — displays help for <command>, or a list of available "
"commands"
msgstr ""
"فرمان ‪/HELP [<فرمان>]‬ — راهنما را برای <فرمان> یا یک فهرست از فرمان‌های "
"موجود را نمایش می‌دهد"

#: src/ircParser.js:33
msgid ""
"/INVITE <nick> [<channel>] — invites <nick> to <channel>, or the current one"
msgstr ""
"فرمان ‪/INVITE <نام مستعار> [<channel>]‬ — <نام مستعار> را به <channel> یا "
"کانال فعلی دعوت می‌کند"

#: src/ircParser.js:34
msgid "/JOIN <channel> — joins <channel>"
msgstr "فرمان ‪/JOIN <کانال>‬ — به <کانال> ملحق می‌شوید"

#: src/ircParser.js:35
msgid "/KICK <nick> — kicks <nick> from current channel"
msgstr "فرمان /KICK <نام مستعار> — <نام مستعار> را از کانال اخراج می‌کند"

#: src/ircParser.js:36
msgid "/ME <action> — sends <action> to the current channel"
msgstr "فرمان ‪/ME <کنش>‬ — <کنش> را به کانال ارسال می‌کند"

#: src/ircParser.js:37
msgid "/MSG <nick> [<message>] — sends a private message to <nick>"
msgstr ""
"فرمان ‪/MSG <نام‌مستعار> [<پیام>]‬ — یک پیام خصوصی به <نام‌مستعار> ارسال "
"می‌کند"

#: src/ircParser.js:38
msgid "/NAMES — lists users on the current channel"
msgstr "فرمان ‪/NAMES‬ — فهرست اعضا فعلی کانال را نشان می‌دهد"

#: src/ircParser.js:39
msgid "/NICK <nickname> — sets your nick to <nickname>"
msgstr ""
"فرمان ‪/NICK <نام مستعار>‬ — نام مستعارتان را به <نام مستعار> تنظیم می‌کند"

#: src/ircParser.js:40
msgid ""
"/PART [<channel>] [<reason>] — leaves <channel>, by default the current one"
msgstr ""
"فرمان ‪/PART [<کانال>] [<دلیل>]‬ — <کانال> را ترک می‌کند، به صورت پیش‌گزیده "
"کانال کنونی"

#: src/ircParser.js:41
msgid "/QUERY <nick> — opens a private conversation with <nick>"
msgstr ""
"فرمان ‪/QUERY <نام مستعار>‬ — یک گفت‌وگو خصوصی را با <نام مستعار> باز می‌کند"

#: src/ircParser.js:42
msgid "/QUIT [<reason>] — disconnects from the current server"
msgstr "فرمان ‪/QUIT [<دلیل>]‬ — از کارساز فعلی قطع می‌شود"

#: src/ircParser.js:43
msgid "/SAY <text> — sends <text> to the current room/contact"
msgstr "فرمان ‪/SAY <متن>‬ — <متن> را به اتاق/مشترک فعلی ارسال می‌کند"

#: src/ircParser.js:44
msgid "/TOPIC <topic> — sets the topic to <topic>, or shows the current one"
msgstr ""
"فرمان ‪/TOPIC <سرفصل>‬ — سرفصل را به <سرفصل> تغییر می‌دهد یا سرفصل فعلی را "
"نمایش می‌دهد"

#: src/ircParser.js:45
msgid "/WHOIS <nick> — requests information on <nick>"
msgstr ""
"فرمان ‪/WHOIS <نام مستعار>‬ — اطّلاعات <نام مستعار> را درخواست می‌دهد"

#: src/ircParser.js:48
msgid "Unknown command — try /HELP for a list of available commands"
msgstr ""
"فرمان ناشناس — برای نمایش یک فهرست از فرمان‌های ممکن Help/ را وارد کنید"

