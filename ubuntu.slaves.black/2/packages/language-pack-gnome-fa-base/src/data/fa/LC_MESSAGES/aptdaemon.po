msgstr "بسته از کیفیت بدی برخوردار است"

#: ../aptdaemon/enums.py:506
msgid "Package file could not be opened"
msgstr "پرونده بسته باز نمی شود"

#: ../aptdaemon/enums.py:507
msgid "Not supported feature"
msgstr "ویژگی پشتیبانی نمی شود"

#: ../aptdaemon/enums.py:508
msgid "Failed to download the license key"
msgstr "بارگیری کلید گواهینامه شکست خورد"

#: ../aptdaemon/enums.py:509
msgid "Failed to install the license key"
msgstr "نصب کلید گواهینامه شکست خورد"

#: ../aptdaemon/enums.py:510
msgid "The system is already up to date"
msgstr "سیستم از قبل به‌روز است"

#: ../aptdaemon/enums.py:511
msgid "You could not be authorized"
msgstr "شما اعتبار سنجی نشده اید"

#: ../aptdaemon/enums.py:512
msgid "You are not allowed to perform this action"
msgstr "شما مجاز به انجام این عمل نیستید"

#: ../aptdaemon/enums.py:513
msgid "An unhandlable error occured"
msgstr "خطایی غیرقابل کنترل رخ داد"

# سرویس: سرویس، خدمت
