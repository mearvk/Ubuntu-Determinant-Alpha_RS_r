#, python-format
msgid "%.1f MB"
msgstr "%.1f مگابایت"

#: ../data/gtkbuilder/UpdateManager.ui.h:1
msgid "updates"
msgstr "به‌روز رسانی‌ها"

#: ../data/gtkbuilder/UpdateManager.ui.h:2
msgid "Changes"
msgstr "تغییرات"

#: ../data/gtkbuilder/UpdateManager.ui.h:3
msgid "Description"
msgstr "توضیح"

#: ../data/gtkbuilder/UpdateManager.ui.h:4
msgid "Technical description"
msgstr "توضیح فنّی"

#: ../data/gtkbuilder/UpdateManager.ui.h:5
msgid "Details of updates"
msgstr "جزییات به‌روز رسانی"

#: ../data/gtkbuilder/UpdateManager.ui.h:6
msgid "The computer will need to restart."
msgstr "رایانه نیاز به شروع دوباره خواهد داشت."

#: ../data/gtkbuilder/UpdateManager.ui.h:7
msgid ""
"You are connected via roaming and may be charged for the data consumed by "
"this update."
msgstr ""
"با رومینگ وصل هستید و ممکن است داده‌های مصرف‌شدهٔ این به‌روز رسانی، هزینه‌بر "
"باشند."

#: ../data/gtkbuilder/UpdateManager.ui.h:8
msgid ""
"You may want to wait until you’re not using a mobile broadband connection."
msgstr ""
"ممکن است بخواهید تا زمان استفاده نکردن از یک اتّصال پهن‌باند همراه، صبر کنید."

#: ../data/gtkbuilder/UpdateManager.ui.h:9
msgid "It’s safer to connect the computer to AC power before updating."
msgstr ""
"امن‌تر این است که پیش از به‌روز رسانی، رایانه را به برق متناوب وصل کنید."

#: ../data/update-manager.desktop.in.h:2
msgid "Software Updates"
msgstr "به‌روز رسانی‌های نرم‌افزاری"

#: ../data/update-manager.desktop.in.h:3
