msgstr "Gat ekki tekið frá minni til að vista BMP-skrána"

#: gdk-pixbuf/io-bmp.c:1462
#| msgid "Couldn't write to BMP file"
msgid "Couldn’t write to BMP file"
msgstr "Gat ekki skrifað í BMP-skrána"

