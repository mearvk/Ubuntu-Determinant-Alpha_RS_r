#| msgid "-%d:%02d:%02d"
msgctxt "short time format"
msgid "-%d:%02d.%03d"
msgstr "-%d:%02d.%03d"

#. minutes:seconds.msec
#. Translators: This is a time format, like "5:02" for 5
