msgstr "Nagyítás"

#: ksaneviewer.cpp:111 ksanewidget.cpp:94
#, kde-format
msgid "Zoom Out"
msgstr "Kicsinyítés"

#: ksaneviewer.cpp:114 ksanewidget.cpp:100
#, kde-format
msgid "Zoom to Selection"
msgstr "Nagyítás a kijelölt részre"

#: ksaneviewer.cpp:117 ksanewidget.cpp:106
#, kde-format
msgid "Zoom to Fit"
msgstr "Teljes méretre"

#: ksaneviewer.cpp:120 ksanewidget.cpp:112
#, kde-format
msgid "Clear Selections"
msgstr "Kijelölések törlése"

#: ksanewidget.cpp:60
#, kde-format
msgid "Waiting for the scan to start."
msgstr "Várakozás a szkenner elindulására."

#: ksanewidget.cpp:73
#, kde-format
msgid "Cancel current scan operation"
msgstr "Megszakítás"

#: ksanewidget.cpp:123
#, kde-format
msgid "Scan Preview Image (%1)"
msgstr "Előnézeti kép beolvasása (%1)"

#: ksanewidget.cpp:124
#, kde-format
msgctxt "Preview button text"
msgid "Preview"
msgstr "Előnézet"

#: ksanewidget.cpp:129
#, kde-format
msgid "Scan Final Image (%1)"
msgstr "Végleges kép beolvasása (%1)"

#: ksanewidget.cpp:130
#, kde-format
msgctxt "Final scan button text"
msgid "Scan"
msgstr "Beolvasás"

#: ksanewidget.cpp:171
#, kde-format
msgid "Basic Options"
msgstr "Alapbeállítások"

#: ksanewidget.cpp:177
#, kde-format
msgid "Advanced Options"
msgstr "Speciális beállítások"

#: ksanewidget.cpp:183
#, kde-format
msgid "Scanner Specific Options"
msgstr "Szkennekspecifikus beállítások"

#: ksanewidget.cpp:324
#, kde-format
msgid "Authentication required for resource: %1"
msgstr "Hitelesítés szükséges az erőforráshoz: %1"

#: ksanewidget.cpp:486
#, kde-format
msgid ""
"The image data contained 16 bits per color, but the color depth has been "
"truncated to 8 bits per color."
msgstr ""
"A képadatok eredetileg 16 bites színmélységűek voltak, de 8 bitesre lettek "
"alakítva."

#: ksanewidget_p.cpp:432
#, kde-format
msgid "Scan Area Size"
