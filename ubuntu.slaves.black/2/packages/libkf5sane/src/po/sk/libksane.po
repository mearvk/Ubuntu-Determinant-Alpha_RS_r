#: ../ksanetwain/ktwain_widget.cpp:36
#, kde-format
msgid "Open scan dialog"
msgstr "Otvoriť dialógové okno skenovania"

#: i18n-hplip.cpp:3
#, kde-format
msgid "None"
msgstr "Nič"

#: i18n-hplip.cpp:4
#, kde-format
msgid "MH"
msgstr "MH"

#: i18n-hplip.cpp:5
#, kde-format
msgid "MR"
msgstr "MR"

#: i18n-hplip.cpp:6
#, kde-format
msgid "MMR"
msgstr "MMR"

#: i18n-hplip.cpp:7
#, kde-format
msgid "JPEG"
msgstr "JPEG"

#: i18n-hplip.cpp:8
#, kde-format
msgid "Auto"
msgstr "Auto"

#: i18n-hplip.cpp:9
#, kde-format
msgid "Flatbed"
msgstr "Plochý"

#: i18n-hplip.cpp:10
#, kde-format
msgid "ADF"
msgstr "ADF"

#: i18n-hplip.cpp:11
#, kde-format
msgid "Advanced"
msgstr "Rozšírené"

#: i18n-hplip.cpp:12
#, kde-format
msgid "Compression"
msgstr "Kompresia"

#: i18n-hplip.cpp:13
#, kde-format
msgid ""
"Selects the scanner compression method for faster scans, possibly at the "
"expense of image quality."
msgstr ""
"Zvolí kompresnú metódu skenera na rýchlejšie skenovanie, možno na úkor "
"kvality obrazu."

#: i18n-hplip.cpp:15
#, kde-format
msgid "JPEG compression factor"
msgstr "Kompresný pomer JPEG"

#: i18n-hplip.cpp:16
#, kde-format
msgid ""
"Sets the scanner JPEG compression factor. Larger numbers mean better "
"compression, and smaller numbers mean better image quality."
msgstr ""
"Nastaví kompresný pomer JPEG skenera. Väčšie číslo znamená lepšiu kompresiu "
"a malé číslo znamená lepšiu kvalitu obrazu."

#: i18n-hplip.cpp:19
#, kde-format
msgid "Batch scan"
msgstr "Dávkové skenovanie"

#: i18n-hplip.cpp:20
#, kde-format
msgid "Enables continuous scanning with automatic document feeder (ADF)."
msgstr "Povolí súvislé skenovanie s automatickým podávačom dokumentov (ADF)."

#: i18n-hplip.cpp:21
#, kde-format
msgid "Duplex"
msgstr "Duplex"

#: i18n-hplip.cpp:22
#, kde-format
msgid "Enables scanning on both sides of the page."
msgstr "Povolí skenovanie oboch strán stránky."

#: i18n-hplip.cpp:23
#, kde-format
msgid "Geometry"
msgstr "Geometria"

#: i18n-hplip.cpp:24
#, kde-format
msgid "Length measurement"
msgstr "Meranie dĺžky"

#: i18n-hplip.cpp:25
#, kde-format
msgid ""
"Selects how the scanned image length is measured and reported, which is "
"impossible to know in advance for scrollfed scans."
msgstr ""
"Zvolí ako sa meria a oznamuje veľksť skenovaného obrazu, ktorú nie je možné "
"vedieť dopresu pre posuvné skeny."

#: i18n-hplip.cpp:27
#, kde-format
msgid "Unknown"
msgstr "neznáme"

#: i18n-hplip.cpp:28
#, kde-format
msgid "Unlimited"
msgstr "Bez obmedzenia"

#: i18n-hplip.cpp:29
#, kde-format
msgid "Approximate"
msgstr "Približné"

#: i18n-hplip.cpp:30
#, kde-format
msgid "Padded"
msgstr "Vypchatý"

#: i18n-hplip.cpp:31
#, kde-format
msgid "Exact"
msgstr "Presné"

#: i18n-hplip.cpp:32
#, kde-format
msgid "???"
msgstr "???"

#: ksanecore.cpp:223
#, kde-format
msgid "Scanning stopped by user."
msgstr "Skenovanie bolo zastavené používateľom."

#: ksanedevicedialog.cpp:38
#, kde-format
msgid ""
"<html>The SANE (Scanner Access Now Easy) system could not find any device."
"<br>Check that the scanner is plugged in and turned on<br>or check your "
"systems scanner setup.<br>For details about SANE see the <a href='http://www."
"sane-project.org/'>SANE homepage</a>.</html>"
msgstr ""
"<html>Systém SANE (Scanner Access Now Easy) nenašiel žiadne zariadenie."
"<br>Skontrolujte, že skener je pripojený a zapnutý<br>alebo "
"skontrolujtenastavenia vašich skenerov.<br>Pre viac informácií o SANE "
"pozrite <a href='http://www.sane-project.org/'>stránku SANE</a>.</html>"

#: ksanedevicedialog.cpp:60
#, kde-format
msgid "Reload devices list"
msgstr "Znovu načítať zoznam zariadení"

#: ksanedevicedialog.cpp:84
#, kde-format
msgid "Looking for devices. Please wait."
msgstr "Vyhľadávajú sa zariadenia. Prosím, čakajte."

#: ksanedevicedialog.cpp:119
#, kde-format
msgid "Sorry. No devices found."
msgstr "Prepáčte, nenašli sa žiadne zariadenia."

#: ksanedevicedialog.cpp:129
#, kde-format
msgid "Found devices:"
msgstr "Nájdené zariadenia:"

#: ksaneviewer.cpp:108 ksanewidget.cpp:88
#, kde-format
msgid "Zoom In"
msgstr "Priblížiť"

#: ksaneviewer.cpp:111 ksanewidget.cpp:94
#, kde-format
msgid "Zoom Out"
msgstr "Oddialiť"

#: ksaneviewer.cpp:114 ksanewidget.cpp:100
#, kde-format
msgid "Zoom to Selection"
msgstr "Priblížiť na výber"

#: ksaneviewer.cpp:117 ksanewidget.cpp:106
#, kde-format
msgid "Zoom to Fit"
msgstr "Prispôsobiť priblíženie"

#: ksaneviewer.cpp:120 ksanewidget.cpp:112
#, kde-format
msgid "Clear Selections"
msgstr "Vymazať výbery"

#: ksanewidget.cpp:60
#, kde-format
msgid "Waiting for the scan to start."
msgstr "Čaká sa na spustenie skenovania."

#: ksanewidget.cpp:73
#, kde-format
msgid "Cancel current scan operation"
msgstr "Zrušiť aktuálnu operáciu skenovania"

#: ksanewidget.cpp:123
#, kde-format
msgid "Scan Preview Image (%1)"
msgstr "Naskenovať náhľad obrázku (%1)"

#: ksanewidget.cpp:124
#, kde-format
msgctxt "Preview button text"
msgid "Preview"
msgstr "Náhľad"

#: ksanewidget.cpp:129
#, kde-format
msgid "Scan Final Image (%1)"
msgstr "Naskenovať finálny obrázok (%1)"

#: ksanewidget.cpp:130
#, kde-format
msgctxt "Final scan button text"
msgid "Scan"
msgstr "Skenovať"

#: ksanewidget.cpp:171
#, kde-format
msgid "Basic Options"
msgstr "Základné nastavenia"

#: ksanewidget.cpp:177
#, kde-format
msgid "Advanced Options"
msgstr "Pokročilé voľby"

#: ksanewidget.cpp:183
#, kde-format
msgid "Scanner Specific Options"
msgstr "Voľby špecifikované skenerom"

#: ksanewidget.cpp:324
#, kde-format
msgid "Authentication required for resource: %1"
msgstr "Vyžaduje sa overenie totožnosti pre prostriedok: %1"

#: ksanewidget.cpp:486
#, kde-format
msgid ""
"The image data contained 16 bits per color, but the color depth has been "
"truncated to 8 bits per color."
msgstr ""
"Obrazové dáta obsahujú 16 bitov na farbu, ale farebná hĺbka bola orezaná na "
"8 bitov na farbu."

#: ksanewidget_p.cpp:432
#, kde-format
msgid "Scan Area Size"
msgstr "Veľkosť oblasti skenovania"

#: ksanewidget_p.cpp:437
#, kde-format
msgid " mm"
msgstr " mm"

#: ksanewidget_p.cpp:437
#, kde-format
msgid " inch"
msgstr " palec"

#: ksanewidget_p.cpp:439
#, kde-format
msgid "Width"
msgstr "Šírka"

#: ksanewidget_p.cpp:444
#, kde-format
msgid "Height"
msgstr "Výška"

#: ksanewidget_p.cpp:449
#, kde-format
msgid "X Offset"
msgstr "Posun na osi X"

#: ksanewidget_p.cpp:454
#, kde-format
msgid "Y Offset"
msgstr "Posun na osi Y"

#: ksanewidget_p.cpp:515
#, kde-format
msgid "Image intensity"
msgstr "Hustota obrázka"

#: ksanewidget_p.cpp:519
#, kde-format
msgid ""
"Gamma-correction table. In color mode this option equally affects the red, "
"green, and blue channels simultaneously (i.e., it is an intensity gamma "
"table)."
msgstr ""
"Tabuľka korekcie gamy. Vo farebnom režime táto možnosť rovnako ovplyvňuje "
"červený, zelený a modrý kanál súčasne (t.j. Je to tabuľka intenzity gamy)."

#: ksanewidget_p.cpp:527
#, kde-format
msgid "Separate color intensity tables"
msgstr "Oddeliť tabuľky intenzity farieb"

#: ksanewidget_p.cpp:1211
#, kde-format
msgctxt "This is compared to the option string returned by sane"
msgid "Transparency"
msgstr "Priehľadnosť"

#: ksanewidget_p.cpp:1213
#, kde-format
msgctxt "This is compared to the option string returned by sane"
msgid "Negative"
msgstr "Negatív"

#: ksanewidget_p.cpp:1260
#, kde-format
msgid "Next scan starts in %1 s."
msgstr "Ďalšie skenovanie začne o %1 s."

#: ksanewidget_p.cpp:1273
#, kde-format
msgctxt "@title:window"
msgid "General Error"
msgstr "Všeobecná chyba"

#: ksanewidget_p.cpp:1276
#, kde-format
msgctxt "@title:window"
msgid "Information"
msgstr "Informácie"

#: ksanewidget_p.cpp:1358
#, kde-format
msgid "Custom"
msgstr "Vlastný"

#: ksanewidget_p.cpp:1383
#, kde-format
msgctxt "Page size landscape"
msgid " Landscape"
msgstr " Landscape"

#: options/ksanebatchdelayoption.cpp:32
#, kde-format
msgid "Batch mode time delay"
msgstr "Časové oneskorenie hromadného režimu"

#: options/ksanebatchdelayoption.cpp:37
#, kde-format
msgid "Specify the time delay between each scan when batch mode is enabled."
msgstr ""
"Určte časové oneskorenie medzi každým skenovaním, keď je povolený hromadný "
"režim."

#: options/ksanebatchmodeoption.cpp:33
#, kde-format
msgid "Batch mode with time delay"
msgstr "Hromadný režim s časovým oneskorením"

#: options/ksanebatchmodeoption.cpp:38
#, kde-format
msgid ""
"Enables batch mode scanning. Continues scanning after a delay until canceled."
msgstr ""
"Povolí režim hromadného skenovania. Skenovanie pokračuje po oneskorení, až "
"kým sa nezruší."

#: options/ksaneinvertoption.cpp:60
#, kde-format
msgid "Invert colors"
msgstr "Invertovať farby"

#: options/ksaneinvertoption.cpp:65
#, kde-format
msgid "Invert the colors of the scanned image."
msgstr "Invertovať farby naskenovaného obrázka."

#: options/ksanepagesizeoption.cpp:99
#, kde-format
msgctxt "Page size landscape"
msgid "Landscape %1"
msgstr "Landscape %1"

#: options/ksanepagesizeoption.cpp:174
#, kde-format
msgid "Scan area size"
msgstr "Veľkosť oblasti skenovania"

#: options/ksanepagesizeoption.cpp:179
#, kde-format
msgid "Select a predefined page size for the scanning area."
msgstr "Vyberte preddefinovanú veľkosť strany pre oblasť skenovania."

