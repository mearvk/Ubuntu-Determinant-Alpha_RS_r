#, c-format
msgid ""
"Conflicting options are present: workspace %d should be interacted with, but "
"--%s has been used\n"
msgstr "같이 사용할 수 없는 옵션을 같이 사용했습니다: 작업 공간 %d번과 통신하지만, --%s 옵션을 사용했습니다\n"

#: libwnck/wnckprop.c:543
#, c-format
