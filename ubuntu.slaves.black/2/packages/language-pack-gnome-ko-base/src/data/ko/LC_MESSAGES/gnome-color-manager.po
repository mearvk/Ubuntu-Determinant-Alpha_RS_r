msgstr "모든 파일의 디버깅 정보 표시"

#: src/gcm-debug.c:128
msgid "Debugging Options"
msgstr "디버깅 옵션"

#: src/gcm-debug.c:128
msgid "Show debugging options"
msgstr "디버깅 옵션 표시"

