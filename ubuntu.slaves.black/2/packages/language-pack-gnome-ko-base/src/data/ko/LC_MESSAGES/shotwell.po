#: data/org.gnome.Shotwell-Viewer.desktop.in:5 src/Resources.vala:10
msgid "Photo Viewer"
msgstr "사진 보기"

#: misc/org.yorba.shotwell-extras.gschema.xml:6
msgid "authentication token"
msgstr "인증 토큰"

#: misc/org.yorba.shotwell-extras.gschema.xml:7
