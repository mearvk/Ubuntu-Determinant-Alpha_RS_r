msgid "Apply glossy effect."
msgstr "번들거리는 효과 적용."

#: Settings.ui.h:21
msgid "Use dominant color"
msgstr "도미넌트 색상 사용"

#: Settings.ui.h:22
msgid "Customize indicator style"
msgstr "인디게이터 스타일 사용자 정의"

#: Settings.ui.h:23
msgid "Color"
msgstr "색상"

#: Settings.ui.h:24
msgid "Border color"
