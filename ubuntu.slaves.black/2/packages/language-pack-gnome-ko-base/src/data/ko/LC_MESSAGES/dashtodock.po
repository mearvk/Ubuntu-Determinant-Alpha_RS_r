#: Settings.ui.h:25
msgid "Border width"
msgstr "테두리 두께"

#: Settings.ui.h:26
msgid "Show the dock on"
msgstr "독 표시하기"

#: Settings.ui.h:25
msgid "Show on all monitors."
msgstr "모든 모니터 보이기."

#: Settings.ui.h:28
msgid "Position on screen"
msgstr "화면 상 위치"

#: Settings.ui.h:30
msgid "Bottom"
msgstr "하단"

#: Settings.ui.h:31
msgid "Top"
msgstr "상단"

#: Settings.ui.h:33
msgid ""
"Hide the dock when it obstructs a window of the current application. More "
"refined settings are available."
msgstr "현재 응용 프로그램의 창을 막을 때 독을 숨깁니다. 보다 세련된 설정을 사용할 수 있습니다."

#: Settings.ui.h:34
msgid "Intelligent autohide"
msgstr "지능적 자동숨김"

#: Settings.ui.h:35
msgid "Dock size limit"
msgstr "독 크기 제한"

