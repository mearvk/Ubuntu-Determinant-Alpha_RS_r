use Test::More tests => 1;
use strict; 
use File::Slurp;
my $fn="/tmp/utf8.txt";

my $data="hallo grüezi blödel schaß und aus.\n";
open F,">$fn";
binmode(F, ":utf8");
print F $data;
close F;

my $x=read_file($fn,binmode=>":utf8");
ok($x eq $data,"utf8 encoded data survives slurp");
unlink($fn);





