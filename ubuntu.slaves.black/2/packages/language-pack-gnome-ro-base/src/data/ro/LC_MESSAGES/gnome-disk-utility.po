"disk;drive;volume;harddisk;hdd;disc;cdrom;dvd;partition;iso;image;backup;rest"
"ore;benchmark;raid;luks;encryption;S.M.A.R.T.;smart;"
msgstr ""
"disk;drive;volume;harddisk;hdd;disc;cdrom;dvd;partition;iso;image;backup;rest"
"ore;benchmark;raid;luks;encryption;S.M.A.R.T.;smart;unitate;hard "
"disc;partiție;imagine;copie;rezervă;copie de "
"rezervă;restaurează;restaurare;test;performanță;test de "
"performanță;criptare;inteligent;"

