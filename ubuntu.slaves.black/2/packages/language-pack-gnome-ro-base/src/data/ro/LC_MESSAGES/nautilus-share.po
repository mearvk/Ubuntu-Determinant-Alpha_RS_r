#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"Pentru a partaja dosarul „%s”, Nautilus trebuie să îi modifice drepturile"

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"Pentru ca partajarea să funcționeze, dosarul „%s” necesită următoarele "
"drepturi:\n"
"%s%s%sDoriți ca Nautilus să adauge automat aceste drepturi dosarului?"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - citire pentru alți utilizatori\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - scriere pentru alți utilizatori\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - execuție pentru alți utilizatori\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "Adăugă drepturile automat"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "Nu s-au putut modifica drepturile pentru „%s”"

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "Numele pentru partajare este prea lung"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "Numele pentru partajare nu poate să fie gol"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr "Eroare la obținerea informației de partajare: %s"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "Există deja un dosar partajat cu aceste nume"

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "Modificare _partajare"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "Creare _partajare"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "Intalarea serviciului de partajare a eșuat"

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr ""
"Intalarea serviciului de partajare a eșuat. Doriți să reîncercați instalarea?"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "Reîncearcă"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "Serviciul de partajare nu este instalat"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"Pentru a partaja dosarele trebuie să instalaţi serviciul de partajare în "
"reţelele Windows."

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "Instalează serviciu"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr "S-a produs o eroare la obținerea informației despre partajare"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "Partajare rețea locală"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "Partajare dosar"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "Partajați acest dosar"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "%s %s %s a ieșit cu semnalul %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s a eșuat dintr-un motiv necunoscut"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "„net usershare” a întors eroarea %d: %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "„net usershare” a întors eroarea  %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "ieșirea lui „net usershare” nu este într-un cod valid UTF-8"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "Eșuat"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "testparm de la Samba a ieșit cu semnalul %d"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "testparm de la Samba a eșuat dintr-un motiv necunoscut"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "testparm de la Samba a eșuat cu eroarea %d: %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "testparm de la Samba a eșuat cu eroarea %d"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr ""
"Nu s-a putut șterge partajarea pentru calea %s: calea nu este partajată"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"Nu s-a putut șterge calea pentru o partajare existentă. Ștergeți vechea "
"partajare și adăugați una nouă"

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>Partajare dosar</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "_Nume partajat:"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "Partajați acest _dosar"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "Co_mentariu:"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr "Permiteți _altora să creeze și să șteargă fișiere în acest dosar"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr "Acces _oaspeți (pentru cei fără un cont de utilizator)"
