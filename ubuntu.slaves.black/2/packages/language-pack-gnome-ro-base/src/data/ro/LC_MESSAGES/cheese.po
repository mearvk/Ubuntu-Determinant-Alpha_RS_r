msgstr "photo;video;webcam;camera;selfie;foto;cameră web;poze;"

#: data/org.gnome.Cheese.gschema.xml:5
msgid "Use a countdown"
msgstr "Utilizează un temporizator"

#: data/org.gnome.Cheese.gschema.xml:6
