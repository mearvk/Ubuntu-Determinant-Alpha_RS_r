msgstr "བསྣར་ཏེ་ཡོད་པའི་བྱ་བ་ཚུ་ཆ་མེད་གཏང་།(^e)"

#: src/ui.cc:2554
msgid "Cancel all pending actions from this session"
msgstr ""

#: src/ui.cc:2557
msgid "^Clean package cache"
msgstr "ཐུམ་སྒྲིལ་འདྲ་མཛོད་དེ་གཙང་དག་བཟོ། (^C)"

#: src/ui.cc:2561
msgid "Clean ^obsolete files"
msgstr "ཕན་ཡིག་སྣོད་ཚུ་གཙང་དག་བཟོ། (^o)"

#: src/ui.cc:2568
msgid "^Reload package cache"
msgstr "ཐུམ་སྒྲིལ་འདྲ་མཛོད་དེ་ཡང་བསྐྱར་མངོན་གསལ་འབད།(^R)"

#: src/ui.cc:2573
msgid "^Play Minesweeper"
msgstr "འགས་རྫས་འཕྱག་མི་གཏང་། (^P)"

#: src/ui.cc:2578
msgid "^Become root"
msgstr "རྩ་བ་ལུ་འགྱུར་འོང་། (^B)"

#: src/ui.cc:2581
msgid "^Quit"
msgstr "སྤང་།(^Q)"

#: src/ui.cc:2588 src/ui.cc:2977
msgid "Undo"
msgstr "འབད་བཤོལ།"

#: src/ui.cc:2597
msgid "^Install"
msgstr "གཞི་བཙུགས།(^I)"

#: src/ui.cc:2598
msgid "Flag the currently selected package for installation or upgrade"
msgstr ""
"གཞི་བཙུགས་དང་ཡར་བསྐྱེད་འབད་ནིའི་དོན་ལུ་ "
"ད་ལྟོ་སེལ་འཐུ་འབད་ཡོའ་པའི་ཐུམ་སྒྲིལ་དེ་ལུ་ཟུར་རྟགས་བཀོད།"

#: src/ui.cc:2601
msgid "R^einstall"
msgstr ""

#: src/ui.cc:2602
msgid "Flag the currently selected package for reinstallation"
msgstr ""

#: src/ui.cc:2605
msgid "^Remove"
msgstr "རྩ་བསྐྲད། (^R)"

#: src/ui.cc:2606
msgid "Flag the currently selected package for removal"
msgstr ""
"རྩ་བསྐྲད་གཏང་ནིའི་དོན་ལུ་ "
"ད་ལྟོ་སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་དེ་ལུ་ཟུར་རྟགས་བཀོད།"

#: src/ui.cc:2609
msgid "^Purge"
msgstr "ཕྱིར་བསྐྲད། (^P)"

#: src/ui.cc:2610
msgid ""
"Flag the currently selected package and its configuration files for removal"
msgstr ""
"རྩ་བསྐྲད་གཏང་ནིའི་དོན་ལུ་ད་ལྟོ་སེལ་འཐུ་འབད་ཡོད་མི་ཐུམ་སྒྲིལ་དང་ "
"དེའི་རིམ་སྒྲིག་ཡིག་སྣོད་དེ་ལུ་ ཟུར་རྟགས་བཀོད།"

#: src/ui.cc:2613
msgid "^Keep"
msgstr "བཞག(^K)"

#: src/ui.cc:2614
msgid "Cancel any action on the selected package"
msgstr "བྱ་བ་ག་འབད་རུང་ཅིག་སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་གུར་ཆ་མེད་གཏང་།"

#: src/ui.cc:2617
msgid "^Hold"
msgstr "འཆང། (^H)"

#: src/ui.cc:2618
msgid ""
"Cancel any action on the selected package, and protect it from future "
"upgrades"
msgstr ""
"བྱ་བ་ག་འབད་རུང་ཅིག་སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་གུར་ཆ་མེད་གཏང་ཞིནམ་ལས་ "
"འ་ནི་དེ་མ་འོངས་པ་ལུ་ཡར་བསྐྱེད་འབད་ནི་ལས་ཉེན་སྐྱོབ་འབད།"

#: src/ui.cc:2621
msgid "Mark ^Auto"
msgstr "རང་བཞིན་ལུ་རྟགས་བཀལ། (^A)"

#: src/ui.cc:2622
msgid ""
"Mark the selected package as having been automatically installed; it will "
"automatically be removed if no other packages depend on it"
msgstr ""
"སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་ཚུ་རང་བཞིན་གྱིས་ཐོག་ལས་གཞི་བཙུགས་འབད་ཡོདཔ་བཟུམ་"
"སྦེ་རྟགས་བཀལ། ཐུམ་སྒྲིལ་གཞན་མི་ཚུ་གིས་དེ་ལུ་མ་བརྟེན་པ་ཅིན་ "
"འ་ནི་དེ་རང་བཞིན་གྱིས་རྩ་བསྐྲད་གཏང་འོང་།"

#: src/ui.cc:2625
msgid "Mark ^Manual"
msgstr "ལག་དེབ་ལུ་རྟགས་བཀལ།(^M)"

#: src/ui.cc:2626
msgid ""
"Mark the selected package as having been manually installed; it will not be "
"removed unless you manually remove it"
msgstr ""
"སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་ཚུ་ལག་ཐོག་ལས་གཞི་བཙུགས་འབད་དེ་ཡོད་དོ་བཟུམ་སྦེ་ར"
"ྟགས་བཀལ། ཁྱོད་ཀྱིས་ལག་ཐོག་ལས་རྩ་བསྐྲད་མ་གཏང་ཚུན་ཚོད་ དེ་གིས་རྩ་བསྐྲད་མི་འགྱོ།"

#: src/ui.cc:2629
msgid "^Forbid Version"
msgstr "ཐོན་རིམ་མ་ཆོགཔ་བཟོ།(^F)"

#: src/ui.cc:2630
msgid ""
"Forbid the candidate version of the selected package from being installed; "
"newer versions of the package will be installed as usual"
msgstr ""
"སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་ཚུ་གིས་མི་ངོའི་ཐོན་རིམ་དེ་གཞི་བཙུགས་འབད་ནི་ལས་མ"
"་ཆོགཔ་བཟོ། "
"ཐུམ་སྒྲིལ་དེ་གི་ཐོན་རིམ་གསརཔ་ཚུ་ཨ་རྟག་བཟུམ་སྦེ་གཞི་བཙུགས་འབད་ནི་ཨིན།"

#: src/ui.cc:2634
msgid "I^nformation"
msgstr "བརྡ་དོན།(^n)"

#: src/ui.cc:2635
msgid "Display more information about the selected package"
msgstr ""
"སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་དེ་གི་སྐོར་ལས་བརྡ་དོན་ཧེང་བཀལ་བཀྲམ་སྟོན་འབད།"

#: src/ui.cc:2638
msgid "C^ycle Package Information"
msgstr ""

#: src/ui.cc:2639
msgid ""
"Cycle through the modes of the package information area: it can show the "
"package's long description, a summary of its dependency status, or an "
"analysis of why the package is required."
msgstr ""

#: src/ui.cc:2642
msgid "^Changelog"
msgstr "བསྒྱུར་བཅོས་དྲན་དེབ། (^C)"

#: src/ui.cc:2643
msgid "Display the Debian changelog of the selected package"
msgstr ""
"སེལ་འཐུ་འབད་ཡོད་པའི་ཐུམ་སྒྲིལ་དེ་གི་ཌེ་བི་ཡཱན་བསྒྱུར་བཅོས་དྲན་དེབ་བཀྲམ་སྟོན་འ"
"བད།"

#: src/ui.cc:2650
msgid "^Examine Solution"
msgstr "ཐབས་ཤེས་བརྟག་དཔྱད་འབད།"

#: src/ui.cc:2651
msgid "Examine the currently selected solution to the dependency problems."
msgstr ""
"ད་ལྟོ་སེལ་འཐུ་འབད་ཡོད་པའི་ཐབས་ཤེས་དེ་རྟེན་འབྲེལ་གྱི་དཀའ་ངལ་དེ་ལུ་བརྟག་དཔྱད་འབ"
"ད།"

#: src/ui.cc:2654
msgid "Apply ^Solution"
msgstr "ཐབས་ཤེས་འཇུག་སྤྱོད་འབད།"

#: src/ui.cc:2655
msgid "Perform the actions contained in the currently selected solution."
msgstr ""
"ད་ལྟོ་སེལ་འཐུ་འབད་ཡོད་པའི་ཐབས་ཤེས་ཚུ་ནང་ལུ་ཡོད་པའི་བྱ་བ་ཚུ་ལག་ལེན་འཐབ།"

#: src/ui.cc:2658
msgid "^Next Solution"
msgstr "ཤུལ་མམ་གྱི་ཐབས་ལམ། (^N)"

#: src/ui.cc:2659
msgid "Select the next solution to the dependency problems."
msgstr "ཤུལ་མམ་གྱི་ཐབས་ཤེས་དེ་རྟེན་འབྲེལ་གྱི་དཀའ་ངལ་དེ་ལུ་སེལ་འཐུ་འབད།"

#: src/ui.cc:2662
msgid "^Previous Solution"
msgstr "ཧེ་མམ་གྱི་་ཐབས་ཤེས། (^P)"

#: src/ui.cc:2663
msgid "Select the previous solution to the dependency problems."
msgstr "ཧེ་མམ་གྱི་ཐབས་ཤེས་དེ་རྟེན་འབྲེལ་གྱི་དཀའ་ངལ་དེ་ལུ་སེལ་འཐུ་འབད།"

#: src/ui.cc:2666
msgid "^First Solution"
msgstr "ཐབས་དང་པ། (^F)"

#: src/ui.cc:2667
msgid "Select the first solution to the dependency problems."
msgstr "ཐབས་ཤེས་དང་པམ་དེ་རྟེན་འབྲེལ་གྱི་དཀའ་ངལ་དེ་ལུ་སེལ་འཐུ་འབད།"

#: src/ui.cc:2670
msgid "^Last Solution"
msgstr "མཇུག་གི་ཐབས་ཤེས།"

#: src/ui.cc:2671
msgid ""
"Select the last solution to the dependency problems that has been generated "
"so far."
msgstr ""
"མཇུག་གི་སེལ་འཐུ་དེ་ད་ལྟོ་ཚུན་ཚོད་བཟོ་བཏོན་འབད་ཡོད་པའི་རྟེན་འབྲེལ་གྱི་དཀའ་ངལ་ད"
"ེ་ལུ་སེལ་འཐུ་འབད།"

#: src/ui.cc:2677
msgid "Toggle ^Rejected"
msgstr "སོར་སྟོན་སྣང་མེད་སྦེ་བཞག་ཡོདཔ།(^R)"

#: src/ui.cc:2678
msgid "Toggle whether the currently selected action is rejected."
msgstr ""
"ད་ལྟོ་སེལ་འཐུ་འབཐ་ཡོད་པའི་བྱ་བ་དེ་སྣང་མེད་སྦེ་བཞག་སྟེ་ཡོད་དང་མེད་སོར་སྟོན་འབད"
"།"

#: src/ui.cc:2682
msgid "Toggle ^Approved"
msgstr "སོར་སྟོན་གནང་བ་གྲོལ་ཡོདཔ། (^A)"

#: src/ui.cc:2683
msgid "Toggle whether the currently selected action is approved."
msgstr ""
"ད་ལྟོ་སེལ་འཐུ་འབད་ཡོད་པའི་བྱ་བ་དེ་གི་གནང་བ་གྲོལ་ཡོད་དང་མེད་སོར་སྟོན་འབད།"

#: src/ui.cc:2687
msgid "^View Target"
msgstr "དམིགས་གཏད་སྟོན། (^V)"

#: src/ui.cc:2688
msgid "View the package which will be affected by the selected action"
msgstr ""
"ཐུམ་སྒྲིལ་ག་དེ་ལུ་སེལ་འཐུ་འབད་ཡོད་པའི་བྱ་བ་གིས་གནོད་སྐྱོན་འབྱུང་ནི་ཨིན་པས་ག་ས"
"ྟོན།"

#: src/ui.cc:2694
msgid "Reject Breaking ^Holds"
msgstr ""

#: src/ui.cc:2696
msgid ""
"Reject all actions that would change the state of held packages or install "
"forbidden versions"
msgstr ""

#: src/ui.cc:2704
msgid "^Find"
msgstr "འཚོལ།(^F)"

#: src/ui.cc:2705
msgid "Search forwards"
msgstr "གདོང་བསྐྱོད་འབད་དེ་འཚོལ་ཞིབ་འབད།"

#: src/ui.cc:2708
msgid "^Find Backwards"
msgstr "རྒྱབ་བསྐྱོད་དེ་འཚོལ། (^F)"

#: src/ui.cc:2709
msgid "Search backwards"
msgstr "རྒྱབ་བསྐྱོད་འབད་དེ་ཚའོལ་ཞིབ་འབད།"

#: src/ui.cc:2712
msgid "Find ^Again"
msgstr "ལོག་སྟེ་འཚོལ།(^A)"

#: src/ui.cc:2713
msgid "Repeat the last search"
msgstr "མཇུག་གི་འཚོལ་ཞིབ་འབད་ཡོད་མི་དེ་ཡང་བསྐྱར་འབད།"

#: src/ui.cc:2716
msgid "Find Again ^Backwards"
msgstr "རྒྱབ་བསྐྱོད་དེ་ལོག་འཚོལ། (^B)"

#: src/ui.cc:2717
msgid "Repeat the last search in the opposite direction"
msgstr "མཇུག་གི་འཚོལ་ཞིབ་འབད་ཡོད་མི་དེ་རྒྱབ་འགལ་ཕྱོགས་སུ་་ཡང་བསྐྱར་འབད།"

#: src/ui.cc:2721
msgid "^Limit Display"
msgstr "བཀྲམ་སྟོན་འབད་ནི་ལུ་་ཚད་བཀལ།(^L)"

#: src/ui.cc:2722
msgid "Apply a filter to the package list"
msgstr "ཐུམ་སྒྲིལ་ཐོ་ཡིག་དེ་ལུ་ཚགས་མ་ཅིག་འཇུག་སྤྱོད་འབད།"

#: src/ui.cc:2725
msgid "^Un-Limit Display"
msgstr "བཀྲམ་སྟོན་འབད་ནི་ལུ་ཚད་བཤོལ་འབད།"

#: src/ui.cc:2726
