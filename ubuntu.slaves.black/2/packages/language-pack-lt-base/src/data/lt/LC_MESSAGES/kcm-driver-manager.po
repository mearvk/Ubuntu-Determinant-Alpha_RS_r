#: Module.cpp:77
msgctxt "@title/rich"
msgid "<title>Your computer requires no proprietary drivers</title>"
msgstr ""
"<title>Jūsų kompiuteris nereikalauja jokių nuosavybinių tvarkyklių</title>"

#: Module.cpp:130
msgctxt ""
"The backend is trying to figure out what drivers are suitable for the users "
"system"
msgid "Collecting information about your system"
msgstr "Renkama informacija apie jūsų sistemą"

#: Module.cpp:220 DriverManager.cpp:248
msgctxt "@label"
msgid ""
"The package system could not be initialized, your configuration may be "
"broken."
msgstr ""
"Nepavyko inicijuoti paketų sistemos, jūsų konfigūracija gali būti sugadinta."

#: Module.cpp:232
msgctxt "The backend replied with a error"
msgid ""
"Something went terribly wrong. Please hit the 'Refresh Driver List' button"
msgstr ""
"Nutiko kažkas baisaus. Prašome spustelėti mygtuką \"Iš naujo įkelti "
"tvarkyklių sąraša\""

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr " ,Launchpad Contributions:,Moo"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ",,hazap@hotmail.com"

