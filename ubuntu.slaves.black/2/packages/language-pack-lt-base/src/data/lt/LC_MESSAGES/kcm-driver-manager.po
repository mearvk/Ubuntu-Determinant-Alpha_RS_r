#: DriverWidget.cpp:45
#, kde-format
msgctxt "@info %1 is hardware vendor, %2 is hardware model"
msgid "<title>%1 %2</title>"
msgstr "<title>%1 %2</title>"

#: DriverWidget.cpp:79
#, kde-format
msgctxt "Manually installed 3rd party driver"
msgid "This device is using a manually-installed driver : (%1)"
msgstr "Šis įrenginys naudoja rankiniu būdu įdiegtą tvarkyklę : (%1)"

#: DriverWidget.cpp:86
#, kde-format
msgctxt ""
"%1 is description and %2 is package name; when driver is recommended for use"
msgid "Using %1 from %2 (Recommended Driver)"
msgstr "Naudojama %1 iš %2 (Rekomenduojama tvarkyklė)"

#: DriverWidget.cpp:91
#, kde-format
msgctxt "%1 is description and %2 is package name"
msgid "Using %1 from %2"
msgstr "Naudojama %1 iš %2"

#: DriverWidget.cpp:98
msgctxt "The driver is under a open source license"
msgid "Open Source Driver"
msgstr "Atvirosios programinės įrangos tvarkyklė"

#: DriverWidget.cpp:101
msgctxt "The driver is under a proprietary license"
msgid "Proprietary Driver"
msgstr "Nuosavybinė tvarkyklė"

#: DriverManager.cpp:253
msgctxt "@label"
msgid ""
"Another application seems to be using the package system at this time. You "
"must close all other package managers before you will be able to install or "
"remove any packages."
msgstr ""
"Atrodo, kad šiuo metu kita programa naudoja paketų sistemą. Prieš tai, kai "
"galėsite įdiegti ar šalinti paketus, privalote užverti visas kitas paketų "
"tvarkytuves."

#: DriverManager.cpp:260
#, kde-format
msgctxt "@label"
msgid ""
"You do not have enough disk space in the directory at %1 to continue with "
"this operation."
msgstr ""
"Jūs neturite pakankamai disko vietos kataloge %1, kad tęstumėte šią "
"operaciją."

#: DriverManager.cpp:266
msgctxt "@label"
msgid "Could not download packages"
msgstr "Nepavyko atsisiųsti paketų"

#: DriverManager.cpp:269
msgctxt "@label"
msgid "An error occurred while applying changes:"
msgstr "Pritaikant pakeitimus, įvyko klaida:"

#: DriverManager.cpp:273
msgctxt "@label"
msgid ""
"This operation cannot continue since proper authorization was not provided"
msgstr ""
"Ši operacija negali tęsti, kadangi nebuvo pateikti tinkami prieigos teisių "
"leidimai"

#: DriverManager.cpp:277
msgctxt "@label"
msgid ""
"It appears that the QApt worker has either crashed or disappeared. Please "
"report a bug to the QApt maintainers"
msgstr ""
"Atrodo, kad QApt darbuotojas arba užstrigo, arba dingo. Prašome pranešti "
"apie klaidą QApt prižiūrėtojams"

#: DriverManager.cpp:285
msgctxt "@label"
msgid ""
"The following package has not been verified by its author. Downloading "
"untrusted packages has been disallowed by your current configuration."
msgid_plural ""
"The following packages have not been verified by their authors. Downloading "
"untrusted packages has been disallowed by your current configuration."
msgstr[0] ""
"Šis paketas nebuvo patvirtintas jo autoriaus. Nepatvirtintų paketų "
"atsiuntimas pagal jūsų esamą konfigūraciją yra neleidžiamas."
msgstr[1] ""
"Šie paketai nebuvo patvirtinti jo autoriaus. Nepatvirtintų paketų "
"atsiuntimas pagal jūsų esamą konfigūraciją yra neleidžiamas."
msgstr[2] ""
"Šie paketai nebuvo patvirtinti jo autoriaus. Nepatvirtintų paketų "
"atsiuntimas pagal jūsų esamą konfigūraciją yra neleidžiamas."

#: DriverManager.cpp:298
#, kde-format
msgctxt "@label"
msgid ""
"The package \"%1\" has not been found among your software sources. "
"Therefore, it cannot be installed. "
msgstr ""
"Paketas \"%1\" nebuvo rastas tarp jūsų programinės įrangos šaltinių. Todėl, "
"jis negali būti įdiegtas. "

#: DriverManager.cpp:310
msgctxt "@title:window"
msgid "Media Change Required"
msgstr "Reikia pakeisti laikmeną"

#: DriverManager.cpp:311
#, kde-format
msgctxt "@label"
msgid "Please insert %1 into <filename>%2</filename>"
msgstr "Prašome įdėti %1 į <filename>%2</filename>"

#: DriverManager.cpp:320
msgctxt "@title:window"
msgid "Warning - Unverified Software"
msgstr "Įspėjimas - Nepatvirtinta programinė įranga"

#: DriverManager.cpp:322
msgctxt "@label"
msgid ""
"The following piece of software cannot be verified. <warning>Installing "
"unverified software represents a security risk, as the presence of "
"unverifiable software can be a sign of tampering.</warning> Do you wish to "
"continue?"
msgid_plural ""
"The following pieces of software cannot be verified. <warning>Installing "
"unverified software represents a security risk, as the presence of "
"unverifiable software can be a sign of tampering.</warning> Do you wish to "
"continue?"
msgstr[0] ""
"Ši programinės įrangos dalis negali būti patvirtinta. "
"<warning>Nepatvirtintos programinės įrangos įdiegimas sukelia saugumo "
"riziką, kadangi nepatvirtintos programinės įrangos buvimas gali būti "
"klastojimo ženklu.</warning> Ar norėtumėte tęsti?"
msgstr[1] ""
"Šios programinės įrangos dalys negali būti patvirtintos. "
"<warning>Nepatvirtintos programinės įrangos įdiegimas sukelia saugumo "
"riziką, kadangi nepatvirtintos programinės įrangos buvimas gali būti "
"klastojimo ženklu.</warning> Ar norėtumėte tęsti?"
msgstr[2] ""
"Šios programinės įrangos dalys negali būti patvirtintos. "
"<warning>Nepatvirtintos programinės įrangos įdiegimas sukelia saugumo "
"riziką, kadangi nepatvirtintos programinės įrangos buvimas gali būti "
"klastojimo ženklu.</warning> Ar norėtumėte tęsti?"

#: DriverManager.cpp:341
msgctxt "@title:window"
msgid "Configuration File Changed"
msgstr "Konfigūracijos failas pakeistas"

#: DriverManager.cpp:343
#, kde-format
msgctxt "@label Notifies a config file change"
msgid ""
"A new version of the configuration file <filename>%1</filename> is "
"available, but your version has been modified. Would you like to keep your "
"current version or install the new version?"
msgstr ""
"Yra prieinama nauja konfigūracijos failo <filename>%1</filename> versija, "
"tačiau jūsų esama versija buvo pakeista. Ar norėtumėte palikti savo esamą "
"versiją, ar įdiegti naująją versiją?"

#: DriverManager.cpp:348
msgctxt "@action Use the new config file"
msgid "Use New Version"
msgstr "Naudoti naują versiją"

#: DriverManager.cpp:349
msgctxt "@action Keep the old config file"
msgid "Keep Old Version"
msgstr "Palikti seną versiją"
