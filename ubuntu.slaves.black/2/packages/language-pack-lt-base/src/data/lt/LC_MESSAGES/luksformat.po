#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Ši programa turi būti paleista kaip pagrindinis naudotojas (root)\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Kurti ir formatuoti užšifruotą LUKS įrenginį\n"
"Naudojimas: luksformat [-t <failų sistema>] <įrenginys> [ mkfs parametrai ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Klaida: įrenginys prijungtas: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Klaida: neteisinga failų sistema: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr ""
"Klaida: nepavyko sugeneruoti laikinai atvaizduojamo įrenginio pavadinimo"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Kuriamas užšifruotas įrenginys ties %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Nepavyko sukurti LUKS įrenginio %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr ""
"Prašome tam, kad patvirtintumėte, dar kartą įrašyti savo slaptafrazę\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Jūsų įrašytos slaptafrazės nebuvo vienodos\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Nepavyko formatuoti įrenginio su %s failų sistema"
