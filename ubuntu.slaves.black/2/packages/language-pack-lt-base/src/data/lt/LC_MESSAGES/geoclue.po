#: ../demo/agent.c:42 ../src/gclue-main.c:47
msgid "Display version number"
msgstr "Rodyti versijos numerį"

#: ../demo/agent.c:85 ../src/gclue-main.c:161
msgid "GeoClue"
msgstr "GeoClue"

#: ../demo/gclue-service-agent.c:163
#, c-format
msgid "Geolocation service in use\n"
msgstr "Yra naudojama geografinės buvimo vietos nustatymo tarnyba\n"

#: ../demo/gclue-service-agent.c:165
#, c-format
msgid "Geolocation service not in use\n"
msgstr "Geografinės buvimo vietos nustatymo tarnyba nėra naudojama\n"

#: ../demo/gclue-service-agent.c:359
#, c-format
msgid "Allow '%s' to access your location information?"
msgstr "Leisti \"%s\" prieigą prie informacijos apie jūsų buvimo vietą?"

#: ../demo/gclue-service-agent.c:367
msgid "Geolocation"
msgstr "Geografinės buvimo vietos nustatymas"

#: ../demo/gclue-service-agent.c:378
msgid "Yes"
msgstr "Taip"

#: ../demo/gclue-service-agent.c:384
msgid "No"
msgstr "Ne"

#: ../demo/where-am-i.c:42
msgid "Exit after T seconds. Default: 30"
msgstr "Išeiti po T sekundžių. Pagal numatymą: 30"

#: ../demo/where-am-i.c:49
msgid ""
"Only report location update after T seconds. Default: 0 (report new location "
"without any delay)"
msgstr ""
"Pranešti apie buvimo vietos atnaujinima tik po T sekundžių. Pagal numatymą: "
"0 (nedelsiant pranešti apie naują buvimo vietą)"

#: ../demo/where-am-i.c:57
msgid ""
"Request accuracy level A. Country = 1, City = 4, Neighborhood = 5, Street = "
"6, Exact = 8."
msgstr ""
"Užklausos tikslumo lygmuo A. Šalis = 1, Miestas = 4, Kaimynystė = 5, Gatvė = "
"6, Tiksliai = 8."

#: ../demo/geoclue-demo-agent.desktop.in.in.h:1
msgid "Geoclue Demo agent"
msgstr "Geoclue demonstracinis agentas"

#: ../demo/geoclue-demo-agent.desktop.in.in.h:2
msgid "Demo geoclue agent"
msgstr "Demonstracinis geoclue agentas"

#: ../demo/geoclue-demo-agent.desktop.in.in.h:3
#: ../demo/geoclue-where-am-i.desktop.in.in.h:4
msgid "geolocation;"
msgstr "geografinės buvimo vietos nustatymas;"

#: ../demo/geoclue-where-am-i.desktop.in.in.h:1
msgid "Where am I?"
msgstr "Kur aš esu?"

#: ../demo/geoclue-where-am-i.desktop.in.in.h:2
msgid "Demo geolocation application"
msgstr "Demonstracinė geografinės buvimo vietos nustatymo programa"

#: ../demo/geoclue-where-am-i.desktop.in.in.h:3
msgid "Find your current location"
msgstr "Rasti jūsų dabartinę buvimo vietą"

#: ../demo/geoclue-where-am-i.desktop.in.in.h:5
msgid "Allows your current location to be shown on terminal."
msgstr "Leidžia terminale rodyti jūsų dabartinę vietą."

#: ../src/gclue-main.c:54
msgid "Exit after T seconds of inactivity, 0 for never. Default: 5"
msgstr "Išeiti po T sekundžių neveiklumo, 0 - niekada. Pagal numatymą: 5"

#: ../src/gclue-main.c:61
msgid "Enable submission of network data"
msgstr "Įjungti tinklo duomenų pateikimą"

#: ../src/gclue-main.c:68
msgid "Nickname to submit network data under (2-32 characters)"
msgstr ""
"Slapyvardis, kuriuo prisidengus pateikti tinklo duomenis (2-32 simboliai)"
