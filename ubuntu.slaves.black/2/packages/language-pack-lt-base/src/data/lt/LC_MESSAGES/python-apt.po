#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Šalies %s serveris"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Pagrindinis serveris"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Kiti serveriai"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Trūksta aprašo, skirto \"%s\".Prašome apie tai pranešti."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Klaidingas unikodas „%s“ apraše (%s). Prašome pranešti."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Pakeitimų sąrašas neprieinamas"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Pakeitimų žurnalas dar neprieinamas.\n"
"\n"
"Naudokite http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"kol pakeitimai taps prieinami arba mėginkite vėliau."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Nepavyko atsiųsti pakeitimų sąrašo. \n"
"Patikrinkite Interneto ryšį."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Nepavyko perskaityti „%s“ failų sąrašo"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Nepavyko perskaityti „%s“ valdymo failų sąrašo"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Priklausomybė nėra patenkinama: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Nesuderinama su įdiegtu paketu „%s“"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Sugadina egzistuojančio paketo „%(pkgname)s“ priklausomybę %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Sugadina egzistuojančio paketo „%(pkgname)s“ konfliktą: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Sugadina egzistuojantį paketą „%(pkgname)s“, kuris konfliktuoja su "
"„%(targetpkg)s“. Bet „%(debfile)s“ suteikia jį per „%(provides)s“"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Nėra architektūros lauko pakete"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Neteisinga architektūra \"%s\" -- Vykdykite dpkg --add-architecture , kad ją "
"pridėtumėte, o po to atnaujintumėte"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Naujesnė versija jau įdiegta"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Nepavyko patenkinti visų priklausomybių (sugadintas podėlis)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Neina įdiegti '%s'"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Išskleistas automatiškai:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Automatiškai pakeista į spausdinamą ascii:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Įdiegti kūrimo priklausomybes išeities teksto paketui „%s“, kuris sukuria "
"%s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Būtų pašalintas būtinas paketas"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Baigta"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Imamas "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Kld "

#: ../apt/progress/text.py:167
msgid "Get:"
