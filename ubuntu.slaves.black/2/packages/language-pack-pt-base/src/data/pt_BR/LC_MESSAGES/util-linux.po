msgstr "Seta p/ cima Move o cursor para a partição anterior"

#: disk-utils/cfdisk.c:2271
msgid "Down Arrow   Move cursor to the next partition"
msgstr ""
"Seta p/ baixo\n"
"             Move o cursor para a próxima partição"

