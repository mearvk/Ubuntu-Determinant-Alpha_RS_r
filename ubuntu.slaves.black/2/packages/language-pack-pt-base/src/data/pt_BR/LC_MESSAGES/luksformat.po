#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Este programa precisa ser iniciado como root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Cria e formata um dispositivo LUKS criptografado\n"
"Uso: luksformat [-t <sistema de arquivos>] <dispositivo> [ opções do mkfs ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Erro: dispositivo montado: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Erro: sistema de arquivos inválido: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr ""
"Error: não foi possível gerar um nome de dispositivo mapeado temporariamente"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Criando dispositivo criptografado em %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Não foi possível criar um dispositivo LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Digite sua senha novamente para verificação\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "As senhas não são idênticas, por favor, tente novamente\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Não foi possível formatar o dispositivo com o sistema de arquivos %s"
