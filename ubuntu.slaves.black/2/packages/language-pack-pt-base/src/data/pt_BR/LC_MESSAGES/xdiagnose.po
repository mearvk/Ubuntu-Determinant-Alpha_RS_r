#: ../com.canonical.xdiagnose.policy.in.h:1
msgid "Authentication is needed to diagnose graphics issues"
msgstr "Autenticação é necessária para diagnosticar problemas gráficos"

#: ../xdiagnose.desktop.in.h:1
msgid "xdiagnose"
msgstr "xdiagnose"

#: ../xdiagnose.desktop.in.h:2
msgid "Diagnose Graphics Issues"
msgstr "Diagnosticar problemas com as imagens"

#: ../xdiagnose.desktop.in.h:3
msgid "X.org Diagnostic and Repair Utility"
msgstr "Utilitário de diagnóstico e reparação do X.org"

#: ../bin/xdiagnose:81
msgid "Troubleshoot failure to start a graphical X11 session"
msgstr "Resolução de problemas falhou ao iniciar uma sessão gráfica X11"

#: ../bin/dpkg-log-summary:130
msgid "List dates on which updates were performed"
msgstr "Lista de datas em que as atualizações foram realizadas"

#: ../bin/dpkg-log-summary:134
msgid "Only include entries from this date forward (YYYY/MM/DD)"
msgstr "Apenas incluir entradas a partir desta data em diante (YYYY/MM/DD)"

#: ../bin/dpkg-log-summary:138
msgid "Only include entries from this date and earlier (YYYY/MM/DD)"
msgstr ""
"Apenas incluir entradas a partir desta data e anteriores (YYYY/MM/DD)"

#: ../xdiagnose/applet.py:62
msgid "X Diagnostics Settings"
msgstr "Configurações de diagnóstico do X"

#: ../xdiagnose/applet.py:74
msgid "Debug"
msgstr "Depuração"

#: ../xdiagnose/applet.py:75
msgid "Extra graphics _debug messages"
msgstr "Mensagens extras da depuração de vídeo"

#: ../xdiagnose/applet.py:76
msgid ""
"Makes dmesg logs more verbose with details about 3d, plymouth, and monitor "
"detection"
msgstr ""
"Deixa os registros de atividades dmesg mais detalhados com informações sobre "
"3D, plymouth e detecção de monitores"

#: ../xdiagnose/applet.py:79
msgid "Display boot messages"
msgstr "Exibir mensagens de inicialização"

#: ../xdiagnose/applet.py:80
msgid ""
"Removes splash and quiet from kernel options so you can see kernel details "
"during boot"
msgstr ""
"Remove splash e quiet das opções do kernel, resultando na exibição de mais "
"detalhes do kernel durante a inicialização"

#: ../xdiagnose/applet.py:83
msgid "Enable automatic crash bug reporting"
msgstr "Habilitar o envio automático de relatórios de travamento"

#: ../xdiagnose/applet.py:84
msgid "Turns on the Apport crash detection and bug reporting tool"
msgstr "Ativa a ferramenta de detecção e relatórios de erros Apport"

#: ../xdiagnose/applet.py:89
msgid "Workarounds"
msgstr "Soluções alternativas"

#: ../xdiagnose/applet.py:90
msgid "Disable bootloader _graphics"
msgstr "Desabilitar _gráficos de inicialização"

#: ../xdiagnose/applet.py:91
msgid ""
"The grub bootloader has a graphics mode using the VESA framebuffer driver "
"which can sometimes interfere with later loading of the proper video driver. "
" Checking this forces grub to use text mode only."
msgstr ""
"O carregador de inicialização grub tem um modo gráfico que utiliza um driver "
"de armazenamento de quadros VESA que, algumas vezes, pode interferir no "
"carregamento posterior do driver de vídeo apropriado. Marcando isto, o grub "
"é forçado a usar somente o modo de texto."

#: ../xdiagnose/applet.py:94
msgid "Disable _VESA framebuffer driver"
msgstr "Desabilitar o driver de framebuffer VESA"

#: ../xdiagnose/applet.py:95
msgid ""
"vesafb is loaded early during boot so the boot logo can display, but can "
"cause issues when switching to a real graphics driver.  Checking this "
"prevents vesafb from loading so these issues do not occur."
msgstr ""
"O vesafb é carregado no começo da inicialização para que o logotipo de "
"inicialização seja exibido, mas ele pode causar problemas na mudança para um "
"driver de vídeo definitivo. Ao marcar esta opção, evita-se que o vesafb seja "
"carregado, de modo que esses problemas não ocorram."

#: ../xdiagnose/applet.py:98
msgid "Disable _PAT memory"
msgstr "Desabilitar memória _PAT"

#: ../xdiagnose/applet.py:99
msgid ""
"This pagetable extension can interfere with the memory management of "
"proprietary drivers under certain situations and cause lagging or failures "
"to allocate video memory, so turning it off can prevent those problems."
msgstr ""
"Esta extensão pode interferir no gerenciamento de memória de drivers "
"proprietários sob certas circunstâncias e causar atraso ou erros ao alocar "
"memória de vídeo. Logo, ao desabilitar essa opção, pode-se previnir esses "
"problemas."

#: ../xdiagnose/applet.py:140
msgid "View Errors"
msgstr "Visualizar erros"

#: ../xdiagnose/applet.py:144
msgid "Report an Xorg Bug"
msgstr "Relatar um problema no Xorg"

#: ../xdiagnose/errors_treeview.py:37
msgid "Xorg Error Messages"
msgstr "Mensagens de erro do Xorg"

#. create the TreeViewColumn to display the data
#: ../xdiagnose/errors_treeview.py:53
msgid "Error Message"
msgstr "Mensagem de erro"
