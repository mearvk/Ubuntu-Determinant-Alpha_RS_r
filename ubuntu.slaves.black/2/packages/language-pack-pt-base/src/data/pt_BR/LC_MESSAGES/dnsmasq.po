#: cache.c:764
#, c-format
msgid "failed to load names from %s: %s"
msgstr "falhou ao carregar os nomes de %s: %s"

#: cache.c:798 dhcp.c:783
#, c-format
msgid "bad address at %s line %d"
msgstr "endereço inválido em %s linha %d"

#: cache.c:853 dhcp.c:797
#, c-format
msgid "bad name at %s line %d"
msgstr "nome inválido em %s linha %d"

#: cache.c:860 dhcp.c:863
#, c-format
msgid "read %s - %d addresses"
msgstr "ler %s - %d endereços"

#: cache.c:899
msgid "cleared cache"
msgstr "cache limpado"

#: cache.c:930 option.c:1026
#, c-format
msgid "cannot access directory %s: %s"
msgstr "não foi possível acessar o diretório %s: %s"

#: cache.c:1049
#, c-format
msgid ""
"not giving name %s to the DHCP lease of %s because the name exists in %s "
"with address %s"
msgstr ""
"não foi dado o nome %s à concessão DHCP de %s porque o nome existe em %s com "
"o endereço %s"

#: cache.c:1126
#, c-format
msgid "time %lu"
msgstr "tempo %lu"

#: cache.c:1127
#, c-format
msgid ""
"cache size %d, %d/%d cache insertions re-used unexpired cache entries."
msgstr ""
"tamanho do cache %d, %d/%d inserções no cache reutilizaram entradas não "
"expiradas."

#: cache.c:1129
#, c-format
msgid "queries forwarded %u, queries answered locally %u"
msgstr "requisições redirecionadas %u, requisições resolvidas localmente %u"

#: cache.c:1152
#, c-format
msgid "server %s#%d: queries sent %u, retried or failed %u"
msgstr "servidor %s#%d: pesquisas enviadas %u, tentativas ou falhas %u"

#: util.c:56
#, c-format
msgid "failed to seed the random number generator: %s"
msgstr "falhou ao obter o gerador de números randômicos: %s"

#: util.c:164
msgid "could not get memory"
msgstr "impossível pegar memória"

#: util.c:174
#, c-format
msgid "cannot create pipe: %s"
msgstr "não foi possível criar o canal: %s"

#: util.c:182
#, c-format
msgid "failed to allocate %d bytes"
msgstr "falhou ao alocar %d bytes"

#: util.c:287
#, c-format
msgid "infinite"
msgstr "infinito"

#: option.c:228
msgid "Specify local address(es) to listen on."
msgstr "Especifique o(s) endereço(s) local(is) para escutar."

#: option.c:229
msgid "Return ipaddr for all hosts in specified domains."
msgstr "Retorna o endereço de ip de todos os hosts no domínio especificado."

#: option.c:230
msgid "Fake reverse lookups for RFC1918 private address ranges."
msgstr ""
"Falsificar consultas reversas para os escopos de endereços privados da "
"RFC1918"

#: option.c:231
msgid "Treat ipaddr as NXDOMAIN (defeats Verisign wildcard)."
msgstr "Tratar ipaddr como NXDOMAIN (sobrescreve coringa da Verisign)"

#: option.c:232
#, c-format
msgid "Specify the size of the cache in entries (defaults to %s)."
msgstr "Especifique o tamanho do cache nas entradas (padrão é %s)."

#: option.c:233
#, c-format
msgid "Specify configuration file (defaults to %s)."
msgstr "Especifique o arquivo de configuração (padrão é %s)."

#: option.c:234
msgid "Do NOT fork into the background: run in debug mode."
msgstr "NÃO coloque em segundo plano: executando em modo de depuracão"

#: option.c:235
msgid "Do NOT forward queries with no domain part."
msgstr "NÃO encaminhe pesquisas com o domínio incompleto"

#: option.c:236
msgid "Return self-pointing MX records for local hosts."
msgstr ""
"Retorna registros MX auto-indicativos (aponta para si mesmo) para hosts "
"locais."

#: option.c:237
msgid "Expand simple names in /etc/hosts with domain-suffix."
msgstr "Expandindo os nomes simples do /etc/hosys com sufixo de domínio"

#: option.c:238
msgid "Don't forward spurious DNS requests from Windows hosts."
msgstr "Não repassa requisições falsas de DNS vindas de hosts Windows"

#: option.c:239
msgid "Enable DHCP in the range given with lease duration."
msgstr "Habilita DHCP na faixa fornecida com duração de concessão."

#: option.c:240
#, c-format
msgid "Change to this group after startup (defaults to %s)."
msgstr "Mudar para este grupo depois da inicialização (padrão é %s)."

#: option.c:241
msgid "Set address or hostname for a specified machine."
msgstr "Configure o endereco ou nome para uma máquina específica"

#: option.c:242
msgid "Read DHCP host specs from file"
msgstr "Lendo especificacões das máquinas em DHCP do arquivo"

#: option.c:243
msgid "Read DHCP option specs from file"
msgstr "Ler as especificações das opções DHCP do arquivo"

#: option.c:244
#, c-format
msgid "Do NOT load %s file."
msgstr "NÃO carregue o arquivo %s."

#: option.c:245
#, c-format
msgid "Specify a hosts file to be read in addition to %s."
msgstr "Especifique o arquivo de hosts para ser lido além de %s."

#: option.c:246
msgid "Specify interface(s) to listen on."
msgstr "Especifique a interface(s) para ouvir."

#: option.c:247
msgid "Specify interface(s) NOT to listen on."
msgstr "Especifica qual(is) interface(s) NÃO escutar."

#: option.c:248
msgid "Map DHCP user class to tag."
msgstr "Mapeia classe de usuários DHCP para marcação."

#: option.c:249
msgid "Map RFC3046 circuit-id to tag."
msgstr "Mapeia identificador de circuito RFC3046 para marcação."

#: option.c:250
msgid "Map RFC3046 remote-id to tag."
msgstr "Mapeia identificador remoto RFC3046 para marcação."

#: option.c:251
msgid "Map RFC3993 subscriber-id to tag."
msgstr "Mapeia identificador de assinante RFC3993 para marcação."

#: option.c:252
msgid "Don't do DHCP for hosts with tag set."
msgstr "Não disponibiliza DHCP para hosts marcados."

#: option.c:253
msgid "Force broadcast replies for hosts with tag set."
msgstr "Força retornos broadcast para hosts marcados."

#: option.c:254
msgid "Do NOT fork into the background, do NOT run in debug mode."
msgstr "NÃO execute em segundo plano, NÃO execute em modo de depuracão"

#: option.c:255
msgid "Assume we are the only DHCP server on the local network."
msgstr "Assumir que somos o único servidor DHCP na rede local."

#: option.c:256
#, c-format
msgid "Specify where to store DHCP leases (defaults to %s)."
msgstr "Especifica onde armazenar os leases DHCP (padrão em %s)."

#: option.c:257
msgid "Return MX records for local hosts."
msgstr "Retorna registros MX dos servidores locais"

#: option.c:258
msgid "Specify an MX record."
msgstr "Especifica um registro MX."

#: option.c:259
msgid "Specify BOOTP options to DHCP server."
msgstr "Especifica as opções BOOTP para o servidor DHCP."

#: option.c:260
#, c-format
msgid "Do NOT poll %s file, reload only on SIGHUP."
msgstr "Não consulta o arquivo %s, recarrega apenas em um SIGHUP."

#: option.c:261
msgid "Do NOT cache failed search results."
msgstr "NÃO fazer cache de resultados falhos de buscas."

#: option.c:262
#, c-format
msgid "Use nameservers strictly in the order given in %s."
msgstr "Use os nameservers exatamente na ordem dada em %s."

#: option.c:263
msgid "Specify options to be sent to DHCP clients."
msgstr "Especifica as opções que serão enviadas aos clientes DHCP."

#: option.c:264
msgid "DHCP option sent even if the client does not request it."
msgstr "enviar opção DHCP mesmo que o cliente não solicite isto."

#: option.c:265
msgid "Specify port to listen for DNS requests on (defaults to 53)."
msgstr "Especifica a porta para escutar requisições DNS (padrão em 53)."

#: option.c:266
#, c-format
msgid "Maximum supported UDP packet size for EDNS.0 (defaults to %s)."
msgstr "Tamanho máximo dos pacotes UDP suportados para EDNS.0 (padrão %s)."

#: option.c:267
msgid "Log DNS queries."
msgstr "Registrar consultas DNS."

#: option.c:268
msgid "Force the originating port for upstream DNS queries."
msgstr "Forca a porta de origem para envio de pesquisas de DNS"

#: option.c:269
msgid "Do NOT read resolv.conf."
msgstr "NÃO leia o resolv.conf."

#: option.c:270
#, c-format
msgid "Specify path to resolv.conf (defaults to %s)."
msgstr "Especifica o caminho para o resolv.conf (padrão em %s)."

#: option.c:271
msgid "Specify address(es) of upstream servers with optional domains."
msgstr "Especifica endereços de servidores upstream com domínios adicionais."

#: option.c:272
msgid "Never forward queries to specified domains."
msgstr "Nunca encaminhe pesquisas para um dom[inio específico."

#: option.c:273
msgid "Specify the domain to be assigned in DHCP leases."
msgstr "Especifica o domínio que será atribuido nos leases DHCP."

#: option.c:274
msgid "Specify default target in an MX record."
msgstr "Especifica o alvo padrão em um registro NX."

#: option.c:275
msgid "Specify time-to-live in seconds for replies from /etc/hosts."
msgstr "Especifique o tempo de vida (TTL) para pesquisas do /etc/hosts"

#: option.c:276
msgid "Specify time-to-live in seconds for negative caching."
msgstr "Specifica duração (time-to-live) em segundos para cache negativo."

#: option.c:277
#, c-format
msgid "Change to this user after startup. (defaults to %s)."
msgstr "Altera para este usuário após inciar. (padrão para %s)."

#: option.c:278
msgid "Map DHCP vendor class to tag."
msgstr "Mapeia classe de fornecedor DHCP para ser marcada."

#: option.c:279
msgid "Display dnsmasq version and copyright information."
msgstr "Exibe as informações de versão e copyright do dnsmasq."

#: option.c:280
msgid "Translate IPv4 addresses from upstream servers."
msgstr "Converte enderecos IPv4 para encaminhamento aos servidores."

#: option.c:281
msgid "Specify a SRV record."
msgstr "Especifica um registro SRV."

#: option.c:282
msgid "Display this message. Use --help dhcp for known DHCP options."
msgstr "Mostra essa menssagem. Use -help dhcp para ver as opcões de DHCP"

#: option.c:283
#, c-format
msgid "Specify path of PID file (defaults to %s)."
msgstr "Especifica o caminho para o arquivo PID ( padrão em %s)."

#: option.c:284
#, c-format
msgid "Specify maximum number of DHCP leases (defaults to %s)."
msgstr "Especifica o número máximo de leases DHCP (padrão de %s)."

#: option.c:285
msgid "Answer DNS queries based on the interface a query was sent to."
msgstr ""
"Respondendo as pesquisas de DNS baseadas na interface que as receberam."

#: option.c:286
msgid "Specify TXT DNS record."
msgstr "Especifica o registro DNS TXT."

#: option.c:287
msgid "Specify PTR DNS record."
msgstr "Especifica o registro DNS PTR."

#: option.c:288
msgid "Give DNS name to IPv4 address of interface."
msgstr "Fornece um nome DNS para endereços IPv4 da interface."

#: option.c:289
msgid "Bind only to interfaces in use."
msgstr "Vincula apenas a interfaces em uso."

#: option.c:290
#, c-format
msgid "Read DHCP static host information from %s."
msgstr "Lendo as informacões estática de DHCP da máquina do %s."

#: option.c:291
msgid "Enable the DBus interface for setting upstream servers, etc."
msgstr "Habilita a interface DBus para configurar servidores upstream, etc."

#: option.c:292
msgid "Do not provide DHCP on this interface, only provide DNS."
msgstr "Não disponibiliza DHCP nesta interface, apenas disponibiliza DNS."

#: option.c:293
msgid "Enable dynamic address allocation for bootp."
msgstr "Habilita alocação dinâmica de endereços ppara bootp."

#: option.c:294
msgid "Map MAC address (with wildcards) to option set."
msgstr "Mapeia endreços MAC (com wildcards) para a opção configurada."

#: option.c:295
msgid "Treat DHCP requests on aliases as arriving from interface."
msgstr ""
"Trata solicitações DHCP nos aliases como tendo chegadas da interface."

#: option.c:296
msgid "Disable ICMP echo address checking in the DHCP server."
msgstr "Desabilita a checagem de endereço ICMP echo no servidor DHCP."

#: option.c:297
msgid "Script to run on DHCP lease creation and destruction."
msgstr "Script para executar no DHCP a crição de alocação e destruição."

#: option.c:298
msgid "Read configuration from all the files in this directory."
msgstr "Ler a configuração de todos os arquivos neste diretório."

#: option.c:299
msgid "Log to this syslog facility or file. (defaults to DAEMON)"
msgstr "Logar no syslog ou arquivo. (padrões para DAEMON)"

#: option.c:300
msgid "Do not use leasefile."
msgstr "Não usar arquivo de alocação."

#: option.c:301
#, c-format
msgid "Maximum number of concurrent DNS queries. (defaults to %s)"
msgstr "Número máximo de consultas DNS simultâneas. (padrões %s)"

#: option.c:302
#, c-format
msgid "Clear DNS cache when reloading %s."
msgstr "Limpar cache DNS quando recarregando %s."

#: option.c:303
msgid "Ignore hostnames provided by DHCP clients."
msgstr "Ignorar nomes de hosts fornecidos por clientes DHCP."

#: option.c:304
msgid "Do NOT reuse filename and server fields for extra DHCP options."
msgstr ""
"NÃO reusar nomes de arquivos e campos de servidores para opções extras de "
"DHCP."

#: option.c:305
msgid "Enable integrated read-only TFTP server."
msgstr "Habilitar servidor TFTP integrado como somente-leitura."

#: option.c:306
msgid "Export files by TFTP only from the specified subtree."
msgstr "Exportar arquivos pelo TFTP somente para a sub-árvore especificada."

#: option.c:307
msgid "Add client IP address to tftp-root."
msgstr "Adicionar endereço IP de cliente para tftp-root."

#: option.c:308
msgid "Allow access only to files owned by the user running dnsmasq."
msgstr ""
"Permitir acesso somente a arquivos de propriedade de usuário executando "
"dnsmasq."

#: option.c:309
#, c-format
msgid "Maximum number of conncurrent TFTP transfers (defaults to %s)."
msgstr "Número máximo de transferências TFTP simultâneas (padrões %s)."

#: option.c:310
msgid "Disable the TFTP blocksize extension."
msgstr "Desabilitar a extensão TFTP de tamanho de bloco."

#: option.c:311
msgid "Ephemeral port range for use by TFTP transfers."
msgstr "Intervalo de portas temporário para uso por transferências TFTP."

#: option.c:312
msgid "Extra logging for DHCP."
msgstr "Logging extra para DHCP."

#: option.c:313
msgid "Enable async. logging; optionally set queue length."
msgstr ""
"Habilitar o log assíncrono; definir o comprimento da fila opcionalmente."

#: option.c:314
msgid "Stop DNS rebinding. Filter private IP ranges when resolving."
msgstr ""
"Parar a religação DNS. Filtrar intervalos de IPs privados enquanto "
"resolvendo."

#: option.c:315
msgid "Always perform DNS queries to all servers."
msgstr "Sempre realizar consultas DNS a todos os servidores."

#: option.c:316
msgid "Set tag if client includes matching option in request."
msgstr ""
"Definir marcador se o cliente inclui a opção correspondente no pedido."

#: option.c:317
msgid "Use alternative ports for DHCP."
msgstr "Usar portas alternativas para o DHCP."

#: option.c:318
msgid "Run lease-change script as this user."
msgstr "Executar o script de mudança de alocação como esse usuário."

#: option.c:319
msgid "Specify NAPTR DNS record."
msgstr "Especifica o registro DNS NAPTR."

#: option.c:320
msgid "Specify lowest port available for DNS query transmission."
msgstr ""
"Especificar a porta mais baixa disponível para a transmissão da consulta DNS."

#: option.c:321
msgid "Use only fully qualified domain names for DHCP clients."
msgstr ""
"Usar somente nomes de domínio totalmente qualificados para os clientes DHCP."

#: option.c:322
msgid "Specify alias name for LOCAL DNS name."
msgstr "Especificar um alias para um nome DNS LOCAL."

#: option.c:323
msgid "Prompt to send to PXE clients."
msgstr "Pedir para enviar a clientes PXE."

#: option.c:324
msgid "Boot service for PXE menu."
msgstr "Serviço de inicialização para menu PXE."

#: option.c:325
msgid "Check configuration syntax."
msgstr "Verificar a sintaxe da configuração."

#: option.c:601
#, c-format
msgid ""
"Usage: dnsmasq [options]\n"
"\n"
msgstr ""
"Uso: dnsmasq [opções]\n"
"\n"

#: option.c:603
#, c-format
msgid "Use short options only on the command line.\n"
msgstr "Use as opções curtas somente na linha de comando.\n"

#: option.c:605
#, c-format
msgid "Valid options are:\n"
msgstr "As opções válidas são:\n"

#: option.c:646
#, c-format
msgid "Known DHCP options:\n"
msgstr "Opções DHCP conhecidas:\n"

#: option.c:723
msgid "bad dhcp-option"
msgstr "opção-dhcp inválida"

#: option.c:780
msgid "bad IP address"
msgstr "endereço IP inválido"

#: option.c:878
msgid "bad domain in dhcp-option"
msgstr "domínio inválido na opção-dhcp"

#: option.c:936
msgid "dhcp-option too long"
msgstr "opção-dhcp muito longa"

#: option.c:945
msgid "illegal dhcp-match"
msgstr "correspondência dhcp ilegal"

#: option.c:981
msgid "illegal repeated flag"
msgstr "sinalização repetida ilegal"

#: option.c:989
msgid "illegal repeated keyword"
msgstr "palavra-chave repetida ilegal"

#: option.c:1046 tftp.c:345
#, c-format
msgid "cannot access %s: %s"
msgstr "não é possível acessar %s: %s"

#: option.c:1084
msgid "only one dhcp-hostsfile allowed"
msgstr "somente um arquivo de host DHCP permitido"

#: option.c:1091
msgid "only one dhcp-optsfile allowed"
msgstr "somente um arquivo de opções DHCP permitido"

#: option.c:1135
msgid "bad MX preference"
msgstr "prioridade MX inválida"

#: option.c:1139
msgid "bad MX name"
msgstr "nome MX inválido"

#: option.c:1153
msgid "bad MX target"
msgstr "alvo MX inválido"

#: option.c:1165
msgid "cannot run scripts under uClinux"
msgstr "não é possível executar scripts sob uClinux"

#: option.c:1395 option.c:1399
msgid "bad port"
msgstr "porta inválida"

#: option.c:1418 option.c:1443
msgid "interface binding not supported"
msgstr "interface de ligação não suportada"

#: option.c:1564
msgid "bad port range"
msgstr "intervalo de portas inválido"

#: option.c:1581
msgid "bad bridge-interface"
msgstr "interface de ponte inválida"

#: option.c:1622
msgid "bad dhcp-range"
msgstr "intervalo DHCP inválido"

#: option.c:1648
msgid "only one netid tag allowed"
msgstr "somente um marcador netid permitida"

#: option.c:1693
msgid "inconsistent DHCP range"
msgstr "intervalo DHCP inconsistente"

#: option.c:1865
msgid "bad DHCP host name"
msgstr "nome de host DHCP inválido"

#: option.c:2155 option.c:2427
msgid "invalid port number"
msgstr "número de porta inválido"

#: option.c:2238
msgid "invalid alias range"
msgstr "alias de intervalo inválido"

#: option.c:2250
msgid "bad interface name"
msgstr "nome de interface inválido"

#: option.c:2273
msgid "duplicate CNAME"
msgstr "CNAME duplicado"

#: option.c:2290
msgid "bad PTR record"
msgstr "registro PTR inválido"

#: option.c:2320
msgid "bad NAPTR record"
msgstr "registro NAPTR inválido"

#: option.c:2346
msgid "TXT record string too long"
msgstr "string de registro TXT grande demais"

#: option.c:2350
msgid "bad TXT record"
msgstr "registro TXT inválido"

#: option.c:2410
msgid "bad SRV record"
msgstr "registro SRV inválido"

#: option.c:2419
msgid "bad SRV target"
msgstr "alvo SRV inválido"

#: option.c:2434
msgid "invalid priority"
msgstr "prioridade inválida"

#: option.c:2441
msgid "invalid weight"
msgstr "carga inválida"

#: option.c:2460
msgid ""
"unsupported option (check that dnsmasq was compiled with DHCP/TFTP/DBus "
"support)"
msgstr ""
"opção não suportada (verificar se o dnsmasq foi compilado com suporte a "
"DHCP/TFTP/DBus)"

#: option.c:2503
#, c-format
msgid "files nested too deep in %s"
msgstr "arquivos alocados muito profundamente em %s"

#: option.c:2511 tftp.c:499
#, c-format
msgid "cannot read %s: %s"
msgstr "não foi possível ler %s: %s"

#: option.c:2572
msgid "missing \""
msgstr "falta \""

#: option.c:2619
msgid "bad option"
msgstr "opção inválida"

#: option.c:2621
msgid "extraneous parameter"
msgstr "parâmetro estranho"

#: option.c:2623
msgid "missing parameter"
msgstr "faltam parâmetros"

#: option.c:2631
msgid "error"
msgstr "erro"

#: option.c:2637
#, c-format
msgid "%s at line %d of %%s"
msgstr "%s na linha %d de %%s"

#: option.c:2686 option.c:2717
#, c-format
msgid "read %s"
msgstr "ler %s"

#: option.c:2789
#, c-format
msgid "Dnsmasq version %s  %s\n"
msgstr "Versão dnsmasq %s %s\n"

#: option.c:2790
#, c-format
msgid ""
"Compile time options %s\n"
"\n"
msgstr ""
"Opções de tempo de compilação %s\n"
"\n"

#: option.c:2791
#, c-format
msgid "This software comes with ABSOLUTELY NO WARRANTY.\n"
msgstr "Este software não vem com ABSOLUTAMENTE NENHUMA GARANTIA.\n"

#: option.c:2792
#, c-format
msgid "Dnsmasq is free software, and you are welcome to redistribute it\n"
msgstr "Dnsmasq é um software livre, e você pode redistribuí-lo.\n"

#: option.c:2793
#, c-format
msgid "under the terms of the GNU General Public License, version 2 or 3.\n"
msgstr "sob os termos da GNU General Public License, versão 2 ou 3.\n"

#: option.c:2804
msgid "try --help"
msgstr "tente --help"

#: option.c:2806
msgid "try -w"
msgstr "tente -w"

#: option.c:2809
#, c-format
msgid "bad command line options: %s"
msgstr "opções inválidas de linha de comando: %s"

#: option.c:2850
#, c-format
msgid "cannot get host-name: %s"
msgstr "não é possível resolver o nome de host: %s"

#: option.c:2878
msgid "only one resolv.conf file allowed in no-poll mode."
msgstr "somente um arquivo resolv.conf é permitido no modo no-poll"

#: option.c:2888
msgid "must have exactly one resolv.conf to read domain from."
msgstr "deve existir exatamente um resolv.conf de onde se lerá o domínio."

#: option.c:2891 network.c:748 dhcp.c:734
#, c-format
msgid "failed to read %s: %s"
msgstr "falhou em ler %s: %s"

#: option.c:2909
#, c-format
msgid "no search directive found in %s"
msgstr "nenhuma diretiva de pesquisa encontrada em %s"

#: option.c:2930
msgid "there must be a default domain when --dhcp-fqdn is set"
msgstr "deve haver um domínio padrão quando --dhcp-fqdn está configurado"

#: option.c:2934
msgid "syntax check OK"
msgstr "verificação de sintaxe OK"

#: forward.c:405
#, c-format
msgid "nameserver %s refused to do a recursive query"
msgstr "nome do servidor %s recusou-se a fazer uma consulta recursiva"

#: forward.c:433
msgid "possible DNS-rebind attack detected"
msgstr "possível ataque DNS-rebind detectado"

#: network.c:73
#, c-format
msgid "unknown interface %s in bridge-interface"
msgstr "interface desconhecida %s na interface de ponte"

