#, c-format
msgid ""
"  arp [-v]          [-i <if>] -d  <host> [pub]               <-Delete ARP "
"entry\n"
msgstr "  arp [-v] [-i <if>] -d <host> [pub] <-Apaga a entrada ARP\n"

