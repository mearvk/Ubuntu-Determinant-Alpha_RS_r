#: luks/keyencryption.c:61
#, c-format
msgid "Unable to obtain sector size for %s"
msgstr "Não foi possível obter o tamanho do sector para %s"

#: luks/keyencryption.c:109
msgid "Failed to obtain device mapper directory."
msgstr "Falha ao obter a directoria do dispositivo mapeador."

#: luks/keymanage.c:79 luks/keymanage.c:120 luks/keymanage.c:390
#, c-format
msgid "Can't open device: %s\n"
msgstr "Não foi possível abrir o dispositivo: %s\n"

#: luks/keymanage.c:86
#, c-format
msgid "%s is not a LUKS partition\n"
msgstr "%s não é uma partição LUKS\n"

#: luks/keymanage.c:89
msgid "unknown hash spec in phdr"
msgstr "hash spec desconhecida em phdr"

#: luks/keymanage.c:92
#, c-format
msgid "unknown version %d\n"
msgstr "versão desconhecida %d\n"

#: luks/keymanage.c:213
#, c-format
msgid "key %d active, purge first.\n"
msgstr "chave %d activa, limpe primeiro.\n"

#: luks/keymanage.c:218
#, c-format
msgid ""
"key material section %d includes too few stripes. Header manipulation?\n"
msgstr ""
"A chave material da secção %d não inclui stripes suficientes. Manipulação de "
"cabeçalho?\n"

#: luks/keymanage.c:281
#, c-format
msgid "key %d is disabled.\n"
msgstr "chave %d está desactivada.\n"

#: luks/keymanage.c:427
#, c-format
msgid "Key %d not active. Can't wipe.\n"
msgstr "Chave %d inactiva. Não foi possível apagar.\n"

#: src/cryptsetup.c:56
msgid "<name> <device>"
msgstr "<nome> <dispositivo>"

#: src/cryptsetup.c:56
msgid "create device"
msgstr "criar dispositivo"

#: src/cryptsetup.c:57 src/cryptsetup.c:58 src/cryptsetup.c:59
#: src/cryptsetup.c:60 src/cryptsetup.c:67
msgid "<name>"
msgstr "<nome>"

#: src/cryptsetup.c:57
msgid "remove device"
msgstr "remover dispositivo"

#: src/cryptsetup.c:58
msgid "modify active device"
msgstr "modificar dispositivo activo"

#: src/cryptsetup.c:59
msgid "resize active device"
msgstr "redimensionar dispositivo activo"

#: src/cryptsetup.c:60
msgid "show device status"
msgstr "mostrar o estado do dispositivo"

#: src/cryptsetup.c:61 src/cryptsetup.c:64
msgid "<device> [<new key file>]"
msgstr "<dispositivo> [<novo ficheiro chave>]"

#: src/cryptsetup.c:61
msgid "formats a LUKS device"
msgstr "formata um dispositivo LUKS"

#: src/cryptsetup.c:62
msgid "<device> <name> "
msgstr "<dispositivo> <nome> "

#: src/cryptsetup.c:62
msgid "open LUKS device as mapping <name>"
msgstr "abrir dispositivo LUKS como mapeamento <nome>"

#: src/cryptsetup.c:63
msgid "<device> <key slot>"
msgstr "<dispositivo> <ranhura da chave>"

#: src/cryptsetup.c:63
msgid "wipes key with number <key slot> from LUKS device"
msgstr "apaga a chave com o número <ranhura da chave> do dispositivo LUKS"

#: src/cryptsetup.c:64
msgid "add key to LUKS device"
msgstr "adicionar chave ao dispositivo LUKS"

#: src/cryptsetup.c:65 src/cryptsetup.c:66 src/cryptsetup.c:68
msgid "<device>"
msgstr "<dispositivo>"

#: src/cryptsetup.c:65
msgid "print UUID of LUKS device"
msgstr "imprimir UUID do dispositivo LUKS"

#: src/cryptsetup.c:66
msgid "tests <device> for LUKS partition header"
msgstr "testa o <dispositivo> para o cabeçalho de partição LUKS"

#: src/cryptsetup.c:67
msgid "remove LUKS mapping"
msgstr "remover mapeamento LUKS"

#: src/cryptsetup.c:68
msgid "dump LUKS partition information"
msgstr "mostar informação da partição LUKS"

#: src/cryptsetup.c:77
#, c-format
msgid "Command successful.\n"
msgstr "Comando bem sucedido.\n"

#: src/cryptsetup.c:90
#, c-format
msgid "Command failed"
msgstr "Comando falhou"

#: src/cryptsetup.c:226
#, c-format
msgid "This will overwrite data on %s irrevocably."
msgstr "Isto vai sobrescrever os dados em %s de forma irrevogável."

#: src/cryptsetup.c:227
msgid "memory allocation error in action_luksFormat"
msgstr "erro de alocação de memória em action_luksFormat"

#: src/cryptsetup.c:269
msgid ""
"This is the last keyslot. Device will become unusable after purging this key."
msgstr ""
"Este é o último keyslot. O dispositivo ficará inutilizável após purgar esta "
"chave."

#: src/cryptsetup.c:349
#, c-format
msgid ""
"\n"
"<action> is one of:\n"
msgstr ""
"\n"
"<acção> é uma de:\n"

#: src/cryptsetup.c:355
#, c-format
msgid ""
"\n"
"<name> is the device to create under %s\n"
"<device> is the encrypted device\n"
"<key slot> is the LUKS key slot number to modify\n"
"<key file> optional key file for the new key for luksAddKey action\n"
msgstr ""
"\n"
"<nome> é o dispositivo para criar sob %s\n"
"<dispositivo> é um dispositivo encriptado\n"
"<key slot> é o número do slot de uma chave LUKS para modificar\n"
"<key file> ficheiro chave opcional para uma ação nova para luksAddKey\n"

#: src/cryptsetup.c:371
msgid "Show this help message"
msgstr "Apresentar esta mensagem de ajuda"

#: src/cryptsetup.c:372
msgid "Display brief usage"
msgstr "Mostrar uso breve"

#: src/cryptsetup.c:376
msgid "Help options:"
msgstr "Opções de ajuda:"

#: src/cryptsetup.c:377
msgid "Shows more detailed error messages"
msgstr "Mostra mensagens de erro mais detalhadas"

#: src/cryptsetup.c:378
msgid "The cipher used to encrypt the disk (see /proc/crypto)"
msgstr "A cifra usada para encriptar o disco (ver /proc/crypto)"

#: src/cryptsetup.c:379
msgid "The hash used to create the encryption key from the passphrase"
msgstr ""
"A hash usada para criar a chave de encriptação a partir da frase-passe"

#: src/cryptsetup.c:380
msgid "Verifies the passphrase by asking for it twice"
msgstr "Verificar a frase-passe pedindo-a duas vezes"

#: src/cryptsetup.c:381
msgid "Read the key from a file (can be /dev/random)"
msgstr "Ler a chave de um ficheiro (pode ser /dev/random)"

#: src/cryptsetup.c:382
msgid "The size of the encryption key"
msgstr "O tamanho da chave de encriptação"

#: src/cryptsetup.c:382
msgid "BITS"
msgstr "BITS"

#: src/cryptsetup.c:383
msgid "The size of the device"
msgstr "O tamanho do dispositivo"

#: src/cryptsetup.c:383 src/cryptsetup.c:384 src/cryptsetup.c:385
#: src/cryptsetup.c:393
msgid "SECTORS"
msgstr "SECTORES"

#: src/cryptsetup.c:384
msgid "The start offset in the backend device"
msgstr "Início do deslocamento no backend dispositivo"

#: src/cryptsetup.c:385
msgid "How many sectors of the encrypted data to skip at the beginning"
msgstr "Quantos sectores dos dados encriptados saltar ao início"

#: src/cryptsetup.c:386
msgid "Create a readonly mapping"
msgstr "Criar um mapeamento só de leitura"

#: src/cryptsetup.c:387
msgid "PBKDF2 iteration time for LUKS (in ms)"
msgstr "Tempo de iteração PBKDF2 para LUKS (em ms)"

#: src/cryptsetup.c:388
msgid "msecs"
msgstr "milisegs"

#: src/cryptsetup.c:389
msgid "Do not ask for confirmation"
msgstr "Não pedir confirmação"

#: src/cryptsetup.c:390
msgid "Print package version"
msgstr "Imprimir versão do pacote"

#: src/cryptsetup.c:391
msgid "Timeout for interactive passphrase prompt (in seconds)"
msgstr "Tempo máximo de espera para linha de comando da frase-passe"

#: src/cryptsetup.c:391
msgid "secs"
msgstr "segs"

#: src/cryptsetup.c:392
msgid "How often the input of the passphrase can be retried"
msgstr "Número de tentativas permitido para a escrita da palavra-passe."

#: src/cryptsetup.c:393
msgid "Align payload at <n> sector boundaries - for luksFormat"
msgstr "Alinhe payload em <n> limites do setor - para luksFormat"

#: src/cryptsetup.c:409
msgid "[OPTION...] <action> <action-specific>]"
msgstr "[OPCÃO...] <acção> <acção especifíca>]"

#: src/cryptsetup.c:445
msgid "Key size must be a multiple of 8 bits"
msgstr "Tamanho da chave deve ser múltiplo de 8 bits"

#: src/cryptsetup.c:449
msgid "Argument <action> missing."
msgstr "Argumento <acção> em falta."

#: src/cryptsetup.c:455
msgid "Unknown action."
msgstr "Acção desconhecida."

#: src/cryptsetup.c:470
#, c-format
msgid "%s: requires %s as arguments"
msgstr "%s: requer %s como argumentos"
