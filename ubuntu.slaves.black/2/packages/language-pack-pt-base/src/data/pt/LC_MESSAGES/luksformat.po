#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Este programa necessita de ser iniciado como root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Criar e formatar um dispositivo encriptado com LUKS\n"
"Utilização: luksformat [-t <sistema ficheiros>] <dispositivo> [mkfs opções]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Erro: dispositivo montado: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Erro: ficheiro de sistema inválido: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Erro: não foi possível gerar nome do dispositivo mapeado temporário"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "A criar dispositivo encriptado em %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Não foi possível criar o dispositivo LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Por favor, digite sua senha novamente para verificá-la\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "As senhas que digitou, não são iguais\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr ""
"Não foi possível formatar o dispositivo com o sistema de ficheiros %s"
