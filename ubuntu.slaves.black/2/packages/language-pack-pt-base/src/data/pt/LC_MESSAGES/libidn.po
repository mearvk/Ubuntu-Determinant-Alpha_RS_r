#: src/idn.c:65
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr ""

#: src/idn.c:69
#, c-format
msgid "Usage: %s [OPTION]... [STRINGS]...\n"
msgstr "Utilização: %s [OPÇÃO]... [STRINGS]...\n"

#: src/idn.c:72
msgid ""
"Internationalized Domain Name (IDN) convert STRINGS, or standard input.\n"
"\n"
msgstr ""
"Nome de domínio internacionalizado (IDN) converter STRINGS, ou entrada de "
"estandardização.\n"
"\n"

#: src/idn.c:76
msgid ""
"Command line interface to the internationalized domain name library.\n"
"\n"
"All strings are expected to be encoded in the preferred charset used\n"
"by your locale.  Use --debug to find out what this charset is.  You\n"
"can override the charset used by setting environment variable CHARSET.\n"
"\n"
"To process a string that starts with '-', for example '-foo', use '--'\n"
"to signal the end of parameters, as in: idn --quiet -a -- -foo\n"
"\n"
"Mandatory arguments to long options are mandatory for short options too.\n"
msgstr ""

#: src/idn.c:88
msgid ""
"  -h, --help               Print help and exit\n"
"  -V, --version            Print version and exit\n"
msgstr ""
"  -h, --help               Imprime a ajuda e sai\n"
"  -V, --version            Imprime a versão e sai\n"

#: src/idn.c:92
msgid ""
"  -s, --stringprep         Prepare string according to nameprep profile\n"
"  -d, --punycode-decode    Decode Punycode\n"
"  -e, --punycode-encode    Encode Punycode\n"
"  -a, --idna-to-ascii      Convert to ACE according to IDNA (default mode)\n"
"  -u, --idna-to-unicode    Convert from ACE according to IDNA\n"
msgstr ""
"  -s, --stringprep         Prepara a string segundo o perfil nameprep\n"
"  -d, --punycode-decode    Descodifica Punycode\n"
"  -e, --punycode-encode    Codifica Punycode\n"
"  -a, --idna-to-ascii      Converte para ACE segundo IDNA (modo por "
"defeito)\n"
"  -u, --idna-to-unicode    Converte de ACE segundo IDNA\n"

#: src/idn.c:99
msgid ""
"      --allow-unassigned   Toggle IDNA AllowUnassigned flag (default off)\n"
"      --usestd3asciirules  Toggle IDNA UseSTD3ASCIIRules flag (default off)\n"
msgstr ""
"      --allow-unassigned   Alterna IDNA AllowUnassigned flag (default off)\n"
"      --usestd3asciirules  Alterna IDNA UseSTD3ASCIIRules flag (default "
"off)\n"

#: src/idn.c:103
msgid ""
"      --no-tld             Don't check string for TLD specific rules\n"
"                             Only for --idna-to-ascii and --idna-to-unicode\n"
msgstr ""
"      --no-tld             Não verifica por sequência para regras "
"específicas do TLD\n"
"                             Apenas para --idna-to-ascii e --idna-to-"
"unicode\n"

#: src/idn.c:107
msgid ""
"  -n, --nfkc               Normalize string according to Unicode v3.2 NFKC\n"
msgstr ""
"  -n, --nfkc               Normaliza a string segundo o Unicode v3.2 NFKC\n"

#: src/idn.c:110
msgid ""
"  -p, --profile=STRING     Use specified stringprep profile instead\n"
"                             Valid stringprep profiles: Nameprep\n"
"                             iSCSI Nodeprep Resourceprep trace SASLprep\n"
msgstr ""

#: src/idn.c:115
msgid ""
"      --debug              Print debugging information\n"
"      --quiet              Silent operation\n"
msgstr ""
"      --debug              Imprime informação para debugging\n"
"      --quiet              Operação silenciosa\n"

#: src/idn.c:173
#, c-format
msgid "only one of -s, -e, -d, -a, -u or -n can be specified"
msgstr "apenas um de-s, -e, -d, -a, -u or -n pode ser especificado"

#: src/idn.c:182
#, c-format
msgid "Charset: %s\n"
msgstr ""

#: src/idn.c:186
#, c-format
msgid ""
"Type each input string on a line by itself, terminated by a newline "
"character.\n"
msgstr ""
"Introduza cada string de entrada numa linha individual, terminando com o "
"símbolo de nova linha.\n"

