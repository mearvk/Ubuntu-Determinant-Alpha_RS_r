msgstr "%s irreconhecível no byte %s: %s"

#: ../debconf-mergetemplate:151
#, perl-format
msgid "%s is fuzzy at byte %s: %s; dropping it"
msgstr "%s irreconhecível no byte %s: %s; deixando-o cair"

#: ../debconf-mergetemplate:168
#, perl-format
msgid "%s is outdated"
msgstr "%s está desactualizado"

#: ../debconf-mergetemplate:173
#, perl-format
msgid "%s is outdated; dropping whole template!"
msgstr "%s está desactualizado; deixando todo o modelo!"

#: ../debconf:95
msgid "Usage: debconf [options] command [args]"
msgstr "Utilização: debconf [opções] comando [args]"

#: ../debconf:97
