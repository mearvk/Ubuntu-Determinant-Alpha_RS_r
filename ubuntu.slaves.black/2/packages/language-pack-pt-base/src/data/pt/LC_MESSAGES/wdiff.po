msgstr "Tente `%s --help' para mais informações\n"

#: src/unify.c:279
msgid "unify - Transforms context diffs into unidiffs, or vice-versa.\n"
msgstr "unify - Transforma diffs de contexto em unidiffs, ou vice-versa.\n"

#: src/unify.c:283
#, c-format
msgid "Usage: %s [OPTION]... [FILE]\n"
msgstr "Utilização: %s [OPÇÃO]... [FICHEIRO]\n"

#: src/unify.c:286
msgid "  -c, --context-diffs    force output to context diffs\n"
msgstr "  -c, --context-diffs    forçar saída para diffs de contexto\n"

#: src/unify.c:287
msgid "  -e, --echo-comments    echo comments to standard error\n"
msgstr "  -e, --echo-comments    ecoar comentários para erro padrão\n"

#: src/unify.c:288
msgid "  -o, --old-diffs        output old-style diffs, no matter what\n"
msgstr ""
"  -o, --old-diffs        saída de diffs ao estilo antigo, apesar de tudo\n"

#: src/unify.c:289
msgid "  -p, --patch-format     generate patch format\n"
msgstr "  -p, --patch-format     gerar formato de correcção\n"

#: src/unify.c:290
msgid "  -P                     same as -p\n"
msgstr "  -P                     igual a -p\n"

#: src/unify.c:291
msgid "  -s, --strip-comments   strip comment lines\n"
msgstr "  -s, --strip-comments   eliminar linhas de comentários\n"

#: src/unify.c:292
msgid "  -u, --unidiffs         force output to unidiffs\n"
msgstr "  -u, --unidiffs         forçar saída para unidiffs\n"

#: src/unify.c:293
msgid "  -U                     same as -p and -u\n"
msgstr "  -U                     o mesmo que -p e -u\n"

#: src/unify.c:294
msgid "  -=, --use-equals       replace spaces by equal signs in unidiffs\n"
msgstr ""
"  -=, --use-equals       substituir espaços por sinais iguais em unidiffs\n"

#: src/unify.c:298
msgid "If FILE is not specified, read standard input.\n"
msgstr "Se FICHEIRO não for especificado, ler entrada padrão.\n"

