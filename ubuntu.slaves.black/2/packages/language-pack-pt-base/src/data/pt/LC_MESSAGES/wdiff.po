#: src/mdiff.c:3769
msgid ""
"mdiff - Studies multiple files and searches for similar sequences, it then\n"
"produces possibly detailed lists of differences and similarities.\n"
msgstr ""
"mdiff - Estuda múltiplos ficheiros e procura sequências similares. Depois\n"
"produz listas possivelmente detalhadas de diferenças e semelhanças.\n"

#: src/mdiff.c:3774
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Utilização: %s [OPÇÃO]... [FICHEIRO]...\n"

#: src/mdiff.c:3778
msgid ""
"\n"
"Operation modes:\n"
msgstr ""
"\n"
"Modos de operação:\n"

#: src/mdiff.c:3779
msgid "  -h                     (ignored)\n"
msgstr "  -h                     (ignorado)\n"

#: src/mdiff.c:3780
msgid "  -v, --verbose          report a few statistics on stderr\n"
msgstr "  -v, --verbose          relatar algumas estatísticas em stderr\n"

#: src/mdiff.c:3781 src/unify.c:295
msgid "      --help             display this help then exit\n"
msgstr "      --help             mostrar esta ajuda ao sair\n"

#: src/mdiff.c:3782 src/unify.c:296
msgid "      --version          display program version then exit\n"
msgstr "      --version          mostrar versão de programa e depois sair\n"

#: src/mdiff.c:3784
msgid ""
"\n"
"Formatting output:\n"
msgstr ""
"\n"
"A formatar saída:\n"

#: src/mdiff.c:3785
msgid "  -T, --initial-tab       produce TAB instead of initial space\n"
msgstr "  -T, --initial-tab       produzir TAB em vez de espaço inicial\n"

#: src/mdiff.c:3786
msgid "  -l, --paginate          paginate output through `pr'\n"
msgstr "  -l, --paginate          paginar saída com `pr'\n"

#: src/mdiff.c:3787
msgid "  -S, --string[=STRING]   take note of another user STRING\n"
msgstr ""
"  -S, --string[=EXPRESSÃO]   tomar nota da EXPRESSÃO de outro utilizador\n"

#: src/mdiff.c:3788
msgid ""
"  -V, --show-links        give file and line references in annotations\n"
msgstr ""
"  -V, --show-links        fornecer referências de ficheiro e linha nas "
"anotações\n"

#: src/mdiff.c:3789
msgid "  -t, --expand-tabs       expand tabs to spaces in the output\n"
msgstr ""
"  -t, --expand-tabs       expandir tabulações para espaços na saída\n"

#: src/mdiff.c:3792
msgid ""
"\n"
"Debugging:\n"
msgstr ""
"\n"
"Depuração:\n"

#: src/mdiff.c:3793
msgid "  -0, --debugging   output many details about what is going on\n"
msgstr ""
"  -0, --debugging   mostrar muitos detalhes sobre o que está a acontecer\n"

#: src/mdiff.c:3796
msgid ""
"\n"
"Word mode options:\n"
msgstr ""
"\n"
"Opçoes de modo Palavras:\n"

#: src/mdiff.c:3797 src/wdiff.c:1251 src/wdiff2.c:190
msgid "  -1, --no-deleted           inhibit output of deleted words\n"
msgstr "  -1, --no-deleted           inibir saída de palavras apagadas\n"

#: src/mdiff.c:3798 src/wdiff.c:1252 src/wdiff2.c:191
msgid "  -2, --no-inserted          inhibit output of inserted words\n"
msgstr "  -2, --no-deleted           inibir saída de palavras inseridas\n"

#: src/mdiff.c:3799 src/wdiff.c:1253 src/wdiff2.c:192
msgid "  -3, --no-common            inhibit output of common words\n"
msgstr "  -3, --no-common            inibir saída de palavras comuns\n"

#: src/mdiff.c:3800
msgid "  -A, --auto-pager           automatically calls a pager\n"
msgstr "  -A, --auto-pager           automaticamente chama um paginador\n"

#: src/mdiff.c:3801
msgid "  -k, --less-mode            variation of printer mode for \"less\"\n"
msgstr ""
"  -k, --less-mode            variação do modo de impressora para \"menos\"\n"

#: src/mdiff.c:3802
msgid "  -m, --avoid-wraps          do not extend fields through newlines\n"
msgstr ""
"  -m, --avoid-wraps          não estender campos através de novas linhas\n"

#: src/mdiff.c:3803
msgid "  -o, --printer              overstrike as for printers\n"
msgstr "  -o, --printer              linha através como para impressoras\n"

#: src/mdiff.c:3804
msgid "  -z, --terminal             use termcap as for terminal displays\n"
msgstr ""
"  -z, --terminal             usar termcap para o visor de um terminal\n"

#: src/mdiff.c:3805
msgid "  -O, --item-regexp=REGEXP   compare items as defined by REGEXP\n"
msgstr ""
"  -O, --item-regexp=REGEXP   comparar itens tal como definido por REGEXP\n"

#: src/mdiff.c:3806
msgid "  -W, --word-mode            compare words instead of lines\n"
msgstr "  -W, --word-mode            comparar palavras em vez de linhas\n"

#: src/mdiff.c:3991
msgid "With no FILE, or when FILE is -, read standard input.\n"
msgstr "Com FICHEIRO, ou quando FICHEIRO está -, ler a entrada padrão.\n"

#: src/mdiff.c:3993 src/unify.c:300 src/wdiff.c:1269 src/wdiff2.c:210
msgid "Report bugs to <wdiff-bugs@gnu.org>.\n"
msgstr "Relatar erros para <wdiff-bugs@gnu.org>.\n"

#: src/mdiff.c:4005
#, c-format
msgid "ignoring option %s (not implemented)"
msgstr "a ignorar opção %s (não implementada)"

#: src/mdiff.c:4299
#, c-format
msgid "cannot use -z, termcap not available"
msgstr "não se pode usar -z, termcap não disponível"

#: src/mdiff.c:4338
#, c-format
msgid "word merging for two files only (so far)"
msgstr "fusão de palavras em dois ficheiros apenas (até agora)"

