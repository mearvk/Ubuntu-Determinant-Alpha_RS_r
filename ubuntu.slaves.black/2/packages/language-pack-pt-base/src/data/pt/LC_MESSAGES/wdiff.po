msgid ""
"wdiff - Compute word differences by internally launching `mdiff -W'.\n"
"This program exists mainly to support the now oldish `wdiff' syntax.\n"
msgstr ""
"wdiff - Computar diferenças de palavras lançando internamente `mdiff -W'.\n"
"Este programa existe principalmente para permitir a sintaxe antiga de "
"`wdiff'.\n"

#: src/wdiff2.c:182
#, c-format
msgid "Usage: %s [OPTION]... FILE1 FILE2\n"
msgstr "Utilização: %s [OPÇÃO]... FICHEIRO1 FICHEIRO2\n"

#: src/wdiff2.c:199
msgid "  -q, --quiet                inhibit the `mdiff' call message\n"
msgstr "  -q, --quiet                inibir mensagem de chamada `mdiff'\n"

#: src/wdiff2.c:208
msgid ""
"This program also tells how `mdiff' could have been called directly.\n"
msgstr ""
"Este programa também diz como `mdiff' podia ter sido chamado directamente.\n"

#. TRANSLATORS: This and the next string are one message.
#: src/wdiff2.c:332
#, c-format
msgid "Launching `%s"
msgstr "A lançar `%s"

#: src/wdiff2.c:335
#, c-format
msgid "'\n"
msgstr "'\n"
