#: lib/ifile.c:58
#, c-format
msgid "%s (child): failed to exec /bin/sh: %s\n"
msgstr "%s (filho): ocorreu falha na execução de /bin/sh: %s\n"

#: lib/ifile.c:104
#, c-format
msgid "%s: command (%s) failed (exit status %d)\n"
msgstr "%s: falhou o comando (%s) (estado de saida %d)\n"

#: lib/ifile.c:113
#, c-format
