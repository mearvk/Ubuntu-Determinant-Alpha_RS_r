#, c-format
msgid "%s: %s: cannot stat: %s\n"
msgstr "%s: %s não pode fazer stat: %s\n"

#: lib/ifile.c:142
msgid "is a directory, skipping"
msgstr "é um directório, ignorado"

#: lib/ifile.c:143
msgid "is a block device, skipping"
msgstr "é um dispositivo com blocos, ignorado"

#: lib/ifile.c:144
msgid "internal error"
msgstr "erro interno"

#: lib/ifile.c:145
msgid "is a socket, skipping"
msgstr "é uma socket,  ignorando"

#: lib/ifile.c:146
msgid "unknown file type, skipping"
msgstr "tipo de ficheiro desconhecido, ignorando"

#: lib/misc.c:37
