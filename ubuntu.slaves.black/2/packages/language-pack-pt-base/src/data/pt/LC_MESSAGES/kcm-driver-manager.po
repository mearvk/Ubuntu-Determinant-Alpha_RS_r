#: Module.cpp:77
msgctxt "@title/rich"
msgid "<title>Your computer requires no proprietary drivers</title>"
msgstr "<title>O Seu computador não requer drivers proprietários</title>"

#: Module.cpp:130
msgctxt ""
"The backend is trying to figure out what drivers are suitable for the users "
"system"
msgid "Collecting information about your system"
msgstr "A recolher informações sobre o sistema"

#: Module.cpp:220 DriverManager.cpp:248
msgctxt "@label"
msgid ""
"The package system could not be initialized, your configuration may be "
"broken."
msgstr ""
"Não foi possível inicializar o sistema de pacotes; a sua configuração poderá "
"estar inválida."

#: Module.cpp:232
msgctxt "The backend replied with a error"
msgid ""
"Something went terribly wrong. Please hit the 'Refresh Driver List' button"
msgstr ""
"Algo correu terrivelmente errado. Por favor, pressione o botão 'Atualizar "
"Lista Controladores'"

