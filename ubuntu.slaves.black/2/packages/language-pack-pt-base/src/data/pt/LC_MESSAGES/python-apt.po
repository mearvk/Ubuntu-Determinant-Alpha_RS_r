#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Servidor para %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Servidor principal"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Servidores personalizados"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Descrição em falta para '%s'. Por favor, comunique."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Unicode inválido na descrição para '%s' (%s). Por favor informe."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "A lista de alterações não está disponível."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"A lista de alterações ainda não está disponível.\n"
"\n"
"Por favor consulte http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"até que as alterações sejam disponibilizadas ou volte a tentar mais tarde."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Falha ao descarregar a lista de alterações. \n"
"Por favor verifique a sua ligação à Internet."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "A lista de ficheiros para '%s' não pode ser lida"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Lista de ficheiros de controlo de '%s' não pôde ser lido"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Dependência não pôde ser satisfeita: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Entra em conflito com o pacote instalado '%s'"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Quebra a dependência %(depname)s (%(deprelation)s %(depversion)s) do pacote "
"existente '%(pkgname)s'"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Quebra o conflito do pacote existente '%(pkgname)s': %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Quebra o pacote \\\"%(pkgname)s\\\" que entra em conflito com \\"
"\"%(targetpkg)s\\\". Mas \\\"%(debfile)s\\\" disponibiliza-o via \\"
"\"%(provides)s\\\"."

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Não existe campo de Arquitectura no pacote"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Arquitetura errada '%s' -- Execute o dpkg --add-architecture para a "
"adicionar e depois atualizar"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Uma versão mais recente já se encontra instalada"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Não foi possível satisfazer todas as dependências (cache quebrada)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Não é possível instalar '%s'"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Descomprimido automaticamente:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Convertido automaticamente para ASCII imprimível:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Instalar dependências de compilação para o pacote fonte '%s' que compila %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Um pacote essencial seria removido"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Completo"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Atingiu "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Obter:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [A trabalhar]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Troca de cd: por favor insira o disco com o nome\n"
" '%s'\n"
"na drive '%s' e carregue no enter.\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Obteve %sB em %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""
"Por favor, forneça um nome para esta unidade, como 'Debian 2.1r1 Disk 1'"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Por favor, insira uma unidade de instalação e pressione enter"
