#: ../whois.c:1501
#, c-format
msgid ""
"Usage: whois [OPTION]... OBJECT...\n"
"\n"
"-h HOST, --host HOST   connect to server HOST\n"
"-p PORT, --port PORT   connect to PORT\n"
"-I                     query whois.iana.org and follow its referral\n"
"-H                     hide legal disclaimers\n"
msgstr ""
"Utilização: whois [OPTION]... OBJECT...\n"
"\n"
"-h HOST, --host HOST   ligar ao servidor HOST\n"
"-p PORT, --port PORT   ligar à porta PORT\n"
"-I                     consulta whois.iana.org e segue as suas referências\n"
"-H                     ocultar isenções de responsabilidade\n"

#: ../whois.c:1508
#, c-format
msgid ""
"      --verbose        explain what is being done\n"
"      --no-recursion   disable recursion from registry to registrar servers\n"
"      --help           display this help and exit\n"
"      --version        output version information and exit\n"
"\n"
msgstr ""

#: ../whois.c:1515
#, c-format
msgid ""
"These flags are supported by whois.ripe.net and some RIPE-like servers:\n"
"-l                     find the one level less specific match\n"
"-L                     find all levels less specific matches\n"
"-m                     find all one level more specific matches\n"
"-M                     find all levels of more specific matches\n"
msgstr ""
"Estas flags são suportadas por whois.ripe.net e alguns servidores do tipo "
"RIPE:\n"
"-l encontrar o nível menos específico de correspondência\n"
"-L encontrar todos os níveis menos específicos\n"
"-m encontrar todos primeiros níveis mais específico de correspondência\n"
"-M encontrar todos os níveis mais específico de correspondência\n"

#: ../whois.c:1522
#, c-format
msgid ""
"-c                     find the smallest match containing a mnt-irt "
"attribute\n"
"-x                     exact match\n"
"-b                     return brief IP address ranges with abuse contact\n"
msgstr ""
"-c                     encontrar a correspondência menos especifica contendo "
"o atributo mnt-irt\n"
"-x                     correspondência exacta\n"
"-b                     retorna breves gamas de endereçamento IP com o "
"contacto de abuso\n"

#: ../whois.c:1527
#, c-format
msgid ""
"-B                     turn off object filtering (show email addresses)\n"
"-G                     turn off grouping of associated objects\n"
"-d                     return DNS reverse delegation objects too\n"
msgstr ""
"-B                     desligar a filtragem de objectos (mostrar endereços "
"de e-mail)\n"
"-G                     desligar o agrupamento de objectos associados\n"
"-d                     devolver também os objectos da delegação inversa do "
"DNS\n"

#: ../whois.c:1532
#, c-format
msgid ""
"-i ATTR[,ATTR]...      do an inverse look-up for specified ATTRibutes\n"
"-T TYPE[,TYPE]...      only look for objects of TYPE\n"
"-K                     only primary keys are returned\n"
"-r                     turn off recursive look-ups for contact information\n"
msgstr ""
"-i ATR[,ATR]...        fazer uma pesquisa inversa para ATRibutos "
"especificados\n"
"-T TIPO[,TIPO]...      procurar apenas objectos de TIPO\n"
"-K                     apenas as chaves primárias são devolvidas\n"
"-r                     desligar as consultas recursivas para informação de "
"contacto\n"

#: ../whois.c:1538
#, c-format
msgid ""
"-R                     force to show local copy of the domain object even\n"
"                       if it contains referral\n"
"-a                     also search all the mirrored databases\n"
"-s SOURCE[,SOURCE]...  search the database mirrored from SOURCE\n"
"-g SOURCE:FIRST-LAST   find updates from SOURCE from serial FIRST to LAST\n"
msgstr ""
"-R                     forçar a mostrar uma cópia local do objecto de "
"domínio,\n"
"                       mesmo que contenha uma referência\n"
"-a                     pesquisar também todas as bases de dados replicadas\n"
"-s FONTE[,FONTE]...  pesquisar na base de dados réplica a partir de FONTE\n"
"-g FONTE:PRIMEIRA-ÚLTIMA   encontrar actualizações de FONTE desde PRIMEIRA "
"série à ÚLTIMA\n"

#: ../whois.c:1545
#, c-format
msgid ""
"-t TYPE                request template for object of TYPE\n"
"-v TYPE                request verbose template for object of TYPE\n"
"-q [version|sources|types]  query specified server info\n"
msgstr ""
"-t TIPO                pede modelo para objecto do TIPO\n"
"-v TIPO                pede modelo completo para objecto do TIPO\n"
"-q [version|sources|types]  consultar informações de servidor especificadas\n"

