msgid "File does not exist."
msgstr "O ficheiro não existe."

#: ../bin/apport-cli.py:402 ../debian/tmp/usr/bin/apport-cli.py:402
msgid "This is a directory."
msgstr "Isto é um directório."

#: ../bin/apport-cli.py:407 ../debian/tmp/usr/bin/apport-cli.py:407
