#: ../bin/apport-cli.py:283 ../debian/tmp/usr/bin/apport-cli.py:283
msgid ""
"The collected information can be sent to the developers to improve the\n"
"application. This might take a few minutes."
msgstr ""
"A informação recolhida pode ser enviada aos programadores de modo a "
"melhorar\n"
"a aplicação. Isto pode demorar alguns minutos."

#: ../bin/apport-cli.py:301 ../debian/tmp/usr/bin/apport-cli.py:301
msgid ""
"The collected information is being sent to the bug tracking system.\n"
"This might take a few minutes."
msgstr ""
"A informação recolhida está a ser enviada ao sistema de rastreio de erros.\n"
"Isto pode demorar alguns minutos."

#: ../bin/apport-cli.py:357 ../debian/tmp/usr/bin/apport-cli.py:357
msgid "&Done"
msgstr "&Concluído"

#: ../bin/apport-cli.py:363 ../debian/tmp/usr/bin/apport-cli.py:363
msgid "none"
msgstr "nenhum"

