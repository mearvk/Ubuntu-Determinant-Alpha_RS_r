#: ../apport/ui.py:1589
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:1589
msgid ""
"You have two versions of this application installed, which one do you want "
"to report a bug against?"
msgstr ""
"Tem duas versões instaladas deste programa, de qual quer reportar um erro?"

#: ../apport/ui.py:1594
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:1594
#, python-format
msgid "%s snap"
msgstr "snap %s"

#: ../apport/ui.py:1595
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:1595
