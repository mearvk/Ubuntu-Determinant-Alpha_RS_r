#: Module.cpp:65
#, kde-format
msgctxt "@info"
msgid ""
"Kubuntu can collect anonymous information that helps developers improve it. "
"All information collected is covered by our <link url='%1'>privacy "
"policy</link>."
msgstr ""
"Kubuntu pode recolher informações de forma anónima que ajuda os "
"programadores a o melhorar. Todas as informações recolhidas estão ao abrigo "
"da nossa <link url='%1'>política de privacidade</link>."

#: Module.cpp:123
#, kde-format
