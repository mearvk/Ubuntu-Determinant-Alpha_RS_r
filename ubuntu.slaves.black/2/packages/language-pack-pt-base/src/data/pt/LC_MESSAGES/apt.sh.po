#: dselect/install:33
msgid "Bad default setting!"
msgstr "Configuração padrão Errada!"

#: dselect/install:52 dselect/install:84 dselect/install:88 dselect/install:95
#: dselect/install:106 dselect/update:45
msgid "Press [Enter] to continue."
msgstr "Pressione [Enter] para continuar."

#: dselect/install:92
msgid "Do you want to erase any previously downloaded .deb files?"
msgstr "Deseja apagar quaisquer ficheiros .deb anteriormente descarregados?"

#: dselect/install:102
msgid "Some errors occurred while unpacking. Packages that were installed"
msgstr ""
"Ocorreram alguns erros enquanto descompactavam. Os pacotes que foram "
"instalados"

#: dselect/install:103
msgid "will be configured. This may result in duplicate errors"
msgstr "serão configurados. Isto pode resultar em erros duplicados"

#: dselect/install:104
msgid "or errors caused by missing dependencies. This is OK, only the errors"
msgstr "ou causados por dependências em falta. Isso é OK, apenas os erros"

#: dselect/install:105
msgid ""
"above this message are important. Please fix them and run [I]nstall again"
msgstr ""
"acima desta mensagem é importante. Por favor resolva-os e execute [I]nstalar "
"novamente"

#: dselect/update:30
msgid "Merging available information"
msgstr "Fundir a informação disponível"
