#: libwnck/wnckprop.c:277
msgid "Change the width of the window to WIDTH"
msgstr "ୱିଣ୍ଡୋର ଓସାରକୁ WIDTHକୁ ପରିବର୍ତ୍ତନ କରନ୍ତୁ"

#: libwnck/wnckprop.c:277
msgid "WIDTH"
msgstr "WIDTH"

#: libwnck/wnckprop.c:279
msgid "Change the height of the window to HEIGHT"
