"anullacion\n"

#: tools/setfacl.c:173
#, c-format
msgid "%s: %s: %s in line %d\n"
msgstr "%s : %s : %s a la linha %d\n"

#: tools/setfacl.c:205
#, c-format
msgid "%s: %s: Cannot change owner/group: %s\n"
msgstr "%s : %s : impossible de cambiar de proprietari/grop : %s\n"

#: tools/setfacl.c:224
#, c-format
msgid "%s: %s: Cannot change mode: %s\n"
msgstr "%s : %s : Impossible de cambiar lo mòde : %s\n"

#: tools/setfacl.c:266
#, c-format
msgid "%s %s -- set file access control lists\n"
msgstr ""
"%s %s -- definir las listas de contraròtle d'accès dels fichièrs (ACL)\n"

#: tools/setfacl.c:268 tools/setfacl.c:653
#, c-format
msgid "Usage: %s %s\n"
msgstr "Utilizacion : %s %s\n"

#: tools/setfacl.c:271
#, c-format
msgid ""
"  -m, --modify=acl        modify the current ACL(s) of file(s)\n"
"  -M, --modify-file=file  read ACL entries to modify from file\n"
"  -x, --remove=acl        remove entries from the ACL(s) of file(s)\n"
"  -X, --remove-file=file  read ACL entries to remove from file\n"
"  -b, --remove-all        remove all extended ACL entries\n"
"  -k, --remove-default    remove the default ACL\n"
msgstr ""
"  -m, --modify=acl           modificar l'ACL(s) actual de fichièr(s)\n"
"  -M, --modify-file=fichièr  legir l'entrada ACL de modificar del fichièr\n"
"  -x, --remove=acl           suprimir las entradas de l'ACL del fichièr\n"
"  -X, --remove-file=fichièr  legir las entradas ACL de suprimir del fichièr\n"
"  -b, --remove-all           suprimir totas las entradas ACL espandidas\n"
"  -k, --remove-default       suprimir l'ACL per defaut\n"

#: tools/setfacl.c:280
#, c-format
msgid ""
"      --set=acl           set the ACL of file(s), replacing the current ACL\n"
"      --set-file=file     read ACL entries to set from file\n"
"      --mask              do recalculate the effective rights mask\n"
msgstr ""
"      --set=acl definís l'ACL del(s) fichièr(s), que remplaça(n) e tanben "
"l'ACL corrent\n"
"      --set-file=file legís las entradas ACL de definir dempuèi un fichièr\n"
"      --mask recalcula las masquetas de dreches en vigor\n"

#: tools/setfacl.c:286
#, c-format
msgid ""
"  -n, --no-mask           don't recalculate the effective rights mask\n"
"  -d, --default           operations apply to the default ACL\n"
msgstr ""
"  -n, --no-mask           recalcular pas las masquetas de dreches en vigor\n"
"  -d, --default           las operacions s'aplican a l'ACL per defaut\n"

#: tools/setfacl.c:291
#, c-format
msgid ""
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"      --restore=file      restore ACLs (inverse of `getfacl -R')\n"
"      --test              test mode (ACLs are not modified)\n"
msgstr ""
"  -R, --recursive         percórrer recursivament los sosrepertòris\n"
"  -L, --logical           seguir los ligams simbolics\n"
"  -P, --physical         seguir pas los ligams simbolics\n"
"      --restore=fichier   restablir los ACL (invèrse de « getfacl -R »)\n"
"      --test              mòde tèst (los ACL son pas modificats)\n"

#: tools/setfacl.c:299 tools/getfacl.c:597
#, c-format
msgid ""
"  -v, --version           print version and exit\n"
"  -h, --help              this help text\n"
msgstr ""
"  -v, --version           aficha la version e quita\n"
"  -h, --help              aficha aqueste tèxte d'ajuda\n"

#: tools/setfacl.c:316 tools/getfacl.c:743
#, c-format
msgid "%s: Standard input: %s\n"
msgstr "%s : Sortida estandarda : %s\n"

#: tools/setfacl.c:452
#, c-format
msgid "%s: Option -%c incomplete\n"
msgstr "%s : Opcion -%c incompleta\n"

#: tools/setfacl.c:457
#, c-format
msgid "%s: Option -%c: %s near character %d\n"
msgstr "%s : Opcion -%c : %s prèp del caractèr %d\n"

#: tools/setfacl.c:533
#, c-format
msgid "%s: %s in line %d of file %s\n"
msgstr "%s : %s a la linha %d del fichièr %s\n"

#: tools/setfacl.c:541
#, c-format
msgid "%s: %s in line %d of standard input\n"
msgstr "%s : %s a la linha %d de la sortida estandarda\n"

#: tools/setfacl.c:655 tools/getfacl.c:758
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Ensajatz '%s --help' per mai d'entresenhas.\n"

#: tools/getfacl.c:498
#, c-format
msgid "%s: Removing leading '/' from absolute path names\n"
msgstr "%s : supression del primièr « / » dels noms de camins absoluts\n"

#: tools/getfacl.c:569
#, c-format
msgid "%s %s -- get file access control lists\n"
msgstr "%s %s -- obténer las listas de contraròtle d'accès del fichièr\n"

#: tools/getfacl.c:571 tools/getfacl.c:756
#, c-format
msgid "Usage: %s [-%s] file ...\n"
msgstr "Utilizacion : %s [-%s] fichièr...\n"

#: tools/getfacl.c:577
#, c-format
msgid "  -d, --default           display the default access control list\n"
msgstr "  -d, --default afichar la lista de contraròtle d'accès per defaut\n"

#: tools/getfacl.c:581
#, c-format
msgid ""
"  -a, --access            display the file access control list only\n"
"  -d, --default           display the default access control list only\n"
"  -c, --omit-header       do not display the comment header\n"
"  -e, --all-effective     print all effective rights\n"
"  -E, --no-effective      print no effective rights\n"
"  -s, --skip-base         skip files that only have the base entries\n"
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"  -t, --tabular           use tabular output format\n"
"  -n, --numeric           print numeric user/group identifiers\n"
"      --one-file-system   skip files on different filesystems\n"
"  -p, --absolute-names    don't strip leading '/' in pathnames\n"
msgstr ""
