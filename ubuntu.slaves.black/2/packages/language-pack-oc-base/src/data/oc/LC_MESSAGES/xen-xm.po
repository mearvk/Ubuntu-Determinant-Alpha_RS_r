#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Error intèrna : %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Aquesta mapa conten ja %(1)s -> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Lo metòde %(1)s es pas suportat."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Lo metòde %(1)s pren %(2)s argument(s) (%(3)s donadas)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Permission refusada."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"La valor \"%(2)s\" per %(1)s es pas suportada per aqueste servidor. Lo "
"servidor a respondut \"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "L'utilizacion de %(1)s per gerir %(2)s es invalida."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Avètz temptat una operacion pas autorizada."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"La ret qu'avètz especificada possedís ja un PIF estacat, doncas, se ne pòt "
"pas apondre un segond."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
