#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Aqueste programa deu èsser aviat en tant qu'utilizaire root\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Crear e formatar de periferics chifrats LUKS\n"
"Utilizacion : luksformat [-t <sistèma de fichièr>] <periferic> [ mkfs "
"options]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Error : periferic montat : %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Error : sistèma de fichièr invalid : %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr ""
"Error : impossible de generar temporàriament lo nom del periferic connectat"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Creacion del periferic chifrat sus %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Impossible de crear lo periferic LUKS %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Picatz vòstra frasa secreta tornarmai per la confirmar\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Las frasas secretas qu'avètz picadas èran pas identicas\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Impossible de formatar lo periferic amb lo sistèma de fichièr %s"
