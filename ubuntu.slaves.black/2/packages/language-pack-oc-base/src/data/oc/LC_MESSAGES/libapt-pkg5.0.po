#, c-format
msgid "Failed to readlink %s"
msgstr "Impossible de legir lo ligam %s"

#: apt-pkg/acquire-item.cc:552
#, c-format
msgid "Failed to stat %s"
msgstr "Impossible d'estatuar %s"

