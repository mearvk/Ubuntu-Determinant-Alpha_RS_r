#: src/envsubst.c:184
#, c-format, no-wrap
msgid "Substitutes the values of environment variables.\n"
msgstr "Substituir las valors de las variablas d'environament.\n"

#: src/envsubst.c:188
#, c-format, no-wrap
msgid "Operation mode:\n"
msgstr "Mòde d'execucion :\n"

#: src/envsubst.c:191
#, c-format, no-wrap
msgid ""
"  -v, --variables             output the variables occurring in SHELL-"
"FORMAT\n"
msgstr ""
"  -v, --variables             afichar las variablas qu'apareisson dins "
"FORMAT-SHELL\n"

#: src/envsubst.c:195 src/gettext.c:275 src/ngettext.c:241
#, c-format, no-wrap
msgid "Informative output:\n"
msgstr "Sortida informativa :\n"

#: src/envsubst.c:198
#, c-format, no-wrap
