#: sed/sed.c:133
#, c-format
msgid ""
"Usage: %s [OPTION]... {script-only-if-no-other-script} [input-file]...\n"
"\n"
msgstr ""
"Utilizacion: %s [OPTION]... {escript-solament-se-pas-d'autre-escript}\n"
"[fichièr-d'entrada]...\n"
"\n"

#: sed/sed.c:137
#, c-format
msgid ""
"  -n, --quiet, --silent\n"
"                 suppress automatic printing of pattern space\n"
msgstr ""
"  -n, --quiet, --silent\n"
"suprimir l'escritura automatica de l'espaci dels motius\n"

#: sed/sed.c:139
#, c-format
msgid ""
"      --debug\n"
"                 annotate program execution\n"
msgstr ""

#: sed/sed.c:141
#, c-format
msgid ""
"  -e script, --expression=script\n"
"                 add the script to the commands to be executed\n"
msgstr ""
"  -e script, --expression=escript\n"
"                apondre l'escript a las comandas d'executar\n"

#: sed/sed.c:143
#, c-format
msgid ""
"  -f script-file, --file=script-file\n"
"                 add the contents of script-file to the commands to be "
"executed\n"
msgstr ""
"  -f fichier-script, --file=fichièr-escript\n"
"            apondre lo contengut de fichièr-escript a las comandas\n"
"d'executar\n"

#: sed/sed.c:147
#, c-format
msgid ""
"  --follow-symlinks\n"
"                 follow symlinks when processing in place\n"
msgstr ""
"  --follow-symlinks\n"
"                 seguir los ligams simbolics pendent lo tractament\n"

#: sed/sed.c:150
#, c-format
msgid ""
"  -i[SUFFIX], --in-place[=SUFFIX]\n"
"                 edit files in place (makes backup if SUFFIX supplied)\n"
msgstr ""

#: sed/sed.c:153
#, c-format
msgid ""
"  -b, --binary\n"
"                 open files in binary mode (CR+LFs are not processed "
"specially)\n"
msgstr ""
"  -b, --binary\n"
"                 dobrir los fichièrs en mòde binari (CR+LF son pas tractats "
"coma una excepcion)\n"

#: sed/sed.c:157
#, c-format
msgid ""
"  -l N, --line-length=N\n"
"                 specify the desired line-wrap length for the `l' command\n"
msgstr ""
"  -l N, --line-length=N\n"
"                especificar la longor de copadura de linha desirada per la\n"
"                comanda `l'\n"

#: sed/sed.c:159
#, c-format
msgid ""
"  --posix\n"
"                 disable all GNU extensions.\n"
msgstr ""
"  --posix\n"
"                 desactivar totas las extensions GNU.\n"

#: sed/sed.c:161
#, c-format
msgid ""
"  -E, -r, --regexp-extended\n"
"                 use extended regular expressions in the script\n"
"                 (for portability use POSIX -E).\n"
msgstr ""

#: sed/sed.c:164
#, c-format
msgid ""
"  -s, --separate\n"
"                 consider files as separate rather than as a single,\n"
"                 continuous long stream.\n"
msgstr ""

#: sed/sed.c:167
#, c-format
msgid ""
"      --sandbox\n"
"                 operate in sandbox mode (disable e/r/w commands).\n"
msgstr ""

#: sed/sed.c:169
#, c-format
msgid ""
"  -u, --unbuffered\n"
"                 load minimal amounts of data from the input files and "
"flush\n"
"                 the output buffers more often\n"
msgstr ""

#: sed/sed.c:172
#, c-format
msgid ""
"  -z, --null-data\n"
"                 separate lines by NUL characters\n"
msgstr ""

#: sed/sed.c:174
#, c-format
msgid "      --help     display this help and exit\n"
msgstr "      --help afichar aquesta ajuda e sortir\n"

#: sed/sed.c:175
#, c-format
msgid "      --version  output version information and exit\n"
msgstr ""
"      --version afichar las informacions de version del logicial e sortir\n"

#: sed/sed.c:176
#, c-format
msgid ""
"\n"
"If no -e, --expression, -f, or --file option is given, then the first\n"
"non-option argument is taken as the sed script to interpret.  All\n"
"remaining arguments are names of input files; if no input files are\n"
"specified, then the standard input is read.\n"
"\n"
msgstr ""

