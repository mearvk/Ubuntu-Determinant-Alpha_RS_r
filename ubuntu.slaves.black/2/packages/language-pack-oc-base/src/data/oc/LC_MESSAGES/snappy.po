#, c-format
msgid "%d minute left"
msgid_plural "%d minutes left"
msgstr[0] "encara %d minuta"
msgstr[1] "encara %d minutas"

#: cmd/snap/error.go:114
#, c-format
msgid ""
"%q does not contain an unpacked snap.\n"
"\n"
"Try 'snapcraft prime' in your project directory, then 'snap try' again."
msgstr "%q conten pas cap de paquet Snap despaquetat."

