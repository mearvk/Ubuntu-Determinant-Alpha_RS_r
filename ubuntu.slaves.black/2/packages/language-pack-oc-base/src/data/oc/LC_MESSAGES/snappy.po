#, c-format
msgid "%d day left"
msgid_plural "%d days left"
msgstr[0] "encara %d jorn"
msgstr[1] "encara %d jorns"

#: usersession/agent/rest_api.go:261
#, c-format
msgid "%d hour left"
msgid_plural "%d hours left"
msgstr[0] "encara %d ora"
msgstr[1] "encara %d oras"

