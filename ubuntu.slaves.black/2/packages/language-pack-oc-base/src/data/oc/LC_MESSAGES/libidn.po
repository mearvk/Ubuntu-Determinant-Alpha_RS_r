msgid "String not idempotent under Unicode NFKC normalization"
msgstr "La cadena es pas idempotenta jos la normalizacion Unicode NFKC"

#: lib/strerror-punycode.c:70
msgid "Invalid input"
msgstr "Picada incorrècta"

#: lib/strerror-punycode.c:74 lib/strerror-stringprep.c:111
msgid "Output would exceed the buffer space provided"
msgstr "La sortica excediriá l'espaci tampon provesit"

#: lib/strerror-punycode.c:78
msgid "String size limit exceeded"
msgstr "Lo limit de la talha de la cadena es depassat"

#: lib/strerror-stringprep.c:91
msgid "Forbidden unassigned code points in input"
msgstr "Interdiccion de còdes punts pas affectada dins l'entrada"

#: lib/strerror-stringprep.c:95
msgid "Prohibited code points in input"
msgstr "Còdes punts proïbits dins l'entrada"

#: lib/strerror-stringprep.c:99
msgid "Conflicting bidirectional properties in input"
msgstr "Proprietats bidireccionalas conflictualas dins l'entrada"

#: lib/strerror-stringprep.c:103
msgid "Malformed bidirectional string"
msgstr "Cadena bidireccionala mal compausada"

#: lib/strerror-stringprep.c:107
msgid "Prohibited bidirectional code points in input"
msgstr "Còdes punts bidireccionals proïbits dins l'entrada"

#: lib/strerror-stringprep.c:115
msgid "Error in stringprep profile definition"
msgstr "Error dins la definicion de perfil de stringprep"

#: lib/strerror-stringprep.c:119
msgid "Flag conflict with profile"
msgstr "Conflicte de bandièras amb lo perfil"

#: lib/strerror-stringprep.c:123
msgid "Unknown profile"
msgstr "Perfil desconegut"

#: lib/strerror-stringprep.c:131
msgid "Unicode normalization failed (internal error)"
msgstr "La normalizacion Unicode a fracassat (error intèrna)"

#: lib/strerror-tld.c:72
msgid "Code points prohibited by top-level domain"
msgstr "Còdes punts proïbits pel domeni de naut nivèl"

#: lib/strerror-tld.c:76
msgid "Missing input"
msgstr "Entrada mancanta"

#: lib/strerror-tld.c:88
msgid "No top-level domain found in input"
msgstr "Cap de domeni de naut nivèl es pas estat reperat dins l'entrada"

#: src/idn.c:65
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr ""

#: src/idn.c:69
#, c-format
msgid "Usage: %s [OPTION]... [STRINGS]...\n"
msgstr "Usatge : %s [OPCION]... [STRINGS]...\n"

#: src/idn.c:72
msgid ""
"Internationalized Domain Name (IDN) convert STRINGS, or standard input.\n"
"\n"
msgstr ""
"Nom de domeni internacionalizat (IDN) convertís los STRINGS, o las entradas "
"estandardas.\n"
"\n"

#: src/idn.c:76
msgid ""
"Command line interface to the internationalized domain name library.\n"
"\n"
"All strings are expected to be encoded in the preferred charset used\n"
"by your locale.  Use --debug to find out what this charset is.  You\n"
"can override the charset used by setting environment variable CHARSET.\n"
"\n"
"To process a string that starts with '-', for example '-foo', use '--'\n"
"to signal the end of parameters, as in: idn --quiet -a -- -foo\n"
"\n"
"Mandatory arguments to long options are mandatory for short options too.\n"
msgstr ""

#: src/idn.c:88
msgid ""
"  -h, --help               Print help and exit\n"
"  -V, --version            Print version and exit\n"
msgstr ""
"  -h, --help               Imprimís l'ajuda e quita\n"
"  -V, --version            Imprimís la version e quita\n"

#: src/idn.c:92
msgid ""
"  -s, --stringprep         Prepare string according to nameprep profile\n"
"  -d, --punycode-decode    Decode Punycode\n"
"  -e, --punycode-encode    Encode Punycode\n"
"  -a, --idna-to-ascii      Convert to ACE according to IDNA (default mode)\n"
"  -u, --idna-to-unicode    Convert from ACE according to IDNA\n"
msgstr ""
"  -s, --stringprep         Tracta la cadena en foncion del perfil nameprep\n"
"  -d, --punycode-decode    Desencòda lo Punycode\n"
"  -e, --punycode-encode    Encòda lo Punycode\n"
"  -a, --idna-to-ascii      Convertís cap a ACE segon lo mòde IDNA (mòde per "
"defaut)\n"
"  -u, --idna-to-unicode    Convertís dempuèi ACE segon IDNA\n"

#: src/idn.c:99
msgid ""
"      --allow-unassigned   Toggle IDNA AllowUnassigned flag (default off)\n"
"      --usestd3asciirules  Toggle IDNA UseSTD3ASCIIRules flag (default off)\n"
msgstr ""
"      --allow-unassigned   Bascuola lo drapèu AllowUnassigned d'IDNA\n"
"                             (desactivat per defaut).\n"
"      --usestd3asciirules  Bascuola lo drapèu UseSTD3ASCIIRules d'IDNA\n"
"                             (desactivat per defaut).\n"

#: src/idn.c:103
msgid ""
"      --no-tld             Don't check string for TLD specific rules\n"
"                             Only for --idna-to-ascii and --idna-to-unicode\n"
msgstr ""
"      --no-tld             Verificar pas las règlas especificas als domenis\n"
"                             de primièr nivèl (TLD). Unicament valable per\n"
"                             --idna-to-ascii e --idna-to-unicode\n"

#: src/idn.c:107
msgid ""
"  -n, --nfkc               Normalize string according to Unicode v3.2 NFKC\n"
msgstr ""
"  -n, --nfkc               Uniformiza la cadena en foncion d'Unicode v3.2 "
"NFKC\n"

#: src/idn.c:110
msgid ""
"  -p, --profile=STRING     Use specified stringprep profile instead\n"
"                             Valid stringprep profiles: Nameprep\n"
"                             iSCSI Nodeprep Resourceprep trace SASLprep\n"
msgstr ""

#: src/idn.c:115
msgid ""
"      --debug              Print debugging information\n"
"      --quiet              Silent operation\n"
msgstr ""
"      --debug              Imprimís las donadas de desbugatge\n"
"      --quiet              Mòde silenciós\n"

#: src/idn.c:173
#, c-format
msgid "only one of -s, -e, -d, -a, -u or -n can be specified"
msgstr "Una sola opcion demest -s, -e, -d, -a, -u e -n pòt èsser indicada"

#: src/idn.c:182
#, c-format
msgid "Charset: %s\n"
msgstr ""

#: src/idn.c:186
#, c-format
msgid ""
"Type each input string on a line by itself, terminated by a newline "
"character.\n"
msgstr ""
"Picatz cada cadena sus una sola linha acabada per un retorn de carriòt.\n"

