msgstr "La foncion sistèma dlopen() a fracassat"

#: lib/strerror-idna.c:130 lib/strerror-pr29.c:78 lib/strerror-punycode.c:82
#: lib/strerror-stringprep.c:139 lib/strerror-tld.c:92
msgid "Unknown error"
msgstr "Error desconeguda"

