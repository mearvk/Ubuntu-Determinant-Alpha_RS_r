#: src/args.c:673
msgid ""
"usage: indent file [-o outfile ] [ options ]\n"
"       indent file1 file2 ... fileN [ options ]\n"
msgstr ""
"emplec : indent fichièr [-o sortida] [opcions]\n"
"         indent fichièr1 fichièr2 … fichièrN [opcions]\n"

#: src/args.c:740
#, c-format
msgid "%s: missing argument to parameter %s\n"
msgstr "%s : manca una valor per l’opcion %s\n"

#: src/args.c:864
#, c-format
msgid "%s: unknown option \"%s\"\n"
msgstr "%s : opcion desconeguda « %s »\n"

#: src/args.c:877
#, c-format
msgid "option: %s\n"
msgstr "option: %s\n"

#: src/args.c:892
#, c-format
msgid "GNU indent %s\n"
msgstr "GNU indent: %s\n"

#: src/args.c:959
#, c-format
msgid "%s: option ``%s'' requires a numeric parameter\n"
msgstr "%s : l’opcion « %s » espèra una valor numerica\n"

#: src/args.c:966
#, c-format
msgid "set_option: internal error: p_type %d\n"
msgstr "set_option : error intèrna : p_type %d\n"

#: src/args.c:1022
msgid "Profile contains an unterminated comment"
msgstr "Profile conten un comentari pas completat"

#: src/args.c:1060
msgid "Profile contains unpalatable characters"
msgstr "Lo perfil conten de caractèrs pas confòrmes"

#: src/args.c:1228
#, c-format
msgid ""
"File named by environment variable %s does not exist or is not readable"
msgstr ""
"Lo fichièr nomenat per la variable d’environament %s existís pas o se pòt "
"pas legir"

#: src/backup.c:463
#, c-format
msgid "indent:  Strange version-control value\n"
msgstr "indent:  estranha valor de version de contraròtle\n"

#: src/backup.c:464
#, c-format
msgid "indent:  Using numbered-existing\n"
msgstr "indent: utilizacion d'un còde de terminason numerica\n"

#: src/backup.c:495
#, c-format
msgid "indent: Can't make backup filename of %s\n"
msgstr "indent: pòt pas crear lo fichièr d'archivatge de %s\n"

#: src/backup.c:503
#, c-format
msgid "Can't open backup file %s"
msgstr "Pòt pas dobrir lo fichièr d'archiu %s"

#: src/backup.c:510
#, c-format
msgid "Can't write to backup file %s"
msgstr "Pòt pas escriure dins lo fichièr d'archiu %s"

#: src/backup.c:523
#, c-format
msgid "Can't preserve modification time on backup file %s"
msgstr "Pòt pas preservar la data de modificacion sul fichièr d'archiu %s"

#: src/globs.c:46 src/globs.c:68
#, c-format
msgid "indent: Virtual memory exhausted.\n"
msgstr "indent: memòria virtuala agotada.\n"

#: src/globs.c:103
#, c-format
msgid "indent: %s:%d: %s:"
msgstr "indent: %s:%d: %s:"

#: src/globs.c:130
#, c-format
msgid "indent: Fatal Error: "
msgstr "indent: error fatala : "

#: src/globs.c:140
#, c-format
msgid "indent: System Error: "
msgstr "indent: error del sistèma : "

#: src/globs.h:26
msgid "Warning"
msgstr "Avertiment"

#: src/globs.h:30
msgid "Error"
msgstr "Error"

#: src/indent.c:291
msgid "EOF encountered in comment"
msgstr "Fin de fichièr (EOF) rencontrat dins lo comentari"

#: src/indent.c:355
msgid "Line broken"
msgstr "Linha copada"

#: src/indent.c:565
msgid "Unexpected end of file"
msgstr "Fin de fichièr inesperada"

#: src/indent.c:571
#, c-format
msgid "There were %d non-blank output lines and %d comments\n"
msgstr "I a agut %d linhas pas voidas e %d comentari(s)\n"

#: src/indent.c:575
#, c-format
msgid "(Lines with comments)/(Lines with code): %6.3f\n"
msgstr "(Linhas amb comentari)/(Linhas d'encodatge): %6.3f\n"

#: src/indent.c:599
msgid "Line broken 2"
msgstr "Linha 2 copada"

#: src/indent.c:821
#, c-format
msgid "indent: only one output file (2nd was %s)\n"
msgstr "indent: un sol fichièr de sortida (lo 2nd èra %s)\n"

#: src/indent.c:830 src/indent.c:856
#, c-format
msgid "indent: only one input file when output file is specified\n"
msgstr ""
"indent: un sol fichièr d'entrada quand un fichièr de sortida es especificat\n"

#: src/indent.c:844 src/indent.c:890
#, c-format
msgid "indent: can't have filenames when specifying standard input\n"
msgstr ""
"indent: pòt pas aver de noms de fichièrs quand l'entrada estandarda es "
"especificada\n"

#: src/indent.c:864
#, c-format
msgid "indent: only one input file when stdout is used\n"
msgstr ""
"indent: solament un fichièr d'entrada quand la sortida estandarda es "
"utilizada\n"

#: src/indent.c:899
msgid "command line"
msgstr "linha de comanda"

#: src/indent.c:1117
#, c-format
msgid "Read profile %s\n"
msgstr "Lectura del profile %s\n"

#: src/code_io.c:217
#, c-format
msgid "Can't open input file %s"
msgstr "Pòt pas dobrir lo fichièr d'entrada %s"

#: src/code_io.c:222
#, c-format
msgid "Can't stat input file %s"
msgstr "Pòt pas avalorar lo fichièr %s per stat()"

#: src/code_io.c:227
#, c-format
msgid "Zero-length file %s"
msgstr "Lo fichièr %s es void"

#: src/code_io.c:235 src/code_io.c:249
#, c-format
msgid "File %s is too big to read"
msgstr "Fichièr %s es tròp grand per èsser legit"

#: src/code_io.c:243
#, c-format
msgid "System problem reading file %s"
msgstr "Problèma sistèma al moment de la lectura de fichièr %s"

#: src/code_io.c:285
#, c-format
msgid "Error reading input file %s"
msgstr "Error de lectura del fichièr d'entrada %s"

#: src/code_io.c:293
#, c-format
msgid "Error closing input file %s"
msgstr "Error a la tampadura del fichièr %s"

#: src/code_io.c:482
#, c-format
msgid "File %s contains NULL-characters: cannot proceed\n"
msgstr "Lo fichièr %s conten NULL : se pòt pas contunhar\n"

#: src/lexi.c:852
msgid "Unterminated character constant"
msgstr "Constanta de caractèrs pas acabada"

#: src/lexi.c:853 src/lexi.c:872
msgid "Unterminated string constant"
msgstr "Constanta de caractèrs pas acabada"

#: src/lexi.c:1131
#, c-format
msgid "old style assignment ambiguity in \"=%s\". Assuming \"= %s\"\n"
msgstr ""

#: src/output.c:1339
#, c-format
msgid "indent: can't create %s\n"
msgstr "indent: pòt pas crear %s\n"

#: src/output.c:1377
#, c-format
msgid "Can't close output file %s"
msgstr "Pòt pas tampar lo fichier de sortida %s"

#: src/output.c:1390
#, c-format
msgid "Can't preserve modification time on output file %s"
msgstr "Pòt pas preservar la data de modificacion del fichièr de sortida %s"

#: src/parse.c:475
msgid "Unmatched 'else'"
msgstr "« else » pas apariat"

#: src/parse.c:501
msgid "Stmt nesting error."
msgstr "ERROR de boclatge d'una declaracion"

#: src/parse.c:543
msgid "Unknown code to parser"
msgstr "Còde desconegut a l'analisador sintaxic"

#: src/wildexp.c:128
msgid "CANNOT FIND '@' FILE!"
msgstr "PÒT PAS REPERAR LO FICHIÈR « @ » !"
