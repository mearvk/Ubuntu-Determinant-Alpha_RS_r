#: lib/error.c:188
msgid "Unknown system error"
msgstr "Error del sistèma desconeguda"

#: lib/getopt.c:547 lib/getopt.c:576
#, c-format
msgid "%s: option '%s' is ambiguous; possibilities:"
msgstr "%s: l'opcion « %s » es ambigua ; las possibilitats son :"

#: lib/getopt.c:624 lib/getopt.c:628
#, c-format
msgid "%s: option '--%s' doesn't allow an argument\n"
msgstr "%s : l'opcion « --%s » accèpta pas d'argument\n"

#: lib/getopt.c:637 lib/getopt.c:642
#, c-format
msgid "%s: option '%c%s' doesn't allow an argument\n"
msgstr "%s : l'opcion « %c%s » accèpta pas d'argument\n"

#: lib/getopt.c:685 lib/getopt.c:704
#, c-format
msgid "%s: option '--%s' requires an argument\n"
msgstr "%s : l'opcion « --%s » requesís un argument\n"

#: lib/getopt.c:742 lib/getopt.c:745
#, c-format
msgid "%s: unrecognized option '--%s'\n"
msgstr "%s : l'opcion « --%s » es pas coneguda\n"

#: lib/getopt.c:753 lib/getopt.c:756
#, c-format
msgid "%s: unrecognized option '%c%s'\n"
msgstr "%s : l'opcion « %c%s » es pas coneguda\n"

#: lib/getopt.c:805 lib/getopt.c:808
#, c-format
msgid "%s: invalid option -- '%c'\n"
msgstr "%s : opcion invalida -- '%c'\n"

#: lib/getopt.c:861 lib/getopt.c:878 lib/getopt.c:1088 lib/getopt.c:1106
#, c-format
msgid "%s: option requires an argument -- '%c'\n"
msgstr "%s : l'opcion requesís un argument -- '%c'\n"

#: lib/getopt.c:934 lib/getopt.c:950
#, c-format
msgid "%s: option '-W %s' is ambiguous\n"
msgstr "%s : l'opcion « -W %s » es ambigua\n"

#: lib/getopt.c:974 lib/getopt.c:992
#, c-format
msgid "%s: option '-W %s' doesn't allow an argument\n"
msgstr "%s : l'opcion « -W %s » pren pas d'argument\n"

#: lib/getopt.c:1013 lib/getopt.c:1031
#, c-format
msgid "%s: option '-W %s' requires an argument\n"
msgstr "%s : l'opcion « -W %s » requerís un argument\n"

#: lib/regcomp.c:131
msgid "Success"
msgstr "Capitada"

#: lib/regcomp.c:134
msgid "No match"
msgstr "Pas cap de correspondéncia"

#: lib/regcomp.c:137
msgid "Invalid regular expression"
msgstr "L'expression regulara es invalida."

#: lib/regcomp.c:140
msgid "Invalid collation character"
msgstr "Lo caractèr de regropament es invalid."

#: lib/regcomp.c:143
msgid "Invalid character class name"
msgstr "Lo nom d'un ensemble de caractèrs es invalid."

#: lib/regcomp.c:146
msgid "Trailing backslash"
msgstr "Barra oblica invèrsa a la fin."

#: lib/regcomp.c:149
msgid "Invalid back reference"
msgstr "La referéncia arrièra es invalida."

#: lib/regcomp.c:152
msgid "Unmatched [ or [^"
msgstr "[ o [^ sens correspondéncia"

#: lib/regcomp.c:155
msgid "Unmatched ( or \\("
msgstr "( o \\( sens correspondéncia"

#: lib/regcomp.c:158
msgid "Unmatched \\{"
msgstr "\\{ sens correspondéncia"

#: lib/regcomp.c:161
msgid "Invalid content of \\{\\}"
msgstr "Contengut de \\{\\} invalid"

#: lib/regcomp.c:164
msgid "Invalid range end"
msgstr "Fin d'interval invalida"

#: lib/regcomp.c:167
msgid "Memory exhausted"
msgstr "Memòria agotada"

#: lib/regcomp.c:170
msgid "Invalid preceding regular expression"
msgstr "Expression regulara precedenta invalida"

#: lib/regcomp.c:173
msgid "Premature end of regular expression"
msgstr "Fin prematurada d'expression regulara"

#: lib/regcomp.c:176
msgid "Regular expression too big"
msgstr "Expression regulara tròp longa"

#: lib/regcomp.c:179
msgid "Unmatched ) or \\)"
msgstr ") o \\) sens correspondéncia"

#: lib/regcomp.c:707
msgid "No previous regular expression"
msgstr "Pas d'expression regulara precedenta"

#: lib/xalloc-die.c:34
msgid "memory exhausted"
msgstr "Memòria agotada"
