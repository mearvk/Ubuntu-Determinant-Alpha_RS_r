msgid "Enumerate objects paths for devices"
msgstr "Afichar la lista dels camins d'objèctes pels periferics"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "Afichar totes los paramètres de totes los objèctes"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "Obténer las donadas de revelh"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "Susvelhar l'activitat del servici d'energia"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "Susvelhar en detalh"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "Afichar d'informacions sul camin de l'objècte"
