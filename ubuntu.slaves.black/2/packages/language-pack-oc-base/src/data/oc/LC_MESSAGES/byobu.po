#: bin/menu:34 byobu-config:129 byobu-config:401 byobu-config:409
msgid "Menu"
msgstr "Menú"

#: byobu-export:68 byobu-export:71 byobu-select-profile:104
#: byobu-select-profile:107
msgid "Choose"
msgstr "Causir"

#: byobu-export:171
msgid "File exists"
msgstr "Lo fichièr existís"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "Suprimir lo fichièr ? [y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "Causissètz una color : "

#: byobu-export:240
msgid "Profile"
msgstr "Perfil"

#: byobu-export:241
msgid "Archive"
msgstr "Archiu"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr ""
"Descompressatz l'archiu dins vòstre repertòri personal (home) sul sistèma "
"cibla."

#: byobu-select-profile:49
msgid "Error:"
msgstr "Error :"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " lo fichièr existís, mas es pas un ligam simbolic"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "Seleccionatz un perfil screen : "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "ERROR : Seleccion invalida"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"S'utilizatz la configuracion per defaut dels acorchis de clavièr, quichatz "
"sus\\n<F5> per activar aqueles cambiaments.\\n\\nSiquenon, quitatz aquesta "
"sesiha d'ecran e començatz-ne una novèla."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Executatz \"byobu\" per activar"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu s'executa actualament a la connexion (desactivar)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu s'executa pas actualament a la connexion (activar)"

#: byobu-config:89
msgid "Help"
msgstr "Ajuda"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "Cambiar las colors de Byobu"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Cambiar las notificacions d'estat"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Cambiar d'ensemble d'acorchis de clavièr"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Cambiar la sequéncia d'escapament"

#: byobu-config:94
msgid "Create new windows"
msgstr "Crear de fenèstras novèlas"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Gerir las fenèstras per defaut"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " Menú de Configuracion de Byobu"

#: byobu-config:110
msgid "Okay"
msgstr "D'acòrdi"

#: byobu-config:110 byobu-config:144 byobu-config:161 byobu-config:195
#: byobu-config:335 byobu-config:376 byobu-config:449
msgid "Cancel"
msgstr "Anullar"

#: byobu-config:130
msgid "Byobu Help"
msgstr "Ajuda de Byobu"

#: byobu-config:144 byobu-config:161 byobu-config:195 byobu-config:335
#: byobu-config:376 byobu-config:449
msgid "Apply"
msgstr "Aplicar"

#: byobu-config:146
msgid "Which profile would you like to use?"
msgstr "Quin perfil voldriatz utilizar ?"

#: byobu-config:162
msgid "Which set of keybindings would you like to use?"
msgstr "Quin ensemble d'acorchis de clavièr voldriatz utilizar ?"

#: byobu-config:175
msgid "Title: "
msgstr "Titol : "

#: byobu-config:177
msgid "Command: "
msgstr "Comanda : "

#: byobu-config:179
msgid "Presets: "
msgstr "Prereglatges : "

#: byobu-config:193
msgid "Add to default windows"
msgstr "Apondre a las fenèstras per defaut"

#: byobu-config:197
msgid "Create new window(s):"
msgstr "Crear de fenèstra(s) novèla(s) :"

#: byobu-config:336
msgid "Toggle status notifications:"
msgstr "Cambiar las notificacions d'estat :"

#: byobu-config:368
msgid "Windows:"
msgstr "Fenèstras :"

#: byobu-config:378
msgid "Select window(s) to create by default:"
msgstr "Seleccionar las fenèstra(s) de crear per defaut :"

#: byobu-config:398
msgid "Byobu will be launched automatically next time you login."
msgstr "Byobu serà aviat automaticament a la connexion venenta."

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "Byobu serà pas utilizat a la connexion venenta."

#: byobu-config:408
msgid "Message"
msgstr "Messatge"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "Sequéncia d'escapament : ctrl-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "Cambiar la sequéncia d'escapament :"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr ""
"<Tab>/<Alt-Tab> entra los elements | <Enter> selecciona | <Esc> quita"
