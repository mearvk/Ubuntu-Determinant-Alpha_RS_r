#: luks/keyencryption.c:61
#, c-format
msgid "Unable to obtain sector size for %s"
msgstr "Impossible d'obténer la talha del sector per %s"

#: luks/keyencryption.c:109
msgid "Failed to obtain device mapper directory."
msgstr "Impossible d'obténer lo repertòri d'estructura de periferic"

#: luks/keymanage.c:79 luks/keymanage.c:120 luks/keymanage.c:390
#, c-format
msgid "Can't open device: %s\n"
msgstr "Impossible de dobrir lo periferic : %s\n"

#: luks/keymanage.c:86
#, c-format
msgid "%s is not a LUKS partition\n"
msgstr "%s es pas una particion LUKS.\n"

#: luks/keymanage.c:89
msgid "unknown hash spec in phdr"
msgstr "Especificacion hash desconeguda dins phdr"

#: luks/keymanage.c:92
#, c-format
msgid "unknown version %d\n"
msgstr "Version desconeguda %d\n"

#: luks/keymanage.c:213
#, c-format
msgid "key %d active, purge first.\n"
msgstr "La tòca %d es activa, Purgar abans.\n"

#: luks/keymanage.c:218
#, c-format
msgid ""
"key material section %d includes too few stripes. Header manipulation?\n"
msgstr ""
"La clau de la seccion material %d inclutz tròp de linhas. Una manipulacion "
"de las entèstas ?\n"

#: luks/keymanage.c:281
#, c-format
msgid "key %d is disabled.\n"
msgstr "La tòca %d es desactivada.\n"

#: luks/keymanage.c:427
#, c-format
msgid "Key %d not active. Can't wipe.\n"
msgstr "La tòca %d es pas activa. Impossible d'escafar.\n"

#: src/cryptsetup.c:56
msgid "<name> <device>"
msgstr "<nom> <periferic>"

#: src/cryptsetup.c:56
msgid "create device"
msgstr "crear un periferic"

#: src/cryptsetup.c:57 src/cryptsetup.c:58 src/cryptsetup.c:59
#: src/cryptsetup.c:60 src/cryptsetup.c:67
msgid "<name>"
msgstr "<nom>"

#: src/cryptsetup.c:57
msgid "remove device"
msgstr "suprimir lo periferic"

#: src/cryptsetup.c:58
msgid "modify active device"
msgstr "modificar lo periferic actiu"

#: src/cryptsetup.c:59
msgid "resize active device"
msgstr "redimensionar lo periferic actiu"

#: src/cryptsetup.c:60
msgid "show device status"
msgstr "far veire l'estat del periferic"

#: src/cryptsetup.c:61 src/cryptsetup.c:64
msgid "<device> [<new key file>]"
msgstr "<periferic> [<fichièr clau novèl]"

#: src/cryptsetup.c:61
msgid "formats a LUKS device"
msgstr "formata un periferic LUKS"

#: src/cryptsetup.c:62
msgid "<device> <name> "
msgstr "<periferic> <nom> "

#: src/cryptsetup.c:62
msgid "open LUKS device as mapping <name>"
msgstr "dobrir lo periferic LUKS en tant que <nom>"

#: src/cryptsetup.c:63
msgid "<device> <key slot>"
msgstr "<periferic> <emplaçament clau>"

#: src/cryptsetup.c:63
msgid "wipes key with number <key slot> from LUKS device"
msgstr "escafar la clau amb un nombre <key slot> a partir del periferic LUKS"

#: src/cryptsetup.c:64
msgid "add key to LUKS device"
msgstr "apondre una clau al periferic LUKS"

#: src/cryptsetup.c:65 src/cryptsetup.c:66 src/cryptsetup.c:68
msgid "<device>"
msgstr "<periferic>"

#: src/cryptsetup.c:65
msgid "print UUID of LUKS device"
msgstr "aficha l'UUID del periferic LUKS"

#: src/cryptsetup.c:66
msgid "tests <device> for LUKS partition header"
msgstr "testa l'entèsta de la particion LUKS per <periferic>"

#: src/cryptsetup.c:67
msgid "remove LUKS mapping"
msgstr "suprimir l'associacion LUKS"

#: src/cryptsetup.c:68
msgid "dump LUKS partition information"
msgstr "recuperar las informacions sus la particion LUKS"

#: src/cryptsetup.c:77
#, c-format
msgid "Command successful.\n"
msgstr "Comanda capitada.\n"

#: src/cryptsetup.c:90
#, c-format
msgid "Command failed"
msgstr "La comanda a fracassat"

#: src/cryptsetup.c:226
#, c-format
msgid "This will overwrite data on %s irrevocably."
msgstr "Aquò espotirà d'un biais definitiu las donadas sus %s."

#: src/cryptsetup.c:227
msgid "memory allocation error in action_luksFormat"
msgstr "Error d'allocacion de memòria per action_luksFormat"

#: src/cryptsetup.c:269
msgid ""
"This is the last keyslot. Device will become unusable after purging this key."
msgstr ""
"Es la darrièra clau disponibla. Lo periferic vendrà inutilizable aprèp la "
"supression d'aquela."

#: src/cryptsetup.c:349
#, c-format
msgid ""
"\n"
"<action> is one of:\n"
msgstr ""
"\n"
"<accion> es lo primièr de\n"

#: src/cryptsetup.c:355
#, c-format
msgid ""
"\n"
"<name> is the device to create under %s\n"
"<device> is the encrypted device\n"
"<key slot> is the LUKS key slot number to modify\n"
"<key file> optional key file for the new key for luksAddKey action\n"
msgstr ""
"\n"
"<nom> es lo periferic de crear jos %s \n"
"<periferic> es lo periferic chifrat\n"
"<emplaçament de clau> es lo numèro de l'emplaçament de la clau LUKS de "
"modificar\n"
"<fichièr de clau> fichièr de clau opcional per la novèla clau al moment de "
"l'apondon d'una novèla clau LUKS\n"

#: src/cryptsetup.c:371
msgid "Show this help message"
msgstr "Aficha aqueste messatge d'ajuda"

#: src/cryptsetup.c:372
msgid "Display brief usage"
msgstr "Aficha l'utilizacion rapida"

#: src/cryptsetup.c:376
msgid "Help options:"
msgstr "Opcions d'ajuda :"

#: src/cryptsetup.c:377
msgid "Shows more detailed error messages"
msgstr "Fa veire de messatges d'errors mai detalhats"

#: src/cryptsetup.c:378
msgid "The cipher used to encrypt the disk (see /proc/crypto)"
msgstr ""
"Lo metòde de chiframent utilizat per encriptar lo disc (vejatz /proc/crypto)"

#: src/cryptsetup.c:379
msgid "The hash used to create the encryption key from the passphrase"
msgstr ""
"Lo hachatge utilizat per crear la clau de chiframent a partir de la "
"passphrase"

#: src/cryptsetup.c:380
msgid "Verifies the passphrase by asking for it twice"
msgstr "Verifica la frasa secreta en la tornant demandar"

#: src/cryptsetup.c:381
msgid "Read the key from a file (can be /dev/random)"
msgstr "legir la clau d'aqueste fichièr"

#: src/cryptsetup.c:382
msgid "The size of the encryption key"
msgstr "La talha de la clau de chiframent"

#: src/cryptsetup.c:382
msgid "BITS"
msgstr "BITS"

#: src/cryptsetup.c:383
msgid "The size of the device"
msgstr "La talha del periferic"

#: src/cryptsetup.c:383 src/cryptsetup.c:384 src/cryptsetup.c:385
#: src/cryptsetup.c:393
msgid "SECTORS"
msgstr "SECTORS"

#: src/cryptsetup.c:384
msgid "The start offset in the backend device"
msgstr "L'adreça memòria relativa de despart dins lo periferic de sortida"

#: src/cryptsetup.c:385
msgid "How many sectors of the encrypted data to skip at the beginning"
msgstr "Quant de sectors de donadas de chifrar pas al començament"

#: src/cryptsetup.c:386
msgid "Create a readonly mapping"
msgstr "Crear una associacion en lectura sola"

#: src/cryptsetup.c:387
msgid "PBKDF2 iteration time for LUKS (in ms)"
msgstr "Temps d'iteracion de PBKDF2 per LUKS (en ms)"

#: src/cryptsetup.c:388
msgid "msecs"
msgstr "msegs"

#: src/cryptsetup.c:389
msgid "Do not ask for confirmation"
msgstr "demandar pas de confirmacion"

#: src/cryptsetup.c:390
msgid "Print package version"
msgstr "Imprimir la version del paquet"

#: src/cryptsetup.c:391
msgid "Timeout for interactive passphrase prompt (in seconds)"
msgstr ""
"Temps d'espèra al moment de la demanda de la frasa secreta (en segondas)"

#: src/cryptsetup.c:391
msgid "secs"
msgstr "segs"

#: src/cryptsetup.c:392
msgid "How often the input of the passphrase can be retried"
msgstr "Quant d'ensages son permeses per la demanda de la passphrase"

#: src/cryptsetup.c:393
msgid "Align payload at <n> sector boundaries - for luksFormat"
msgstr ""
"Plaça las informacions utilas a <n> sectors limits - per aqueste luksFormat"

#: src/cryptsetup.c:409
msgid "[OPTION...] <action> <action-specific>]"
msgstr "[OPCION...] <accion> <accion-especific>]"

#: src/cryptsetup.c:445
msgid "Key size must be a multiple of 8 bits"
msgstr "La talha de la clau deu èsser un multiple de 8 bits"

#: src/cryptsetup.c:449
msgid "Argument <action> missing."
msgstr "L'argument <accion> es mancant."

#: src/cryptsetup.c:455
msgid "Unknown action."
msgstr "Accion desconeguda."

#: src/cryptsetup.c:470
#, c-format
msgid "%s: requires %s as arguments"
msgstr "%s: requerís %s coma arguments"
