#, perl-format
msgid "getgrnam `%s' failed. This shouldn't happen.\n"
msgstr "getgrnam « %s » a fracassat. Aquesta error se deuriá pas produire.\n"

#: ../deluser:385
#, perl-format
msgid "The group `%s' is not a system group. Exiting.\n"
msgstr ""
"Lo grop « %s » es pas un grop sistèma.\n"
"Abandon.\n"

#: ../deluser:389
#, perl-format
msgid "The group `%s' is not empty!\n"
msgstr "Lo grop « %s » es pas void.\n"

#: ../deluser:413
