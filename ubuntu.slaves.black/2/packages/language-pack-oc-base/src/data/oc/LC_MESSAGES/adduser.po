#. everyone can issue "--help" and "--version", but only root can go on
#: ../adduser:161
msgid "Only root may add a user or group to the system.\n"
msgstr ""
"Sonque l'administrator pòt apondre un utilizaire o un grop al sistèma.\n"

#: ../adduser:191 ../deluser:145
msgid "Only one or two names allowed.\n"
msgstr "Sonque un o dos noms son autorizats.\n"

#: ../adduser:197
msgid "Specify only one name in this mode.\n"
msgstr "Dins aqueste mòde, especificatz pas qu'un nom d'utilizaire.\n"

#: ../adduser:224
msgid "The --group, --ingroup, and --gid options are mutually exclusive.\n"
msgstr "Las opcions --group, --ingroup et --gid s'excluisson mutualament.\n"

#: ../adduser:229
msgid "The home dir must be an absolute path.\n"
msgstr "Lo dorsièr personal deu èsser un camin absolut.\n"

#: ../adduser:233
#, perl-format
msgid "Warning: The home dir %s you specified already exists.\n"
msgstr "Atencion : lo dorsièr personal « %s » qu'avètz indicat existìs ja.\n"

#: ../adduser:235
#, perl-format
msgid "Warning: The home dir %s you specified can't be accessed: %s\n"
msgstr ""
"Atencion : lo dorsièr personal « %s » qu'avètz indicat es pas accessible : "
"%s\n"

#: ../adduser:305
#, perl-format
msgid "The group `%s' already exists as a system group. Exiting.\n"
msgstr "Lo grop « %s » existís ja coma grop del sistèma. Abandon.\n"

#: ../adduser:310
#, perl-format
msgid "The group `%s' already exists and is not a system group. Exiting.\n"
msgstr "Lo grop « %s » existís ja coma grop del sistèma. Abandon.\n"

#: ../adduser:315
#, perl-format
msgid "The group `%s' already exists, but has a different GID. Exiting.\n"
msgstr ""
"Lo grop « %s » existís ja mas a un identificant diferent.\n"
"Abandon.\n"

#: ../adduser:320 ../adduser:354
#, perl-format
msgid "The GID `%s' is already in use.\n"
msgstr "L'identificant de grop « %s » es ja utilizat.\n"

#: ../adduser:330
#, perl-format
msgid ""
"No GID is available in the range %d-%d (FIRST_SYS_GID - LAST_SYS_GID).\n"
msgstr ""
"Cap d'identificant de grop es pas disponible dins l'interval %d-%d\n"
"(FIRST_SYS_GID - LAST_SYS_GID).\n"

#: ../adduser:331 ../adduser:372
#, perl-format
msgid "The group `%s' was not created.\n"
msgstr "Lo grop « %s » es pas estat creat.\n"

#: ../adduser:336 ../adduser:376
#, perl-format
msgid "Adding group `%s' (GID %d) ...\n"
msgstr "Apondon del grop « %s » (identificant %d)...\n"

#: ../adduser:340 ../adduser:380 ../adduser:404 ../deluser:366 ../deluser:400
#: ../deluser:440
msgid "Done.\n"
msgstr "Acabat.\n"

#: ../adduser:351 ../adduser:991
#, perl-format
msgid "The group `%s' already exists.\n"
msgstr "Lo grop « %s » existís ja.\n"

#: ../adduser:371
#, perl-format
msgid "No GID is available in the range %d-%d (FIRST_GID - LAST_GID).\n"
msgstr ""
"Cap d'identificant de grop es pas disponible dins l'interval %d-%d\n"
"(FIRST_GID - LAST_GID).\n"

#: ../deluser:447
#, perl-format
msgid "The user `%s' does not exist.\n"
msgstr "L'utilizaire « %s » existís pas.\n"

#: ../deluser:451
#, perl-format
msgid "The group `%s' does not exist.\n"
msgstr "Lo grop « %s » existís pas.\n"

#: ../adduser:394 ../adduser:788
#, perl-format
msgid "The user `%s' is already a member of `%s'.\n"
msgstr "L'utilizaire « %s » es ja membre del grop « %s ».\n"

