#, perl-format
msgid "The user `%s' already exists, but is not a system user. Exiting.\n"
msgstr ""
"L’utilizaire « %s » existís ja mas es pas un utilizaire sistèma. Sortida.\n"

#: ../adduser:425
#, perl-format
msgid "The user `%s' already exists with a different UID. Exiting.\n"
msgstr ""
"L'utilizaire « %s » existís ja amb un identificant diferent.\n"
"Abandon.\n"

#: ../adduser:439
#, perl-format
msgid ""
"No UID/GID pair is available in the range %d-%d (FIRST_SYS_UID - "
