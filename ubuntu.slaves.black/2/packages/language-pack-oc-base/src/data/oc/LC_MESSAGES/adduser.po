msgstr ""
"Cap de parèl d'identificants utilizaire/grop es pas disponible dins\n"
"l'interval %d-%d (FIRST_SYS_UID - LAST_SYS_UID).\n"

#: ../adduser:440 ../adduser:453 ../adduser:523 ../adduser:635 ../adduser:640
#, perl-format
msgid "The user `%s' was not created.\n"
msgstr "L'utilizaire « %s » es pas estat creat.\n"

#: ../adduser:452
#, perl-format
msgid ""
"No UID is available in the range %d-%d (FIRST_SYS_UID - LAST_SYS_UID).\n"
msgstr ""
"Cap d'identificant utilizaire es pas disponible dins l'interval %d-%d\n"
"(FIRST_SYS_UID - LAST_SYS_UID).\n"

#: ../adduser:517 ../adduser:529
msgid "Internal error"
msgstr "Error intèrna"

#: ../adduser:465
#, perl-format
msgid "Adding system user `%s' (UID %d) ...\n"
msgstr "Apondon de l'utilizaire sistèma « %s » (identificant : %d)...\n"

#: ../adduser:469
#, perl-format
msgid "Adding new group `%s' (GID %d) ...\n"
msgstr "Apondon del grop novèl « %s » (identificant : %d)...\n"

#: ../adduser:475
#, perl-format
msgid "Adding new user `%s' (UID %d) with group `%s' ...\n"
msgstr ""
"Apondon de l'utilizaire novèl « %s » (identificant : %d) amb lo\n"
"grop « %s »...\n"

#: ../AdduserCommon.pm:212
#, perl-format
msgid "`%s' returned error code %d. Exiting.\n"
msgstr ""
"« %s » a renviat lo còde d'error %d.\n"
"Abandon.\n"

#: ../AdduserCommon.pm:214
#, perl-format
msgid "`%s' exited from signal %d. Exiting.\n"
msgstr "« %s » a acabat amb lo senhal %d. Abandon.\n"

#: ../adduser:483
#, perl-format
msgid ""
"%s failed with return code 15, shadow not enabled, password aging cannot be "
"set. Continuing.\n"
msgstr ""
"La comanda « %s » a fracassat amb un còde de retorn 15, indicant que\n"
"los senhals amagats (« shadow passwords ») son pas utilizats. La\n"
"fin de validitat del senhal pòt pas èsser establida mas la creacion\n"
"se perseguís.\n"

#: ../adduser:611
#, perl-format
msgid "Adding user `%s' ...\n"
msgstr "Apondon de l'utilizaire « %s »...\n"

#: ../adduser:634
#, perl-format
msgid ""
"No UID/GID pair is available in the range %d-%d (FIRST_UID - LAST_UID).\n"
msgstr ""
"Cap de parelhs d'identificants utilizaire/grop es pas disponible dins\n"
"l'interval %d-%d (FIRST_UID - LAST_UID).\n"

#: ../adduser:506
#, perl-format
msgid "No UID is available in the range %d-%d (FIRST_UID - LAST_UID).\n"
msgstr ""
"Cap d'identificant utilizaire es pas disponible dins l'interval %d-%d\n"
"(FIRST_UID - LAST_UID).\n"

#: ../adduser:687
#, perl-format
msgid "Adding new group `%s' (%d) ...\n"
msgstr "Apondon del grop novèl « %s » (%d)...\n"

#: ../adduser:533
#, perl-format
msgid "Adding new user `%s' (%d) with group `%s' ...\n"
msgstr "Apondon de l'utilizaire novèl « %s » (%d) amb lo grop « %s »...\n"

