#: ../com.canonical.xdiagnose.policy.in.h:1
msgid "Authentication is needed to diagnose graphics issues"
msgstr ""
"L'autentificacion es necessària per diagnosticar los problèmas grafics"

#: ../xdiagnose.desktop.in.h:1
msgid "xdiagnose"
msgstr "xdiagnose"

#: ../xdiagnose.desktop.in.h:2
msgid "Diagnose Graphics Issues"
msgstr "Diagnosticar los problèmas grafics"

#: ../xdiagnose.desktop.in.h:3
msgid "X.org Diagnostic and Repair Utility"
msgstr "Utilitari de reparacion e de diagnostic per X.org"

#: ../bin/xdiagnose:81
msgid "Troubleshoot failure to start a graphical X11 session"
msgstr "Analisi del fracàs de l'aviada d'una sesilha grafica X11"

#: ../bin/dpkg-log-summary:130
msgid "List dates on which updates were performed"
msgstr "Lista de las datas quand de mesas a jorn son estadas efectuadas"

#: ../bin/dpkg-log-summary:134
msgid "Only include entries from this date forward (YYYY/MM/DD)"
msgstr ""
"Inclòu pas que las entradas a partir d'aquesta data (en format AAAA/MM/DD)"

#: ../bin/dpkg-log-summary:138
msgid "Only include entries from this date and earlier (YYYY/MM/DD)"
msgstr ""
"Inclòu pas que las entradas abans aquesta data (en format AAAA/MM/DD)"

#: ../xdiagnose/applet.py:62
msgid "X Diagnostics Settings"
msgstr "Paramètres de X Diagnostics"

#: ../xdiagnose/applet.py:74
msgid "Debug"
msgstr "Desbugatge"

#: ../xdiagnose/applet.py:75
msgid "Extra graphics _debug messages"
msgstr "Messatges de _desbugatge suplementaris sus l'afichatge"

#: ../xdiagnose/applet.py:76
msgid ""
"Makes dmesg logs more verbose with details about 3d, plymouth, and monitor "
"detection"
msgstr ""
"Rendre los jornals de dmesg mai verboses amb de detalhs al subjècte de la "
"3D, de Plymouth e de la deteccion de l'ecran"

#: ../xdiagnose/applet.py:79
msgid "Display boot messages"
msgstr "Afichar los messatges de l'aviada"

#: ../xdiagnose/applet.py:80
msgid ""
"Removes splash and quiet from kernel options so you can see kernel details "
"during boot"
msgstr ""
"Lèva « splash » e « quiet » de las opcions del nucli, per que poscatz veire "
"los messatges del nucli pendent l'aviada"

#: ../xdiagnose/applet.py:83
msgid "Enable automatic crash bug reporting"
msgstr "Activar lo rapòrt automatic de plantatges"

#: ../xdiagnose/applet.py:84
msgid "Turns on the Apport crash detection and bug reporting tool"
msgstr ""
"Activar Apport, l'aisina de deteccion de plantatges e de rapòrt d'anomalias"

#: ../xdiagnose/applet.py:89
msgid "Workarounds"
msgstr "Solucions"

#: ../xdiagnose/applet.py:90
msgid "Disable bootloader _graphics"
msgstr "Desactivar lo cargador d'aviada _grafica"

#: ../xdiagnose/applet.py:91
msgid ""
"The grub bootloader has a graphics mode using the VESA framebuffer driver "
"which can sometimes interfere with later loading of the proper video driver. "
" Checking this forces grub to use text mode only."
msgstr ""
"Lo cargador d'amorçatge Grub prepausa un mòde grafic via lo pilòt "
"framebuffer VESA. De còps, aqueste pòt interferir amb lo cargament ulterior "
"del vertadièr pilòt vidèo. Aquesta opcion fòrça Grub a utilizar lo mòde "
"tèxte."

#: ../xdiagnose/applet.py:94
msgid "Disable _VESA framebuffer driver"
msgstr "Desactivar lo pilòt framebuffer _VESA"

#: ../xdiagnose/applet.py:95
msgid ""
"vesafb is loaded early during boot so the boot logo can display, but can "
"cause issues when switching to a real graphics driver.  Checking this "
"prevents vesafb from loading so these issues do not occur."
msgstr ""
"vesafb es cargat d'ora al moment de l'amorçatge per que lo lògo se pòsca "
"afichar, mas aquò pòt causar de problèmas al moment de la transicion cap a "
"un vertadièr pilòt vidèo. Activar aquesta opcion empacharà lo cargament de "
"vesafb per qu'aquestes problèmas se produsiscan pas."

#: ../xdiagnose/applet.py:98
msgid "Disable _PAT memory"
msgstr "Desactivar la memòria _PAT"

#: ../xdiagnose/applet.py:99
msgid ""
"This pagetable extension can interfere with the memory management of "
"proprietary drivers under certain situations and cause lagging or failures "
"to allocate video memory, so turning it off can prevent those problems."
msgstr ""
"Aquesta extension de taula de paginacion pòt interferir amb la gestion de la "
"memòria dels pilòts proprietaris dins d'unas situacions e pòt causar "
"d'alentiments e de desfalhenças d'allocacion de memòria vidèo. Desactivar "
"aquesta extension pòt doncas prevenir aquesta mena de problèmas."

#: ../xdiagnose/applet.py:140
msgid "View Errors"
msgstr "Afichar las errors"

#: ../xdiagnose/applet.py:144
msgid "Report an Xorg Bug"
msgstr "Raportar un bug de Xorg"

#: ../xdiagnose/errors_treeview.py:37
msgid "Xorg Error Messages"
msgstr "Messatges d'error de Xorg"

#. create the TreeViewColumn to display the data
#: ../xdiagnose/errors_treeview.py:53
msgid "Error Message"
msgstr "Messatge d'error"
