#: find/exec.c:123
#, c-format
msgid "Failed to save working directory in order to run a command on %s"
msgstr ""
"Lo repertòri de trabalh a pas pogut èsser salvat abans d'executar la comanda "
"%s"

#: find/exec.c:243
#, c-format
msgid "Cannot close standard input"
msgstr "Impossible de tampar l'entrada estandarda"

#: find/exec.c:272
#, c-format
msgid "Failed to change directory%s%s"
msgstr ""

#: find/exec.c:317 xargs/xargs.c:1322
msgid "cannot fork"
msgstr "impossible de clonar lo processus (fork)."

#: find/exec.c:348
#, c-format
msgid "error waiting for %s"
msgstr "Error en esperant %s"

#: find/exec.c:357
#, c-format
msgid "%s terminated by signal %d"
msgstr "%s acabat pel senhal %d"

#: find/fstype.c:240
msgid "Cannot read mounted file system list"
msgstr "Impossible de listar los sistèmas de fichièrs montats"

#: find/fstype.c:270
msgid "unknown"
msgstr "desconegut(da)"

#: find/ftsfind.c:231
#, c-format
msgid ""
"Symbolic link %s is part of a loop in the directory hierarchy; we have "
"already visited the directory to which it points."
msgstr ""

#: find/ftsfind.c:245
#, c-format
msgid ""
"File system loop detected; %s is part of the same file system loop as %s."
msgstr ""
"Bocla detectada dins lo sistèma de fichièrs ; « %s » es dins la meteissa "
"bocla que %s."

#: find/ftsfind.c:394 find/util.c:259
#, c-format
msgid "WARNING: file %s appears to have mode 0000"
msgstr "ATENCION : sembla que lo fichièr %s a la permission 0000"

#: find/ftsfind.c:509
#, c-format
msgid "cannot search %s"
msgstr "impossible de cercar %s"

#: find/ftsfind.c:555
#, c-format
msgid "failed to restore working directory after searching %s"
msgstr ""
"fracàs de restabliment del repertòri de trabalh inicial aprèp recèrca dins %s"

#: find/ftsfind.c:754
msgid "Failed to initialize shared-file hash table"
msgstr ""
"Fracàs d'inicializacion de la taula de hachage dels fichièrs partejats"

#: find/ftsfind.c:770 locate/frcode.c:222 locate/locate.c:1568
#: xargs/xargs.c:434
msgid "The atexit library function failed"
msgstr "La foncion atexit de la bibliotèca a fracassat"

#: find/oldfind.c:238
msgid "cannot stat current directory"
msgstr "impossible d'obténer las « stat » del repertòri corrent"

#: find/oldfind.c:331
msgid "Cannot read list of mounted devices."
msgstr "Impossible de listar los periferics montats."

#: find/oldfind.c:420
#, c-format
msgid "WARNING: file system %s has recently been unmounted."
msgstr "ATENCION : lo sistèma de fichièr %s es estat desmontat recentament."

#: find/oldfind.c:430
#, c-format
msgid "WARNING: file system %s has recently been mounted."
msgstr "ATENCION : lo sistèma de fichièrs %s es estat montat recentament."

#: find/oldfind.c:527
#, c-format
msgid ""
"%s%s changed during execution of %s (old device number %ld, new device "
"number %ld, file system type is %s) [ref %ld]"
msgstr ""
"modification de %s%s pendent l'execucion de %s (ancian n° de periferic %ld, "
"novèl n° de periferic %ld, tipe del sistèma de fichièrs es %s) [ref %ld]"

#: find/oldfind.c:564
#, c-format
msgid ""
"%s%s changed during execution of %s (old inode number %<PRIuMAX>, new inode "
"number %<PRIuMAX>, file system type is %s) [ref %ld]"
msgstr ""
"modification de %s%s pendent l'execucion de %s (ancian n° d'inode "
"%<PRIuMAX>, novèl n° d'inode %<PRIuMAX>, tipe del sistèma de fichièrs %s) "
"[ref %ld]"

#: find/oldfind.c:729
msgid "failed to return to parent directory"
msgstr "impossible de tornar al repertòri parent"

#: find/oldfind.c:1015
#, c-format
msgid "Failed to safely change directory into %s"
msgstr "Impossible de cambiar cap al repertòri %s en tota seguretat"

#: find/oldfind.c:1134
#, c-format
msgid ""
"Filesystem loop detected; %s has the same device number and inode as a "
"directory which is %d level higher in the file system hierarchy"
msgid_plural ""
"Filesystem loop detected; %s has the same device number and inode as a "
"directory which is %d levels higher in the file system hierarchy"
msgstr[0] ""
"Bocla detectada dins lo sistèma de fichièrs ; « %s » al meteis n° de "
"periferic e d'inode que lo repertòri qu'es %d nivèl mai naut dins "
"l'arborescéncia"
msgstr[1] ""
"Bocla detectada dins lo sistèma de fichièrs ; « %s » al meteis n° de "
"periferic e d'inode que lo repertòri qu'es %d nivèls mai naut dins "
"l'arborescéncia"

#: find/oldfind.c:1386
#, c-format
msgid "warning: not following the symbolic link %s"
msgstr "Atencion : ligam simbolic pas seguit %s"

#: find/oldfind.c:1458
#, c-format
msgid ""
"WARNING: Hard link count is wrong for %s (saw only st_nlink=%<PRIuMAX> but "
"we already saw %<PRIuMAX> subdirectories): this may be a bug in your file "
"system driver.  Automatically turning on find's -noleaf option.  Earlier "
"results may have failed to include directories that should have been "
"searched."
msgstr ""
"ATENCION : Ligam dirècte (hard link) erronèu per %s (vistes solament "
"st_nlink=%<PRIuMAX>, mas ja vistes %<PRIuMAX> sosrepertòris). Es benlèu "
"degut a una anomalia dins lo pilòt del sistèma de fichièrs. Opcion de "
"recèrca -noleaf de « find » automaticament activada. Es possible que los "
"resultats anteriors sián pas incluses dina los repertòris qu'aurián degut "
"èsser percorruts."

#: find/parser.c:451
msgid ""
"The -delete action automatically turns on -depth, but -prune does nothing "
"when -depth is in effect.  If you want to carry on anyway, just explicitly "
"use the -depth option."
msgstr ""
"L'accion -delete active automaticament -depth, mas -prune fa pas res se -"
"depth es presenta. Per contunhar, utilizatz puslèu explicitament l'opcion -"
"depth."

#: find/parser.c:609
#, c-format
msgid ""
"warning: you have specified the global option %s after the argument %s, but "
"global options are not positional, i.e., %s affects tests specified before "
"it as well as those specified after it.  Please specify global options "
"before other arguments."
msgstr ""

#: find/parser.c:912
#, c-format
msgid ""
"warning: the -d option is deprecated; please use -depth instead, because the "
"latter is a POSIX-compliant feature."
msgstr ""
"atencion : l'opcion -d es obsolèta ; utilizatz -depth a la plaça, perque "
"aquela es una opcion confòrma a POSIX."

#: find/parser.c:1167
#, c-format
msgid ""
"%s is not the name of an existing group and it does not look like a numeric "
"group ID because it has the unexpected suffix %s"
msgstr ""
"%s es pas lo nom d'un grop existent e sembla pas èsser un identificant "
"numeric de grop a causa del sufix inesperat %s"

#: find/parser.c:1182
#, c-format
msgid "%s is not the name of an existing group"
msgstr "%s es pas lo nom d'un grop existent"

#: find/parser.c:1188
msgid "argument to -group is empty, but should be a group name"
msgstr "l'argument de -group es void. Deuriá èsser un nom de grop"

#: find/parser.c:1261
msgid "sanity check of the fnmatch() library function failed."
msgstr ""
"Foncion de bibliotèca fnmatch() : fracàs de verificacion d'integritat."

#: find/parser.c:1276
#, c-format
msgid ""
"warning: %s matches against basenames only, but the given pattern contains a "
"directory separator (%s), thus the expression will evaluate to false all the "
"time.  Did you mean %s?"
msgstr ""

#: find/parser.c:1399
#, c-format
msgid "Expected a positive decimal integer argument to %s, but got %s"
msgstr ""
"Un nombre decimal positiu es esperat coma argument a %s, mas %s trobat"

#: find/parser.c:1564
#, c-format
msgid "This system does not provide a way to find the birth time of a file."
msgstr "Lo sistèma permet pas de retrobar la data de creacion d'un fichièr."

#: find/parser.c:1585
#, c-format
msgid "The %s test needs an argument"
msgstr "Lo tèst « %s » requesís un paramètre"

#: find/parser.c:1622
#, c-format
msgid "I cannot figure out how to interpret %s as a date or time"
msgstr "Impossible d'interpretar %s coma una data o una ora"

#: find/parser.c:1639
#, c-format
msgid "Cannot obtain birth time of file %s"
msgstr "Impossible d'obténer la data de creacion del fichièr %s"

#: find/parser.c:1783
#, c-format
msgid "warning: -%s %s will not match anything because it ends with /."
msgstr ""
"atencion : -%s %s donarà pas de correspondéncia perque s'acaba per /."

#: find/parser.c:1878
#, c-format
msgid "invalid mode %s"
msgstr "mòde invalid « %s »"

#: find/parser.c:1896
#, c-format
msgid ""
"warning: you have specified a mode pattern %s (which is equivalent to /000). "
"The meaning of -perm /000 has now been changed to be consistent with -perm -"
"000; that is, while it used to match no files, it now matches all files."
msgstr ""
"atencion : avètz especificat un motiu de permission %s (equivalent a /000). "
"Lo sens de -perm /000 es estat modificat per èsser consistent amb -perm -"
"000 ; es a dire qu'al luòc d'aver pas cap de fichièr correspondent, totes "
"los fichièrs correspondon d'ara enlà."

#: find/parser.c:2069
#, c-format
msgid "failed to compile regular expression '%s': %s"
msgstr ""

#: find/parser.c:2098
msgid "invalid null argument to -size"
msgstr "Paramètre nul invalid per l'opcion -size"

#: find/parser.c:2148
#, c-format
msgid "invalid -size type `%c'"
msgstr "tipe invalid per l'opcion -size « %c »"

#: find/parser.c:2158
#, c-format
msgid "Invalid argument `%s%s' to -size"
msgstr "Argument invalid « %s%s » per -size"

#: find/parser.c:2340
msgid ""
"The -show-control-chars option takes a single argument which must be "
"'literal' or 'safe'"
msgstr ""
"L'opcion -show-control-chars pren un unic argument que deu èsser « literal » "
"o « safe »"

#: find/parser.c:2454
#, c-format
msgid "Invalid argument %s to -used"
msgstr "Argument invalid %s per -used"

#: find/parser.c:2495
#, c-format
msgid "%s is not the name of a known user"
msgstr "%s es pas lo nom d'un utilizaire conegut"

#: find/parser.c:2502
msgid "The argument to -user should not be empty"
msgstr "L'argument de l'opcion -user deuriá pas èsser void"

#: find/parser.c:2527
#, c-format
msgid "Features enabled: "
msgstr "Foncions activadas : "

#: find/parser.c:2588
msgid "invalid predicate -context: SELinux is not enabled."
msgstr "predicat invalid -context : SELinux es pas activat."

#: find/parser.c:2652
#, c-format
msgid "Arguments to %s should contain at least one letter"
msgstr ""

#: find/parser.c:2717
#, c-format
msgid ""
"%s %c is not supported because symbolic links are not supported on the "
"platform find was compiled on."
msgstr ""

#: find/parser.c:2729
#, c-format
msgid ""
"%s %c is not supported because FIFOs are not supported on the platform find "
"was compiled on."
msgstr ""

#: find/parser.c:2741
#, c-format
msgid ""
"%s %c is not supported because named sockets are not supported on the "
"platform find was compiled on."
msgstr ""

#: find/parser.c:2757
#, c-format
msgid ""
"%s %c is not supported because Solaris doors are not supported on the "
"platform find was compiled on."
msgstr ""

#: find/parser.c:2765
#, c-format
msgid "Unknown argument to %s: %c"
msgstr ""

#: find/parser.c:2773
#, c-format
msgid "Duplicate file type '%c' in the argument list to %s."
msgstr ""

#: find/parser.c:2789
#, c-format
msgid "Must separate multiple arguments to %s using: ','"
msgstr ""

#: find/parser.c:2798
#, c-format
msgid ""
"Last file type in list argument to %s is missing, i.e., list is ending on: "
"','"
msgstr ""

#: find/parser.c:2857
#, c-format
msgid ""
"The current directory is included in the PATH environment variable, which is "
"insecure in combination with the %s action of find.  Please remove the "
"current directory from your $PATH (that is, remove \".\", doubled colons, or "
"leading or trailing colons)"
msgstr ""

#: find/parser.c:2869
#, c-format
msgid ""
"The relative path %s is included in the PATH environment variable, which is "
"insecure in combination with the %s action of find.  Please remove that "
"entry from $PATH"
msgstr ""
"Lo camin relatiu %s es inclús dins la variabla d'environament de camin "
"PATH ; aquò es pas securizat amb l'accion %s de find. Levatz aquesta entrada "
"dins $PATH."

#: find/parser.c:2980
msgid ""
"You may not use {} within the utility name for -execdir and -okdir, because "
"this is a potential security problem."
msgstr ""
"Podètz pas utilizar {} a l'interior del nom de l'utilitari per --execdir e -"
"okdir, perque aquò pausa un problèma potencial de seguretat."

#: find/parser.c:3006
#, c-format
msgid "Only one instance of {} is supported with -exec%s ... +"
msgstr "Una sola instància de {} es suportada amb -exec%s ... +"

#: find/parser.c:3016
#, c-format
msgid "In %s the %s must appear by itself, but you specified %s"
msgstr "Dins %s, lo %s deu aparéisser sol mas avètz especificat %s"

#: find/parser.c:3035
msgid "The environment is too large for exec()."
msgstr "L'environament es tròp voluminós per exec()."

#: find/parser.c:3204
#, c-format
msgid "arithmetic overflow while converting %s days to a number of seconds"
msgstr "depassament aritmetic pendent la conversion de %s jorns en segondas"

#: find/parser.c:3228
msgid "arithmetic overflow when trying to calculate the end of today"
msgstr "depassament aritmetic pendent lo calcul de la fin d'aqueste jorn"

#: find/parser.c:3387
msgid "standard error"
msgstr "sortida « errors » estandarda"

#: find/parser.c:3392
msgid "standard output"
msgstr "sortida estandarda"

#: find/pred.c:260
#, c-format
msgid "cannot delete %s"
msgstr "impossible de suprimir %s"

#: find/pred.c:650
#, c-format
msgid "WARNING: cannot determine birth time of file %s"
msgstr "ATENCION : impossible de trobar la data de creacion del fichièr %s"

#: find/pred.c:698
#, c-format
msgid "< %s ... %s > ? "
msgstr "< %s ... %s > ? "

#: find/pred.c:700
msgid "Failed to write prompt for -ok"
msgstr "Fracàs d'escritura del convit per -ok"

#: find/pred.c:1173 find/print.c:1238
#, c-format
msgid "getfilecon failed: %s"
msgstr "getfilecon a fracassat : %s"

#: find/print.c:335
#, c-format
msgid "warning: escape `\\' followed by nothing at all"
msgstr "atencion : sequéncia d'escapament « [nbsp]» seguida per res"

#: find/print.c:354
#, c-format
msgid "warning: unrecognized escape `\\%c'"
msgstr "atencion : sequéncia d'escapament « \\%c » desconeguda"

#: find/print.c:374 find/print.c:1260
#, c-format
msgid "error: %s at end of format string"
msgstr "error : %s a la fin de la cadena de format"

#: find/print.c:398
#, c-format
msgid "error: the format directive `%%%c' is reserved for future use"
msgstr ""
"error : la directiva de format « %%%c » es reservada per un usatge futur"

#: find/print.c:406
#, c-format
msgid ""
"warning: format directive `%%%c' should be followed by another character"
msgstr ""
"avertiment : la directiva de formatatge « %%%c » deuriá èsser seguida per un "
"autre caractèr"

#: find/print.c:414
#, c-format
msgid "warning: unrecognized format directive `%%%c'"
msgstr "atencion : directiva de formatatge « %%%c » desconeguda"

#: find/tree.c:115 find/tree.c:120 find/tree.c:226 find/tree.c:265
msgid "invalid expression"
msgstr "expression invalida"

#: find/tree.c:126
#, c-format
msgid ""
"invalid expression; you have used a binary operator '%s' with nothing before "
"it."
msgstr ""
"expression invalida ; avètz utilizat un operator binari « %s » pas precedit "
"d'una expression."

#: find/tree.c:145
#, c-format
msgid "expected an expression between '%s' and ')'"
msgstr "expression esperada entre « %s » e « ) »"

#: find/tree.c:155
#, c-format
msgid "expected an expression after '%s'"
msgstr "expression esperada aprèp « %s »"

#: find/tree.c:160
msgid "invalid expression; you have too many ')'"
msgstr "expression invalida ; i a tròp de « ) »"

#: find/tree.c:183
#, c-format
msgid ""
"invalid expression; expected to find a ')' but didn't see one. Perhaps you "
"need an extra predicate after '%s'"
msgstr ""

#: find/tree.c:198
msgid "invalid expression; empty parentheses are not allowed."
msgstr "expression invalida ; parentèsis voidas pas autorizadas."

#: find/tree.c:204
msgid ""
"invalid expression; I was expecting to find a ')' somewhere but did not see "
"one."
msgstr "expression invalida ; « ) » esperada mas pas detectada."

#: find/tree.c:211 find/tree.c:835
msgid "oops -- invalid expression type!"
msgstr "Ops -- tipe d'expression invalida !"

#: find/tree.c:283
#, c-format
msgid "oops -- invalid expression type (%d)!"
msgstr "Ops -- tipe (%d) de l'expression invalida !"

#: find/tree.c:1112
#, c-format
msgid ""
"warning: there is no entry in the predicate evaluation cost table for "
"predicate %s; please report this as a bug"
msgstr ""
"avertiment : i a pas d'entrada dins la taula dels còstes d'avaloracion dels "
"predicats pel predicat %s. Mercé de senhalar aqueste bug"

#: find/tree.c:1286
#, c-format
msgid "paths must precede expression: `%s'"
msgstr ""

#: find/tree.c:1288
#, c-format
msgid "possible unquoted pattern after predicate `%s'?"
msgstr ""

#: find/tree.c:1298
#, c-format
msgid "unknown predicate `%s'"
msgstr "predicat desconegut « %s »"

#: find/tree.c:1318
#, c-format
msgid "invalid predicate `%s'"
msgstr "predicat invalid « %s »"

#: find/tree.c:1322
#, c-format
msgid "invalid argument `%s' to `%s'"
msgstr "paramètre invalid « %s » per « %s »"

#: find/tree.c:1329
#, c-format
msgid "missing argument to `%s'"
msgstr "paramètre mancant per « %s »"

#: find/tree.c:1405
msgid "you have too many ')'"
msgstr "i a tròp de « ) »"

#: find/tree.c:1411
#, c-format
msgid "unexpected extra predicate '%s'"
msgstr "predicat suplementari inesperat « %s »"

#: find/tree.c:1413
msgid "unexpected extra predicate"
msgstr "predicat suplementari inesperat"

#: find/tree.c:1534
msgid "oops -- invalid default insertion of and!"
msgstr "Ops -- insercion per defaut de « and » invalida !"

#: find/util.c:139
msgid "Valid arguments for -D:\n"
msgstr ""

#: find/util.c:163 locate/frcode.c:142 locate/locate.c:1365 xargs/xargs.c:1702
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr ""

#: find/util.c:169
#, c-format
msgid ""
"Usage: %s [-H] [-L] [-P] [-Olevel] [-D debugopts] [path...] [expression]\n"
msgstr ""

#: find/util.c:173
msgid ""
"\n"
"default path is the current directory; default expression is -print\n"
"expression may consist of: operators, options, tests, and actions:\n"
msgstr ""
"\n"
"Lo repertòri utilizat per defaut es lo repertòri corrent ;\n"
"l'opcion per defaut es -print. Una expression benlèu\n"
"constituida d'operators, d'opcions, de tèsts e d'accions :\n"

#: find/util.c:176
msgid ""
"operators (decreasing precedence; -and is implicit where no others are "
"given):\n"
"      ( EXPR )   ! EXPR   -not EXPR   EXPR1 -a EXPR2   EXPR1 -and EXPR2\n"
"      EXPR1 -o EXPR2   EXPR1 -or EXPR2   EXPR1 , EXPR2\n"
msgstr ""
"las operators (per precedéncia descreissenta; -and es implicita\n"
"quand cap paramètre mai es pas provesit) :\n"
"      ( EXPR )   ! EXPR   -not EXPR   EXPR1 -a EXPR2   EXPR1 -and EXPR2\n"
"      EXPR1 -o EXPR2   EXPR1 -or EXPR2   EXPR1 , EXPR2\n"

#: find/util.c:180
msgid ""
"positional options (always true): -daystart -follow -regextype\n"
"\n"
"normal options (always true, specified before other expressions):\n"
"      -depth --help -maxdepth LEVELS -mindepth LEVELS -mount -noleaf\n"
"      --version -xdev -ignore_readdir_race -noignore_readdir_race\n"
msgstr ""
"las opcions posicionalas (totjorn vertadièras e.-a-d. « true ») :\n"
"      -daystart -follow -regextype\n"
"las opcions normalas (totjorn vertadièras e.-a-d. « true » e que devon èsser "
"especificadas\n"
"abans las autras expressions) :\n"
"      -depth --help -maxdepth NIVÈLS -mindepth NIVÈLS -mount -noleaf\n"
"      --version -xdev -ignore_readdir_race -noignore_readdir_race\n"

#: find/util.c:185
msgid ""
"tests (N can be +N or -N or N): -amin N -anewer FILE -atime N -cmin N\n"
"      -cnewer FILE -ctime N -empty -false -fstype TYPE -gid N -group NAME\n"
"      -ilname PATTERN -iname PATTERN -inum N -iwholename PATTERN -iregex "
"PATTERN\n"
"      -links N -lname PATTERN -mmin N -mtime N -name PATTERN -newer FILE"
msgstr ""
"las opcions de tèsts (N benlèu +N o -N o N) :\n"
"      -amin N -anewer FICHIÈR -atime N -cmin N\n"
"      -cnewer FICHIÈR -ctime N -empty -false -fstype TYPE -gid N -group NOM\n"
"      -ilname MOTIU -iname MOTIU -inum N -iwholename MOTIU -iregex MOTIU\n"
"      -links N -lname MOTIU -mmin N -mtime N -name MOTIU -newer FICHIÈR"

#: find/util.c:190
msgid ""
"\n"
"      -nouser -nogroup -path PATTERN -perm [-/]MODE -regex PATTERN\n"
"      -readable -writable -executable\n"
"      -wholename PATTERN -size N[bcwkMG] -true -type [bcdpflsD] -uid N\n"
"      -used N -user NAME -xtype [bcdpfls]"
msgstr ""

#: find/util.c:195
msgid "      -context CONTEXT\n"
msgstr "      -context CONTÈXTE\n"

#: find/util.c:197
msgid ""
