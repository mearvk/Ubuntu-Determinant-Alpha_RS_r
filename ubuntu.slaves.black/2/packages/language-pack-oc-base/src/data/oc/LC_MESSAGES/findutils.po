"rencontrat sus\n"
"                                 una linha en entrada, la rèsta de las "
"entradas es ignorada\n"
"                                 (ignorat se -0 o -D es estat especificat)\n"

#: xargs/xargs.c:1726
msgid ""
"  -e, --eof[=END]              equivalent to -E END if END is specified;\n"
"                                 otherwise, there is no end-of-file string\n"
msgstr ""
"  -e, --eof[=FIN]              equivalent a -E FIN se FIN es especificat. "
"Siquenon\n"
"                                  i a pas de cadena de fin de fichièr\n"

#: xargs/xargs.c:1728
msgid "  -I R                         same as --replace=R\n"
msgstr "  -I R                         identic a --replace=R\n"

#: xargs/xargs.c:1729
msgid ""
"  -i, --replace[=R]            replace R in INITIAL-ARGS with names read\n"
"                                 from standard input, split at newlines;\n"
"                                 if R is unspecified, assume {}\n"
msgstr ""

#: xargs/xargs.c:1732
msgid ""
"  -L, --max-lines=MAX-LINES    use at most MAX-LINES non-blank input lines "
"per\n"
"                                 command line\n"
msgstr ""
"  -L, --max-lines=LINHAS-MAX   utilizar al mai LINHAS-MAX linhas pas blancas "
"par\n"
"                                 linha de comanda\n"

#: xargs/xargs.c:1734
msgid ""
"  -l[MAX-LINES]                similar to -L but defaults to at most one non-"
"\n"
"                                 blank input line if MAX-LINES is not "
"specified\n"
msgstr ""
"  -l[LINHAS-MAX]               similaire a -L exceptat qu'una sola linha pas "
"blanca\n"
"                                 es utilizada se LINHAS-MAX es absent\n"

#: xargs/xargs.c:1736
msgid ""
"  -n, --max-args=MAX-ARGS      use at most MAX-ARGS arguments per command "
"line\n"
msgstr ""
"  -n, --max-args=ARG-MAX      utilizar al mai ARG-MAX per linha de comanda\n"

#: xargs/xargs.c:1737
msgid ""
"  -o, --open-tty               Reopen stdin as /dev/tty in the child "
"process\n"
"                                 before executing the command; useful to run "
"an\n"
"                                 interactive application.\n"
msgstr ""

#: xargs/xargs.c:1740
msgid ""
"  -P, --max-procs=MAX-PROCS    run at most MAX-PROCS processes at a time\n"
msgstr ""
"  -P, --max-procs=PROC-MAX     executar al mai PROC-MAX processus a l'encòp\n"

#: xargs/xargs.c:1741
msgid "  -p, --interactive            prompt before running commands\n"
msgstr ""
"  -p, --interactive             demandar abans d'executar las comandas\n"

#: xargs/xargs.c:1742
msgid ""
"      --process-slot-var=VAR   set environment variable VAR in child "
"processes\n"
msgstr ""
"      --process-slot-var=VAR    definir la variabla d'environament VAR dels "
"processus enfants\n"

#: xargs/xargs.c:1743
msgid ""
"  -r, --no-run-if-empty        if there are no arguments, then do not run "
"COMMAND;\n"
"                                 if this option is not given, COMMAND will "
"be\n"
"                                 run at least once\n"
msgstr ""
"  -r, --no-run-if-empty        executar pas la COMANDA se i a pas "
"d'argument.\n"
"                                 Se aquesta opcion es absenta, la COMANDA "
"serà\n"
"                                 executada al mens un còp\n"

#: xargs/xargs.c:1746
msgid ""
"  -s, --max-chars=MAX-CHARS    limit length of command line to MAX-CHARS\n"
msgstr ""
"  -s, --max-chars=CAR-MAX     limitar la longor d'una linha de comanda a CAR-"
"MAX\n"

#: xargs/xargs.c:1747
msgid "      --show-limits            show limits on command-line length\n"
msgstr ""
"      --show-limits            afichar los limits sus la longor d'una linha "
"de comanda\n"

#: xargs/xargs.c:1748
msgid "  -t, --verbose                print commands before executing them\n"
msgstr ""
"  -t, --verbose                afichar las comandas abans de las executar\n"

#: xargs/xargs.c:1749
msgid ""
"  -x, --exit                   exit if the size (see -s) is exceeded\n"
msgstr ""
"  -x, --exit                   terminer se la talha es depassada (veire -s)\n"

#: find/util.c:206 xargs/xargs.c:1751
msgid "      --help                   display this help and exit\n"
msgstr ""
"      --help                   afichar aqueste ajudamemòria e quitar\n"

#: find/util.c:207 xargs/xargs.c:1752
msgid ""
"      --version                output version information and exit\n"
"\n"
msgstr ""
