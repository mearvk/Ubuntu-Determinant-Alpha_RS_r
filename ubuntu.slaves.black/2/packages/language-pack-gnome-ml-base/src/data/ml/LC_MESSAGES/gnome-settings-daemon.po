#: data/org.gnome.settings-daemon.plugins.media-keys.gschema.xml.in:698
msgid "Command"
msgstr "കമാൻഡ്"

#: data/org.gnome.settings-daemon.plugins.media-keys.gschema.xml.in:699
msgid "Command to run when the binding is invoked"
