msgstr "ടെക്സ്റ്റിലുളള ലിങ്കുകള്‍ തിരിച്ചറിഞ്ഞ് അവയെ മാറ്റുക."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:13
msgid "Automatic emoticon recognition"
msgstr "ഓട്ടോമാറ്റിക്കായി ഇമോട്ടൈക്കണ്‍  തിരിച്ചറിയല്‍"

