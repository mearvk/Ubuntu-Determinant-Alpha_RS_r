#: data/org.gnome.Chess.appdata.xml.in:7
msgid "GNOME Chess"
msgstr "ഗ്നോം ചെസ്സ്"

#: data/org.gnome.Chess.appdata.xml.in:8 data/org.gnome.Chess.desktop.in:5
msgid "Play the classic two-player board game of chess"
msgstr "രണ്ടു പേര്‍ക്ക് കളിക്കാവുന്ന ക്ലാസ്സിക്‌ ചെസ്സ്‌ കളി കളിക്കൂ"

#: data/org.gnome.Chess.appdata.xml.in:10
msgid ""
"GNOME Chess is a simple chess game. You can play against your computer at "
"three different difficulty levels, or against a friend at your computer."
msgstr ""
"ഗ്നോം ചെസ്സ് ലളിതമായ ഒരു ചെസ്സ് കളിയാണ്. നിങ്ങളുടെ കമ്പ്യൂട്ടറിന് എതിരായി "
"മൂന്ന് വ്യത്യസ്ത കഠിനതാതലങ്ങളിൽ കളിക്കുകയോ ,അല്ലെങ്കിൽ നിങ്ങളുടെ "
"കമ്പ്യൂട്ടറിൽ ഒരു സുഹൃത്തിനെതിരെയോ കളിക്കുകയോ ചെയ്യാം."

#: data/org.gnome.Chess.appdata.xml.in:14
msgid ""
"Computer chess enthusiasts will appreciate GNOME Chess’s compatibility with "
"nearly all modern computer chess engines, and its ability to detect several "
"popular engines automatically if installed."
msgstr ""
"ആധുനിക കമ്പ്യൂട്ടർ ചെസ്സ് എഞ്ചിനുകളുമായി ഗ്നോം ചെസ്സിന്റെ അനുയോജ്യതയും, "
"നിരവധി ജനപ്രിയ എഞ്ചിനുകൾ ഇൻസ്റ്റാൾ ചെയ്തിട്ടുണ്ടെങ്കിൽ തനിയേ "
"കണ്ടെത്തുന്നതിനുള്ള കഴിവും ചെസ്സ് പ്രേമികൾക്ക് പ്രിയങ്കരമായിരിക്കും."

#: data/org.gnome.Chess.appdata.xml.in:72
msgid "The GNOME Project"
msgstr "ഗ്നോം പ്രോജക്റ്റ്"

#: data/org.gnome.Chess.desktop.in:4
msgid "Chess Game"
msgstr "ചെസ്സ് കളി"

