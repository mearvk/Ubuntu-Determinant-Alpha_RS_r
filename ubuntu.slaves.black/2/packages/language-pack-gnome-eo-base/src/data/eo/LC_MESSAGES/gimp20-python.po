msgstr ""

#: ../plug-ins/pygimp/plug-ins/spyro_plus.py:1474
msgid "Hole percent"
msgstr ""

#: ../plug-ins/pygimp/plug-ins/spyro_plus.py:1475
msgid ""
"How far is the hole from the center of the moving gear. 100% means that the "
"hole is at the gear's edge."
msgstr ""

