#. ChangelogURI
#: ../data/templates/Ubuntu.info.in.h:4
#, no-c-format
msgid "http://changelogs.ubuntu.com/changelogs/pool/%s/%s/%s/%s_%s/changelog"
msgstr ""
"http://changelogs.ubuntu.com/changelogs/pool/%s/%s/%s/%s_%s/changelog"

#. Description
#: ../data/templates/Ubuntu.info.in:33
msgid "Ubuntu development series"
msgstr "Ubuntu တိုးတက်မှုအဆက်များ"

#. CompDescriptionLong
#: ../data/templates/Ubuntu.info.in:112
msgid "Canonical-supported free and open-source software"
msgstr "Canonical-အခမဲ့ထောက်ပံပေးထား နှင့် open-source ဆော့ဝဲလ်"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:114
msgid "Community-maintained"
msgstr "အဖွဲ့အစည်းမှထိန်းသိမ်းစောင့်ရှောက်ထားသော"

#. CompDescriptionLong
#: ../data/templates/Ubuntu.info.in:115
msgid "Community-maintained free and open-source software"
msgstr "သက်ဆိုင်ရာကဏ္ဍ - ထိန်းသိမ်းထား၊အခမဲ့နှင့် open-source ဆော့၀ဲရ်"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:117
msgid "Non-free drivers"
msgstr "အခမဲ့မဟုတ်သော driver များ"

#. CompDescriptionLong
#: ../data/templates/Ubuntu.info.in:118
msgid "Proprietary drivers for devices"
msgstr "ကိရိယာအတွက် အခမဲ့မဟုတ်သောိ driver"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:121
msgid "Restricted software"
msgstr "ကန့်သတ်ထားသောဆော့ဝဲလ်"

#. CompDescriptionLong
#: ../data/templates/Ubuntu.info.in:122
msgid "Software restricted by copyright or legal issues"
msgstr ""
"မူပိုင်ခွင့် သို့မဟုတ် ဥပဒေဆိုင်ရာ ပြဿနာများဖြင့် ကန့်သတ်ထားသည့်ဆော့ဖ်ဝဲရ်"

#. Description
#: ../data/templates/Ubuntu.info.in:129
msgid "Ubuntu {version} '{codename}'"
msgstr "Ubuntu {version} '{codename}'"

#. Description
#: ../data/templates/Ubuntu.info.in:137
msgid "Installation medium with Ubuntu {version} '{codename}'"
msgstr "Ubuntu {version} '{codename}' ဖြင့် ထည့်သွင်းခြင်းကြားခံ"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:140 ../data/templates/Debian.info.in:113
msgid "Officially supported"
msgstr "တရားဝင်ထောက်ပံ့ထားသော"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:142
msgid "Restricted copyright"
msgstr "ကန့်သတ်ထားသောမူပိုင်ခွင့်"

#. Description
#: ../data/templates/Ubuntu.info.in:149
msgid "Canonical Partners"
msgstr "Canonical ၏လုပ်ဖော်ကိုင်ဖက်များ"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:151
msgid "Software packaged by Canonical for their partners"
msgstr ""
"၎င်းတို့၏မိတ်ဖက်များအတွက် Canonical မှ ပက်ကေ့ဂျ်လုပ်ထားသည့်ဆော့ဖ်ဝဲရ်"

#. CompDescriptionLong
#: ../data/templates/Ubuntu.info.in:152
msgid "This software is not part of Ubuntu."
msgstr "ဒီဆော့ဝဲလ်သည် ဦးဘန္တု အပိုင်းမဟုတ်ချေ။"

#. Description
#: ../data/templates/Ubuntu.info.in:160
msgid "Independent"
msgstr "မည်သည်နှင့်မှမသက်ဆိုင်သော"

#. CompDescription
#: ../data/templates/Ubuntu.info.in:162
msgid "Provided by third-party software developers"
msgstr "third-party ဆော့ဖ်ဝဲရ်ရေးသားသူများမှ ပံ့ပိုးပေးထားပါသည်။"

#. CompDescriptionLong
#: ../data/templates/Ubuntu.info.in:163
msgid "Software offered by third party developers."
msgstr "Third Party Developer များမှ ပေးထားသည့် ဆော့ဖ်ဝဲရ်"

#. Description
#: ../data/templates/Ubuntu.info.in:182
msgid "Important security updates"
msgstr "အရေးကြီးသော လုံခြုံရေးအသစ်များ"

#. Description
#: ../data/templates/Ubuntu.info.in:195 ../data/templates/Debian.info.in:53
msgid "Recommended updates"
msgstr "အကြံပြုအပ်ဒိတ်များ"

#. Description
#: ../data/templates/Ubuntu.info.in:208
msgid "Pre-released updates"
msgstr "ကြိုပြီးထုတ်သော အသစ်ထွက်ရှိမှု့များ"

#. Description
#: ../data/templates/Ubuntu.info.in:221
msgid "Unsupported updates"
msgstr "မထောက်ပံ့ထားသော အသစ်ထွက်ရှိမှု့များ"

#. ChangelogURI
#: ../data/templates/Debian.info.in.h:4
#, no-c-format
msgid "http://packages.debian.org/changelogs/pool/%s/%s/%s/%s_%s/changelog"
msgstr "http://packages.debian.org/changelogs/pool/%s/%s/%s/%s_%s/changelog"

#. Description
#: ../data/templates/Debian.info.in:25
msgid "Debian {version} '{codename}'"
msgstr "Debian {version} '{codename}'"

#. Description
#: ../data/templates/Debian.info.in:47
msgid "Security updates"
msgstr "လုံခြုံရေးအသစ်ထွက်ရှိမှု့များ"

#. Description
#: ../data/templates/Debian.info.in:59
msgid "Proposed updates"
msgstr "အဆိုပြုထားနောက်ဆုံးအသစ်များ"

#. Description
#: ../data/templates/Debian.info.in:66
msgid "Debian current stable release"
msgstr "Debian ယခုလက်ရှိတည်ငြိမ်သောထွက်ရှိမှု့"

#. Description
#: ../data/templates/Debian.info.in:81
msgid "Debian testing"
msgstr "Debian စမ်းသပ်ခြင်း"

#. Description
#: ../data/templates/Debian.info.in:111
msgid "Debian 'Sid' (unstable)"
msgstr "Debian 'Sid' (မတည်ငြိမ်)"

#. CompDescription
#: ../data/templates/Debian.info.in:115
msgid "DFSG-compatible Software with Non-Free Dependencies"
msgstr "DFSG-compatible Software with Non-Free Dependencies"

#. CompDescription
#: ../data/templates/Debian.info.in:119
msgid "Non-DFSG-compatible Software"
msgstr "Non-DFSG-compatible Software"

#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "%s အတွက်ဆာဗာ"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "အဓိကဆာဗာ"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "စိတ်ကြိုက်ဆာဗာများ"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "'%s' အတွက် ဖော်ပြချက်ပျောက်ဆုံးနေပါတယ် သတင်းပို့ပေးပါ"

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"%s' (%s) အတွက် ဖော်ပြချက်တွင် မှန်ကန်မှုမရှိသောယူနီကုဒ်။ ကျေးဇူးပြု၍ "
"သတင်းပို့ပါရန်။"

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "ပြောင်းလဲမှု့စာရင်းမရရှိနိုင်ပါ"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"အပြောင်းအလဲများကိုစာရင်းမရနိုင်ပါ။ \n"
"ကျေးဇူးပြု၍ http://launchpad.net/ubuntu/+source/%s/%s/+changelog "
"ကိုအသုံးပြုပါ \n"
"အပြောင်းအလဲများကိုမရရှိနိုသည်အထိသို့မဟုတ်နောက်မှထပ်ကြိုးစားပါသည်အထိ။"

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"ပြောင်းလဲမှု့စာရင်းကိုဒေါင်းလုတ်မချနိုင်ပါ။ \n"
"ကျေးဇူးပြု၍သင်၏အင်တာနက်ကွန်နက်ရှင်ကိုစစ်ဆေးပါ။"

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "'% s' ဖိုင်တွဲများကိုဖတ်မရပါ"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "'% s' အတွက်ထိန်းချုပ်မှုဖိုင်များအားဖတ်မရပါ"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Dependency မှာ အားရစရာမကောင်းပါ။ - %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "ထည့်သွင်းထားသော package '% s' နှင့်ပိပက္ခများ"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "ပက်ကေ့ဂျ်တွင် Architecture field မရှိပါ။"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"မှားယွင်းနေသော architecture '%s' -- dpkg --add-architecture ကို "
"ထည့်သွင်းပြီး နောက်မှအပ်ဒိတ်လုပ်ရန်"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "နောက်ဆုံးပေါ်ဗားရှင်းကို သွင်းထားပြီးပါပြီ"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr ""
"dependencies အားလုံးအတွက် ဖြည့်ဆည်းပေးရန်မှာ မအောင်မြင်ပါ။ (ကျိုးပျက်နေသော "
"ကက်ရှ်)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "'%s' ကိုမသွင်းနိုင်ပါ"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"အလိုအလျောက် decompressed:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "ထုတ်နိုင်သော ascii သို့အလိုအလျောက်ပြောင်းလဲခြင်း:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"%s ကို တည်ဆောက်ပေးသော အရင်းအမြစ်ပက်ကေ့ဂျ် '%s' အတွက် Build-Dependencies ကို "
"ထည့်သွင်းပါ။\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "မရှိမဖြစ်လိုအပ်သော package တစ်ခုကိုဖယ်ရှားလိမ့်မည်"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... ပြီးပါပြီ"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "နှိပ်ပါ "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "ရယူရန် -"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [အလုပ်လုပ်နေပါသည်]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"မီဒီယာပြောင်းလဲမှု - ကျေးဇူးပြု၍ တံဆိပ်တပ်ထားသော Disc ကိုထည့်သွင်းပါ။\n"
"'%s'\n"
"Drive တွင် '%s' ထည့်သွင်းပြီး Enter နှိပ်ပါ။\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "%s (%sB/s) ရှိ %sB ကို ရယူခဲ့သည်။\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""
"ကျေးဇူးပြု၍ 'Debian 2.1r1 Disk 1' ကဲ့သို့သော ဤကြားခံအတွက် အမည်တစ်ခုပေးပါ။"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "ကျေးဇူးပြု၍ ထည့်သွင်းမှုကြားခံတစ်ခုထည့်သွင်းပြီး Enter နှိပ်ပါ။"
