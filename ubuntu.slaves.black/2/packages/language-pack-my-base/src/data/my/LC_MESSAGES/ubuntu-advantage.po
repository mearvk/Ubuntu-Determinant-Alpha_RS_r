#: hook.cc:237
#, c-format
msgid "%d of the updates is from UA Apps: ESM."
msgid_plural "%d of the updates are from UA Apps: ESM."
msgstr[0] "မွမ်းမံပြင်ဆင်မှုများ၏ %d သည် UA Apps မှ ဖြစ်သည် - ESM"

#: hook.cc:252
#, c-format
msgid "%d additional update is available with UA Infra: ESM."
msgid_plural "%d additional updates are available with UA Infra: ESM."
msgstr[0] ""
"UA Infra ဖြင့် နောက်ထပ်မွမ်းမံပြင်ဆင်မှုများ %d ကို ရနိုင်ပါသည် - ESM"

#: hook.cc:261
#, c-format
msgid "%d additional update is available with UA Apps: ESM."
