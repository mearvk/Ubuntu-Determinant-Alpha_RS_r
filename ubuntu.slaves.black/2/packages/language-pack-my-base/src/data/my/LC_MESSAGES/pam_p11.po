#: src/pam_p11.c:205
msgid "Error loading PKCS#11 module"
msgstr "PKCS#11 မော်ဂျူးကို ဖွင့်ရာတွင် အမှားအယွင်းရှိနေသည်။"

#: src/pam_p11.c:213 src/pam_p11.c:265
msgid "Error initializing PKCS#11 module"
msgstr "PKCS#11 module ကို စတင်ရာတွင် အမှားအယွင်းရှိနေသည်။"

#: src/pam_p11.c:333
msgid " (last try)"
msgstr " (last try)"

#: src/pam_p11.c:340
#, c-format
msgid "Login on PIN pad with %s%s"
msgstr "%s%s ဖြင့် PIN pad တွင် အကောင့်ဝင်ပါ။"

#: src/pam_p11.c:346
#, c-format
msgid "Login with %s%s: "
msgstr "%s%s ဖြင့် ဝင်ရောက်ပါ။ "

#: src/pam_p11.c:370
msgid "Invalid PIN"
msgstr "ပင်နံပါတ် မမှန်ကန်ပါ။"

#: src/pam_p11.c:378
msgid "PIN not verified; PIN locked"
msgstr "ပင်နံပါတ်ကို အတည်မပြုရသေးပါ။ ပင်နံပါတ် လော့ခ်ချထားသည်။"

#: src/pam_p11.c:380
msgid "PIN not verified; one try remaining"
msgstr "ပင်နံပါတ် အတည်မပြုရသေးပါ။ တစ်ခါကြိုးစား၍ ရနိုင်ပါသေးသည်။"

#: src/pam_p11.c:382
msgid "PIN not verified"
msgstr "ပင်နံပါတ်ကို အတည်မပြုရသေးပါ။"

#: src/pam_p11.c:424
#, c-format
msgid "Change PIN with PUK on PIN pad for %s"
msgstr "%s အတွက် PIN pad ရှိ PUK ဖြင့် PIN ကို ပြောင်းပါ။"

#: src/pam_p11.c:428
#, c-format
msgid "Change PIN on PIN pad for %s"
msgstr "%s အတွက် PIN pad ပေါ်တွင် PIN နံပါတ် ပြောင်းပါ။"

#: src/pam_p11.c:435
#, c-format
msgid "PUK for %s: "
msgstr "%s အတွက် PUK "

#: src/pam_p11.c:446
msgid "Current PIN: "
msgstr "လက်ရှိ ပင်နံပါတ်- "

#: src/pam_p11.c:464
msgid "Enter new PIN: "
msgstr "ပင်နံပါတ်အသစ်ရိုက်ထည့်ပါ- "

#: src/pam_p11.c:467
msgid "Retype new PIN: "
msgstr "ပင်နံပါတ်အသစ်ကို ပြန်ရိုက်ပါ- "

#: src/pam_p11.c:471
msgid "PINs don't match"
msgstr "ပင်နံပါတ်များမှာ ကိုက်ညီမှုမရှိပါ။"

#: src/pam_p11.c:478
msgid "PIN not changed; PIN locked"
msgstr "ပင်နံပါတ် မပြောင်းပါ။ ပင်နံပါတ် လော့ခ်ချထားသည်။"

#: src/pam_p11.c:480
msgid "PIN not changed; one try remaining"
msgstr "ပင်နံပါတ် မပြောင်းပါ။ တစ်ခါကြိုးစား၍ ရနိုင်ပါသေးသည်။"

#: src/pam_p11.c:482
msgid "PIN not changed"
msgstr "ပင်နံပါတ် မပြောင်းပါ။"

#: src/pam_p11.c:610
msgid "No token found"
msgstr "တိုကင်မတွေ့ပါ။"

#: src/pam_p11.c:612
msgid "No authorized keys on token"
msgstr "တိုကင်တွင် ခွင့်ပြုထားသော ကီးများ မရှိပါ။"

#: src/pam_p11.c:674
msgid "Error verifying key"
msgstr "ကီးစစ်ဆေးရာတွင် အမှားအယွင်းရှိနေသည်။"
