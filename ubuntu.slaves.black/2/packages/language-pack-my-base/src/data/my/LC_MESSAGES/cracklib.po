#: lib/fascist.c:516
msgid "it is based on your username"
msgstr "သင်၏အသုံးပြုသူအမည်ပေါ်တွင်ထိုအရာသည်အ ခြေခံသည်"

#: lib/fascist.c:576
msgid "it is based upon your password entry"
msgstr "သင်၏စကားစုသွင်းချက်ပေါ်တွင်ထိုအရာသည်အခြေခံသည်"

#: lib/fascist.c:591
msgid "it is derived from your password entry"
msgstr "သင်၏စကားဝှက်သွင်းချက်ပေါ်မှာထိုအရာရရှိသည်"

#: lib/fascist.c:599
msgid "it's derived from your password entry"
msgstr "သင်၏စကားဝှက်သွင်းချက်ပေါ်မှာထိုအရာရရှိသည်"

#: lib/fascist.c:608
msgid "it is derivable from your password entry"
msgstr "သင်၏စကားဝှက်သွင်းချက်ပေါ်မှာထိုအရာရရှိနိုင်သည်"

#: lib/fascist.c:617
msgid "it's derivable from your password entry"
msgstr "သင်၏စကားဝှက်သွင်းချက်ပေါ်မှာထိုအရာရရှိနိုင်သည်"

#: lib/fascist.c:674
msgid "you are not registered in the password file"
msgstr "စကားဝှက်ဖိုင်အတွင်းသင်သည်စာရင်းမသွင်းခဲ့ပါ"

#: lib/fascist.c:709
msgid "it is WAY too short"
msgstr "အရာသည်အလွန်တိုလွန်းနေနိုင်သည်"

#: lib/fascist.c:714
msgid "it is too short"
msgstr "ထိုအရာသည်အလွန်တိုလွန်းသည်"

#: lib/fascist.c:731
msgid "it does not contain enough DIFFERENT characters"
msgstr "ထိုအရာတွင်မတူညီသောအက္ခရာမျုားလုံလောက်စွာမပါဝင်ပါ"

#: lib/fascist.c:745
msgid "it is all whitespace"
msgstr "ထိုအရာသည်နေရာအလွတ်အားလုံးဖြစ်သည်"

#: lib/fascist.c:764
msgid "it is too simplistic/systematic"
msgstr "၎င်းသည်အလွန်ရိုးရှင်း / စနစ်ကျသည်"

#: lib/fascist.c:769
msgid "it looks like a National Insurance number."
msgstr "ဒါကအမျိုးသားအာမခံနံပါတ်နဲ့တူတယ်။"

#: lib/fascist.c:801
msgid "it is based on a dictionary word"
msgstr "ထိုအရာသည်အဘိဓာန်တစ်ခု၏စကားလုံးပေါ်တွင်ခြေခံသည်"

#: lib/fascist.c:820
msgid "it is based on a (reversed) dictionary word"
msgstr "ထိုအရာသည် (reversed) အဘိဓာန်တစ်ခု၏စကားလုံးပေါ်တွင်ခြေခံသည်"

#: lib/fascist.c:865
msgid "error loading dictionary"
msgstr "အဘိဓာန်တင်ရာတွင်အမှားဖြစ်နေသည်"
