#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "အတွင်းပိုင်းမှားယွင်းချက် - %(1)s။"

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "သည်မြေပုံတွင် %(1)s -> %(2)s ပါပြီးသားဖြစ်သည်။"

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "သည်နည်းလမ်း %(1)s ကိုမထောက်ခံပါ။"

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr ""
"သည်နည်းလမ်း %(1)s takes %(2)s လျှောက်လွဲချက် (များ) (%(3)s ပေးခဲ့သော)။"

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "ခွင့်ပြုချက်ကိုပိတ်ပင်သည်။"

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"%(1)s အတွက် \"%(2)s\" တန်ဖိုးသည်ဤဆာဗာမှမထောက်ပံ့ပါ။သည်ဆာဗာသည် \"%(3)s\" "
"ဟုပြောသည်။"

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "%(2)s ကိုကိုင်တွယ်သော %(1)s သည်တရားမဝင်ပါ။"

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "သင်ကြိုးပမ်းခဲ့သောပြုလုပ်ပုံတစ်ခုကိုခွင့်မပြုခဲ့ပါ။"

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"သင်သတ်မှတ်ခဲ့ပြီးသောကွန်ရက်သည် PIF "
"တစ်ခုပူးတွဲပါဝင်နေသည်၊နှင့်ထို့ကြောင်နောက်တစ်ခုကိုမပူးတွဲနိုင်တော့ပါ။"

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
