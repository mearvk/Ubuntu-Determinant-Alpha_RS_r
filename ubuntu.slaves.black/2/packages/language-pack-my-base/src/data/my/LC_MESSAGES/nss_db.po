msgstr ""
"မူ​ပိုင်​ခွင့် (C) %s အခ​မဲ့ Software Foundation, Inc.\n"
"ဤ​ဟာ​သည် အခ​မဲ့ software ဖြစ်​ပါ​သည်။ ကူး​ယူ​လို​ပါ​က မူလ​အရင်း​မြစ် "
"(source) မှ​ကြည့်ပါ။\n"
"သတိပေးချက် ; ပြန်လည်​ရောင်းချ ခြင်း မ​ပြု​ရ။\n"

#: src/makedb.c:253
#, c-format
msgid "Written by %s.\n"
msgstr "%s မှရေးသားသည်။\n"

#: src/makedb.c:330
msgid "duplicate key"
msgstr "ထပ်တူထပ်မျှကူးယူသော key"

#: src/makedb.c:336
#, c-format
msgid "while writing database file: %s"
msgstr "database file ကိုရေးသားနေချိန်တွင် %s"

#: src/makedb.c:348
#, c-format
msgid "problems while reading `%s'"
msgstr "`%s' ကိုဖတ်နေချိန်တွင် ပြသာနတတ်နေသည်။"

#: src/makedb.c:371 src/makedb.c:389
#, c-format
msgid "while reading database: %s"
msgstr "database ကိုဖတ်နေချိန်တွင် : %s"
