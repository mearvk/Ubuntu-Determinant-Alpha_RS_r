#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "key အား စာလုံး​အသေး​သို ့​ပြောင်း​ပါ။"

#: src/makedb.c:69
msgid "NAME"
msgstr "အမည်"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "Output ကို file အမည်တွင်ရေးပါ"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "Database ဆောက်​နေ​ချိန်​မှာ အချက်အလက်​များ​ကို​မဖော်​ပြ​ပါ​နှင့်"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr ""
"database file မှာ "
"ပါ၀င်သည်များကိုအဝင်လမ်းကြောင်းတစ်ကြောင်းခြင်းဖြင်ေ​ဖာ​်​ြ​ပ​ပါ"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "textual input မှရိုးရိုး DB database သို ့ဖန်တီးပါ။"

#. Strings for arguments in help texts.
#: src/makedb.c:81
msgid ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"
msgstr ""
"အဝင်file - အထွက် file\n"
"-o အထွက် - FILE အဝင်-FILE\n"
"-u အဝင်-FILE"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "လျှောက်လွဲ ချက်များရှိကိန်းဂဏန်းအမှား"

#: src/makedb.c:154
#, c-format
msgid "cannot open database file `%s': %s"
msgstr "database file ကို ဖွင့်လို ့မရပါ။ `%s': %s"

#: src/makedb.c:173
#, c-format
msgid "cannot open input file `%s'"
msgstr "အဝင် file ကို ဖွင့်လို ့မရပါ။ `%s'"

#: src/makedb.c:187
#, c-format
msgid "cannot open output file `%s': %s"
msgstr "အထွက် file ကို ဖွင့်လို ့မရပါ `%s': %s"

#. We print some extra information.
#: src/makedb.c:235
msgid "Report bugs using the `glibcbug' script to <bugs@gnu.org>.\n"
msgstr ""
"`glibcbug' script ကို အသုံးပြုပြီး bugs ကို  <bugs@gnu.org>.←သိို ့report "
"လုပ်ပါ။\n"

