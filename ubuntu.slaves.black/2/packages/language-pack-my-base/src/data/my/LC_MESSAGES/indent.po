#: src/args.c:673
msgid ""
"usage: indent file [-o outfile ] [ options ]\n"
"       indent file1 file2 ... fileN [ options ]\n"
msgstr ""
"usage: indent file [-o outfile ] [ options ]\n"
"       indent file1 file2 ... fileN [ options ]\n"

#: src/args.c:740
#, c-format
msgid "%s: missing argument to parameter %s\n"
msgstr "%s: %s သတ်မှတ်ချက်ဘောင်သို့ပျောက်ဆုံးနေသောလျောက်လွဲချက်\n"

#: src/args.c:864
#, c-format
msgid "%s: unknown option \"%s\"\n"
msgstr "%s: မသိရွိေသာေရြးပိုင္ခြင့္ \"%s\"\n"

#: src/args.c:877
#, c-format
msgid "option: %s\n"
msgstr "ေရြးပိုင္ခြင့္- %s\n"

#: src/args.c:892
#, c-format
msgid "GNU indent %s\n"
msgstr "GNU indent %s\n"

#: src/args.c:959
#, c-format
msgid "%s: option ``%s'' requires a numeric parameter\n"
msgstr ""
"%s: ရွေးပိုင်ခွင့် ``%s'' "
"ကိန်းဂဏန်းတစ်ခုနှင့်ပတ်သက်သောသတ်မှတ်ချက်ဘောင်အတွင်းတွင်လိုအပ်သည်။\n"

#: src/args.c:966
#, c-format
msgid "set_option: internal error: p_type %d\n"
msgstr "set_option: internal error: p_type %d\n"

#: src/args.c:1022
msgid "Profile contains an unterminated comment"
msgstr "အချက်အလက်အတွင်းတွင်အဆုံးသတ်၍မရသောမှတ်ချက်တစ်ခုပါဝင်သည်"

#: src/args.c:1060
msgid "Profile contains unpalatable characters"
msgstr "အချက်အလက်အတွင်းတွင်လက်ခံ ၊ ထည့်သွင်းရန်ခက်ခဲသောအက္ခရာများပါဝင်သည်"

