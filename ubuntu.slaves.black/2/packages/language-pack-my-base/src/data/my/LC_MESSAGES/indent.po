#, c-format
msgid ""
"File named by environment variable %s does not exist or is not readable"
msgstr ""

#: src/backup.c:463
#, c-format
msgid "indent:  Strange version-control value\n"
msgstr "indent:  ထူးခြားသောမူကွဲ-ထိန်းချုပ်သောတန်ဖိုး\n"

#: src/backup.c:464
#, c-format
msgid "indent:  Using numbered-existing\n"
msgstr "indent: သတ်မှတ်ထားသည့်ကိန်းဂဏန်းကိုအသုံးပြုခြင်း-တည်ဆဲ\n"

