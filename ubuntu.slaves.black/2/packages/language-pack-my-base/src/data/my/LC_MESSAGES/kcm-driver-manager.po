#: Module.cpp:77
msgctxt "@title/rich"
msgid "<title>Your computer requires no proprietary drivers</title>"
msgstr ""
"<title>သင့်ကွန်ပျူတာသည် တစ်ဦးတည်းပိုင် Driver များ မလိုအပ်ပါ။</title>"

#: Module.cpp:130
msgctxt ""
"The backend is trying to figure out what drivers are suitable for the users "
"system"
msgid "Collecting information about your system"
msgstr "သင့်စနစ်ဆိုင်ရာ အချက်အလက်များ စုဆောင်းခြင်း။"

#: Module.cpp:220 DriverManager.cpp:248
msgctxt "@label"
msgid ""
"The package system could not be initialized, your configuration may be "
"broken."
msgstr "ပက်ကေ့ဂျ်စနစ် စတင်၍မရပါ။ ဖွဲ့စည်းပုံ ပျက်စီးသွားနိုင်ပါသည်။"

#: Module.cpp:232
msgctxt "The backend replied with a error"
msgid ""
"Something went terribly wrong. Please hit the 'Refresh Driver List' button"
msgstr ""
"တစ်စုံတစ်ခု ဆိုးဆိုးရွားရွား မှားယွင်းခဲ့ပါသည်။ ကျေးဇူးပြု၍ 'Refresh Driver "
"List' ခလုတ်ကို နှိပ်ပါ။"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr " ,Launchpad Contributions:,Wint Theingi Aung"

