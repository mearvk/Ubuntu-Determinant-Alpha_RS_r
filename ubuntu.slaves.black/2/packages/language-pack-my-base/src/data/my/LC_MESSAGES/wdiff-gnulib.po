#: lib/error.c:188
msgid "Unknown system error"
msgstr "မသိရှိသောစနစ်အမှား"

#: lib/getopt.c:547 lib/getopt.c:576
#, c-format
msgid "%s: option '%s' is ambiguous; possibilities:"
msgstr ""

#: lib/getopt.c:624 lib/getopt.c:628
#, c-format
msgid "%s: option '--%s' doesn't allow an argument\n"
msgstr "%s: ရွေးချယ်မှ ု '--%s' လျောက်လွဲချက်တစ်ခုုကိုခွင့်မပြုပါ\n"

#: lib/getopt.c:637 lib/getopt.c:642
#, c-format
msgid "%s: option '%c%s' doesn't allow an argument\n"
msgstr "%s: ရွေးချယ်မှ ု'%c%s' လျောက်လွဲချက်တစ်ခုုကိုခွင့်မပြုပါ\n"

#: lib/getopt.c:685 lib/getopt.c:704
#, c-format
msgid "%s: option '--%s' requires an argument\n"
msgstr "%s: ရွေးချယ်မှ ု'--%s' လျောက်လွဲချက်တစ်ခုကိုလိုအပ်သည်\n"

#: lib/getopt.c:742 lib/getopt.c:745
#, c-format
msgid "%s: unrecognized option '--%s'\n"
msgstr "%s: အသိအမှတ်မပြုခဲ့သောရွေးချယ်မှ ု'--%s\n"

#: lib/getopt.c:753 lib/getopt.c:756
#, c-format
msgid "%s: unrecognized option '%c%s'\n"
msgstr "%s: အသိအမှတ်မပြုခဲ့သောရွေးချယ်မှ ု'%c%s'\n"

#: lib/getopt.c:805 lib/getopt.c:808
#, c-format
msgid "%s: invalid option -- '%c'\n"
msgstr "%s: မတည်ရှိသောရွေးချယ်မှ ု-- '%c'\n"

#: lib/getopt.c:861 lib/getopt.c:878 lib/getopt.c:1088 lib/getopt.c:1106
#, c-format
msgid "%s: option requires an argument -- '%c'\n"
msgstr "%s: ရွေးချယ်မှ ုအတွက်လျောက်လွဲချက်တစ်ခုလိုအပ်သည် -- '%c'\n"

#: lib/getopt.c:934 lib/getopt.c:950
#, c-format
msgid "%s: option '-W %s' is ambiguous\n"
msgstr "%s:  ရွေးချယ်မှ ု'-W %s' သည်မရေမရာဖြစ်နေသည်\n"

#: lib/getopt.c:974 lib/getopt.c:992
#, c-format
msgid "%s: option '-W %s' doesn't allow an argument\n"
msgstr "%s: ရွေးချယ်မှ ု '-W %s' လျောက်လွဲချက်တစ်ခုကိုခွင့်မပြုပါ\n"

#: lib/getopt.c:1013 lib/getopt.c:1031
#, c-format
msgid "%s: option '-W %s' requires an argument\n"
msgstr "%s: ရွေးချယ်မှ ု '-W %s' လျောက်လွဲချက်တစ်ခုကိုလိုအပ်သည်\n"

#: lib/regcomp.c:131
msgid "Success"
msgstr "အောင်မြင်မှု"

#: lib/regcomp.c:134
msgid "No match"
msgstr "မကိုက်ညီမှ ု"

#: lib/regcomp.c:137
msgid "Invalid regular expression"
msgstr "မတည်ရှိသောပုံမှန်ဖော်ပြချက်"

#: lib/regcomp.c:140
msgid "Invalid collation character"
msgstr "မတည်ရှိသောအက္ခရာစုစည်းစီစဉ်ခြင်း။"

#: lib/regcomp.c:143
msgid "Invalid character class name"
msgstr "မတည်ရှိသောအက္ခရာအမျိုးအစားသတ်မှတ်ချက်အမည်"

#: lib/regcomp.c:146
msgid "Trailing backslash"
msgstr ""

#: lib/regcomp.c:149
msgid "Invalid back reference"
msgstr "မတည်ရှိသောနောက်ပြန်ကိုးကားခြင်း"

#: lib/regcomp.c:152
msgid "Unmatched [ or [^"
msgstr "မကိုက်ညီခဲ့ပါ [ သို့မဟုတ် [^"

#: lib/regcomp.c:155
msgid "Unmatched ( or \\("
msgstr "မကိုက်ညီခဲ့ပါ ( သို့မဟုတ် \\("

#: lib/regcomp.c:158
msgid "Unmatched \\{"
msgstr "မကိုက်ညီခဲ့ပါ \\{"

#: lib/regcomp.c:161
msgid "Invalid content of \\{\\}"
msgstr "မတည်ရှိသော မာတိကာ၏ \\{\\}"

#: lib/regcomp.c:164
msgid "Invalid range end"
msgstr "မတည်ရှိသောအကွာဝေးအဆုံး"

#: lib/regcomp.c:167
msgid "Memory exhausted"
msgstr "အားနည်းနေသောမှတ်ဥာဏ်"

#: lib/regcomp.c:170
msgid "Invalid preceding regular expression"
msgstr "မတည်ရှိသောရှေ့ရောက်နေသည့်ပုံမှန်ဖော်ပြချက်"

#: lib/regcomp.c:173
msgid "Premature end of regular expression"
msgstr ""

#: lib/regcomp.c:176
msgid "Regular expression too big"
msgstr "ကြီးမားသောပုံမှန်ဖော်ပြချက်"

#: lib/regcomp.c:179
msgid "Unmatched ) or \\)"
msgstr "မကိုက်ညီခဲ့ပါ ) သို့မဟုတ် \\)"

#: lib/regcomp.c:707
msgid "No previous regular expression"
msgstr ""

#: lib/xalloc-die.c:34
msgid "memory exhausted"
msgstr "အားနည်းနေသောမှတ်ဥာဏ်"
