#: src/background.c:260
#, c-format
msgid "Allow %s to run in the background?"
msgstr "%sကို နောက်ကွယ်တွင် မောင်းနှင်ခွင့်ပြုမည်လား။"

#: src/background.c:264
#, c-format
msgid "%s requests to be started automatically and run in the background."
msgstr ""
"%sသည် အလိုအလျောက်စတင်မှုနှင့်နောက်ကွယ်တွင်မောင်းနှင်မှုတို့အတွက် "
"ခွင့်ပြုချက်တောင်းခံလာသည်။"

#: src/background.c:266
#, c-format
msgid "%s requests to run in the background."
msgstr "%sသည် နောက်ကွယ်တွင်မောင်းနှင်ခွင့်တောင်းခံလာသည်။"

#: src/background.c:267
msgid ""
"The ‘run in background’ permission can be changed at any time from the "
"application settings."
msgstr ""
"ခွင့်ပြုချက် 'နောက်ကွယ်တွင်မောင်းနှင်မည်' ကို "
"အပ္ပလီကေးရှင်းသတ်မှတ်ချက်များတွင် အချိန်မရွေးပြောင်းလဲနိုင်သည်။"

#: src/background.c:272
msgid "Don't allow"
msgstr "ခွင့်မပြုပါနှင့်"

#: src/background.c:273 src/wallpaper.c:165
msgid "Allow"
msgstr "ခွင့်ပြုမည်"

#: src/device.c:115
msgid "Turn On Microphone?"
msgstr "မိုက်ခရိုဖုန်းဖွင့်မှာလား။"

#: src/device.c:116
msgid ""
"Access to your microphone can be changed at any time from the privacy "
"settings."
msgstr ""
"သင်၏မိုက်ခရိုဖုန်းရယူအသုံးပြုခွင့်ကို အတွင်းရေးရာသတ်မှတ်ချက်များတွင် "
"အချိန်မရွေးပြောင်းလဲနိုင်သည်။"

#: src/device.c:120
msgid "An application wants to use your microphone."
msgstr "အပ္ပလီကေးရှင်းသည် သင်၏မိုက်ခရိုဖုန်းကို အသုံးပြုချင်နေပါသည်။"

#: src/device.c:122
#, c-format
msgid "%s wants to use your microphone."
msgstr "%sသည် သင်၏မိုက်ခရိုဖုန်းကို အသုံးပြုချင်နေပါသည်။"

#: src/device.c:128
msgid "Turn On Speakers?"
msgstr "စပီကာဖွင့်မည်လား။"

#: src/device.c:129
msgid ""
"Access to your speakers can be changed at any time from the privacy settings."
msgstr ""
"စပီကာအသုံးပြုခွင့်ကို အတွင်းရေးရာသတ်မှတ်ချက်များတွင် "
"အချိန်မရွေးပြောင်းလဲနိုင်သည်။"

#: src/device.c:133
msgid "An application wants to play sound."
msgstr "အပ္ပလီကေးရှင်းသည် အသံဖွင့်ပြချင်နေသည်။"

#: src/device.c:135
#, c-format
msgid "%s wants to play sound."
msgstr "%sသည် အသံဖွင့်ပြချင်နေသည်။"

#: src/device.c:141
msgid "Turn On Camera?"
msgstr "ကင်မရာဖွင့်မည်လား။"

#: src/device.c:142
msgid ""
"Access to your camera can be changed at any time from the privacy settings."
msgstr ""
"အတွင်းရေးရာသတ်မှတ်ချက်များတွင် ကင်မရာအသုံးပြုခွင့်ကို "
"အချိန်မရွေးပြောင်းလဲနိုင်သည်။"

#: src/device.c:146
msgid "An application wants to use your camera."
msgstr "အပ္ပလီကေးရှင်းသည် သင်၏ကင်မရာကိုအသုံးပြုချင်နေသည်။"

#: src/device.c:148
#, c-format
msgid "%s wants to use your camera."
msgstr "%sသည် သင်၏ကင်မရာကို အသုံးပြုချင်နေသည်။"

#: src/location.c:526
msgid "Deny Access"
msgstr "အသုံးပြုခွင့် ပယ်ချမည်"

#: src/location.c:528
msgid "Grant Access"
msgstr "အသုံးပြုခွင့် ပေးမည်"

#: src/location.c:534
msgid "Grant Access to Your Location?"
msgstr "သင်၏တည်နေရာအချက်အလက်ကိုရယူသုံးစွဲခွင့်ပေးမည်လား။"

#: src/location.c:535
msgid "An application wants to use your location."
msgstr "အပ္ပလီကေးရှင်းသည် သင်၏တည်နေရာအချက်အလက်ကို ရယူအသုံးပြုချင်နေသည်။"

#: src/location.c:547
#, c-format
msgid "Give %s Access to Your Location?"
msgstr "%sကို သင်၏တည်နေရာအချက်အလက်ရယူသုံးစွဲခွင့်ပေးမည်လား။"

#: src/location.c:551
#, c-format
msgid "%s wants to use your location."
msgstr "%sသည် သင်၏တည်နေရာအချက်အလက်ကို ရယူသုံးစွဲချင်နေသည်။"

#: src/location.c:554
msgid "Location access can be changed at any time from the privacy settings."
msgstr ""
"တည်နေရာအချက်အလက်ရယူသုံးစွဲခွင့်ကို အတွင်းရေးရာသတ်မှတ်ချက်များတွင် "
"ပြောင်းလဲနိုင်သည်။"

#: src/settings.c:124
msgid "Requested setting not found"
msgstr "တောင်းဆိုထားသော သတ်မှတ်ချက် ရှာမတွေ့ပါ"

#: src/wallpaper.c:163
msgid "Deny"
msgstr "ငြင်းပယ်မည်"

#: src/wallpaper.c:171
msgid "Allow Applications to Set Backgrounds?"
msgstr "နောက်ခံပုံသတ်မှတ်ခွင့်ပြုမည်လား။"

#: src/wallpaper.c:172
msgid ""
"An application is requesting to be able to change the background image."
msgstr "အပ္ပလီကေးရှင်းသည် နောက်ခံပုံပြောင်းလဲပိုင်ခွင့်တောင်းခံနေသည်။"

#: src/wallpaper.c:184
#, c-format
msgid "Allow %s to Set Backgrounds?"
msgstr "%sကို နောက်ခံပုံပြောင်းခွင့်ပြုမည်လား။"

#: src/wallpaper.c:185
#, c-format
msgid "%s is requesting to be able to change the background image."
msgstr "%sသည် နောက်ခံပုံပြောင်းလဲပိုင်ခွင့်တောင်းခံနေသည်။"

#: src/wallpaper.c:188
msgid "This permission can be changed at any time from the privacy settings."
msgstr ""
"ဤခွင့်ပြုချက်ကို အတွင်းရေးရာသတ်မှတ်ချက်များတွင် အချိန်မရွေးပြောင်းလဲနိုင်သည်။"
