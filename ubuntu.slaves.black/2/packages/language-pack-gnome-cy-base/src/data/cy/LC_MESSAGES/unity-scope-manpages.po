#: ../src/unity_manpages_daemon.py:35
msgid "Search Manpages"
msgstr "Chwilio llawlyfrau"

#: ../src/unity_manpages_daemon.py:36
msgid "Sorry, there are no Manpages that match your search."
msgstr ""
"Mae'n ddrwg gennym, nid oes unrhyw lawlyfrau sy'n cyfateb i'ch chwiliad."

#: ../src/unity_manpages_daemon.py:45
msgid "Technical Documents"
msgstr "Dogfennau Technegol"

#: ../src/unity_manpages_daemon.py:101
msgid "Open"
msgstr "Agor"

#: ../data/manpages.scope.in.h:1
msgid "manpages;man;"
msgstr "llawlyfrau;llawlyfr"

#: ../data/manpages.scope.in.h:2
msgid "Manpages"
msgstr "Llawlyfrau"

#: ../data/manpages.scope.in.h:3
msgid ""
"This is an Ubuntu search plugin that enables information from local manpages "
"to be searched and displayed in the Dash underneath the Code header. If you "
"do not wish to search this content source, you can disable this search "
"plugin."
msgstr ""
"Ategyn chwilio Ubuntu yw hwn sy'n galluogi i wybodaeth o lawlyfrau lleol "
"gael eu chwilio a'u harddangos yn y Dash o dan y pennawd Côd. Os nad ydych "
"am chwilio'r ffynhonnell gynnwys hon, gallwch analluogi'r ategyn chwilio hwn."

#: ../data/manpages.scope.in.h:4
msgid "Search for Manpages"
msgstr "Chwilio am Lawlyfrau"
