msgid "%zd current update"
msgid_plural "%zd current updates"
msgstr[0] "%zd diweddariad cyfredol"
msgstr[1] "%zd diweddariad cyfredol"
msgstr[2] "%zd diweddariad cyfredol"
msgstr[3] "%zd diweddariad cyfredol"

#: ../src/livepatch-tray.c:168
