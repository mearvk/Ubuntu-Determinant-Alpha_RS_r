msgid_plural "There are %i updates available"
msgstr[0] "Mae %i diweddariad ar gael."
msgstr[1] "Mae %i diweddariad ar gael."
msgstr[2] "Mae %i diweddariad ar gael."
msgstr[3] "Mae %i diweddariad ar gael."

#: ../src/update.c:147
