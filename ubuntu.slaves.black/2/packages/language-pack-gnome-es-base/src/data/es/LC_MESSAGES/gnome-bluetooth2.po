#, c-format
#| msgid ""
#| "Confirm the Bluetooth PIN for '%s'. This can usually be found in the "
#| "device's manual."
msgid ""
"Confirm the Bluetooth PIN for “%s”. This can usually be found in the "
"device’s manual."
msgstr ""
"Confirme el PIN Bluetooth para «%s». Normalmente se puede encontrar en el "
"manual del dispositivo."

