msgstr "Εμφάνιση βοήθειας"

#: gio/gapplication-tool.c:49 gio/gresource-tool.c:497 gio/gresource-tool.c:565
msgid "[COMMAND]"
msgstr "[ΕΝΤΟΛΗ]"

