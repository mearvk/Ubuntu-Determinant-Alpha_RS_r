#. Appears at the top of the dialog, as the heading of the dialog
#: games/scores/dialog.vala:58
msgid "Congratulations!"
msgstr "Συγχαρητήρια!"

#: games/scores/dialog.vala:60
msgid "High Scores"
msgstr "Υψηλές βαθμολογίες"

#: games/scores/dialog.vala:62
msgid "Best Times"
msgstr "Καλύτεροι χρόνοι"

#: games/scores/dialog.vala:81
msgid "No scores yet"
msgstr "Καμία βαθμολογία ακόμα"

#: games/scores/dialog.vala:85
msgid "Play some games and your scores will show up here."
msgstr "Παίξτε μερικά παιχνίδια και οι βαθμολογίες σας θα εμφανιστούν εδώ."

#. A column heading in the scores dialog
#: games/scores/dialog.vala:144
msgid "Rank"
msgstr "Κατάταξη"

#. A column heading in the scores dialog
#: games/scores/dialog.vala:153
msgid "Score"
msgstr "Βαθμολογία"

#: games/scores/dialog.vala:155
msgid "Time"
msgstr "Χρόνος"

#. A column heading in the scores dialog
#: games/scores/dialog.vala:162
msgid "Player"
msgstr "Παίχτης"

#. Appears on the top right corner of the dialog. Clicking the button closes the dialog.
#: games/scores/dialog.vala:172
msgid "_Done"
msgstr "Έ_τοιμο"

#. Time which may be displayed on a scores dialog.
#: games/scores/dialog.vala:288
#, c-format
#| msgid "%d minute"
#| msgid_plural "%d minutes"
msgid "%ld minute"
msgid_plural "%ld minutes"
msgstr[0] "%ld λεπτό"
msgstr[1] "%ld λεπτά"

#. Time which may be displayed on a scores dialog.
#: games/scores/dialog.vala:290
#, c-format
#| msgid "%d second"
#| msgid_plural "%d seconds"
msgid "%ld second"
msgid_plural "%ld seconds"
msgstr[0] "%ld δευτερόλεπτο"
msgstr[1] "%ld δευτερόλεπτα"

#: games/scores/dialog.vala:296
msgid "Your score is the best!"
msgstr "Η βαθμολογία σας είναι η καλύτερη!"

#: games/scores/dialog.vala:298
msgid "Your score has made the top ten."
msgstr "Η βαθμολογία σας είναι στην κορυφαία δεκάδα."
