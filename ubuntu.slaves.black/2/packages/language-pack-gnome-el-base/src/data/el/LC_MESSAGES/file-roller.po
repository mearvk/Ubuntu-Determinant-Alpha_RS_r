msgstr ""
"Προσθήκη αρχείων με ερώτηση για το φάκελο προορισμού και έξοδος από το "
"πρόγραμμα"

#: src/fr-application.c:75
msgid ""
"Extract the contents of the archives in the archive folder and quit the "
"program"
