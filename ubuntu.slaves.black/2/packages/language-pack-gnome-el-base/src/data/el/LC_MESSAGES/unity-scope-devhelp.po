#: ../src/unity_devhelp_daemon.py:34 ../data/devhelp.scope.in.h:4
msgid "Search Devhelp"
msgstr "Αναζήτηση Devhelp"

#: ../src/unity_devhelp_daemon.py:35
msgid "Sorry, there are no Devhelp results that match your search."
msgstr ""
"Συγνώμη δεν υπάρχουν αποτελέσματα Devhelp που να ταιριάζουν με την αναζήτησή "
"σας."

#: ../src/unity_devhelp_daemon.py:45
msgid "Technical Documents"
msgstr "Τεχνικά έγγραφα"

#: ../src/unity_devhelp_daemon.py:170
msgid "Show"
msgstr "Εμφάνιση"

#: ../data/devhelp.scope.in.h:1
msgid "devhelp;dev;help;doc;"
msgstr "devhelp;dev;help;doc;βοήθεια;τεκμηρίωση;προγραμματισμός"

#: ../data/devhelp.scope.in.h:2
msgid "Devhelp"
msgstr "Devhelp"

#: ../data/devhelp.scope.in.h:3
msgid ""
"This is an Ubuntu search plugin that enables information from Devhelp to be "
"searched and displayed in the Dash underneath the Code header. If you do not "
"wish to search this content source, you can disable this search plugin."
msgstr ""
"Αυτό είναι ένα πρόσθετο αναζήτησης του Ubuntu που επιτρέπει στις πληροφορίες "
"από το Devhelp να αναζητούνται και να εμφανίζονται στο Dash κάτω από την "
"επικεφαλίδα Κώδικας. Αν δεν επιθυμείτε να αναζητήσετε αυτή την πηγή "
"περιεχομένου, μπορείτε να απενεργοποιήσετε αυτό το πρόσθετο αναζήτησης."
