msgstr "Έλεγχος για ενημερώσεις…"

#: ../UpdateManager/backend/InstallBackendAptdaemon.py:216
#: ../UpdateManager/backend/InstallBackendAptdaemon.py:290
#: ../UpdateManager/backend/InstallBackendAptdaemon.py:340
msgid "Installing updates…"
msgstr "Εγκατάσταση ενημερώσεων…"

#: ../UpdateManager/backend/InstallBackendSynaptic.py:43
msgid "Please wait, this can take some time."
msgstr "Παρακαλώ περιμένετε, αυτό μπορεί να διαρκέσει λίγο χρόνο."

#: ../UpdateManager/backend/InstallBackendSynaptic.py:45
msgid "Update is complete"
msgstr "Η ενημέρωση ολοκληρώθηκε"

#: ../UpdateManager/backend/__init__.py:300
