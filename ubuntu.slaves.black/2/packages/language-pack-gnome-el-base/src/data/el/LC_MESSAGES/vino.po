msgstr "Καθορισμός αρχείου που περιλαμβάνει τις αποθηκευμένες ρυθμίσεις"

#: ../server/smclient/eggsmclient.c:229
msgid "FILE"
msgstr "ΑΡΧΕΙΟ"

#: ../server/smclient/eggsmclient.c:232
