#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "Konverter nøkkel til små bokstaver"

#: src/makedb.c:69
msgid "NAME"
msgstr "NAVN"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "Skriv utdata til filen NAVN"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "Ikke skriv ut meldinger når databasen bygges"

#: src/makedb.c:73
msgid "Print content of database file, one entry a line"
msgstr "Skriv ut innholdet i databasefilen, en rad per linje"

#. Short description of program.
#: src/makedb.c:78
msgid "Create simple DB database from textual input."
msgstr "Lag en enkel database fra tekstdata."

#. Strings for arguments in help texts.
#: src/makedb.c:81
msgid ""
"INPUT-FILE OUTPUT-FILE\n"
"-o OUTPUT-FILE INPUT-FILE\n"
"-u INPUT-FILE"
msgstr ""
"INNFIL UTFIL\n"
"-o UTFIL INNFIL\n"
"-u INNFIl"

#: src/makedb.c:132
msgid "wrong number of arguments"
msgstr "feil antall argumenter"

#: src/makedb.c:154
#, c-format
msgid "cannot open database file `%s': %s"
msgstr "kan ikke åpne databasefilen '%s': %s"

#: src/makedb.c:173
#, c-format
msgid "cannot open input file `%s'"
msgstr "kan ikke åpne filen `%s'"

#: src/makedb.c:187
#, c-format
msgid "cannot open output file `%s': %s"
msgstr "kan ikke åpne inndatafilen `%s': %s"

