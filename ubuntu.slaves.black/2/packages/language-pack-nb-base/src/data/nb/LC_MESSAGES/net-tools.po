#: ../arp.c:626
#, c-format
msgid ""
"Usage:\n"
"  arp [-vn]  [<HW>] [-i <if>] [-a] [<hostname>]             <-Display ARP "
"cache\n"
msgstr ""
"Bruk:\n"
"  arp [-vn]  [<HW>] [-i <grensesnitt>] [-a] [<vertsnavn>]             <-Vis "
"ARP-hurtiglager\n"

#: ../arp.c:627
#, c-format
msgid ""
"  arp [-v]          [-i <if>] -d  <host> [pub]               <-Delete ARP "
"entry\n"
msgstr ""
"  arp [-v]          [-i <if>] -d  <vert> [pub]               <-Slett ARP-"
"oppføring\n"

#: ../arp.c:628
#, c-format
msgid ""
"  arp [-vnD] [<HW>] [-i <if>] -f  [<filename>]            <-Add entry from "
"file\n"
msgstr ""
"  arp [-vnD] [<HW>] [-i <if>] -f  [<filnavn>]            <-Legg til "
"oppføring fra fil\n"

#: ../arp.c:629
#, c-format
msgid ""
"  arp [-v]   [<HW>] [-i <if>] -s  <host> <hwaddr> [temp]            <-Add "
"entry\n"
msgstr ""
"  arp [-v]   [<HW>] [-i <if>] -s  <vert> <maskinvareadr.> [midl.]            "
"<-Legg til oppføring\n"

#: ../arp.c:630
#, c-format
msgid ""
"  arp [-v]   [<HW>] [-i <if>] -Ds <host> <if> [netmask <nm>] pub          <-"
"''-\n"
"\n"
msgstr ""
"  arp [-v]   [<HW>] [-i <if>] -Ds <vert> <grensesn> [nettmaske <nm>] pub     "
"     <-''-\n"
"\n"

#: ../arp.c:632
#, c-format
msgid ""
"        -a                       display (all) hosts in alternative (BSD) "
"style\n"
msgstr ""
"        -a                       vis alle verter i alternativ (BSD-) stil\n"

#: ../arp.c:633
#, c-format
msgid "        -s, --set                set a new ARP entry\n"
msgstr "        -s, --set                lag ny ARP-oppføring\n"

#: ../arp.c:634
#, c-format
msgid "        -d, --delete             delete a specified entry\n"
msgstr "        -d, --delete             slett valgt oppføring\n"

