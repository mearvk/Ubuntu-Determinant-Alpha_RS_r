#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Dette programmet må startes av root-brukeren\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Opprett og formater en kryptert LUKS-enhet\n"
"Bruk: luksformat [-t <filsystem>] <enhet> [ mkfs <alternativer> ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Feil: enheten er montert: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Feil: ugyldig filsystem: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Feil: klarte ikke å opprette en midlertidig navnkobling til enheten"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Oppretter kryptert enhet på %s …\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Klarte ikke å opprette LUKS-enhet %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Skriv inn passordet ditt igjen for å bekrefte det\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Passordene du skrev inn var ikke identiske\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Klarte ikke å formatere enheten med filsystemet %s"
