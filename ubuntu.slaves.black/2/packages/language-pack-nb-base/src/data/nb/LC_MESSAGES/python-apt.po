#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Tjener for %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Hovedtjener"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Selvvalgte tjenere"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr ""

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Ugyldig unicode i beskrivelse for «%s» (%s). Du bør rapportere dette."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Lista over endringer er ikke tilgjengelig."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Lista over endringer er ikke tilgjengelig ennå.\n"
"\n"
"Se http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"eller prøv igjen senere."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Klarte ikke å laste ned liste over endringer. \n"
"Kontroller at du er koblet til Internett."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Klarte ikke å lese filliste for «%s»"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Klarte ikke å lese liste over kontrollfiler for «%s»"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Avhengigheter er ikke tilfredsstilt: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Kommer i konflikt med den installerte pakka «%s»"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Bryter eksisterende pakke «%(pkgname)s» sin avhengighet av %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Stopper eksisterende pakke «%(pkgname)s» sin konflikt med: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Stopper pakke «%(pkgname)s» som er i konflikt med «%(targetpkg)s». Men "
"«%(debfile)s» tilbyr den via: «%(provides)s»"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Pakka mangler arkitekturfelt"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Arkitektur «%s» er feil. Kjør «dpkg --add-architecture» for å legge den til "
"og oppdatere"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Du har allerede installert en nyere versjon"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Klarte ikke å innfri alle avhengigheter (ødelagt hurtiglager)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Klarte ikke å installere «%s»"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Pakket ut automatisk:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Konvertert til utskrivbar ASCII automatisk:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Installer byggeavhengigheter for kildekodepakke «%s» som bygger «%s»\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "En essensiell pakke ville blitt fjernet"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s … Ferdig"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Treff "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Feil "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Hent:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Arbeider]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Mediebytte: sett inn mediet som er merket\n"
"  «%s»\n"
"i «%s» og trykk «Enter»\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Hentet %sB på %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
