#: Module.cpp:77
msgctxt "@title/rich"
msgid "<title>Your computer requires no proprietary drivers</title>"
msgstr "<title>Datamaskinen din krever ingen produsenteide drivere</title>"

#: Module.cpp:130
msgctxt ""
"The backend is trying to figure out what drivers are suitable for the users "
"system"
msgid "Collecting information about your system"
msgstr "Samler inn informasjon om systemet"

#: Module.cpp:220 DriverManager.cpp:248
msgctxt "@label"
msgid ""
"The package system could not be initialized, your configuration may be "
"broken."
msgstr "Klaret ikke å starte pakkesystemet. Oppsettet ditt kan være ugyldig."

#: Module.cpp:232
msgctxt "The backend replied with a error"
msgid ""
"Something went terribly wrong. Please hit the 'Refresh Driver List' button"
msgstr "Noe gikk fullstendig galt. Trykk på knappen «Oppdater driverliste»"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr " ,Launchpad Contributions:,Åka Sikrom"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ",,"

