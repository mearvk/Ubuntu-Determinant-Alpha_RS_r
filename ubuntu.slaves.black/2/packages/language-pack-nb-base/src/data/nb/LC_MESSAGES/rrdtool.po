#: src/rrd_tool.c:203
msgid ""
" * tune -  Modify some basic properties of an RRD\n"
"\n"
"\trrdtool tune filename\n"
"\t\t[--heartbeat|-h ds-name:heartbeat]\n"
"\t\t[--data-source-type|-d ds-name:DST]\n"
"\t\t[--data-source-rename|-r old-name:new-name]\n"
"\t\t[--minimum|-i ds-name:min] [--maximum|-a ds-name:max]\n"
"\t\t[--deltapos|-p scale-value] [--deltaneg|-n scale-value]\n"
"\t\t[--failure-threshold|-f integer]\n"
"\t\t[--window-length|-w integer]\n"
"\t\t[--alpha|-x adaptation-parameter]\n"
msgstr ""
" * tune -  Endre grunnleggende egenskaper for en RRD\n"
"\n"
"\trrdtool tune filnavn\n"
"\t\t[--heartbeat|-h ds-navn:hjerterytme]\n"
"\t\t[--data-source-type|-d ds-navn:DST]\n"
"\t\t[--data-source-rename|-r gammelt-navn:nytt-navn]\n"
"\t\t[--minimum|-i ds-navn:min] [--maximum|-a ds-navn:maks]\n"
"\t\t[--deltapos|-p skaleringsverdi] [--deltaneg|-n skaleringsverdi]\n"
"\t\t[--failure-threshold|-f heltall]\n"
"\t\t[--window-length|-w heltall]\n"
"\t\t[--alpha|-x opptaksparameter]\n"

#: src/rrd_tool.c:214
msgid ""
"\t\t[--beta|-y adaptation-parameter]\n"
"\t\t[--gamma|-z adaptation-parameter]\n"
"\t\t[--gamma-deviation|-v adaptation-parameter]\n"
"\t\t[--smoothing-window|-s fraction-of-season]\n"
"\t\t[--smoothing-window-deviation|-S fraction-of-season]\n"
"\t\t[--aberrant-reset|-b ds-name]\n"
msgstr ""
"\t\t[--beta|-y opptaksparameter]\n"
"\t\t[--gamma|-z opptaksparameter]\n"
"\t\t[--gamma-deviation|-v opptaksparameter]\n"
"\t\t[--smoothing-window|-s del-av-sesong]\n"
"\t\t[--smoothing-window-deviation|-S del-av-sesong]\n"
"\t\t[--aberrant-reset|-b ds-navn]\n"

#: src/rrd_tool.c:221
msgid ""
"\t\t[--step|-t newstep]\n"
"\t\t[--daemon|-D address]\n"
"\t\t[DEL:ds-name]\n"
"\t\t[DS:ds-spec]\n"
"\t\t[DELRRA:index]\n"
"\t\t[RRA:rra-spec]\n"
"\t\t[RRA#index:[+-=]number]\n"
msgstr ""
"\t\t[--step|-t nyttsteg]\n"
"\t\t[--daemon|-D adresse]\n"
"\t\t[DEL:ds-navn]\n"
"\t\t[DS:ds-spes]\n"
"\t\t[DELRRA:indeks]\n"
"\t\t[RRA:rra-spes]\n"
"\t\t[RRA#indeks:[+-=]nummer]\n"

#: src/rrd_tool.c:230
msgid ""
" * resize - alter the length of one of the RRAs in an RRD\n"
"\n"
"\trrdtool resize filename rranum GROW|SHRINK rows\n"
msgstr ""
" * resize - endre lengde på RRA i en RRD\n"
"\n"
"\trrdtool resize filnavn rranum GROW|SHRINK rader\n"

#: src/rrd_tool.c:233
msgid ""
"* xport - generate XML dump from one or several RRD\n"
"\n"
"\trrdtool xport [-s|--start seconds] [-e|--end seconds]\n"
"\t\t[-m|--maxrows rows]\n"
"\t\t[--step seconds]\n"
"\t\t[--enumds] [--json]\n"
"\t\t[-d|--daemon address]\n"
"\t\t[DEF:vname=rrd:ds-name:CF]\n"
"\t\t[CDEF:vname=rpn-expression]\n"
"\t\t[XPORT:vname:legend]\n"
msgstr ""
"* xport - lag XML-utskrift av én eller flere RRD-er\n"
"\n"
"\trrdtool xport [-s|--start sekunder] [-e|--end sekunder]\n"
"\t\t[-m|--maxrows rader]\n"
"\t\t[--step sekunder]\n"
"\t\t[--enumds] [--json]\n"
"\t\t[-d|--daemon adresse]\n"
"\t\t[DEF:vnavn=rrd:ds-navn:CF]\n"
"\t\t[CDEF:vnavn=rpn-uttrykk]\n"
"\t\t[XPORT:vnavn:forklaring]\n"

#: src/rrd_tool.c:242
msgid ""
" * quit - closing a session in remote mode\n"
"\n"
"\trrdtool quit\n"
msgstr ""
" * quit - lukk økt i fjernstyringsmodus\n"
"\n"
"\trrdtool quit\n"

#: src/rrd_tool.c:245
msgid ""
" * ls - lists all *.rrd files in current directory\n"
"\n"
"\trrdtool ls\n"
msgstr ""
" * ls - vis alle *.rrd-filer i gjeldende mappe\n"
"\n"
"\trrdtool ls\n"

#: src/rrd_tool.c:248
msgid ""
" * cd - changes the current directory\n"
"\n"
"\trrdtool cd new directory\n"
msgstr ""
" * cd - bytt arbeidsmappe\n"
"\n"
"\trrdtool cd ny-mappe\n"

#: src/rrd_tool.c:251
msgid ""
" * mkdir - creates a new directory\n"
"\n"
"\trrdtool mkdir newdirectoryname\n"
msgstr ""
" * mkdir - lag ny mappe\n"
"\n"
"\trrdtool mkdir nytt-mappenavn\n"

#: src/rrd_tool.c:254
msgid ""
" * pwd - returns the current working directory\n"
"\n"
"\trrdtool pwd\n"
msgstr ""
" * pwd - vis gjeldende arbeidsmappe\n"
"\n"
"\trrdtool pwd\n"

