"\t\t[SHIFT:vnavn:posisjon]\n"
"\t\t[TEXTALIGN:{left|right|justified|center}]\n"
"\t\t[TICK:vnavn#rrggbb[aa][:[fraksjon][:forklaring]]]\n"
"\t\t[HRULE:verdi#rrggbb[aa][:forklaring]]\n"
