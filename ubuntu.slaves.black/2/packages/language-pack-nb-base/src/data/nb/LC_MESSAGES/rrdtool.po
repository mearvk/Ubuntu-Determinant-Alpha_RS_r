#: src/rrd_tool.c:49
#, c-format
msgid ""
"RRDtool %s  Copyright by Tobias Oetiker <tobi@oetiker.ch>\n"
"               Compiled %s %s\n"
"\n"
"Usage: rrdtool [options] command command_options\n"
msgstr ""
"RRDtool %s  Opphavsrett tilhører Tobias Oetiker <tobi@oetiker.ch>\n"
"               Kompilert %s %s\n"
"\n"
"Bruk: rrdtool [valg] kommando valg\n"

#: src/rrd_tool.c:56
msgid ""
"Valid commands: create, update, updatev, graph, graphv,  dump, restore,\n"
"\t\tlast, lastupdate, first, info, list, fetch, tune,\n"
"\t\tresize, xport, flushcached\n"
msgstr ""

#: src/rrd_tool.c:61
msgid "Valid remote commands: quit, ls, cd, mkdir, pwd\n"
msgstr "Gyldige fjernstyringskommandoer: quit, ls, cd, mkdir, pwd\n"

#: src/rrd_tool.c:65
msgid ""
"* create - create a new RRD\n"
"\n"
"\trrdtool create filename [--start|-b start time]\n"
"\t\t[--step|-s step]\n"
"\t\t[--template|-t template-file]\n"
"\t\t[--source|-r source-file]\n"
"\t\t[--no-overwrite|-O]\n"
"\t\t[--daemon|-d address]\n"
"\t\t[DS:ds-name:DST:dst arguments]\n"
"\t\t[RRA:CF:cf arguments]\n"
msgstr ""
"* create - lag ny RRD\n"
"\n"
"\trrdtool create filnavn [--start|-b starttid]\n"
"\t\t[--step|-s steg]\n"
"\t\t[--template|-t malfil]\n"
"\t\t[--source|-r kildefil]\n"
"\t\t[--no-overwrite|-O]\n"
"\t\t[--daemon|-d adresse]\n"
"\t\t[DS:ds-name:DST:dst argumenter]\n"
"\t\t[RRA:CF:cf argumenter]\n"

#: src/rrd_tool.c:76
msgid ""
"* dump - dump an RRD to XML\n"
"\n"
"\trrdtool dump [--header|-h {none,xsd,dtd}]\n"
"\t\t[--no-header|-n]\n"
"\t\t[--daemon|-d address]\n"
"\t\tfile.rrd [file.xml]"
msgstr ""
"* dump - skriv ut RRD til XML\n"
"\n"
"\trrdtool dump [--header|-h {none,xsd,dtd}]\n"
"\t\t[--no-header|-n]\n"
"\t\t[--daemon|-d adresse]\n"
"\t\tfil.rrd [fil.xml]"

#: src/rrd_tool.c:83
msgid ""
"* info - returns the configuration and status of the RRD\n"
"\n"
"\trrdtool info [--daemon|-d <addr> [--noflush|-F]] filename.rrd\n"
msgstr ""
"* info - viser oppsett og status for RRD\n"
"\n"
"\trrdtool info [--daemon|-d <addr> [--noflush|-F]] filnavn.rrd\n"

#: src/rrd_tool.c:87
msgid ""
"* list - returns the list of RRDs\n"
"\n"
"\trrdtool list [--daemon <address>] [--noflush] <dirname>\n"
msgstr ""

#: src/rrd_tool.c:91
msgid ""
"* restore - restore an RRD file from its XML form\n"
"\n"
"\trrdtool restore [--range-check|-r] [--force-overwrite|-f] filename.xml "
"filename.rrd\n"
msgstr ""
"* restore - gjenopprett RRD-fil fra XML-format\n"
"\n"
"\trrdtool restore [--range-check|-r] [--force-overwrite|-f] filnavn.xml "
"filnavn.rrd\n"

#: src/rrd_tool.c:95
msgid ""
"* last - show last update time for RRD\n"
"\n"
"\trrdtool last filename.rrd\n"
"\t\t[--daemon|-d address]\n"
msgstr ""
"* last - vis siste oppdateringstid for RRD\n"
"\n"
"\trrdtool last filnavn.rrd\n"
"\t\t[--daemon|-d adresse]\n"

#: src/rrd_tool.c:100
msgid ""
"* lastupdate - returns the most recent datum stored for\n"
"  each DS in an RRD\n"
"\n"
"\trrdtool lastupdate filename.rrd\n"
"\t\t[--daemon|-d address]\n"
msgstr ""
"* lastupdate - viser nyligste lagret dato per\n"
"  DS i en RRD\n"
"\n"
"\trrdtool lastupdate filnavn.rrd\n"
"\t\t[--daemon|-d adresse]\n"

#: src/rrd_tool.c:106
msgid ""
"* first - show first update time for RRA within an RRD\n"
"\n"
"\trrdtool first filename.rrd [--rraindex number] [--daemon|-d address]\n"
msgstr ""
"* first - vis første oppdateringstid for RRA i en RRD\n"
"\n"
"\trrdtool first filnavn.rrd [--rraindex nummer] [--daemon|-d adresse]\n"

#: src/rrd_tool.c:110
msgid ""
"* update - update an RRD\n"
"\n"
"\trrdtool update filename\n"
"\t\t[--template|-t ds-name:ds-name:...]\n"
"\t\t[--skip-past-updates|-s]\n"
"\t\t[--daemon|-d <address>]\n"
"\t\ttime|N:value[:value...]\n"
"\n"
"\t\tat-time@value[:value...]\n"
"\n"
"\t\t[ time:value[:value...] ..]\n"
msgstr ""
"* update - oppdater en RRD\n"
"\n"
"\trrdtool update filnavn\n"
"\t\t[--template|-t ds-navn:ds-navn: …]\n"
"\t\t[--skip-past-updates|-s]\n"
"\t\t[--daemon|-d <adresse>]\n"
"\t\ttid|N:verdi[:verdi …]\n"
"\n"
"\t\tved-tid@verdi[:verdi …]\n"
"\n"
"\t\t[ tid:verdi[:verdi …] …]\n"

#: src/rrd_tool.c:120
msgid ""
"* updatev - a verbose version of update\n"
"\treturns information about values, RRAs, and datasources updated\n"
"\n"
"\trrdtool updatev filename\n"
"\t\t[--template|-t ds-name:ds-name:...]\n"
"\t\t[--skip-past-updates|-s]\n"
"\t\ttime|N:value[:value...]\n"
"\n"
"\t\tat-time@value[:value...]\n"
"\n"
"\t\t[ time:value[:value...] ..]\n"
msgstr ""
"* updatev - detaljert versjon av «update»\n"
"\tviser info om verdier, RRA-er og oppdaterte datakilder\n"
"\n"
"\trrdtool updatev filnavn\n"
"\t\t[--template|-t ds-navn:ds-navn: …]\n"
"\t\t[--skip-past-updates|-s]\n"
"\t\ttid|N:verdi[:verdi …]\n"
"\n"
"\t\tved-tid@verdi[:verdi …]\n"
"\n"
"\t\t[ tid:verdi[:verdi …] …]\n"

#: src/rrd_tool.c:130
msgid ""
"* fetch - fetch data out of an RRD\n"
"\n"
"\trrdtool fetch filename.rrd CF\n"
"\t\t[-r|--resolution resolution]\n"
"\t\t[-s|--start start] [-e|--end end]\n"
"\t\t[-a|--align-start]\n"
"\t\t[-d|--daemon <address>]\n"
msgstr ""
"* fetch - hent data fra en RRD\n"
"\n"
"\trrdtool fetch filnavn.rrd CF\n"
"\t\t[-r|--resolution oppløsning]\n"
"\t\t[-s|--start start] [-e|--end slutt]\n"
"\t\t[-a|--align-start]\n"
"\t\t[-d|--daemon <adresse>]\n"

#: src/rrd_tool.c:138
msgid ""
"* flushcached - flush cached data out to an RRD file\n"
"\n"
"\trrdtool flushcached filename.rrd\n"
"\t\t[-d|--daemon <address>]\n"
msgstr ""
"* flushcached - tøm hurtiglagret data ut i en RRD-fil\n"
"\n"
"\trrdtool flushcached filnavn.rrd\n"
"\t\t[-d|--daemon <adresse>]\n"

#: src/rrd_tool.c:145
msgid ""
"* graph - generate a graph from one or several RRD\n"
"\n"
"\trrdtool graph filename [-s|--start seconds] [-e|--end seconds]\n"
msgstr ""
"* graph - lag graf av én eller flere RRD-er\n"
"\n"
"\trrdtool graph filnavn [-s|--start sekunder] [-e|--end sekunder]\n"

#: src/rrd_tool.c:148
msgid ""
"* graphv - generate a graph from one or several RRD\n"
"           with meta data printed before the graph\n"
"\n"
"\trrdtool graphv filename [-s|--start seconds] [-e|--end seconds]\n"
msgstr ""
"* graphv - lag graf av én eller flere RRD-er\n"
"           og skriv ut metadata først\n"
"\n"
"\trrdtool graphv filnavn [-s|--start sekunder] [-e|--end sekunder]\n"

#: src/rrd_tool.c:152
msgid ""
"\t\t[-x|--x-grid x-axis grid and label]\n"
"\t\t[-Y|--alt-y-grid] [--full-size-mode]\n"
"\t\t[--left-axis-format format]\n"
"\t\t[-y|--y-grid y-axis grid and label]\n"
"\t\t[-v|--vertical-label string] [-w|--width pixels]\n"
"\t\t[--right-axis scale:shift] [--right-axis-label label]\n"
"\t\t[--right-axis-format format]\n"
"\t\t[-h|--height pixels] [-o|--logarithmic]\n"
"\t\t[-u|--upper-limit value] [-z|--lazy]\n"
"\t\t[-l|--lower-limit value] [-r|--rigid]\n"
"\t\t[-g|--no-legend] [-d|--daemon <address>]\n"
"\t\t[-F|--force-rules-legend]\n"
"\t\t[-j|--only-graph]\n"
msgstr ""
"\t\t[-x|--x-grid nett og etikett for x-akse]\n"
"\t\t[-Y|--alt-y-grid] [--full-size-mode]\n"
"\t\t[--left-axis-format format]\n"
"\t\t[-y|--y-grid nett og etikett for y-akse]\n"
"\t\t[-v|--vertical-label streng] [-w|--width piksler]\n"
"\t\t[--right-axis skala:forskyvning] [--right-axis-label etikett]\n"
"\t\t[--right-axis-format format]\n"
"\t\t[-h|--height piksler] [-o|--logarithmic]\n"
"\t\t[-u|--upper-limit verdi] [-z|--lazy]\n"
"\t\t[-l|--lower-limit verdi] [-r|--rigid]\n"
"\t\t[-g|--no-legend] [-d|--daemon <adresse>]\n"
"\t\t[-F|--force-rules-legend]\n"
"\t\t[-j|--only-graph]\n"

