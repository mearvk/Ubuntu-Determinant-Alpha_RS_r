"\t\t[VRULE:value#rrggbb[aa][:legend]]\n"
"\t\t[LINE[width]:vname[#rrggbb[aa][:[legend][:STACK]]]]\n"
"\t\t[AREA:vname[#rrggbb[aa][:[legend][:STACK]]]]\n"
