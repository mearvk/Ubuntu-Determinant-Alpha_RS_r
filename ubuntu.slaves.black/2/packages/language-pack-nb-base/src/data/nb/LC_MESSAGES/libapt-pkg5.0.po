msgstr ""
"%s: Verdien %s er utenfor rekkevidde av gyldige pin-prioriteter (%d til %d)"

#: apt-pkg/policy.cc:426
msgid "No priority (or zero) specified for pin"
msgstr "Ingen prioritet (eller null) spesifisert for pin"

