#: bin/menu:34 byobu-config:129 byobu-config:401 byobu-config:409
msgid "Menu"
msgstr "Meny"

#: byobu-export:68 byobu-export:71 byobu-select-profile:104
#: byobu-select-profile:107
msgid "Choose"
msgstr "Velg"

#: byobu-export:171
msgid "File exists"
msgstr "Fila finnes"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "Vil du fjerne fila? [y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "Velg en farge: "

#: byobu-export:240
msgid "Profile"
msgstr "Profil"

#: byobu-export:241
msgid "Archive"
msgstr "Arkiv"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Pakk ut arkivet i hjemmemappa på målsystemet."

#: byobu-select-profile:49
msgid "Error:"
msgstr "Feil:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " filen finnes, men er ikke en symbolsk lenke"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "Velg en skjermprofil: "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "FEIL: ugyldig utvalg"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"Trykk\\n<F5> for å ta disse endringene i bruk hvis du bruker standard-"
"hurtigtaster.\\n\\nEllers kan du lukke denne skjerm-økta og starte en ny."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Kjør «byobu» for å slå på"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu starter ved innlogging (slå av)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu starter ikke ved innlogging (slå på)"

#: byobu-config:89
msgid "Help"
msgstr "Hjelp"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "Endre Byobus farger"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Slå på/av statusvarslinger"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Endre hurtigtast-oppsett"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Endre skiftesekvens"

#: byobu-config:94
msgid "Create new windows"
msgstr "Lag nye vinduer"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Håndter standardvinduer"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " Byobu-oppsettsmeny"

#: byobu-config:110
msgid "Okay"
msgstr "OK"

#: byobu-config:110 byobu-config:144 byobu-config:161 byobu-config:195
#: byobu-config:335 byobu-config:376 byobu-config:449
msgid "Cancel"
msgstr "Avbryt"

#: byobu-config:130
msgid "Byobu Help"
msgstr "Byobu-hjelp"

#: byobu-config:144 byobu-config:161 byobu-config:195 byobu-config:335
#: byobu-config:376 byobu-config:449
msgid "Apply"
msgstr "Bruk"

#: byobu-config:146
msgid "Which profile would you like to use?"
msgstr "Hvilken profil vil du bruke?"

#: byobu-config:162
msgid "Which set of keybindings would you like to use?"
msgstr "Hvilket hurtigtast-oppsett vil du bruke?"

#: byobu-config:175
msgid "Title: "
msgstr "Tittel: "

#: byobu-config:177
msgid "Command: "
msgstr "Kommando: "

#: byobu-config:179
msgid "Presets: "
msgstr "Forvalg: "

#: byobu-config:193
msgid "Add to default windows"
msgstr "Legg til standardvinduer"

#: byobu-config:197
msgid "Create new window(s):"
msgstr "Lag ny(e) vindu(er):"

#: byobu-config:336
msgid "Toggle status notifications:"
msgstr "Slå på/av statusvarslinger:"

#: byobu-config:368
msgid "Windows:"
msgstr "Vinduer:"

#: byobu-config:378
msgid "Select window(s) to create by default:"
msgstr "Velg vindu(er) som skal opprettes som standard:"

#: byobu-config:398
msgid "Byobu will be launched automatically next time you login."
msgstr "Byobu starter automatisk neste gang du logger inn."

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "Byobu blir ikke brukt neste gang du logger inn."

#: byobu-config:408
msgid "Message"
msgstr "Melding"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "Escape-knapp: ctrl-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "Endre skiftesekvens:"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr "<Tab>/<Alt-Tab> mellom elementer | <Enter> velger | <Esc> avslutter"
