msgstr "apt-promjeneliste: %(msg)s"

#: ../apt-listchanges/ALCLog.py:32
#, python-format
msgid "apt-listchanges warning: %(msg)s"
msgstr "apt-promjeneliste upozorenje: %(msg)s"

#: ../apt-listchanges/ALCSeenDb.py:54
msgid ""
"Path to the seen database is unknown.\n"
"Please either specify it with --save-seen option\n"
"or pass --profile=apt to have it read from the configuration file."
msgstr ""
"Put viđene datoteke je nepoznat.\n"
"Molim Vas ili specificirajte ga sa --save-viđeno opcijama\n"
"ili proslijedite --profile=apt da se čita iz konfiguracijskog fajla."

#: ../apt-listchanges/ALCSeenDb.py:65
#, python-format
msgid "Database %(db)s does not end with %(ext)s"
msgstr "Baza podataka %(db)s ne završava sa %(ext)s"

#: ../apt-listchanges/ALCSeenDb.py:74
#, python-format
msgid "Database %(db)s failed to load: %(errmsg)s"
msgstr "Baza podataka %(db)s se neuspješno učitala: %(errmsg)s"

