msgstr ""
"Obavezni i opcionalni argumenti za duge opcije su također\n"
"obavezni ili opcionalni za odgovarajuće kratke opcije-\n"

#: xargs/xargs.c:1716
msgid ""
"  -0, --null                   items are separated by a null, not "
"whitespace;\n"
"                                 disables quote and backslash processing "
"and\n"
"                                 logical EOF processing\n"
msgstr ""
"  -0, --null stavke su odvojene nulom, ne razmakom;\n"
"                                 onemogućava procesiranje navoda i kosih "
"crti i\n"
"                                 logičko EOF procesiranje\n"

#: xargs/xargs.c:1719
msgid ""
"  -a, --arg-file=FILE          read arguments from FILE, not standard input\n"
msgstr ""
"  -a, --arg-file=FILE čitaj argumente iz FILE, ne sa standardnog ulaza\n"

#: xargs/xargs.c:1720
msgid ""
"  -d, --delimiter=CHARACTER    items in input stream are separated by "
"CHARACTER,\n"
"                                 not by whitespace; disables quote and "
"backslash\n"
"                                 processing and logical EOF processing\n"
msgstr ""
"  -d, --delimiter=CHARACTER stvari u ulaznom toku su razdvojeni CHARACTER,\n"
"                                 ne sa bijelim prostorom, isključuje "
"navodničko i backslash\n"
"                                 procesiranje i logičko EOF procesiranje\n"

#: xargs/xargs.c:1723
msgid ""
"  -E END                       set logical EOF string; if END occurs as a "
"line\n"
"                                 of input, the rest of the input is ignored\n"
"                                 (ignored if -0 or -d was specified)\n"
msgstr ""
"  -E END postavi logicki EOF string, ako se END javlja kao linija\n"
"                                 inputa, ostatak inputa je ignorisan\n"
"                                 (ignorisano ako su specificirani -0 ili -"
"d)\n"

#: xargs/xargs.c:1726
msgid ""
"  -e, --eof[=END]              equivalent to -E END if END is specified;\n"
"                                 otherwise, there is no end-of-file string\n"
msgstr ""
"  -e, --eof[=END] ekvivalent  -E END ako END navedeno;\n"
"                                 inače, nema kraj-datoteke stringa\n"

#: xargs/xargs.c:1728
msgid "  -I R                         same as --replace=R\n"
msgstr "  -I R isto kao --replace=R\n"

#: xargs/xargs.c:1729
msgid ""
"  -i, --replace[=R]            replace R in INITIAL-ARGS with names read\n"
"                                 from standard input, split at newlines;\n"
"                                 if R is unspecified, assume {}\n"
msgstr ""

#: xargs/xargs.c:1732
msgid ""
"  -L, --max-lines=MAX-LINES    use at most MAX-LINES non-blank input lines "
"per\n"
"                                 command line\n"
msgstr ""
"  -L, --max-lines=MAX-LINES koristi pri najviše MAX-LINES ne praznih ulaznih "
"linija po\n"
"                                 komandnoj liniji\n"

#: xargs/xargs.c:1734
msgid ""
"  -l[MAX-LINES]                similar to -L but defaults to at most one non-"
"\n"
"                                 blank input line if MAX-LINES is not "
"specified\n"
msgstr ""
"  -l[MAX-LINES] slično -L ali podrazmijevana je pri najviše jednoj ne-\n"
"                                 praznoj ulaznoj liniji ako MAX-LINES nije "
"navedeno\n"

#: xargs/xargs.c:1736
msgid ""
"  -n, --max-args=MAX-ARGS      use at most MAX-ARGS arguments per command "
"line\n"
msgstr ""
"  -n, --max-args=MAX-ARGS koristiti pri najviše  MAX-ARGS argumenata po "
"komandnoj liniji\n"

#: xargs/xargs.c:1737
msgid ""
"  -o, --open-tty               Reopen stdin as /dev/tty in the child "
"process\n"
"                                 before executing the command; useful to run "
"an\n"
"                                 interactive application.\n"
msgstr ""

#: xargs/xargs.c:1740
msgid ""
"  -P, --max-procs=MAX-PROCS    run at most MAX-PROCS processes at a time\n"
msgstr ""
"  -P, --max-procs=MAX-PROCS vrti pri najviše MAX-PROCS procesa u trenutku\n"

#: xargs/xargs.c:1741
msgid "  -p, --interactive            prompt before running commands\n"
msgstr "  -p, --interactive upitaj prije porketanja komandi\n"

#: xargs/xargs.c:1742
msgid ""
"      --process-slot-var=VAR   set environment variable VAR in child "
"processes\n"
msgstr ""
"      --process-slot-var=VAR postavi varijablu okruženja VAR u dijete "
"procesu\n"

#: xargs/xargs.c:1743
msgid ""
"  -r, --no-run-if-empty        if there are no arguments, then do not run "
"COMMAND;\n"
"                                 if this option is not given, COMMAND will "
"be\n"
"                                 run at least once\n"
msgstr ""
"  -r, --no-run-if-empty if ako nema argumenata, data nemoj pokretati "
"COMMAND\n"
"                                 ako ova opcija nije data, COMMAND će biti\n"
"                                 pokrenuta bar jednom\n"

#: xargs/xargs.c:1746
msgid ""
"  -s, --max-chars=MAX-CHARS    limit length of command line to MAX-CHARS\n"
msgstr ""
"  -s, --max-chars=MAX-CHARS ograniči dužinu komandne linije na MAX-CHARS\n"

#: xargs/xargs.c:1747
msgid "      --show-limits            show limits on command-line length\n"
msgstr "      --show-limits prikaži granice na command-line dužini\n"

#: xargs/xargs.c:1748
msgid "  -t, --verbose                print commands before executing them\n"
msgstr "  -t, --verbose ispiši komandu prije njenog izvršavanja\n"

#: xargs/xargs.c:1749
msgid ""
"  -x, --exit                   exit if the size (see -s) is exceeded\n"
msgstr "  -x, --exit izađi ako je veličina (see -s) prekoračena\n"

#: find/util.c:206 xargs/xargs.c:1751
msgid "      --help                   display this help and exit\n"
msgstr "      --help prikaži pomoć i izađi\n"

#: find/util.c:207 xargs/xargs.c:1752
msgid ""
"      --version                output version information and exit\n"
"\n"
msgstr ""
