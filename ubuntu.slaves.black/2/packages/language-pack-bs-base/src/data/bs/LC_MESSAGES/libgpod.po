#: ../tests/test-photos.c:39
#, c-format
msgid ""
"Usage to add photos:\n"
"  %s add <mountpoint> <albumname> [<filename(s)>]\n"
"  <albumname> should be set to 'NULL' to add photos to the master photo "
"album\n"
"  (Photo Library) only. If you don't specify any filenames an empty album "
"will\n"
"  be created.\n"
msgstr ""
"Korištenje za dodavanje fotografija:\n"
"  %s add <mountpoint> <albumname> [<filename(s)>]\n"
"  <albumname> trebao bi biti podešen na 'NULL' da se dodaju fotografije u "
"glavni foto album\n"
"  (Photo Library) samo. Ako ne navedete nikakva imena datoteka, prazan album "
"će\n"
"  biti kreiran.\n"

#: ../tests/test-photos.c:40
#, c-format
msgid ""
"Usage to dump all photos to <output_dir>:\n"
"  %s dump <mountpoint> <output_dir>\n"
msgstr ""
"Korištenje da se sve fotografije smjeste u <output_dir>:\n"
"  %s dump <mountpoint> <output_dir>\n"

#: ../tests/test-photos.c:41
#, c-format
msgid ""
"Usage to list all photos IDs to stdout:\n"
"  %s list <mountpoint>\n"
msgstr ""
"Korištenje da se izlista ID svake fotografije u stdout:\n"
"  %s list <mountpoint>\n"

#: ../tests/test-photos.c:42
#, c-format
msgid ""
"Usage to remove photo IDs from Photo Library:\n"
"  %s remove <mountpoint> <albumname> [<ID(s)>]\n"
"  <albumname> should be set to 'NULL' to remove photos from the iPod\n"
"  altogether. If you don't specify any IDs, the photoalbum will be removed\n"
"  instead.\n"
"  WARNING: IDs may change when writing the PhotoDB file.\n"
msgstr ""
"Korištenje da se uklone ID fotografija iz Zbirke Fotografjia:\n"
"  %s remove <mountpoint> <albumname> [<ID(s)>]\n"
"  <albumname> trebao bi biti podešen na 'NULL' da se uklone fotografije sa "
"iPoda\n"
"  sve zajedno. Ako ne navedete nijedan ID, foto album će biti uklonjen\n"
"  umjesto toga\n"
"PAŽNJA: ID se mogu promijeniti pri pisanju PhotoDB datoteke.\n"

