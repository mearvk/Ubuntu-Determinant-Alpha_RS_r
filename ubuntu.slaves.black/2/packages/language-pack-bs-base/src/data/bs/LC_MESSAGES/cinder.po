#: cinder/context.py:107
#, python-format
msgid "read_deleted can only be one of 'no', 'yes' or 'only', not %r"
msgstr ""
"read_deleted može biti samo jedno od sljedećeg: 'no' , 'yes' ili 'only', a "
"nikako %r"

#: cinder/coordination.py:119
msgid "Coordinator uninitialized."
msgstr "Koordinator nije inicijalizovan."

#: cinder/coordination.py:210
#, python-format
msgid "Not a valid string: %s"
msgstr "String nije validan: %s"

#: cinder/exception.py:66 cinder/brick/exception.py:31
msgid "An unknown exception occurred."
msgstr "Desio se nepoznat izuzetak."

#: cinder/exception.py:107
#, python-format
msgid ""
"Bad or unexpected response from the storage volume backend API: %(data)s"
msgstr ""
"Loš ili nepredviđen odgovor sa spremišta sadržaja backend API: %(data)s"

#: cinder/exception.py:112
#, python-format
msgid "Volume driver reported an error: %(message)s"
msgstr "Sadržajni drajver je prijavio grešku: %(message)s"

#: cinder/exception.py:116
#, python-format
msgid "Backup driver reported an error: %(message)s"
msgstr "Drajver za podršku je prijavio grešku: %(message)s"

#: cinder/exception.py:120
#, python-format
msgid "Connection to glance failed: %(reason)s"
msgstr "Neuspješno povezivanje sa glance : %(reason)s"

#: cinder/exception.py:124
msgid "Not authorized."
msgstr "Bez ovlaštenja."

#: cinder/exception.py:129
msgid "User does not have admin privileges"
msgstr "Korisnik nema administratorske privilegija"

#: cinder/exception.py:133
#, python-format
msgid "Policy doesn't allow %(action)s to be performed."
msgstr "Pravila ne dozvoljavaju da se izvrši %(action)s."

#: cinder/exception.py:137
#, python-format
msgid "Not authorized for image %(image_id)s."
msgstr "Nije autorizovan za sliku %(image_id)s."

#: cinder/exception.py:141
msgid "Volume driver not ready."
msgstr "Drajver za sadržaj nije spreman."

#: cinder/exception.py:145 cinder/brick/exception.py:77
msgid "Unacceptable parameters."
msgstr "Neprihvatljivi parametri."

#: cinder/exception.py:150
#, python-format
msgid "Invalid snapshot: %(reason)s"
msgstr "Nevažeći snimak: %(reason)s"

#: cinder/exception.py:154
#, python-format
msgid "Invalid attaching mode '%(mode)s' for volume %(volume_id)s."
msgstr "Neispravan način spajanja '%(mode)s' za sadržaj %(volume_id)s."

#: cinder/exception.py:159
#, python-format
msgid "Volume %(volume_id)s is still attached, detach volume first."
msgstr "Sadržaj %(volume_id)s je i dalje povezan, prvo odspojite sadržaj."

#: cinder/exception.py:167
msgid "The results are invalid."
msgstr "Rezultati su nevažeći."

#: cinder/exception.py:171
#, python-format
msgid "Invalid input received: %(reason)s"
msgstr "Prihvaćen je neispravan ulaz: %(reason)s"

#: cinder/exception.py:175
#, python-format
msgid "Invalid volume type: %(reason)s"
msgstr "Neispravan tip sadržaja: %(reason)s"

#: cinder/exception.py:179
#, python-format
msgid "Invalid volume: %(reason)s"
msgstr "Sadržaj je neispravan: %(reason)s"

#: cinder/exception.py:183
#, python-format
msgid "Invalid content type %(content_type)s."
msgstr "Neispravan tip sadržaja %(content_type)s."

#: cinder/exception.py:187
#, python-format
msgid "Invalid host: %(reason)s"
msgstr "Nepravilan host:  %(reason)s"

#: cinder/exception.py:193 cinder/brick/exception.py:84
#, python-format
msgid "%(err)s"
msgstr "%(err)s"

#: cinder/exception.py:197
#, python-format
msgid "Invalid auth key: %(reason)s"
msgstr "Neispravan izvorni ključ: %(reason)s"

#: cinder/exception.py:201
#, python-format
msgid ""
"Value \"%(value)s\" is not valid for configuration option \"%(option)s\""
msgstr ""
"Vrijednost \"%(value)s\" nije valdina za izbor konfiguracije \"%(option)s\""

#: cinder/exception.py:206
msgid "Service is unavailable at this time."
msgstr "U ovom trenutku usluga nije dostupna."

#: cinder/exception.py:210
#, python-format
msgid "Image %(image_id)s is unacceptable: %(reason)s"
msgstr "Fotografija %(image_id)s je neprihvatljiva: %(reason)s"

#: cinder/exception.py:214
#, python-format
msgid "The device in the path %(path)s is unavailable: %(reason)s"
msgstr "Komponenta u putanji %(path)s nije dostupna: %(reason)s"

#: cinder/exception.py:218
#, python-format
msgid "Expected a uuid but received %(uuid)s."
msgstr "Očekivan uuid, ali dobijen %(uuid)s"

#: cinder/exception.py:247
#, python-format
msgid ""
"API Version String %(version)s is of invalid format. Must be of format "
"MajorNum.MinorNum."
msgstr ""
"API Version String %(version)s je neispravnog formata. Mora biti formata "
"MajorNum.MinorNum."

#: cinder/exception.py:252
#, python-format
msgid "API version %(version)s is not supported on this method."
msgstr "API verzija %(version)s nije podržana ovom metodom."

#: cinder/exception.py:256
#, python-format
msgid ""
"Version %(req_ver)s is not supported by the API. Minimum is %(min_ver)s and "
"maximum is %(max_ver)s."
msgstr ""
"Verzija  %(req_ver)s nije podržana od strane API. Minimalno je  %(min_ver)s "
"i maksimalno je %(max_ver)s."

#: cinder/exception.py:261
#, python-format
msgid "Error while requesting %(service)s API."
msgstr "Greška prilikom zahtjeva za %(service)s API."

#: cinder/exception.py:270
#, python-format
msgid "Timeout while requesting %(service)s API."
msgstr "Desio se prekid tokom zahtijevanja %(service)s API."

#: cinder/exception.py:274
#, python-format
msgid "Timeout while requesting capabilities from backend %(service)s."
msgstr ""
"Desio se prekid prilikom zahtjevanja sposobnosti iz backend-a %(service)s."

#: cinder/exception.py:222 cinder/brick/exception.py:71
msgid "Resource could not be found."
msgstr "Resurs nije moguće pronaći."

#: cinder/exception.py:228
#, python-format
msgid "Volume %(volume_id)s could not be found."
msgstr "Sadržaj %(volume_id)s nije moguće pronaći."

#: cinder/exception.py:290
#, python-format
msgid "Volume attachment could not be found with filter: %(filter)s ."
msgstr "Dodatak zvuka nije moguće naći sa filterom : %(filter)s."

#: cinder/exception.py:232
#, python-format
msgid "Volume %(volume_id)s has no metadata with key %(metadata_key)s."
msgstr "Sadržaj %(volume_id)s nema metapodataka sa ključem %(metadata_key)s."

#: cinder/exception.py:237
#, python-format
msgid ""
"Volume %(volume_id)s has no administration metadata with key "
"%(metadata_key)s."
msgstr ""
"Sadržaj %(volume_id)s nema administrativnih metapodataka sa ključem "
"%(metadata_key)s."

#: cinder/exception.py:242
#, python-format
msgid "Invalid metadata: %(reason)s"
msgstr "Nevažeći metapodaci: %(reason)s"

#: cinder/exception.py:246
#, python-format
msgid "Invalid metadata size: %(reason)s"
msgstr "Neispravna mjera metapodatak: %(reason)s"

#: cinder/exception.py:250
#, python-format
msgid "Snapshot %(snapshot_id)s has no metadata with key %(metadata_key)s."
msgstr ""
"Snimak  %(snapshot_id)s nema metapodataka sa ključem %(metadata_key)s."

#: cinder/exception.py:255
#, python-format
msgid "Volume type %(volume_type_id)s could not be found."
msgstr "Tip sveska %(volume_type_id)s nije pronađen."

#: cinder/exception.py:259
#, python-format
msgid "Volume type with name %(volume_type_name)s could not be found."
msgstr "Tip sadržaja sa imenom %(volume_type_name)s nije moguće pronaći."

#: cinder/exception.py:327
#, python-format
msgid ""
"Volume type access not found for %(volume_type_id)s / %(project_id)s "
"combination."
msgstr ""
"Nije pronađen pristup tipu sadržaja za %(volume_type_id)s / %(project_id)s "
"kombinaciju."

#: cinder/exception.py:264
#, python-format
msgid ""
"Volume Type %(volume_type_id)s has no extra specs with key "
"%(extra_specs_key)s."
msgstr ""
"Tip sadržaja %(volume_type_id)s nema dodatnih specifikacija sa ključem "
"%(extra_specs_key)s."

#: cinder/exception.py:269
#, python-format
msgid ""
"Volume Type %(volume_type_id)s deletion is not allowed with volumes present "
"with the type."
msgstr ""
"Brisanje tipa sadržaja %(volume_type_id)s nije dozvoljeno sa sadržajem "
"prisutnim u tipu."

#: cinder/exception.py:274
#, python-format
msgid "Snapshot %(snapshot_id)s could not be found."
msgstr "Snimak %(snapshot_id)s ne može biti pronađen."

#: cinder/exception.py:346
#, python-format
msgid "Instance %(uuid)s could not be found."
msgstr "Slučaj %(uuid)s nije pronađen."

#: cinder/exception.py:278
#, python-format
msgid "deleting volume %(volume_name)s that has snapshot"
msgstr "Brisanje sadržaja%(volume_name)s koji posjeduje snimak"

#: cinder/exception.py:282
#, python-format
msgid "deleting snapshot %(snapshot_name)s that has dependent volumes"
msgstr "Brisanje snimka%(snapshot_name)s koji ima zavisne opsege"

#: cinder/exception.py:287
#, python-format
msgid "No target id found for volume %(volume_id)s."
msgstr "Nije pronađena identifikacija za sadržaj %(volume_id)s."

#: cinder/exception.py:291
#, python-format
msgid "Invalid image href %(image_href)s."
msgstr "Pogrešna slika href %(image_href)s."

#: cinder/exception.py:295
#, python-format
msgid "Image %(image_id)s could not be found."
msgstr "Sliku %(image_id)s ne moguće pronaći."

#: cinder/exception.py:374
#, python-format
msgid "Service %(service_id)s could not be found on host %(host)s."
msgstr "Servis %(service_id)s nije pronađen na domaćinu %(host)s."

#: cinder/exception.py:299
#, python-format
msgid "Service %(service_id)s could not be found."
msgstr "Usluga %(service_id)s nije pronađena."

#: cinder/exception.py:382
msgid "Service is too old to fulfil this request."
msgstr "Servis je previše star da ispuni ovaj zahtjev."

#: cinder/exception.py:303
#, python-format
msgid "Host %(host)s could not be found."
msgstr "Host %(host)s nije pronađen."

#: cinder/exception.py:307
#, python-format
msgid "Scheduler Host Filter %(filter_name)s could not be found."
msgstr "Raspoređivač Host Filtera %(filter_name)s ne moguće pronaći."

#: cinder/exception.py:311
#, python-format
msgid "Scheduler Host Weigher %(weigher_name)s could not be found."
msgstr "Raspoređivač Host Mjerača %(weigher_name)s nije pronađen."

#: cinder/exception.py:319
#, python-format
msgid "Invalid reservation expiration %(expire)s."
msgstr "Nevažeće isticanje rezervacije %(expire)s."

#: cinder/exception.py:323
#, python-format
msgid ""
"Change would make usage less than 0 for the following resources: %(unders)s"
msgstr ""
"Promjena bi uzrokovala korist manju od 0 za sljedeće resurse: %(unders)s"

#: cinder/exception.py:407
#, python-format
msgid "Project quotas are not properly setup for nested quotas: %(reason)s."
msgstr ""
"Projektne kvote nisu ispravno postavljene za uklopljene kvote : %(reason)s.."

#: cinder/exception.py:328
msgid "Quota could not be found"
msgstr "Kvotu nije moguće pronaći"

#: cinder/exception.py:332
#, python-format
msgid "Unknown quota resources %(unknown)s."
msgstr "Nepoznati resursi kvota %(unknown)s."

#: cinder/exception.py:336
#, python-format
msgid "Quota for project %(project_id)s could not be found."
msgstr "Kvotu za projekt %(project_id)s ne moguće pronaći."

#: cinder/exception.py:340
#, python-format
msgid "Quota class %(class_name)s could not be found."
msgstr "Vrsta kvota %(class_name)s nije pronađena."

#: cinder/exception.py:344
#, python-format
msgid "Quota usage for project %(project_id)s could not be found."
msgstr "Upotreba kvote za projekat %(project_id)s nije ponađena."

#: cinder/exception.py:348
#, python-format
msgid "Quota reservation %(uuid)s could not be found."
msgstr "Rezervaciju kvote %(uuid)s nije moguće pronaći."

#: cinder/exception.py:352
#, python-format
msgid "Quota exceeded for resources: %(overs)s"
msgstr "Kvota prekoračena za resurse: %(overs)s"

#: cinder/exception.py:356
#, python-format
msgid "File %(file_path)s could not be found."
msgstr "Datoteka %(file_path)s nije pronađena."

#: cinder/exception.py:365
#, python-format
msgid "Volume Type %(id)s already exists."
msgstr "Tip sadržaja %(id)s već postoji."

#: cinder/exception.py:452
#, python-format
msgid ""
"Volume type access for %(volume_type_id)s / %(project_id)s combination "
"already exists."
msgstr ""
"Pristup sadržaju tipa %(volume_type_id)s za %(project_id)s kombinaciju  već "
"postoji."

#: cinder/exception.py:369
#, python-format
msgid "Volume type encryption for type %(type_id)s already exists."
msgstr "Kodiranje za sadržaj tipa %(type_id)s već postoji."

#: cinder/exception.py:373
#, python-format
msgid "Volume type encryption for type %(type_id)s does not exist."
msgstr "Kodiranje za sadržaj tipa %(type_id)s ne postoji."

#: cinder/exception.py:377
#, python-format
msgid "Malformed message body: %(reason)s"
msgstr "Deformisano tijelo poruke: %(reason)s"

#: cinder/exception.py:381
#, python-format
msgid "Could not find config at %(path)s"
msgstr "Konfiguracija nije pronađena u %(path)s"

#: cinder/exception.py:385
#, python-format
msgid "Could not find parameter %(param)s"
msgstr "Parametar nije pronađen %(param)s"

#: cinder/exception.py:389
#, python-format
msgid "Could not load paste app '%(name)s' from %(path)s"
msgstr "Zalijepljena aplikacija nije učitana '%(name)s' iz %(path)s"

#: cinder/exception.py:393
#, python-format
msgid "No valid host was found. %(reason)s"
msgstr "Nije pronađen nijedan važeći host. %(reason)s"

#: cinder/exception.py:402
#, python-format
msgid "Quota exceeded: code=%(code)s"
msgstr "Kvota prekoračena: kod=%(code)s"

#: cinder/exception.py:497
#, python-format
msgid ""
"Requested volume or snapshot exceeds allowed %(name)s quota. Requested "
"%(requested)sG, quota is %(quota)sG and %(consumed)sG has been consumed."
msgstr ""
"Traženi sadržaj ili fotografija prelaze dopuštenu %(name)s kvotu. Tražena "
"%(requested)sG, kvota je %(quota)sG i %(consumed)sG iskorištena."

#: cinder/exception.py:508
#, python-format
msgid ""
"Requested volume size %(size)d is larger than maximum allowed limit "
"%(limit)d."
msgstr ""
"Traženi sadržaj %(size)d je veći od najvećeg dozvoljenog limita %(limit)d."

#: cinder/exception.py:513
#, python-format
msgid ""
"Requested backup exceeds allowed Backup gigabytes quota. Requested "
"%(requested)sG, quota is %(quota)sG and %(consumed)sG has been consumed."
msgstr ""
"Treženi bekap prelazi dozvoljenu kvotu bekap gigabajta. Tražena "
"%(requested)sG, kvota je %(quota)sG i %(consumed)sG  iskorištena."

#: cinder/exception.py:519
#, python-format
msgid ""
"Maximum number of volumes allowed (%(allowed)d) exceeded for quota "
"'%(name)s'."
msgstr ""
"Maksimalni dozvoljeni broj volumena (%(allowed)d)   prelazi  za kvotu "
"'%(name)s'."

#: cinder/exception.py:419
#, python-format
msgid "Maximum number of snapshots allowed (%(allowed)d) exceeded"
msgstr "Maksimalni broj dozvoljenih snimaka (%(allowed)d) je premašen"

#: cinder/exception.py:532
#, python-format
msgid "Maximum number of backups allowed (%(allowed)d) exceeded"
msgstr "Maksimalni broj dopuštenih bekapa (%(allowed)d) je prekoračen"

#: cinder/exception.py:423
#, python-format
msgid "Detected more than one volume with name %(vol_name)s"
msgstr "Pronađeno je više od jednog sadržaja sa imenom %(vol_name)s"

#: cinder/exception.py:427
#, python-format
msgid ""
"Cannot create volume_type with name %(name)s and specs %(extra_specs)s"
msgstr ""
"Nije moguće napraviti volume_type sa imenom %(name)s i specifikacijama "
"%(extra_specs)s"

#: cinder/exception.py:545
#, python-format
msgid "Cannot update volume_type %(id)s"
msgstr "Ne može se nadograditi volume_type %(id)s"

#: cinder/exception.py:432
#, python-format
msgid "Unknown or unsupported command %(cmd)s"
msgstr "Nepoznata ili nepodržana naredba %(cmd)s"

#: cinder/exception.py:436
#, python-format
msgid "Malformed response to command %(cmd)s: %(reason)s"
msgstr "Deformisan odgovor na naredbu %(cmd)s: %(reason)s"

#: cinder/exception.py:440
#, python-format
msgid "Operation failed with status=%(status)s. Full dump: %(data)s"
msgstr "Proces neuspješan sa statusom=%(status)s. Puno bacanje:%(data)s"

#: cinder/exception.py:561
#, python-format
msgid "Connector doesn't have required information: %(missing)s"
msgstr "Konektor nema neophodnu informaciju: %(missing)s"

#: cinder/exception.py:444
#, python-format
msgid ""
"Glance metadata cannot be updated, key %(key)s exists for volume id "
"%(volume_id)s"
msgstr ""
"Glance metapodaci se ne mogu ažurirati , ključ %(key)s postoji za sadržaj "
"imena %(volume_id)s"

#: cinder/exception.py:449
#, python-format
msgid "Glance metadata for volume/snapshot %(id)s cannot be found."
msgstr "Glance metapodaci za sadržaj/sliku  %(id)s nisu pronađeni."

#: cinder/exception.py:453
#, python-format
msgid "Failed to export for volume: %(reason)s"
msgstr "Neuspješan izvoz za sadržaj : %(reason)s"

#: cinder/exception.py:684
#, python-format
msgid "Failed to remove export for volume %(volume)s: %(reason)s"
msgstr "Otklanjanje izvoza iz sadržaja  %(volume)s nije uspio : %(reason)s"

#: cinder/exception.py:457
#, python-format
msgid "Failed to create metadata for volume: %(reason)s"
msgstr "Nisu kreirani metapodaci za sadržaj: %(reason)s"

#: cinder/exception.py:461
#, python-format
msgid "Failed to update metadata for volume: %(reason)s"
msgstr "Nisu ažurirani metapodaci za sadržaj: %(reason)s"

#: cinder/exception.py:465
#, python-format
msgid "Failed to copy metadata to volume: %(reason)s"
msgstr "Nisu kopirani metapodaci za sadržaj: %(reason)s"

#: cinder/exception.py:594
#, python-format
msgid ""
"The type of metadata: %(metadata_type)s for volume/snapshot %(id)s is "
"invalid."
msgstr ""
"Tip metapodataka: %(metadata_type)s za sadržaj/fotografiju %(id)s je "
"nevažeći."

#: cinder/exception.py:469
#, python-format
msgid "Failed to copy image to volume: %(reason)s"
msgstr "Nije uspjelo kopiranje slike u sadržaj: %(reason)s"

#: cinder/exception.py:473
msgid "Invalid Ceph args provided for backup rbd operation"
msgstr "Nevažeći Ceph argumenti su obezbjeđeni sa operaciom rbd podrške"

#: cinder/exception.py:477
msgid "An error has occurred during backup operation"
msgstr "Došlo je do grške prilikom operacije podrške"

#: cinder/exception.py:481
msgid "Unsupported backup metadata version requested"
msgstr "Verzija metapodataka za podršku koja je tražena nije podržana"

#: cinder/exception.py:615
msgid "Unsupported backup verify driver"
msgstr "Nije podržan vertifikaciski rajver za podršku"

#: cinder/exception.py:485
msgid "Metadata backup already exists for this volume"
msgstr "Za podršku trnutnog sadržaja već postoje metapodaci"

#: cinder/exception.py:489
msgid "Backup RBD operation failed"
msgstr "Rezerva RBD zahvat neuspješan"

#: cinder/exception.py:627
msgid "Backup operation of an encrypted volume failed."
msgstr "Rezervna operacija enkriptovanog sardžaja neuspješna."

#: cinder/exception.py:493
#, python-format
msgid "Backup %(backup_id)s could not be found."
msgstr "Podršku %(backup_id)s ne moguće pronaći."

#: cinder/exception.py:497
msgid "Failed to identify volume backend."
msgstr "Zadnji kraj sadržaja nije identifikovan."

#: cinder/exception.py:501
#, python-format
msgid "Invalid backup: %(reason)s"
msgstr "Nevažeća rezerva: %(reason)s"

#: cinder/exception.py:505
#, python-format
msgid "Connection to swift failed: %(reason)s"
msgstr "Konekcija nije uspješna za swift: %(reason)s"

#: cinder/exception.py:509
#, python-format
msgid "Transfer %(transfer_id)s could not be found."
msgstr "Nije pronađen transfer %(transfer_id)s ."

#: cinder/exception.py:513
#, python-format
msgid "Volume migration failed: %(reason)s"
msgstr "Neuspješno prebacivanje sadržaja: %(reason)s"

#: cinder/exception.py:517
#, python-format
msgid "SSH command injection detected: %(command)s"
msgstr "Detektovano je ubacivanje komande SSH: %(command)s"

#: cinder/exception.py:521
#, python-format
msgid "QoS Specs %(specs_id)s already exists."
msgstr "Specifikacija Qo5 %(specs_id)s već postoji."

#: cinder/exception.py:525
#, python-format
msgid "Failed to create qos_specs: %(name)s with specs %(qos_specs)s."
msgstr ""
"Nije uspjelo stvaranje qos_specs: %(name)s sa specifikacijama %(qos_specs)s."

#: cinder/exception.py:530
#, python-format
msgid "Failed to update qos_specs: %(specs_id)s with specs %(qos_specs)s."
msgstr ""
"Nije upjelo ažuriranje qos_specs: %(specs_id)s sa specifikacijama "
"%(qos_specs)s."

#: cinder/exception.py:535
#, python-format
msgid "No such QoS spec %(specs_id)s."
msgstr "Ne postoje Qo5 specifikacije %(specs_id)s."

