msgstr ""
"Paketi koji će biti instalirani\n"
" Ove pakete ste ručno odabrali da budu instalirani na Vašem računaru."

#: src/gtk/previewtab.cc:106 src/pkg_grouppolicy.cc:699
msgid ""
"Packages to be removed\n"
