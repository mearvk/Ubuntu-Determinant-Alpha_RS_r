#: src/main.cc:191
#, c-format
msgid "Usage: aptitude [-S fname] [-u|-i]"
msgstr "Upotreba: aptitude [-S Ime_Fajla] [-u|-i]"

#: src/main.cc:193
#, c-format
msgid "       aptitude [options] <action> ..."
msgstr "       aptitude [opcije] <radnja> ..."

#: src/main.cc:196
#, c-format
msgid ""
"Actions (if none is specified, aptitude will enter interactive mode):\n"
"\n"
msgstr ""
"Akcije (ako se nitko ne navede, aptitude će ući u interaktivni način rada):\n"
"\n"

#: src/main.cc:197
#, c-format
msgid " install         Install/upgrade packages.\n"
msgstr " Instalirajte pakete za instalaciju/nadogradnju.\n"

#: src/main.cc:198
#, c-format
msgid " remove          Remove packages.\n"
msgstr " ukloniti ukloni pakete.\n"

#: src/main.cc:199
#, c-format
msgid " purge           Remove packages and their configuration files.\n"
msgstr " purge ukloni pakete i njihove konfiguracijske datoteke.\n"

#: src/main.cc:200
#, c-format
msgid " hold            Place packages on hold.\n"
msgstr " držite pakete na čekanju.\n"

#: src/main.cc:201
#, c-format
msgid " unhold          Cancel a hold command for a package.\n"
msgstr " zadržite zadržavanje naredbe za zadržavanje za paket.\n"

#: src/main.cc:202
#, c-format
msgid ""
" markauto        Mark packages as having been automatically installed.\n"
msgstr " markauto označite pakete koji su automatski instalirani.\n"

#: src/main.cc:203
#, c-format
msgid " unmarkauto      Mark packages as having been manually installed.\n"
msgstr " Unmarkauto označite pakete kao ručno instalirane.\n"

#: src/main.cc:204
#, c-format
msgid ""
" forbid-version  Forbid aptitude from upgrading to a specific package "
"version.\n"
msgstr ""
" zabraniti-verziju zabraniti aptitude od nadogradnje na određenu verziju "
"paketa.\n"

#: src/main.cc:205
#, c-format
msgid " update          Download lists of new/upgradable packages.\n"
msgstr " ažuriranje preuzimanje popisa novih/nadogradivih paketa.\n"

#: src/main.cc:206
#, c-format
msgid " safe-upgrade    Perform a safe upgrade.\n"
msgstr " sigurno-ažuriranje izvršite sigurnu nadogradnju.\n"

#: src/main.cc:207
#, c-format
msgid ""
" full-upgrade    Perform an upgrade, possibly installing and removing "
"packages.\n"
msgstr ""
" puni nadogradnja izvršite nadogradnju, moguće instaliranje i uklanjanje "
"paketa.\n"

#: src/main.cc:208
#, c-format
msgid " build-dep       Install the build-dependencies of packages.\n"
msgstr " build-dep instalirajte ovisnosti o gradnji paketa.\n"

#: src/main.cc:209
#, c-format
msgid " forget-new      Forget what packages are \"new\".\n"
msgstr " zaboraviti-novo zaboravite koji su paketi \"novi\".\n"

#: src/main.cc:210
#, c-format
msgid " search          Search for a package by name and/or expression.\n"
msgstr " pretraživanje traženje paketa po imenu i/ili izrazu.\n"

#: src/main.cc:211
#, c-format
msgid " show            Display detailed info about a package.\n"
msgstr " prikazati Pprikaz detaljnih informacija o paketu.\n"

#: src/main.cc:212
#, c-format
msgid ""
" showsrc         Display detailed info about a source package (apt "
"wrapper).\n"
msgstr ""
" showsrc Pprikaz detaljnih informacija o izvornom paketu (apt wrapper).\n"

#: src/main.cc:213
#, c-format
msgid " versions        Displays the versions of specified packages.\n"
msgstr " verzija prikazuje verzije za specifičan paket.\n"

#: src/main.cc:214
#, c-format
msgid " clean           Erase downloaded package files.\n"
msgstr " čisti Brise sve prezuete paketene datoteke.\n"

#: src/main.cc:215
#, c-format
msgid " autoclean       Erase old downloaded package files.\n"
msgstr " autoočisti brise stare preuzete paketne datoteke.\n"

#: src/main.cc:216
#, c-format
msgid " changelog       View a package's changelog.\n"
msgstr " zapisnik promijena pregledajte changelog paketa.\n"

#: src/main.cc:217
#, c-format
msgid ""
" download        Download the .deb file for a package (apt wrapper).\n"
msgstr " preuzmi preuzima .deb datoteke za paket (apt omot).\n"

#: src/main.cc:218
#, c-format
msgid " source          Download source package (apt wrapper).\n"
msgstr " izvor preuzima izvorne pakete (apt omot).\n"

#: src/main.cc:219
#, c-format
msgid " reinstall       Reinstall a currently installed package.\n"
msgstr " reinstall  reinstalira trenutno instalirani paket.\n"

#: src/main.cc:220
#, c-format
msgid ""
" why             Explain why a particular package should be installed.\n"
msgstr " zašto objašnjava zasto određeni paket treba bit instaliran.\n"

#: src/main.cc:221
#, c-format
msgid ""
" why-not         Explain why a particular package cannot be installed.\n"
msgstr " zašto-ne objašnjava zašto određeni paket netreba bit instaliran.\n"

#: src/main.cc:223
#, c-format
msgid " add-user-tag    Add user tag to packages/patterns.\n"
msgstr " dodaj-korisničku-oznau dodaje korizniku oznaku za pakete/obrazce.\n"

#: src/main.cc:224
#, c-format
msgid " remove-user-tag Remove user tag from packages/patterns.\n"
msgstr " remove-user-tag uklanja korisničku oznaku iz paketa/obrazca.\n"

#: src/main.cc:226
#, c-format
msgid "Options:\n"
msgstr "Opcije:\n"

#: src/main.cc:227
#, c-format
msgid " -h              This help text.\n"
msgstr " -h Ovo pomaže tekstu.\n"

#: src/main.cc:229
#, c-format
msgid ""
" --gui           Use the GTK GUI even if disabled in the configuration.\n"
msgstr " --gui korist GTK GUI čak i kad je onemogučeno u konfiguracij.\n"

#: src/main.cc:231
#, c-format
msgid " --no-gui        Do not use the GTK GUI even if available.\n"
msgstr " --no-gui  ne koristi GTK GUI čak i kad je dostupno.\n"

#: src/main.cc:233
#, c-format
msgid " --qt            Use the Qt GUI.\n"
msgstr " --qt koristi Qt GUI.\n"

#: src/main.cc:234
#, c-format
msgid ""
" --no-qt         Do not use the Qt GUI even if enabled in the "
"configuration.\n"
msgstr " --no-qt ne koristi Qt GUI čak i kad je omogučeno u konfiguracij.\n"

#: src/main.cc:236
#, c-format
msgid ""
" -s              Simulate actions, but do not actually perform them.\n"
msgstr " -s  simulira akciju, ali ih zapravo ne izvodi.\n"

#: src/main.cc:237
#, c-format
msgid ""
" -d              Only download packages, do not install or remove anything.\n"
msgstr " -d samo preuzmi pakete, ne instaliraj ili uklanjaj bilo šta.\n"

#: src/main.cc:238
#, c-format
msgid " -P              Always prompt for confirmation of actions.\n"
msgstr " -P uvijek potanki potvrđenje akcija.\n"

#: src/main.cc:239
#, c-format
msgid ""
" -y              Assume that the answer to simple yes/no questions is "
"'yes'.\n"
msgstr ""
" -y Predpostavlja da odgovor na jednostavno da/ne pitanje je \"da\".\n"

#: src/main.cc:240
#, c-format
msgid ""
" -F format       Specify a format for displaying search results; see the "
"manual.\n"
msgstr ""
" -F format određuje format za prikazivanje rezultata pretraživanja; pogledaj "
"priručnik.\n"

#: src/main.cc:241
#, c-format
msgid ""
" -O order        Specify how search results should be sorted; see the "
"manual.\n"
msgstr ""
" -O redoslijed određuje kako bi rezultat pretraživanja trebali bit "
"sortirani; pogledaj priručnik.\n"

#: src/main.cc:242
#, c-format
msgid ""
" -w width        Specify the display width for formatting search results.\n"
msgstr ""
" -w širina oređuje širinu prikaza za formatiranje rezultata pretrage.\n"

#: src/main.cc:243
#, c-format
msgid " -f              Aggressively try to fix broken packages.\n"
msgstr " -f Agresivno pokušava popraviti pokvareni paket.\n"

#: src/main.cc:244
#, c-format
msgid ""
" -V              Show which versions of packages are to be installed.\n"
msgstr " -V pokazuje koju verziju paketa treba instalirat.\n"

#: src/main.cc:245
#, c-format
msgid ""
" -D              Show the dependencies of automatically changed packages.\n"
msgstr " -D prikazuje ovisnost od automatski izmijena paketa.\n"

#: src/main.cc:246
#, c-format
msgid " -Z              Show the change in installed size of each package.\n"
msgstr " -Z prikazuje promijene u instaliranoj veličini svakog paketa.\n"

#: src/main.cc:247
#, c-format
msgid ""
" -v              Display extra information. (may be supplied multiple "
"times).\n"
msgstr " -v prikazuje dodatne informacije. (mogu se isporučiti više puta).\n"

#: src/main.cc:248
#, c-format
msgid ""
" -t [release]    Set the release from which packages should be installed.\n"
msgstr ""
