#, c-format
msgid ""
"  --gdwarf-sections       generate per-function section names for DWARF line "
"information\n"
msgstr ""
"  --gdwarf-sections       generiši imena sekcija po funkcijama za "
"informaciju linije DWARF-a\n"

#: as.c:348
#, c-format
msgid "  --target-help           show target specific options\n"
msgstr "  --target-help prikazi konkretno odredište opcija\n"

#: as.c:350
#, c-format
msgid ""
"  -I DIR                  add DIR to search list for .include directives\n"
msgstr "  -I DIR dodaj DIR da u listu pretrage za .include direktive\n"

#: as.c:352
#, c-format
msgid "  -J                      don't warn about signed overflow\n"
msgstr "  -J neupozorava o označenom prekoračenju kapaciteta\n"

#: as.c:354
#, c-format
msgid ""
"  -K                      warn when differences altered for long "
"displacements\n"
msgstr "  -K upozori kada se razlika promjenila za duge pomake\n"

#: as.c:356
#, c-format
msgid ""
"  -L,--keep-locals        keep local symbols (e.g. starting with `L')\n"
msgstr "  -L,--keep-locals čuva lokalne simbole (npr. počinje sa 'L')\n"

#: as.c:358
#, c-format
msgid "  -M,--mri                assemble in MRI compatibility mode\n"
msgstr "  -M,--mri asemblira u MRI kompaktibilnom modu\n"

#: as.c:360
#, c-format
msgid ""
"  --MD FILE               write dependency information in FILE (default "
"none)\n"
msgstr ""
"  --MD FILE piše informacije o međuzavisnostima u DATOTECI (nema "
"podrazumjevane)\n"

#: as.c:362
#, c-format
msgid "  -nocpp                  ignored\n"
msgstr "  -nocpp ignorirano\n"

#: as.c:364
#, c-format
msgid ""
"  -no-pad-sections        do not pad the end of sections to alignment "
"boundaries\n"
msgstr ""
"  -no-pad-sections nemoj postavljati kraj oblasti za poravnanje sa "
"granicama\n"

#: as.c:366
#, c-format
msgid ""
"  -o OBJFILE              name the object-file output OBJFILE (default "
"a.out)\n"
msgstr ""
"  -o OBJFILE imenuj objektnu datoteku izlaz OBJFILE (podrazumjevani a.out)\n"

#: as.c:368
#, c-format
msgid "  -R                      fold data section into text section\n"
msgstr "  -R složena sekcija podataka u tekstnoj sekciji\n"

#: as.c:370
#, c-format
msgid ""
"  --statistics            print various measured statistics from execution\n"
msgstr "  --statistics ispisuje razna statistička mjerenja od izvršavanja\n"

#: as.c:372
#, c-format
msgid "  --strip-local-absolute  strip local absolute symbols\n"
msgstr "  --strip-local-absolute  odbaci lokalne apsolutne simbole\n"

#: as.c:374
#, c-format
msgid ""
"  --traditional-format    Use same format as native assembler when possible\n"
msgstr ""
"  --traditional-format koristi isti format kao izvorni asembler kada je "
"moguće\n"

#: as.c:376
#, c-format
msgid "  --version               print assembler version number and exit\n"
msgstr "  --version ispis verzije asemblera i izlazi\n"

#: as.c:378
#, c-format
msgid "  -W  --no-warn           suppress warnings\n"
msgstr "  -W  --no-warn izostavljena upozorenja\n"

#: as.c:380
#, c-format
msgid "  --warn                  don't suppress warnings\n"
msgstr "  --warn nemoj izostavljati upozorenja\n"

#: as.c:382
#, c-format
msgid "  --fatal-warnings        treat warnings as errors\n"
msgstr "  --fatal-warnings tretiraj upozorenja kao greške\n"

#: as.c:385
#, c-format
msgid ""
"  --itbl INSTTBL          extend instruction set to include instructions\n"
"                          matching the specifications defined in file "
"INSTTBL\n"
msgstr ""
"  --itbl INSTTBL          proširiti skup instrukcija kako bi uključili "
"instrukcije\n"
"                        koje se podudaraju specifikacije definirane u "
"datoteci INSTTBL\n"

#: as.c:389
#, c-format
msgid "  -w                      ignored\n"
msgstr "  - w ignoriran\n"

#: as.c:391
#, c-format
msgid "  -X                      ignored\n"
msgstr "  -X ignoriran\n"

#: as.c:393
#, c-format
msgid "  -Z                      generate object file even after errors\n"
msgstr "  -Z generira objektnu datoteku i poslije grešaka\n"

#: as.c:395
#, c-format
msgid ""
"  --listing-lhs-width     set the width in words of the output data column "
"of\n"
"                          the listing\n"
msgstr ""
"  --listing-lhs-width    postavite širinu u riječima izlazne kolone "
"podataka\n"
"                          popis\n"

#: as.c:398
#, c-format
msgid ""
"  --listing-lhs-width2    set the width in words of the continuation lines\n"
"                          of the output data column; ignored if smaller "
"than\n"
"                          the width of the first line\n"
msgstr ""
"  --listing-lhs-width2   postavite širinu u riječima nastavka linije\n"
"                         kolone izlaznih podataka, ignorirati ako je manja "
"od\n"
"                         širine prve linije\n"

#: as.c:402
#, c-format
msgid ""
"  --listing-rhs-width     set the max width in characters of the lines from\n"
"                          the source file\n"
msgstr ""
"  --listing-rhs-width     postaviti maksimalnu  širinu u znakovima od linije "
"iz\n"
"                         izvorna datoteka\n"

#: as.c:405
#, c-format
msgid ""
"  --listing-cont-lines    set the maximum number of continuation lines used\n"
"                          for the output data column of the listing\n"
msgstr ""
"  --listing-cont-lines   postavlja najveći broj nastavaka iskorištenih "
"linija\n"
"                         za kolonu izlaznih podataka u popisu\n"

