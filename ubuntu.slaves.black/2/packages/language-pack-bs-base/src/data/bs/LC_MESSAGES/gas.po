#: as.c:336
#, c-format
msgid "  -f                      skip whitespace and comment preprocessing\n"
msgstr "  -f                    preskočite praznine i komentar obradu\n"

#: as.c:338
#, c-format
msgid "  -g --gen-debug          generate debugging information\n"
msgstr "  -g --gen-debug        generiranje pogrešaka informacije\n"

#: as.c:340
#, c-format
msgid "  --gstabs                generate STABS debugging information\n"
msgstr "  --gstabs generira STABS informacije o traženju grešaka\n"

#: as.c:342
#, c-format
msgid ""
"  --gstabs+               generate STABS debug info with GNU extensions\n"
msgstr ""
"  --gstabs+ generira STABS info traženja grešaka sa GNU ekstenzijom\n"

