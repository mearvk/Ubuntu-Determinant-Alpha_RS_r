#, c-format
msgid ""
"  --debug-prefix-map OLD=NEW\n"
"                          map OLD to NEW in debug information\n"
msgstr ""
"  --debug-prefix-map OLD=NEW\n"
"                         mapa Old za NEW u informaciji o otklanjanju "
"grešaka\n"

#: as.c:286
#, c-format
msgid "  --defsym SYM=VAL        define symbol SYM to given value\n"
msgstr "  --defsym SYM=VAL        definirati simbol SYM date vrijednosti\n"

