msgstr ""
"  --compress-debug-sections[={none|zlib|zlib-gnu|zlib-gabi}]\n"
"                          kompresuj DWARF debug odjeljke korištenjem zlib "
"[default]\n"

#: as.c:270
#, c-format
msgid ""
"  --nocompress-debug-sections\n"
"                          don't compress DWARF debug sections\n"
msgstr ""
"  --nocompress-debug-sections\n"
"                          ne kompresuj DWARF sekciju traženja grešaka\n"

#: as.c:274
#, c-format
msgid ""
"  --compress-debug-sections[={none|zlib|zlib-gnu|zlib-gabi}]\n"
