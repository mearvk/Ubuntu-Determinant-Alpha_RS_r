"-mips5 generiši MIPS ISA V upute\n"
"-mips32 generiši MIPS32 ISA upute\n"
"-mips32r2 generiši MIPS32  2 ISA upute\n"
"-mips32r3 generiši MIPS32 oslobodi 3 ISA upute\n"
"-mips32r5 generiši MIPS32 oslobodi 5 ISA upute\n"
"-mips32r6 generiši MIPS32 oslobodi 6 ISA upute\n"
"-mips64 generiši MIPS64 ISA upute\n"
"-mips64r2 generiši MIPS64 oslobodi 2 ISA upute\n"
"-mips64r3 generiši MIPS64 oslobodi 3 ISA upute\n"
"-mips64r5 generiši MIPS64 oslobodi 5 ISA upute\n"
"-mips64r6 generiši MIPS64 oslobodi 6 ISA upute\n"
"-march=CPU/-mtune=CPU\tgeneriši kod/raspored za CPU, gdje je CPU jedan od:\n"

#: config/tc-mips.c:20358
