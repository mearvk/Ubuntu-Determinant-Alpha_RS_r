msgstr ""
"  --compress-debug-sections[={none|zlib|zlib-gnu|zlib-gabi}]\n"
"                          kopresuj DWARF debug dijelove koristeći zlib\n"

#: as.c:277
#, c-format
msgid ""
"  --nocompress-debug-sections\n"
"                          don't compress DWARF debug sections [default]\n"
msgstr ""
"  --nocompress-debug-sections\n"
"                          ne kompresiraj DWARF debug oblasti [default]\n"

#: as.c:281
#, c-format
msgid "  -D                      produce assembler debugging messages\n"
msgstr "  -D daje poruke traženja grešaka asemblera\n"

