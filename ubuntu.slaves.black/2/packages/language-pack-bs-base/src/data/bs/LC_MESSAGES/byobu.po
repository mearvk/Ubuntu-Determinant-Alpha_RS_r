msgid "Profile"
msgstr "Profil"

#: byobu-export:241
msgid "Archive"
msgstr "Arhiva"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Raspakujte arhivu u vašem ličnom direktorijumu na ciljnom sistemu."

