#. type: Plain text
#: ../scripts/manpage-alert.1:6
msgid "B<manpage-alert> [I<options>] [I<paths>]"
msgstr "B<manpage-alert> [I<options>] [I<paths>]"

#. type: Plain text
#: ../scripts/manpage-alert.1:9
