#. type: Plain text
#: ../scripts/dd-list.1:30
msgid ""
"B<dd-list> produces nicely formatted lists of Debian (.deb) packages and "
"their maintainers."
msgstr ""
"B<dd-list> produces nicely formatted lists of Debian (.deb) packages and "
"their maintainers."

#. type: Plain text
#: ../scripts/dd-list.1:37
