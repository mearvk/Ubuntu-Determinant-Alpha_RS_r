msgid "B<-x>I<prefix>"
msgstr "B<-x>I<prefix>"

#. type: Plain text
#: ../scripts/cvs-debc.1:55 ../scripts/cvs-debi.1:59
#: ../scripts/cvs-debrelease.1:57
msgid "This option provides the CVS default module prefix."
msgstr "Ova opcija nudi CVS podrazumijevani prefiks modula."

#. type: TP
#: ../scripts/cvs-debc.1:55 ../scripts/cvs-debi.1:59
#: ../scripts/cvs-debrelease.1:61 ../scripts/debc.1:99 ../scripts/debi.1:105
#: ../scripts/debrsign.1:50
#, no-wrap
msgid "B<--help>, B<--version>"
msgstr "B<--help>, B<--version>"

#. type: Plain text
