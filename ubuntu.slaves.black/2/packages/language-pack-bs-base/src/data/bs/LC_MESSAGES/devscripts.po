msgstr ""
"Ispiši izlaz za ispravljanje pogrešaka u stderr (including url(s) fetched)."

#. type: TP
#: ../scripts/grep-excuses.1:52
#, no-wrap
msgid "B<GREP_EXCUSES_MAINTAINER>"
msgstr "B<GREP_EXCUSES_MAINTAINER>"

#. type: Plain text
#: ../scripts/grep-excuses.1:56
