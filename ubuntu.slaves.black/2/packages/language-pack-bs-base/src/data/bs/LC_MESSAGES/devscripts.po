#. type: Plain text
#: ../scripts/cvs-debc.1:52 ../scripts/cvs-debi.1:56
#: ../scripts/cvs-debrelease.1:54
msgid "The full path name for the cvs-buildpackage working directory."
msgstr "Cijelo ime puta za cvs-buildpackage radni direktorij."

#. type: TP
#: ../scripts/cvs-debc.1:52 ../scripts/cvs-debi.1:56
#: ../scripts/cvs-debrelease.1:54
