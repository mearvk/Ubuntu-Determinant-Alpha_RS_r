#: tp/texi2any.pl:785
msgid ""
"Translate Texinfo source documentation to various other formats, by default\n"
"Info files suitable for reading online with Emacs or standalone GNU Info.\n"
"\n"
"This program is commonly installed as both `makeinfo' and `texi2any';\n"
"the behavior is identical, and does not depend on the installed name.\n"
msgstr ""
"Prevedi Texinfo izvorne dokumentacije za razne druge formate, po defaultu\n"
"Info datoteke pogodne za čitanje on-line s Emacs ili samostalnim GNU Info.\n"
"\n"
"Ovaj program obično je instaliran i kao `makeinfo' i `texi2any';\n"
"ponašanje je identično, i ne ovisi o instaliranom imenu.\n"

#: tp/texi2any.pl:793
#, perl-format
msgid ""
"General options:\n"
"      --document-language=STR locale to use in translating Texinfo keywords\n"
"                                for the output document (default C).\n"
"      --error-limit=NUM       quit after NUM errors (default %d).\n"
"      --force                 preserve output even if errors.\n"
"      --help                  display this help and exit.\n"
"      --no-validate           suppress node cross-reference validation.\n"
"      --no-warn               suppress warnings (but not errors).\n"
"      --conf-dir=DIR          search also for initialization files in DIR.\n"
"      --init-file=FILE        load FILE to modify the default behavior.\n"
"  -c, --set-customization-variable VAR=VAL  set customization variable VAR \n"
"                                to value VAL.\n"
"  -v, --verbose               explain what is being done.\n"
"      --version               display version information and exit.\n"
msgstr ""
"Generalne opcije:\n"
"      --document-language=STR locale koristiti u prevođenju Texinfo riječi\n"
"                                za izlaz dokumenta (zadano C).\n"
"      --error-limit=NUM izađi nakon NUM grešaka (zadano %d).\n"
"      --force sačuvaj izlaz čak i ako dođe do greške.\n"
"      --help prikaži ovu pomoć ako dođe do greške i izađi.\n"
"      --no-validate potisnuti cross-reference validacije čvora.\n"
"      --no-warn potisnuti upozorenja (ali ne greške).\n"
"      --conf-dir=DIR pretraga također za inicijalizaciju datoteka u DIR.\n"
"      --init-file=FILE učitaj FILE za modificiranje zadanog ponašanja.\n"
"  -c, --set-customization-variable VAR=VAL postavi varijablu prilagodbe VAR "
"\n"
"                                na vrijednost VAL.\n"
"  -v, --verbose objasni šta se radi.\n"
"      --version prikaži veziju informacija displeja i izađi-\n"

#: tp/texi2any.pl:689
msgid ""
"Output format selection (default is to produce Info):\n"
"      --docbook               output Docbook XML rather than Info.\n"
"      --html                  output HTML rather than Info.\n"
"      --plaintext             output plain text rather than Info.\n"
"      --xml                   output Texinfo XML rather than Info.\n"
"      --dvi, --dvipdf, --ps, --pdf  call texi2dvi to generate given output,\n"
"                                after checking validity of TEXINFO-FILE.\n"
msgstr ""
"Izbor izlaznog formata (zadano je da se stvori Info):\n"
"      --docbook izlaz Docbook XML radije nego Info.\n"
"      --html izlaz HTM radije nego Info.\n"
"      --plaintext izlaz obični tekst radije nego Info.\n"
"      --xml izlaz Texinfo XML radije nego Info.\n"
"      --dvi, --dvipdf, --ps, --pdf pozovi texi2dvi za generisanje datog "
"izlaza,\n"
"                                nakon provjeravanja valjanosti TEXINFO-"
"FILE.\n"

#: tp/texi2any.pl:699
msgid ""
"General output options:\n"
"  -E, --macro-expand=FILE     output macro-expanded source to FILE,\n"
"                                ignoring any @setfilename.\n"
"      --no-headers            suppress node separators, Node: lines, and "
"menus\n"
"                                from Info output (thus producing plain "
"text)\n"
"                                or from HTML (thus producing shorter "
"output).\n"
"                                Also, if producing Info, write to\n"
"                                standard output by default.\n"
"      --no-split              suppress any splitting of the output;\n"
"                                generate only one output file.\n"
"      --[no-]number-sections  output chapter and sectioning numbers;\n"
"                                default is on.\n"
"  -o, --output=DEST           output to DEST.\n"
"                                With split output, create DEST as a "
"directory\n"
"                                 and put the output files there.\n"
"                                With non-split output, if DEST is already\n"
"                                 a directory or ends with a /,\n"
"                                 put the output file there.\n"
"                                Otherwise, DEST names the output file.\n"
msgstr ""
"Generalne opcije izlaza:\n"
"  -E, --macro-expand=FILE izlaz makro-proširio izvor na FILE,\n"
"                                ignoriše sve @setfilename.\n"
"      --no-headers potisni rastavljače čvorova, Čvor: linije i meniji\n"
"                                iz Info izlaza (uz to stvarajući običan "
"tekst)\n"
"                                ili iz HTML (uz to stvarajući kraći izlaz).\n"
"                                Također, ako stvara Info, upisuj u\n"
"                                standardni izlaz kao zadano.\n"
"      --no-split potisni rastavljanje izlaza;\n"
"                                generiši samo jednu izlaznu datoteku.\n"
"      --[no-]number-section poglavlje izlaza i sekcioniranje brojeva;\n"
"                                kao zadano uključeno.\n"
"  -o, --output=DEST izlaz u EST.\n"
"                                Sa razdvajanjem izlaza, kreiraj DEST kao "
"direktorij\n"
"                                 i stavi izlazne datoteke tu.\n"
"                                Sa izlazom koji nije razdvojen, ako je DEST "
"već\n"
"                                  direktorij ili završava sa /,\n"
"                                 stavi izlazne datoteke tu.\n"
"                                U suprotnom, DEST je ime izlazne datoteke.\n"

#: tp/texi2any.pl:721
#, perl-format
msgid ""
"Options for Info and plain text:\n"
"      --disable-encoding      do not output accented and special characters\n"
"                                in Info output based on @documentencoding.\n"
"      --enable-encoding       override --disable-encoding (default).\n"
"      --fill-column=NUM       break Info lines at NUM characters (default "
"%d).\n"
"      --footnote-style=STYLE  output footnotes in Info according to STYLE:\n"
"                                `separate' to put them in their own node;\n"
"                                `end' to put them at the end of the node, "
"in\n"
"                                which they are defined (this is the "
"default).\n"
"      --paragraph-indent=VAL  indent Info paragraphs by VAL spaces (default "
"%d).\n"
"                                If VAL is `none', do not indent; if VAL is\n"
"                                `asis', preserve existing indentation.\n"
"      --split-size=NUM        split Info files at size NUM (default %d).\n"
msgstr ""
"Opcije za Info i obični tekst:\n"
"      --disable-encoding Ne šalji na izlaz akcentovane i specijalne "
"karaktere\n"
"                                u Info izlaz na temelju @documentencoding.\n"
"      --enable-encoding override --disable-encoding (zadano %d).\n"
"      --footnote-style=STYLE izlazne fusnote u Info u skladu sa STYLE:\n"
"                                'separate' da budu stavljeni u zasebne "
"čvorove;\n"
"                                'end' da budu stavljeni na kraj čvora, u\n"
"                                koje su definisane (ovo je zadano).\n"
"      --paragraph-indent=VAL uvući Info paragrafe za VAL mjesta (zadano "
"%d).\n"
"                                Ako je VAL 'none', nemoj uvlačiti; ako je "
"VAL\n"
"                                'asis', sačuvaj postojeće uvlačenje.\n"
"      --split-size=NUM razdvoji Info datoteke na veličinu NUM (zadano %d).\n"

#: tp/texi2any.pl:874
msgid ""
"Options for HTML:\n"
"      --css-include=FILE      include FILE in HTML <style> output;\n"
"                                read stdin if FILE is -.\n"
"      --css-ref=URL           generate CSS reference to URL.\n"
"      --internal-links=FILE   produce list of internal links in FILE.\n"
"      --split=SPLIT           split at SPLIT, where SPLIT may be `chapter',\n"
"                                `section' or `node'.\n"
"      --transliterate-file-names  use file names in ASCII transliteration.\n"
"      --node-files            produce redirection files for nodes and \n"
"                                anchors; default is set only if split.\n"
msgstr ""
"Opcije za HTML:\n"
"      --css-include=FILE ukljuci FILE u HTML <style> izlaz;\n"
"                                čitaj stdin ako je FILE -.\n"
"     --css-ref=URL generiše CSS referencu za URL.\n"
"      --internal-links=FILE proizvedi listu unutrašnjih linkova u FILE.\n"
"      --split=SPLIT razdvoji kod SPLIT, gdje SPLIT može biti 'chapter',\n"
"                                'section' ili 'node'.\n"
"      --transliterate-file-names koristi imena datoteka u ASCII "
"transkripciji.\n"
"      --node-files stvori redirekcione datoteke za čvorove i \n"
"                                sidra; zadano je samo ako razdavaja.\n"

#: tp/texi2any.pl:752
msgid ""
"Options for XML and Docbook:\n"
"      --output-indent=VAL     does nothing, retained for compatibility.\n"
msgstr ""
"Opcije za XML i Docbook:\n"
"      --output-indent=VAL     ne radi ništa, zadržano radi kompatibilnosti.\n"

#: tp/texi2any.pl:886
msgid ""
"Options for DVI/PS/PDF:\n"
"      --Xopt=OPT              pass OPT to texi2dvi; can be repeated.\n"
msgstr ""
"Opcije za DVI/PS/PDF:\n"
"      --Xopt=OPT              šalje OPT k texi2dvi; može se ponoviti.\n"

#: tp/texi2any.pl:760
msgid ""
"Input file options:\n"
"      --commands-in-node-names  does nothing, retained for compatibility.\n"
"  -D VAR                        define the variable VAR, as with @set.\n"
"  -D 'VAR VAL'                  define VAR to VAL (one shell argument).\n"
"  -I DIR                        append DIR to the @include search path.\n"
"  -P DIR                        prepend DIR to the @include search path.\n"
"  -U VAR                        undefine the variable VAR, as with @clear.\n"
msgstr ""
"Ulazne opcije datoteke:\n"
"      --commands-in-node-names ne radi ništa, zadržano radi "
"kompatibilnosti.\n"
"  -D VAR definiše varijablu VAR, kao sa @set.\n"
"  -D 'VAR VAL definiše VAR u VAL (jedan argument).\n"
"  -I DIR dodati DIR u @include put pretraživanja.\n"
"  -P DIR dodati na početak DIR u @include put pretraživanja.\n"
"  -U VAR obriši varijablu VAR, kao sa @clear.\n"

#: tp/texi2any.pl:770
msgid ""
"Conditional processing in input:\n"
"  --ifdocbook       process @ifdocbook and @docbook even if\n"
"                      not generating Docbook.\n"
"  --ifhtml          process @ifhtml and @html even if not generating HTML.\n"
"  --ifinfo          process @ifinfo even if not generating Info.\n"
"  --ifplaintext     process @ifplaintext even if not generating plain text.\n"
"  --iftex           process @iftex and @tex.\n"
"  --ifxml           process @ifxml and @xml.\n"
"  --no-ifdocbook    do not process @ifdocbook and @docbook text.\n"
"  --no-ifhtml       do not process @ifhtml and @html text.\n"
"  --no-ifinfo       do not process @ifinfo text.\n"
"  --no-ifplaintext  do not process @ifplaintext text.\n"
"  --no-iftex        do not process @iftex and @tex text.\n"
"  --no-ifxml        do not process @ifxml and @xml text.\n"
"\n"
"  Also, for the --no-ifFORMAT options, do process @ifnotFORMAT text.\n"
msgstr ""
"Uslovno procesiranje u ulaz:\n"
"  --ifdocbook process @ifdocbook i @docbook čak i ako\n"
"                      ne generiše Dockbook.\n"
"  --ifhtml proces @ifinfo čak i ako ne generiše Info.\n"
"  --ifplaintext proces @ifplaintext čak i ako ne generiše obični tekst.\n"
"  --iftex proces @iftex i @tex.\n"
"  --ifxml proces @ifxml i @xml.\n"
"  --no-ifdocbook ne procesiraj @ifdocbook i @docbook tekst.\n"
"  --no-ifhtml ne procesiraj @ifhtml i @html tekst.\n"
"  --no-ifinfo ne procesiraj @ifinfo tekst.\n"
"  --no-ifplaintext ne procesiraj @ifplaintext tekst.\n"
"  --no-iftex ne procesiraj @iftex i @tex tekst.\n"
"  --no-ifxml ne procesiraj @ifxml i @xml tekst.\n"
"\n"
"  Također, za --no-ifFORMAT opcije, ne procesiraj @ifnotFORMAT tekst.\n"

#: tp/texi2any.pl:789
msgid ""
"  The defaults for the @if... conditionals depend on the output format:\n"
"  if generating Docbook, --ifdocbook is on and the others are off;\n"
"  if generating HTML, --ifhtml is on and the others are off;\n"
"  if generating Info, --ifinfo is on and the others are off;\n"
"  if generating plain text, --ifplaintext is on and the others are off;\n"
"  if generating XML, --ifxml is on and the others are off.\n"
msgstr ""
"  Zadano za @if...kondicional zavisi od izlaznog formata:\n"
"  Ako generiše Dockbook, --ifdocbook je uključen ostali su isključeni;\n"
"  Ako generiše HTML, --ifhtml je uključen ostali su isključeni;\n"
"  Ako generiše Info, -ifinfo je uključen ostali su isključeni;\n"
"  Ako generiše obični tekst, --ifplaintext je uključen ostali su "
"isključeni;\n"
"  Ako generiše XML, --ifxml je uključen ostali su isključeni.\n"

#: tp/texi2any.pl:929
msgid ""
"Examples:\n"
"  makeinfo foo.texi                      write Info to foo's @setfilename\n"
"  makeinfo --html foo.texi               write HTML to @setfilename\n"
"  makeinfo --xml foo.texi                write Texinfo XML to @setfilename\n"
"  makeinfo --docbook foo.texi            write Docbook XML to @setfilename\n"
"  makeinfo --plaintext foo.texi          write plain text to standard "
"output\n"
"  makeinfo --pdf foo.texi                write PDF using texi2dvi\n"
"\n"
"  makeinfo --html --no-headers foo.texi  write html without node lines, "
"menus\n"
"  makeinfo --number-sections foo.texi    write Info with numbered sections\n"
"  makeinfo --no-split foo.texi           write one Info file however big\n"
msgstr ""
"Primjeri:\n"
"  makeinfo foo.texi piše Info u foo-ov @setfilename\n"
"  makeinfo --html foo.texi piše HTML u @setfilename\n"
"  makeinfo --xml foo.texi piše Texinfo XML u @setfilename\n"
"  makeinfo --docbook foo.texi piše Dockbook XML u @setfilename\n"
"  makeinfo --plaintext foo.texi piše obični tekst na standardni izlaz\n"
"  makeinfo --pdf foo.texi piše pdf koristeći texi2dvi\n"
"  makeinfo --html --no-headers foo.texi piše html bez čvornih linija, "
"menija\n"
"  makeinfo --number-sections foo.texi piše Info sa numerisanim dijelovima.\n"
"  makeinfo --no-split foo.texi piše jednu Info datoteku koliko god je "
"velika\n"

