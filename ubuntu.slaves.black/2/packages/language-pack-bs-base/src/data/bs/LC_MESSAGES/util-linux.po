msgid " %s [options] [<device>|<mountpoint>]\n"
msgstr " %s [opcije] [<uređaj>|<tačka montiranja>]\n"

#: sys-utils/eject.c:143
msgid "Eject removable media.\n"
msgstr "Izbaci otklonjive uređaje\n"

#: sys-utils/eject.c:146
msgid ""
" -a, --auto <on|off>         turn auto-eject feature on or off\n"
" -c, --changerslot <slot>    switch discs on a CD-ROM changer\n"
" -d, --default               display default device\n"
" -f, --floppy                eject floppy\n"
" -F, --force                 don't care about device type\n"
" -i, --manualeject <on|off>  toggle manual eject protection on/off\n"
" -m, --no-unmount            do not unmount device even if it is mounted\n"
" -M, --no-partitions-unmount do not unmount another partitions\n"
" -n, --noop                  don't eject, just show device found\n"
" -p, --proc                  use /proc/mounts instead of /etc/mtab\n"
" -q, --tape                  eject tape\n"
" -r, --cdrom                 eject CD-ROM\n"
" -s, --scsi                  eject SCSI device\n"
" -t, --trayclose             close tray\n"
" -T, --traytoggle            toggle tray\n"
" -v, --verbose               enable verbose output\n"
" -x, --cdspeed <speed>       set CD-ROM max speed\n"
" -X, --listspeed             list CD-ROM available speeds\n"
msgstr ""
" -a, --auto <on|off> postavite svojstvo automatskog izbacivanja on ili off\n"
"-c, --changerslot<slot>  prebaci diskove na CD-ROM mjenjač\n"
"-d, --default  prikaži zadani uređaj\n"
"-f, --floppy  izbaci disketu\n"
"-F, --force ne obraćaj pažnju na tip uređaja\n"
"-i, --manualeject <on|off> prebaci zaštitu manuelnog izbacivanja na on ili "
"off\n"
"-m, -no-unmount nemoj demontirati uređaj čak i ako je montiran\n"
"-M, --no-parittions-unmount ne demontirati druge particije\n"
"-n, --noop ne izbacuj, samo pokaži pronađeni uređaj\n"
"-p, --proc  koristiti  /proc/mounts umjesto /etc/mtab\n"
"-q, --tape traka za izbacivanje\n"
"-r, -cdrom izbaci CD-ROM\n"
"-s, --scsi izbacii SCSI uređaj \n"
"-t, --trayclose zatvoriti poslužavnik\n"
"-v, --verbose omogući preopširan izlaz\n"
"-x, --cdspeed <speed> postavi CD-ROM brzinu na maksimalnu\n"
"-X, --listspeed prikaži CD-ROM dostupne brzine\n"

