#: disk-utils/cfdisk.c:2252
msgid "This is cfdisk, a curses-based disk partitioning program."
msgstr "Ovo je cfdisk, disk za podjelu programa baziran na pokazivačima."

#: disk-utils/cfdisk.c:2253
msgid "It lets you create, delete, and modify partitions on a block device."
msgstr "Dopušta ti da kreiraš, brišeš, i mijenjaš particije na blok uređaju."

#: disk-utils/cfdisk.c:2255
msgid "Command      Meaning"
msgstr "Komanda      Značenje"

#: disk-utils/cfdisk.c:2256
msgid "-------      -------"
msgstr "-------      -------"

#: disk-utils/cfdisk.c:2257
msgid "  b          Toggle bootable flag of the current partition"
msgstr "  b          Menjaj but indikator za tekuću particiju"

#: disk-utils/cfdisk.c:2258
msgid "  d          Delete the current partition"
msgstr "  d          Obriši tekuću particiju"

#: disk-utils/cfdisk.c:2259
msgid "  h          Print this screen"
msgstr "  h          Štampaj ovaj ekran"

#: disk-utils/cfdisk.c:2260
msgid "  n          Create new partition from free space"
msgstr "  n          Napravi novu particiju od slobodnog prostora"

#: disk-utils/cfdisk.c:2261
msgid "  q          Quit program without writing partition table"
msgstr "  q          Izlazi iz programa bez pisanja tabele particija"

#: disk-utils/cfdisk.c:2262
msgid "  r          Reduce or enlarge the current partition"
msgstr ""

#: disk-utils/cfdisk.c:2263
msgid "  s          Fix partitions order (only when in disarray)"
msgstr "  s Fix particija red (samo kada je u rasulu)"

#: disk-utils/cfdisk.c:2264
msgid "  t          Change the partition type"
msgstr "  t Promijeni tip particije"

#: disk-utils/cfdisk.c:2265
msgid "  u          Dump disk layout to sfdisk compatible script file"
msgstr "  u Prebaci raspored diska u sfdisk kompatibilnu skriptnu datoteku"

#: disk-utils/cfdisk.c:2266
msgid ""
"  W          Write partition table to disk (you must enter uppercase W);"
msgstr "  W ispisuje tabelu particija na disk (morate unijeti veliko W);"

#: disk-utils/cfdisk.c:2267
msgid ""
"               since this might destroy data on the disk, you must either"
msgstr "               pošto ovo može uništiti podatke na disku, morate ili"

#: disk-utils/cfdisk.c:2268
msgid "               confirm or deny the write by entering 'yes' or 'no'"
msgstr ""
"               potvrditi ili odbiti umanjenje upisujući 'da' ili 'ne'"

#: disk-utils/cfdisk.c:2269
msgid "  x          Display/hide extra information about a partition"
msgstr "  x Prikazuje/sakriva dodatne informacije o particiji"

#: disk-utils/cfdisk.c:2270
msgid "Up Arrow     Move cursor to the previous partition"
msgstr "Strelica gore     Pomera kursor na prethodnu particiju"

#: disk-utils/cfdisk.c:2271
msgid "Down Arrow   Move cursor to the next partition"
msgstr "Strelica dole     Pomera kursor na sljedeću particiju"

#: disk-utils/cfdisk.c:2272
msgid "Left Arrow   Move cursor to the previous menu item"
msgstr "Lijeva Strelica Pomakni kursor na predhodni elemenat izbornika"

#: disk-utils/cfdisk.c:2273
msgid "Right Arrow  Move cursor to the next menu item"
msgstr "Desna Strelica Pomakni kursor na idući elemenat izbornika"

#: disk-utils/cfdisk.c:2275
msgid "Note: All of the commands can be entered with either upper or lower"
msgstr "Napomena: Kod svih komandi nije bitna veličina"

#: disk-utils/cfdisk.c:2276
msgid "case letters (except for Write)."
msgstr "slova osjetljiva na veličinu (osim za Write)"

#: disk-utils/cfdisk.c:2278
msgid "Use lsblk(8) or partx(8) to see more details about the device."
msgstr ""
"Koristite lsblk(8) ili partx(8) da bi vidjeli više detalja o uređaju."

#: disk-utils/cfdisk.c:2288 disk-utils/cfdisk.c:2591
msgid "Press a key to continue."
msgstr "Pritisnite tipku za nastavak."

#: disk-utils/cfdisk.c:2374
msgid "Could not toggle the flag."
msgstr "Nije moguće promijeniti stanje oznake."

#: disk-utils/cfdisk.c:2384
#, c-format
