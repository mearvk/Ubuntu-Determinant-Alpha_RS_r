#: sys-utils/prlimit.c:179
msgid ""
" -c, --core             maximum size of core files created\n"
" -d, --data             maximum size of a process's data segment\n"
" -e, --nice             maximum nice priority allowed to raise\n"
" -f, --fsize            maximum size of files written by the process\n"
" -i, --sigpending       maximum number of pending signals\n"
" -l, --memlock          maximum size a process may lock into memory\n"
" -m, --rss              maximum resident set size\n"
" -n, --nofile           maximum number of open files\n"
" -q, --msgqueue         maximum bytes in POSIX message queues\n"
" -r, --rtprio           maximum real-time scheduling priority\n"
" -s, --stack            maximum stack size\n"
" -t, --cpu              maximum amount of CPU time in seconds\n"
" -u, --nproc            maximum number of user processes\n"
" -v, --as               size of virtual memory\n"
" -x, --locks            maximum number of file locks\n"
" -y, --rttime           CPU time in microseconds a process scheduled\n"
"                        under real-time scheduling\n"
msgstr ""
" -c, --core maksimalne veličine jezgrenih datoteka kreirana\n"
"-d, --data maksimalna segmenta podataka procesa\n"
"-e, --nice dozvoljen rast za maksimalan nice prioritet \n"
"-f, --fsize maksimalna veličina datoteke napisana od strane procesa\n"
"-i, --sigpending maksimalan broj čekajućih signala\n"
"-l, --memlock  maksimalna  veličina koju proces može zaključati u memoriju\n"
"-m, --rss  maksimalni rezident postavi veličinu\n"
"-n, --nofile  maksimalan broj otvorenih datoteka\n"
"-q, --msgqueue maksimalno bajtova u POSIX redovima poruka\n"
"-r, --rtprio  maksimalan prioritet raspoređivanja u realnom vremenu\n"
"-s, --stack maksimalna  stack veličina\n"
"-t, --cpu maksimalni iznos CPU vremena u sekundama\n"
"-u, --nproc maksimalni broj korisničkih procesa\n"
"-v, --as veličina virtuelne memorije\n"
"-x, --locks maksimalan broj brava datoteke\n"
"-y, --rttime CPU  vrijeme u  mikrosekundi procesu zakazano\n"
"                        pod rasporedom u realnom vremenu\n"

