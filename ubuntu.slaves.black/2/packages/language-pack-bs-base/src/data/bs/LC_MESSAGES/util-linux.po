" -g, --show-geometry [<dev> ...]   list geometry of all or specified "
"devices\n"
msgstr ""
" -g, --show-geometry [<dev> ...]   prikaži geometriju svih ili specifiranih "
"uređaja\n"

#: disk-utils/sfdisk.c:2025
msgid " -l, --list [<dev> ...]            list partitions of each device\n"
msgstr " -l, --lisr [<dev> ...] nabraja particije svakog uređaja\n"

#: disk-utils/sfdisk.c:2026
msgid ""
" -F, --list-free [<dev> ...]       list unpartitioned free areas of each "
"device\n"
msgstr ""
" -F, --list-free [<dev>...] lista slobodnih polja bez particija od svakog "
"uređaja\n"

#: disk-utils/sfdisk.c:2027
msgid ""
" -r, --reorder <dev>               fix partitions order (by start offset)\n"
msgstr " -r, --reorder <dev> popravite redoslijed particija (od ofseta)\n"

#: disk-utils/sfdisk.c:2028
msgid ""
" -s, --show-size [<dev> ...]       list sizes of all or specified devices\n"
msgstr ""
" -s, --show-size [<dev> ...] nabraja veličine svih ili određenih uređaja\n"

#: disk-utils/sfdisk.c:2029
msgid ""
" -T, --list-types                  print the recognized types (see -X)\n"
msgstr " -T, --list-types printa tipove koje je prepoznao (vidi -X)\n"

#: disk-utils/sfdisk.c:2030
msgid ""
" -V, --verify [<dev> ...]          test whether partitions seem correct\n"
msgstr " -V, --verify [<dev> ...] testira da li particija djeluje ispravno\n"

#: disk-utils/sfdisk.c:2031
msgid ""
"     --delete <dev> [<part> ...]   delete all or specified partitions\n"
msgstr ""
"     --delete <dev> [<part> ...] izbrišite sve ili specifirane particije\n"

#: disk-utils/sfdisk.c:2034
msgid " --part-label <dev> <part> [<str>] print or change partition label\n"
msgstr ""
" --part-label <dev> <part> [<str>] printa ili mijenja oznaku particije\n"

#: disk-utils/sfdisk.c:2035
msgid " --part-type <dev> <part> [<type>] print or change partition type\n"
msgstr ""
" --part-type <dev> <part> [<type>] printa ili mijenja tip particije\n"

#: disk-utils/sfdisk.c:2036
msgid " --part-uuid <dev> <part> [<uuid>] print or change partition uuid\n"
msgstr ""
" --part-uuid <dev> <part> [<uuid>] ispišite ili promjenite univerzalni "
"jedinstveni identifikator particije\n"

#: disk-utils/sfdisk.c:2037
msgid ""
" --part-attrs <dev> <part> [<str>] print or change partition attributes\n"
msgstr ""
" --part-attrs <dev> <part> [<str>] printa ili mijenja karakteristike "
"particije\n"

#: disk-utils/sfdisk.c:2040
msgid ""
" --disk-id <dev> [<str>]           print or change disk label ID (UUID)\n"
msgstr ""

#: disk-utils/sfdisk.c:2041
msgid " --relocate <oper> <dev>           move partition header\n"
msgstr ""

#: disk-utils/sfdisk.c:2044
msgid " <dev>                     device (usually disk) path\n"
msgstr " <dev> put uređaja (obično diskete)\n"

#: disk-utils/sfdisk.c:2045
msgid " <part>                    partition number\n"
msgstr " <part> broj particije\n"

#: disk-utils/sfdisk.c:2046
msgid ""
" <type>                    partition type, GUID for GPT, hex for MBR\n"
msgstr " <type> tip particije, GUID za GPT, hex za MBR\n"

#: disk-utils/sfdisk.c:2049
msgid ""
" -a, --append              append partitions to existing partition table\n"
msgstr " -a, --append dodaj particije u postojeću particijsku tabelu\n"

#: disk-utils/sfdisk.c:2050
msgid " -b, --backup              backup partition table sectors (see -O)\n"
msgstr " -b, --backup rezervna tabela sektora particije (pogledaj -O)\n"

#: disk-utils/sfdisk.c:2051
msgid ""
"     --bytes               print SIZE in bytes rather than in human readable "
"format\n"
msgstr ""
"     --bytes printa SIZE u bajtima radije nego u formatu čitljivom čovjeku\n"

#: disk-utils/sfdisk.c:2052
msgid ""
"     --move-data[=<typescript>] move partition data after relocation "
"(requires -N)\n"
msgstr ""
"     --move-data[=<typescript>] pomjerite podatke particije nakon relokacije "
"(zahtjeva -N)\n"

#: disk-utils/sfdisk.c:2053
msgid ""
"     --move-use-fsync      use fsync after each write when move data\n"
msgstr ""

#: disk-utils/sfdisk.c:2054
msgid " -f, --force               disable all consistency checking\n"
msgstr " -f, --force onemogući sve provjere dosljednosti\n"

#: disk-utils/sfdisk.c:2057
#, c-format
msgid "     --color[=<when>]      colorize output (%s, %s or %s)\n"
msgstr ""

#: disk-utils/sfdisk.c:2062
msgid " -N, --partno <num>        specify partition number\n"
msgstr " -N, --partno <num> odredi broj particije\n"

#: disk-utils/sfdisk.c:2063
msgid " -n, --no-act              do everything except write to device\n"
msgstr " -n, --no-act uradi sve osim ispisa na uređaj\n"

#: disk-utils/sfdisk.c:2064
msgid ""
"     --no-reread           do not check whether the device is in use\n"
msgstr "     --no-reread ne provjeravaj da li je uređaj u upotrebi\n"

#: disk-utils/sfdisk.c:2065
msgid "     --no-tell-kernel      do not tell kernel about changes\n"
msgstr "     --no-tell-kernel nemojte reći kernelu u vezi promjena\n"

#: disk-utils/sfdisk.c:2066
msgid " -O, --backup-file <path>  override default backup file name\n"
msgstr ""
" -O, --backup-file <path> promjenite osnovni (prvi) naziv rezervne datoteke\n"

#: disk-utils/sfdisk.c:2067
msgid " -o, --output <list>       output columns\n"
msgstr " -o, --output <list> izlazne kolone\n"

#: disk-utils/sfdisk.c:2068
msgid " -q, --quiet               suppress extra info messages\n"
msgstr " -q, --quiet zabrani dodatne informativne poruke\n"

#: disk-utils/sfdisk.c:2070
#, c-format
msgid " -w, --wipe <mode>         wipe signatures (%s, %s or %s)\n"
msgstr ""

#: disk-utils/sfdisk.c:2073
msgid " -X, --label <name>        specify label type (dos, gpt, ...)\n"
msgstr " -X, --label <name> odredi tip (dos, gpt, ...)\n"

#: disk-utils/sfdisk.c:2074
msgid " -Y, --label-nested <name> specify nested label type (dos, bsd)\n"
msgstr ""
" -Y, --label-nested <name> specifirajte grupisani tip labele (dos, bsd)\n"

#: disk-utils/sfdisk.c:2076
msgid " -G, --show-pt-geometry    deprecated, alias to --show-geometry\n"
msgstr " -G, --show-pt-geometry zastarjela, lažni naziv za --show-geometry\n"

#: disk-utils/sfdisk.c:2077
msgid ""
" -L, --Linux               deprecated, only for backward compatibility\n"
msgstr " -L, --Linux zastarjela, samo za kompatibilnost unazad\n"

