msgstr ""
"Sistem datoteka može promijeniti veličinu samo na ovu vrijednost "
"pretvaranjem u FAT16."

#: libparted/fs/r/fat/resize.c:557
msgid ""
"The file system can only be resized to this size by converting to FAT32."
msgstr ""
"Sistem datoteka može promijeniti veličinu samo na ovu vrijednost "
"pretvaranjem u FAT32."

