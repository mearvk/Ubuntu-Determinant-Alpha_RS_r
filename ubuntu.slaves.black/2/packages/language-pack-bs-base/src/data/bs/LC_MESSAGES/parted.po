"Sistem datoteka ima pogrešnu veličinu sektora za FAT sistem datoteka."

#: libparted/fs/fat/bootsector.c:65 libparted/fs/r/fat/bootsector.c:64
msgid "File system has an invalid cluster size for a FAT file system."
msgstr "Sistem datoteka ima pogrešan klaster za FAT sistem datoteka."

#: libparted/fs/fat/bootsector.c:72 libparted/fs/r/fat/bootsector.c:71
msgid ""
"File system has an invalid number of reserved sectors for a FAT file system."
msgstr ""
"Sistem datoteka ima pogrešan broj rezervisanih sektora za FAT sistem "
"datoteka."

#: libparted/fs/fat/bootsector.c:79 libparted/fs/r/fat/bootsector.c:78
msgid "File system has an invalid number of FATs."
msgstr "Sistem datoteka ima pogrešan broj FAT-ova."

#: libparted/fs/fat/bootsector.c:162
#, c-format
msgid ""
"The file system's CHS geometry is (%d, %d, %d), which is invalid.  The "
"partition table's CHS geometry is (%d, %d, %d)."
msgstr ""
"Geometrija CHS datoteka sistema  je (%d, %d, %d), ona je pogrešna.  "
"Geometrija CHS tabele particija je (%d, %d, %d)."

#: libparted/fs/fat/bootsector.c:197 libparted/fs/r/fat/bootsector.c:194
msgid "FAT boot sector says logical sector size is 0.  This is weird. "
msgstr "FAT but sektor kaže da je sektor veličine 0.  Ovo je čudno. "

