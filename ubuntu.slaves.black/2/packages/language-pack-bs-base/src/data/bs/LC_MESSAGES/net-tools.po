#, c-format
msgid "        -s, --set                set a new ARP entry\n"
msgstr "        -s, --set               zadaje novi ARP unos\n"

#: ../arp.c:634
#, c-format
msgid "        -d, --delete             delete a specified entry\n"
msgstr "        -d, --delete             briše dotičan unos\n"

