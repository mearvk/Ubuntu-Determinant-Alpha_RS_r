msgstr " Prikaži informacije o sadržaju datoteka ELF formata\n"

#: readelf.c:5023
#, c-format
msgid " Options are:\n"
msgstr ""

#: readelf.c:5024
#, c-format
msgid "  -a --all               Equivalent to: -h -l -S -s -r -d -V -A -I\n"
