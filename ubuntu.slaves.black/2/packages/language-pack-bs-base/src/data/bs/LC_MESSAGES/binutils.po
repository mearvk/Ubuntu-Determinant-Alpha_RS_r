#: ar.c:295
#, c-format
msgid ""
"Usage: %s [emulation options] [-]{dmpqrstx}[abcDfilMNoOPsSTuvV] [member-"
"name] [count] archive-file file...\n"
msgstr ""

#: ar.c:303
#, c-format
msgid "       %s -M [<mri-script]\n"
msgstr "       %s -M [<mri-script]\n"

#: ar.c:304
#, c-format
msgid " commands:\n"
msgstr " komande:\n"

#: ar.c:305
#, c-format
msgid "  d            - delete file(s) from the archive\n"
msgstr "  d - obriši datoteku/e iz arhive\n"

#: ar.c:306
#, c-format
msgid "  m[ab]        - move file(s) in the archive\n"
msgstr "  m[ab] - premjesti datoteku(e) u arhivi\n"

#: ar.c:307
#, c-format
msgid "  p            - print file(s) found in the archive\n"
msgstr "  p  -štampaj datoteke nađene u arhivi\n"

#: ar.c:308
#, c-format
msgid "  q[f]         - quick append file(s) to the archive\n"
msgstr "  q[f] - brzo dodaj datoteke u arhivu\n"

#: ar.c:309
#, c-format
msgid ""
"  r[ab][f][u]  - replace existing or insert new file(s) into the archive\n"
msgstr ""
"  r[ab][f][u]  - zamjeni postojeću/e ili dodaj novu/e datoteku/e u arhivu\n"

#: ar.c:310
#, c-format
msgid "  s            - act as ranlib\n"
msgstr "  s  - ponaša se kao ranlib\n"

#: ar.c:311
#, c-format
msgid "  t[O][v]      - display contents of the archive\n"
msgstr ""

#: ar.c:312
#, c-format
msgid "  x[o]         - extract file(s) from the archive\n"
msgstr "  x[o] - raspakuj datoteku/e iz arhive\n"

#: ar.c:313
#, c-format
msgid " command specific modifiers:\n"
msgstr " modifikatori specifični za komande:\n"

#: ar.c:314
#, c-format
msgid "  [a]          - put file(s) after [member-name]\n"
msgstr "  [a] - stavi datoteku/e poslije [member-name]\n"

#: ar.c:315
#, c-format
msgid "  [b]          - put file(s) before [member-name] (same as [i])\n"
msgstr "  [b] - stavi datoteke prije [member-name] (isto kao [i])\n"

#: ar.c:318
#, c-format
msgid "  [D]          - use zero for timestamps and uids/gids (default)\n"
msgstr "  [D] - upotrijebi nulu za vremenske oznake i uids / gids (zadano)\n"

#: ar.c:320
#, c-format
msgid "  [U]          - use actual timestamps and uids/gids\n"
msgstr "  [U] - upotrijebi stvarne vremenske oznake i uids / gids\n"

#: ar.c:325
#, c-format
msgid "  [D]          - use zero for timestamps and uids/gids\n"
msgstr "  [D] - use zero for timestamps and uids/gids\n"

#: ar.c:327
#, c-format
msgid "  [U]          - use actual timestamps and uids/gids (default)\n"
msgstr "  [U] - upotrijebi stvarne vremenske oznake i uids / gids (zadano)\n"

#: ar.c:330
#, c-format
msgid "  [N]          - use instance [count] of name\n"
msgstr "  [N] - upotrijebi instancu [broj] imena\n"

#: ar.c:331
#, c-format
msgid "  [f]          - truncate inserted file names\n"
msgstr "  [f] - skrati unijeta imena datoteka\n"

#: ar.c:332
#, c-format
msgid "  [P]          - use full path names when matching\n"
msgstr "  [P]          - „sti kompletne putanje za upoređivanje\n"

#: ar.c:333
#, c-format
msgid "  [o]          - preserve original dates\n"
msgstr "  [o] - očuvaj originalne datume\n"

#: ar.c:334
#, c-format
msgid "  [O]          - display offsets of files in the archive\n"
msgstr ""

#: ar.c:335
#, c-format
msgid ""
"  [u]          - only replace files that are newer than current archive "
"contents\n"
msgstr "  [u]- zamjeni samo datoteke novije od trenutnog sadržaja arhive\n"

#: ar.c:336
#, c-format
msgid " generic modifiers:\n"
msgstr " generički modifikatori:\n"

#: ar.c:337
#, c-format
msgid "  [c]          - do not warn if the library had to be created\n"
msgstr "  [c] - ne upozoravaj ako biblioteka treba da se kreira\n"

#: ar.c:338
#, c-format
msgid "  [s]          - create an archive index (cf. ranlib)\n"
msgstr "  [s] - napravi indeks arhive (cf. ranlib)\n"

#: ar.c:339
#, c-format
msgid "  [l <text> ]  - specify the dependencies of this library\n"
msgstr ""

#: ar.c:340
#, c-format
msgid "  [S]          - do not build a symbol table\n"
msgstr "  [S] - nemoj praviti tabelu simbola\n"

#: ar.c:341
#, c-format
msgid "  [T]          - deprecated, use --thin instead\n"
msgstr ""

#: ar.c:342
#, c-format
msgid "  [v]          - be verbose\n"
msgstr "  [v] - budi verbalan\n"

#: ar.c:343
#, c-format
msgid "  [V]          - display the version number\n"
msgstr "  [V] - prikaži broj verzije\n"

#: ar.c:344
#, c-format
msgid "  @<file>      - read options from <file>\n"
msgstr "  @<file> - učitaj opcije iz datoteke <file>\n"

#: ar.c:345
#, c-format
msgid "  --target=BFDNAME - specify the target object format as BFDNAME\n"
msgstr "  --target=BFDNAME - odredi ciljani format objekta kao BFDNAME\n"

#: ar.c:346
#, c-format
msgid ""
"  --output=DIRNAME - specify the output directory for extraction operations\n"
msgstr ""

#: ar.c:347
#, c-format
msgid ""
"  --record-libdeps=<text> - specify the dependencies of this library\n"
msgstr ""

#: ar.c:348
#, c-format
msgid "  --thin       - make a thin archive\n"
msgstr ""

#: ar.c:350
#, c-format
msgid " optional:\n"
msgstr " neobavezan:\n"

#: ar.c:351
#, c-format
msgid "  --plugin <p> - load the specified plugin\n"
msgstr "  --plugin <p> - učitaj specifični dodatak\n"

