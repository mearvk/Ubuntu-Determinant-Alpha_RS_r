msgstr ""

#: readelf.c:5058
#, c-format
msgid ""
"     --no-demangle       Do not demangle low-level symbol names.  (default)\n"
msgstr ""

#: readelf.c:5060
#, c-format
msgid ""
"     --recurse-limit     Enable a demangling recursion limit.  (default)\n"
msgstr ""

#: readelf.c:5062
#, c-format
