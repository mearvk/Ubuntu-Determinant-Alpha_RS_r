msgstr "Postavite da potvrdite potencijalno opasne operacije."

#: top.c:2317
msgid "Show whether to confirm potentially dangerous operations."
msgstr "Pokaži da li da se potvrdi potencijalno opasna operacija."

#: top.c:2323
msgid "Set annotation_level."
msgstr "Postavi annotation_level."

#: top.c:2324
msgid "Show annotation_level."
msgstr "Pokaži annotation_level."

#: top.c:2325
msgid ""
"0 == normal;     1 == fullname (for use when running under emacs)\n"
"2 == output annotated suitably for use by programs that control GDB."
msgstr ""
"0 == normalno; 1 == puno ime (za korištenje kada se pokreće pod emacs)\n"
"2 == izlaz bilježen na odgovarajući način za korištenje od strane programa "
"koji kontrolišu GDB."

#: top.c:2333
