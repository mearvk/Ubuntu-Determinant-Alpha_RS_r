#: aarch64-nat.c:286 mips-linux-nat.c:791 x86-nat.c:222
msgid ""
"Use \"on\" to enable, \"off\" to disable.\n"
"If enabled, the debug registers values are shown when GDB inserts\n"
"or removes a hardware breakpoint or watchpoint, and when the inferior\n"
"triggers a breakpoint or watchpoint."
msgstr ""
"Koristi \"\"uključeno\" za omogućavanje, \"isključeno\" za onemogućavanje.\n"
"Ako je omogućeno, vrijednost debug spremnika je prikazan kada GDB umeće\n"
"ili izbacuje hardverski breakpoint ili watchpoint i kada slabiji\n"
"okine breakpoint ili watchpoint."

