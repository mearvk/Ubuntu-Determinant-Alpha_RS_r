#: scripts/dpkg-genchanges.pl
msgid ""
"Options:\n"
"  --build=<type>[,...]     specify the build <type>: full, source, binary,\n"
"                             any, all (default is 'full').\n"
"  -g                       source and arch-indep build.\n"
"  -G                       source and arch-specific build.\n"
"  -b                       binary-only, no source files.\n"
"  -B                       binary-only, only arch-specific files.\n"
"  -A                       binary-only, only arch-indep files.\n"
"  -S                       source-only, no binary files.\n"
"  -c<control-file>         get control info from this file.\n"
"  -l<changelog-file>       get per-version info from this file.\n"
"  -f<files-list-file>      get .deb files list from this file.\n"
"  -v<since-version>        include all changes later than version.\n"
"  -C<changes-description>  use change description from this file.\n"
"  -m<maintainer>           override control's maintainer value.\n"
"  -e<maintainer>           override changelog's maintainer value.\n"
"  -u<upload-files-dir>     directory with files (default is '..').\n"
"  -si                      source includes orig, if new upstream (default).\n"
"  -sa                      source includes orig, always.\n"
"  -sd                      source is diff and .dsc only.\n"
"  -q                       quiet - no informational messages on stderr.\n"
"  -F<changelog-format>     force changelog format.\n"
"  -V<name>=<value>         set a substitution variable.\n"
"  -T<substvars-file>       read variables here, not debian/substvars.\n"
"  -D<field>=<value>        override or add a field and value.\n"
"  -U<field>                remove a field.\n"
"  -O[<filename>]           write to stdout (default) or <filename>.\n"
"  -?, --help               show this help message.\n"
"      --version            show the version.\n"
msgstr ""
"Opcije:\n"
"  --build=<type>[,...]      specifišite gradnju <type>: puni, izvorni, "
"binarni, \n"
"                             bilo koji, svi (zadano je 'puni').\n"
"  -g                       izvorna i arch-indep gradnja.\n"
"  -G                       izvorna i arch-specific gradnja.\n"
"  -b                       samo binarna, bez izvornih datoteka.\n"
"  -B                       samo binarna, samo arch-specific datoteke.\n"
"  -A                       samo binarna, samo arch-indep datoteke.\n"
"  -S                       samo izvorne, bez binarnih datoteka.\n"
"  -c<control-file>         dobij kontrolne informacije sa ove datoteke.\n"
"  -l<changelog-file>       dobij informacije po verziji sa ove datoteke.\n"
"  -f<files-list-file>      dobij .deb liste datoteka sa ove datoteke.\n"
"  -v<since-version>         uključi sve promijene poslije verzije.\n"
"  -C<changes-description>   koristi promjenu opisa sa ove datoteke.\n"
"  -m<maintainer>            obori vrijednost upraviteljskog održavatelja.\n"
"  -e<maintainer>           obori vrijednosti changelog održavatelja.\n"
"  -u<upload-files-dir>      direktorij sa datotekama (zadano je '..').\n"
"  -si                       izvor uključuje orig, ako je novi uzvodno "
"(zadano).\n"
"  -sa                      izvor uključuje orig, uvijek.\n"
"  -sd                      izvor je samo diff i .dsc.\n"
"  -q                       tiho - bez informacijskih poruka na stderr.\n"
"  -F<changelog-format>     prisili changelog format.\n"
"  -V<name>=<value>         postavi zamjensku varijablu.\n"
"  -T<substvars-file>        čitaj varijable ovdje, ne u debian/substvars.\n"
"  -D<field>=<value>         obori ili dodaj polje i vrijednost.\n"
"  -U<field>                 ukloni polje.\n"
"  -O[<filename>]           piši na stdout (zadano) ili <filename>.\n"
"  -?, --help                prikaži ovu poruku pomoći.\n"
"      --version             prikaži verziju.\n"

