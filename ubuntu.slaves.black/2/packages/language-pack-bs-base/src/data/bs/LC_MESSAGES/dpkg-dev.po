#: scripts/dpkg-genbuildinfo.pl
msgid ""
"Options:\n"
"  --build=<type>[,...]     specify the build <type>: full, source, binary,\n"
"                             any, all (default is 'full').\n"
"  -c<control-file>         get control info from this file.\n"
"  -l<changelog-file>       get per-version info from this file.\n"
"  -f<files-list-file>      get .deb files list from this file.\n"
"  -F<changelog-format>     force changelog format.\n"
"  -O[<buildinfo-file>]     write to stdout (or <buildinfo-file>).\n"
"  -u<upload-files-dir>     directory with files (default is '..').\n"
"  --always-include-kernel  always include Build-Kernel-Version.\n"
"  --always-include-path    always include Build-Path.\n"
"  --admindir=<directory>   change the administrative directory.\n"
"  -?, --help               show this help message.\n"
"      --version            show the version.\n"
msgstr ""
"Opcije:\n"
"  --build=<type>[,...]     specifiši gradnju <type>: puni, izvorni, "
"binarni,\n"
"                             bilo koji, svi (zadano je 'svi').\n"
"  -c<control-file>         dobij informaciju kontrole sa ove datoteke.\n"
"  -l<changelog-file>       dobij informacije po verziji sa ove datoteke.\n"
"  -f<files-list-file>      dobij listu .deb dateoteka sa ove datoteke.\n"
"  -F<changelog-format>     prisili podmetnuti format.\n"
"  -O[<buildinfo-file>]     ispiši na stdout (ili <buildinfo-file>).\n"
"  -u<upload-files-dir>     direktorij sa datotekama (zadano je '..').\n"
"  --always-include-kernel  uvijek uključi Build-Kernel-Version.\n"
"  --always-include-path    uvijek uključi Build-Path.\n"
"  --admindir=<directory>   promijeni administrativni direktorij.\n"
"  -?, --help               prikaži ovu poruku pomoći.\n"
"      --version            prikaži verziju.\n"

