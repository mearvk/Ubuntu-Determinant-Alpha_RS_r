#: client/as-compose.c:431
msgid "Error parsing translations"
msgstr "Greška pri obradi prevoda"

#. TRANSLATORS: we could not auto-add the kudo
#: client/as-compose.c:442
msgid "Error parsing kudos"
msgstr "Greška pri obradi kudoa"

#. TRANSLATORS: we could not auto-add the provides
#: client/as-compose.c:453
msgid "Error parsing provides"
msgstr "Greška pri obradi nabavki"

#. TRANSLATORS: the .desktop file could not
#. * be loaded
#: client/as-compose.c:469
msgid "Error loading desktop file"
msgstr "Greška pri učitavanju desktop datoteke"

