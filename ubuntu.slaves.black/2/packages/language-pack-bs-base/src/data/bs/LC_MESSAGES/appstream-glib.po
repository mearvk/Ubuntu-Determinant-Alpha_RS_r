#. * not be created
#: client/as-compose.c:482
msgid "Error creating output directory"
msgstr "Greška pri kreiranju izlaznog direktorija"

#. TRANSLATORS: we've saving the XML file to disk
#: client/as-compose.c:491
msgid "Saving AppStream"
msgstr "Snimam AppStream"

#. TRANSLATORS: this is when the destination file
#. * cannot be saved for some reason
#: client/as-compose.c:501
msgid "Error saving AppStream file"
msgstr "Greška pri snimanju AppStream datoteke"

#. TRANSLATORS: this is a command alias
#: client/as-util.c:104
#, c-format
msgid "Alias to %s"
msgstr "Drugo ime za %s"

#: client/as-util.c:186
msgid "Command not found, valid commands are:"
msgstr "Naredba nije nađena, valjane naredbe su:"

