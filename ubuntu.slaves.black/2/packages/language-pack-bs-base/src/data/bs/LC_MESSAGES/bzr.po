"zahtjevan sa bzrlib.mutabletree.PostCommitHookParams objektom.  Nepostojano "
"stablo inzvšenja je postavljeno na dostupno pomoću mutable_tree attribute "
"tog objekta."

#: en/help_topics/hooks.txt:399
msgid ""
"post_transform\n"
"~~~~~~~~~~~~~~"
msgstr ""
"post_transform\n"
"~~~~~~~~~~~~~~"

