"\n"
"Source hosting provider\n"
"~~~~~~~~~~~~~~~~~~~~~~~"
msgstr ""
"\n"
"Izvor domaćinskog provajdera\n"
"~~~~~~~~~~~~~~~~~~~~~~~"

#: en/help_topics/authentication.txt:168
msgid "In the shp.net (fictitious) domain, each project has its own site::"
msgstr ""
