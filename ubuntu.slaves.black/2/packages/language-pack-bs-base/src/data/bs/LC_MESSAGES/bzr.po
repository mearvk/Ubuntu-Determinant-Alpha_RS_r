"        [hobby]\n"
"        host=r.hobby.net\n"
"        user=jim\n"
"        password=obvious1234\n"
"        \n"
"        # Home server\n"
"        [home]\n"
"        scheme=https\n"
"        host=home.net\n"
"        user=joe\n"
"        password=1essobV10us\n"
"        \n"
"        [DEFAULT]\n"
"        # Our local user is barbaz, on all remote sites we're known as "
"foobar\n"
"        user=foobar"

#: en/help_topics/authentication.txt:164
