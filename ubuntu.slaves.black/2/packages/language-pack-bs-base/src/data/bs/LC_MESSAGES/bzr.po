msgstr "Datoteke"

#: dummy/help_topics/files/detail.txt:3
msgid ""
":On Unix:   ~/.bazaar/bazaar.conf\n"
":On Windows: C:\\\\Documents and Settings\\\\username\\\\Application Data\\\\"
