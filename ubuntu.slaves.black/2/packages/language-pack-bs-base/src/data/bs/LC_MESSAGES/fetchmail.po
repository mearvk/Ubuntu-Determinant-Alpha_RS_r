#: options.c:641
msgid "usage:  fetchmail [options] [server ...]\n"
msgstr "Upotreba: Fetchmail [opcije] [server ...]\n"

#: options.c:642
msgid "  Options are as follows:\n"
msgstr "  Opcije su kao što slijedi:\n"

#: options.c:643
msgid "  -?, --help        display this option help\n"
msgstr "  -?, --help prikazati ovu opciju pomoć\n"

#: options.c:644
msgid "  -V, --version     display version info\n"
msgstr "  -V, --version prikaz verzije info\n"

#: options.c:646
msgid "  -c, --check       check for messages without fetching\n"
msgstr "  -c, --check provjeriti poruke bez dohvaćanja\n"

#: options.c:647
msgid "  -s, --silent      work silently\n"
msgstr "  -a, --silent tiho raditi\n"

#: options.c:648
msgid "  -v, --verbose     work noisily (diagnostic output)\n"
msgstr "  -v, --verbose raditi bučno (dijagnostički izlaz)\n"

#: options.c:649
msgid "  -d, --daemon      run as a daemon once per n seconds\n"
msgstr "  -d, --daemon vođen kao daemon jednom po n sekundi\n"

#: options.c:650
msgid "  -N, --nodetach    don't detach daemon process\n"
msgstr "  -N, --nodetach ne odvaja daemon proces\n"

#: options.c:651
msgid "  -q, --quit        kill daemon process\n"
msgstr "  -q, --quit ubijati daemon proces\n"

