msgstr "  -L, --logfile navedite logfile ime\n"

#: options.c:653
msgid ""
"      --syslog      use syslog(3) for most messages when running as a "
"daemon\n"
msgstr ""
"      --syslog korištenje syslog (3) za većinu poruka kada je pokrenut kao "
"daemon\n"

#: options.c:654
msgid "      --nosyslog    turns off use of syslog(3)\n"
msgstr ""

#: options.c:655
msgid "      --invisible   don't write Received & enable host spoofing\n"
msgstr "      --invisible ne pisati Primljeni i omogućiti podvalu domaćina\n"

#: options.c:656
msgid "  -f, --fetchmailrc specify alternate run control file\n"
msgstr "  -f, --fetchmailrc odrediti zamjensku datoteku kontrolni vođenu\n"

#: options.c:657
