#: src/ps/help.c:98
#, c-format
msgid ""
"\n"
"Usage:\n"
" %s [options]\n"
msgstr ""
"\n"
"Korištenje:\n"
"%s [opcije]\n"

#: src/ps/help.c:103
msgid ""
"\n"
"Basic options:\n"
msgstr ""
"\n"
"Osnovne opcije:\n"

#: src/ps/help.c:104
msgid " -A, -e               all processes\n"
msgstr " -A, -e svi procesi\n"

#: src/ps/help.c:105
msgid " -a                   all with tty, except session leaders\n"
msgstr " -a sve sa tty, osim lidera sesije\n"

#: src/ps/help.c:106
msgid "  a                   all with tty, including other users\n"
msgstr "  a svi sa tty, uključujuči i druge korisnike\n"

#: src/ps/help.c:107
msgid " -d                   all except session leaders\n"
msgstr " -d svi osim lidera sesije\n"

#: src/ps/help.c:108
msgid " -N, --deselect       negate selection\n"
msgstr " -N, --deselect poništi selekciju\n"

#: src/ps/help.c:109
msgid "  r                   only running processes\n"
msgstr "  r samo pokrenuti procesi\n"

#: src/ps/help.c:110
msgid "  T                   all processes on this terminal\n"
msgstr "  T svi procesi na ovom terminalu\n"

#: src/ps/help.c:111
msgid "  x                   processes without controlling ttys\n"
msgstr "  x procesi bez kontrolnih tty-a\n"

#: src/ps/help.c:114
msgid ""
"\n"
"Selection by list:\n"
msgstr ""
"\n"
"Selekcija po listi:\n"

#: src/ps/help.c:115
msgid " -C <command>         command name\n"
msgstr " -C <command> ime komande\n"

#: src/ps/help.c:116
msgid " -G, --Group <GID>    real group id or name\n"
msgstr " -G, --Group <GID> ime ili id realne grupe\n"

#: src/ps/help.c:117
msgid " -g, --group <group>  session or effective group name\n"
msgstr " -g, --group <group> sesija ili efektivno ime grupe\n"

#: src/ps/help.c:118
msgid " -p, p, --pid <PID>   process id\n"
msgstr " -p, p, --pid <PID> id procesa\n"

#: src/ps/help.c:119
msgid "        --ppid <PID>  parent process id\n"
msgstr "        --ppid <PID> id procesa roditelja\n"

#: src/ps/help.c:120
msgid ""
" -q, q, --quick-pid <PID>\n"
"                      process id (quick mode)\n"
msgstr ""
" -q, q, --quick-pid <PID>\n"
"                      id procesa (brzi režim)\n"

#: src/ps/help.c:122
msgid " -s, --sid <session>  session id\n"
msgstr " -s, --sid <session> id sesije\n"

#: src/ps/help.c:123
msgid " -t, t, --tty <tty>   terminal\n"
msgstr " -t, t, --tty <tty> terminal\n"

#: src/ps/help.c:124
msgid " -u, U, --user <UID>  effective user id or name\n"
msgstr " -u, U, --user <UID> efektivni korisnički id ili ime\n"

#: src/ps/help.c:125
msgid " -U, --User <UID>     real user id or name\n"
msgstr " -U, --User <UID> realan korisnički id ili ime\n"

#: src/ps/help.c:126
msgid ""
"\n"
"  The selection options take as their argument either:\n"
"    a comma-separated list e.g. '-u root,nobody' or\n"
"    a blank-separated list e.g. '-p 123 4567'\n"
msgstr ""
"\n"
"  Opcije selekcije uzimaju kao svoj argument ili:\n"
"    zarezom razdvojenu listu npr. '-u root,nobody' ili\n"
"    razmakom razdvojenu listu npr. '-p 123 4567'\n"

#: src/ps/help.c:132
msgid ""
"\n"
"Output formats:\n"
msgstr ""
"\n"
"Formati izlaza:\n"

#: src/ps/help.c:134
msgid " -F                   extra full\n"
msgstr " -F extra pun\n"

#: src/ps/help.c:135
msgid " -f                   full-format, including command lines\n"
msgstr " -f cijeli format, uklučujući i komandne linije\n"

#: src/ps/help.c:136
msgid "  f, --forest         ascii art process tree\n"
msgstr "  f, --forest ascii art stablo procesa\n"

#: src/ps/help.c:137
msgid " -H                   show process hierarchy\n"
msgstr " -H prikaži hijerarhiju procesa\n"

#: src/ps/help.c:138
msgid " -j                   jobs format\n"
msgstr " -j format poslova\n"

#: src/ps/help.c:139
msgid "  j                   BSD job control format\n"
msgstr "  j BSD format kontrole poslova\n"

#: src/ps/help.c:140
msgid " -l                   long format\n"
msgstr " -l dugačak format\n"

#: src/ps/help.c:141
msgid "  l                   BSD long format\n"
msgstr "  l BSD dugački format\n"

#: src/ps/help.c:142
msgid " -M, Z                add security data (for SELinux)\n"
msgstr " -M, Z dodaj sigurnost podataka (za SELinux)\n"

#: src/ps/help.c:143
msgid " -O <format>          preloaded with default columns\n"
msgstr " -O <format> unaprijed-učitano sa zadanim kolonama\n"

#: src/ps/help.c:144
msgid "  O <format>          as -O, with BSD personality\n"
msgstr "  O <format> kao -O, sa BSD karakterom\n"

#: src/ps/help.c:145
msgid ""
" -o, o, --format <format>\n"
"                      user-defined format\n"
msgstr ""
" -o, o, --format <format>\n"
"                      korisnički definisan format\n"

#: src/ps/help.c:148
msgid "  s                   signal format\n"
msgstr "  s format signala\n"

#: src/ps/help.c:149
msgid "  u                   user-oriented format\n"
msgstr "  u korisnički orijentisan format\n"

#: src/ps/help.c:150
msgid "  v                   virtual memory format\n"
msgstr "  v format virtualne memorije\n"

#: src/ps/help.c:151
msgid "  X                   register format\n"
msgstr "  X format registra\n"

#: src/ps/help.c:152
msgid ""
" -y                   do not show flags, show rss vs. addr (used with -l)\n"
msgstr " -y ne prikazuj oznake, prikaži rss naspram addr (korišteno sa -l)\n"

#: src/ps/help.c:153
msgid "     --context        display security context (for SELinux)\n"
msgstr "     --context prikaži sigurnosni kontekst (za SELinux)\n"

#: src/ps/help.c:154
msgid "     --headers        repeat header lines, one per page\n"
msgstr "     --headers ponovi zaglavne linije, jednu po stranici\n"

#: src/ps/help.c:155
msgid "     --no-headers     do not print header at all\n"
msgstr "     --no-headers  uopšte ne prikazuj zaglavlje\n"

#: src/ps/help.c:156
msgid ""
"     --cols, --columns, --width <num>\n"
"                      set screen width\n"
msgstr ""
"     --cols, --columns, --width <num>\n"
"                      postavi širinu zaslona\n"

#: src/ps/help.c:158
msgid ""
"     --rows, --lines <num>\n"
"                      set screen height\n"
msgstr ""
"     --rows, --lines <num>\n"
"                      postavi dužinu ekrana\n"

#: src/ps/help.c:162
msgid ""
"\n"
"Show threads:\n"
msgstr ""
"\n"
"Prikaži niti:\n"

#: src/ps/help.c:163
msgid "  H                   as if they were processes\n"
msgstr "  H kao da su bili procesi\n"

#: src/ps/help.c:164
msgid " -L                   possibly with LWP and NLWP columns\n"
msgstr " -L moguće sa LWP i NLWP kolonama\n"

#: src/ps/help.c:165
msgid " -m, m                after processes\n"
msgstr " -m, m poslije procesa\n"

#: src/ps/help.c:166
msgid " -T                   possibly with SPID column\n"
msgstr " -T moguće sa SPID kolonama\n"

#: src/ps/help.c:169
msgid ""
"\n"
"Miscellaneous options:\n"
msgstr ""
"\n"
"Razne opcije:\n"

#: src/ps/help.c:170
msgid " -c                   show scheduling class with -l option\n"
msgstr " -c prikaži planirane klase sa -l opcijom\n"

#: src/ps/help.c:171
msgid "  c                   show true command name\n"
msgstr "  c prikaži pravo ime komande\n"

#: src/ps/help.c:172
msgid "  e                   show the environment after command\n"
msgstr "  e prikaži okruženje poslije komande\n"

#: src/ps/help.c:173
msgid ""
"  k,    --sort        specify sort order as: [+|-]key[,[+|-]key[,...]]\n"
msgstr ""
"  k, --sort naznači poredak sortiranja kao: [+|-]key[,[+|-]key[,...]]\n"

#: src/ps/help.c:174
msgid "  L                   show format specifiers\n"
msgstr "  L prikaži specifikatore formata\n"

#: src/ps/help.c:175
msgid "  n                   display numeric uid and wchan\n"
msgstr "  n prikaži numerički uid i wchan\n"

#: src/ps/help.c:176
msgid "  S,    --cumulative  include some dead child process data\n"
msgstr "  S, --cumulative ukljuci neke podatke mrtvih dijete-procesa\n"

#: src/ps/help.c:177
msgid " -y                   do not show flags, show rss (only with -l)\n"
msgstr " -y ne prikazuj oznake, prikaži rss (samo sa -l)\n"

#: src/ps/help.c:178
msgid " -V, V, --version     display version information and exit\n"
msgstr " -V, V, --version prikaži informacije o verziji i izađi\n"

#: src/ps/help.c:179
msgid " -w, w                unlimited output width\n"
msgstr " -w, w neograničena širina izlaza\n"

#: src/ps/help.c:180
#, c-format
msgid ""
"\n"
"        --%s <%s|%s|%s|%s|%s|%s>\n"
"                      display help and exit\n"
msgstr ""
"\n"
"        --%s <%s|%s|%s|%s|%s|%s>\n"
"                      prikaži pomoć i izaži\n"

