msgid " -d, --delimiter <string>  specify output delimiter\n"
msgstr " -d, --graničnik <string> odredi izlazni znak ograničenja\n"

#: src/pgrep.c:160
msgid " -l, --list-name           list PID and process name\n"
msgstr " -l, --list-name PID lista i ime procesa\n"

#: src/pgrep.c:161
msgid " -a, --list-full           list PID and full command line\n"
msgstr " -a, --list-full PID lista i puna komandna linija\n"

#: src/pgrep.c:162
msgid " -v, --inverse             negates the matching\n"
msgstr " -v, --inverzni negira podudaranje\n"

#: src/pgrep.c:163
msgid " -w, --lightweight         list all TID\n"
msgstr " -w, --lagani popis svih TID\n"

#: src/pgrep.c:176
msgid " -<sig>, --signal <sig>    signal to send (either number or name)\n"
msgstr " -<sig>, --signal<sig>signal za slanje(bilo broj ili naziv)\n"

#: src/pgrep.c:167
msgid " -q, --queue <value>       integer value to be sent with the signal\n"
msgstr ""

#: src/pgrep.c:168
msgid " -e, --echo                display what is killed\n"
msgstr " -e, --echo prikazi šta je ubijeno\n"

#: src/pgrep.c:172
msgid " -e, --echo                display PIDs before waiting\n"
msgstr ""

#: src/pgrep.c:177
msgid " -c, --count               count of matching processes\n"
msgstr " -c, --računati broj odgovarajućih postupaka\n"

#: src/pgrep.c:178
msgid " -f, --full                use full process name to match\n"
msgstr " -f,--u potpunosti iskoristiti puni naziv odgovarajućeg procesa\n"

#: src/pgrep.c:179
msgid " -g, --pgroup <PGID,...>   match listed process group IDs\n"
msgstr ""
" -g, --pgroup <PGID,...> svrstaj izlistane procese po ID-u njihovijh grupa\n"

#: src/pgrep.c:180
msgid " -G, --group <GID,...>     match real group IDs\n"
msgstr " -G, --group <GID,...> spoji ID-ove realnih grupa\n"

#: src/pgrep.c:181
msgid " -i, --ignore-case         match case insensitively\n"
msgstr " -i, --ignore-case upari predmete \"neosjetljivo\"\n"

#: src/pgrep.c:182
msgid " -n, --newest              select most recently started\n"
msgstr " -n, --najnoviji odabrani nedavno je započeo\n"

#: src/pgrep.c:183
msgid " -o, --oldest              select least recently started\n"
msgstr " -o, --najstariji odabrani je najmanje nedavno započeo\n"

#: src/pgrep.c:184
msgid " -O, --older <seconds>     select where older than seconds\n"
msgstr ""

#: src/pgrep.c:185
msgid ""
" -P, --parent <PPID,...>   match only child processes of the given parent\n"
msgstr ""
" -P, --parent <PPID,...> svrstaj samo dijete procese od datog roditelja\n"

#: src/pgrep.c:186
msgid " -s, --session <SID,...>   match session IDs\n"
msgstr " -s, --session <SID,...> upari ID-ove sesija\n"

#: src/pgrep.c:187
msgid " -t, --terminal <tty,...>  match by controlling terminal\n"
msgstr " -t, --terminal<tty,...>susret od strane kontorlirajućeg terminala\n"

#: src/pgrep.c:188
msgid " -u, --euid <ID,...>       match by effective IDs\n"
msgstr " -u, --euid <ID,...> svrstaj po efektivnim ID-ovima\n"

#: src/pgrep.c:189
msgid " -U, --uid <ID,...>        match by real IDs\n"
msgstr " -U, --uid <ID,...> svrstaj po realnim ID-ovima\n"

#: src/pgrep.c:190
msgid " -x, --exact               match exactly with the command name\n"
msgstr " -x, --tačan susret upravo sa imenom zapovjedne\n"

#: src/pgrep.c:191
msgid " -F, --pidfile <file>      read PIDs from file\n"
msgstr " -F, --piddokument<file>pročitati PIDs iz datoteke\n"

#: src/pgrep.c:192
msgid " -L, --logpidfile          fail if PID file is not locked\n"
msgstr " -L, --logpidfile uspjet će ako PID datoteka nije zaključana\n"

#: src/pgrep.c:193
msgid " -r, --runstates <state>   match runstates [D,S,Z,...]\n"
msgstr ""

#: src/pgrep.c:196
msgid ""
" --ns <PID>                match the processes that belong to the same\n"
"                           namespace as <pid>\n"
msgstr ""
" --ns <PID> spoji procese koji pripadaju istom\n"
"                           namespace-u kao <pid>\n"

#: src/pgrep.c:198
msgid ""
" --nslist <ns,...>         list which namespaces will be considered for\n"
"                           the --ns option.\n"
"                           Available namespaces: ipc, mnt, net, pid, user, "
"uts\n"
msgstr " --nslist <ns,...>popis koji imenskom prostoru će uzeti u obzir za\n"

