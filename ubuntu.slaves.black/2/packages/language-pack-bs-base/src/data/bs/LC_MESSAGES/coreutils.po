"  \\c     ne ispisuj ništa više\n"
"  \\e     iskočni znak\n"
"  \\f     skok na novu stranu\n"
"  \\n     skok u novi red\n"
"  \\r     povratak na početak reda\n"
"  \\t     horizontalni tabulator\n"
"  \\v     vertikalni tabulator\n"

#: src/echo.c:78
