msgstr "ne mogu da nađem ulaz direktorijuma u %s sa podudarajućim i-čvorom"

#: src/pwd.c:367
#, c-format
msgid "ignoring non-option arguments"
msgstr "ignorišem argumente koji nemaju opciju"

