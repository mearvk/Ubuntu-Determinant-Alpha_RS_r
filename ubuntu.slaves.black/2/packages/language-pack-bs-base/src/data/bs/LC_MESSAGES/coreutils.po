msgstr "Upotreba:%s[OPCIJA]...FAJL1 FAJL2\n"

#: src/comm.c:116
msgid "Compare sorted files FILE1 and FILE2 line by line.\n"
msgstr "Poredi sortirane fajlove FILE1 i FILE2 liniju po liniju.\n"

#: src/comm.c:119 src/join.c:201
msgid ""
"\n"
"When FILE1 or FILE2 (not both) is -, read standard input.\n"
msgstr ""
"\n"
"Kada FILE1 ili FILE2 (ne oba) su -,  očitaj standardni ulaz\n"

#: src/comm.c:123
msgid ""
"\n"
"With no options, produce three-column output.  Column one contains\n"
"lines unique to FILE1, column two contains lines unique to FILE2,\n"
"and column three contains lines common to both files.\n"
msgstr ""
"\n"
"Bez opcija, prikaci izlaz u tri kolone. Prva kolona sadrži\n"
"linije jednistvene za FILE1, druga kolona sadrži linije jednistvene za FILE2 "
"i\n"
"treća kolona sadrži linije zajedničke za oba fajla.\n"

#: src/comm.c:129
msgid ""
"\n"
"  -1              suppress column 1 (lines unique to FILE1)\n"
"  -2              suppress column 2 (lines unique to FILE2)\n"
"  -3              suppress column 3 (lines that appear in both files)\n"
msgstr ""
"\n"
"  -1 suzbij kolonu 1 (linije jedinstvene za FILE1)\n"
"  -2 suzbij kolonu 2 (linije jedinstvene za FILE2)\n"
"  -3 suzbij kolonu 3 (linije koje se pojavljuju u oba fajla)\n"

#: src/comm.c:135
msgid ""
"\n"
"  --check-order     check that the input is correctly sorted, even\n"
"                      if all input lines are pairable\n"
"  --nocheck-order   do not check that the input is correctly sorted\n"
msgstr ""
"\n"
"  --check-order     provjeri da li je ulaz ispravno sortiran, čak\n"
"                      ako su sve ulazne linije uparive\n"
"  --nocheck-order   ne provjeravaj da su ulazne linije isravno sortirane\n"

#: src/comm.c:141
msgid "  --output-delimiter=STR  separate columns with STR\n"
msgstr "  --output-delimiter=STR  odvoji kolone sa STR\n"

#: src/comm.c:144
