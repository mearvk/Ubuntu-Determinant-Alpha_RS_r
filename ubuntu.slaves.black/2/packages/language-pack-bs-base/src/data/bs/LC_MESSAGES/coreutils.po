msgstr "navedena je neispravna širina linije: %s"

#: src/pwd.c:58
msgid ""
"Print the full filename of the current working directory.\n"
"\n"
msgstr ""
"Štampaj puno ime datoteke tekućeg aktivnog direktorijuma.\n"
"\n"

#: src/pwd.c:62
msgid ""
"  -L, --logical   use PWD from environment, even if it contains symlinks\n"
"  -P, --physical  avoid all symlinks\n"
msgstr ""
"  -L, --logical   koristiti PWD iz okruženja, čak i ako sadrži simboličke "
"veze\n"
"  -P, --physical  izbjegni sve simboličke veze\n"

#: src/pwd.c:68
msgid ""
"\n"
"If no option is specified, -P is assumed.\n"
msgstr ""
"\n"
"Ako nije naznačena nijedna opcija, -P je pretpostavljen.\n"

#: src/pwd.c:169
#, c-format
