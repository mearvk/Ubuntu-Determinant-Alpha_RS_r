msgstr "Potrošnja: %s [OPTION]... [NUMBER]...\n"

#: src/numfmt.c:887
msgid ""
"Reformat NUMBER(s), or the numbers from standard input if none are "
"specified.\n"
msgstr ""
"Preformatiraj NUMBER(e), ili brojeve sa standardnog ulaza ako ni jedan nije "
"naveden.\n"

#: src/numfmt.c:891
msgid "      --debug          print warnings about invalid input\n"
msgstr "      --debug          Ispiši upozorenja za nevažeće brojeve\n"

#: src/numfmt.c:894
msgid ""
"  -d, --delimiter=X    use X instead of whitespace for field delimiter\n"
msgstr ""
"  -d, --delimiter=X    koristi X umjesto međuprostora za granična polja\n"

#: src/numfmt.c:897
msgid ""
"      --field=FIELDS   replace the numbers in these input fields "
"(default=1)\n"
"                         see FIELDS below\n"
msgstr ""
"      --field=FIELDS   zamijeni brojeve na trenutno unesenim poljima "
"(default=1)\n"
"                         see FIELDS below\n"

#: src/numfmt.c:901
msgid ""
"      --format=FORMAT  use printf style floating-point FORMAT;\n"
"                         see FORMAT below for details\n"
msgstr ""
"      --format=FORMAT  koristiti prinf stil floating-point FORMAT;\n"
"                         pogledati FORMAT ispod za detalje\n"

#: src/numfmt.c:905
msgid ""
"      --from=UNIT      auto-scale input numbers to UNITs; default is "
"'none';\n"
"                         see UNIT below\n"
msgstr ""
"      --from=unit automatski skaliraj ulazne brojeve u UNITs; podrazmijevano "
"je 'nijedan';\n"
"                         vidjeti UNIT ispod\n"

#: src/numfmt.c:909
msgid ""
"      --from-unit=N    specify the input unit size (instead of the default "
"1)\n"
msgstr ""
"      --from-unit=N    navesti vličinu ulazne jedinice (umjesto po zadanom "
"na 1)\n"

#: src/numfmt.c:912
msgid ""
"      --grouping       use locale-defined grouping of digits, e.g. "
"1,000,000\n"
"                         (which means it has no effect in the C/POSIX "
"locale)\n"
msgstr ""
"      --grouping       koristi lokalno-definisan skupinu cifara. e.g. "
"1,000,000\n"
"                         (što znaci da nema efekta u C/POSIX locale)\n"

#: src/numfmt.c:916
msgid ""
"      --header[=N]     print (without converting) the first N header lines;\n"
"                         N defaults to 1 if not specified\n"
msgstr ""
"      --header[=N]     ispiši (bez konvertovanja) prvih N zaglavlja;\n"
"                         N je po zadanom 1 ako nije navedeno\n"

#: src/numfmt.c:920
msgid ""
"      --invalid=MODE   failure mode for invalid numbers: MODE can be:\n"
"                         abort (default), fail, warn, ignore\n"
msgstr ""
"      --invalid=MODE   način rada sa greškom nevažećih brojeva: MODE može "
"biti:\n"
"                         obustavi (po zadanom), zakaži, upozori, zanemari\n"

#: src/numfmt.c:924
msgid ""
"      --padding=N      pad the output to N characters; positive N will\n"
"                         right-align; negative N will left-align;\n"
"                         padding is ignored if the output is wider than N;\n"
"                         the default is to automatically pad if a "
"whitespace\n"
"                         is found\n"
msgstr ""
"      --padding=N namjesti izlaz na N karaktera; pozitivno N će\n"
"                         poravnati desno, negativno N će poravnati lijevo;\n"
"                         namještanje se ignoriše ako je izlaz širi od N;\n"
"                         podrazmijeva se da će se automatski namjestiti ako "
"razmak\n"
"                         bude pronađen\n"

#: src/numfmt.c:931
msgid ""
"      --round=METHOD   use METHOD for rounding when scaling; METHOD can be:\n"
"                         up, down, from-zero (default), towards-zero, "
"nearest\n"
msgstr ""
"      --round=METHOD   koristi METHOD za zaokruživanje kod skaliranja; "
"METHOD može biti:\n"
"                         gore, dole, od-nule (po zadnom), ka-nuli, najbliži\n"

#: src/numfmt.c:935
msgid ""
"      --suffix=SUFFIX  add SUFFIX to output numbers, and accept optional\n"
"                         SUFFIX in input numbers\n"
msgstr ""
"      --suffix=SUFFIX  dodaj SUFFIX na izlazne brojeve, i prihvati po volji\n"
"                         SUFFIX u ulaznim brojevima\n"

#: src/numfmt.c:939
msgid ""
"      --to=UNIT        auto-scale output numbers to UNITs; see UNIT below\n"
msgstr ""
"      --to=UNIT        automatski-skaliraj izlazne brojeve ka UNITima; "
"vidjeti UNIT ispod\n"

#: src/numfmt.c:942
msgid ""
"      --to-unit=N      the output unit size (instead of the default 1)\n"
msgstr ""
"      --to-unit=N izlazna jedinica veličine (umjesto podrazumijevanog 1)\n"

#: src/numfmt.c:951
msgid ""
"\n"
"UNIT options:\n"
msgstr ""
"\n"
"UNIT mogučnosti:\n"

#: src/numfmt.c:954
msgid ""
"  none       no auto-scaling is done; suffixes will trigger an error\n"
msgstr ""
"  none       automatsko-skaliranje nije izvršavano; sufiksi će aktivirati "
"grešku\n"

#: src/numfmt.c:957
msgid ""
"  auto       accept optional single/two letter suffix:\n"
"               1K = 1000,\n"
"               1Ki = 1024,\n"
"               1M = 1000000,\n"
"               1Mi = 1048576,\n"
msgstr ""
"  auto prihvati opcionalne jednokarakterne/dvokarakterne sufikse:\n"
"               1K = 1000,\n"
"               1Ki = 1024,\n"
"               1M = 1000000,\n"
"               1Mi = 1048576,\n"

#: src/numfmt.c:963
msgid ""
"  si         accept optional single letter suffix:\n"
"               1K = 1000,\n"
"               1M = 1000000,\n"
"               ...\n"
msgstr ""
"  si         prihvati mogući jedno-karakterni sufiks:\n"
"               1K = 1000,\n"
"               1M = 1000000,\n"
"               ...\n"

#: src/numfmt.c:968
msgid ""
"  iec        accept optional single letter suffix:\n"
"               1K = 1024,\n"
"               1M = 1048576,\n"
"               ...\n"
msgstr ""
"  iec        prihvati jedno-karakterni sufiks:\n"
"               1K = 1024,\n"
"               1M = 1048576,\n"
"               ...\n"

#: src/numfmt.c:973
msgid ""
"  iec-i      accept optional two-letter suffix:\n"
"               1Ki = 1024,\n"
"               1Mi = 1048576,\n"
"               ...\n"
msgstr ""
"  iec-i      prihvati mogući dvo-slovni sufiks:\n"
"               1Ki = 1024,\n"
"               1Mi = 1048576,\n"
"               ...\n"

#: src/numfmt.c:979
msgid ""
"\n"
"FIELDS supports cut(1) style field ranges:\n"
"  N    N'th field, counted from 1\n"
"  N-   from N'th field, to end of line\n"
"  N-M  from N'th to M'th field (inclusive)\n"
"  -M   from first to M'th field (inclusive)\n"
"  -    all fields\n"
"Multiple fields/ranges can be separated with commas\n"
msgstr ""
"\n"
"FIELDS podržava stil rezanja(1) dometa polja:\n"
"  N    N-to polje, brojano od 1\n"
"  N-   od N-tog polja, do kraja vrste\n"
"  N-M  od N-tog do M-tog polja (ulkjučivo)\n"
"  -M   od prvog do M-tog polja (uključivo)\n"
"  -    all fields\n"
"Multiple fields/ranges can be separated with commas\n"

#: src/numfmt.c:989
#, c-format
msgid ""
"\n"
"FORMAT must be suitable for printing one floating-point argument '%f'.\n"
"Optional quote (%'f) will enable --grouping (if supported by current "
"locale).\n"
"Optional width value (%10f) will pad output. Optional zero (%010f) width\n"
"will zero pad the number. Optional negative values (%-10f) will left align.\n"
"Optional precision (%.1f) will override the input determined precision.\n"
msgstr ""
"\n"
"FORMAT mora biti pogodan za štampanje jednog argumenta sa plutajućim tačkom "
"'% f'.\n"
"Opcioni citat (% 'f) će omogućiti - grupisanje (ako ga podržava trenutna "
"lokacija).\n"
"Opciona širina vrijednost (% 10f) će izlaziti. Opciona nula (% 010f) širina\n"
"nula će unijeti broj. Opcijske negativne vrednosti (% -10f) će ostati "
"poravnate.\n"
"Opciona preciznost (% .1f) će prevazići preciznost određenog ulaza.\n"

#: src/numfmt.c:997
#, c-format
msgid ""
"\n"
"Exit status is 0 if all input numbers were successfully converted.\n"
"By default, %s will stop at the first conversion error with exit status 2.\n"
"With --invalid='fail' a warning is printed for each conversion error\n"
"and the exit status is 2.  With --invalid='warn' each conversion error is\n"
"diagnosed, but the exit status is 0.  With --invalid='ignore' conversion\n"
"errors are not diagnosed and the exit status is 0.\n"
msgstr ""
"\n"
"Izlazni status je 0, ako su svi ulazni brojevi uspješno konvertovani.\n"
"Po zadanom, %s će se zaustaviti na prvoj konverzijskoj greški sa izlaznim "
"statusom 2.\n"
"Sa --invalid='fail' upozorenje se ispisuje za svaku konverzijsku grešku\n"
"i izlaznim statusom 2. Sa --invalid'warn' svaka konverzijska greška se\n"
"dijagnosticira, ali izlazni status je 0. Sa --invalid='zanemari' "
"konverzijske\n"
"greške se ne dijagnosticiiraju i izlazni status je 0.\n"

#: src/numfmt.c:1006
#, c-format
msgid ""
"\n"
"Examples:\n"
"  $ %s --to=si 1000\n"
"            -> \"1.0K\"\n"
"  $ %s --to=iec 2048\n"
"           -> \"2.0K\"\n"
"  $ %s --to=iec-i 4096\n"
"           -> \"4.0Ki\"\n"
"  $ echo 1K | %s --from=si\n"
"           -> \"1000\"\n"
"  $ echo 1K | %s --from=iec\n"
"           -> \"1024\"\n"
"  $ df -B1 | %s --header --field 2-4 --to=si\n"
"  $ ls -l  | %s --header --field 5 --to=iec\n"
"  $ ls -lh | %s --header --field 5 --from=iec --padding=10\n"
"  $ ls -lh | %s --header --field 5 --from=iec --format %%10f\n"
msgstr ""
"\n"
"Primjeri:\n"
"  $ %s --to=si 1000\n"
"            -> \"1.0K\"\n"
"  $ %s --to=iec 2048\n"
"           -> \"2.0K\"\n"
"  $ %s --to=iec-i 4096\n"
"           -> \"4.0Ki\"\n"
"  $ echo 1K | %s --from=si\n"
"           -> \"1000\"\n"
"  $ echo 1K | %s --from=iec\n"
"           -> \"1024\"\n"
"  $ df -B1 | %s --header --field 2-4 --to=si\n"
"  $ ls -l  | %s --header --field 5 --to=iec\n"
"  $ ls -lh | %s --header --field 5 --from=iec --padding=10\n"
"  $ ls -lh | %s --header --field 5 --from=iec --format %%10f\n"

