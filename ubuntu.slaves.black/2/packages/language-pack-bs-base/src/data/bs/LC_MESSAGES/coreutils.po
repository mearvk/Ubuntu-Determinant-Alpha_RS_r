#: src/basename.c:48
#, c-format
msgid ""
"Usage: %s NAME [SUFFIX]\n"
"  or:  %s OPTION... NAME...\n"
msgstr ""
"Korištenje: %s IME [SUFIKS]\n"
"  or: %s OPCIJA...IME..\n"

#: src/basename.c:53
msgid ""
"Print NAME with any leading directory components removed.\n"
"If specified, also remove a trailing SUFFIX.\n"
msgstr ""
"Ispiši IME sa bilo kojim vodećim direktorijom uklonjenim.\n"
"Ako je navedeno, također ukloni i prateči SUFIKS.\n"

#: src/basename.c:60
msgid ""
"  -a, --multiple       support multiple arguments and treat each as a NAME\n"
"  -s, --suffix=SUFFIX  remove a trailing SUFFIX; implies -a\n"
"  -z, --zero           end each output line with NUL, not newline\n"
msgstr ""
"  -a, --multiple podržava višestruke argumente i tretira svaki kao IME\n"
"  -s, --suffix=SUFFIX briše zaostali SUFIKS; podrazumijeva -a\n"
"  -z, --zero završi svaku izlaznu liniju sa NUL, ne novim redom\n"

#: src/basename.c:67
#, c-format
msgid ""
"\n"
"Examples:\n"
"  %s /usr/bin/sort          -> \"sort\"\n"
"  %s include/stdio.h .h     -> \"stdio\"\n"
"  %s -s .h include/stdio.h  -> \"stdio\"\n"
"  %s -a any/str1 any/str2   -> \"str1\" followed by \"str2\"\n"
msgstr ""
"\n"
"Primjeri:\n"
"  %s /usr/bin/sort -> \"sort\"\n"
"  %s include/stdio.h .h -> \"stdio\"\n"
"  %s -s .h include/stdio.h -> \"stdio\"\n"
"  %s -a any/str1 any/str2 -> \"str1\" a zatim \"str2\"\n"

