msgstr "nisam uspeo da promijenim direktorijum u %s"

#: src/pwd.c:173 src/pwd.c:280 src/split.c:470
#, c-format
msgid "failed to stat %s"
msgstr "stat nije uspio za %s"

#: src/pwd.c:238
