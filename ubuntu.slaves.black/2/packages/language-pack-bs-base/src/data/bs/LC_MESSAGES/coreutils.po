#: src/shuf.c:62
#, c-format
msgid ""
"Usage: %s [OPTION]... [FILE]\n"
"  or:  %s -e [OPTION]... [ARG]...\n"
"  or:  %s -i LO-HI [OPTION]...\n"
msgstr ""
"Upotreba: %s [OPCIJA]... [DATOTEKA]\n"
"  ili:  %s -e [OPCIJA]... [ARG]...\n"
"  ili:  %s -i NI-VI [OPCIJA]...\n"

#: src/shuf.c:68
msgid "Write a random permutation of the input lines to standard output.\n"
msgstr "Ispiši nasumičnu permutaciju ulaznih linija na standardni izlaz\n"

#: src/shuf.c:75
msgid ""
"  -e, --echo                treat each ARG as an input line\n"
"  -i, --input-range=LO-HI   treat each number LO through HI as an input "
"line\n"
"  -n, --head-count=COUNT    output at most COUNT lines\n"
"  -o, --output=FILE         write result to FILE instead of standard output\n"
"      --random-source=FILE  get random bytes from FILE\n"
"  -r, --repeat              output lines can be repeated\n"
msgstr ""
"  -e, --echo tretiraj svaki ARG kao ulaznu liniju\n"
"  -i, --input-range=LO-HI tretiraj svaki broj LO preko HI kao ulaznu liniju\n"
"  -n, --head-count=COUNT prikaži najviše COUNT linija\n"
"  -o, --output=FILE piši rezultat u FILE umjesto na standardni izlaz\n"
"      --random-source=FILE nasumično uzmi bajte iz FILE\n"
"  -r, --repeat ispisane linije se mogu ponavljati\n"

#: src/shuf.c:226
msgid "too many input lines"
msgstr "previše ulaznih linija"

#: src/shuf.c:418
