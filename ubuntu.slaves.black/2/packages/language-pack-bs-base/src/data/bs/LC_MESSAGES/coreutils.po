msgid_plural "%s: remove %<PRIuMAX> arguments recursively? "
msgstr[0] "%s: ukloniti %<PRIuMAX> argument rekurzivno? "
msgstr[1] "%s: ukloniti %<PRIuMAX> argumente rekurzivno? "

#: src/rm.c:362
#, c-format
msgid "%s: remove %<PRIuMAX> argument? "
msgid_plural "%s: remove %<PRIuMAX> arguments? "
msgstr[0] "%s: ukloniti %<PRIuMAX> argument? "
msgstr[1] "%s: ukloniti %<PRIuMAX> argumente? "

