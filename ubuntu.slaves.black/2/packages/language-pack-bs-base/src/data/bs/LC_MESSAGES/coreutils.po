msgstr "%s: navedeno je više signala"

#: src/kill.c:284
#, c-format
msgid "multiple -l or -t options specified"
msgstr "navedeno je više opcija -l ili -t"

#: src/kill.c:301
#, c-format
msgid "cannot combine signal with -l or -t"
msgstr "ne mogu da kombinujem signal sa opcijama -l i -t"

#: src/kill.c:307
#, c-format
