"ovaj sistem ne obezbjeđuje %lu-bajt cio tip"

#: src/od.c:817
#, c-format
msgid ""
"invalid type string %s;\n"
"this system doesn't provide a %lu-byte floating point type"
msgstr ""
"neispravan tip stringa %s;\n"
"ovaj sistem ne obezbjeđuje %lu-bajt  pokretnu tačku tip"

#: src/od.c:875
#, c-format
msgid "invalid character '%c' in type string %s"
msgstr "neispravan karakter '%c' u tipu stringa %s"

#: src/od.c:1110
msgid "cannot skip past end of combined input"
msgstr "ne mogu da preskočim poslije kraja kombinovanog ulaza"

#: src/od.c:1661
#, c-format
msgid ""
"invalid output address radix '%c'; it must be one character from [doxn]"
msgstr ""
"nevažeća izlazna adresa osnove '%c'; mora biti jedan karakter iz [doxn]"

#: src/od.c:1799
msgid "no type may be specified when dumping strings"
msgstr "nijedan tip ne smje biti određen kada se odbacuju stringovi"

#: src/od.c:1874
msgid "compatibility mode supports at most one file"
msgstr "način kompatibilnosti podržava najviše jednu datoteku"

#: src/od.c:1895
msgid "skip-bytes + read-bytes is too large"
msgstr "preskoči-bajtove + čitaj-bajtove rezultat je preveliki"

#: src/od.c:1938
#, c-format
msgid "warning: invalid width %lu; using %d instead"
msgstr "upozorenje: neispravna širina %lu; koristim %d umjesto"

#: src/paste.c:221
msgid "standard input is closed"
msgstr "standardni ulaz je zatvoren"

#: src/paste.c:437
msgid ""
"Write lines consisting of the sequentially corresponding lines from\n"
"each FILE, separated by TABs, to standard output.\n"
msgstr ""
"Ispiši linije koje se sastoje od serijski podudarnih linija\n"
"svakog FILE, odvojene TABovima, na standardni izlaz.\n"

#: src/paste.c:445
msgid ""
"  -d, --delimiters=LIST   reuse characters from LIST instead of TABs\n"
"  -s, --serial            paste one file at a time instead of in parallel\n"
msgstr ""
"  -d, --delimiters=LISTA   ponovo koristi karaktere iz LISTA umjesto TAB-"
"ova\n"
"  -s, --serial            kopiraj jedan po jednu datoteku umjesto paralelno\n"

#: src/paste.c:515
#, c-format
msgid "delimiter list ends with an unescaped backslash: %s"
msgstr ""
"graničnik popisa završava s neočekivanim znakom za novu obrnutu kosu crtu: %s"

#: src/pathchk.c:89
msgid ""
"Diagnose invalid or unportable file names.\n"
"\n"
"  -p                  check for most POSIX systems\n"
"  -P                  check for empty names and leading \"-\"\n"
"      --portability   check for all POSIX systems (equivalent to -p -P)\n"
msgstr ""
"Dijagnosticirati nevažeće ili neprenosive nazive datoteka.\n"
"\n"
"  -p                  provjeriti za većinu POSIX sustava\n"
"  -P                  provjeriti za prazna imena i vodeći \"-\"\n"
"      --portability   provjeriti za sve POSIX sisteme (ekvivalent za -p -P)\n"

#: src/pathchk.c:169
#, c-format
msgid "leading '-' in a component of file name %s"
msgstr "vodeća '-' u sastavu imena datoteke %s"

#: src/pathchk.c:195
