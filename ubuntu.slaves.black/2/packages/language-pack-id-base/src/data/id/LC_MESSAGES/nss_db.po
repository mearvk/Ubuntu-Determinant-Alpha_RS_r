#: src/makedb.c:68
msgid "Convert key to lower case"
msgstr "Ubah kunci ke huruf kecil"

#: src/makedb.c:69
msgid "NAME"
msgstr "NAMA"

#: src/makedb.c:69
msgid "Write output to file NAME"
msgstr "Tulis keluaran ke berkas NAMA"

#: src/makedb.c:71
msgid "Do not print messages while building database"
msgstr "Jangan tampilkan pesan-pesan ketika sedang membangun basis data"

#: src/makedb.c:73
