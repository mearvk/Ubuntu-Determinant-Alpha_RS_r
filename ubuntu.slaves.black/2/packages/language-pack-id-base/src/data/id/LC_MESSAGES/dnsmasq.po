#: option.c:228
msgid "Specify local address(es) to listen on."
msgstr "Tentukan alamat lokal yang akan didengarkan"

#: option.c:229
msgid "Return ipaddr for all hosts in specified domains."
msgstr "Kembalikan ipaddr untuk semua host di domain tertentu."

#: option.c:230
msgid "Fake reverse lookups for RFC1918 private address ranges."
msgstr "Pencarian terbalik palsu untuk rentang alamat pribadi RFC1918."

#: option.c:231
msgid "Treat ipaddr as NXDOMAIN (defeats Verisign wildcard)."
msgstr "Perlakukan ipaddr sebagai NXDOMAIN (mengalahkan wildcard Verisign)."

#: option.c:232
#, c-format
msgid "Specify the size of the cache in entries (defaults to %s)."
msgstr "Tentukan ukuran cache dalam entri (default ke %s)."

#: option.c:233
#, c-format
msgid "Specify configuration file (defaults to %s)."
msgstr "Tentukan berkas konfigurasi (default ke %s)."

#: option.c:234
msgid "Do NOT fork into the background: run in debug mode."
msgstr ""

#: option.c:235
msgid "Do NOT forward queries with no domain part."
msgstr "JANGAN meneruskan kueri tanpa bagian domain."

#: option.c:236
msgid "Return self-pointing MX records for local hosts."
msgstr "Kembalikan data MX yang menunjuk sendiri untuk host lokal."

#: option.c:237
msgid "Expand simple names in /etc/hosts with domain-suffix."
msgstr "Perluas nama sederhana di /etc/hosts dengan domain-suffix."

#: option.c:238
msgid "Don't forward spurious DNS requests from Windows hosts."
msgstr "Jangan meneruskan permintaan DNS palsu dari host Windows."

#: option.c:239
msgid "Enable DHCP in the range given with lease duration."
msgstr "Aktifkan DHCP dalam rentang yang diberikan dengan durasi sewa."

#: option.c:240
#, c-format
msgid "Change to this group after startup (defaults to %s)."
msgstr "Ubah ke grup ini setelah startup (default ke %s)."

#: option.c:241
msgid "Set address or hostname for a specified machine."
msgstr "Tetapkan alamat atau nama host untuk mesin tertentu."

#: option.c:242
msgid "Read DHCP host specs from file"
msgstr "Baca spesifikasi host DHCP dari berkas"

#: option.c:243
msgid "Read DHCP option specs from file"
msgstr "Baca spesifikasi opsi DHCP dari berkas"

#: option.c:244
#, c-format
msgid "Do NOT load %s file."
msgstr "JANGAN memuat berkas %s."

#: option.c:245
#, c-format
msgid "Specify a hosts file to be read in addition to %s."
msgstr "Tentukan berkas host yang akan dibaca sebagai tambahan terhadap %s."

#: option.c:246
msgid "Specify interface(s) to listen on."
msgstr "Tentukan antarmuka untuk didengarkan."

#: option.c:247
msgid "Specify interface(s) NOT to listen on."
msgstr "Tentukan antarmuka untuk TIDAK didengarkan."

#: option.c:248
msgid "Map DHCP user class to tag."
msgstr "Petakan kelas pengguna DHCP untuk diberi tag."

#: option.c:249
msgid "Map RFC3046 circuit-id to tag."
msgstr "Petakan id sirkuit RFC3046 untuk diberi tag."

#: option.c:250
msgid "Map RFC3046 remote-id to tag."
msgstr "Petakan ID jarak jauh RFC3046 untuk diberi tag."

#: option.c:251
msgid "Map RFC3993 subscriber-id to tag."
msgstr "Petakan ID pelanggan RFC3993 untuk diberi tag."

#: option.c:252
msgid "Don't do DHCP for hosts with tag set."
msgstr "Jangan lakukan DHCP untuk host dengan kumpulan tag."

#: option.c:253
msgid "Force broadcast replies for hosts with tag set."
msgstr "Paksa balasan siaran untuk host dengan kumpulan tag."

#: option.c:254
msgid "Do NOT fork into the background, do NOT run in debug mode."
msgstr ""

#: option.c:255
msgid "Assume we are the only DHCP server on the local network."
msgstr "Asumsikan kita adalah satu-satunya server DHCP di jaringan lokal."

#: option.c:256
#, c-format
msgid "Specify where to store DHCP leases (defaults to %s)."
msgstr "Tentukan tempat untuk menyimpan sewa DHCP (default ke %s)."

#: option.c:257
msgid "Return MX records for local hosts."
msgstr ""

#: option.c:258
msgid "Specify an MX record."
msgstr ""

#: option.c:259
msgid "Specify BOOTP options to DHCP server."
msgstr "Tentukan opsi BOOTP ke server DHCP."

#: option.c:260
#, c-format
msgid "Do NOT poll %s file, reload only on SIGHUP."
msgstr "JANGAN polling berkas %s, muat ulang hanya di SIGHUP."

#: option.c:261
msgid "Do NOT cache failed search results."
msgstr "JANGAN cache hasil pencarian yang gagal."

#: option.c:262
#, c-format
msgid "Use nameservers strictly in the order given in %s."
msgstr ""
"Gunakan nama server secara ketat dalam urutan yang diberikan dalam %s."

#: option.c:263
msgid "Specify options to be sent to DHCP clients."
msgstr "Tentukan opsi yang akan dikirim ke klien DHCP."

#: option.c:264
msgid "DHCP option sent even if the client does not request it."
msgstr "Opsi DHCP dikirim bahkan jika klien tidak memintanya."

#: option.c:265
msgid "Specify port to listen for DNS requests on (defaults to 53)."
msgstr ""
"Tentukan port untuk mendengarkan permintaan DNS aktif (default ke 53)."

#: option.c:266
#, c-format
msgid "Maximum supported UDP packet size for EDNS.0 (defaults to %s)."
msgstr ""
"Ukuran paket UDP maksimum yang didukung untuk EDNS.0 (default ke %s)."

#: option.c:267
msgid "Log DNS queries."
msgstr "Catatan kueri DNS."

#: option.c:268
msgid "Force the originating port for upstream DNS queries."
msgstr "Paksa port asal untuk kueri DNS upstream."

#: option.c:269
msgid "Do NOT read resolv.conf."
msgstr "JANGAN baca resolv.conf."

#: option.c:270
#, c-format
msgid "Specify path to resolv.conf (defaults to %s)."
msgstr "Tentukan jalur ke resolv.conf (default ke %s)."

#: option.c:271
msgid "Specify address(es) of upstream servers with optional domains."
msgstr "Tentukan alamat server upstream dengan domain opsional."

#: option.c:272
msgid "Never forward queries to specified domains."
msgstr "Jangan pernah meneruskan kueri ke domain tertentu."

#: option.c:273
msgid "Specify the domain to be assigned in DHCP leases."
msgstr "Tentukan domain yang akan ditetapkan dalam penyewaan DHCP."

#: option.c:274
msgid "Specify default target in an MX record."
msgstr ""

#: option.c:275
msgid "Specify time-to-live in seconds for replies from /etc/hosts."
msgstr "Tentukan time-to-live dalam detik untuk balasan dari /etc/hosts."

#: option.c:276
msgid "Specify time-to-live in seconds for negative caching."
msgstr "Tentukan time-to-live dalam detik untuk caching negatif."

#: option.c:277
#, c-format
msgid "Change to this user after startup. (defaults to %s)."
msgstr "Ubah ke pengguna ini setelah startup. (default ke %s)."

#: option.c:278
msgid "Map DHCP vendor class to tag."
msgstr "Petakan kelas vendor DHCP untuk diberi tag."

#: option.c:279
msgid "Display dnsmasq version and copyright information."
msgstr "Tampilkan versi dnsmasq dan informasi hak cipta."

#: option.c:280
msgid "Translate IPv4 addresses from upstream servers."
msgstr "Terjemahkan alamat IPv4 dari server upstream."

#: option.c:281
msgid "Specify a SRV record."
msgstr ""

#: option.c:282
msgid "Display this message. Use --help dhcp for known DHCP options."
msgstr ""

