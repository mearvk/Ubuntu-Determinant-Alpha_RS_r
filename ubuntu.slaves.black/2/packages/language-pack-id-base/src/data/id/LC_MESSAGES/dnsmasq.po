#, c-format
msgid "Read DHCP static host information from %s."
msgstr ""

#: option.c:291
msgid "Enable the DBus interface for setting upstream servers, etc."
msgstr ""

#: option.c:292
msgid "Do not provide DHCP on this interface, only provide DNS."
msgstr "Jangan berikan DHCP pada antarmuka ini, hanya sediakan DNS."

#: option.c:293
msgid "Enable dynamic address allocation for bootp."
msgstr "Aktifkan alokasi alamat dinamis untuk bootp."

#: option.c:294
msgid "Map MAC address (with wildcards) to option set."
msgstr "Petakan alamat MAC (dengan wildcard) ke set opsi."

#: option.c:295
msgid "Treat DHCP requests on aliases as arriving from interface."
msgstr "Perlakukan permintaan DHCP pada alias sebagai datang dari antarmuka."

#: option.c:296
msgid "Disable ICMP echo address checking in the DHCP server."
msgstr "Nonaktifkan pemeriksaan alamat echo ICMP di server DHCP."

#: option.c:297
msgid "Script to run on DHCP lease creation and destruction."
msgstr ""

#: option.c:298
msgid "Read configuration from all the files in this directory."
msgstr "Baca konfigurasi dari semua berkas di direktori ini."

#: option.c:299
msgid "Log to this syslog facility or file. (defaults to DAEMON)"
msgstr "Masuk ke fasilitas atau berkas syslog ini. (default ke DAEMON)"

#: option.c:300
msgid "Do not use leasefile."
msgstr "Jangan gunakan leasefile."

#: option.c:301
#, c-format
msgid "Maximum number of concurrent DNS queries. (defaults to %s)"
msgstr "Jumlah maksimum kueri DNS serentak. (default ke %s)"

#: option.c:302
#, c-format
msgid "Clear DNS cache when reloading %s."
msgstr "Kosongkan cache DNS saat memuat ulang %s."

#: option.c:303
msgid "Ignore hostnames provided by DHCP clients."
msgstr "Abaikan nama host yang disediakan oleh klien DHCP."

#: option.c:304
msgid "Do NOT reuse filename and server fields for extra DHCP options."
msgstr ""
"JANGAN menggunakan kembali bidang nama berkas dan server untuk opsi DHCP "
"tambahan."

#: option.c:305
msgid "Enable integrated read-only TFTP server."
msgstr "Aktifkan server TFTP baca-saja terintegrasi."

#: option.c:306
msgid "Export files by TFTP only from the specified subtree."
msgstr "Ekspor berkas dengan TFTP hanya dari subpohon yang ditentukan."

#: option.c:307
msgid "Add client IP address to tftp-root."
msgstr "Tambahkan alamat IP klien ke tftp-root."

#: option.c:308
msgid "Allow access only to files owned by the user running dnsmasq."
msgstr ""
"Izinkan akses hanya ke berkas yang dimiliki oleh pengguna yang menjalankan "
"dnsmasq."

#: option.c:309
#, c-format
msgid "Maximum number of conncurrent TFTP transfers (defaults to %s)."
