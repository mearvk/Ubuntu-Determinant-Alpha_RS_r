#: Module.cpp:77
msgctxt "@title/rich"
msgid "<title>Your computer requires no proprietary drivers</title>"
msgstr "<title>Komputer Anda tidak memerlukan driver berhak-milik</title>"

#: Module.cpp:130
msgctxt ""
"The backend is trying to figure out what drivers are suitable for the users "
"system"
msgid "Collecting information about your system"
msgstr "Mengumpulkan informasi tentang sistem Anda"

#: Module.cpp:220 DriverManager.cpp:248
msgctxt "@label"
msgid ""
"The package system could not be initialized, your configuration may be "
"broken."
msgstr ""
"Sistim paket tidak dapat di inisialisasi, mungkin pengaturan Anda rusak."

#: Module.cpp:232
msgctxt "The backend replied with a error"
msgid ""
"Something went terribly wrong. Please hit the 'Refresh Driver List' button"
msgstr "Ada yang tidak beres. Silakan tekan tombol 'Segarkan Daftar Driver'"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr " ,Launchpad Contributions:,Arief Setiadi Wibowo"

