#: tools/setfacl.c:147
#, c-format
msgid "%s: %s: No filename found in line %d, aborting\n"
msgstr "%s: %s: Tidak ditemukan nama berkas dalam baris %d, menggugurkan\n"

#: tools/setfacl.c:152
#, c-format
msgid "%s: No filename found in line %d of standard input, aborting\n"
msgstr ""
"%s: Tidak di temukan berkas di baris%d dari standar input, mengabaikan\n"

#: tools/setfacl.c:173
#, c-format
msgid "%s: %s: %s in line %d\n"
msgstr "%s: %s: %s di baris %d\n"

#: tools/setfacl.c:205
#, c-format
msgid "%s: %s: Cannot change owner/group: %s\n"
msgstr "%s: %s: Tidak dapat merubah pemilik/group: %s\n"

#: tools/setfacl.c:224
#, c-format
msgid "%s: %s: Cannot change mode: %s\n"
msgstr "%s: %s: Tidak bisa mengubah mode: %s\n"

#: tools/setfacl.c:266
#, c-format
msgid "%s %s -- set file access control lists\n"
msgstr "%s %s -- Mengatur berkas daftar kontrol akses\n"

#: tools/setfacl.c:268 tools/setfacl.c:653
#, c-format
msgid "Usage: %s %s\n"
msgstr "Kegunaan: %s %s\n"

#: tools/setfacl.c:271
#, c-format
msgid ""
"  -m, --modify=acl        modify the current ACL(s) of file(s)\n"
"  -M, --modify-file=file  read ACL entries to modify from file\n"
"  -x, --remove=acl        remove entries from the ACL(s) of file(s)\n"
"  -X, --remove-file=file  read ACL entries to remove from file\n"
"  -b, --remove-all        remove all extended ACL entries\n"
"  -k, --remove-default    remove the default ACL\n"
msgstr ""
"  -m, --modify=acl        ubah ACL berkas saat ini\n"
"  -M, --modify-file=file  baca entri ACL yang akan diubah dari berkas\n"
"  -x, --remove=acl        hapus entri dari ACL berkas\n"
"  -X, --remove-file=file  baca entri ACL yang akan dihapus dari berkas\n"
"  -b, --remove-all        hapus semua entri ACL extended\n"
"  -k, --remove-default    hapus ACL baku\n"

#: tools/setfacl.c:280
#, c-format
msgid ""
"      --set=acl           set the ACL of file(s), replacing the current ACL\n"
"      --set-file=file     read ACL entries to set from file\n"
"      --mask              do recalculate the effective rights mask\n"
msgstr ""
"      --set=acl           tata ACL berkas, menggantikan ACL saat ini\n"
"      --set-file=file     baca entri ACL yang akan ditata dari berkas\n"
"      --mask              hitung ulang mask hak efektif\n"

#: tools/setfacl.c:286
#, c-format
msgid ""
"  -n, --no-mask           don't recalculate the effective rights mask\n"
"  -d, --default           operations apply to the default ACL\n"
msgstr ""
"  -n, --no-mask           jangan hitung ulang mask hak efektif\n"
"  -d, --default           operasi berlaku ke ACL baku\n"

#: tools/setfacl.c:291
#, c-format
msgid ""
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"      --restore=file      restore ACLs (inverse of `getfacl -R')\n"
"      --test              test mode (ACLs are not modified)\n"
msgstr ""
"  -R, --recursive         rekursi ke dalam subdirektori\n"
"  -L, --logical           jalan lojik, ikuti taut simbolik\n"
"  -P, --physical          jalan fisik, jangan ikuti taut simbolik\n"
"      --restore=file      pulihkan ACL (inversi dari `getfacl -R')\n"
"      --test              mode uji (ACL tidak diubah)\n"

#: tools/setfacl.c:299 tools/getfacl.c:597
#, c-format
msgid ""
"  -v, --version           print version and exit\n"
"  -h, --help              this help text\n"
msgstr ""
"  -v, --version           cetak versi dan keluar\n"
"  -h, --help              teks bantuan ini\n"

#: tools/setfacl.c:316 tools/getfacl.c:743
#, c-format
msgid "%s: Standard input: %s\n"
msgstr "%s: Masukan standar: %s\n"

#: tools/setfacl.c:452
#, c-format
msgid "%s: Option -%c incomplete\n"
msgstr "%s: Opsi -%c tidak lengkap\n"

#: tools/setfacl.c:457
#, c-format
msgid "%s: Option -%c: %s near character %d\n"
msgstr "%s: Opsi -%c: %s dekat karakter %d\n"

#: tools/setfacl.c:533
#, c-format
msgid "%s: %s in line %d of file %s\n"
msgstr "%s: %s dalam baris %d dari berkas %s\n"

#: tools/setfacl.c:541
#, c-format
msgid "%s: %s in line %d of standard input\n"
msgstr "%s: %s dalam baris %d dari masukan standar\n"

#: tools/setfacl.c:655 tools/getfacl.c:758
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Coba '%s --help' untuk informasi lebih lanjut\n"

#: tools/getfacl.c:498
#, c-format
msgid "%s: Removing leading '/' from absolute path names\n"
msgstr "%s: Menghapus '/' depan dari nama path absolut\n"

#: tools/getfacl.c:569
#, c-format
msgid "%s %s -- get file access control lists\n"
msgstr "%s %s -- dapatkan daftar kendali akses berkas\n"

#: tools/getfacl.c:571 tools/getfacl.c:756
#, c-format
msgid "Usage: %s [-%s] file ...\n"
msgstr "Cara pakai: %s [-%s] berkas ...\n"

#: tools/getfacl.c:577
#, c-format
msgid "  -d, --default           display the default access control list\n"
msgstr "  -d, --default           menampilkan daftar kendali akses baku\n"

#: tools/getfacl.c:581
#, c-format
msgid ""
"  -a, --access            display the file access control list only\n"
"  -d, --default           display the default access control list only\n"
"  -c, --omit-header       do not display the comment header\n"
"  -e, --all-effective     print all effective rights\n"
"  -E, --no-effective      print no effective rights\n"
"  -s, --skip-base         skip files that only have the base entries\n"
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"  -t, --tabular           use tabular output format\n"
"  -n, --numeric           print numeric user/group identifiers\n"
"      --one-file-system   skip files on different filesystems\n"
"  -p, --absolute-names    don't strip leading '/' in pathnames\n"
msgstr ""
"  -a, --access            hanya menampilkan urutan kontrol file saja\n"
"  -d, --default           hanya menampilkan urutan kontrol file awal saja\n"
"  -c, --omit-header       jangan tampilkan perkenalan komen\n"
"  -e, --all-effective     cetak semua hak efektif\n"
"  -E, --no-effective      cetak semua hak yang tidak efektif\n"
"  -s, --skip-base         lewatakan semua berkas yang hanya punya masukan "
"dasar\n"
"  -R, --recursive         ulangi kedalam sub direktori\n"
"  -L, --logical           jalan logis, ikuti tautan simbolis\n"
"  -P, --physical           jalan logis, jangan ikuti tautan simbolis\n"
"  -t, --tabular           gunakan format keluaran tubular\n"
"  -n, --numeric           cetak identitas numerik pengguna/grup\n"
"      --one-file-system   lewati berkas di berkas sistem yang berbeda\n"
"  -p, --absolute-names    jangan hilangkan '/' didepan pathname\n"
