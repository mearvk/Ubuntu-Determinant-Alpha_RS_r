#: apt-pkg/acquire-item.cc:176
msgid ""
"Updating from such a repository can't be done securely, and is therefore "
"disabled by default."
msgstr ""
"Memperbarui dari repositori seperti itu tidak dapat dilakukan dengan aman, "
"dan karenanya dinonaktifkan secara default."

#: apt-pkg/acquire-item.cc:181
msgid ""
"Data from such a repository can't be authenticated and is therefore "
"potentially dangerous to use."
msgstr ""
"Data dari repositori seperti itu tidak dapat diautentikasi dan karenanya "
"berpotensi berbahaya untuk digunakan."

#: apt-pkg/acquire-item.cc:183
msgid ""
"See apt-secure(8) manpage for repository creation and user configuration "
"details."
msgstr ""
"Lihat manual apt-secure(8) untuk pembuatan repositori dan detail konfigurasi "
"pengguna."

#: apt-pkg/acquire-item.cc:224
#, c-format
msgid "The repository '%s' is no longer signed."
msgstr "Repositori '%s' tidak lagi ditandatangani."

#: apt-pkg/acquire-item.cc:225
#, c-format
msgid "The repository '%s' no longer has a Release file."
msgstr "Repositori '%s' tidak lagi memiliki berkas Release."

#: apt-pkg/acquire-item.cc:234
msgid ""
"This is normally not allowed, but the option "
"Acquire::AllowDowngradeToInsecureRepositories was given to override it."
msgstr ""
"Ini biasanya tidak diperbolehkan, tetapi opsi "
"Acquire::AllowDowngradeToInsecureRepositories diberikan untuk menimpanya."

#: apt-pkg/acquire-item.cc:252
#, c-format
msgid "The repository '%s' is not signed."
msgstr "Repositori '%s' tidak ditandatangani."

#: apt-pkg/acquire-item.cc:253
#, c-format
msgid "The repository '%s' does not have a Release file."
msgstr "Repositori '%s' tidak memiliki berkas Release."

#: apt-pkg/acquire-item.cc:254
#, c-format
msgid "The repository '%s' provides only weak security information."
msgstr "Repositori '%s' hanya memberikan informasi keamanan yang lemah."

#: apt-pkg/acquire-item.cc:543
#, c-format
msgid "Failed to readlink %s"
msgstr "Gagal membaca tautan %s"

#: apt-pkg/acquire-item.cc:552
#, c-format
msgid "Failed to stat %s"
msgstr "Gagal menetapkan %s"

#: apt-pkg/acquire-item.cc:864 apt-pkg/acquire-item.cc:1004
msgid "Hash Sum mismatch"
msgstr "Hash Sum tidak sesuai"

#: apt-pkg/acquire-item.cc:867
msgid "Insufficient information available to perform this download securely"
msgstr ""
"Tidak cukup tersedia informasi untuk melakukan unduhan ini secara aman"

#: apt-pkg/acquire-item.cc:979 apt-pkg/contrib/fileutl.cc:3139
#, c-format
msgid "rename failed, %s (%s -> %s)."
msgstr "Gagal mengganti nama, %s (%s-> %s)."

#: apt-pkg/acquire-item.cc:1007
msgid "Size mismatch"
msgstr "Ukuran tidak sesuai"

#: apt-pkg/acquire-item.cc:1011
msgid "Invalid file format"
msgstr "Format berkas tidak valid"

#: apt-pkg/acquire-item.cc:1016
msgid "Signature error"
msgstr "Kesalahan tanda tangan"

#: apt-pkg/acquire-item.cc:1020
#, c-format
msgid ""
"Clearsigned file isn't valid, got '%s' (does the network require "
"authentication?)"
msgstr ""
"Berkas yang ditandatangani tidak valid, mendapat '%s' (apakah jaringan "
"memerlukan autentikasi?)"

#: apt-pkg/acquire-item.cc:1269
#, c-format
msgid ""
"An error occurred during the signature verification. The repository is not "
"updated and the previous index files will be used. GPG error: %s: %s"
msgstr ""
"Terjadi kesalahan selama verifikasi tanda tangan. Repositori tidak "
"diperbarui dan berkas indeks sebelumnya akan digunakan. Kesalahan GPG: %s: %s"

#. Invalid signature file, reject (LP: #346386) (Closes: #627642)
#: apt-pkg/acquire-item.cc:1278 apt-pkg/acquire-item.cc:1284
#, c-format
msgid "GPG error: %s: %s"
msgstr "galat GPG: %s: %s"

#: apt-pkg/acquire-item.cc:1494
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' doesn't have the "
"component '%s' (component misspelt in sources.list?)"
msgstr ""
"Melewati mengambil berkas yang dikonfigurasi '%s' karena repositori '%s' "
"tidak memiliki komponen '%s' (komponen salah eja di sources.list?)"

#: apt-pkg/acquire-item.cc:1513
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' doesn't support "
"architecture '%s'"
msgstr ""
"Melewati mengambil berkas yang dikonfigurasi '%s' karena repositori '%s' "
"tidak mendukung arsitektur '%s'"

#: apt-pkg/acquire-item.cc:1530
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' does not seem to "
"provide it (sources.list entry misspelt?)"
msgstr ""
"Melewati mengambil berkas yang dikonfigurasi '%s' karena repositori '%s' "
"tampaknya tidak menyediakannya (entri sources.list salah eja?)"

#: apt-pkg/acquire-item.cc:1548
#, c-format
msgid ""
"Skipping acquire of configured file '%s' as repository '%s' provides only "
"weak security information for it"
msgstr ""
"Melewati mengambil berkas yang dikonfigurasi '%s' karena repositori '%s' "
"hanya memberikan informasi keamanan yang lemah untuk itu"

#. TRANSLATOR: The first %s is the URL of the bad Release file, the second is
#. the time since then the file is invalid - formatted in the same way as in
#. the download progress display (e.g. 7d 3h 42min 1s)
#: apt-pkg/acquire-item.cc:1659
#, c-format
msgid ""
"Release file for %s is expired (invalid since %s). Updates for this "
"repository will not be applied."
msgstr ""
"Berkas Release untuk %s telah kedaluwarsa (tidak valid sejak %s). Pembaruan "
"untuk repositori ini tidak akan diterapkan."

#. TRANSLATOR: The first %s is the URL of the bad Release file, the second is
#. the time until the file will be valid - formatted in the same way as in
#. the download progress display (e.g. 7d 3h 42min 1s)
#: apt-pkg/acquire-item.cc:1678
#, c-format
msgid ""
"Release file for %s is not valid yet (invalid for another %s). Updates for "
"this repository will not be applied."
msgstr ""
"Berkas Release untuk %s belum valid (tidak valid untuk %s lagi). Pembaruan "
"untuk repositori ini tidak akan diterapkan."

#: apt-pkg/acquire-item.cc:1713
#, c-format
msgid "Conflicting distribution: %s (expected %s but got %s)"
msgstr "Distribusi konflik: %s (diharapkan %s tetapi mendapat %s)"

#: apt-pkg/acquire-item.cc:1743
#, c-format
msgid "Repository '%s' changed its '%s' value from '%s' to '%s'"
msgstr "Repositori '%s' mengubah nilai '%s' dari '%s' ke '%s'"

#: apt-pkg/acquire-item.cc:1759
#, c-format
msgid "Repository '%s' changed its default priority for %s from %hi to %hi."
msgstr ""
"Repositori '%s' mengubah prioritas baku untuk %s dari %hi menjadi %hi."

#. TRANSLATOR: the "this" refers to changes in the repository like a new release or owner change
#: apt-pkg/acquire-item.cc:1772
#, c-format
msgid ""
"More information about this can be found online in the Release notes at: %s"
msgstr ""
"Informasi lebih lanjut tentang ini dapat ditemukan daring di Catatan rilis "
"pada: %s"

#. TRANSLATOR: %s is the name of the manpage in question, e.g. apt-secure(8)
#: apt-pkg/acquire-item.cc:1779
#, c-format
msgid ""
"This must be accepted explicitly before updates for this repository can be "
"applied. See %s manpage for details."
msgstr ""
"Ini harus diterima secara eksplisit sebelum pembaruan untuk repositori ini "
"dapat diterapkan. Lihat manual %s untuk detailnya."

#: apt-pkg/acquire-item.cc:1910 apt-pkg/update.cc:110 apt-pkg/update.cc:113
#, c-format
msgid "Failed to fetch %s  %s"
msgstr "Gagal mengambil %s  %s"

#: apt-pkg/acquire-item.cc:3338
#, c-format
msgid ""
"I wasn't able to locate a file for the %s package. This might mean you need "
"to manually fix this package. (due to missing arch)"
msgstr ""
"Tidak dapat menemukan berkas untuk paket %s. Artinya Anda harus memperbaiki "
"secara manual.(karena arsip hilang)"

#: apt-pkg/acquire-item.cc:3471
#, c-format
msgid "Can't find a source to download version '%s' of '%s'"
msgstr "Tidak dapat menemukan sumber untuk mengunduh versi '%s' dari '%s'"

#. TRANSLATOR: %s=%s is sourcename=sourceversion, e.g. apt=1.1
#: apt-pkg/acquire-item.cc:3629 apt-pkg/acquire-item.cc:3818
#, c-format
msgid "Changelog unavailable for %s=%s"
msgstr "Changelog tidak tersedia untuk %s=%s"

#: apt-pkg/acquire-worker.cc:102
#, c-format
msgid ""
"The method '%s' is unsupported and disabled by default. Consider switching "
"to http(s). Set Dir::Bin::Methods::%s to \"%s\" to enable it again."
msgstr ""
"Metode '%s' tidak didukung dan dinonaktifkan secara baku. Pertimbangkan "
"untuk beralih ke http(s). Atur Dir::Bin::Methods::%s ke \"%s\" untuk "
"memfungsikannya lagi."

#: apt-pkg/acquire-worker.cc:108
#, c-format
msgid "The method '%s' is explicitly disabled via configuration."
msgstr "Metode '%s' secara eksplisit dinonaktifkan melalui konfigurasi."

#: apt-pkg/acquire-worker.cc:110
#, c-format
msgid "If you meant to use Tor remember to use %s instead of %s."
msgstr ""
"Jika Anda bermaksud menggunakan Tor, ingatlah untuk menggunakan %s bukannya "
"%s."

#: apt-pkg/acquire-worker.cc:113
#, c-format
msgid "The method driver %s could not be found."
msgstr "Metode driver %s tidak ditemukan"

#: apt-pkg/acquire-worker.cc:117
#, c-format
msgid "Is the package %s installed?"
msgstr "Apakah paket %s diinstal?"

#: apt-pkg/acquire-worker.cc:172
#, c-format
msgid "Method %s did not start correctly"
msgstr "Metode %s tidak dapat dimulai dengan benar"

#: apt-pkg/acquire-worker.cc:677
#, c-format
msgid ""
"Please insert the disc labeled: '%s' in the drive '%s' and press [Enter]."
msgstr ""
"Harap masukkan cakram berlabel: '%s' ke dalam drive '%s' dan tekan [Enter]."

#: apt-pkg/acquire.cc:137 apt-pkg/acquire.cc:161 apt-pkg/cdrom.cc:833
#, c-format
msgid "List directory %s is missing."
msgstr "Direktori daftar %s hilang."

#: apt-pkg/acquire.cc:144 apt-pkg/acquire.cc:166
#, c-format
msgid "Archives directory %s is missing."
msgstr "Direktori arsip %s hilang."

#: apt-pkg/acquire.cc:184
#, c-format
msgid "Unable to lock directory %s"
msgstr "Tidak dapat mengunci direktori %s"

#: apt-pkg/acquire.cc:612
#, c-format
msgid "No sandbox user '%s' on the system, can not drop privileges"
msgstr ""
"Tidak ada pengguna sandbox '%s' di sistem, tidak dapat membatalkan hak "
"istimewa"

#: apt-pkg/acquire.cc:649 apt-pkg/acquire.cc:666
#, c-format
msgid ""
"Download is performed unsandboxed as root as file '%s' couldn't be accessed "
"by user '%s'."
msgstr ""
"Pengunduhan dilakukan tanpa sandbox sebagai root karena file '%s' tidak "
"dapat diakses oleh pengguna '%s'."

#: apt-pkg/acquire.cc:789 apt-pkg/clean.cc:40
#, c-format
msgid "Clean of %s is not supported"
msgstr "Membersihkan %s tidak didukung"

#. Only warn if there are no sources.list.d.
#. Only warn if there is no sources.list file.
#: apt-pkg/acquire.cc:793 apt-pkg/acquire.cc:796 apt-pkg/clean.cc:50
#: apt-pkg/clean.cc:60 apt-pkg/contrib/cdromutl.cc:190
#: apt-pkg/contrib/cdromutl.cc:212 apt-pkg/contrib/fileutl.cc:412
#: apt-pkg/contrib/fileutl.cc:414 apt-pkg/contrib/fileutl.cc:527
#: apt-pkg/contrib/fileutl.cc:3381 apt-pkg/deb/dpkgpm.cc:1394
#: apt-pkg/init.cc:223 apt-pkg/init.cc:231 apt-pkg/policy.cc:328
#: apt-pkg/sourcelist.cc:321 apt-pkg/sourcelist.cc:328
#, c-format
msgid "Unable to read %s"
msgstr "Tidak berhasil membaca %s"

#. only show the ETA if it makes sense
#. two days
#: apt-pkg/acquire.cc:1376
#, c-format
msgid "Retrieving file %li of %li (%s remaining)"
msgstr "Mengambil berkas %li dari %li ( tersisa %s)"

#: apt-pkg/acquire.cc:1378
#, c-format
msgid "Retrieving file %li of %li"
msgstr "Mengambil berkas %li dari %li"

#: apt-pkg/algorithms.cc:334
#, c-format
msgid ""
"The package %s needs to be reinstalled, but I can't find an archive for it."
msgstr ""
"Paket %s perlu diinstal ulang, tetapi tidak dapat ditemukan dalam arsip."

#: apt-pkg/algorithms.cc:1149
msgid ""
"Error, pkgProblemResolver::Resolve generated breaks, this may be caused by "
"held packages."
msgstr ""
"Galat, generate  pkgProblemResolver::Resolve terhenti, kemungkinan "
"disebabkan adanya paket yang memegangnya."

#: apt-pkg/algorithms.cc:1151
msgid "Unable to correct problems, you have held broken packages."
msgstr "Tidak berhasil memperbaiki problem, Anda memiliki paket yang rusak"

#: apt-pkg/cachefile.cc:130
msgid "The package lists or status file could not be parsed or opened."
msgstr "Daftar paket atau status berkas tidak dapat diuraikan atau dibuka."

#: apt-pkg/cachefile.cc:134
msgid "You may want to run apt-get update to correct these problems"
msgstr "Anda dapat menjalankan apt-get update untuk memperbaiki masalah ini"

#: apt-pkg/cachefile.cc:157
msgid "The list of sources could not be read."
msgstr "Senarai sumber tidak dapat dibaca."

#: apt-pkg/cachefilter.cc:44
#, c-format
msgid "Regex compilation error - %s"
msgstr "Kesalahan mengompilasi regex - %s"

#: apt-pkg/cacheset.cc:486
#, c-format
msgid "Release '%s' for '%s' was not found"
msgstr "Rilis '%s' untuk '%s' tidak ditemukan"

#: apt-pkg/cacheset.cc:489
#, c-format
msgid "Version '%s' for '%s' was not found"
msgstr "Versi '%s' untuk '%s' tidak ditemukan"

#: apt-pkg/cacheset.cc:724
#, c-format
msgid "Couldn't find task '%s'"
msgstr "Tidak dapat menemukan task '%s'"

#: apt-pkg/cacheset.cc:730
#, c-format
msgid "Couldn't find any package by regex '%s'"
msgstr "Tidak dapat menemukan paket apa pun dengan regex '%s'"

#: apt-pkg/cacheset.cc:736
#, c-format
msgid "Couldn't find any package by glob '%s'"
msgstr "Tidak dapat menemukan paket apa pun dari glob '%s'"

#: apt-pkg/cacheset.cc:748
#, c-format
msgid "Unable to locate package %s"
msgstr "Tidak dapat menemukan lokasi paket %s"

#: apt-pkg/cacheset.cc:775
#, c-format
msgid "Can't select versions from package '%s' as it is purely virtual"
msgstr "Tidak dapat memilih versi dari paket '%s' karena ini murni virtual"

#: apt-pkg/cacheset.cc:814
#, c-format
msgid "Can't select newest version from package '%s' as it is purely virtual"
msgstr ""
"Tidak dapat memilih versi terbaru dari paket '%s' karena ini murni virtual"

#: apt-pkg/cacheset.cc:822
#, c-format
msgid "Can't select candidate version from package %s as it has no candidate"
msgstr ""
"Tidak dapat memilih versi kandidat dari paket %s karena tidak memiliki "
"kandidat"

#: apt-pkg/cacheset.cc:830
#, c-format
msgid "Can't select installed version from package %s as it is not installed"
msgstr ""
"Tidak dapat memilih versi yang diinstal dari paket %s karena tidak diinstal"

#: apt-pkg/cacheset.cc:838 apt-pkg/cacheset.cc:846
#, c-format
msgid ""
"Can't select installed nor candidate version from package '%s' as it has "
"neither of them"
msgstr ""
"Tidak dapat memilih versi yang diinstal atau kandidat dari paket '%s' karena "
"tidak memiliki keduanya"

#: apt-pkg/cdrom.cc:498
#, c-format
msgid "Line %u too long in source list %s."
msgstr "Baris  %u terlalu panjang dalam daftar sumber %s."

#: apt-pkg/cdrom.cc:572
msgid "Unmounting CD-ROM...\n"
msgstr "Melepaskan kaitan CD-ROM...\n"

#: apt-pkg/cdrom.cc:587
#, c-format
msgid "Using CD-ROM mount point %s\n"
msgstr "Sedang menggunakan titik kait CD-ROM %s\n"

#: apt-pkg/cdrom.cc:600
msgid "Waiting for disc...\n"
msgstr "Menunggu cakram\n"

#: apt-pkg/cdrom.cc:610
msgid "Mounting CD-ROM...\n"
msgstr "Sedang Mengkait CD-ROM...\n"

#: apt-pkg/cdrom.cc:621
msgid "Identifying... "
msgstr "Mengenali... "

#: apt-pkg/cdrom.cc:663
#, c-format
msgid "Stored label: %s\n"
msgstr "Label penyimpanan: %s\n"

#: apt-pkg/cdrom.cc:681
msgid "Scanning disc for index files...\n"
msgstr "Memindai cakram untuk mencari berkas indeks...\n"

#: apt-pkg/cdrom.cc:735
#, c-format
msgid ""
"Found %zu package indexes, %zu source indexes, %zu translation indexes and "
"%zu signatures\n"
msgstr ""
"Menemukan %zu indek paket, %zu indek sumber, %zu indek translasi dan %zu "
"tanda tangan\n"

#: apt-pkg/cdrom.cc:745
msgid ""
"Unable to locate any package files, perhaps this is not a Debian Disc or the "
"wrong architecture?"
msgstr ""
"Tidak dapat menemukan berkas paket apa pun, mungkin ini bukan Cakram Debian "
"atau arsitektur yang salah?"

#: apt-pkg/cdrom.cc:772
#, c-format
msgid "Found label '%s'\n"
msgstr "Menemukan label '%s'\n"

#: apt-pkg/cdrom.cc:801
msgid "That is not a valid name, try again.\n"
msgstr "Nama tidak valid, coba lagi\n"

#: apt-pkg/cdrom.cc:818
#, c-format
msgid ""
"This disc is called: \n"
"'%s'\n"
msgstr ""
"Cakram ini disebut: \n"
"'%s'\n"

#: apt-pkg/cdrom.cc:820
msgid "Copying package lists..."
msgstr "Menyalin daftar paket..."

#: apt-pkg/cdrom.cc:867
msgid "Writing new source list\n"
msgstr "Menulis daftar sumber baru\n"

#: apt-pkg/cdrom.cc:878
msgid "Source list entries for this disc are:\n"
msgstr "Entri daftar sumber untuk cakram ini adalah:\n"

#: apt-pkg/clean.cc:56 apt-pkg/clean.cc:146
#, c-format
msgid "Unable to change to %s"
msgstr "Tidak dapat mengubah menjadi %s"

#: apt-pkg/clean.cc:76
#, c-format
msgid "Unable to stat %s."
msgstr "Tidak dapat menyatakan %s."

#: apt-pkg/contrib/cdromutl.cc:65
#, c-format
msgid "Unable to stat the mount point %s"
msgstr "Tidak dapat menentukan titik kait %s"

#: apt-pkg/contrib/cdromutl.cc:245
msgid "Failed to stat the cdrom"
msgstr "Gagal untuk menentukan cakram optik"

#: apt-pkg/contrib/cmndline.cc:127
#, c-format
msgid ""
"Command line option '%c' [from %s] is not understood in combination with the "
"other options."
msgstr ""
"Opsi baris perintah '%c' [dari %s] tidak dipahami dalam kombinasi bersama "
"dengan opsi lain."

#: apt-pkg/contrib/cmndline.cc:152 apt-pkg/contrib/cmndline.cc:161
#: apt-pkg/contrib/cmndline.cc:169
#, c-format
msgid ""
"Command line option %s is not understood in combination with the other "
"options"
msgstr ""
"Opsi baris perintah %s tidak dipahami dalam kombinasi bersama dengan opsi "
"lain"

#: apt-pkg/contrib/cmndline.cc:174
#, c-format
msgid "Command line option %s is not boolean"
msgstr "Pilihan baris perintah %s bukan boolean"

#: apt-pkg/contrib/cmndline.cc:230
#, c-format
msgid "Option %s requires an argument."
msgstr "Pilihan %s memerlukan argumen."

#: apt-pkg/contrib/cmndline.cc:243
#, c-format
msgid "Option %s: Configuration item specification must have an =<val>."
msgstr "Pilihan %s: Konfigurasi item yang ditentukan harus memiliki =<val>."

#: apt-pkg/contrib/cmndline.cc:269
#, c-format
msgid "Option %s requires an integer argument, not '%s'"
msgstr "Pilihan %s membutuhkan argument integer, tidak '%s'"

#: apt-pkg/contrib/cmndline.cc:300
#, c-format
msgid "Option '%s' is too long"
msgstr "Pilihan '%s' terlalu panjang"

#: apt-pkg/contrib/cmndline.cc:332
#, c-format
msgid "Sense %s is not understood, try true or false."
msgstr "Nilai %s tidak dimengerti, coba true atau false"

#: apt-pkg/contrib/cmndline.cc:380
#, c-format
msgid "Invalid operation %s"
msgstr "Operasi tidak valid %s"

#: apt-pkg/contrib/configuration.cc:721
#, c-format
msgid "Unrecognized type abbreviation: '%c'"
msgstr "Tidak mengenali tipe penyingkatan: '%c'"

#: apt-pkg/contrib/configuration.cc:1002
#, c-format
msgid "Syntax error %s:%u: Block starts with no name."
msgstr "Galat sintak %s:%u: Blok dimulai tanpa nama"

#: apt-pkg/contrib/configuration.cc:1016
#, c-format
msgid "Syntax error %s:%u: Malformed tag"
msgstr "Galat sintak %s:%u: tag cacat"

#: apt-pkg/contrib/configuration.cc:1033
#, c-format
msgid "Syntax error %s:%u: Extra junk after value"
msgstr "Galat sintak %s:%u: Nilai sampah setelah nilai."

#: apt-pkg/contrib/configuration.cc:1071
#, c-format
msgid "Syntax error %s:%u: Directives can only be done at the top level"
msgstr "Galat sintak %s:%u: Petunjuk hanya bisa dilakukan pada level teratas"

#: apt-pkg/contrib/configuration.cc:1078
#, c-format
msgid "Syntax error %s:%u: Too many nested includes"
msgstr "Galat sintak %s:%u: Terlalu banyak mencakup sarang"

#: apt-pkg/contrib/configuration.cc:1082 apt-pkg/contrib/configuration.cc:1087
#, c-format
msgid "Syntax error %s:%u: Included from here"
msgstr "Galat sintak %s:%u: dicakup dari sini"

#: apt-pkg/contrib/configuration.cc:1096
#, c-format
msgid "Syntax error %s:%u: Unsupported directive '%s'"
msgstr "Galat sintak %s:%u: Penunjuk tidak didukung '%s'"

#: apt-pkg/contrib/configuration.cc:1099
#, c-format
msgid ""
"Syntax error %s:%u: clear directive requires an option tree as argument"
msgstr ""
"Kesalahan sintaks %s:%u: direktir hapus membutuhkan suatu pohon opsi sebagai "
"argumen"

#: apt-pkg/contrib/configuration.cc:1143
#, c-format
