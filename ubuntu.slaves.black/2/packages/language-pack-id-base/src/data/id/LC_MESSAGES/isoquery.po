#. TRANSLATORS:
#. The first placeholder is a filename, including the directory path.
#. The second placeholder is an ISO standard, e.g. 3166-1 or 639-3.
#: src/isocodes.c:68
#, c-format
msgid "The file \"%s\" does not contain valid ISO %s data."
msgstr "Berkas \"%s\" tidak memuat data ISO %s yang valid."

#. TRANSLATORS: This is an error message.
#: src/isocodes.c:93 src/isoquery.c:43 src/isoquery.c:60 src/isoquery.c:70
#, c-format
msgid "isoquery: %s\n"
msgstr "isoquery: %s\n"

#: src/isoquery.c:45
msgid ""
"Run \"isoquery --help\" to see a full list of available command line "
"options.\n"
msgstr ""
"Jalankan \"isoquery --help\" untuk melihat daftar lengkap dari opsi baris "
"perintah yang tersedia.\n"

#: src/options.c:45
msgid ""
"The ISO standard to use. Possible values: 639-2, 639-3, 639-5, 3166-1, 3166-"
"2, 3166-3, 4217, 15924 (default: 3166-1)"
msgstr ""
"Standar ISO yang akan dipakai. Nilai yang mungkin: 639-2, 639-3, 639-5, 3166-"
"1, 3166-2, 3166-3, 4217, 15924 (baku: 3166-1)"

#: src/options.c:46
msgid "STANDARD"
msgstr "STANDAR"

#: src/options.c:48
msgid ""
"Use pathname as prefix for the data files (default: /usr/share/iso-"
"codes/json)"
msgstr ""
"Pakai nama path sebagai prefiks bagi berkas data (baku: /usr/share/iso-"
"codes/json)"

#: src/options.c:49
msgid "PATHNAME"
msgstr "NAMAPATH"

#: src/options.c:51
msgid "Use this locale for output"
msgstr "Pakai locale ini bagi keluaran"

#: src/options.c:52
msgid "LOCALE"
msgstr "LOCALE"

#: src/options.c:54
msgid "Name for the supplied codes (default)"
msgstr "Nama bagi kode yang diberikan (baku)"

#: src/options.c:56
msgid ""
"Official name for the supplied codes. This may be the same as --name (only "
"applies to ISO 3166-1)"
msgstr ""
"Nama resmi bagi kode yang diberikan. Ini mungkin sama dengan --name (hanya "
"berlaku bagi ISO 3166-1)"

#: src/options.c:60
msgid ""
"Common name for the supplied codes. This may be the same as --name (only "
"applies to ISO 639-2, 639-3, and 3166-1)"
msgstr ""
"Nama umum bagi kode yang diberikan. Ini mungkin sama dengan --name (hanya "
"berlaku bagi ISO 639-2, 639-3, dan 3166-1)"

#: src/options.c:63
msgid "Separate entries with a NULL character instead of newline"
msgstr "Pisahkan entri dengan karakter NULL bukan ganti baris"

#: src/options.c:65
msgid "Show program version and copyright"
msgstr "Tampilkan versi program dan hak cipta"

#: src/options.c:82
msgid "[ISO codes]"
msgstr "[kode ISO]"

#. TRANSLATORS: The placeholder is a string like "1234-5".
#: src/options.c:142
#, c-format
msgid "ISO standard \"%s\" is not supported."
msgstr "Standar ISO \"%s\" tidak didukung."

#. TRANSLATORS: The placeholder is the version identifier.
#: src/options.c:176
#, c-format
msgid "isoquery %s\n"
msgstr "isoquery %s\n"

#: src/options.c:177
msgid "Copyright © 2007-2016 Dr. Tobias Quathamer\n"
msgstr "Hak Cipta © 2007-2016 Dr. Tobias Quathamer\n"

#. TRANSLATORS: Please change the uppercase words as
#. appropriate for your language.
#: src/options.c:180
msgid "Translation to LANGUAGE Copyright © YEAR YOUR-NAME\n"
msgstr "Terjemahan ke Bahasa Indonesia Hak Cipta © 2014 Andika Triwidada\n"

#. TRANSLATORS: The first placeholder is a code like "urgl" or
#. "does-not-exist", the second placeholder is the current
#. ISO standard like "3166-1" or "15924".
#: src/search.c:60
#, c-format
msgid "The code \"%s\" is not defined in ISO %s."
msgstr "Kode \"%s\" tidak didefinisikan dalam ISO %s."
