#: src/vte.cc:7612
msgid "WARNING"
msgstr "সতর্কীকরণ"

#: src/vte.cc:7614
msgid "GnuTLS not enabled; data will be written to disk unencrypted!"
msgstr "GnuTLS সক্রিয় নয়; ড্যাটা ডিস্কে আন-এনক্রিপ্ট অবস্থায় জমা হবে!"

#: src/spawn.cc:124
#, c-format
msgid "Failed to set pipe nonblocking: %s"
msgstr "পাইপ নন-ব্লকিংঃ %s আরোপ করতে ব্যর্থ"

#: src/spawn.cc:169
#, c-format
msgid "poll error: %s"
msgstr "পল ত্রুটিঃ %s"

#: src/spawn.cc:176
msgid "Operation timed out"
msgstr "কার্যকলাপের সময় শেষ"

#: src/spawn.cc:186
msgid "Operation was cancelled"
msgstr "কার্যকলাপ বাতিল করা হয়েছে"

#: src/spawn.cc:204
#, c-format
msgid "Failed to read from child pipe (%s)"
msgstr "চাইল্ড-পাইপ থেকে পড়তে ব্যর্থ (%s)"

#: src/spawn.cc:639
#, c-format
msgid "Failed to change to directory “%s”: %s"
msgstr "ডিরেক্টরি “%s”: %s পরিবর্তন করতে ব্যর্থ"

#: src/spawn.cc:708
#, c-format
msgid "Failed to execute child process “%s”: "
msgstr "চাইল্ড-প্রসেস “%s”: সম্পাদন করতে ব্যর্থ "
