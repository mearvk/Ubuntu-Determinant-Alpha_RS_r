#: src/tmpl-parser.c:199
#, c-format
msgid "%s() may only be called once"
msgstr "%s()-কে হয়তবা একবারই অভিহিত করা যাবে"

#: src/tmpl-parser.c:211
#, c-format
msgid "Parser does not contain an input stream"
msgstr "পার্সারে ইনপুট স্ট্রিম নেই"

#: src/tmpl-template.c:454
#, c-format
msgid "Must parse template before expanding"
msgstr "প্রসারণের আগে অবশ্যই টেমপ্লেট পার্স করতে হবে"

#: src/tmpl-template-locator.c:117
#, c-format
msgid "Failed to locate template “%s”"
msgstr "টেমপ্লেট “%s” বের করা যাচ্ছে না"
