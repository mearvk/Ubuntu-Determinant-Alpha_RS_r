#: data/mousetweaks.ui:8
msgid "Hover Click"
msgstr "হোভার ক্লিক"

#: data/mousetweaks.ui:56
msgid "Single Click"
msgstr "একটি ক্লিক"

#: data/mousetweaks.ui:111
msgid "Double Click"
msgstr "দুইবার ক্লিক"

#. 'Drag' like in a Drag and Drop operation
#: data/mousetweaks.ui:166
msgid "Drag"
msgstr "টানা"

#: data/mousetweaks.ui:221
msgid "Secondary Click"
msgstr "সেকেন্ডারী ক্লিক"

#: data/mousetweaks.ui:249
msgid "Button Style"
msgstr "বোতামের ধরন"

#: data/mousetweaks.ui:257
msgid "Text only"
msgstr "শুধুমাত্র টেক্সট"

#: data/mousetweaks.ui:267
msgid "Icons only"
msgstr "শুধুমাত্র আইকন"

#: data/mousetweaks.ui:277
msgid "Text and Icons"
msgstr "টেক্সট এবং আইকন"

#: data/mousetweaks.ui:287
msgid "Orientation"
msgstr "দিকবিন্যাস"

#. Buttons are arranged from left to right in the layout
#: data/mousetweaks.ui:295
msgid "Horizontal"
msgstr "অনুভূমিক"

#. Buttons are arranged from top to bottom in the layout
#: data/mousetweaks.ui:305
msgid "Vertical"
msgstr "উল্লম্ব"

#: data/org.gnome.mousetweaks.gschema.xml:5
msgid "Click-type window style"
msgstr "ক্লিক-টাইপ উইন্ডো ধরণ"

#: data/org.gnome.mousetweaks.gschema.xml:6
msgid "Button style of the click-type window."
msgstr "ক্লিক-টাইপ উইন্ডোর বাটন ধরণ।"

#: data/org.gnome.mousetweaks.gschema.xml:10
msgid "Click-type window orientation"
msgstr "ক্লিক-টাইপ উইন্ডোর দিকবিন্যাস"

#: data/org.gnome.mousetweaks.gschema.xml:11
msgid "Orientation of the click-type window."
msgstr "ক্লিক-টাইপ উইন্ডো পরিচিতি।"

#: data/org.gnome.mousetweaks.gschema.xml:15 src/mt-main.c:638
msgid "Click-type window geometry"
msgstr "ক্লিক-টাইপ উইন্ডো জিওমেট্রি"

#: data/org.gnome.mousetweaks.gschema.xml:16
msgid ""
"Size and position of the click-type window. The format is a standard X "
"Window System geometry string."
msgstr ""
"ক্লিক-টাইপ উইন্ডোর আকৃতি এবং অবস্থান। ফরম্যাট হল আদর্শ X উইন্ডো সিস্টেম "
"জিওমেট্রি স্ট্রিং।"

#: src/mt-main.c:624
msgid "Enable dwell click"
msgstr "ডুওয়াল ক্লিক সক্রিয় করুন"

#: src/mt-main.c:626
msgid "Enable simulated secondary click"
msgstr "সেকেন্ডারী ক্লিকের সিমুলেশন সক্রিয় করুন"

#: src/mt-main.c:628
msgid "Time to wait before a dwell click"
msgstr "ডূওয়াল ক্লিকের জন্য কত সময় অপেক্ষা করা হবে"

#: src/mt-main.c:630
msgid "Time to wait before a simulated secondary click"
msgstr "দ্বিতীয় ক্লিকের অনুকরণের পূর্বে কত সময় অপেক্ষা করা হবে"

#: src/mt-main.c:632
msgid "Set the active dwell mode"
msgstr "সক্রিয় ডূওয়াল মোড নির্ধারণ করুন"

#: src/mt-main.c:634
msgid "Hide the click-type window"
msgstr "ক্লিক-টাইপ উইন্ডো আড়াল করুন"

#: src/mt-main.c:636
msgid "Ignore small pointer movements"
msgstr "পয়েন্টারের ক্ষুদ্র চলাচল উপক্ষা করা হবে"

#: src/mt-main.c:640
msgid "Shut down mousetweaks"
msgstr "মাউসটুইক বন্ধ করুন"

#: src/mt-main.c:642
#| msgid "- GNOME mousetweaks daemon"
msgid "Start mousetweaks as a daemon"
msgstr "ডেমন হিসেবে মাউসটুইক শুরু করা হবে"

#: src/mt-main.c:644
msgid "Start mousetweaks in login mode"
msgstr "লগইন মোডে মাউসটুইক শুরু করা হবে"

#: src/mt-main.c:662
msgid "- GNOME mouse accessibility daemon"
msgstr "- নোম মাউস ব্যবহারের ডেমন"

#: src/mt-main.c:814
msgid "Shutdown failed or nothing to shut down.\n"
msgstr "শাটডাউন দিতে ব্যর্থ হচ্ছে অথবা শাটডাউন করার মত কিছুই নেই।\n"

#: src/mt-main.c:816
msgid "Shutdown successful.\n"
msgstr "শাটডাউন সম্পন্ন।\n"

#: src/mt-main.c:824
#, c-format
msgid "Mousetweaks is already running. (PID %u)\n"
msgstr "মাউস-টুইক ইতোমধ্যেই চলছে।  (পিআইডি %u)\n"

#: src/mt-main.c:830
msgid "Starting daemon.\n"
msgstr "ডেমন চালু হচ্ছে।\n"

#: src/mt-common.c:97
msgid "Failed to Display Help"
msgstr "সহায়তা প্রদর্শন করতে ব্যর্থ"
