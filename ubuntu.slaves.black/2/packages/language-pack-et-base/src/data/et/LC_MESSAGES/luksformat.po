#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Seda programmi on vaja käivitada administraatorina\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Loo ja formaadi krüpteeritud LUKS seadet\n"
"\n"
"Kasuta: luksformat [-t <failisüsteem>] <seade> [mkfs valikud]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Viga: seade ühendatud: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Viga: vigane failisüsteem: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Viga: ei saa luua ajutist salvestatud seadet"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Luuakse krüpteeritud seadet %s...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Ei suudeta luua LUKS seadet %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Palun sisestage oma parool kinnitamiseks uuesti\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Parool, mida sisestasid, ei ole identne.\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Ei saa seadet formaatida koos failisüsteemi %s"
