#: dselect/install:33
msgid "Bad default setting!"
msgstr "Halb vaikesäte!"

#: dselect/install:52 dselect/install:84 dselect/install:88 dselect/install:95
#: dselect/install:106 dselect/update:45
msgid "Press [Enter] to continue."
msgstr "Vajuta sisestusklahvi (Enter), et jätkata."

#: dselect/install:92
msgid "Do you want to erase any previously downloaded .deb files?"
msgstr "Kas soovid kustutada kõik varem alla laaditud .deb-failid?"

#: dselect/install:102
msgid "Some errors occurred while unpacking. Packages that were installed"
msgstr "Lahtipakkimisel ilmnesid mõned vead. Paketid, mis olid paigaldatud"

#: dselect/install:103
msgid "will be configured. This may result in duplicate errors"
msgstr "konfigureeritakse. See võib põhjustada dubleerivaid vigu"

#: dselect/install:104
msgid "or errors caused by missing dependencies. This is OK, only the errors"
msgstr ""
"või puuduvatest sõltuvustest põhjustatud vead. See on OK, ainult vead"

#: dselect/install:105
msgid ""
"above this message are important. Please fix them and run [I]nstall again"
msgstr ""
"ülaltoodud sõnumid on olulised. Parandage need ja käivitage [I]installige "
"uuesti"

#: dselect/update:30
msgid "Merging available information"
msgstr "Saadaoleva teabe liitmine"
