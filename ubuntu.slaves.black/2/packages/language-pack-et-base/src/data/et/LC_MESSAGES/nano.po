#. TRANSLATORS: The next long series of strings are shortcut descriptions;
#. * they are best kept shorter than 56 characters, but may be longer.
#: src/global.c:546
msgid "Cancel the current function"
msgstr "Tühista praegune funktsioon"

#: src/global.c:547
msgid "Display this help text"
msgstr "Kuva see abitekst"

#: src/global.c:548
msgid "Close the current buffer / Exit from nano"
msgstr "Sulge praegune puhver / välju nanost"

#: src/global.c:550
msgid "Write the current buffer (or the marked region) to disk"
msgstr "Kirjuta praegune puhver (või märgitud piirkond) kettale"

#: src/global.c:552
msgid "Insert another file into current buffer (or into new buffer)"
msgstr "Sisesta mõni muu fail praegusesse puhvrisse (või uude puhvrisse)"

#: src/global.c:554
msgid "Search forward for a string or a regular expression"
msgstr "Otsi edasi stringi või regulaaravaldist"

#: src/global.c:556
msgid "Search backward for a string or a regular expression"
msgstr "Otsi tagasi stringi või regulaaravaldist"

#: src/global.c:558
msgid "Cut current line (or marked region) and store it in cutbuffer"
msgstr ""
"Lõika praegune joon (või märgitud piirkond) ja salvesta see lõikepuhvrisse"

#: src/global.c:560
msgid "Paste the contents of cutbuffer at current cursor position"
msgstr "Kleebi lõikepuhvri sisu kursori praegusesse asukohta"

#: src/global.c:561
msgid "Display the position of the cursor"
msgstr "Kuvage kursori asukoht"

#: src/global.c:563
msgid "Invoke the spell checker, if available"
msgstr "Ava õigekirjakontroll, kui see on saadaval"

#: src/global.c:565
msgid "Replace a string or a regular expression"
msgstr "Asenda string või regulaaravaldis"

#: src/global.c:566
msgid "Go to line and column number"
msgstr "Minge rea ja veeru numbrile"

#: src/global.c:568
msgid "Mark text starting from the cursor position"
msgstr "Märgi tekst alates kursori asukohast"

#: src/global.c:570
msgid "Copy current line (or marked region) and store it in cutbuffer"
msgstr ""
"Kopeeri praegune rida (või märgitud piirkond) ja salvesta see lõikepuhvrisse"

#: src/global.c:571
msgid "Throw away the current line (or marked region)"
msgstr "Viska praegune rida (või märgitud piirkond) minema"

#: src/global.c:572
msgid "Indent the current line (or marked lines)"
msgstr "Aktiivse rea (või märgitud joonte) taane"

#: src/global.c:573
msgid "Unindent the current line (or marked lines)"
msgstr "Tühista aktiivse rea (või märgitud ridade) taane"

#: src/global.c:574
msgid "Undo the last operation"
msgstr "Võta viimane operatsioon tagasi"

#: src/global.c:575
msgid "Redo the last undone operation"
msgstr "Korda viimast tagasivõetud toimingut"

#: src/global.c:577
msgid "Go back one character"
msgstr "Mine ühe tähemärgi võrra tagasi"

#: src/global.c:578
msgid "Go forward one character"
msgstr "Mine ühe tähemärgi võrra edasi"

#: src/global.c:579
msgid "Go back one word"
msgstr "Mine ühe sõna võrra tagasi"

#: src/global.c:580
msgid "Go forward one word"
msgstr "Mine ühe sõna võrra edasi"

#: src/global.c:581
msgid "Go to previous line"
msgstr "Mine eelmisele reale"

#: src/global.c:582
msgid "Go to next line"
msgstr "Mine järgmisele reale"

#: src/global.c:583
msgid "Go to beginning of current line"
msgstr "Mine praeguse rea algusesse"

#: src/global.c:584
msgid "Go to end of current line"
msgstr "Mine praeguse rea lõppu"

#: src/global.c:585
msgid "Go to previous block of text"
msgstr "Mine eelmise tekstiploki juurde"

#: src/global.c:586
msgid "Go to next block of text"
msgstr "Mine järgmise tekstiploki juurde"

#: src/global.c:589
msgid "Go to beginning of paragraph; then of previous paragraph"
msgstr "Mine lõigu algusesse; siis eelmisest lõigust"

#: src/global.c:591
msgid "Go just beyond end of paragraph; then of next paragraph"
msgstr "Mine veidi kaugemale lõigu lõpust; siis järgmisest lõigust"

#: src/global.c:593
msgid "Go one screenful up"
msgstr "Mine ühe ekraanitäie võrra üles"

#: src/global.c:594
msgid "Go one screenful down"
msgstr "Mine ekraanitäie võrra allapoole"

#: src/global.c:595
msgid "Go to the first line of the file"
msgstr "Mine faili esimesele reale"

#: src/global.c:596
msgid "Go to the last line of the file"
msgstr "Mine faili viimasele reale"

#: src/global.c:598
msgid "Go to the matching bracket"
msgstr "Mine sobivasse sulgu"

#: src/global.c:602
msgid "Scroll up one line without moving the cursor textually"
msgstr "Keri ühe rea võrra ülespoole kursorit tekstiliselt liigutamata"

#: src/global.c:604
msgid "Scroll down one line without moving the cursor textually"
msgstr "Keri ühe rea võrra allapoole kursorit tekstiliselt liigutamata"

#: src/global.c:605
msgid "Center the line where the cursor is"
msgstr "Joone keskele, kus asub kursor"

#: src/global.c:608
msgid "Switch to the previous file buffer"
msgstr "Lülitu eelmisele failipuhvrile"

#: src/global.c:609
msgid "Switch to the next file buffer"
msgstr "Lülitu järgmisele failipuhvrile"

#: src/global.c:611
msgid "Insert the next keystroke verbatim"
msgstr "Sisestage sõna-sõnalt järgmine klahvivajutus"

#: src/global.c:612
msgid "Insert a tab at the cursor position (or indent marked lines)"
msgstr "Tabeldusmärgi lisamine kursori asukohta (või märgitud joonte taane)"

#: src/global.c:613
msgid "Insert a newline at the cursor position"
msgstr "Sisesta kursori asukohta reavahetus"

#: src/global.c:614
msgid "Delete the character under the cursor"
msgstr "Kustutage kursori all olev märk"

#: src/global.c:616
msgid "Delete the character to the left of the cursor"
msgstr "Kustuta kursorist vasakul olev märk"

#: src/global.c:619
msgid "Delete backward from cursor to word start"
msgstr "Kustuta kursorilt tagasi sõna alguseni"

#: src/global.c:621
msgid "Delete forward from cursor to next word start"
msgstr "Kustuta kursorilt edasi järgmise sõna alguseni"

#: src/global.c:623
msgid "Cut from the cursor position to the end of the file"
msgstr "Lõika kursori asukohast faili lõpuni"

#: src/global.c:626
msgid "Justify the current paragraph"
msgstr "Joonda hetke lõik mõlemale poolele"

#: src/global.c:627
msgid "Justify the entire file"
msgstr "Joonda terve fail mõlemale poolele"

#: src/global.c:631
msgid "Count the number of lines, words, and characters"
msgstr "Loenda ridade, sõnade ja märkide arvu"

#: src/global.c:632
msgid "Suspend the editor (return to the shell)"
msgstr "Peata redaktor (naase kesta)"

#: src/global.c:634
msgid "Refresh (redraw) the current screen"
msgstr "Värskenda (taasjoonista) praegust ekraani"

#: src/global.c:636
msgid "Try and complete the current word"
msgstr "Proovi ja lõpeta praegune sõna"

#: src/global.c:640
msgid "Comment/uncomment the current line (or marked lines)"
msgstr "Kommenteeri/tühista praegust rida (või märgitud ridu)"

#: src/global.c:642
msgid "Save file without prompting"
msgstr "Salvestage fail ilma viibata"

#: src/global.c:643
msgid "Search next occurrence backward"
msgstr "Otsi järgmist esinemist tagasi"

#: src/global.c:644
msgid "Search next occurrence forward"
msgstr "Otsi järgmist esinemist edasi"

#: src/global.c:646
msgid "Start/stop recording a macro"
msgstr "Makro salvestamise alustamine/lõpetamine"

#: src/global.c:647
msgid "Run the last recorded macro"
msgstr "Käivita viimati salvestatud makro"

