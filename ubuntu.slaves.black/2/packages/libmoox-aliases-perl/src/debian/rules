include /usr/share/cdbs/1/rules/upstream-tarball.mk
include /usr/share/cdbs/1/rules/utils.mk
include /usr/share/cdbs/1/class/perl-makemaker.mk
include /usr/share/cdbs/1/rules/debhelper.mk

pkg = $(DEB_SOURCE_PACKAGE)

DEB_UPSTREAM_PACKAGE = MooX-Aliases
DEB_UPSTREAM_URL = http://www.cpan.org/modules/by-module/MooX

# Needed by upstream build process and (always) at runtime
deps = libclass-method-modifiers-perl, libstrictures-perl
deps +=, libmoo-perl (>= 1.001000)

# Needed by upstream testsuite
deps-test = libtest-fatal-perl
deps-test +=, perl (>= 5.11.1) | libtest-simple-perl (>= 0.94)

CDBS_BUILD_DEPENDS +=, $(deps), $(deps-test)
CDBS_DEPENDS_$(pkg) = $(deps)
