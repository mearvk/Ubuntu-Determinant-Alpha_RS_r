#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "Изађите након краћег застоја"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "Изађите након учитавања погона"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr "Замени старог демона"

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "Прикажите додатна обавештења прочишћавања"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "Поставите бројеве путања предмета за уређаје"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "Испишите све параметре за све предмете"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "Добавите податке о буђењу"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "Пратите активност из услужника напајања"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "Пратите са појединостима"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "Прикажите податке о путањи предмета"
