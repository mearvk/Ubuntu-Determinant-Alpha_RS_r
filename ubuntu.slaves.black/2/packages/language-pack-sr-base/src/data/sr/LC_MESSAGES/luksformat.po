#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Овај програм мора бити покренут као администраторски\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat — Направите и форматирајте шифроване ЛУКС уређаје\n"
"Употреба: luksformat [-t <систем датотека>] <уређај> [ mkfs опције]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Грешка: уређај је прикачен %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Грешка: неисправан систем датотека: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Грешка: не могу да створим привремени назив мапираног уређаја"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Правим шифровани уређај на „%s“...\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Не могу да направим ЛУКС уређај „%s“"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Још једном унесите вашу пропусну реч да је проверите\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "Пропусне речи које сте унели нису исте\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Не могу да форматирам уређај са системом датотека „%s“"
