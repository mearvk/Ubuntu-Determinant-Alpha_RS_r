#: ../Debconf/AutoSelect.pm:89
#, perl-format
msgid "falling back to frontend: %s"
msgstr "прелазим на резервног челника: %s"

#: ../Debconf/AutoSelect.pm:97
#, perl-format
msgid "unable to initialize frontend: %s"
msgstr "не могу да покренем челника: %s"

#: ../Debconf/AutoSelect.pm:103
#, perl-format
msgid "Unable to start a frontend: %s"
msgstr "Не могу да покренем челника: %s"

#: ../Debconf/Config.pm:131
msgid "Config database not specified in config file."
msgstr "База подешавања није наведена у датотеци подешавања."

#: ../Debconf/Config.pm:135
msgid "Template database not specified in config file."
msgstr "База шаблона није наведена у датотеци подешавања."

#: ../Debconf/Config.pm:140
msgid ""
"The Sigils and Smileys options in the config file are no longer used. Please "
"remove them."
msgstr ""
"Опције за магичне знакове и емотиконе се више не користе у датотеци "
"подешавања. Уклоните их."

#: ../Debconf/Config.pm:157
#, perl-format
msgid "Problem setting up the database defined by stanza %s of %s."
msgstr "Неприлика подешавања базе података одређене строфом „%s“ од „%s“."

#: ../Debconf/Config.pm:232
msgid ""
"  -f,  --frontend\t\tSpecify debconf frontend to use.\n"
"  -p,  --priority\t\tSpecify minimum priority question to show.\n"
"       --terse\t\t\tEnable terse mode.\n"
msgstr ""
"  -f,  --frontend\t\tНаводи челника дебконфа за коришћење.\n"
"  -p,  --priority\t\tНаводи најмању предност питања за приказ.\n"
"       --terse\t\t\tУкључује сажети начин рада.\n"

#: ../Debconf/Config.pm:312
#, perl-format
msgid "Ignoring invalid priority \"%s\""
msgstr "Занемарујем неисправну предност „%s“"

#: ../Debconf/Config.pm:313
#, perl-format
msgid "Valid priorities are: %s"
msgstr "Исправне предности су: %s"

#: ../Debconf/Element/Editor/Boolean.pm:30
#: ../Debconf/Element/Editor/Multiselect.pm:31
#: ../Debconf/Element/Editor/Select.pm:31
