#: ../aa_enabled.c:26
#, c-format
msgid ""
"%s: [options]\n"
"  options:\n"
"  -q | --quiet        Don't print out any messages\n"
"  -h | --help         Print help\n"
msgstr ""
"%s: [опције]\n"
"  опције:\n"
"  -q | --quiet        Не исписује никакве поруке\n"
"  -h | --help         Исписује помоћ\n"

#: ../aa_enabled.c:45
#, c-format
msgid "unknown or incompatible options\n"
msgstr "непознате или несагласне опције\n"

#: ../aa_enabled.c:55
#, c-format
msgid "unknown option '%s'\n"
msgstr "непозната опција „%s“\n"

#: ../aa_enabled.c:64
#, c-format
msgid "Yes\n"
msgstr "Da\n"

#: ../aa_enabled.c:71
#, c-format
msgid "No - not available on this system.\n"
msgstr "Не – није доступна на овом систему\n"

#: ../aa_enabled.c:74
#, c-format
msgid "No - disabled at boot.\n"
msgstr "Не – искључена је приликом подизања система.\n"

#: ../aa_enabled.c:77
#, c-format
msgid "Maybe - policy interface not available.\n"
msgstr "Можда – политика сучеља није доступна.\n"

#: ../aa_enabled.c:81
#, c-format
msgid "Maybe - insufficient permissions to determine availability.\n"
msgstr "Можда – недовољно овлашћења за одређивање доступности.\n"

#: ../aa_enabled.c:84
#, c-format
msgid "Error - '%s'\n"
msgstr "Грешка — „%s“\n"
