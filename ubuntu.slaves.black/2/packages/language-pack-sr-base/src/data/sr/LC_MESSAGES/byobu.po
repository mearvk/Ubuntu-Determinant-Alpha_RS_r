#: bin/menu:34 byobu-config:129 byobu-config:401 byobu-config:409
msgid "Menu"
msgstr "Изборник"

#: byobu-export:68 byobu-export:71 byobu-select-profile:104
#: byobu-select-profile:107
msgid "Choose"
msgstr "Изабери"

#: byobu-export:171
msgid "File exists"
msgstr "Датотека постоји"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "Да уклоним датотеку? [д/Н] "

#: byobu-export:199
msgid "Select a color: "
msgstr "Изаберите боју: "

#: byobu-export:240
msgid "Profile"
msgstr "Профил"

#: byobu-export:241
msgid "Archive"
msgstr "Архива"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Распакујте архиву у вашој личној фасцикли на циљном систему."

#: byobu-select-profile:49
msgid "Error:"
msgstr "Грешка:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " датотека постоји, али није симболичка веза"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "Изаберите профил екрана: "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "ГРЕШКА: Неисправан избор"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"Ако користите подразумевани скуп свеза тастера, притисните\\n<Ф5> да "
"активирате измене.\\n\\nУ супротном, напустите ову сесију екрана и покрените "
"нову."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Покрените „byobu“ да активирате"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Бјоби се тренутно покреће при пријављивању (искључи)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Бјоби се тренутно не покреће при пријављивању (укључи)"

#: byobu-config:89
msgid "Help"
msgstr "Помоћ"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "Измени боју Бјобија"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Окини обавештења стања"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Измени скуп свеза тастера"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Измени низ промене"

#: byobu-config:94
msgid "Create new windows"
msgstr "Направи нови прозор"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Управљај основним прозором"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " Изборник подешавања Бјобија"

#: byobu-config:110
msgid "Okay"
msgstr "У реду"

#: byobu-config:110 byobu-config:144 byobu-config:161 byobu-config:195
#: byobu-config:335 byobu-config:376 byobu-config:449
msgid "Cancel"
msgstr "Откажи"

#: byobu-config:130
msgid "Byobu Help"
msgstr "Бјобијева помоћ"

#: byobu-config:144 byobu-config:161 byobu-config:195 byobu-config:335
#: byobu-config:376 byobu-config:449
msgid "Apply"
msgstr "Примени"

#: byobu-config:146
msgid "Which profile would you like to use?"
msgstr "Који профил желите да користите?"

#: byobu-config:162
msgid "Which set of keybindings would you like to use?"
msgstr "Који скуп свеза тастера желите да користите?"

#: byobu-config:175
msgid "Title: "
msgstr "Наслов: "

#: byobu-config:177
msgid "Command: "
msgstr "Наредба: "

#: byobu-config:179
msgid "Presets: "
msgstr "Подешености: "

#: byobu-config:193
msgid "Add to default windows"
msgstr "Додај основном прозору"

#: byobu-config:197
msgid "Create new window(s):"
msgstr "Направи нови прозор:"

#: byobu-config:336
msgid "Toggle status notifications:"
msgstr "Окини обавештења стања:"

#: byobu-config:368
msgid "Windows:"
msgstr "Прозори:"

#: byobu-config:378
msgid "Select window(s) to create by default:"
msgstr "Изабери прозор за стварање по основи:"

#: byobu-config:398
msgid "Byobu will be launched automatically next time you login."
msgstr "Бјоби ће се сам покренути приликом следећег пријављивања на систем."

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "Бјоби се неће користити приликом следећег пријављивања."

#: byobu-config:408
msgid "Message"
msgstr "Порука"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "Тастер промене: ктрл-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "Измени низ промене:"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr "<Tab>/<Алт-Таб> између елемената | <Унеси> бира | <Есц> излази"
