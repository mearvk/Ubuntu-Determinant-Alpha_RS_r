#: ../sos/sosreport.py:745
#, python-format
msgid "sosreport (version %s)"
msgstr "sosreport (издање %s)"

#: ../sos/sosreport.py:977
#, python-format
msgid "plugin %s does not validate, skipping"
msgstr "прикључак „%s“ се није оверио, прескачем"

#: ../sos/sosreport.py:979
msgid "does not validate"
msgstr "не оверавај"

#: ../sos/sosreport.py:983
#, python-format
msgid "plugin %s requires root permissions to execute, skipping"
msgstr ""

#: ../sos/sosreport.py:985
msgid "requires root"
msgstr "захтева администратора"

#: ../sos/sosreport.py:993
msgid "excluded"
msgstr "изузет"

#: ../sos/sosreport.py:997
msgid "skipped"
msgstr "прескочен"

#: ../sos/sosreport.py:1001
msgid "inactive"
msgstr "неактиван"

#: ../sos/sosreport.py:1005
msgid "optional"
msgstr "изборни"

#: ../sos/sosreport.py:1015
msgid "not specified"
msgstr "ненаведен"

#: ../sos/sosreport.py:1023
#, python-format
msgid "plugin %s does not install, skipping: %s"
msgstr "прикључак „%s“ се није инсталирао, прескачем: %s"

#: ../sos/sosreport.py:1027
#, python-format
msgid "Unknown or inactive profile(s) provided: %s"
msgstr "Неппознат или неактиван профил је достављен: %s"

#: ../sos/sosreport.py:1120
msgid "no valid plugins found"
msgstr "нисам нашао исправне прикључке"

#: ../sos/sosreport.py:1124
msgid "The following plugins are currently enabled:"
msgstr "Следећи прикључци су тренутно укључени:"

#: ../sos/sosreport.py:1130
msgid "No plugin enabled."
msgstr "Нема укључених прикључака."

#: ../sos/sosreport.py:1134
msgid "The following plugins are currently disabled:"
msgstr "Следећи прикључци су тренутно искључени:"

#: ../sos/sosreport.py:1145
msgid "The following plugin options are available:"
msgstr "Следеће опције прикључка су доступне:"

#: ../sos/sosreport.py:1160
msgid "No plugin options available."
msgstr "Нема доступних опција прикључка."

#: ../sos/sosreport.py:1172
msgid "no valid profiles found"
msgstr "нисам нашао исправне профиле"

#: ../sos/sosreport.py:1174
msgid "The following profiles are available:"
msgstr "Следећи профили су доступни:"

#: ../sos/sosreport.py:1197
msgid "Press ENTER to continue, or CTRL-C to quit.\n"
msgstr "Притисните УНЕСИ да наставите, или „CTRL-C“ да изађете.\n"

#: ../sos/sosreport.py:1216
msgid " Setting up archive ..."
msgstr " Постављам архиву ..."

#: ../sos/sosreport.py:1250
msgid " Setting up plugins ..."
msgstr " Постављам прикључке ..."

#: ../sos/sosreport.py:1282
msgid " Running plugins. Please wait ..."
msgstr " Покрећем прикључке. Сачекајте ..."

#: ../sos/sosreport.py:1490
msgid "Creating compressed archive..."
msgstr "Правим запаковану архиву..."

#: ../sos/sosreport.py:1498
#, python-format
msgid " %s while finalizing archive"
msgstr " %s приликом довршавања архиве"

#: ../sos/sosreport.py:1517
#, python-format
msgid "Error moving directory: %s"
msgstr "Грешка премештања директоријума: %s"

#: ../sos/sosreport.py:1540
#, python-format
msgid "Error moving archive file: %s"
msgstr "Грешка премештања датотеке архиве: %s"

#: ../sos/sosreport.py:1558
#, python-format
msgid "Error moving checksum file: %s"
msgstr "Грешка премештања датотеке суме провере: %s"

#: ../sos/sosreport.py:1574
msgid "no valid plugins were enabled"
msgstr "нису укључени исправни прикључци"
