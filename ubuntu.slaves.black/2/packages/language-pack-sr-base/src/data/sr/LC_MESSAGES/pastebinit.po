#: ../pastebinit:126
msgid "%s: no section [pastebin]"
msgstr "%s: нема избора [pastebin]"

#: ../pastebinit:131
msgid "%s: no 'basename' in [pastebin]"
msgstr "%s: нема „basename“ у [pastebin]"

#: ../pastebinit:139
#, docstring
msgid "Return the parameters array for the selected pastebin"
msgstr "Исписује низ параметара за изабрано ведро убацивања"

#: ../pastebinit:154
msgid ""
"Unknown website, please post a bugreport to request this pastebin to be "
"added (%s)"
msgstr ""
"Непознат веб сајт, објавите извештај о грешци да затражите додавање овог "
"ведра убацивања (%s)"

#: ../pastebinit:204
msgid "Reads on stdin for input or takes a list of filenames as parameters"
msgstr ""
"Чита уносе са стандардног улаза или узима списак назива датотека као "
"параметре"

#: ../pastebinit:206
msgid "Optional arguments (not supported by all pastebins):"
msgstr "Изборни аргументи (не подржавају их сва ведра убацивања):"

#: ../pastebinit:208
msgid "\t-a <author:default is '%s'>"
msgstr "\t-a <аутор:основно је „%s“>"

#: ../pastebinit:209
msgid "\t-b <pastebin url:default is '%s'>"
msgstr "\t-b <адреса ведра убацивања:основно је „%s“>"

#: ../pastebinit:210
msgid "\t-f <format of paste:default is '%s'>"
msgstr "\t-f <формат убацивања:основно је „%s“>"

#: ../pastebinit:211
msgid "\t-h This help screen"
msgstr "\t-h Приказује овај екран помоћи"

#: ../pastebinit:197
msgid "\t-i <input file>"
msgstr "\t-i <улазна датотека>"

#: ../pastebinit:198
msgid "\t-l List all supported pastebins"
msgstr "\t-l Исписује сва подржана ведра убацивања"

#: ../pastebinit:214
msgid "\t-j <jabberid for notifications:default is '%s'>"
msgstr "\t-j <џабериб за обавештења:основно је „%s“>"

#: ../pastebinit:216
msgid "\t-m <permatag for all versions of a post:default is blank>"
msgstr "\t-m <перматаг за сва издања објаве:основно је празно>"

#: ../pastebinit:218
msgid "\t-r <parent posts ID:defaults to none>"
msgstr "\t-r <ИБ почетних објава:основно је ништа>"

#: ../pastebinit:219
msgid "\t-t <title of paste:default is blank>"
msgstr "\t-t <наслов убацивања:основно је празно>"

#: ../pastebinit:216
msgid "\t-u <username> -p <password>"
msgstr "\t-u <корисник> -p <лозинка>"

#: ../pastebinit:201
msgid "\t-v Print the version number"
msgstr "\t-v Исписује број издања"

#: ../pastebinit:254 ../pastebinit:277 ../pastebinit:291 ../pastebinit:362
#: ../pastebinit:464 ../pastebinit:473
msgid "KeyboardInterrupt caught."
msgstr "Ухваћен је прекид тастатуре."

#: ../pastebinit:280
msgid "Error parsing configuration file!"
msgstr "Грешка обраде датотеке подешавања!"

#: ../pastebinit:281
msgid ""
"Please ensure that your configuration file looks similar to the following:"
msgstr "Уверите се да ваша датотека подешавања изгледа слично као следеће:"

#: ../pastebinit:288
msgid "Invalid arguments!\n"
msgstr "Неисправни аргументи!\n"

#: ../pastebinit:310
msgid "Supported pastebins:"
msgstr "Подржана ведра убацивања:"

#: ../pastebinit:365
msgid "Unable to read from: %s"
msgstr "Не могу да читам из: %s"

#: ../pastebinit:369
msgid "You are trying to send an empty document, exiting."
msgstr "Покушавате да пошаљете празан документ, излазим."

#: ../pastebinit:414
msgid "The content you are trying to send exceeds the pastebin's size limit."
msgstr ""
"Садржај који покушавате да пошаљете превазилази ограничење величине ведра "
"убацивања."

#: ../pastebinit:403
msgid "Could not find any json library."
msgstr "Не могу да нађем никакву јсон библиотеку."

#: ../pastebinit:438
msgid "Failed to contact the server: %s"
msgstr "Нисам успео да ступим у везу са сервером: %s"

#: ../pastebinit:467
msgid ""
"Unable to read or parse the result page, it could be a server timeout or a "
"change server side, try with another pastebin."
msgstr ""
"Не могу да прочитам или да обрадим страницу резултата, може бити да је "
"истекло време серверу или услед промене од стране сервера, пробајте са "
"другим ведром убацивања."
