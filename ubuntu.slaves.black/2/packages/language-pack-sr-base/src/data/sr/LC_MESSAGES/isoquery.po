#. TRANSLATORS:
#. The first placeholder is a filename, including the directory path.
#. The second placeholder is an ISO standard, e.g. 3166-1 or 639-3.
#: src/isocodes.c:68
#, c-format
msgid "The file \"%s\" does not contain valid ISO %s data."
msgstr "Датотека „%s“ не садржи исправне ИСО %s податке."

#. TRANSLATORS: This is an error message.
#: src/isocodes.c:93 src/isoquery.c:43 src/isoquery.c:60 src/isoquery.c:70
#, c-format
msgid "isoquery: %s\n"
msgstr "isoquery: %s\n"

#: src/isoquery.c:45
msgid ""
"Run \"isoquery --help\" to see a full list of available command line "
"options.\n"
msgstr ""
"Покрените „isoquery --help“ да видите читав списак доступних могућности "
"линије наредби.\n"

#: src/options.c:45
msgid ""
"The ISO standard to use. Possible values: 639-2, 639-3, 639-5, 3166-1, 3166-"
"2, 3166-3, 4217, 15924 (default: 3166-1)"
msgstr ""
"ИСО стандард за коришћење. Могуће вредности: 639-2, 639-3, 639-5, 3166-1, "
"3166-2, 3166-3, 4217, 15924 (основно: 3166-1)"

#: src/options.c:46
msgid "STANDARD"
msgstr "СТАНДАРД"

#: src/options.c:48
msgid ""
"Use pathname as prefix for the data files (default: /usr/share/iso-"
"codes/json)"
msgstr ""
"Користи назив путање као префикс за датотеке података (основно: "
"/usr/share/iso-codes/json)"

#: src/options.c:49
msgid "PATHNAME"
msgstr "НАЗИВ_ПУТАЊЕ"

#: src/options.c:51
msgid "Use this locale for output"
msgstr "Користи овај језик за излаз"

#: src/options.c:52
msgid "LOCALE"
msgstr "ЈЕЗИК"

#: src/options.c:54
msgid "Name for the supplied codes (default)"
msgstr "Назив за достављене кодове (основно)"

#: src/options.c:56
msgid ""
"Official name for the supplied codes. This may be the same as --name (only "
"applies to ISO 3166-1)"
msgstr ""
"Званичан назив за достављене кодове. Ово може бити исто као „--name“ "
"(примењује се само на ИСО 3166-1)"

#: src/options.c:60
msgid ""
"Common name for the supplied codes. This may be the same as --name (only "
"applies to ISO 639-2, 639-3, and 3166-1)"
msgstr ""
"Општи назив за достављене кодове. Ово може бити исто као „--name“ (примењује "
"се само на ИСО 639-2, 639-3 и 3166-1)"

#: src/options.c:63
msgid "Separate entries with a NULL character instead of newline"
msgstr "Раздваја уносе знаком НИШТИЦЕ уместо новим редом"

#: src/options.c:65
msgid "Show program version and copyright"
msgstr "Приказује издање програма и ауторска права"

#: src/options.c:82
msgid "[ISO codes]"
msgstr "[ИСО кодови]"

#. TRANSLATORS: The placeholder is a string like "1234-5".
#: src/options.c:142
#, c-format
msgid "ISO standard \"%s\" is not supported."
msgstr "ИСО стандард „%s“ није подржан."

#. TRANSLATORS: The placeholder is the version identifier.
#: src/options.c:176
#, c-format
msgid "isoquery %s\n"
msgstr "isoquery %s\n"

#: src/options.c:177
msgid "Copyright © 2007-2016 Dr. Tobias Quathamer\n"
msgstr "Ауторска права © 2007-2016 Др. Тобијас Кватамер\n"

#. TRANSLATORS: Please change the uppercase words as
#. appropriate for your language.
#: src/options.c:180
msgid "Translation to LANGUAGE Copyright © YEAR YOUR-NAME\n"
msgstr ""
"Превод на СРПСКИ Ауторска права © 2020. Мирослав Николић "
"„nikolicmiroslav@rocketmail.com“\n"

#. TRANSLATORS: The first placeholder is a code like "urgl" or
#. "does-not-exist", the second placeholder is the current
#. ISO standard like "3166-1" or "15924".
#: src/search.c:60
#, c-format
msgid "The code \"%s\" is not defined in ISO %s."
msgstr "Код „%s“ није дефинисан у ИСО %s."
