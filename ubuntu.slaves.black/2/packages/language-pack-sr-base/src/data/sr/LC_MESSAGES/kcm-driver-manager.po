#: Module.cpp:77
msgctxt "@title/rich"
msgid "<title>Your computer requires no proprietary drivers</title>"
msgstr "<title>Ваш рачунар не захтева власничке управљачке програме</title>"

#: Module.cpp:130
msgctxt ""
"The backend is trying to figure out what drivers are suitable for the users "
"system"
msgid "Collecting information about your system"
msgstr "Прикупљам податке о вашем систему"

#: Module.cpp:220 DriverManager.cpp:248
msgctxt "@label"
msgid ""
"The package system could not be initialized, your configuration may be "
"broken."
msgstr ""
"Систем пакета не може бити покренут, можда вам је оштећено подешавање."

#: Module.cpp:232
msgctxt "The backend replied with a error"
msgid ""
"Something went terribly wrong. Please hit the 'Refresh Driver List' button"
msgstr ""
"Нешто је пошло наопако. Притисните дугме „Освежи списак управљачких програма“"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr " ,Launchpad Contributions:,Мирослав Николић"

#: rc.cpp:2
