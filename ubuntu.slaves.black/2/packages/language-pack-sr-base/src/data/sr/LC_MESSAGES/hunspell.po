#: src/tools/hunspell.cxx:1826
msgid "Usage: hunspell [OPTION]... [FILE]...\n"
msgstr "Коришћење: hunspell [ОПЦИЈА]... [ДАТОТЕКА]...\n"

#: src/tools/hunspell.cxx:1827
msgid ""
"Check spelling of each FILE. Without FILE, check standard input.\n"
"\n"
msgstr ""
"Проверава писање у свакој ДАТОТЕЦИ. Без ДАТОТЕКЕ, проверава стандардни "
"улаз.\n"
"\n"

#: src/tools/hunspell.cxx:1829
msgid "  -1\t\tcheck only first field in lines (delimiter = tabulator)\n"
msgstr ""
"  -1\t\tпроверава само прво поље у редовима (граничник = табулатор)\n"

#: src/tools/hunspell.cxx:1831
msgid "  -a\t\tIspell's pipe interface\n"
msgstr "  -a\t\tсучеље спојке „Ispell“-а\n"

#: src/tools/hunspell.cxx:1832
msgid "  --check-url\tcheck URLs, e-mail addresses and directory paths\n"
msgstr ""
"  --check-url\tпроверава интернет адресе, адресе е-поште и путање "
"директоријума\n"

#: src/tools/hunspell.cxx:1837
msgid "  --check-apostrophe\tcheck Unicode typographic apostrophe\n"
msgstr "  --check-apostrophe\tпроверава типографски апостроф Јуникода\n"

#: src/tools/hunspell.cxx:1839
msgid "  -d d[,d2,...]\tuse d (d2 etc.) dictionaries\n"
msgstr "  -d d[,d2,...]\tкористи d (d2 итд.) речника\n"

#: src/tools/hunspell.cxx:1840
msgid "  -D\t\tshow available dictionaries\n"
msgstr "  -D\t\tприказује доступне речнике\n"

#: src/tools/hunspell.cxx:1841
msgid "  -G\t\tprint only correct words or lines\n"
msgstr "  -G\t\tисписује само исправне речи или редове\n"

#: src/tools/hunspell.cxx:1842
msgid "  -h, --help\tdisplay this help and exit\n"
msgstr "  -h, --help\tприказује ову помоћ и излази\n"

#: src/tools/hunspell.cxx:1843
msgid "  -H\t\tHTML input file format\n"
msgstr "  -H\t\tформат „HTML“ улазне датотеке\n"

#: src/tools/hunspell.cxx:1844
msgid "  -i enc\tinput encoding\n"
msgstr "  -i код\tулазно кодирање\n"

#: src/tools/hunspell.cxx:1845
msgid "  -l\t\tprint misspelled words\n"
msgstr "  -l\t\tисписује погрешне речи\n"

#: src/tools/hunspell.cxx:1846
msgid "  -L\t\tprint lines with misspelled words\n"
msgstr "  -L\t\tисписује редове са погрешним речима\n"

#: src/tools/hunspell.cxx:1848
msgid "  -m \t\tanalyze the words of the input text\n"
msgstr "  -m \t\tанализира речи улазног текста\n"

#: src/tools/hunspell.cxx:1849
msgid "  -n\t\tnroff/troff input file format\n"
msgstr "  -n\t\tформат „nroff/troff“ улазне датотеке\n"

#: src/tools/hunspell.cxx:1853
msgid "  -O\t\tOpenDocument (ODF or Flat ODF) input file format\n"
msgstr ""
"  -O\t\tформат улазне датотеке Отвореног документа (ОДФ или Обичан ОДФ)\n"

#: src/tools/hunspell.cxx:1854
msgid "  -p dict\tset dict custom dictionary\n"
msgstr "  -p речн\tпоставља произвољни речник „dict“-а\n"

#: src/tools/hunspell.cxx:1856
msgid "  -r\t\twarn of the potential mistakes (rare words)\n"
msgstr "  -r\t\tупозорава о могућим погрешкама (ретке речи)\n"

#: src/tools/hunspell.cxx:1859
msgid "  -P password\tset password for encrypted dictionaries\n"
msgstr "  -P лозинка\tпоставља лозинку за шифроване речнике\n"

#: src/tools/hunspell.cxx:1860
msgid "  -s \t\tstem the words of the input text\n"
msgstr "  -s \t\tоснове речи улазног текста\n"

#: src/tools/hunspell.cxx:1861
msgid "  -S \t\tsuffix words of the input text\n"
msgstr "  -S \t\tдодаје суфикс на речи улазног текста\n"

#: src/tools/hunspell.cxx:1862
msgid "  -t\t\tTeX/LaTeX input file format\n"
msgstr "  -t\t\tформат „TeX/LaTeX“ улазне датотеке\n"

#: src/tools/hunspell.cxx:1863
msgid "  -v, --version\tprint version number\n"
msgstr "  -v, --version\tисписује број издања\n"

#: src/tools/hunspell.cxx:1865
msgid "  -vv\t\tprint Ispell compatible version number\n"
msgstr "  -vv\t\tисписује „Ispell“ сагласан број издања\n"

#: src/tools/hunspell.cxx:1866
msgid "  -w\t\tprint misspelled words (= lines) from one word/line input.\n"
msgstr ""
"  -w\t\tисписује погрешно написане речи (= редове) из једног улаза "
"речи/реда.\n"

#: src/tools/hunspell.cxx:1868
msgid ""
"  -X\t\tXML input file format\n"
"\n"
msgstr ""
"  -X\t\tформат „XML“ улазне датотеке\n"
"\n"

#: src/tools/hunspell.cxx:1872
msgid ""
"Example: hunspell -d en_US file.txt    # interactive spelling\n"
"         hunspell -i utf-8 file.txt    # check UTF-8 encoded file\n"
"         hunspell -l *.odt             # print misspelled words of ODF "
"files\n"
"\n"
"         # Quick fix of ODF documents by personal dictionary creation\n"
"\n"
"         # 1 Make a reduced list from misspelled and unknown words:\n"
"\n"
"         hunspell -l *.odt | sort | uniq >words\n"
"\n"
"         # 2 Delete misspelled words of the file by a text editor.\n"
"         # 3 Use this personal dictionary to fix the deleted words:\n"
"\n"
"         hunspell -p words *.odt\n"
"\n"
msgstr ""
"Пример:  hunspell -d en_US датотека.txt    # међудејствена провера писања\n"
"         hunspell -i utf-8 датотека.txt    # проверава УТФ-8 кодиране "
"датотеке\n"
"         hunspell -l *.odt                 # исписује лоше написане речи ОДФ "
"датотека\n"
"\n"
"         # Брза поправка ОДФ докумената стварањем личног речника\n"
"\n"
"         # 1 Прави умањени списак од лоше написаних и непознатих речи:\n"
"\n"
"         hunspell -l *.odt | sort | uniq >words\n"
"\n"
"         # 2 Брише лоше написаних речи датотеке уређивачем текста.\n"
"         # 3 Користи овај лични речник да поправи обрисане речо:\n"
"\n"
"         hunspell -p words *.odt\n"
"\n"

