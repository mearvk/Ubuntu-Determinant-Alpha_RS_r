#: src/tools/hunspell.cxx:1275
msgid ""
"Whenever a word is found that is not in the dictionary\n"
"it is printed on the first line of the screen.  If the dictionary\n"
"contains any similar words, they are listed with a number\n"
"next to each one.  You have the option of replacing the word\n"
"completely, or choosing one of the suggested words.\n"
msgstr ""
"Кад год се нађе реч која није у речнику исписује\n"
"се на првом реду екрана. Ако речник садржи неке\n"
"сличне речи, исписују се са бројем поред сваке\n"
"од њих. Имате могућност да у потпуности замените\n"
"реч, или да изаберете једну од предложених речи.\n"

#: src/tools/hunspell.cxx:1281
msgid ""
"\n"
"Commands are:\n"
"\n"
msgstr ""
"\n"
"Наредбе су:\n"
"\n"

#: src/tools/hunspell.cxx:1282
msgid "R\tReplace the misspelled word completely.\n"
msgstr "R\tЗамењује у потпуности погрешно написану реч.\n"

#: src/tools/hunspell.cxx:1283
msgid "Space\tAccept the word this time only.\n"
msgstr "Размак\tПрихвата реч само овај пут.\n"

#: src/tools/hunspell.cxx:1285
msgid "A\tAccept the word for the rest of this session.\n"
msgstr "A\tПрихвата реч до краја ове сесије.\n"

#: src/tools/hunspell.cxx:1287
msgid "I\tAccept the word, and put it in your private dictionary.\n"
msgstr "I\tПрихвата реч, и ставља је у ваш лични речник.\n"

#: src/tools/hunspell.cxx:1289
msgid "U\tAccept and add lowercase version to private dictionary.\n"
msgstr "U\tПрихвата и додаје издање са малим словом у лични речник.\n"

#: src/tools/hunspell.cxx:1291
msgid ""
"S\tAsk a stem and a model word and store them in the private dictionary.\n"
"\tThe stem will be accepted also with the affixes of the model word.\n"
msgstr ""
"S\tТражи реч основе и узора и чува их у личном речнику.\n"
"\tОснова ће бити прихваћена ракође и са афиксима речи узора.\n"

#: src/tools/hunspell.cxx:1295
msgid "0-n\tReplace with one of the suggested words.\n"
msgstr "0-n\tЗамењује једном од предложених речи.\n"

#: src/tools/hunspell.cxx:1297
msgid ""
"X\tWrite the rest of this file, ignoring misspellings, and start next file.\n"
msgstr ""
"X\tПише остатак ове датотеке, занемарујући погрешке у писању, и започиње "
"следећу датотеку.\n"

#: src/tools/hunspell.cxx:1300
msgid "Q\tQuit immediately. Asks for confirmation. Leaves file unchanged.\n"
msgstr "Q\tИзлази одмах. Тражи потврђивање. Оставља датотеку неизмењеном.\n"

#: src/tools/hunspell.cxx:1302
msgid "^Z\tSuspend program. Restart with fg command.\n"
msgstr "^Z\tОбуставља програм. Поново покреће наредбом „fg“.\n"

#: src/tools/hunspell.cxx:1303
msgid "?\tShow this help screen.\n"
msgstr "?\tПриказује овај прозор помоћи.\n"

#: src/tools/hunspell.cxx:1304
msgid ""
"\n"
"-- Type space to continue -- \n"
msgstr ""
"\n"
"– Унесите размак да наставите – \n"

