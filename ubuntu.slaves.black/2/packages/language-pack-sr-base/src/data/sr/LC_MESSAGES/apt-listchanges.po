#: ../apt-listchanges.py:70
#, python-format
msgid "Unknown frontend: %s"
msgstr "Непознат челник: %s"

#: ../apt-listchanges.py:86
#, python-format
msgid "Cannot reopen /dev/tty for stdin: %s"
msgstr "Не могу поново да отворим „/dev/tty“ за стандардни улаз: %s"

#: ../apt-listchanges.py:142
#, python-format
msgid "News for %s"
msgstr "Новости за „%s“"

#: ../apt-listchanges.py:144
#, python-format
msgid "Changes for %s"
msgstr "Измене за „%s“"

#: ../apt-listchanges.py:154
msgid "Informational notes"
msgstr "Обавештајне напомене"

#: ../apt-listchanges.py:161
msgid "apt-listchanges: News"
msgstr "apt-listchanges: Новости"

#: ../apt-listchanges.py:162
msgid "apt-listchanges: Changelogs"
msgstr "apt-listchanges: Дневник измена"

#: ../apt-listchanges.py:168
#, python-format
msgid "apt-listchanges: news for %s"
msgstr "apt-listchanges: новине за „%s“"

#: ../apt-listchanges.py:169
#, python-format
msgid "apt-listchanges: changelogs for %s"
msgstr "apt-listchanges: дневник измена за „%s“"

#: ../apt-listchanges.py:175
msgid "Didn't find any valid .deb archives"
msgstr "Нисам нашао ниједну исправну „.deb“ архиву"

#: ../apt-listchanges.py:194
#, python-format
msgid "%s: will be newly installed"
msgstr "%s: биће новоинсталирани"

#: ../apt-listchanges.py:221
#, python-format
msgid "%(pkg)s: Version %(version)s has already been seen"
msgstr "%(pkg)s: Издање %(version)s је већ виђено"

#: ../apt-listchanges.py:225
#, python-format
msgid ""
"%(pkg)s: Version %(version)s is lower than version of related packages "
"(%(maxversion)s)"
msgstr ""
"%(pkg)s: Издање %(version)s је мање од издања односног пакета "
"(%(maxversion)s)"

#: ../apt-listchanges.py:279
msgid "Binary NMU of"
msgstr "Бинарни НМУ од"

#: ../apt-listchanges.py:313
#, python-format
msgid "Received signal %d, exiting"
msgstr "Примљен је сигнал %d, излазим"

#: ../apt-listchanges/ALCApt.py:54
msgid "APT pipeline messages:"
msgstr "Поруке спојног реда АПТ-а:"

#: ../apt-listchanges/ALCApt.py:62
msgid "Packages list:"
msgstr "Списак пакета:"

#: ../apt-listchanges/ALCApt.py:70
msgid ""
"APT_HOOK_INFO_FD environment variable is not defined\n"
"(is Dpkg::Tools::Options::/usr/bin/apt-listchanges::InfoFD set to 20?)"
msgstr ""
"Променљива окружења „APT_HOOK_INFO_FD“ није дефинисана\n"
"(да ли је „Dpkg::Tools::Options::/usr/bin/apt-listchanges::InfoFD“ постављен "
"на 20?)"

#: ../apt-listchanges/ALCApt.py:76
msgid "Invalid (non-numeric) value of APT_HOOK_INFO_FD environment variable"
msgstr ""
"Неисправна (не-бојчана) вредност променљиве окружења „APT_HOOK_INFO_FD“"

#: ../apt-listchanges/ALCApt.py:79
#, python-format
msgid "Will read apt pipeline messages from file descriptor %d"
msgstr "Прочитаћу поруке спојног реда апт-а из описника датотеке „%d“"

#: ../apt-listchanges/ALCApt.py:82
msgid ""
"Incorrect value (0) of APT_HOOK_INFO_FD environment variable.\n"
"If the warning persists after restart of the package manager (e.g. "
"aptitude),\n"
"please check if the /etc/apt/apt.conf.d/20listchanges file was properly "
"updated."
msgstr ""
"Неисправна вредност (0) променљиве окружења „APT_HOOK_INFO_FD“.\n"
"Ако упозорења остану након поновног покретања управника пакета (нпр. "
"„aptitude“-а),\n"
"проверите да ли је датотека „/etc/apt/apt.conf.d/20listchangesисправно "
"освежена."

#: ../apt-listchanges/ALCApt.py:87
msgid ""
"APT_HOOK_INFO_FD environment variable is incorrectly defined\n"
"(Dpkg::Tools::Options::/usr/bin/apt-listchanges::InfoFD should be greater "
"than 2)."
msgstr ""
"Променљива окружења „APT_HOOK_INFO_FD“ је неправилно дефинисана\n"
"(„Dpkg::Tools::Options::/usr/bin/apt-listchanges::InfoFD“ треба бити веће од "
"2)."

#: ../apt-listchanges/ALCApt.py:93
#, python-format
msgid "Cannot read from file descriptor %(fd)d: %(errmsg)s"
msgstr "Не могу да читам из описника датотеке „%(fd)d“: %(errmsg)s"

#: ../apt-listchanges/ALCApt.py:99
msgid ""
"Wrong or missing VERSION from apt pipeline\n"
"(is Dpkg::Tools::Options::/usr/bin/apt-listchanges::Version set to 2?)"
msgstr ""
"Недостаје или је погрешно издање из спојке апт-а\n"
"(да ли је „Dpkg::Tools::Options::/usr/bin/apt-listchanges::Version“ "
"постављено на 2?)"

#: ../apt-listchanges/ALCConfig.py:116
#, python-format
msgid "Unknown configuration file option: %s"
msgstr "Непозната опција датотеке подешавања: %s"

#: ../apt-listchanges/ALCConfig.py:129
msgid "Usage: apt-listchanges [options] {--apt | filename.deb ...}\n"
msgstr "Употреба: apt-listchanges [опције] {--apt | датотека.deb ...}\n"

#: ../apt-listchanges/ALCConfig.py:135
#, python-format
msgid ""
"Unknown argument %(arg)s for option %(opt)s.  Allowed are: %(allowed)s."
msgstr ""
"Непознат аргумент „%(arg)s“ за опцију „%(opt)s“.  Дозвољени су: %(allowed)s."

#: ../apt-listchanges/ALCConfig.py:147
#, python-format
msgid "%(deb)s does not have '.deb' extension"
msgstr "„%(deb)s“ нема проширење „.deb“"

#: ../apt-listchanges/ALCConfig.py:150
#, python-format
msgid "%(deb)s does not exist or is not a file"
msgstr "„%(deb)s“ не постоји или није датотека"

#: ../apt-listchanges/ALCConfig.py:153
#, python-format
msgid "%(deb)s is not readable"
msgstr "„%(deb)s“ није читљив"

#: ../apt-listchanges/ALCConfig.py:254
msgid "--since=<version> and --show-all are mutually exclusive"
msgstr "„--since=<издање>“ и „--show-all“ се међусобно искључују"

#: ../apt-listchanges/ALCConfig.py:262
msgid "--since=<version> expects a path to exactly one .deb archive"
msgstr "„--since=<издање>“ очекује путању до тачно једне „.deb“ архиве"

#: ../apt-listchanges/ALCConfig.py:268
msgid "--latest=<N> and --show-all are mutually exclusive"
msgstr "„--latest=<N>“ и „--show-all“ се међусобно искључују"

#: ../apt-listchanges/ALCLog.py:29 ../apt-listchanges/ALCLog.py:35
#, python-format
msgid "apt-listchanges: %(msg)s"
msgstr "apt-listchanges: %(msg)s"

#: ../apt-listchanges/ALCLog.py:32
#, python-format
msgid "apt-listchanges warning: %(msg)s"
msgstr "„apt-listchanges“ упозорење: %(msg)s"

#: ../apt-listchanges/ALCSeenDb.py:54
msgid ""
"Path to the seen database is unknown.\n"
"Please either specify it with --save-seen option\n"
"or pass --profile=apt to have it read from the configuration file."
msgstr ""
"Путања до виђене базе података није позната.\n"
"Или је наведите опцијом „--save-seen“\n"
"или проследите „--profile=apt“ да је прочитате из датотеке подешавања."

#: ../apt-listchanges/ALCSeenDb.py:65
#, python-format
msgid "Database %(db)s does not end with %(ext)s"
msgstr "База података „%(db)s“ се не завршава на „%(ext)s“"

#: ../apt-listchanges/ALCSeenDb.py:74
#, python-format
msgid "Database %(db)s failed to load: %(errmsg)s"
msgstr "Нисам успео да учитам базу података „%(db)s“: %(errmsg)s"

#: ../apt-listchanges/AptListChangesGtk.py:40
msgid "apt-listchanges: Reading changelogs"
msgstr "apt-listchanges: Читам дневник измена"

#: ../apt-listchanges/AptListChangesGtk.py:41
msgid "Reading changelogs. Please wait."
msgstr "Читам дневник измена. Сачекајте тренутак."

#: ../apt-listchanges/AptListChangesGtk.py:74
msgid "Continue Installation?"
msgstr "Да наставим са инсталацијом?"

#: ../apt-listchanges/AptListChangesGtk.py:75
msgid ""
"Select <i>yes</i> to continue with the installation.\n"
"Select <i>no</i> to abort the installation."
msgstr ""
"Изаберите „<i>да</i>“ да наставите са инсталацијом.\n"
"Изаберите „<i>не</i>“ да прекинете инсталацију."

#: ../apt-listchanges/DebianFiles.py:118 ../apt-listchanges/DebianFiles.py:127
#, python-format
msgid "Error processing '%(what)s': %(errmsg)s"
msgstr "Грешка обраде „%(what)s“: %(errmsg)s"

#: ../apt-listchanges/DebianFiles.py:342
#, python-format
msgid "Ignoring `%s' (seems to be a directory!)"
msgstr "Занемарујем „%s“ (изгледа да је директоријум!)"

#: ../apt-listchanges/DebianFiles.py:417
#, python-format
msgid "Calling %(cmd)s to retrieve changelog"
msgstr "Позивам „%(cmd)s“ да довучем дневник измена"

#: ../apt-listchanges/DebianFiles.py:421
#, python-format
msgid ""
"Unable to retrieve changelog for package %(pkg)s; 'apt-get changelog' failed "
"with: %(errmsg)s"
msgstr ""
"Не могу да довучем дневник измена за пакет „%(pkg)s“; „apt-get changelog“ "
"није успело са: %(errmsg)s"

#: ../apt-listchanges/DebianFiles.py:427
#, python-format
msgid ""
"Unable to retrieve changelog for package %(pkg)s; could not run 'apt-get "
"changelog': %(errmsg)s"
msgstr ""
"Не могу да довучем дневник измена за пакет „%(pkg)s“; не могу да покренем "
"„apt-get changelog“: %(errmsg)s"

#: ../apt-listchanges/apt_listchanges.py:54
msgid "Aborting"
msgstr "Прекидам"

#: ../apt-listchanges/apt_listchanges.py:59
#, python-format
msgid "Confirmation failed: %s"
msgstr "Потврђивање није успело: %s"

#: ../apt-listchanges/apt_listchanges.py:63
#, python-format
msgid "Mailing %(address)s: %(subject)s"
msgstr "Шаљем пошту на „%(address)s“: %(subject)s"

#: ../apt-listchanges/apt_listchanges.py:83
#, python-format
msgid "Failed to send mail to %(address)s: %(errmsg)s"
msgstr "Нисам успео да пошаљем пошту на „%(address)s“: %(errmsg)s"

#: ../apt-listchanges/apt_listchanges.py:92
#, python-format
msgid "The mail frontend needs an installed 'sendmail', using %s"
msgstr "Челник поште захтева инсталиран пакет „sendmail“, користим „%s“"

#: ../apt-listchanges/apt_listchanges.py:98
#, python-format
msgid "The mail frontend needs an e-mail address to be configured, using %s"
msgstr "Челник поште захтева адресу е-поштеда би био подешен, користим „%s“"

#: ../apt-listchanges/apt_listchanges.py:111
msgid "Available apt-listchanges frontends:"
msgstr "Доступни челници за апт-списак_измена:"

#: ../apt-listchanges/apt_listchanges.py:113
msgid "Choose a frontend by entering its number: "
msgstr "Изаберите челника уневши његов број: "

#: ../apt-listchanges/apt_listchanges.py:122
#: ../apt-listchanges/apt_listchanges.py:468
#, python-format
msgid "Error: %s"
msgstr "Грешка: %s"

#: ../apt-listchanges/apt_listchanges.py:124
#, python-format
msgid "Using default frontend: %s"
msgstr "Користим основног челника: %s"

#: ../apt-listchanges/apt_listchanges.py:177
#, python-format
msgid "$DISPLAY is not set, falling back to %(frontend)s"
msgstr "„$DISPLAY“ није постављено, враћам се на „%(frontend)s“"

#: ../apt-listchanges/apt_listchanges.py:197
#, python-format
msgid ""
"The gtk frontend needs a working python3-gi,\n"
"but it cannot be loaded. Falling back to %(frontend)s.\n"
"The error is: %(errmsg)s"
msgstr ""
"гтк челнику је потребан радни „python3-gi“,\n"
"али не може бити учитан. Пребацујем се на „%(frontend)s“.\n"
"Грешка је: %(errmsg)s"

#: ../apt-listchanges/apt_listchanges.py:298
msgid "Do you want to continue? [Y/n] "
msgstr "Да ли желите да наставите? [Д/н] "

#: ../apt-listchanges/apt_listchanges.py:311
#: ../apt-listchanges/apt_listchanges.py:364
#: ../apt-listchanges/apt_listchanges.py:372
msgid "Reading changelogs"
msgstr "Читам дневнике измена"

#: ../apt-listchanges/apt_listchanges.py:350
#: ../apt-listchanges/apt_listchanges.py:405
#, python-format
msgid "Command %(cmd)s exited with status %(status)d"
msgstr "Наредба „%(cmd)s“ је изашла са стањем „%(status)d“"

#: ../apt-listchanges/apt_listchanges.py:372
msgid "Done"
msgstr "Готово"

#: ../apt-listchanges/apt_listchanges.py:450
#, python-format
msgid "Found user: %(user)s, temporary directory: %(dir)s"
msgstr "Нађох корисника: %(user)s, привремени директоријум: %(dir)s"

#: ../apt-listchanges/apt_listchanges.py:496
#, python-format
msgid "Error getting user from variable '%(envvar)s': %(errmsg)s"
msgstr "Грешка добављања корисника из променљиве „%(envvar)s“: %(errmsg)s"

#: ../apt-listchanges/apt_listchanges.py:502
msgid "Cannot find suitable user to drop root privileges"
msgstr ""
"Не могу да нађем одговарајућег корисника да одбацим администраторске "
"привилегије"

#: ../apt-listchanges/apt_listchanges.py:528
#, python-format
msgid ""
"None of the following directories is accessible by user %(user)s: %(dirs)s"
msgstr ""
"Ни једном од ових директоријума не може да приступи корисник %(user)s: "
"%(dirs)s"

#: ../apt-listchanges/apt_listchanges.py:558
msgid "press q to quit"
msgstr "притисните „q“ да изађете"

#: ../apt-listchanges/apt-listchanges.ui:13
msgid "List the changes"
msgstr "Испишите измене"

#: ../apt-listchanges/apt-listchanges.ui:43
msgid ""
"The following changes are found in the packages you are about to install:"
msgstr "Пронашао сам следеће измене у пакетима које желите да инсталирате:"
