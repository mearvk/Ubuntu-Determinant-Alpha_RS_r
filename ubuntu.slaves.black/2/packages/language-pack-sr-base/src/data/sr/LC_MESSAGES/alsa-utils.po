#: speaker-test/speaker-test.c:943
#, c-format
msgid ""
"Usage: speaker-test [OPTION]... \n"
"-h,--help\thelp\n"
"-D,--device\tplayback device\n"
"-r,--rate\tstream rate in Hz\n"
"-c,--channels\tcount of channels in stream\n"
"-f,--frequency\tsine wave frequency in Hz\n"
"-F,--format\tsample format\n"
"-b,--buffer\tring buffer size in us\n"
"-p,--period\tperiod size in us\n"
"-P,--nperiods\tnumber of periods\n"
"-t,--test\tpink=use pink noise, sine=use sine wave, wav=WAV file\n"
"-l,--nloops\tspecify number of loops to test, 0 = infinite\n"
"-s,--speaker\tsingle speaker test. Values 1=Left, 2=right, etc\n"
"-w,--wavfile\tUse the given WAV file as a test sound\n"
"-W,--wavdir\tSpecify the directory containing WAV files\n"
"-m,--chmap\tSpecify the channel map to override\n"
"-X,--force-frequency\tforce frequencies outside the 30-8000hz range\n"
"-S,--scale\tScale of generated test tones in percent (default=80)\n"
"\n"
msgstr ""
"Употреба: speaker-test [ОПЦИЈА]... \n"
"-h,--help\tприказује помоћ\n"
"-D,--device\tуређај за пуштање\n"
"-r,--rate\tпроток тока у Hz\n"
"-c,--channels\tброј канала у току\n"
"-f,--frequency\tучесталост синусног таласа у Hz\n"
"-F,--format\tформат узорка\n"
"-b,--buffer\tвеличина међумеморије прстена у µs\n"
"-p,--period\tвеличина периода у µs\n"
"-P,--nperiods\tбој периода\n"
"-t,--test\tpink=користи ружичасти шум, sine=користи синусни талас, wav=ВАВ "
"датотека\n"
"-l,--nloops\tнаводи број понављања за тестирање, 0 = бесконачно\n"
"-s,--speaker\tпровера једног звучника. Вредности: 1=леви, 2=десни, итд.\n"
"-w,--wavfile\tкористи дату ВАВ датотеку као звук пробе\n"
"-W,--wavdir\tнаводи директоријум који садржи ВАВ датотеке\n"
"-m,--chmap\tнаводи мапу канала за преобилажење\n"
"-X,--force-frequency\tприморава учесталости ван опсега од 30-8000hz\n"
"-S,--scale\tсразмера створених тонова теста у процентима (основно=80)\n"
"\n"

