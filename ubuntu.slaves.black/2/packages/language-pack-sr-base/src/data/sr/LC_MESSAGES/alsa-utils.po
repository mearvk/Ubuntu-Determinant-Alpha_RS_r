msgid "usage:\n"
msgstr "употреба:\n"

#: seq/aseqnet/aseqnet.c:174
#, c-format
msgid "  server mode: aseqnet [-options]\n"
msgstr "  режим сервера: aseqnet [-опције]\n"

#: seq/aseqnet/aseqnet.c:175
#, c-format
msgid "  client mode: aseqnet [-options] server_host\n"
msgstr "  режим клијента: aseqnet [-опције] домаћин_сервер\n"

#: seq/aseqnet/aseqnet.c:176
#, c-format
msgid "options:\n"
msgstr "опције:\n"

#: seq/aseqnet/aseqnet.c:177
#, c-format
msgid "  -6,--ipv6 : use IPv6 TCP protocol\n"
msgstr ""

#: seq/aseqnet/aseqnet.c:178
#, c-format
msgid "  -p,--port # : specify TCP port (digit or service name)\n"
msgstr "  -p,--port #:      наводи ТЦП прикључник (цифра или назив услуге)\n"

#: seq/aseqnet/aseqnet.c:179
#, c-format
msgid "  -s,--source addr : read from given addr (client:port)\n"
msgstr "  -s,--source адрс: чита из дате адресе (клијент:прикључник)\n"

#: seq/aseqnet/aseqnet.c:180
#, c-format
msgid "  -d,--dest addr : write to given addr (client:port)\n"
msgstr "  -d,--dest адрс:   пише у дату адресу (клијент:прикључник)\n"

#: seq/aseqnet/aseqnet.c:181
#, c-format
msgid "  -n,--name value : use a specific midi process name\n"
msgstr ""

#: seq/aseqnet/aseqnet.c:182
#, c-format
msgid "  -v, --verbose : print verbose messages\n"
msgstr "  -v, --verbose:    исписује опширне поруке\n"

#: seq/aseqnet/aseqnet.c:183
#, c-format
