#: lib/fascist.c:516
msgid "it is based on your username"
msgstr "заснива се на вашем корисничком имену"

#: lib/fascist.c:576
msgid "it is based upon your password entry"
msgstr "заснива се на вашем уносу лозинке"

#: lib/fascist.c:591
msgid "it is derived from your password entry"
msgstr "произилази из вашег уноса лозинке"

#: lib/fascist.c:599
msgid "it's derived from your password entry"
msgstr "произашла је из вашег уноса лозинке"

#: lib/fascist.c:608
msgid "it is derivable from your password entry"
msgstr "може се извући из вашег уноса лозинке"

#: lib/fascist.c:617
msgid "it's derivable from your password entry"
msgstr "може произаћи из вашег уноса лозинке"

#: lib/fascist.c:674
msgid "you are not registered in the password file"
msgstr "ви нисте регистровани у датотеци лозинке"

#: lib/fascist.c:709
msgid "it is WAY too short"
msgstr "превише је кратка на НАЧИН"

#: lib/fascist.c:714
msgid "it is too short"
msgstr "превише је кратка"

#: lib/fascist.c:731
msgid "it does not contain enough DIFFERENT characters"
msgstr "не садржи довољно РАЗЛИЧИТИХ знакова"

#: lib/fascist.c:745
msgid "it is all whitespace"
msgstr "сва је у празнинама"

#: lib/fascist.c:764
msgid "it is too simplistic/systematic"
msgstr "превише је једноставна/системска"

#: lib/fascist.c:769
msgid "it looks like a National Insurance number."
msgstr "изгледа као јавни матични број грађана."

#: lib/fascist.c:801
msgid "it is based on a dictionary word"
msgstr "заснована је на речи из речника"

#: lib/fascist.c:820
msgid "it is based on a (reversed) dictionary word"
msgstr "заснована је на (обрнутој) речи из речника"

#: lib/fascist.c:865
msgid "error loading dictionary"
msgstr "грешка учитавања речника"
