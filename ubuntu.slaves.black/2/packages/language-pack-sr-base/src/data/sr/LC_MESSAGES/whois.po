#: ../whois.c:242
#, c-format
msgid ""
"Version %s.\n"
"\n"
"Report bugs to %s.\n"
msgstr ""
"Издање %s.\n"
"\n"
"Грешке пријавите на „%s“.\n"

#: ../whois.c:331
msgid ""
"This TLD has no whois server, but you can access the whois database at"
msgstr ""
"Овај ТЛД нема сервер „ко-је“, али можете приступити бази података за „ко-је“ "
"на"

#: ../whois.c:336
msgid "This TLD has no whois server."
msgstr "Овај ТЛД нема сервер „ко-је“."

#: ../whois.c:339
msgid "No whois server is known for this kind of object."
msgstr "Нема познатог севера „ко-је“ за ову врсту предмета."

#: ../whois.c:342
msgid "Unknown AS number or IP network. Please upgrade this program."
msgstr ""
"Непознат АС број или ИП мрежа. Било би добро да надоградите овај програм."

#: ../whois.c:346 ../whois.c:355 ../whois.c:390 ../whois.c:407
#, c-format
msgid "Using server %s.\n"
msgstr "Користим сервер „%s“.\n"

#: ../whois.c:364
#, c-format
msgid ""
"\n"
"Querying for the IPv4 endpoint %s of a 6to4 IPv6 address.\n"
"\n"
msgstr ""
"\n"
"Пропитујем за ИПв4 крајњом тачком „%s“ за 6до4 ИПв6 адресе.\n"
"\n"

#: ../whois.c:371
#, c-format
msgid ""
"\n"
"Querying for the IPv4 endpoint %s of a Teredo IPv6 address.\n"
"\n"
msgstr ""
"\n"
"Пропитујем за ИПв4 крајњом тачком „%s“ за Тередо ИПв6 адресе.\n"
"\n"

#: ../whois.c:408
#, c-format
msgid ""
"Query string: \"%s\"\n"
"\n"
msgstr ""
"Ниска упита: „%s“\n"
"\n"

#: ../whois.c:418
#, c-format
msgid ""
"\n"
"\n"
"Found a referral to %s.\n"
"\n"
msgstr ""
"\n"
"\n"
"Нађох упутницу на „%s“.\n"
"\n"

#: ../whois.c:460 ../whois.c:463
#, c-format
msgid "Cannot parse this line: %s"
msgstr "Не могу да обрадим овај ред: %s"

#: ../whois.c:652
msgid "Warning: RIPE flags used with a traditional server."
msgstr "Упозорење: РИПЕ опције су коришћене са уобичајеним сервером."

#: ../whois.c:825 ../whois.c:941
msgid ""
"Catastrophic error: disclaimer text has been changed.\n"
"Please upgrade this program.\n"
msgstr ""
"Катастрофална грешка: измењен је текст прихватања одредби.\n"
"Стварно би било добро да надоградите овај програм.\n"

#: ../whois.c:1042
#, c-format
msgid "Host %s not found."
msgstr "Нисам нашао домаћина „%s“."

#: ../whois.c:1052
#, c-format
msgid "%s/tcp: unknown service"
msgstr "%s/тцп: непозната услуга"

#: ../whois.c:1127
msgid "Timeout."
msgstr "Време је истекло."

#: ../whois.c:1133
#, c-format
msgid "Interrupted by signal %d..."
msgstr "Прекинут сам сигналом „%d“..."

#: ../whois.c:1501
#, c-format
msgid ""
"Usage: whois [OPTION]... OBJECT...\n"
"\n"
"-h HOST, --host HOST   connect to server HOST\n"
"-p PORT, --port PORT   connect to PORT\n"
"-I                     query whois.iana.org and follow its referral\n"
"-H                     hide legal disclaimers\n"
msgstr ""
"Употреба: whois [ОПЦИЈА]... ОБЈЕКАТ...\n"
"\n"
"-h ДОМАЋИН, --host ДОМАЋИН       повезује се на сервер ДОМАЋИН\n"
"-p ПРИКЉУЧНИК, --port ПРИКЉУЧНИК прикључује се на ПРИКЉУЧНИК\n"
"-I                               пропитује „whois.iana.org“ и прати његове "
"упуте\n"
"-H                               скрива прихватање законских одредби\n"

#: ../whois.c:1508
#, c-format
msgid ""
"      --verbose        explain what is being done\n"
"      --no-recursion   disable recursion from registry to registrar servers\n"
"      --help           display this help and exit\n"
"      --version        output version information and exit\n"
"\n"
msgstr ""

#: ../whois.c:1515
#, c-format
msgid ""
"These flags are supported by whois.ripe.net and some RIPE-like servers:\n"
"-l                     find the one level less specific match\n"
"-L                     find all levels less specific matches\n"
"-m                     find all one level more specific matches\n"
"-M                     find all levels of more specific matches\n"
msgstr ""
"Ове опције подржавају „whois.ripe.net“ и неки РИПЕ-слични сервери:\n"
"-l                               налази једног нивоа мање посебно поклапање\n"
"-L                               налази свих нивоа мање посебна поклапања\n"
"-m                               налази сва једног нивоа више посебна "
"поклапања\n"
"-M                               налази све нивое више посебних поклапања\n"

#: ../whois.c:1522
#, c-format
msgid ""
"-c                     find the smallest match containing a mnt-irt "
"attribute\n"
"-x                     exact match\n"
"-b                     return brief IP address ranges with abuse contact\n"
msgstr ""
"-c                               налази најмање поклапање које садржи „mnt-"
"irt“ особину\n"
"-x                               тачно поклапање\n"
"-b                               даје кратке опсеге ИП адресе са нападним "
"контактом\n"

#: ../whois.c:1527
#, c-format
msgid ""
"-B                     turn off object filtering (show email addresses)\n"
"-G                     turn off grouping of associated objects\n"
"-d                     return DNS reverse delegation objects too\n"
msgstr ""
"-B                               искључује издвајање предмета (приказује "
"адресе ел. поште)\n"
"-G                               искључује груписање придружених објеката\n"
"-d                               такође даје објекте обрнуте делегације ДНС-"
"а\n"

#: ../whois.c:1532
#, c-format
msgid ""
"-i ATTR[,ATTR]...      do an inverse look-up for specified ATTRibutes\n"
"-T TYPE[,TYPE]...      only look for objects of TYPE\n"
"-K                     only primary keys are returned\n"
"-r                     turn off recursive look-ups for contact information\n"
msgstr ""
"-i АТР[,АТР]...                  обавља обратну претрагу за наведеним "
"АТРИБУТИМА\n"
"-T ВРСТА[,ВРСТА]...              тражи само предмете ВРСТЕ\n"
"-K                               враћају се само примарни кључеви\n"
"-r                               искључује дубинска тражења података "
"контакта\n"

#: ../whois.c:1538
#, c-format
msgid ""
"-R                     force to show local copy of the domain object even\n"
"                       if it contains referral\n"
"-a                     also search all the mirrored databases\n"
"-s SOURCE[,SOURCE]...  search the database mirrored from SOURCE\n"
"-g SOURCE:FIRST-LAST   find updates from SOURCE from serial FIRST to LAST\n"
msgstr ""
"-R                               приморава показивање локални умножак "
"објекта домена чак\n"
"                                 и ако садржи упутност\n"
"-a                               такође тражи све одразне базе података\n"
"-s ИЗВОР[,ИЗВОР]...              претражује базу података одразну из ИЗВОРА\n"
"-g ИЗВОР:ПРВИ-ПОСЛЕДЊИ           налази освежења из ИЗВОРА из серије од "
"ПРВОГ до ПОСЛЕДЊЕГ\n"

#: ../whois.c:1545
#, c-format
msgid ""
"-t TYPE                request template for object of TYPE\n"
"-v TYPE                request verbose template for object of TYPE\n"
"-q [version|sources|types]  query specified server info\n"
msgstr ""
"-t ВРСТА                         захтева шаблон за предмет ВРСТЕ\n"
"-v ВРСТА                         захтева опширан шаблон за предмет ВРСТЕ\n"
"-q [издање|извори|врсте]         пропитује наведене податке сервера\n"

#: ../mkpasswd.c:137
msgid "BSDI extended DES-based crypt(3)"
msgstr "„BSDI“ проширен „crypt(3)“ заснован на ДЕС-у"

#: ../mkpasswd.c:140
msgid "standard 56 bit DES-based crypt(3)"
msgstr "уобичајено 56-битно „crypt(3)“ засновано на ДЕС-у"

#: ../mkpasswd.c:209
#, c-format
msgid "Invalid method '%s'.\n"
msgstr "Неисправна метода „%s“.\n"

#: ../mkpasswd.c:218 ../mkpasswd.c:230
#, c-format
msgid "Invalid number '%s'.\n"
msgstr "Неисправан број „%s“.\n"

#: ../mkpasswd.c:248
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Пробајте „%s --help“ за више података.\n"

#: ../mkpasswd.c:304
#, c-format
msgid "Wrong salt length: %d byte when %d expected.\n"
msgid_plural "Wrong salt length: %d bytes when %d expected.\n"
msgstr[0] "Погрешна дужина присолка: %d бајт а очекивах %d.\n"
msgstr[1] "Погрешна дужина присолка: %d бајта а очекивах %d.\n"
msgstr[2] "Погрешна дужина присолка: %d бајтова а очекивах %d.\n"

#: ../mkpasswd.c:309
#, c-format
msgid "Wrong salt length: %d byte when %d <= n <= %d expected.\n"
msgid_plural "Wrong salt length: %d bytes when %d <= n <= %d expected.\n"
msgstr[0] "Погрешна дужина присолка: %d бајт а очекивах %d <= n <= %d.\n"
msgstr[1] "Погрешна дужина присолка: %d бајта а очекивах %d <= n <= %d.\n"
msgstr[2] "Погрешна дужина присолка: %d бајтова а очекивах %d <= n <= %d.\n"

#: ../mkpasswd.c:318
#, c-format
msgid "Illegal salt character '%c'.\n"
msgstr "Неисправан знак присолка „%c“.\n"

#: ../mkpasswd.c:374 ../mkpasswd.c:387
#, c-format
msgid "Password: "
msgstr "Лозинка: "

#: ../mkpasswd.c:406
#, c-format
msgid "Method not supported by crypt(3).\n"
msgstr "„crypt(3)“ не подржава ову методу.\n"

#: ../mkpasswd.c:514
#, c-format
msgid ""
"Usage: mkpasswd [OPTIONS]... [PASSWORD [SALT]]\n"
"Crypts the PASSWORD using crypt(3).\n"
"\n"
msgstr ""
"Употреба: mkpasswd [ОПЦИЈЕ]... [ЛОЗИНКА [ПРИСОЛАК]]\n"
"Шифрујте ЛОЗИНКЕ користећи „crypt(3)“.\n"
"\n"

#: ../mkpasswd.c:517
#, c-format
msgid ""
"      -m, --method=TYPE     select method TYPE\n"
"      -5                    like --method=md5crypt\n"
"      -S, --salt=SALT       use the specified SALT\n"
msgstr ""
"      -m, --method=ВРСТА      бира методу ВРСТЕ\n"
"      -5                      као „--method=md5“\n"
"      -S, --salt=ПРИСОЛАК     користи наведени ПРИСОЛАК\n"

#: ../mkpasswd.c:522
#, c-format
msgid ""
"      -R, --rounds=NUMBER   use the specified NUMBER of rounds\n"
"      -P, --password-fd=NUM read the password from file descriptor NUM\n"
"                            instead of /dev/tty\n"
"      -s, --stdin           like --password-fd=0\n"
msgstr ""
"      -R, --rounds=БРОЈ       користи наведени БРОЈ рунди\n"
"      -P, --password-fd=БРОЈ  чита лозинку из описника датотеке БРОЈ\n"
"                              уместо „/dev/tty“\n"
"      -s, --stdin             као „--password-fd=0“\n"

#: ../mkpasswd.c:528
#, c-format
msgid ""
"      -h, --help            display this help and exit\n"
"      -V, --version         output version information and exit\n"
"\n"
"If PASSWORD is missing then it is asked interactively.\n"
"If no SALT is specified, a random one is generated.\n"
"If TYPE is 'help', available methods are printed.\n"
"\n"
"Report bugs to %s.\n"
msgstr ""
"      -h, --help              приказује ову помоћ и излази\n"
"      -V, --version           исписује податке о издању и излази\n"
"\n"
"Ако недостаје ЛОЗИНКА онда се тражи.\n"
"Ако није наведен ПРИСОЛАК, ствара се један насумичан.\n"
"Ако је ВРСТА „help“, исписују се доступна метода.\n"
"\n"
"Грешке пријавите на „%s“.\n"

#: ../mkpasswd.c:551
#, c-format
msgid "Available methods:\n"
msgstr "Доступни начини:\n"
