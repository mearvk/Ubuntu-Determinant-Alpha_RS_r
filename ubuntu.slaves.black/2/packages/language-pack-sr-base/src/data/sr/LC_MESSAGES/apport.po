msgstr "Вама није допуштено да приступите извештају овог проблема."

#: ../apport/ui.py:545
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:545
msgid "Error"
msgstr "Грешка"

#: ../apport/ui.py:547
#: ../debian/tmp/usr/lib/python3.11/dist-packages/apport/ui.py:547
