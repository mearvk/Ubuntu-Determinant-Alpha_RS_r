#, c-format
msgid "unable to write file '%s'"
msgstr "не могу запишем датотеку „%s“"

#: lib/dpkg/ar.c
#, c-format
msgid "ar member name '%s' length too long"
msgstr "дужина назива ар члана „%s“ је предуга"

#: lib/dpkg/ar.c
#, c-format
msgid "ar member size %jd too large"
msgstr "величина ар члана „%jd“ је превелика"

#: lib/dpkg/ar.c
#, c-format
msgid "ar member time %jd too large"
msgstr "време ар члана „%jd“ је превелико"

#: lib/dpkg/ar.c
#, c-format
msgid "generated corrupt ar header for '%s'"
msgstr "створено је неисправно ар заглавље за „%s“"

#: lib/dpkg/ar.c
#, c-format
msgid "failed to fstat ar member file (%s)"
msgstr "нисам успео да добавим податке датотеке ар члана (%s)"

#: lib/dpkg/ar.c
#, c-format
msgid "cannot append ar member file (%s) to '%s': %s"
msgstr "не могу да прикачим датотеку ар члана (%s) на „%s“: %s"

#: lib/dpkg/arch.c lib/dpkg/parsehelp.c lib/dpkg/pkg-format.c
msgid "may not be empty string"
msgstr "не сме бити празна ниска"

#: lib/dpkg/arch.c
msgid "must start with an alphanumeric"
msgstr "мора почињати алфа-нумеричким знаком"

#: lib/dpkg/arch.c lib/dpkg/parsehelp.c
#, c-format
msgid "character '%c' not allowed (only letters, digits and characters '%s')"
msgstr "знак „%c“ није дозвољен (само слова, цифре и знаци „%s“)"

#: lib/dpkg/arch.c
msgctxt "architecture"
msgid "<none>"
msgstr "<ништа>"

#: lib/dpkg/arch.c
msgctxt "architecture"
msgid "<empty>"
msgstr "<празно>"

#: lib/dpkg/arch.c
msgid "error writing to architecture list"
msgstr "грешка писања у списак архитектуре"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "cannot create base directory for %s"
msgstr "не могу да направим директоријум основе за „%s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "unable to create new file '%.250s'"
msgstr "не могу да направим нову датотеку „%.250s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "unable to write new file '%.250s'"
msgstr "не могу да запишем нову датотеку „%.250s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "unable to flush new file '%.250s'"
msgstr "не могу да проследим нову датотеку „%.250s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "unable to sync new file '%.250s'"
msgstr "не могу да усагласим нову датотеку „%.250s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "unable to close new file '%.250s'"
msgstr "не могу да затворим нову датотеку „%.250s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "error removing old backup file '%s'"
msgstr "грешка уклањања старе датотеке резерве „%s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "error creating new backup file '%s'"
msgstr "грешка стварања нове датотеке резерве „%s“"

#: lib/dpkg/atomic-file.c lib/dpkg/db-ctrl-upgrade.c lib/dpkg/triglib.c
#: src/remove.c
#, c-format
msgid "cannot remove '%.250s'"
msgstr "не могу да уклоним „%.250s“"

#: lib/dpkg/atomic-file.c
#, c-format
msgid "error installing new file '%s'"
msgstr "грешка инсталације нове датотеке „%s“"

#: lib/dpkg/buffer.c
msgid "failed to write"
msgstr "нисам успео да упишем"

#: lib/dpkg/buffer.c
msgid "failed to read"
msgstr "нисам успео да прочитам"

#: lib/dpkg/buffer.c
msgid "unexpected end of file or stream"
msgstr "неочекивани крај датотеке или тока"

#: lib/dpkg/buffer.c
msgid "failed to seek"
msgstr "нисам успео да премотам"

#: lib/dpkg/command.c lib/dpkg/path-remove.c src/unpack.c dpkg-split/split.c
#: utils/update-alternatives.c
#, c-format
msgid "unable to execute %s (%s)"
msgstr "не могу да извршим „%s“ (%s)"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: pass-through copy error: %s"
msgstr "%s: грешка умножавања пролаза: %s"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: error binding input to gzip stream"
msgstr "%s: грешка привезивања улаза на гзип ток"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal gzip read error: '%s'"
msgstr "%s: унутрашња грешка читања гзип-а: „%s“"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal gzip write error"
msgstr "%s: унутрашња грешка писања гзип-а"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal gzip read error: %s"
msgstr "%s: унутрашња грешка читања гзип-а: %s"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: error binding output to gzip stream"
msgstr "%s: грешка привезивања излаза на гзип ток"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal gzip read error"
msgstr "%s: унутрашња грешка читања гзип-а"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal gzip write error: '%s'"
msgstr "%s: унутрашња грешка писања гзип-а: „%s“"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal gzip write error: %s"
msgstr "%s: унутрашња грешка писања гзип-а: %s"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: error binding input to bzip2 stream"
msgstr "%s: грешка привезивања улаза на бзип2 ток"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal bzip2 read error: '%s'"
msgstr "%s: унутрашња грешка читања бзип-а2: „%s“"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal bzip2 write error"
msgstr "%s: унутрашња грешка писања бзип-а2"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: error binding output to bzip2 stream"
msgstr "%s: грешка привезивања излаза на бзип2 ток"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal bzip2 read error"
msgstr "%s: унутрашња грешка читања бзип-а2"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: internal bzip2 write error: '%s'"
msgstr "%s: унутрашња грешка писања бзип-а2: „%s“"

#: lib/dpkg/compress.c
msgid "unexpected bzip2 error"
msgstr "неочекивана грешка бзип-а2"

#: lib/dpkg/compress.c
msgid "internal error (bug)"
msgstr "унутрашња грешка (бубица)"

#: lib/dpkg/compress.c
msgid "memory usage limit reached"
msgstr "достигнуто је ограничење употребе меморије"

#: lib/dpkg/compress.c
msgid "unsupported compression preset"
msgstr "неподржано претподешавање паковања"

#: lib/dpkg/compress.c
msgid "unsupported options in file header"
msgstr "неподржане могућности у заглављу датотеке"

#: lib/dpkg/compress.c
msgid "compressed data is corrupt"
msgstr "запаковани подаци су оштећени"

#: lib/dpkg/compress.c
msgid "unexpected end of input"
msgstr "неочекиван крај улаза"

#: lib/dpkg/compress.c
msgid "file format not recognized"
msgstr "запис датотеке није препознат"

#: lib/dpkg/compress.c
msgid "unsupported type of integrity check"
msgstr "неподржана врста провере целовитости"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: lzma read error"
msgstr "%s: грешка читања лзма-е"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: lzma write error"
msgstr "%s: грешка писања лзма-е"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: lzma close error"
msgstr "%s: грешка затварања лзма-е"

#: lib/dpkg/compress.c
#, c-format
msgid "%s: lzma error: %s"
msgstr "%s: грешка лзма-е: %s"

#: lib/dpkg/compress.c
msgid "unknown compression strategy"
msgstr "непозната стратегија паковања"

#: lib/dpkg/dbmodify.c
#, c-format
msgid ""
"updates directory contains file '%.250s' whose name is too long (length=%d, "
"max=%d)"
msgstr ""
"директоријум освежења садржи датотеку „%.250s“ чији назив је предуг "
"(дужина=%d, највише=%d)"

#: lib/dpkg/dbmodify.c
#, c-format
msgid ""
"updates directory contains files with different length names (both %d and %d)"
msgstr ""
"директоријум освежења садржи датотеке са различитим дужинама назива (и %d и "
"%d)"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "cannot create the dpkg updates directory %s"
msgstr "не могу да направим директоријум освежавања дпкг-а „%s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "cannot scan updates directory '%.255s'"
msgstr "не могу да прегледам директоријум освежења „%.255s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "failed to remove incorporated update file %.255s"
msgstr "нисам успео да уклоним уграђену датотеку освежења %.255s"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to fill %.250s with padding"
msgstr "не могу да испуним „%.250s“ са попунама"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to flush %.250s after padding"
msgstr "не могу да запишем %.250s након попуњавања"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to seek to start of %.250s after padding"
msgstr "не могу да пређем на почетак %.250s након попуњавања"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to check lock file for dpkg database directory %s"
msgstr ""
"не могу да проверим има ли директоријума „%s“ базе података дпкг-а у "
"датотеци закључавања"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to open/create dpkg frontend lock for directory %s"
msgstr ""
"не могу да отворим/направим закључавање дпкг челника за директоријум „%s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to open/create dpkg database lock file for directory %s"
msgstr ""
"не могу да отворим/направим датотеку закључавања дпкг базе података за "
"директоријум „%s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "you do not have permission to lock the dpkg database directory %s"
msgstr "немате овлашћење да закључате директоријум базе података дпкг-а „%s“"

#: lib/dpkg/dbmodify.c
msgid "dpkg frontend lock"
msgstr "закључавање дпкг челника"

#: lib/dpkg/dbmodify.c
msgid "dpkg database lock"
msgstr "закључавање дпкг базе података"

#: lib/dpkg/dbmodify.c
msgid "requested operation requires superuser privilege"
msgstr "тражена радња захтева привилегије администратора"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "cannot create the dpkg database directory %s"
msgstr "не могу да направим директоријум базе података дпкг-а „%s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to access the dpkg database directory %s"
msgstr "не могу да приступим директоријуму дпкг базе података „%s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "required read/write access to the dpkg database directory %s"
msgstr "потребан је приступ директоријуму дпкг базе података „%s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "failed to remove my own update file %.255s"
msgstr "нисам успео да уклоним моју личну датотеку освежења %.255s"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to write updated status of '%.250s'"
msgstr "не могу да запишем освежено стање за „%.250s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to flush updated status of '%.250s'"
msgstr "не могу да проследим освежено стање за „%.250s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to truncate for updated status of '%.250s'"
msgstr "не могу да одсечем за освеженим стањем за „%.250s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to fsync updated status of '%.250s'"
msgstr "не могу да усагласим датотеку освеженог стања за „%.250s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to close updated status of '%.250s'"
msgstr "не могу да затворим освежено стање за „%.250s“"

#: lib/dpkg/dbmodify.c
#, c-format
msgid "unable to install updated status of '%.250s'"
msgstr "не могу да инсталирам освежено стање за „%.250s“"

#: lib/dpkg/db-ctrl-access.c
#, c-format
msgid "unable to check existence of '%.250s'"
msgstr "не могу да проверим да ли постоји „%.250s“"

#: lib/dpkg/db-ctrl-access.c lib/dpkg/db-ctrl-upgrade.c
msgid "cannot read info directory"
msgstr "не могу да прочитам директоријум података"

#: lib/dpkg/db-ctrl-format.c src/unpack.c
#, c-format
msgid "error trying to open %.250s"
msgstr "грешка приликом отварања „%.250s“"

#: lib/dpkg/db-ctrl-format.c
#, c-format
msgid "corrupt info database format file '%s'"
msgstr "оштећена је датотека записа информација базе података „%s“"

#: lib/dpkg/db-ctrl-format.c
#, c-format
msgid ""
"info database format (%d) is bogus or too new; try getting a newer dpkg"
msgstr ""
"запис базе података (%d“ је неподесан или сувише нов; покушавам да добавим "
"новији дпкг"

#: lib/dpkg/db-ctrl-upgrade.c
#, c-format
msgid "info file %s/%s not associated to any package"
msgstr "датотека података %s/%s није придружена ниједном пакету"

#: lib/dpkg/db-ctrl-upgrade.c src/archives.c
#, c-format
msgid "error creating hard link '%.255s'"
msgstr "грешка стварања чврсте везе „%.255s“"

#: lib/dpkg/db-ctrl-upgrade.c
#, c-format
msgid "error while writing '%s'"
msgstr "грешка приликом уписа „%s“"

#: lib/dpkg/db-fsys-digest.c
#, c-format
msgid "control file '%s' for package '%s' is missing final newline"
msgstr "контролној датотеци „%s“ за пакет „%s“ недостаје завршни нови ред"

#: lib/dpkg/db-fsys-digest.c
#, c-format
msgid "control file '%s' for package '%s' is missing value"
msgstr "контролној датотеци „%s“ за пакет „%s“ недостаје вредност"

#: lib/dpkg/db-fsys-digest.c
#, c-format
msgid "control file '%s' for package '%s' is missing value separator"
msgstr ""
"контролној датотеци „%s“ за пакет „%s“ недостаје раздвојник вредности"

#: lib/dpkg/db-fsys-digest.c
#, c-format
msgid "control file '%s' for package '%s' contains empty filename"
msgstr "контролној датотеци „%s“ за пакет „%s“ садржи празан назив датотеке"

#: lib/dpkg/db-fsys-digest.c
#, c-format
msgid "loading control file '%s' for package '%s'"
msgstr "учитавам контролну датотеку „%s“ за пакет „%s“"

#: lib/dpkg/db-fsys-divert.c
msgid "failed to open diversions file"
msgstr "не могу да отворим датотеку разлика"

#: lib/dpkg/db-fsys-divert.c
msgid "failed to fstat diversions file"
msgstr "не могу да добавим податке датотеке разлика"

#: lib/dpkg/db-fsys-divert.c
#, c-format
msgid "conflicting diversions involving '%.250s' or '%.250s'"
msgstr "сукобљене разлике обухватају „%.250s“ или „%.250s“"

#: lib/dpkg/db-fsys-files.c
#, c-format
msgid "loading files list file for package '%s'"
msgstr "учитавам датотеку списка датотека за пакет „%s“"

#: lib/dpkg/db-fsys-files.c
#, c-format
msgid ""
"files list file for package '%.250s' missing; assuming package has no files "
"currently installed"
msgstr ""
"датотека списка датотека за пакет „%.250s“ недостаје; подразумевам да пакет "
"нема тренутно инсталираних датотека"

#: lib/dpkg/db-fsys-files.c
#, c-format
msgid "files list file for package '%.250s' is missing final newline"
msgstr "датотеци списка датотека „%.250s“ недостаје завршни нови ред"

#: lib/dpkg/db-fsys-files.c
#, c-format
msgid "files list file for package '%.250s' contains empty filename"
msgstr ""
"датотека списка датотека за пакет „%.250s“ садржи празан назив датотеке"

#: lib/dpkg/db-fsys-files.c
msgid "(Reading database ... "
msgstr "(Читам базу података ... "

#: lib/dpkg/db-fsys-files.c
#, c-format
msgid "%d file or directory currently installed.)\n"
msgid_plural "%d files and directories currently installed.)\n"
msgstr[0] "%d датотека или директоријум је тренутно инсталиран.)\n"
msgstr[1] "%d датотеке или директоријума су тренутно инсталирана.)\n"
msgstr[2] "%d датотека или директоријума је тренутно инсталирано.)\n"

#: lib/dpkg/db-fsys-override.c
#, c-format
msgid "invalid statoverride uid %s"
msgstr "неисправан „statoverride“ уид „%s“"

#: lib/dpkg/db-fsys-override.c
#, c-format
msgid "invalid statoverride gid %s"
msgstr "неисправан „statoverride“ гид „%s“"

#: lib/dpkg/db-fsys-override.c
#, c-format
msgid "invalid statoverride mode %s"
msgstr "неисправан „statoverride“ режим „%s“"

#: lib/dpkg/db-fsys-override.c
msgid "failed to open statoverride file"
msgstr "нисам успео да отворим датотеку „statoverride“"

#: lib/dpkg/db-fsys-override.c
msgid "failed to fstat statoverride file"
msgstr "нисам успео да добавим податке датотеке „statoverride“"

#: lib/dpkg/db-fsys-override.c
#, c-format
msgid "reading statoverride file '%.250s'"
msgstr "читам датотеку „statoverride“ „%.250s“"

#: lib/dpkg/db-fsys-override.c
