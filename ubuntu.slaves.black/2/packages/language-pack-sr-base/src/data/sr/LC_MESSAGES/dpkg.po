"пакета.\n"
"\n"

#: src/querycmd.c
#, c-format
msgid ""
"Options:\n"
"  --admindir=<directory>           Use <directory> instead of %s.\n"
"  --root=<directory>               Use <directory> instead of %s.\n"
"  --load-avail                     Use available file on --show and --list.\n"
