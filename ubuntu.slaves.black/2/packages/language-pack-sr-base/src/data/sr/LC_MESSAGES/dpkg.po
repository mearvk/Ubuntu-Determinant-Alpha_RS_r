#: lib/dpkg/ar.c
msgid "failed to fstat archive"
msgstr "нисам успео да добавим податке о архиви"

#: lib/dpkg/ar.c
#, c-format
msgid "failed to read archive '%.255s'"
msgstr "нисам успео да прочитам архиву „%.255s“"

#: lib/dpkg/ar.c lib/dpkg/dbmodify.c
#, c-format
msgid "unable to create '%.255s'"
msgstr "не могу да направим „%.255s“"

