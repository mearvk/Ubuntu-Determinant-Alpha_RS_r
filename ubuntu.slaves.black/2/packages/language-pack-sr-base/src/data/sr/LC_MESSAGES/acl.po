#: tools/chacl.c:271
#, c-format
msgid "%s: cannot get access ACL text on '%s': %s\n"
msgstr "%s: не могу да добијем приступни текст ACL-a на „%s“: %s\n"

#: tools/chacl.c:278
#, c-format
msgid "%s: cannot get default ACL text on '%s': %s\n"
msgstr "%s: не могу да добијем подразумевани ACL текст на „%s“: %s\n"

#: tools/chacl.c:304
#, c-format
msgid "%s: cannot set access acl on \"%s\": %s\n"
msgstr "%s: не могу да подесим приступ за ACL на „%s“: %s\n"

#: tools/chacl.c:310
#, c-format
msgid "%s: cannot set default acl on \"%s\": %s\n"
msgstr "%s: не могу да подесим подразумевани ACL на „%s“: %s\n"

#: tools/chacl.c:328
#, c-format
msgid "%s: opendir failed: %s\n"
msgstr "%s: функција opendir није успела: %s\n"

#: tools/chacl.c:342
#, c-format
msgid "%s: malloc failed: %s\n"
msgstr "%s:функција malloc није успела: %s\n"

#: tools/do_set.c:410
#, c-format
msgid "%s: %s: Malformed access ACL `%s': %s at entry %d\n"
msgstr "%s: %s: Неисправна контролна приступна листа „%s“: %s у ставци %d\n"

#: tools/do_set.c:437
#, c-format
msgid "%s: %s: Malformed default ACL `%s': %s at entry %d\n"
msgstr ""
"%s: %s: Неисправна подразумевана контролна приступна листа „%s“: %s у ставци "
"%d\n"

#: tools/do_set.c:508
#, c-format
msgid "%s: %s: Only directories can have default ACLs\n"
msgstr "%s: %s: Само директоријуми могу да имају подразумеване ACL-ове\n"

#: tools/setfacl.c:147
#, c-format
msgid "%s: %s: No filename found in line %d, aborting\n"
msgstr "%s: %s:Нисам пронашао име фајла у линији %d, прекидам\n"

#: tools/setfacl.c:152
#, c-format
msgid "%s: No filename found in line %d of standard input, aborting\n"
msgstr ""
"%s: Нисам пронашао име фајла у линији бр. %d стандардог улаза, прекидам\n"

#: tools/setfacl.c:173
#, c-format
msgid "%s: %s: %s in line %d\n"
msgstr "%s: %s: %s у линији %d\n"

#: tools/setfacl.c:205
#, c-format
msgid "%s: %s: Cannot change owner/group: %s\n"
msgstr "%s: %s: Не могу да променим власника/групу: %s\n"

#: tools/setfacl.c:224
#, c-format
msgid "%s: %s: Cannot change mode: %s\n"
msgstr "%s: %s: Не могу да изменим режим: %s\n"

#: tools/setfacl.c:266
#, c-format
msgid "%s %s -- set file access control lists\n"
msgstr "%s %s -- постави ACL фајла\n"

#: tools/setfacl.c:268 tools/setfacl.c:653
#, c-format
msgid "Usage: %s %s\n"
msgstr "Употреба: %s %s\n"

#: tools/setfacl.c:271
#, c-format
msgid ""
"  -m, --modify=acl        modify the current ACL(s) of file(s)\n"
"  -M, --modify-file=file  read ACL entries to modify from file\n"
"  -x, --remove=acl        remove entries from the ACL(s) of file(s)\n"
"  -X, --remove-file=file  read ACL entries to remove from file\n"
"  -b, --remove-all        remove all extended ACL entries\n"
"  -k, --remove-default    remove the default ACL\n"
msgstr ""
"  -m, --modify=acl        промени тренутни ACL(ове) фајла/ова\n"
"  -M, --modify-file=ФАЈЛ  прочитај ACL уносе да би променио из наведеног "
"фајла\n"
"  -x, --remove=acl        уклони уносе из ACL(ова) фајла/ова\n"
"  -X, --remove-file=ФАЈЛ  прочитај ACL уносе да би уклонио из наведеног "
"фајла\n"
"  -b, --remove-all        уклони све продужене ACL уносе\n"
"  -k, --remove-default    уклони подразумевани ACL\n"

#: tools/setfacl.c:280
#, c-format
msgid ""
"      --set=acl           set the ACL of file(s), replacing the current ACL\n"
"      --set-file=file     read ACL entries to set from file\n"
"      --mask              do recalculate the effective rights mask\n"
msgstr ""
"      --set=acl          подеси ACL фајла/ова и замени тренутни ACL\n"
"      --set-file=ФАЈЛ     прочитај ACL уносе за подешавање из наведеног "
"фајла\n"
"      --mask              прерачунај маску ефективних права\n"

#: tools/setfacl.c:286
#, c-format
msgid ""
"  -n, --no-mask           don't recalculate the effective rights mask\n"
"  -d, --default           operations apply to the default ACL\n"
msgstr ""
"  -n, --no-mask          немој израчунавати маску ефективних права\n"
"  -d, --default           ради се са подразумеваним ACL-ом\n"

#: tools/setfacl.c:291
#, c-format
msgid ""
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"      --restore=file      restore ACLs (inverse of `getfacl -R')\n"
"      --test              test mode (ACLs are not modified)\n"
msgstr ""
"  -R, --recursive         ради рекурзивно у поддиректоријумима\n"
"  -L, --logical           логична шетња, прати симболичке везе\n"
"  -P, --physical          физичка шетња, не прати симболичке везе\n"
"      --restore=file      врати ACL-ове (обрнуто од „getfacl -R“)\n"
"      --test              мод тестирања (ACL-ови нису промењени)\n"

#: tools/setfacl.c:299 tools/getfacl.c:597
#, c-format
msgid ""
"  -v, --version           print version and exit\n"
"  -h, --help              this help text\n"
msgstr ""
"  -v, --version     исписује издање програма и излази\n"
"  -h, --help          приказује овај текст помоћи\n"

#: tools/setfacl.c:316 tools/getfacl.c:743
#, c-format
msgid "%s: Standard input: %s\n"
msgstr "%s: Стандардни улаз: %s\n"

#: tools/setfacl.c:452
#, c-format
msgid "%s: Option -%c incomplete\n"
msgstr "%s: Опција -%c је непотпуна\n"

#: tools/setfacl.c:457
#, c-format
msgid "%s: Option -%c: %s near character %d\n"
msgstr "%s: Опција -%c: %s близу слова %d\n"

#: tools/setfacl.c:533
#, c-format
msgid "%s: %s in line %d of file %s\n"
msgstr "%s: %s у линији бр. %d фајла %s\n"

#: tools/setfacl.c:541
#, c-format
msgid "%s: %s in line %d of standard input\n"
msgstr "%s: %s у линији бр. %d стандардног улаза\n"

#: tools/setfacl.c:655 tools/getfacl.c:758
#, c-format
msgid "Try `%s --help' for more information.\n"
msgstr "Покушајте „%s --help“ за више информција.\n"

#: tools/getfacl.c:498
#, c-format
msgid "%s: Removing leading '/' from absolute path names\n"
msgstr "%s: Уклањам пратећи знак „/“ из имена апсолуних путања\n"

#: tools/getfacl.c:569
#, c-format
msgid "%s %s -- get file access control lists\n"
msgstr "%s %s -- прибави ACL\n"

#: tools/getfacl.c:571 tools/getfacl.c:756
#, c-format
msgid "Usage: %s [-%s] file ...\n"
msgstr "Употреба: %s [-%s] фајла ...\n"

#: tools/getfacl.c:577
#, c-format
msgid "  -d, --default           display the default access control list\n"
msgstr ""
"  -d, --default           приказује подразумевани списак приступних "
"контрола\n"

#: tools/getfacl.c:581
#, c-format
msgid ""
"  -a, --access            display the file access control list only\n"
"  -d, --default           display the default access control list only\n"
"  -c, --omit-header       do not display the comment header\n"
"  -e, --all-effective     print all effective rights\n"
"  -E, --no-effective      print no effective rights\n"
"  -s, --skip-base         skip files that only have the base entries\n"
"  -R, --recursive         recurse into subdirectories\n"
"  -L, --logical           logical walk, follow symbolic links\n"
"  -P, --physical          physical walk, do not follow symbolic links\n"
"  -t, --tabular           use tabular output format\n"
"  -n, --numeric           print numeric user/group identifiers\n"
"      --one-file-system   skip files on different filesystems\n"
"  -p, --absolute-names    don't strip leading '/' in pathnames\n"
msgstr ""
