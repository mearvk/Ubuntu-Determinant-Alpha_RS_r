#: tools/chacl.c:146
#, c-format
msgid "%s: error removing access acl on \"%s\": %s\n"
msgstr "%s:грешка у уклањању приступа acl на „%s“: %s\n"

#: tools/chacl.c:153
#, c-format
msgid "%s: error removing default acl on \"%s\": %s\n"
msgstr "%s:грешка у уклањању подразумеваог acl на „%s“: %s\n"

#: tools/chacl.c:172 tools/chacl.c:191
#, c-format
