msgstr "тражи у описима пакета"

#: cmdline/apt.cc:63
msgid "show package details"
msgstr "показује детаље пакета"

#. package stuff
#: cmdline/apt.cc:66
msgid "install packages"
msgstr "инсталира пакете"

#: cmdline/apt.cc:67
msgid "reinstall packages"
msgstr "поново инсталира пакете"

#: cmdline/apt.cc:68
msgid "remove packages"
msgstr "уклања пакете"

#. system wide stuff
#: cmdline/apt.cc:75
msgid "update list of available packages"
msgstr "освежава списак доступних пакета"

#: cmdline/apt.cc:76
msgid "upgrade the system by installing/upgrading packages"
msgstr "надограђује систем инсталирањем/надоградњом пакета"

#: cmdline/apt.cc:77
msgid "upgrade the system by removing/installing/upgrading packages"
msgstr "надограђује систем уклањањем/инсталирањем/надоградњом пакета"

