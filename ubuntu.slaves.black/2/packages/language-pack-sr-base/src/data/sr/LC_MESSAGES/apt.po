#, c-format
msgid "%s was already set to manually installed.\n"
msgstr "„%s“ је већ постављен као ручно инсталиран.\n"

#: cmdline/apt-mark.cc:75
#, c-format
msgid "%s was already set to automatically installed.\n"
msgstr "„%s“ је већ постављен као самостално инсталиран.\n"

#: cmdline/apt-mark.cc:255
msgid "No changes necessary"
msgstr "Измене нису неопходне"

#: cmdline/apt-mark.cc:259
msgid "The following packages will be marked as automatically installed:"
msgstr "Следећи пакети биће означени да су самостално инсталирани:"

