msgid "Non-DFSG-compatible Software"
msgstr "Не-ДФСГ-сагласан софтвер"

#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Земља сервера: %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Главни сервер"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Призвољни сервер"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Недостаје опис за „%s“. Известите о овоме (не било вам тешко)."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Неисправан јуникод у опису за „%s“ (%s). Известите о овоме (не било вам "
"тешко)."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Списак измена није доступан"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Списак измена још увек није доступан.\n"
"\n"
"Користите „http://launchpad.net/Убунту/+source/%s/%s/+changelog“\n"
"док промене не постану доступне или пробајте касније."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Нисам успео да преузмем списак измена.\n"
"Проверите вашу интернет везу."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Не могу да прочитам списак датотека за „%s“"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Не могу да прочитам списак управљачких датотека за „%s“"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Зависност се не може задовољити: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Сукоби међу инсталираним пакетима „%s“"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Зависност „%(depname)s“ оштећује постојећи пакет „%(pkgname)s“ "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Сукоб са „%(targetpkg)s“ оштећује постојећи пакет „%(pkgname)s“ "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Сукоб са „%(targetpkg)s“ оштећује постојећи пакет „%(pkgname)s“. Али га "
"„%(debfile)s“ обезбеђује путем: „%(provides)s“"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Нема поља архитектуре у пакету"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Погрешна архитектура „%s“ —— Покрените „dpkg --add-architecture“ да је "
"додате и да након тога освежите"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Новије издање је већ инсталирано"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Нисам успео да задовољим све зависности (оштећена остава)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Не могу да инсталирам „%s“"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Самостално распаковано:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Самостално претворено за исписиве аскри-је:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Инсталирајте „Build-Dependencies“ за изворни пакет „%s“ који гради „%s“\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Кључни пакет би био уклоњен"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Крај"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Нашао сам: "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Знмрно "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Гршка "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Добављам:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Радим]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Промена медијума: убаците диск са натписом\n"
" „%s“\n"
"у уређај „%s“ и притисните „унеси“\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Преузето је %sB за %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr "Доставите назив за овај медиј, као што је „Дебиан 2.1r1 диск 1“"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Убаците инсталациони медиј и притисните „Унеси“"
