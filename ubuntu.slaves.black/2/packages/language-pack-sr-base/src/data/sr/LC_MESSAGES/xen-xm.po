#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Унутрашња грешка: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Ова мапа већ садржи %(1)s —> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Начин „%(1)s“ није подржан."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Начин „%(1)s“ прихвата %(2)s аргумент(а) (датих — %(3)s)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Приступ је одбијен."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Вредност „%(2)s“ за „%(1)s“ није подржана овим сервером.  Сервер поручује: "
"%(3)s."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "„%(1)s“ ручка %(2)s није исправна."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Покушали сте да урадите нешто што није допуштено."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Мрежа коју сте навели већ има приложен ПИФ, тако да још један не може бити "
"приложен."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
