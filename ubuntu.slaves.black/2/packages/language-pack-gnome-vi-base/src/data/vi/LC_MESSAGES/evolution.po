#: ../src/mail/mail.error.xml.h:23
msgid "Send private reply?"
msgstr "Gửi riêng chứ?"

#: ../src/mail/mail.error.xml.h:24
msgid ""
"You are replying privately to a message which arrived via a mailing list, "
