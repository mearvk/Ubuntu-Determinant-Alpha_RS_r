msgid "AisleRiot Solitaire"
msgstr "Solitari AisleRiot"

#: data/sol.desktop.in:4 data/sol.metainfo.xml.in:37
msgid "Play many different solitaire games"
msgstr "Jogar a mantun jòc de solitari diferents"

