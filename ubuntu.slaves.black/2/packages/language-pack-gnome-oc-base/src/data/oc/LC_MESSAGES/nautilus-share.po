#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"Nautilus deu apondre de permissions a vòstre dorsièr « %s » per lo poder "
"partejar."

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"Lo dorsièr « %s » necessita d'aver las permissions suplementàrias seguentas "
"per permetre son partiment \n"
":%s%s%sVolètz que Nautilus aponda automaticament aquelas permissions al "
"dorsièr ?"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - lectura per de tèrces\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - permission d'escritura pels autres\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - permissions d'execucion pels autres\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "Apondre las permissions automaticament"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "Impossible de modificar las permissions del dorsièr « %s »"

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "Lo nom del partiment es tròp long"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "Lo nom del partiment pòt pas èsser void"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr ""
"Una error s'es produita al moment de la recuperacion de las informacions del "
"partiment : « %s »"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "Un autre partiment a ja lo meteis nom"

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "Modificar lo _partiment"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "Crear un _partiment"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "L'installacion del servici de partiment a fracassat"

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr ""
"L'installacion del servici de partiment a fracassat. Volètz reaviar "
"l'installacion ?"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "Ensajar tornamai"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "Lo servici de partiment es pas installat"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"Vos cal installar lo servici de partiment de rets Windows per poder partejar "
"vòstres dorsièrs."

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "Installar lo servici"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr ""
"Una error s'es produita al moment de la recuperacion de las informacions del "
"partiment"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "Partiment de ret locala"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "Partiment de dorsièr"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "Partejar aqueste dorsièr"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "%s %s %s a tornat lo senhal %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s a fracassat per una rason desconeguda"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "« net usershare » a tornat l'error %d : %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "« net usershare » a tornat l'error %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "la sortida de « net usershare » es pas encodada en UTF-8 valid"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "Fracàs"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "testparm de Samba a tornat lo senhal %d"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "testparm de Samba a fracassat per una rason desconeguda"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "testparm de Samba a tornat l'error %d : %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "testparm de Samba a tornat l'error %d"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr ""
"Impossible d'eliminar lo partiment pel repertòri %s : aqueste repertòri es "
"pas partejat."

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"Impossible de modificar lo camin d'un partiment existent ; suprimissètz "
"l'ancian partiment puèi creatz-ne un novèl"

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>Partiment de dorsièr</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "_Nom del partiment :"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "Partejar aqueste _dorsièr"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "Co_mentari :"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr "_Permetre als autres utilizaires de modificar aqueste dorsièr"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr "_Accès d'avaloracion (per las personas sens compte d'utilizaire)"
