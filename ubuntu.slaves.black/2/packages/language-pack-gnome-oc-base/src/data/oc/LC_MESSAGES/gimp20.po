#: ../app/config/gimprc-blurbs.h:501
msgid "Save changed keyboard shortcuts when GIMP exits."
msgstr "Enregistrar los acorchis de clavièr modificats quand òm quita GIMP."

#: ../app/config/gimprc-blurbs.h:504
