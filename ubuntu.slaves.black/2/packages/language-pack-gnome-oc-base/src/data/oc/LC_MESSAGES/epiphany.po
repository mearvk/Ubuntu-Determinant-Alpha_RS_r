msgstr "L’aplicacion « %s » es prèsta a èsser utilizada"

#: src/window-commands.c:1340
#, c-format
#| msgid "The application '%s' could not be created"
msgid "The application “%s” could not be created"
msgstr "L’aplicacion « %s » a pas pogut èsser creada"

