#: ../UpdateManager/backend/InstallBackendAptdaemon.py:154
msgid "Checking for updates…"
msgstr "Verificacion de las mesas a jorn…"

#: ../UpdateManager/backend/InstallBackendAptdaemon.py:216
#: ../UpdateManager/backend/InstallBackendAptdaemon.py:290
#: ../UpdateManager/backend/InstallBackendAptdaemon.py:340
msgid "Installing updates…"
msgstr "Installacion de las mesas a jorn…"

#: ../UpdateManager/backend/InstallBackendSynaptic.py:43
msgid "Please wait, this can take some time."
msgstr "Esperatz, aquò pòt prendre de temps."

#: ../UpdateManager/backend/InstallBackendSynaptic.py:45
msgid "Update is complete"
msgstr "La mesa a jorn es acabada"

#: ../UpdateManager/backend/__init__.py:300
msgid "Updating snaps"
msgstr "Mesa a jorn dels snaps"

#: ../UpdateManager/backend/__init__.py:328
#, python-format
msgid "Refreshing %s snap"
msgstr "Actualizacion del snap %s"

#: ../UpdateManager/backend/__init__.py:336
#, python-format
msgid "Removing %s snap"
msgstr "Supression del snap %s"

#: ../UpdateManager/backend/__init__.py:343
#, python-format
msgid "Installing %s snap"
msgstr "Installacion del snap %s"

#: ../UpdateManager/backend/__init__.py:356
msgid "Upgrade only partially completed."
msgstr "Mesa a nivèl sonque acabada parcialament."

#: ../UpdateManager/backend/__init__.py:358
msgid ""
"An error occurred while updating snaps. Please check your network connection."
msgstr ""
"Una error s’es producha pendent la mesa a jorn dels snap. Mercés de "
"verificar la connexion ret."

#: ../UpdateManager/ChangelogViewer.py:82
msgid "Open Link in Browser"
msgstr "Dobrir lo ligam dins un navigador"

#: ../UpdateManager/ChangelogViewer.py:87
msgid "Copy Link to Clipboard"
msgstr "Copiar lo ligam dins lo quichapapièrs"

#: ../UpdateManager/Dialogs.py:128
msgid "Settings…"
msgstr "Paramètres…"

#: ../UpdateManager/Dialogs.py:169
msgid ""
"<b>Tip:</b> You can use Livepatch with Ubuntu Pro to keep your computer more "
"secure between restarts."
msgstr ""
"<b>Astúcia :</b> podètz utilizar Livepatch amb Ubuntu Pro per gardar "
"l’ordenador mai segur entre doas reaviadas."

#: ../UpdateManager/Dialogs.py:174
msgid "Settings & Pro…"
msgstr "Paramètres e Pro…"

#: ../UpdateManager/Dialogs.py:189
#, python-format
msgid "%d Livepatch update applied since the last restart."
msgid_plural "%d Livepatch updates applied since the last restart."
msgstr[0] "%d mesa a jorn Livepatch aplicada dempuèi la darrièra reaviada."
msgstr[1] "%d mesas a jorn Livepatch aplicadas dempuèi la darrièra reaviada."

#: ../UpdateManager/Dialogs.py:197
#, python-format
msgid "%d Livepatch update failed to apply since the last restart."
msgid_plural "%d Livepatch updates failed to apply since the last restart."
msgstr[0] "%d mesa a jorn Livepatch fracassèt dempuèi la darrièra reaviada."
msgstr[1] ""
"%d mesas a jorn Livepatch fracassèron dempuèi la darrièra reaviada."

#: ../UpdateManager/Dialogs.py:220 ../UpdateManager/UpdateManager.py:317
msgid "You stopped the check for updates."
msgstr "Avètz arrestat la verificacion de las mesas a jorn."

#: ../UpdateManager/Dialogs.py:222
msgid "_Check Again"
msgstr "_Verificar tornarmai"

#: ../UpdateManager/Dialogs.py:235
msgid "No software updates are available."
msgstr "Cap de mesa a jorn logiciala es pas disponibla."

#: ../UpdateManager/Dialogs.py:237 ../UpdateManager/Dialogs.py:249
msgid "The software on this computer is up to date."
msgstr "Los logicials sus aqueste ordenador son a jorn."

#: ../UpdateManager/Dialogs.py:252
#, python-format
msgid "However, %s %s is now available (you have %s)."
msgstr "Çaquelà, %s %s es ara disponible (sètz jos %s)."

#: ../UpdateManager/Dialogs.py:260
msgid "Upgrade…"
msgstr "Mesa a nivèl…"

#: ../UpdateManager/Dialogs.py:286
msgid "New important security and hardware support update."
msgstr ""
"Novèla mesa a jorn importanta de seguretat e de presa en carga del material."

#: ../UpdateManager/Dialogs.py:295
msgid "_Install…"
msgstr "_Installar…"

#: ../UpdateManager/Dialogs.py:309
#, python-format
msgid "Software updates are no longer provided for %s %s."
msgstr "Las mesas a jorn logicialas son pas mai provesidas per %s %s."

#: ../UpdateManager/Dialogs.py:314
#, python-format
msgid "To stay secure, you should upgrade to %s %s."
msgstr "Per demorar en seguretat, vos caldriá metre a jorn cap a %s %s."

#: ../UpdateManager/Dialogs.py:327
msgid "Sorry, there are no more upgrades for this system"
msgstr "O planhèm, i a pas mai de mesa a nivèl per aqueste sistèma"

#: ../UpdateManager/Dialogs.py:331
#, python-format
msgid ""
"\n"
"There will not be any further Ubuntu releases for this system's '%s' "
"architecture.\n"
"\n"
"Updates for Ubuntu %s will continue until 2023-04-26.\n"
"\n"
"If you reinstall Ubuntu from ubuntu.com/download, future upgrades will be "
"available."
msgstr ""
"\n"
"I aurà pas mai de sortida d’Ubuntu per aquesta arquitectura sistèma « %s ».\n"
"\n"
"Las mesas a jorn per Ubuntu %s contunharàn fins al 26 d’abrial de 2023.\n"
"\n"
"Se tornatz installar Ubuntu a partir d’ubuntu.com/download, auretz las mesas "
"a nivèls futuras disponiblas."

#: ../UpdateManager/Dialogs.py:347
msgid "Not all updates can be installed"
msgstr "Totas las mesas a jorn pòdon pas èsser installadas"

#: ../UpdateManager/Dialogs.py:350
msgid ""
"Run a partial upgrade, to install as many updates as possible.\n"
"\n"
"    This can be caused by:\n"
"     * A previous upgrade which didn't complete\n"
"     * Problems with some of the installed software\n"
"     * Unofficial software packages not provided by Ubuntu\n"
"     * Normal changes of a pre-release version of Ubuntu"
msgstr ""
"Aviar una mesa a nivèl parciala, per installar autant de mesas a jorn coma "
"possible.\n"
"\n"
"Aquò pòt èsser causat per :\n"
"* una precedenta mesa a jorn que s'es mal acabada ;\n"
"* de problèmas amb un o mantun logicial installat ;\n"
"* de paquets logicials non oficials qu'Ubuntu provesís pas ;\n"
"* de cambiaments normals deguts a una version bèta d'Ubuntu."

#: ../UpdateManager/Dialogs.py:361
msgid "_Partial Upgrade"
msgstr "_Mesa a jorn parciala"

#: ../UpdateManager/Dialogs.py:362
msgid "_Continue"
msgstr "_Contunhar"

#: ../UpdateManager/Dialogs.py:403
msgid "_Try Again"
msgstr "_Ensajar tornarmai"

#: ../UpdateManager/Dialogs.py:417
msgid "The computer needs to restart to finish installing updates."
msgstr ""
"L'ordenador a besonh de se reaviar per acabar l'installacion de las mesas a "
"jorn."

#: ../UpdateManager/Dialogs.py:421
msgid "Restart _Later"
msgstr "Reaviar _mai tard"

#: ../UpdateManager/Dialogs.py:423
msgid "_Restart Now"
msgstr "_Reaviar ara"

#. Basic GTK+ parameters
#: ../UpdateManager/UpdateManager.py:100 ../data/update-manager.desktop.in.h:1
#: ../data/update-manager.appdata.xml.in.h:1
msgid "Software Updater"
msgstr "Gestionari de mesas a jorn"

#: ../UpdateManager/UpdateManager.py:315
msgid "Some software couldn’t be checked for updates."
msgstr ""
"La verificacion de las mesas a jorn a pas pogut èsser efectuada per d'unes "
"logicials."

#: ../UpdateManager/UpdateManager.py:319
msgid "Updated software is available from a previous check."
msgstr ""
"Segon una precedenta verificacion, de mesas a jorn de logicials son "
"disponiblas."

#. we assert a clean cache
#: ../UpdateManager/UpdateManager.py:430
msgid "Software index is broken"
msgstr "La lista dels logicials es corrompuda"

#: ../UpdateManager/UpdateManager.py:432
msgid ""
"It is impossible to install or remove any software. Please use the package "
"manager \"Synaptic\" or run \"sudo apt-get install -f\" in a terminal to fix "
"this issue at first."
msgstr ""
"Impossible d'installar o de suprimir de logicials. D'en primièr, utilizatz "
"lo « Gestionari de paquets Synaptic » o aviatz « sudo apt-get install -f » "
"dins un terminal per corregir aqueste problèma."

#: ../UpdateManager/UpdateManager.py:440
msgid "Could not initialize the package information"
msgstr "Impossible d'inicializar las donadas suls paquets"

#: ../UpdateManager/UpdateManager.py:442
msgid ""
"An unresolvable problem occurred while initializing the package "
"information.\n"
"\n"
"Please report this bug against the 'update-manager' package and include the "
"following error message:\n"
msgstr ""
"Un problèma insoluble s'es produit pendent l'inicializacion de las "
"informacions del paquet.\n"
"\n"
"Senhalatz aqueste bug del paquet « update-manager » en i jonhent lo messatge "
"d'error seguent :\n"

#: ../UpdateManager/UpdateManager.py:477
msgid "Could not calculate the upgrade"
msgstr "Impossible de calcular la mesa a jorn"

#: ../UpdateManager/UpdateManager.py:479
msgid ""
"An unresolvable problem occurred while calculating the upgrade.\n"
"\n"
"Please report this bug against the 'update-manager' package and include the "
"following error message:\n"
msgstr ""
"Un problèma insoluble es aparegut pendent lo calcul de la mesa a nivèl.\n"
"\n"
"Mercé de senhalar aqueste bug relatiu a 'update-manager' e d'inclure lo "
"messatge d'error seguent :\n"

#: ../UpdateManager/UpdatesAvailable.py:263
msgid "Install Now"
msgstr "Installar ara"

#: ../UpdateManager/UpdatesAvailable.py:298
msgid "Install or remove"
msgstr "Installar o suprimir"

#: ../UpdateManager/UpdatesAvailable.py:340
msgid "Download"
msgstr "Telecargar"

#: ../UpdateManager/UpdatesAvailable.py:406
msgid "_Remind Me Later"
msgstr "Lo me _remembrar mai tard"

#. upload_archive = version_match.group(2).strip()
#: ../UpdateManager/UpdatesAvailable.py:559
#, python-format
msgid "Version %s: \n"
msgstr "Version %s : \n"

#: ../UpdateManager/UpdatesAvailable.py:631
msgid ""
"No network connection detected, you can not download changelog information."
msgstr ""
"Cap de connexion de ret es pas estada detectada. Podètz pas telecargar la "
"lista de cambiaments."

#: ../UpdateManager/UpdatesAvailable.py:644
msgid "Downloading list of changes..."
msgstr "Telecargament de la lista de las modificacions…"

#: ../UpdateManager/UpdatesAvailable.py:690
msgid "_Deselect All"
msgstr "_Deseleccionar tot"

#: ../UpdateManager/UpdatesAvailable.py:697
msgid "Select _All"
msgstr "Seleccionar _tot"

#: ../UpdateManager/UpdatesAvailable.py:797
#, python-format
msgid "%s will be downloaded."
msgstr "%s serà(n) telecargat(s)."

#: ../UpdateManager/UpdatesAvailable.py:812
msgid "The update has already been downloaded."
msgid_plural "The updates have already been downloaded."
msgstr[0] "La mesa a jorn es estada telecargada ja."
msgstr[1] "Las mesas a jorn son estadas telecargadas ja."

#: ../UpdateManager/UpdatesAvailable.py:819
msgid "There are no updates to install."
msgstr "I a pas de mesas a jorn d'installar."

#: ../UpdateManager/UpdatesAvailable.py:828
msgid "Unknown download size."
msgstr "Talha del telecargament desconeguda."

#: ../UpdateManager/UpdatesAvailable.py:856
#, python-format
msgid ""
"Updated software has been issued since %s %s was released. Do you want to "
"install it now?"
msgstr ""
"Un logicial mes a jorn es paregut dempuèi que %s %s es sortit. Lo volètz "
"installar ara ?"

#: ../UpdateManager/UpdatesAvailable.py:862
msgid ""
"Updated software is available for this computer. Do you want to install it "
"now?"
msgstr ""
"Una mesa a jorn es disponibla per aqueste ordenador. La volètz installar "
"ara ?"

#: ../UpdateManager/UpdatesAvailable.py:867
msgid ""
"The computer also needs to restart to finish installing previous updates."
msgstr ""
"L'ordenador deu tanben èsser reaviat per acabar l'installacion de las mesas "
"a jorn precedentas."

#. print("on_button_install_clicked")
#: ../UpdateManager/UpdatesAvailable.py:898
msgid "Not enough free disk space"
msgstr "Pas pro d'espaci liure sul disc"

#: ../UpdateManager/UpdatesAvailable.py:900
#, python-format
msgid ""
"The upgrade needs a total of %s free space on disk '%s'. Please free at "
"least an additional %s of disk space on '%s'. %s"
msgstr ""
"La mesa a nivèl requerís un total de %s d’espaci disc liure sul disc « %s ». "
"Liberatz almens %s d’espaci disc sus « %s ». %s"

#: ../UpdateManager/UpdatesAvailable.py:905
msgid ""
"Remove temporary packages of former installations using 'sudo apt clean'."
msgstr ""
"Suprimir los paquets temporaris d’installacions precedentas en utilizant "
"« sudo apt clean »."

#: ../UpdateManager/UpdatesAvailable.py:909
msgid ""
"You can remove old kernels using 'sudo apt autoremove', and you could also "
"set COMPRESS=xz in /etc/initramfs-tools/initramfs.conf to reduce the size of "
"your initramfs."
msgstr ""
"Podètz suprimir los kernels ancians en utilizant « sudo apt autoremove », e "
"podètz tanben definir COMPRESS=xz in /etc/initramfs-tools/initramfs.conf per "
"reduire la talha de vòstre initramfs."

#: ../UpdateManager/UpdatesAvailable.py:914
msgid ""
"Empty your trash and remove temporary packages of former installations using "
"'sudo apt clean'."
msgstr ""
"Voidatz l’escobilhièr e suprimissètz los paquets temporaris d’ancianas "
"installacion en utilizant « sudo apt clean »,"

#: ../UpdateManager/UpdatesAvailable.py:917
msgid "Reboot to clean up files in /tmp."
msgstr "Reaviatz per netejar los fichièrs dins /tmp."

#: ../UpdateManager/UpdatesAvailable.py:979
msgid "Connecting..."
msgstr "Connexion…"

#: ../UpdateManager/UpdatesAvailable.py:999
msgid "You may not be able to check for updates or download new updates."
msgstr "Benlèu que podètz pas verificar o telecargar de mesas a jorn."

#: ../UpdateManager/UpdatesAvailable.py:1164
msgid "Improved hardware support"
msgstr "Presa en carga materiala melhorada"

#: ../UpdateManager/UpdatesAvailable.py:1168
msgid "Security updates"
msgstr "Mesas a jorn de seguretat"

#: ../UpdateManager/UpdatesAvailable.py:1173
msgid "Other updates"
msgstr "Autras mesas a jorn"

#: ../UpdateManager/UpdatesAvailable.py:1177
msgid "Updates"
msgstr "Mesas a jorn"

#: ../UpdateManager/UpdatesAvailable.py:1182
msgid "Unused kernel updates to be removed"
msgstr "Kernel pas utilizat per èsser suprimit"

#: ../UpdateManager/UpdatesAvailable.py:1188
msgid "Duplicate packages to be removed"
msgstr "Paquets en doble de suprimir"

#: ../UpdateManager/UpdatesAvailable.py:1194
msgid "Ubuntu Pro (enable in Settings…)"
msgstr "Ubuntu Pro (activar als Paramètres…)"

#: ../UpdateManager/UnitySupport.py:73
msgid "Install All Available Updates"
msgstr "Installar totas las mesas a jorn disponiblas"

#: ../UpdateManager/Core/MyCache.py:459
msgid "This update does not come from a source that supports changelogs."
msgstr ""
"Aquesta mesa a jorn proven d'una font que provesís pas de nòtas de version."

#: ../UpdateManager/Core/MyCache.py:466 ../UpdateManager/Core/MyCache.py:508
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Lo telecargament de la lista de las modificacions a fracassat.\n"
"Verificatz vòstra connexion Internet."

#: ../UpdateManager/Core/MyCache.py:475
#, python-format
msgid ""
"Changes for %s versions:\n"
"Installed version: %s\n"
"Available version: %s\n"
"\n"
msgstr ""
"Cambiaments per las versions %s :\n"
"Version installada : %s\n"
"Version disponibla : %s\n"
"\n"

#: ../UpdateManager/Core/MyCache.py:493
#, python-format
msgid ""
"The changelog does not contain any relevant changes.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Lo fichièr d'istoric de desvolopament conten pas cap de modificacion "
"pertinenta.\n"
"\n"
"Utilizatz http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"fins al moment que las modificacions seràn disponiblas o tornatz ensajar pus "
"tard."

#: ../UpdateManager/Core/MyCache.py:500
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"La lista de las modificacions es pas encara disponibla.\n"
"\n"
"Consultatz http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"en esperant que siá disponibla, o tornatz ensajar mai tard."

#. Translators: the %s is a distro name, like 'Ubuntu' and 'base' as in
#. the core components and packages.
#: ../UpdateManager/Core/UpdateList.py:189
#, python-format
msgid "%s base"
msgstr "%s basa"

#. TRANSLATORS: download size of small updates, e.g. "250 kB"
#: ../UpdateManager/Core/utils.py:487
#, python-format
msgid "%(size).0f kB"
msgid_plural "%(size).0f kB"
msgstr[0] "%(size).0f ko"
msgstr[1] "%(size).0f ko"

#. TRANSLATORS: download size of updates, e.g. "2.3 MB"
#: ../UpdateManager/Core/utils.py:492
#, python-format
msgid "%.1f MB"
msgstr "%.1f Mo"

#: ../data/gtkbuilder/UpdateManager.ui.h:1
msgid "updates"
msgstr "mesas a jorn"

#: ../data/gtkbuilder/UpdateManager.ui.h:2
msgid "Changes"
msgstr "Cambiaments"

#: ../data/gtkbuilder/UpdateManager.ui.h:3
msgid "Description"
msgstr "Descripcion"

#: ../data/gtkbuilder/UpdateManager.ui.h:4
msgid "Technical description"
msgstr "Descripcion tecnica"

#: ../data/gtkbuilder/UpdateManager.ui.h:5
msgid "Details of updates"
msgstr "Detalhs de las mesas a jorn"

#: ../data/gtkbuilder/UpdateManager.ui.h:6
msgid "The computer will need to restart."
msgstr "Caldrà reaviar l'ordenador."

#: ../data/gtkbuilder/UpdateManager.ui.h:7
msgid ""
"You are connected via roaming and may be charged for the data consumed by "
"this update."
msgstr ""
"Sètz connectat en itinerància e vos pòdon facturar per las donadas "
"consomadas per aquesta mesa a jorn."

#: ../data/gtkbuilder/UpdateManager.ui.h:8
msgid ""
"You may want to wait until you’re not using a mobile broadband connection."
msgstr ""
"Benlèu que voldretz esperar d'utilizar pas mai una connexion mobila de benda "
"larga."

#: ../data/gtkbuilder/UpdateManager.ui.h:9
msgid "It’s safer to connect the computer to AC power before updating."
msgstr ""
"Es mai segur de brancar l'ordenador sus una alimentacion sector abans la "
"mesa a jorn."

#: ../data/update-manager.desktop.in.h:2
msgid "Software Updates"
msgstr "Mesas a jorn dels logicials"

#: ../data/update-manager.desktop.in.h:3
#: ../data/update-manager.appdata.xml.in.h:2
msgid "Show and install available updates"
msgstr "Afichar e installar las mesas a jorn disponiblas"

#: ../data/update-manager.appdata.xml.in.h:3
msgid ""
"Software Updater checks for updates using apt and let you choose which "
"updates to install."
msgstr ""
"Lo gestionari de mesas a jorn verifica las mesas a jorn en utilizant apt and "
"vos daissa causir quinas mesas a jorn installar."

#: ../update-manager:75
msgid "Show version and exit"
msgstr "Afichar lo numèro de version e tampar"

#: ../update-manager:78
msgid "Directory that contains the data files"
msgstr "Dorsièr que conten los fichièrs de donadas"

#: ../update-manager:81
msgid "Check if a new Ubuntu release is available"
msgstr "Verificar se una version novèla d'Ubuntu es disponibla"

#: ../update-manager:84
msgid ""
"If using the latest supported release, upgrade to the development release"
msgstr ""
"Se utilizatz la darrièra version presa en carga, passatz a la version de "
"desvolopament"

#: ../update-manager:88
msgid "Upgrade using the latest proposed version of the release upgrader"
msgstr ""
"Metre a nivèl en utilizant la darrièra version prepausada de l'assistent de "
"mesa a jorn de la distribucion"

#: ../update-manager:95
msgid "Do not focus on map when starting"
msgstr "Capturar pas lo focus a l'aviada"

#: ../update-manager:98
msgid "Do not check for updates when starting"
msgstr "Verificar pas las mesas a jorn a l'aviada"

#: ../update-manager:100
msgid "Show debug messages"
msgstr "Afichar los messatges de desbugatge"

#. Why do we use %s here instead of $strings or {} format placeholders?
#. It's because we don't want to break existing translations.
#: ../janitor/plugincore/exceptions.py:39
#, python-format
msgid "Unimplemented method: %s"
msgstr "Metòde pas implementat : %s"

#: ../janitor/plugincore/core/file_cruft.py:42
msgid "A file on disk"
msgstr "Un fichièr sus disc"

#: ../janitor/plugincore/core/missing_package_cruft.py:37
msgid "Install missing package."
msgstr "Installacion del paquet mancant."

#. 2012-06-08 BAW: i18n string; don't use {} or PEP 292.
#: ../janitor/plugincore/core/missing_package_cruft.py:47
#, python-format
msgid "Package %s should be installed."
msgstr "Lo paquet %s deuriá èsser installat."

#: ../janitor/plugincore/core/package_cruft.py:47
msgid ".deb package"
msgstr "paquet .deb"

#: ../janitor/plugincore/plugins/langpack_manual_plugin.py:43
#, python-format
msgid "%s needs to be marked as manually installed."
msgstr "%s deu èsser marcat per una installacion manuala."

#: ../janitor/plugincore/plugins/kdelibs4to5_plugin.py:51
msgid ""
"When upgrading, if kdelibs4-dev is installed, kdelibs5-dev needs to be "
"installed. See bugs.launchpad.net, bug #279621 for details."
msgstr ""
"Se kdelibs4-dev es installat, kdelibs5-dev deu èsser installat al moment de "
"la mesa a nivèl. Consultatz lo rapòrt de bug #279621 sus launchpad.net per "
"mai d'entresenhas."

#: ../janitor/plugincore/plugins/dpkg_status_plugin.py:40
#, python-format
msgid "%i obsolete entries in the status file"
msgstr "%i entradas obsoletas dins lo fichièr « status »"

#: ../janitor/plugincore/plugins/dpkg_status_plugin.py:43
msgid "Obsolete entries in dpkg status"
msgstr "Entradas obsoletas dins lo fichièr « status » del paquet"

#. pragma: no cover
#: ../janitor/plugincore/plugins/dpkg_status_plugin.py:46
msgid "Obsolete dpkg status entries"
msgstr "Entradas obsoletas dins lo fichièr « status »"

#: ../janitor/plugincore/plugins/remove_lilo_plugin.py:40
msgid ""
"Remove lilo since grub is also installed.(See bug #314004 for details.)"
msgstr ""
"Suprimir Lilo perque Grub es installat ja. (Vejatz bug #314004 per mai de "
"detalhs.)"
