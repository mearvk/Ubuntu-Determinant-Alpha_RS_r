msgid "Middle-Click action"
msgstr "Accion del clic mitan"

#: Settings.ui.h:17
msgid "Behavior for Shift+Middle-Click."
msgstr "Comportament per Shift+Clic mitan"

#: Settings.ui.h:18
msgid "Shift+Middle-Click action"
msgstr "Accion de Shift+Clic mitan"

#: Settings.ui.h:19
msgid "Enable Unity7 like glossy backlit items"
msgstr "Activar un fons brilhant a la Unity7"

#: Settings.ui.h:20
msgid "Apply glossy effect."
msgstr "Aplicar un efèit lusent."

#: Settings.ui.h:21
msgid "Use dominant color"
msgstr "Utilizar la color dominanta"

#: Settings.ui.h:22
msgid "Customize indicator style"
msgstr "Reglar l'estil dels indicators"

#: Settings.ui.h:23
msgid "Color"
msgstr "Color"

#: Settings.ui.h:24
msgid "Border color"
msgstr "Color de la bordadura"

#: Settings.ui.h:25
