#: Settings.ui.h:1
msgid ""
"When set to minimize, double clicking minimizes all the windows of the "
"application."
msgstr ""
"Quand reglat sus Minimizar, clicar doble minimiza totas las fenèstras de "
"l'aplicacion."

#: Settings.ui.h:2
msgid "Shift+Click action"
msgstr "Acction Shift+Clic"

#: Settings.ui.h:3
msgid "Raise window"
msgstr "Far aparéisser la fenèstra"

#: Settings.ui.h:4
msgid "Minimize window"
msgstr "Reduire la fenèstra"

#: Settings.ui.h:5
msgid "Launch new instance"
msgstr "Aviar una fenèstra novèla"

#: Settings.ui.h:6
msgid "Cycle through windows"
msgstr "Ciclar sus las fenèstras"

#: Settings.ui.h:7
msgid "Minimize or overview"
msgstr "Minimizar o lancer l'exposé"

#: Settings.ui.h:8
msgid "Show window previews"
msgstr "Afichar d'apercebuts de fenèstras"

#: Settings.ui.h:9
msgid "Minimize or show previews"
msgstr "Reduire o afichar los apercebuts"

#: Settings.ui.h:10
msgid "Focus or show previews"
msgstr "Activar o mostrar l’apercebut"

#: Settings.ui.h:12
msgid "Focus, minimize or show previews"
msgstr "Focalizar, minimizar o mostrar apercebuts"

#: Settings.ui.h:14
msgid "Quit"
msgstr "Quitar"

