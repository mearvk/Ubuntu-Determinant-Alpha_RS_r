msgid "Disable Show Desktop in the Switcher"
msgstr "Desactivar l'afichatge del burèu dins lo selector de fenèstra"

#: ../plugins/unityshell/unityshell.xml.in.h:149
msgid "Disables the Show Desktop icon in the Switcher."
msgstr ""
"Desactiva l'icòna d'afichatge del burèu dins lo selector de fenèstra."

