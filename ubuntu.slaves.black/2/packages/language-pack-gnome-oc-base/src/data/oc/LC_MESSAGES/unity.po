#: ../plugins/unityshell/unityshell.xml.in.h:114
msgid "Pulse"
msgstr "Cluquetejament"

#: ../plugins/unityshell/unityshell.xml.in.h:115
msgid "Wiggle"
msgstr "Gigòtament"

#: ../plugins/unityshell/unityshell.xml.in.h:116
msgid "Menus"
msgstr "Menús"

