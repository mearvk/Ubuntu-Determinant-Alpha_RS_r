#: src/DebugInstaller.cpp:49
msgctxt "@info Error message"
msgid "No file paths were provided, so no debug packages could be found."
msgstr ""
"Ingen filstier blev angivet, så ingen fejlretningspakker kunne findes."

#: src/DebugInstaller.cpp:52 src/DebugInstaller.cpp:81
msgctxt "@title:window"
msgid "Couldn't find debug packages"
msgstr "Kunne ikke finde fejlretningspakker"

#: src/DebugInstaller.cpp:78
msgctxt "@info"
msgid ""
"No debug packages could be found for the files listed below.\n"
"Do you want to continue anyway?"
msgstr ""
"Ingen fejlretningspakker kunne findes for filerne i listen nedenfor.\n"
"Vil du alligevel fortsætte?"

#: src/DebugInstaller.cpp:94
msgctxt "@info"
msgid ""
"Do you want to install the following debug packages so that the necessary "
"debug symbols become available?"
msgstr ""
"Vil du installere de følgende fejlretningspakker, så de nødvendige "
"fejlretningssymboler bliver tilgængelige?"

#: src/DebugInstaller.cpp:96
msgctxt "@title:window"
msgid "Confirm package installation"
msgstr "Bekræft pakkeinstallation"

#: src/DebugInstaller.cpp:99
msgctxt "@action:button"
msgid "Install"
msgstr "Installér"

#: src/DebugInstaller.cpp:161
msgctxt "@info:progress"
msgid "Looking for debug packages"
msgstr "Søger fejlretningspakker"

#: src/main.cpp:31
msgid "A debug package installer for Kubuntu"
msgstr "En fejlretningspakkehåndtering til Kubuntu"

#: src/main.cpp:35
msgid "Debug package installer"
msgstr "Fejlretningspakkeinstallering"

#: src/main.cpp:37
msgid "(C) 2010 Harald Sitter"
msgstr "(C) 2010 Harald Sitter"

#: src/main.cpp:39
