#: src/querycmd.c dpkg-deb/main.c
#, c-format
msgid ""
"Format syntax:\n"
"  A format is a string that will be output for each package. The format\n"
"  can include the standard escape sequences \\n (newline), \\r (carriage\n"
"  return) or \\\\ (plain backslash). Package information can be included\n"
"  by inserting variable references to package fields using the "
"${var[;width]}\n"
"  syntax. Fields will be right-aligned unless the width is negative in "
"which\n"
"  case left alignment will be used.\n"
msgstr ""
"ढाँचाबद्ध वाक्य संरचना:\n"
"  ढाँचा स्ट्रिङ हो जो प्रत्येक प्याकेजको लागि निर्गात हुनेछ । ढाँचाले\n"
"   छोडिएका मानक अनुक्रमहरू \\n (newline), \\r (carriage\n"
"  return) वा \\\\ (plain backslash) समावेश गर्न सक्छ । प्याकेज फाँटहरुमा "
"${var[;width]} वाक्यसंरचना प्रयोग गरेर चल सन्दर्भहरू घुसाएर सूचनाहरू समावेश "
"गर्न सकिन्छ ।\n"
"चौडा नकारात्मक भएता पनि फाँटहरू सही संलग्न छन् जुन केसमा छोडिएका रेखाहरू "
