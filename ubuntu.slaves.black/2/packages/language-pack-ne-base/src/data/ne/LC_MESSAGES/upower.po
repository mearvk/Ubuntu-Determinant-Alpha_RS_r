#. TRANSLATORS: exit after we've started up, used for user profiling
#: src/up-main.c:187
msgid "Exit after a small delay"
msgstr "सानो ढिलाइ पछि बन्द हुनेछ"

#. TRANSLATORS: exit straight away, used for automatic profiling
#: src/up-main.c:190
msgid "Exit after the engine has loaded"
msgstr "इन्जिन लोड भए पछि बन्द हुनेछ"

#: src/up-main.c:192
msgid "Replace the old daemon"
msgstr ""

#: src/up-main.c:194
msgid "Show extra debugging information"
msgstr "थप डिबग्गिङ जानकारी"

#: tools/up-tool.c:261
msgid "Enumerate objects paths for devices"
msgstr "यन्त्रहरूको लागि अब्जेक्ट पाथहरू इन्युमरेट गर्नुहोस्"

#: tools/up-tool.c:262
msgid "Dump all parameters for all objects"
msgstr "सबै अब्जेक्टहरूको प्यारामिटरहरू डम्प गर्नुहोस्"

#: tools/up-tool.c:263
msgid "Get the wakeup data"
msgstr "वेकअप डेटा प्राप्त गर्नुहोस्"

#: tools/up-tool.c:264
msgid "Monitor activity from the power daemon"
msgstr "पावर डेमबाट कार्यहरू निरिक्षण गर्नुहोस्"

#: tools/up-tool.c:265
msgid "Monitor with detail"
msgstr "विस्तारित जानकारी सहित निरिक्षण गर्नुहोस्"

#: tools/up-tool.c:266
msgid "Show information about object path"
msgstr "अब्जेक्ट पाथहरूबारे जानकारी देखाउनुहोस्"
