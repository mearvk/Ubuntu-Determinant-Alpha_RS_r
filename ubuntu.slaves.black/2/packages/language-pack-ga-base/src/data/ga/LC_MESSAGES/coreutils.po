"  -k                    ar comhbhrí le `--block-size=1K'\n"
"  -l, --local           ná taispeáin ach córais chomhaid logánta\n"
"      --no-sync         ná sync roimh eolas úsáide a fháil (réamhshocrú)\n"

#: src/df.c:1559
