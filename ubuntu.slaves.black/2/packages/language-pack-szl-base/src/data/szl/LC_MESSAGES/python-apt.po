#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Serwer dlo kroju %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Bazowy serwer"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Inksze serwery"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Brak ôpisu dlo „%s”. Wyślij report błyndu."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Niynoleżny znak unikodu w ôpisie paketu „%s” (%s). Zgłoś tyn błōnd."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Wykoz zmian niyma dostympny"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Wykoz zmian niyma jeszcze dostympny.\n"
"\n"
"Użyj http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"aż zmiany bydōm udostympniōne abo sprōbuj niyskorzij."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Niy szło pobrać listy zmian. \n"
"Wejzdrzij na połōnczynie necowe."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Niy szło ôdczytać listy zbiorōw „%s”"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Niy szło ôdczytać listy zbiorōw kōntrolnych „%s”"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Zależność niy je społniōno: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Kōnflikty z zainstalowanym paketym „%s”"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Psuje paket, co już istniyje \"%(pkgname)s\" zależność %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Psuje paket, co już istniyje \"%(pkgname)s\" kōnflikt: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Psuje paket, co już istniyje \"%(pkgname)s\", co wadzi sie ze: "
"\"%(targetpkg)s\". Je ôn udostympniany ôd \"%(debfile)s\" ze pōmocōm: "
"\"%(provides)s\""

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Brakuje pola architektury (Architecture) w pakecie"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Niynoleżno architektura „%s” -- Sztartnij dpkg --add-architecture, coby jōm "
"przidać i dokōnać aktualizacyje"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Nowszo wersyjo je już zainstalowano"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr ""
"Niy szło sie społnić wszyjskich zależności (popsuto pamiyńć podrynczno)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Niy idzie zainstalować „%s”"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Autōmatycznie rozpakowane:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Autōmatycznie skōnwertowane do durkowalnego ascii:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Instalacyjo zależności budowanio paketu zdrzōdłowego „%s”, co buduje %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Kōnieczny paket musiołby być skasowany"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Gotowe"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Stary "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign. "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Feler "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Pobier:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Robi]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Pōmiana medium: wraź dysk ôznaczōny „%s”\n"
"do napyndu „%s” i wciść enter\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Pobrane %sB we %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
