msgstr "Aegumise veeru näitamine"

#: data/org.gnome.seahorse.manager.gschema.xml:44
msgid "Show trust column"
msgstr "Kuva usaldusveerg"

#: data/org.gnome.seahorse.manager.gschema.xml:49
