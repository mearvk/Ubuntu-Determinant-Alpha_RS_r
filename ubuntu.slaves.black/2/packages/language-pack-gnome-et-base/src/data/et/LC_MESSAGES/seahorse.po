#: data/org.gnome.seahorse.gschema.xml:5
msgid "Auto retrieve keys"
msgstr "Võtmete automaatne toomine"

#: data/org.gnome.seahorse.gschema.xml:6
msgid ""
"Whether or not keys should be automatically retrieved from key servers."
msgstr "Kas võtmeid tuleb võtmeserveritest automaatselt tõmmata või mitte."

#: data/org.gnome.seahorse.gschema.xml:10
msgid "Auto publish keys"
msgstr "Võtmete automaatne avaldamine"

#: data/org.gnome.seahorse.gschema.xml:11
msgid "Whether or not modified keys should be automatically published."
msgstr "Kas muudetud võtmed tuleks automaatselt avaldada või mitte."

#: data/org.gnome.seahorse.gschema.xml:15
msgid "Publish keys to this key server"
msgstr "Avalda võtmed selles võtmeserveris"

#: data/org.gnome.seahorse.gschema.xml:16
msgid ""
"The key server to publish PGP keys to. Or empty to suppress publishing of "
"PGP keys."
msgstr ""
"PGP-võtmete avaldamiseks kasutatav võtmeserver. Kui võtmeid ei soovita "
"avadada, siis on see tühi."

#: data/org.gnome.seahorse.gschema.xml:20
msgid "Last key server search pattern"
msgstr "Viimane võtmeserveri otsingumuster"

#: data/org.gnome.seahorse.gschema.xml:21
msgid "The last search pattern searched for against a key server."
msgstr "Võtmeserverist otsimisel viimati kasutatud muster."

#: data/org.gnome.seahorse.gschema.xml:25
msgid "Last key servers used"
msgstr "Viimati kasutatud võtmeserverid"

#: data/org.gnome.seahorse.gschema.xml:26
msgid ""
"The last key server a search was performed against or empty for all key "
"servers."
msgstr ""
"Viimane võtmeserver, millest otsingut läbi viidi. Tühi väärtus tähendab "
"kõiki võtmeservereid."

#: data/org.gnome.seahorse.manager.gschema.xml:5
msgid "Show keyrings sidebar"
msgstr "Kuva võtmehoidjate külgriba"

#: data/org.gnome.seahorse.manager.gschema.xml:6
msgid "Show keyrings sidebar in Seahorse."
msgstr "Kuva Seahorse'is võtmehoidjate külgriba."

#: data/org.gnome.seahorse.manager.gschema.xml:10
msgid "Which items to show"
msgstr "Milliseid üksusi näidata"

#: data/org.gnome.seahorse.manager.gschema.xml:11
msgid ""
"Filter which items to show. If empty, show all items, if “personal” show "
"personal keys, if “trusted” show trusted."
msgstr ""
"Filtreeri, milliseid üksusi kuvada. Kui see on tühi, kuvage kõik üksused, "
"kui „isiklik”, kuva isiklikud võtmed, kui „usaldusväärne”, kuva "
"usaldusväärsed."

