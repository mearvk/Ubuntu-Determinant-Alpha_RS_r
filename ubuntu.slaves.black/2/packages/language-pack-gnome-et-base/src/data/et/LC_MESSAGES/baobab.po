#: data/org.gnome.baobab.appdata.xml.in:6 data/org.gnome.baobab.desktop.in:3
#: data/ui/baobab-main-window.ui:35 src/baobab-window.vala:288
msgid "Disk Usage Analyzer"
msgstr "Kettakasutuse analüsaator"

#: data/org.gnome.baobab.appdata.xml.in:7 data/org.gnome.baobab.desktop.in:4
msgid "Check folder sizes and available disk space"
msgstr "Kaustade suuruse ja saadaoleva kettaruumi kontroll"

#: data/org.gnome.baobab.appdata.xml.in:9
msgid ""
"A simple application to keep your disk usage and available space under "
"control."
msgstr ""
"Lihtne rakendus, mis hoiab sinu kettakasutust ja vaba ruumi kontrolli all."

#: data/org.gnome.baobab.appdata.xml.in:12
msgid ""
"Disk Usage Analyzer can scan specific folders, storage devices and online "
"accounts. It provides both a tree and a graphical representation showing the "
"size of each folder, making it easy to identify where disk space is wasted."
msgstr ""
"Kettakasutuse analüsaator saab skannida konkreetseid kaustu, "
"salvestusseadmeid ja võrgukontosid. See pakub nii puu kui ka graafilist "
"esitust, mis näitab iga kausta suurust, muutes kettaruumi raiskamise "
"hõlpsaks tuvastamiseks."

