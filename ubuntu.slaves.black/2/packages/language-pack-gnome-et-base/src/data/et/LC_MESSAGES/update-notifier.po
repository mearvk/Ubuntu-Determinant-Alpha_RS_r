#: ../data/apt_check.py:62
#, python-format
msgid "Unknown Error: '%s' (%s)"
msgstr "Tundmatu viga: '%s' (%s)"

#: ../data/apt_check.py:151
#, python-format
msgid "%d of these updates is an ESM %s security update."
msgid_plural "%d of these updates are ESM %s security updates."
msgstr[0] "%d neist värskendustest on ESM-i %s turvavärskendus."
msgstr[1] "%d neist värskendustest on ESM-i %s turvavärskendused."

#: ../data/apt_check.py:180
#, python-format
msgid ""
"%i additional security update can be applied with ESM %s.\n"
"Learn more about enabling ESM %s service %s"
msgid_plural ""
"%i additional security updates can be applied with ESM %s.\n"
"Learn more about enabling ESM %s service %s"
msgstr[0] ""
"%i täiendavat turvavärskendust saab rakendada ESM-iga %s.\n"
"Lisateave ESM-i %s teenuse %s lubamise kohta"
msgstr[1] ""
"%i täiendavaid turvavärskendusi saab rakendada ESM-iga %s\n"
"Lisateave ESM-i %s teenuse %s lubamise kohta"

#: ../data/apt_check.py:196
#, python-format
msgid "Enable ESM %s to receive additional future security updates."
msgstr "Täiendavate tulevaste turvavärskenduste saamiseks lubage ESM %s."

#: ../data/apt_check.py:204
msgid "See https://ubuntu.com/esm or run: sudo pro status"
msgstr "Vaata https://ubuntu.com/esm või käivita: sudo pro status"

#: ../data/apt_check.py:212
#, python-format
msgid "Expanded Security Maintenance for %s is enabled."
msgstr "Laiendatud turbehooldus %s jaoks on lubatud."

#: ../data/apt_check.py:216
#, python-format
msgid "Expanded Security Maintenance for %s is not enabled."
msgstr "Laiendatud turbehooldus %s jaoks pole lubatud."

#: ../data/apt_check.py:243
#, python-format
msgid "%i update can be applied immediately."
msgid_plural "%i updates can be applied immediately."
msgstr[0] "%i värskenduse saab kohe rakendada."
msgstr[1] "%i värskendust saab kohe rakendada."

#: ../data/apt_check.py:256
#, python-format
msgid "%i of these updates is a standard security update."
msgid_plural "%i of these updates are standard security updates."
msgstr[0] "%i neist värskendustest on klassikaline turvavärskendus."
msgstr[1] "%i neist värskendustest on klassikalised turvavärskendused."

#: ../data/apt_check.py:266
msgid "To see these additional updates run: apt list --upgradable"
msgstr ""
"Nende täiendavate värskenduste käitamiseks toimige järgmiselt: apt list --"
"upgradable"

#: ../data/apt_check.py:373
#, python-format
msgid "Error: Opening the cache (%s)"
msgstr "Viga: puhvri avamine (%s)"

#: ../data/apt_check.py:383
msgid "Error: BrokenCount > 0"
msgstr "Viga: BrokenCount > 0"

#: ../data/apt_check.py:390
#, python-format
msgid "Error: Marking the upgrade (%s)"
msgstr "Viga: uuendamise märkimine (%s)"

#: ../data/apt_check.py:503
msgid "Show the packages that are going to be installed/upgraded"
msgstr "Näidatakse paigaldatavaid/uuendatavaid pakette"

#: ../data/apt_check.py:509
msgid "Show human readable output on stdout"
msgstr "Stdout-is näidatakse inimloetavat väljundit"

#: ../data/apt_check.py:513
msgid ""
"Return the time in days when security updates are installed unattended (0 "
"means disabled)"
msgstr ""
"Tagastab aja päevades, mille järel turvauuendused paigaldatakse ilma "
"kasutaja sekkumata (0 tähendab välja lülitatud)"

#: ../src/crash.c:46 ../src/system-crash.c:20
msgid "System program problem detected"
msgstr "Süsteemi programmi viga tuvastatud"

#: ../src/crash.c:47 ../src/system-crash.c:21
msgid "Do you want to report the problem now?"
msgstr "Kas soovid probleemist kohe teatada?"

#: ../src/crash.c:57 ../src/system-crash.c:31
msgid "Report problem…"
msgstr "Probleemist teatamine…"

#: ../src/crash.c:99 ../src/crash.c:206
msgid "Crash report detected"
msgstr "Tuvastati vearaport"

#: ../src/crash.c:100
msgid ""
"An application has crashed on your system (now or in the past). Click on the "
"notification icon to display details. "
msgstr ""
"Üks rakendus on sinu arvutis kokku jooksnud (äsja või minevikus). "
"Üksikasjade vaatamiseks klõpsa teavitusikoonil. "

#: ../src/cdroms.c:48
msgid "Software Packages Volume Detected"
msgstr "Avastati tarkvarapakettide andmekandja"

#: ../src/cdroms.c:49
msgid ""
"<span weight=\"bold\" size=\"larger\">A volume with software packages has "
"been detected.</span>\n"
"\n"
"Would you like to open it with the package manager?"
msgstr ""
"<span weight=\"bold\" size=\"larger\">Avastati tarkvarapakettide "
"andmekandja.</span>\n"
"\n"
"Kas sa tahad seda avada paketihalduriga?"

#: ../src/cdroms.c:57
msgid "Start Package Manager"
msgstr "Käivita paketihaldur"

#: ../src/cdroms.c:63
msgid "Upgrade volume detected"
msgstr "Andmekandjalt avastati versiooniuuendus"

#: ../src/cdroms.c:64
msgid ""
"<span weight=\"bold\" size=\"larger\">A distribution volume with software "
"packages has been detected.</span>\n"
"\n"
"Would you like to try to upgrade from it automatically? "
msgstr ""
"<span weight=\"bold\" size=\"larger\">Avastati distributsiooni "
"tarkvarapakettidega andmekandja.</span>\n"
"\n"
"Kas sa tahad proovida sellelt andmekandjalt automaatselt uuendada? "

#: ../src/cdroms.c:71
msgid "Run upgrade"
msgstr "Käivita uuendamine"

#: ../src/cdroms.c:79
msgid "APTonCD volume detected"
msgstr "Avastati APTonCD andmekandja"

#: ../src/cdroms.c:80
msgid ""
"<span weight=\"bold\" size=\"larger\">A volume with unofficial software "
"packages has been detected.</span>\n"
"\n"
"Would you like to open it with the package manager?"
msgstr ""
"<span weight=\"bold\" size=\"larger\">Avastati mitteametlike "
"tarkvarapakettidega andmekandja.</span>\n"
"\n"
"Kas soovid selle avada paketihalduriga?"

#: ../src/cdroms.c:88 ../src/update.c:39
msgid "Start package manager"
msgstr "Käivita paketihaldur"

#: ../src/hooks.c:412 ../ui/hooks-dialog.ui.h:2
msgid "_Run this action now"
msgstr "_Käivita see tegevus kohe"

#: ../src/hooks.c:564 ../src/hooks.c:723
msgid "Information available"
msgstr "Informatsioon saadaval"

#: ../src/hooks.c:724
msgid "Click on the notification icon to show the available information.\n"
msgstr "Saadaval oleva info kuvamiseks klõpsa teateikoonil.\n"

#: ../src/livepatch.c:62 ../src/livepatch.c:64
msgid "Show Settings…"
msgstr "Kuva seaded…"

#: ../src/livepatch.c:135
msgid "An update has just been applied."
msgstr "Äsja rakendati värskendus."

#: ../src/livepatch-tray.c:85
msgid "Livepatch Settings…"
msgstr "Livepatchi seaded…"

#: ../src/livepatch-tray.c:118
msgid "Livepatch is on"
msgstr "Livepatch on sisse lülitatud"

#: ../src/livepatch-tray.c:146
msgid "No current updates"
msgstr "Hetkel värskendusi ei ole"

#: ../src/livepatch-tray.c:148
#, c-format
msgid "%zd current update"
msgid_plural "%zd current updates"
msgstr[0] "%zd praegune värskendus"
msgstr[1] "%zd praeguseid värskendusi"

#: ../src/livepatch-tray.c:168
msgid "An error occured when checking for Livepatch updates."
msgstr "Livepatchi värskenduste otsimisel ilmnes viga."

#: ../src/livepatch-tray.c:173
msgid "An error occured when applying Livepatch updates."
msgstr "Livepatchi värskenduste rakendamisel ilmnes viga."

#: ../src/update.c:28
msgid "Show updates"
msgstr "Näita uuendusi"

#: ../src/update.c:32
msgid "Install all updates"
msgstr "Paigalda kõik uuendused"

#: ../src/update.c:36
msgid "Check for updates"
msgstr "Otsi uuendusi"

#: ../src/update.c:83
#, c-format
msgid "There is %i update available"
msgid_plural "There are %i updates available"
msgstr[0] "Saadaval on %i uuendus"
msgstr[1] "Saadaval on %i uuendust"

#: ../src/update.c:147
msgid "Show notifications"
msgstr "Näita teateid"

#. and update the tooltip
#: ../src/update.c:203
msgid "A package manager is working"
msgstr "Paketihaldur töötab"

#: ../src/update.c:235
#, c-format
msgid ""
"There is %i update available. Click on the notification icon to show the "
"available update."
msgid_plural ""
"There are %i updates available. Click on the notification icon to show the "
"available updates."
msgstr[0] ""
"Saadaval on %i uuendus. Saadaoleva uuenduse kuvamiseks klõpsa "
"märguandeikoonil."
msgstr[1] ""
"Saadaval on %i uuendust. Saadaolevate uuenduste kuvamiseks klõpsa "
"märguandeikoonil."

#: ../src/update.c:246
msgid "Software updates available"
msgstr "Tarkvara uuendused saadaval"

#: ../src/update.c:284
msgid ""
"The update information is outdated. This may be caused by network problems "
"or by a repository that is no longer available. Please update manually by "
"selecting 'Show updates' from the indicator menu, and watching for any "
"failing repositories."
msgstr ""
"Värskendusteave on aegunud. Selle põhjuseks võivad olla võrguprobleemid või "
"hoidla, mis pole enam saadaval. Värskendage käsitsi, valides "
"indikaatorimenüüst „Näita värskendusi” ja jälgides, kas hoidlad on rikkis."

#: ../src/update.c:594
#, c-format
msgid ""
"An error occurred, please run Package Manager from the right-click menu or "
"apt-get in a terminal to see what is wrong.\n"
"The error message was: '%s'. "
msgstr ""
"Tekkis viga, palun käivitage Package Manager paremklõpsu menüüst või apt-get "
"terminaliaknas et näha, mis on valesti.\n"
"Veateade oli: '%s'. "

#: ../src/update.c:601
msgid ""
"An error occurred, please run Package Manager from the right-click menu or "
"apt-get in a terminal to see what is wrong."
msgstr ""
"Esines viga. Vea nägemiseks käivita hüpikmenüüst paketihaldur või terminalis "
"apt-get."

#: ../src/update.c:605
msgid ""
"This usually means that your installed packages have unmet dependencies"
msgstr ""
"Tavaliselt tähendab see, et paigaldatud pakettidel on rahuldamata sõltuvusi"

#: ../src/update.c:618
msgid "A problem occurred when checking for the updates."
msgstr "Uuenduste kontrolli ajal tekkis probleem."

#: ../src/update-notifier.c:609
msgid "- inform about updates"
msgstr "- teavita uuendustest"

#: ../src/update-notifier.c:611
#, c-format
msgid "Failed to init the UI: %s\n"
msgstr "Kasutajaliidese lähtestamine nurjus: %s\n"

#: ../src/update-notifier.c:612
msgid "unknown error"
msgstr "tundmatu viga"

#: ../src/update-notifier.c:639
msgid "update-notifier"
msgstr "update-notifier"

#: ../ui/hooks-dialog.ui.h:1
msgid "<span weight=\"bold\" size=\"larger\">Update information</span>"
msgstr "<span weight=\"bold\" size=\"larger\">Uuenduse info</span>"

#: ../data/com.ubuntu.update-notifier.policy.in.h:1
msgid "Authentication is needed to upgrade"
msgstr "Uuendamiseks on vaja autentimist"

#: ../data/com.ubuntu.update-notifier.policy.in.h:2
msgid "Authentication is needed to query package system lock status"
msgstr ""
"Autentimine on vajalik paketi süsteemi lukustuse oleku päringu tegemiseks"

#: ../data/update-notifier.desktop.in.h:1
msgid "Update Notifier"
msgstr "Uuendustest teataja"

#: ../data/update-notifier.desktop.in.h:2
msgid "Check for available updates automatically"
msgstr "Olemasolevate uuenduste automaatne kontroll"

#: ../data/ubuntu-advantage-notification.desktop.in.h:1
msgid "Ubuntu Advantage Notification"
msgstr "Ubuntu Advantage'i teatis"

#: ../data/ubuntu-advantage-notification.desktop.in.h:2
msgid "Notifies user if user has not connected to Ubuntu Advantage."
msgstr ""
"Teatab kasutajat, kui kasutaja pole Ubuntu Advantage'iga ühendust võtnud."

#. Name
#: ../data/package-data-downloads-failed.in:2
msgid "Failure to download extra data files"
msgstr "Täiendavate andmefailide allalaadimine ebaõnnestus"

#. Description
#: ../data/package-data-downloads-failed.in:5
#: ../data/package-data-downloads-failed-permanently.in:3
msgid ""
"The following packages requested additional data downloads after package "
"installation, but the data could not be downloaded or could not be processed."
msgstr ""
"Järgnevad paketid nõudsid peale paigaldamist täiendavate andmete "
"allalaadimist, aga see ebaõnnestus millegi pärast."

#. Description
#: ../data/package-data-downloads-failed.in:5
#: ../data/package-data-downloads-failed-permanently.in:3
msgid "  $packages"
msgstr "  $packages"

#. Description
#: ../data/package-data-downloads-failed.in:5
msgid ""
"The download will be attempted again later, or you can try the download "
"again now.  Running this command requires an active Internet connection."
msgstr ""
"Sa võid proovida allalaadimist kohe või seda tehakse sinu eesti hiljem "
"automaatselt. Selle käsu käivitamiseks on sul vaja internetiühendust."

#. Name
#: ../data/package-data-downloads-failed-permanently.in:2
msgid "Data files for some packages could not be downloaded"
msgstr "Mõndade pakettide andmefailide allalaadimine ebaõnnestus"

#. Description
#: ../data/package-data-downloads-failed-permanently.in:3
msgid ""
"This is a permanent failure that leaves these packages unusable on your "
"system.  You may need to fix your Internet connection, then remove and "
"reinstall the packages to fix this problem."
msgstr ""
"See on mittemuudetav viga, mille tõttu jäävad need paketid sinu süsteemi "
"jaoks kasutamiskõlbmatuks. Viga võib olla seotud internetiühendusega. Kui "
"sul on internetiühendus olemas, siis palun eemalda ja taaspaigalda paketid "
"vea parandamiseks."
