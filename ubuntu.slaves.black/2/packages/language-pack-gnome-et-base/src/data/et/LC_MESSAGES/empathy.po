#, c-format
msgid "Called %s"
msgstr "Helistad kasutajale %s"

#: ../libempathy/empathy-message.c:392
#, c-format
msgid "Call from %s"
msgstr "Kõne kasutajalt %s"

#: ../libempathy/empathy-utils.c:176
msgid "Available"
msgstr "Saadaval"

#: ../libempathy/empathy-utils.c:178
msgid "Busy"
msgstr "Hõivatud"

#: ../libempathy/empathy-utils.c:181
msgid "Away"
msgstr "Eemal"

#: ../libempathy/empathy-utils.c:183
msgid "Invisible"
msgstr "Nähtamatu"

#: ../libempathy/empathy-utils.c:185
msgid "Offline"
msgstr "Ühendamata"

#. translators: presence type is unknown
#: ../libempathy/empathy-utils.c:188
msgctxt "presence"
msgid "Unknown"
msgstr "Tundmatu"

#: ../libempathy/empathy-utils.c:228
msgid "No reason specified"
msgstr "Põhjendust pole määratud"

#: ../libempathy/empathy-utils.c:230 ../libempathy/empathy-utils.c:286
msgid "Status is set to offline"
msgstr "Olekuks on määratud 'pole ühendatud'."

#: ../libempathy/empathy-utils.c:232 ../libempathy/empathy-utils.c:266
#: ../libempathy-gtk/empathy-call-utils.c:42
#: ../libempathy-gtk/empathy-new-message-dialog.c:70
msgid "Network error"
msgstr "Võrgu viga"

#: ../libempathy/empathy-utils.c:234 ../libempathy/empathy-utils.c:268
msgid "Authentication failed"
