#: ../src/unity_calculator_daemon.py:29 ../data/calculator.scope.in.h:4
msgid "Calculate"
msgstr "ማስሊያ"

#: ../src/unity_calculator_daemon.py:30
msgid "Sorry, there are no results that match your search."
msgstr "አዝናለሁ: እርስዎ የሚፈልጉትን አይነት ተመሳሳይ አልተገኘም"

#: ../src/unity_calculator_daemon.py:39
msgid "Result"
msgstr "ውጤት"

#: ../src/unity_calculator_daemon.py:140
msgid "Open in calculator"
msgstr "በ መደመሪያ ውስጥ መክፈቻ"

#: ../data/calculator.scope.in.h:1
msgid "calculator;result;calculate;calc;"
msgstr "መደመሪያ: ውጤት: ማስሊያ:ማስሊያ:"

#: ../data/calculator.scope.in.h:2
msgid "Calculator"
msgstr "መደመሪያ"

#: ../data/calculator.scope.in.h:3
msgid ""
"This is an Ubuntu search plugin that enables Calculator results to be "
"displayed in the Dash underneath the Info header. If you do not wish to "
"search this content source, you can disable this search plugin."
msgstr ""
"ይህ የ ኡቡንቱ መፈለጊያ ተሰኪ ነው: ለ መደመሪያ ውጤቶች ማሳያ ነው በጭረት ውስጥ ከ መረጃ ራስጌ ስር: ይህን የ "
"ይዞታዎች መፈለጊያ መጠቀም ካልፈለጉ የ መፈለጊያውን ተሰኪ ማሰናከል ይችላሉ"
