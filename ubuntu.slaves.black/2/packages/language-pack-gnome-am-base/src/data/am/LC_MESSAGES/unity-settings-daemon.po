#: ../data/unity-settings-daemon.desktop.in.in.h:1
msgid "Unity Settings Daemon"
msgstr "የ ዩኒቲ ማሰናጃ ረዳት"

#: ../gnome-settings-daemon/main.c:53
msgid "Enable debugging code"
msgstr "ኮድ ማስተካከያ ማስቻያ"

#: ../gnome-settings-daemon/main.c:54
msgid "Replace existing daemon"
msgstr "የ ነበረውን ረዳት ማስወገጃ"

#: ../gnome-settings-daemon/main.c:55
msgid "Exit after a time (for debugging)"
msgstr "ከ ተወሰነ ጊዜ በኋላ መውጫ (ለ ማስተካከያ)"

#: ../plugins/a11y-keyboard/a11y-keyboard.gnome-settings-plugin.in.h:1
msgid "Accessibility Keyboard"
msgstr "የ ፊደል ገበታ መድረሻ"

#: ../plugins/a11y-keyboard/a11y-keyboard.gnome-settings-plugin.in.h:2
msgid "Accessibility keyboard plugin"
msgstr "የ ፊደል ገበታ ተሰኪ መድረሻ"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:400
msgid "Slow Keys Turned On"
msgstr "ማዘግያ ቁልፍ በርቷል"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:401
msgid "Slow Keys Turned Off"
msgstr "ማዘግያ ቁልፍ ጠፍቷል"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:402
msgid ""
"You just held down the Shift key for 8 seconds.  This is the shortcut for "
"the Slow Keys feature, which affects the way your keyboard works."
msgstr ""
"እርስዎ የ Shift ቁልፍን ለ 8 ሰከንዶች ተጭነዋል: ይህ አቋራጭ ነው ለ ቁልፎች ማዘግያ: በ እርስዎ የ ፊደል ገበታ "
"አሰራር ላይ ተጽእኖ ይፈጥራል"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:412
#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:480
#: ../plugins/mouse/gsd-mouse-manager.c:904
msgid "Universal Access"
msgstr "አለም አቀፍ መድረሻ"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:418
#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:486
msgid "Turn Off"
msgstr "ማጥፊያ"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:418
#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:486
msgid "Turn On"
msgstr "ማብሪያ"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:424
#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:492
msgid "Leave On"
msgstr "እንደ በራ መተው"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:424
#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:492
msgid "Leave Off"
msgstr "እንደ ጠፋ መተው"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:465
msgid "Sticky Keys Turned On"
msgstr "ተጣባቂ ቁልፍ በርቷል"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:466
msgid "Sticky Keys Turned Off"
msgstr "ተጣባቂ ቁልፍ ጠፍቷል"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:468
msgid ""
"You just pressed the Shift key 5 times in a row.  This is the shortcut for "
"the Sticky Keys feature, which affects the way your keyboard works."
msgstr ""
"እርስዎ የ Shift ቁልፍን ለ 5 ሰከንዶች ተጭነዋል: ይህ አቋራጭ ነው ለ ቁልፎች ማጣበቂያ: በ እርስዎ የ ፊደል ገበታ "
"አሰራር ላይ ተጽእኖ ይፈጥራል"

#: ../plugins/a11y-keyboard/gsd-a11y-keyboard-manager.c:470
msgid ""
"You just pressed two keys at once, or pressed the Shift key 5 times in a "
"row.  This turns off the Sticky Keys feature, which affects the way your "
"keyboard works."
msgstr ""
"እርስዎ ሁለት ቁልፎች በ አንድ ጊዜ ተጭነዋል: ወይንም የ Shift ቁልፍን ለ 5 ጊዜ በ ተከታታይ ተጭነዋል: ይህ የ "
"ቁልፎች ማጣበቂያን ያጠፋዋል: በ እርስዎ የ ፊደል ገበታ አሰራር ላይ ተጽእኖ ይፈጥራል"

#: ../plugins/a11y-settings/a11y-settings.gnome-settings-plugin.in.h:1
msgid "Accessibility settings"
msgstr "መድረሻ ማሰናጃ"

