#: ../plugins/housekeeping/gsd-disk-space.c:612
#, c-format
msgid "Low Disk Space on \"%s\""
msgstr "ዝቅተኛ የዲስክ ቦታ በ \"%s\""

#: ../plugins/housekeeping/gsd-disk-space.c:614
#, c-format
msgid ""
"The volume \"%s\" has only %s disk space remaining.  You may free up some "
"space by emptying the trash."
msgstr ""
"መጠኑ \"%s\" ያለው %s የቀረው ነፃ የ ዲስክ ቦታ: እርስዎ ቆሻሻውን ባዶ በማድረግ ትንሽ ነፃ ቦታ ማግኘት ይችላሉ"

#: ../plugins/housekeeping/gsd-disk-space.c:618
#: ../plugins/housekeeping/gsd-ldsm-dialog.c:81
#, c-format
msgid "The volume \"%s\" has only %s disk space remaining."
msgstr "ይህ መጠን \"%s\" ይህን ያህል %s የ ዲስክ ቦታ ይቀረዋል"

#. Set up all the window stuff here
#: ../plugins/housekeeping/gsd-disk-space.c:623
#: ../plugins/housekeeping/gsd-ldsm-dialog.c:205
msgid "Low Disk Space"
msgstr "ዝቅተኛ የ ዲስክ ቦታ"

#: ../plugins/housekeeping/gsd-disk-space.c:625
#, c-format
msgid ""
"This computer has only %s disk space remaining.  You may free up some space "
"by emptying the trash."
msgstr ""
"ይህ ኮምፒዩተር ይህን ያህል %s የ ዲስክ ቦታ ይቀረዋል የ ቆሻሻ ማጠራቀሚያውን ባዶ በማድረግ ጥቂት ነፃ ባዶ ቦታ ያገኛሉ"

#: ../plugins/housekeeping/gsd-disk-space.c:628
#: ../plugins/housekeeping/gsd-ldsm-dialog.c:84
#, c-format
msgid "This computer has only %s disk space remaining."
msgstr "ይህ ኮምፒዩተር %s የዲስክ ቦታ ቀርቶታል"

#: ../plugins/housekeeping/gsd-disk-space.c:643
msgid "Disk space"
msgstr "የዲስክ ቦታ"

#: ../plugins/housekeeping/gsd-disk-space.c:650
msgid "Examine"
msgstr "መመርመሪያ"

#: ../plugins/housekeeping/gsd-disk-space.c:658
#: ../plugins/housekeeping/gsd-ldsm-dialog.c:439
msgid "Empty Trash"
msgstr "ቆሻሻውን ባዶ ማድረጊያ"

#: ../plugins/housekeeping/gsd-disk-space.c:665
#: ../plugins/housekeeping/gsd-ldsm-dialog.c:454
msgid "Ignore"
msgstr "መተው"

#: ../plugins/housekeeping/gsd-ldsm-dialog.c:66
msgid "Don't show any warnings again for this file system"
msgstr "ለዚህ የፋይል ስርአት ምንም አይነት ማስጠንቀቂያ አታሳይ"

#: ../plugins/housekeeping/gsd-ldsm-dialog.c:68
msgid "Don't show any warnings again"
msgstr "ምንም አይነት ማስጠንቀቂያ አታሳይ"

#: ../plugins/housekeeping/gsd-ldsm-dialog.c:100
msgid ""
"You can free up disk space by emptying the Trash, removing unused programs "
