msgstr "HiDpiIcon"

#: data/org.gnome.Terminal.metainfo.xml.in:55
msgid "HighContrast"
msgstr "उच्च व्यतिरेक"

#: data/org.gnome.Terminal.metainfo.xml.in:56
msgid "ModernToolkit"
msgstr "आधुनिक टुलकिट"

