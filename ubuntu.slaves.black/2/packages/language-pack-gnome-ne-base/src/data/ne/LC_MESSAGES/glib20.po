#, c-format
msgid "Cannot autolaunch D-Bus without X11 $DISPLAY"
msgstr "X11 $DISPLAY बिना D-Bus स्वत: सुरुआत गर्न सकिँदैन"

#: gio/gdbusaddress.c:1157
