#: data/org.gnome.five-or-more.gschema.xml:5
msgid "Playing field size"
msgstr "खेल मैदानको आकार"

#: data/org.gnome.five-or-more.gschema.xml:6
msgid ""
"Playing field size. 1=Small, 2=Medium, 3=Large. Any other value is invalid."
msgstr ""
"खेलिरहेको खेलको मैदान । १=सानो, २=मध्यम, ३=ठूलो । अन्य कुनै पनि मान अवैध छ ।"

#: data/org.gnome.five-or-more.gschema.xml:10
msgid "Ball style"
msgstr "बल शैली"

#: data/org.gnome.five-or-more.gschema.xml:11
msgid "Ball style. The filename of the images to use for the balls."
msgstr "बल शैली । बलका लागि प्रयोग गरिने छविको फाइलनाम ।"

#: data/org.gnome.five-or-more.gschema.xml:15
msgid "Background color"
msgstr "पृष्ठभूमि रङ"

#: data/org.gnome.five-or-more.gschema.xml:16
