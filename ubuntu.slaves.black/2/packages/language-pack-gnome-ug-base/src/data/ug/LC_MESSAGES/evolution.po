msgstr "مەشغۇلاتنى ئىجرا قىلىۋاتقاندا خاتالىق كۆرۈلدى."

#: ../src/mail/mail.error.xml.h:52
msgid "Enter password."
msgstr "ئىم كىرگۈزۈڭ."

#: ../src/mail/mail.error.xml.h:53
