#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"Nautilus سىزنىڭ ھۆججەت قىسقۇچىڭىز \"%s\" غا ھەمبەھىرلەش ئۈچۈن ئىجرا قىلىش "
"ھوقۇقى قوشۇشنى تەلەپ قىلىدۇ"

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"ھۆججەت قىسقۇچ  \"%s\" تۆۋەندىكىدەك ھوقۇقلىرىمۇ بولغاندا ئاندىن ھەمبەھىرلەشكە "
"بولىدۇ:\n"
"%s%s%s ھۆججەت قىسقۇچىڭىزغا Nautilus ئاپتوماتىك ھالدا بۇ ھوقۇقلارنى قوشۇپ "
"قويسۇنمۇ؟"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - باشقىلارنىڭ كۆرۈش ھوقۇقى\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - باشقىلارنىڭ يېزىش ھوقۇقى\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - باشقىلارنىڭ ئىجرا قىلىش ھوقۇقى\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "ئاپتوماتىك ھوقۇق قوشۇش"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "\"%s\" ھۆججەت قىسقۇچىنىڭ ھوقۇقىنى ئۆزگەرتىش مۇمكىن بولمىدى"

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "ھەمبەھىر ئىسمى بەك ئۇزۇن"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "ھەمبەھىر ئىسمى قۇرۇق بولسا بولمايدۇ"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr "ھەمبەھىر ئۇچۇرىنى ئېلىشتا خاتالىق كۆرۈلدى: %s"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "باشقا بىر ھەمبەھىرنىڭمۇ مۇشۇنداق ئاتى بار ئىكەن."

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "ھەمبەھىرنى ئۆزگەرت(_P)"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "ھەمبەھىر قۇر(_S)"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "ھەمبەھىر مۇلازىمىتىنى ئورنىتىش مەغلۇپ بولدى"

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr "ھەمبەھىر مۇلازىمىتىنى ئورنىتىش مەغلۇپ بولدى. قايتا سىناپ باقامسىز؟"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "قايتا سىنا"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "ھەمبەھىر مۇلازىمىتى قاچىلانمىدى"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"سىز ھېچ بولمىغاندا Windows  تور ھەمبەھىر مۇلازىمىتىنى قاچىلىسىڭىز ئاندىن "
"مۇندەرىجىنى ھەمبەھىر قىلالايسىز."

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "مۇلازىمەتنى ئورنات"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr "ھەمبەھىر ئۇچۇرىنى ئېلىۋاتقاندا خاتالىق كۆرۈلدى"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "يەرلىك تور ھەمبەھىرى"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "مۇندەرىجە ھەمبەھىرلەش"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "بۇ مۇندەرىجىنى ھەمبەھىرلە"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "%s %s %s قايتۇرغان سىگنال %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s  نامەلۇم سەۋەبتىن مەغلۇپ بولدى"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "'net usershare' قايتۇرغان خاتالىق %d: %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "'net usershare' قايتۇرغان خاتالىق %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "'net usershare' چىقارغان ئۇچۇرلار UTF-8 دە كودلانماپتۇ"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "مەغلۇپ بولدى"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "Samba نىڭ testparm %d دېگەن سىگنالنى قايتۇردى"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "Samba نىڭ testparm نامەلۇم سەۋەبلەر تۈپەيلى مەغلۇپ بولدى"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "Samba نىڭ testparm %d دېگەن خاتالىق قايتۇردى: %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "Samba نىڭ testparm %d دېگەن خاتالىق قايتۇردى"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr "يول %s نىڭ ھەمبەھىرىنى ئۆچۈرگىلى بولمىدى: بۇ يول ھەمبەھىرلەنمەپتۇ"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"ھەمبەھىرلەنگەن يولنى ئۆزگەرتكىلى بولمايدۇ. ئالدى بىلەن ھەمبەھىرنى ئۆچۈرۈپ "
"ئاندىن يېڭى ھەمبەھىر قوشۇڭ."

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>مۇندەرىجىنى ھەمبەھىرلەش</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "ھەمبەھىر ئاتى(_N):"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "بۇ مۇندەرىجىنى ھەمبەھىرلە(_F)"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "ئىزاھات(_M):"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr ""
"باشقىلارنىڭ بۇ قىسقۇچ ئىچىدە ھۆججەت قۇرۇشى ۋە ئۆچۈرۈشىگە رۇخسەت قىل(_A)"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr "مېھمان زىيارىتى(ھېسابى يوقلار ئۈچۈن)"
