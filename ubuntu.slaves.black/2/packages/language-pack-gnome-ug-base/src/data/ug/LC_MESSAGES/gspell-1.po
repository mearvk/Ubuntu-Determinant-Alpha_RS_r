#: gspell/gspell-checker.c:415
#, c-format
msgid "Error when checking the spelling of word “%s”: %s"
msgstr "«%s» سۆزىنىڭ ئىملاسىنى تەكشۈرگەندىكى خاتالىق:%s"

#. Translators: Displayed in the "Check Spelling"
#. * dialog if there are no suggestions for the current
#. * misspelled word.
#. 
#. No suggestions. Put something in the menu anyway...
#: gspell/gspell-checker-dialog.c:150 gspell/gspell-context-menu.c:217
msgid "(no suggested words)"
msgstr "(تەكلىپ سۆزلەر يوق)"

#: gspell/gspell-checker-dialog.c:235
msgid "Error:"
msgstr "خاتالىق:"

#: gspell/gspell-checker-dialog.c:271
msgid "Completed spell checking"
msgstr "ئىملا تەكشۈرۈش تاماملاندى"

#: gspell/gspell-checker-dialog.c:275
msgid "No misspelled words"
msgstr "ئىملاسى خاتا سۆز يوق"

#. Translators: Displayed in the "Check
#. * Spelling" dialog if the current word
#. * isn't misspelled.
#. 
#: gspell/gspell-checker-dialog.c:502
msgid "(correct spelling)"
msgstr "(توغرا ئىملا)"

#: gspell/gspell-checker-dialog.c:644
msgid "Suggestions"
msgstr "تەۋسىيەلەر"

#: gspell/gspell-context-menu.c:152
msgid "_Language"
msgstr "_تىل"

#: gspell/gspell-context-menu.c:240
msgid "_More…"
msgstr "_تېخىمۇ..."

#. Ignore all
#: gspell/gspell-context-menu.c:285
msgid "_Ignore All"
msgstr "ھەممىگە پەرۋا قىلما(_A)"

#. Add to Dictionary
#: gspell/gspell-context-menu.c:303
msgid "_Add"
msgstr "قوشۇش(_A)"

#: gspell/gspell-context-menu.c:340
msgid "_Spelling Suggestions…"
msgstr "_ئىملا تەكلىپلىرى…"

#. Translators: %s is the language ISO code.
#: gspell/gspell-language.c:89
#, c-format
msgctxt "language"
msgid "Unknown (%s)"
msgstr "نامەلۇم(%s)"

#: gspell/gspell-language-chooser-button.c:84
msgid "No language selected"
msgstr "ھېچقانداق تىل تاللانمىدى"

#: gspell/gspell-navigator-text-view.c:310
msgid ""
"Spell checker error: no language set. It’s maybe because no dictionaries are "
"installed."
msgstr ""
"ئىملا تەكشۈرۈش خاتالىقى: تىل تەڭشىكى يوق. بۇ بەلكىم ھېچقانداق لۇغەت "
"ئورنىتىلمىغان بولۇشى مۇمكىن."

