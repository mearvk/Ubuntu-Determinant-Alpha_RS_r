#: ../update.c:186
msgid "Update standard folders to current language?"
msgstr "ئۆلچەملىك قىسقۇچلارنى نۆۋەتتىكى تىلغا ماسلاشتۇرۇپ يېڭىلىسۇنمۇ؟"

#: ../update.c:188
msgid ""
"You have logged in in a new language. You can automatically update the names "
"of some standard folders in your home folder to match this language. The "
"update would change the following folders:"
msgstr ""
"سىز يېڭى تىلنى ئىشلىتىپ كىردىڭىز. ماكان مۇندەرىجە ئىچىدىكى ئۆلچەملىك "
"مۇندەرىجىلەرنىڭ ئاتىنى يېڭى تىلغا ماسلاشتۇرۇپ ئاپتوماتىك ئۆزگەرتكىلى بولىدۇ. "
"بۇنىڭدا تۆۋەندىكى قىسقۇچلارنىڭ ئاتى يېڭىلىنىدۇ."

#: ../update.c:191
msgid "_Keep Old Names"
msgstr "كونا ئاتى بويىچە تۇرۇۋەرسۇن(_K)"

#: ../update.c:192
msgid "_Update Names"
msgstr "ئاتى يېڭىلانسۇن(_U)"

#: ../update.c:218
msgid "Current folder name"
msgstr "نۆۋەتتىكى قىسقۇچ ئاتى"

#: ../update.c:223
msgid "New folder name"
msgstr "يېڭى قىسقۇچ ئاتى"

#: ../update.c:233
msgid "Note that existing content will not be moved."
msgstr "(قىسقۇچ ئىچىدىكى مەزمۇنلار يۆتكەلمەيدۇ)"

#: ../update.c:240
msgid "_Don't ask me this again"
msgstr "قايتا سورىما(_D)"

#: ../update.c:257
msgid "There was an error updating the folders"
msgstr "قىسقۇچلارنى يېڭىلاۋاتقاندا خاتالىق كۆرۈلدى"

#: ../user-dirs-update-gtk.desktop.in.h:1
msgid "User folders update"
msgstr "ئىشلەتكۈچى قىسقۇچىنى يېڭىلاش"

#: ../user-dirs-update-gtk.desktop.in.h:2
msgid "Update common folders names to match current locale"
msgstr "ئۆلچەملىك قىسقۇچلارنى نۆۋەتتىكى تىلغا ماسلاشتۇرۇپ يېڭىلايدۇ"
