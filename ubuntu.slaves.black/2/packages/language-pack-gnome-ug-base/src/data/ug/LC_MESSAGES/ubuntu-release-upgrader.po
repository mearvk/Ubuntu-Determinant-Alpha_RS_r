msgstr "يېڭى يۇمشاق دېتال قانىلىنى تەڭشەۋاتىدۇ"

#: ../data/gtkbuilder/DistUpgrade.ui.h:25
msgid "Restarting the computer"
msgstr "كومپيۇتېرنى قايتا قوزغىتىۋاتىدۇ"

#: ../data/gtkbuilder/DistUpgrade.ui.h:28
msgid "Terminal"
msgstr "تېرمىنال"

