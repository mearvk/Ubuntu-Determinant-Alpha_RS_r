msgid "Archive"
msgstr "Arhivă"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Extrageți arhiva în dosarul personal de pe sistemul-țintă."

#: byobu-select-profile:49
msgid "Error:"
msgstr "Eroare:"

