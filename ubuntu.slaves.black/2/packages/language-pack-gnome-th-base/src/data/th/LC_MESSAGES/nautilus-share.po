#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"Nautilus ต้องการเพิ่มสิทธิ์ไปยังโฟลเดอร์ของคุณ \"%s\" เพื่อที่จะแชร์ข้อมูล"

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"โฟลเดอร์ \"%s\" ต้องการสิทธิ์เพิ่มเติ่มเพื่อให้การแบ่งบันใช้งานได้:\n"
"%s%s%sคุณต้องการให้ Nautilus เพิ่มสิทธิ์นี้ให้โฟลเดอร์อัตโนมัติหรือไม่"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - คนอื่น ๆ มีสิทะิ์อ่านได้\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - คนอื่น ๆ มีสิทธิ์เขียนได้\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - คนอื่น ๆ มีสิทธิ์รันโปรแกรมได้\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "เพิ่มสิทธิอัตโนมัติ"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "ไม่สามารถเปลี่ยนแปลงสิทธิ์ของโฟล์เดอร์ \"%s\""

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "ชื่อที่ใช้แชร์ยาวเกินไป"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "ชื่อของการแชร์ไม่สามารถเว้นว่างได้"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr "ผิดพลาดขณะเข้าถึงแชร์ข้อมูล: %s"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "ชื่อซ้ำกับการแชร์อื่น"

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "แก้ไขแ_ชร์"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "สร้าง_การแบ่งปัน"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "การติดตั้งบริการแชร์ข้อมูลผิดพลาด"

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr "การติดตั้งบริการแชร์ข้อมูลผิดพลาด คุณต้องการจะลองติดตั้งใหม่หรือไม่"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "ลองใหม่"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "บริการแชร์ข้อมูลยังไม่ได้รับการติดตั้ง"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"คุณจำเป็นต้องติดตั้งบริการแบ่งปันเครื่อข่ายของ Windows "
"เพื่อที่จะแบ่งบันโฟลเดอร์ของคุณ"

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "ติดตั้งบริการ"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr "มีเหตุขัดข้องขณะกำลังเข้าถึงข่าวสารการแบ่งปัน"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "การแบ่งปันการใช้เครือข่ายในพื้นที่"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "โฟลเดอร์ที่แบ่งปัน"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "แบ่งปันโฟล์เดอร์นี้"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "%s %s %s คืนพร้อมสัญญาณ %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s ผิดพลาดไม่รู้สาเหตุ"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "'net usershare' มีข้อผิดพลาด %d: %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "'net usershare' มีข้อผิดพลาด %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "ผลลัพธ์ของ 'net usershare' ไม่ได้เข้ารหัส UTF-8 ที่ถูกต้อง"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "ล้มเหลวแล้ว"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "Samba's testparm คืนพร้อมสัญญาณ %d"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "Samba's testparm ล้มเหลวและยังไม่ทราบสาเหตุ"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "testparm ของ Samba ได้ส่งกลับข้อผิดพลาด %d: %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "testparm ของ Samba ได้ส่งกลับข้อผิดพลาด %d"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr "ไม่สามารถลบการแบ่งปันสำหรับเส้นทาง %s: เส้นทางนั้นไม่ได้ถูกแบ่งปัน"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"ไม่สามารถเปลี่ยนเส้นทางของการแบ่งปันที่มีอยู่ได้; โปรดลบการแบ่งปันเก่าออก "
"แล้วเพิ่มใหม่อีกอัน"

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>การแบ่งปันโฟลเดอร์</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "ชื่อของการแบ่งปัน:"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "แบ่งปันโฟลเดอร์นี้"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "ห_มายเหตุ:"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr "อนุญาตให้ผู้ใช้อื่นสร้างและลบแฟ้มในโฟลเดอร์นี้"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr "การเข้าใช้ของคนนอก (สำหรับผู้ที่ไม่มีบัญชีผู้ใช้)"
