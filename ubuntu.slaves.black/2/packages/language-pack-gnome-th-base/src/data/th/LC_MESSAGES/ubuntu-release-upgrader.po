msgstr "กำลังคำนวณความต้องการขนาดของ snap"

#: ../DistUpgrade/DistUpgradeQuirks.py:735
msgid "Processing snap replacements"
msgstr "กำลังทำการแทนที่ snap"

#: ../DistUpgrade/DistUpgradeQuirks.py:741
#, python-format
msgid "refreshing snap %s"
msgstr "กำลังรีเฟรช snap %s"

#: ../DistUpgrade/DistUpgradeQuirks.py:745
#, python-format
