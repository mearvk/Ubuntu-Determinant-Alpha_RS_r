#: ../caribou/settings/caribou_settings.py:5
msgid "Caribou Preferences"
msgstr "การตั้งค่า Caribou"

#: ../caribou/settings/caribou_settings.py:6
msgid "Scanning"
msgstr "กำลังสแกน"

#: ../caribou/settings/caribou_settings.py:8
msgid "Enable scanning"
msgstr "เปิดใช้งานการสแกน"

#: ../caribou/settings/caribou_settings.py:9
msgid "Enable switch scanning"
msgstr "เปิดใช้งานการสแกนสวิตช์"

#: ../caribou/settings/caribou_settings.py:12
msgid "General"
msgstr "ทั่วไป"

#: ../caribou/settings/caribou_settings.py:13
msgid "Scanning mode"
msgstr "โหมดการสแกน"

#: ../caribou/settings/caribou_settings.py:15
msgid "Scanning type, subgroups, rows or linear"
msgstr "ชนิดการสแกน กลุ่มย่อย แถว หรือเส้น"

#: ../caribou/settings/caribou_settings.py:16
msgid "Subgroups"
msgstr "กลุ่มย่อย"

#: ../caribou/settings/caribou_settings.py:17
msgid "Rows"
msgstr "แถว"

#: ../caribou/settings/caribou_settings.py:18
msgid "Linear"
msgstr "เส้น"

#: ../caribou/settings/caribou_settings.py:20
msgid "Step time"
msgstr "เวลาของแต่ละขั้นตอน"

#: ../caribou/settings/caribou_settings.py:21
msgid "Time between key transitions"
msgstr "เวลาระหว่างการเปลี่ยนปุ่ม"

#: ../caribou/settings/caribou_settings.py:24
msgid "Inverse scanning"
msgstr "การสแกนแบบย้อนกลับ"

#: ../caribou/settings/caribou_settings.py:25
msgid "Step with the switch, activate by dwelling"
msgstr "ไปยังขั้นตอนแต่ละขั้นตอนด้วยสวิตช์ เปิดใช้งานด้วยการคลิก"

#: ../caribou/settings/caribou_settings.py:28
msgid "Auto-restart scanning"
msgstr "เริ่มสแกนใหม่อัตโนมัติ"

#: ../caribou/settings/caribou_settings.py:29
msgid "Automatically restart scanning after item activation"
msgstr "เริ่มสแกนใหม่โดยอัตโนมัติหลังจากเปิดใช้งานรายการ"

#: ../caribou/settings/caribou_settings.py:30
msgid "Scan cycles"
msgstr "วัฏจักรการสแกน"

#: ../caribou/settings/caribou_settings.py:31
msgid "One"
msgstr "หนึ่ง"

#: ../caribou/settings/caribou_settings.py:32
msgid "Two"
msgstr "สอง"

#: ../caribou/settings/caribou_settings.py:33
msgid "Three"
msgstr "สาม"

#: ../caribou/settings/caribou_settings.py:34
msgid "Four"
msgstr "สี่"

#: ../caribou/settings/caribou_settings.py:35
msgid "Five"
msgstr "ห้า"

#: ../caribou/settings/caribou_settings.py:38
msgid "Input"
msgstr "ป้อนเข้า"

#: ../caribou/settings/caribou_settings.py:39
msgid "Switch device"
msgstr "สลับอุปกรณ์"

#: ../caribou/settings/caribou_settings.py:41
msgid "Switch device, keyboard or mouse"
msgstr "สลับอุปกรณ์ แป้นพิมพ์ หรือเมาส์"

#: ../caribou/settings/caribou_settings.py:43
msgid "Keyboard"
msgstr "แป้นพิมพ์"

#: ../caribou/settings/caribou_settings.py:44
msgid "Mouse"
msgstr "เมาส์"

#: ../caribou/settings/caribou_settings.py:46
msgid "Switch key"
msgstr "ปุ่มสลับ"

#: ../caribou/settings/caribou_settings.py:48
msgid "Key to use with scanning mode"
msgstr "ปุ่มที่ใช้กับโหมดสแกน"

#: ../caribou/settings/caribou_settings.py:50
msgid "Right shift"
msgstr "Shift ขวา"

#: ../caribou/settings/caribou_settings.py:51
msgid "Left shift"
msgstr "Shift ซ้าย"

#: ../caribou/settings/caribou_settings.py:52
msgid "Space"
msgstr "วรรค"

#: ../caribou/settings/caribou_settings.py:53
msgid "Alt Gr"
msgstr "Alt Gr"

#: ../caribou/settings/caribou_settings.py:54
msgid "Num lock"
msgstr "Num lock"

#: ../caribou/settings/caribou_settings.py:55
msgid "Switch button"
msgstr "ปุ่มสลับ"

#: ../caribou/settings/caribou_settings.py:58
msgid "Mouse button to use in the scanning mode"
msgstr "ปุ่มเมาส์ที่ใช้ในโหมดสแกน"

#: ../caribou/settings/caribou_settings.py:60
msgid "Button 1"
msgstr "ปุ่ม 1"

#: ../caribou/settings/caribou_settings.py:61
msgid "Button 2"
msgstr "ปุ่ม 2"

#: ../caribou/settings/caribou_settings.py:62
msgid "Button 3"
msgstr "ปุ่ม 3"

#: ../caribou/__init__.py:8
msgid "Caribou"
msgstr "Caribou"

#: ../caribou/antler/antler_settings.py:5
msgid "Antler Preferences"
msgstr "การตั้งค่า Antler"

#: ../caribou/antler/antler_settings.py:6
msgid "Antler"
msgstr "Antler"

#: ../caribou/antler/antler_settings.py:7
msgid "Appearance"
msgstr "รูปโฉม"

#: ../caribou/antler/antler_settings.py:9
msgid "Keyboard Type"
msgstr "ชนิดแป้นพิมพ์"

#: ../caribou/antler/antler_settings.py:10
msgid "The keyboard geometry Caribou should use"
msgstr "เรขาคณิตของแป้นพิมพ์ที่ Caribou ควรใช้"

#: ../caribou/antler/antler_settings.py:11
msgid ""
"The keyboard geometry determines the shape and complexity of the keyboard, "
"it could range from a 'natural' look and feel good for composing simple "
"text, to a fullscale keyboard."
msgstr ""
"เรขาคณิตชองแป้นพิมพ์กำหนดรูปร่างและความซับซ้อนของแป้นพิมพ์ "
"โดยอาจอยู่ในช่วงมุมมองแบบ 'ธรรมชาติ' "
"และอาจให้ความรู้สึกที่ดีต่อการเขียนข้อความ ไปจนถึงแป้นพิมพ์แบบขนาดเต็ม"

#. Translators: Keyboard type (similar to touch/tactile device)
#: ../caribou/antler/antler_settings.py:16
msgid "Touch"
msgstr "สัมผัส"

#. Translators: Keyboard type (conventional keyboard)
#: ../caribou/antler/antler_settings.py:18
msgid "Full scale"
msgstr "ขนาดเต็ม"

#. Translators: Keyboard type (scanned grid by rows/columns)
#: ../caribou/antler/antler_settings.py:20
msgid "Scan"
msgstr "สแกน"

#: ../caribou/antler/antler_settings.py:21
#: ../caribou/antler/antler_settings.py:22
msgid "Use System Theme"
msgstr "ใช้ชุดตกแต่งของระบบ"

#: ../caribou/antler/antler_settings.py:23
msgid "Minimum Alpha"
msgstr "ค่าอัลฟาต่ำสุด"

#: ../caribou/antler/antler_settings.py:24
msgid "Minimal opacity of keyboard"
msgstr "ค่าความทึบแสงขั้นต่ำของแป้นพิมพ์"

#: ../caribou/antler/antler_settings.py:26
msgid "Maximum Alpha"
msgstr "ค่าอัลฟามากสุด"

#: ../caribou/antler/antler_settings.py:27
msgid "Maximal opacity of keyboard"
msgstr "ค่าความทึบแสงขั้นสูงของแป้นพิมพ์"

#: ../caribou/antler/antler_settings.py:29
msgid "Maximum Distance"
msgstr "ระยะทางมากสุด"

#: ../caribou/antler/antler_settings.py:30
msgid "Maximum distance when keyboard is hidden"
msgstr "ระยะทางมากสุดเมื่อซ่อนแป้นพิมพ์"

