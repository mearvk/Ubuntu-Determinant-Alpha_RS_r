#. * TrueType (CID)
#. * Encoding: Custom
#. * Embedded subset
#. 
#: backend/pdf/ev-poppler.c:1044
#, c-format
msgid ""
"%s%s\n"
"Encoding: %s\n"
"%s"
msgstr ""
"%s%s\n"
"การเข้ารหัส: %s\n"
"%s"

