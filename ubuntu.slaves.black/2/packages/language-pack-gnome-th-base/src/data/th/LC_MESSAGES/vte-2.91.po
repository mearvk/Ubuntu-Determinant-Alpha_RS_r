#: src/vte.cc:7612
msgid "WARNING"
msgstr "คำเตือน"

#: src/vte.cc:7614
msgid "GnuTLS not enabled; data will be written to disk unencrypted!"
msgstr "ไม่ได้เปิดใช้ GnuTLS ข้อมูลจะถูกเขียนลงดิสก์โดยไม่มีการเข้ารหัสลับ!"

#: src/spawn.cc:124
#, c-format
msgid "Failed to set pipe nonblocking: %s"
msgstr "ไม่สามารถตั้งค่า pipe nonblocking: %s"

#: src/spawn.cc:169
#, c-format
msgid "poll error: %s"
msgstr "poll ผิดพลาด: %s"

#: src/spawn.cc:176
msgid "Operation timed out"
msgstr "การทำงานหมดเวลา"

#: src/spawn.cc:186
msgid "Operation was cancelled"
msgstr "การทำงานถูกยกเลิก"

#: src/spawn.cc:204
#, c-format
msgid "Failed to read from child pipe (%s)"
msgstr "อ่านข้อมูลจากไปป์จากโพรเซสลูกไม่สำเร็จ (%s)"

#: src/spawn.cc:639
#, c-format
msgid "Failed to change to directory “%s”: %s"
msgstr "ไม่สามารถเปลี่ยนไปที่ไดเรกทอรี “%s”: %s"

#: src/spawn.cc:708
#, c-format
msgid "Failed to execute child process “%s”: "
msgstr "ไม่สามารถประมวลผลโพรเซสลูก “%s”: "
