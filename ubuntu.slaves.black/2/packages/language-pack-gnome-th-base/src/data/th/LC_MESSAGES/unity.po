#: ../plugins/unityshell/unityshell.xml.in.h:3
msgid "General"
msgstr "ทั่วไป"

#: ../plugins/unityshell/unityshell.xml.in.h:4
msgid "Key to show the menu bar while pressed"
msgstr "แป้นสำหรับแสดงแถบเมนูขณะที่กด"

