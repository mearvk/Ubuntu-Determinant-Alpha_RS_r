#: cmdline/apt-config.cc:82
msgid ""
"Usage: apt-config [options] command\n"
"\n"
"apt-config is an interface to the configuration settings used by\n"
"all APT tools, mainly intended for debugging and shell scripting.\n"
msgstr ""
"Upotreba: apt-config [mogućnosti] naredba\n"
"\n"
"apt-config je sučelje za postavke podešavanja koje koriste\n"
"svi APT alati, uglavnom namijenjeni za otklanjanje greški\n"
"i skriptama za ljusku.\n"

#: cmdline/apt-config.cc:92
