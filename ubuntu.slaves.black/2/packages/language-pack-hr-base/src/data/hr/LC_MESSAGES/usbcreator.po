#: .././gui/usbcreator-gtk.ui.h:1
msgid "Installation Failed"
msgstr "Instalacija nije uspjela"

#: .././gui/usbcreator-gtk.ui.h:2
msgid ""
"The installation failed.  Please see ~/.cache/usb-creator.log for more "
"details.\n"
msgstr ""
"Instalacija nije uspjela.  Za više pojedinosti pogledajte ~/.cache/usb-"
"creator.log.\n"

#: .././gui/usbcreator-gtk.ui.h:4
msgid "Installation Complete"
msgstr "Instalacija završena"

#: .././gui/usbcreator-gtk.ui.h:5
msgid "Test Disk"
msgstr "Testiraj disk"

#: .././gui/usbcreator-gtk.ui.h:6
msgid ""
"Installation is complete.  You may now run Ubuntu on other computers by "
"booting them with this drive inserted."
msgstr ""
"Instalacija je završena. Ubuntu sada možete pokretati na drugim računalima "
"tako da ovaj uređaj postavite kao početni disk za učitavanje."

#. #-#-#-#-#  usbcreator.pot (PACKAGE VERSION)  #-#-#-#-#
#. set title of progress window (same as gtk frontend)
#: .././gui/usbcreator-gtk.ui.h:7 .././usbcreator/frontends/kde/frontend.py:429
#: usbcreator/frontends/kde/frontend.py:429
msgid "Installing"
msgstr "Instalacija"

#: .././gui/usbcreator-gtk.ui.h:8 .././usbcreator/frontends/kde/frontend.py:505
#: usbcreator/frontends/kde/frontend.py:505
msgid "Quit the installation?"
msgstr "Izlaz iz instalacije?"

#: .././gui/usbcreator-gtk.ui.h:9 .././usbcreator/frontends/kde/frontend.py:506
#: usbcreator/frontends/kde/frontend.py:506
msgid "Do you really want to quit the installation now?"
msgstr "Želite li doista izaći iz instalacije?"

#: .././gui/usbcreator-gtk.ui.h:10
msgid "Make Startup Disk"
msgstr "Napravi disk za pokretanje"

#: .././gui/usbcreator-gtk.ui.h:11
msgid ""
"To try or install Ubuntu from a removable disk, it needs to be set up as a "
"startup disk."
msgstr ""
"Za isprobavanje ili instalaciju Ubuntua s prijenosnog diska, potrebno ga je "
"postaviti kao disk za pokretanje."

#: .././gui/usbcreator-gtk.ui.h:12
msgid "Source disc image (.iso):"
msgstr "Slika diska izvora (.iso):"

#: .././gui/usbcreator-gtk.ui.h:13
msgid "Other..."
msgstr "Ostalo..."

#: .././gui/usbcreator-gtk.ui.h:14
msgid "Disk to use:"
msgstr "Disk za korištenje:"

#: .././gui/usbcreator-gtk.ui.h:15
msgid "Erase Disk"
msgstr "Obriši sadržaj diska"

#: .././desktop/usb-creator-kde.desktop.in.h:1
#: .././desktop/usb-creator-gtk.desktop.in.h:1
msgid "Startup Disk Creator"
msgstr "Stvaratelj diska za pokretanje"

#: .././desktop/usb-creator-kde.desktop.in.h:2
#: .././desktop/usb-creator-gtk.desktop.in.h:2
msgid "Create a startup disk using a CD or disc image"
msgstr "Stvorite disk za pokretanje koristeći CD ili sliku diska"

#: .././dbus/com.ubuntu.usbcreator.policy.in.h:1
msgid "Image the device"
msgstr "Napravi sliku uređaja"

#: .././dbus/com.ubuntu.usbcreator.policy.in.h:2
msgid "System policy prevents writing a disk image to this device"
msgstr "Pravila sustava sprječavaju zapisivanje slike diska na ovaj uređaja"

#: .././dbus/com.ubuntu.usbcreator.policy.in.h:3
msgid "Run KVM"
msgstr "Pokreni KVM"

#: .././dbus/com.ubuntu.usbcreator.policy.in.h:4
msgid "System policy prevents running KVM"
msgstr "Pravila sustava sprječavaju pokretanje KVM-a"

#: .././usbcreator/frontends/kde/frontend.py:200
#: .././usbcreator/frontends/gtk/frontend.py:655
#: usbcreator/frontends/kde/frontend.py:200
msgid "Installation failed."
msgstr "Instalacija nije uspjela."

#: .././usbcreator/frontends/kde/frontend.py:355
#: .././usbcreator/frontends/gtk/frontend.py:430
#: usbcreator/frontends/kde/frontend.py:355
msgid "The device is not large enough to hold this image."
msgstr "Uređaj nije dovoljno velik za ovu sliku."

#. #-#-#-#-#  usbcreator.pot (PACKAGE VERSION)  #-#-#-#-#
#. This here filter is for kfiledialog, no clue if it will ever make a return
#. filter = '*.iso|' + _('CD Images') + '\n*.img|' + _('Disk Images')
#: .././usbcreator/frontends/kde/frontend.py:387
#: .././usbcreator/frontends/gtk/frontend.py:548
#: usbcreator/frontends/kde/frontend.py:387
msgid "CD Images"
msgstr "CD slike"

#: .././usbcreator/frontends/kde/frontend.py:387
#: .././usbcreator/frontends/gtk/frontend.py:549
#: usbcreator/frontends/kde/frontend.py:387
msgid "Disk Images"
msgstr "Slike diska"

#: .././usbcreator/frontends/kde/frontend.py:417
#: .././usbcreator/frontends/gtk/frontend.py:577
#: usbcreator/frontends/kde/frontend.py:417
msgid "Are you sure you want to write the disc image to the device?"
msgstr "Sigurno želite zapisati sliku diska na uređaj?"

#: .././usbcreator/frontends/kde/frontend.py:418
#: .././usbcreator/frontends/gtk/frontend.py:578
#: usbcreator/frontends/kde/frontend.py:418
msgid "All existing data will be lost."
msgstr "Svi postojeći podaci će biti izgubljeni."

#: .././usbcreator/frontends/kde/frontend.py:427
#: usbcreator/frontends/kde/frontend.py:427
msgid "Cancel"
msgstr "Odustani"

#: .././usbcreator/frontends/kde/frontend.py:438
#: usbcreator/frontends/kde/frontend.py:438
msgid "Starting up"
msgstr "Pokretanje"

#: .././usbcreator/frontends/kde/frontend.py:447
#: usbcreator/frontends/kde/frontend.py:447
msgid "You must select both source image and target device first."
msgstr "Najprije morate odabrati sliku izvora i odredišni uređaj."

#: .././usbcreator/frontends/kde/frontend.py:458
#: .././usbcreator/frontends/gtk/frontend.py:611
#: usbcreator/frontends/kde/frontend.py:458
msgid "Finishing..."
msgstr "Završavanje..."

#: .././usbcreator/frontends/kde/frontend.py:477
#: usbcreator/frontends/kde/frontend.py:477
msgid ""
"The installation is complete.  You may now reboot your computer with this "
"device inserted to try or install Ubuntu."
msgstr ""
"Instalacija je završena. Računalo možete ponovno pokrenuti dok je ovaj "
"uređaj priključen, te isprobati ili instalirati Ubuntu."

#: .././usbcreator/frontends/kde/frontend.py:489
#: usbcreator/frontends/kde/frontend.py:489
msgid "Retry?"
msgstr "Pokušati ponovno?"

#: .././usbcreator/frontends/gtk/frontend.py:342
msgid "CD-Drive/Image"
msgstr "CD pogon/Slika"

#: .././usbcreator/frontends/gtk/frontend.py:355
msgid "OS Version"
msgstr "Inačica OS-a"

#: .././usbcreator/frontends/gtk/frontend.py:365
msgid "Size"
msgstr "Veličina"

#: .././usbcreator/frontends/gtk/frontend.py:500
msgid "Device"
msgstr "Uređaj"

#: .././usbcreator/frontends/gtk/frontend.py:516
msgid "Label"
msgstr "Oznaka"

#: .././usbcreator/frontends/gtk/frontend.py:526
msgid "Capacity"
msgstr "Kapacitet"

#: .././usbcreator/frontends/gtk/frontend.py:584
msgid "Starting up..."
msgstr "Pokretanje..."

#: .././usbcreator/frontends/gtk/frontend.py:609
#, python-format
msgid "%d%% complete"
msgstr "%d%% završeno"

#: .././usbcreator/install.py:92
#, python-format
msgid "The extension \"%s\" is not supported."
msgstr "Poširenje \"%s\" nije podržano."

#: .././usbcreator/install.py:101
#, python-format
msgid ""
"An uncaught exception was raised:\n"
"%s"
msgstr ""
"Dogodila se neočekivana iznimka:\n"
"%s"

#: .././usbcreator/install.py:105
msgid "Writing disk image..."
msgstr "Zapisivanje slike diska..."

#: .././usbcreator/install.py:106
#, python-format
msgid ""
"Could not write the disk image (%(source)s) to the device (%(device)s)."
msgstr ""
"Nemoguće zapisivanje slike diska (%(source)s) na uređaj (%(device)s)."

#: .././bin/usb-creator-kde:64
msgid "provide a source image to pre-populate the UI."
msgstr "pruža sliku izvora s ugrađenim GUI sučeljem."

#: .././bin/usb-creator-kde:69
msgid "allow writing to system-internal devices"
msgstr "dopusti zapisivanje na uređaje s ugrađenim sustavom"
