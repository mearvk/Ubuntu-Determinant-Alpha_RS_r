#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Poslužitelj za %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Glavni poslužitelj"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Prilagođeni poslužitelji"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Nedostaje opis za '%s'. Prijavite nedostatak."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Nevaljan unikôd u opisu za '%s' (%s). Prijavite ovo."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Popis promjena nije dostupan."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Popis promjena još nije dostupan.\n"
"\n"
"Posjetite http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"dok promjene ne postanu dostupne ili pokušajte ponovno kasnije."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Preuzimanje popisa promjena nije uspjelo. \n"
"Provjerite vaš pristup internetu."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Popis datoteka za '%s' ne može biti pročitan"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Popis kontrolnih datoteka za '%s' ne može biti pročitan"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Zavisnost se ne može riješiti: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Sukob s instaliranim paketom '%s'"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Prekida zavisnosti postojećeg paketa '%(pkgname)s' %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Prekida postojeći sukob paketa '%(pkgname)s': %(targetpkg)s (%(comptype)s "
"%(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Prekida postojeći sukob paketa '%(pkgname)s': '%(targetpkg)s'. Ali "
"'%(debfile)s' ga osigurava putem: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "U ovom paketu nema polja arhitekture"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Pogrešna arhitektura '%s' -- Pokrenite naredbu dpkg --add-architecture za "
"naknadno dodavanje arhitekture i nadopunu"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Novija inačica već je instalirana"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr ""
"Pokušaj rješavanja svih zavisnosti nije uspio (slomljena predmemorija)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Nemoguće instalirati '%s'"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Automatski raspakirano:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Automatski pretvoreno u ascii za ispis:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr "Instaliraj Build-Dependencies za izvorni paket '%s' koji gradi %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Neophodni paket bi bio uklonjen"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Završeno"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Pogodak "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Zanemareno "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Greška "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Preuzmi:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Obrada]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Promjena medija: umetnite disk označen kao\n"
" '%s'\n"
"u uređaj '%s' i pritisnite Enter\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Preuzeto %sB pri %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr "Navedite naziv za ovaj medij, poput 'Debian 2.1r1 Disk 1'"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Umetnite instalacijski medij i pritisnite Enter"
