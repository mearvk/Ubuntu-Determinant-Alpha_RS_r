#. TRANSLATORS:
#. The first placeholder is a filename, including the directory path.
#. The second placeholder is an ISO standard, e.g. 3166-1 or 639-3.
#: src/isocodes.c:68
#, c-format
msgid "The file \"%s\" does not contain valid ISO %s data."
msgstr "Datoteka \"%s\" ne sadrži valjane ISO %s podatke."

#. TRANSLATORS: This is an error message.
#: src/isocodes.c:93 src/isoquery.c:43 src/isoquery.c:60 src/isoquery.c:70
#, c-format
msgid "isoquery: %s\n"
msgstr "isoquery: %s\n"

#: src/isoquery.c:45
msgid ""
"Run \"isoquery --help\" to see a full list of available command line "
"options.\n"
msgstr ""
"Pokrenite \"isoquery --help\" kako bi vidjeli potpuni popis mogućnosti "
"naredbenog redka.\n"

#: src/options.c:45
msgid ""
"The ISO standard to use. Possible values: 639-2, 639-3, 639-5, 3166-1, 3166-"
"2, 3166-3, 4217, 15924 (default: 3166-1)"
msgstr ""
"ISO standard koji se koristi. Moguće vrijednosti: 639-2, 639-3, 639-5, 3166-"
"1, 3166-2, 3166-3, 4217, 15924 (zadano: 3166-1)"

#: src/options.c:46
msgid "STANDARD"
msgstr "STANDARD"

#: src/options.c:48
msgid ""
"Use pathname as prefix for the data files (default: /usr/share/iso-"
"codes/json)"
msgstr ""
"Koristite naziv putanje kao prefiks za datoteke podataka (zadano: "
"/usr/share/iso-codes/json)"

#: src/options.c:49
msgid "PATHNAME"
msgstr "NAZIV PUTANJE"

#: src/options.c:51
msgid "Use this locale for output"
msgstr "Koristi ovu lokalizaciju za izlaz"

#: src/options.c:52
msgid "LOCALE"
msgstr "LOKALIZACIJA"

#: src/options.c:54
msgid "Name for the supplied codes (default)"
msgstr "Naziv isporučenih kôdova (zadano)"

#: src/options.c:56
msgid ""
"Official name for the supplied codes. This may be the same as --name (only "
"applies to ISO 3166-1)"
msgstr ""
"Službeni naziv isporučenih kôdova. To može biti isto kao i --name (samo se "
"odnosi na ISO 3166-1)"

#: src/options.c:60
msgid ""
"Common name for the supplied codes. This may be the same as --name (only "
"applies to ISO 639-2, 639-3, and 3166-1)"
msgstr ""
"Uobičajeni naziv isporučenih kôdova. To može biti isto kao i --name (samo se "
"odnosi na ISO 639-2, 639-3, and 3166-1)"

#: src/options.c:63
msgid "Separate entries with a NULL character instead of newline"
msgstr "Odvojeni unosi s NULL znakom umjesto novog redka"

#: src/options.c:65
msgid "Show program version and copyright"
msgstr "Prikaži inačicu programa i autorska prava"

#: src/options.c:82
msgid "[ISO codes]"
msgstr "[ISO kôdovi]"

#. TRANSLATORS: The placeholder is a string like "1234-5".
#: src/options.c:142
#, c-format
msgid "ISO standard \"%s\" is not supported."
msgstr "ISO standard \"%s\" nije podržan."

#. TRANSLATORS: The placeholder is the version identifier.
#: src/options.c:176
#, c-format
msgid "isoquery %s\n"
msgstr "isoquery %s\n"

#: src/options.c:177
msgid "Copyright © 2007-2016 Dr. Tobias Quathamer\n"
msgstr "Autorsko pravo © 2007-2016 Dr. Tobias Quathamer\n"

#. TRANSLATORS: Please change the uppercase words as
#. appropriate for your language.
#: src/options.c:180
msgid "Translation to LANGUAGE Copyright © YEAR YOUR-NAME\n"
msgstr "Prijevod na hrvatski Autorsko pravo © 2020 gogo\n"

#. TRANSLATORS: The first placeholder is a code like "urgl" or
#. "does-not-exist", the second placeholder is the current
#. ISO standard like "3166-1" or "15924".
#: src/search.c:60
#, c-format
msgid "The code \"%s\" is not defined in ISO %s."
msgstr "Kôd \"%s\" nije definiran u ISO %s."
