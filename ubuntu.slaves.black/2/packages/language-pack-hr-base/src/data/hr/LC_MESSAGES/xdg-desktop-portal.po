#: src/background.c:260
#, c-format
msgid "Allow %s to run in the background?"
msgstr "Dopusti %s pokretanje u pozadini?"

#: src/background.c:264
#, c-format
msgid "%s requests to be started automatically and run in the background."
msgstr "%s zahtijeva automatsko pokretanje i izvođenje u pozadini."

#: src/background.c:266
#, c-format
msgid "%s requests to run in the background."
msgstr "%s zahtijeva izvođenje u pozadini."

#: src/background.c:267
msgid ""
"The ‘run in background’ permission can be changed at any time from the "
"application settings."
msgstr ""
"Dozvola ‘pokreni u pozadini‘ uvijek se može promijeniti u postavkama "
"aplikacija."

#: src/background.c:272
msgid "Don't allow"
msgstr "Nemoj dopustiti"

#: src/background.c:273 src/wallpaper.c:165
msgid "Allow"
msgstr "Dopusti"

#: src/device.c:115
msgid "Turn On Microphone?"
msgstr "Uključi mikrofon?"

#: src/device.c:116
msgid ""
"Access to your microphone can be changed at any time from the privacy "
"settings."
msgstr ""
"Pristup vašem mikrofonu je uvijek moguće promijeniti u postavkama "
"privatnosti."

#: src/device.c:120
msgid "An application wants to use your microphone."
msgstr "Aplikacija želi koristiti vaš mikrofon."

#: src/device.c:122
#, c-format
msgid "%s wants to use your microphone."
msgstr "%s želi koristiti vaš mikrofon."

#: src/device.c:128
msgid "Turn On Speakers?"
msgstr "Uključi zvučnike?"

#: src/device.c:129
msgid ""
"Access to your speakers can be changed at any time from the privacy settings."
msgstr ""
"Pristup svojim zvučnicima uvijek možete promijeniti u postavkama privatnosti."

#: src/device.c:133
msgid "An application wants to play sound."
msgstr "Aplikacija želi svirati zvuk."

#: src/device.c:135
#, c-format
msgid "%s wants to play sound."
msgstr "%s želi svirati zvuk."

#: src/device.c:141
msgid "Turn On Camera?"
msgstr "Uključi kameru?"

#: src/device.c:142
msgid ""
"Access to your camera can be changed at any time from the privacy settings."
msgstr ""
"Pristup svojoj kameri uvijek možete promijeniti u postavkama privatnosti."

#: src/device.c:146
msgid "An application wants to use your camera."
msgstr "Aplikacija želi koristiti vašu kameru."

#: src/device.c:148
#, c-format
msgid "%s wants to use your camera."
msgstr "%s želi koristiti vašu kameru."

#: src/location.c:526
msgid "Deny Access"
msgstr "Uskrati pristup"

#: src/location.c:528
msgid "Grant Access"
msgstr "Dopusti pristup"

#: src/location.c:534
msgid "Grant Access to Your Location?"
msgstr "Dopusti pristup svojoj lokaciji?"

#: src/location.c:535
msgid "An application wants to use your location."
msgstr "Aplikacija želi koristiti vašu lokaciju."

#: src/location.c:547
#, c-format
msgid "Give %s Access to Your Location?"
msgstr "Dopusti %s pristup svojoj lokaciji?"

#: src/location.c:551
#, c-format
msgid "%s wants to use your location."
msgstr "%s želi koristiti vašu lokaciju."

#: src/location.c:554
msgid "Location access can be changed at any time from the privacy settings."
msgstr ""
"Pristup lokaciji može se promijeniti u svako vrijeme iz postavka privatnosti."

#: src/settings.c:124
msgid "Requested setting not found"
msgstr "Zahtijevana postavka nije pronađena"

#: src/wallpaper.c:163
msgid "Deny"
msgstr "Uskrati"

#: src/wallpaper.c:171
msgid "Allow Applications to Set Backgrounds?"
msgstr "Dopusti aplikacijama postavljanje pozadine?"

#: src/wallpaper.c:172
msgid ""
"An application is requesting to be able to change the background image."
msgstr "Aplikacija zahtijeva promjenu slike pozadine."

#: src/wallpaper.c:184
#, c-format
msgid "Allow %s to Set Backgrounds?"
msgstr "Dopusti %s postavljanje pozadine?"

#: src/wallpaper.c:185
#, c-format
msgid "%s is requesting to be able to change the background image."
msgstr "%s zahtijeva promjenu slike pozadine."

#: src/wallpaper.c:188
msgid "This permission can be changed at any time from the privacy settings."
msgstr "Ovu dozvolu uvijek možete promijeniti u postavkama privatnosti."
