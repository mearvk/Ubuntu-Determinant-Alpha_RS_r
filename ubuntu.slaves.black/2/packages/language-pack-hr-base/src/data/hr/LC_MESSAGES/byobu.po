msgid "ERROR: Invalid selection"
msgstr "GREŠKA: neispravan odabir"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"Ako koristite zadane prečace tipkovnice, pritisnite\\n<F5> za aktivaciju tih "
"promjena.\\n\\nInače, izađite iz ovog zaslona prijave i pokrenite novi."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Pokreni \"byobu\" za aktiviranje"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu se trenutno pokreće pri prijavi (odaberite isključi)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu se trenutno ne pokreće pri prijavi (odaberite uključi)"

#: byobu-config:89
msgid "Help"
msgstr "Pomoć"

