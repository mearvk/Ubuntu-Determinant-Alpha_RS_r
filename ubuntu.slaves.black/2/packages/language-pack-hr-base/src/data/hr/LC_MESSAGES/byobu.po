msgid "Select a color: "
msgstr "Odaberi boju: "

#: byobu-export:240
msgid "Profile"
msgstr "Profil"

#: byobu-export:241
msgid "Archive"
msgstr "Arhiva"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Raspakirajte datoteku u vašu osobnu mapu na odredišnom sustavu."

