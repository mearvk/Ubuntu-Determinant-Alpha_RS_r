#. Type: title
#. Description
#: ../needrestart.templates:1001
msgid "Daemons using outdated libraries"
msgstr "Pozadinski programi koriste zastarjele biblioteke"

#. Type: multiselect
#. Description
#: ../needrestart.templates:2001
msgid "Which services should be restarted?"
msgstr "Koju uslugu treba ponovno pokrenuti?"

#. Type: note
#. Description
#. Type: note
#. Description
#: ../needrestart.templates:3001 ../needrestart.templates:4001
msgid "Newer kernel available"
msgstr "Dostupan je noviji kernel"

#. Type: note
#. Description
#: ../needrestart.templates:3001
msgid ""
"The currently running kernel version is ${KVERSION} and there is an ABI "
"compatible upgrade pending."
msgstr ""
"Trenutno pokrenuti kernel inačice je ${KVERSION} i dostupan je ABI "
"kompatibilna nadogradnja na čekanju."

#. Type: note
#. Description
#. Type: note
#. Description
#: ../needrestart.templates:3001 ../needrestart.templates:4001
msgid ""
"Restarting the system to load the new kernel will not be handled "
"automatically, so you should consider rebooting."
msgstr ""
"Ponovno pokretanje sustava za učitavanje novog kernela neće se pokrenuti "
"automatski, stoga bi trebali ponovno pokrenuti sustav."

#. Type: note
#. Description
#: ../needrestart.templates:4001
msgid ""
"The currently running kernel version is ${KVERSION} which is not the "
"expected kernel version ${EVERSION}."
msgstr ""
"Trenutno pokrenuti kernel inačice je ${KVERSION} što nije očekivana kernel "
"inačica ${EVERSION}."

#. Type: title
#. Description
#: ../needrestart.templates:5001
msgid "Pending kernel upgrade"
msgstr "Nadogradnja kernela na čekanju"

#. Type: title
#. Description
#: ../needrestart.templates:6001
msgid "Restart pending..."
msgstr "Ponovno pokretanje na čekanju..."

#. Type: note
#. Description
#: ../needrestart.templates:7001
msgid "This system runs ${EHINT} - you should consider rebooting!"
msgstr ""
"Ovaj sustav pokreće ${EHINT} - trebali bi razmotriti ponovno pokretanje!"

#. Type: note
#. Description
#: ../needrestart.templates:7001
msgid "For more details, run «needrestart -m a»."
msgstr "Za više pojedinosti, pokrenite «needrestart -m a»."

#. Type: title
#. Description
#: ../needrestart.templates:8001
msgid "Outdated processor microcode"
msgstr "Zastarjeli mikrokôd procesora"

#. Type: note
#. Description
#: ../needrestart.templates:9001
msgid "Processor microcode update"
msgstr "Nadopuna mikrokôd procesora"

#. Type: note
#. Description
#: ../needrestart.templates:9001
msgid ""
"The currently running processor microcode revision is ${CURRENT} which is "
"not the expected microcode revision ${AVAIL}."
msgstr ""
"Trenutno pokrenuti mikrokôd procesora je izdanja ${CURRENT} što nije "
"očekivano mikrokôd izdanje ${AVAIL}."

#. Type: note
#. Description
#: ../needrestart.templates:9001
msgid ""
"Restarting the system to load the new processor microcode will not be "
"handled automatically, so you should consider rebooting."
msgstr ""
"Ponovno pokretanje sustava za učitavanje novog mikrokôd procesora neće se "
"pokrenuti automatski, stoga bi trebali ponovno pokrenuti sustav."

#. Type: title
#. Description
#: ../needrestart.templates:10001
msgid "Containers using outdated libraries"
msgstr "Kontejneri koriste zastarjele biblioteke"

#. Type: multiselect
#. Description
#: ../needrestart.templates:11001
msgid "Which containers should be restarted?"
msgstr "Koji kontejner treba ponovno pokrenuti?"
