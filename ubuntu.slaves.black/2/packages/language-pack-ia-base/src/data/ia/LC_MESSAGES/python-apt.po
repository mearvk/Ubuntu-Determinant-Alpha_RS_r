#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Servitor pro %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Servitor principal"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Servitores personalisate"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr ""

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Unicode invalide in le description de «%s» (%s). Per favor reporta lo."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Le lista de cambios non es disponibile."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Le lista de cambios ancora non es disponibile.\n"
"\n"
"Usa «http://launchpad.net/ubuntu/+source/%s/%s/+changelog»\n"
"usque le lista esse disponibile o prova in altere momento."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Occurreva un error durante le discarga del lista de cambios. \n"
"Verifica tu connexion a Internet."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Non se poteva leger le lista de dossiers de «%s»"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Le lista del files de controlo pro '%s' non pote esser legite"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Le dependentia non es satis-facibile: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Conflictos con le pacchetto installate «%s»"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Rumpe le pacchettos existente '%(pkgname)s' dependetia %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Rumpe le pacchettos existente '%(pkgname)s' conflicto: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Rumpe le pacchettos existente '%(pkgname)s' que conflige: '%(targetpkg)s'. "
"Ma le '%(debfile)s' provide illo via: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Le pacchetto con contente un campo «Architecture»"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Mal architectura '%s' -- Face fluer dpkg --add-architecture pro adder lo e "
"actualisar afterwards"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Jam es installate una version posterior"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Fallite a satisfacer tote le dependentias (tampon rupte)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Non se poteva installar «%s»"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Decomprimite automaticamente:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Convertite automaticamente a ASCII imprimibile:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Installar le dependentias de production pro le pacchetto'%s' que produce %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Un pacchetto essential esserea removite"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Facite"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Consilio "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Err "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Obtener:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Working]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Cambio de dispositivo: introduce le disco appellate\n"
"«%s»\n"
"in le dispositivo «%s» e opprime Intro\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Obtenite %sB in %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
