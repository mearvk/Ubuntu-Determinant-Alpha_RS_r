#: src/frontend.py:93
#, python-format
msgid ""
"\n"
"Usage: %(progname)s %(command)s\n"
"\n"
"%(commands)s:\n"
" %(enable)-31s enables the firewall\n"
" %(disable)-31s disables the firewall\n"
" %(default)-31s set default policy\n"
" %(logging)-31s set logging to %(level)s\n"
" %(allow)-31s add allow %(rule)s\n"
" %(deny)-31s add deny %(rule)s\n"
" %(reject)-31s add reject %(rule)s\n"
" %(limit)-31s add limit %(rule)s\n"
" %(delete)-31s delete %(urule)s\n"
" %(insert)-31s insert %(urule)s at %(number)s\n"
" %(route)-31s add route %(urule)s\n"
" %(route-delete)-31s delete route %(urule)s\n"
" %(route-insert)-31s insert route %(urule)s at %(number)s\n"
" %(reload)-31s reload firewall\n"
" %(reset)-31s reset firewall\n"
" %(status)-31s show firewall status\n"
" %(statusnum)-31s show firewall status as numbered list of %(rules)s\n"
" %(statusverbose)-31s show verbose firewall status\n"
" %(show)-31s show firewall report\n"
" %(version)-31s display version information\n"
"\n"
"%(appcommands)s:\n"
" %(applist)-31s list application profiles\n"
" %(appinfo)-31s show information on %(profile)s\n"
" %(appupdate)-31s update %(profile)s\n"
" %(appdefault)-31s set default application policy\n"
msgstr ""
"\n"
"Użycie: %(progname)s %(command)s\n"
"\n"
"%(commands)s:\n"
" %(enable)-31s włącza zaporę\n"
" %(disable)-31s wyłącza zaporę\n"
" %(default)-31s ustawia zasady domyślne\n"
" %(logging)-31s ustawia logowanie na %(level)s\n"
" %(allow)-31s dodaje zezwolenie %(rule)s\n"
" %(deny)-31s dodaje odmowę %(rule)s\n"
" %(reject)-31s dodaje odrzucenie %(rule)s\n"
" %(limit)-31s dodaje ograniczenie %(rule)s\n"
" %(delete)-31s usuwa %(urule)s\n"
" %(insert)-31s wstawia %(urule)s na %(number)s\n"
" %(route)-31s dodaje trasę %(urule)s\n"
" %(route-delete)-31s usuwa trasę %(urule)s\n"
" %(route-insert)-31s wstawia trasę %(urule)s na %(number)s\n"
" %(reload)-31s przeładowuje zaporę\n"
" %(reset)-31s resetuje zaporę\n"
" %(status)-31s pokazuje stan zapory\n"
" %(statusnum)-31s pokazuje stan zapory jako listę numerowaną %(rules)s\n"
" %(statusverbose)-31s pokazuje opisowy stan zapory\n"
" %(show)-31s pokazuje raport zapory\n"
" %(version)-31s wyświetla informacje o wersji\n"
"\n"
"%(appcommands)s:\n"
" %(applist)-31s wymienia profile aplikacji\n"
" %(appinfo)-31s wyświetla informacje o %(profile)s\n"
" %(appupdate)-31s aktualizuje %(profile)s\n"
" %(appdefault)-31s ustawia domyślne zasady aplikacji\n"

