#: ../parser_main.c:263
#, c-format
msgid "%s: Could not allocate memory for subdomain mount point\n"
msgstr "%s: Nie można alokować pamięci dla punktu montowania subdomeny\n"

#: ../parser_main.c:269
#, c-format
msgid "%s: Could not allocate memory for subdomainbase mount point\n"
