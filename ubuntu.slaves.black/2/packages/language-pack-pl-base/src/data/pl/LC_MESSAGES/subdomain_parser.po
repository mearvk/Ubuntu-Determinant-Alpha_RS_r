#, c-format
msgid "Error: bad include. line %d in %s\n"
msgstr "Błąd: złe dołączenie. Wiersz %d w %s\n"

#: ../parser_include.c:303
#, c-format
msgid "Error: exceeded %d levels of includes.  NOT processing %s include\n"
