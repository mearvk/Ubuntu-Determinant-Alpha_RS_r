#: ../parser_include.c:80
msgid "Error couldn't allocate temporary file\n"
msgstr "Błąd - nie można zapisać pliku tymczasowego\n"

#: ../parser_include.c:103
msgid "Error: Out of Memory\n"
msgstr "Błąd: Brak pamięci\n"

#: ../parser_include.c:122
#, c-format
msgid "Error: Can't add directory %s to search path\n"
msgstr "Błąd: Nie można dodać katalogu %s do ścieżki wyszukiwania\n"

#: ../parser_include.c:130
msgid "Error: Could not allocate memory\n"
msgstr "Błąd: Brak dostępu do pamięci\n"

#: ../parser_include.c:251
#, c-format
msgid "Error: could not allocate buffer for include. line %d in %s\n"
msgstr "Błąd: brak możliwości dołączenia bufora. Wiersz %d w %s\n"

