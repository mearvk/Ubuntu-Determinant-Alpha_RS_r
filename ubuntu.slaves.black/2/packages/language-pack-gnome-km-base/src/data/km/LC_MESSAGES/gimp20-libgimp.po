#: ../libgimp/gimpexport.c:368 ../libgimp/gimpexport.c:406
#: ../libgimp/gimpexport.c:415
msgid "Convert to RGB"
msgstr "បម្លែង​ទៅជា RGB"

#: ../libgimp/gimpexport.c:376
#, c-format
msgid "%s plug-in can only handle grayscale images"
