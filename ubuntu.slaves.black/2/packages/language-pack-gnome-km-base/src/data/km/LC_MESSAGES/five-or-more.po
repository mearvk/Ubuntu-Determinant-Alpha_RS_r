#: data/org.gnome.five-or-more.gschema.xml:5
msgid "Playing field size"
msgstr "ទំហំ​វាល"

#: data/org.gnome.five-or-more.gschema.xml:6
msgid ""
"Playing field size. 1=Small, 2=Medium, 3=Large. Any other value is invalid."
msgstr ""
"ទំហំ​​វាល ១=តូច  ២=មធ្យម ៣=ធំ ។ តម្លៃ​ផ្សេង​ទៀត​គឺ​មិន​ត្រឹមត្រូវ​ឡើយ ។"

#: data/org.gnome.five-or-more.gschema.xml:10
msgid "Ball style"
msgstr "រចនាប័ទ្ម​បាល់"

#: data/org.gnome.five-or-more.gschema.xml:11
msgid "Ball style. The filename of the images to use for the balls."
msgstr "រចនាប័ទ្ម​បាល់ ។ ឈ្មោះ​ឯកសារ​រូបភាព​​ត្រូវ​ប្រើ​សម្រាប់​បាល់ ។"

#: data/org.gnome.five-or-more.gschema.xml:15
msgid "Background color"
msgstr "ពណ៌​ផ្ទៃខាងក្រោយ"

#: data/org.gnome.five-or-more.gschema.xml:16
msgid "Background color. The hex specification of the background color."
msgstr ""
"ពណ៌​ផ្ទៃ​ខាងក្រោយ ។ ការ​បញ្ជាក់​ចំនួន​គោល​ដប់​ប្រាំ​មួយ​នៃ​ពណ៌​ផ្ទៃ​ខាងក្រោយ "
"។"

#: data/org.gnome.five-or-more.gschema.xml:20
msgid "Time between moves"
msgstr "ចន្លោះ​ពេល​ផ្លាស់ទី"

#: data/org.gnome.five-or-more.gschema.xml:21
msgid "Time between moves in milliseconds."
msgstr "ចន្លោះ​ពេល​​ផ្លាស់ទី​គិត​ជា​មិល្លីវិនាទី ។"

#: data/org.gnome.five-or-more.gschema.xml:25
msgid "Game score"
msgstr "ពិន្ទុ​ល្បែង"

#: data/org.gnome.five-or-more.gschema.xml:26
msgid "Game score from last saved session."
msgstr "ពិន្ទុ​ល្បែង​ពី​សម័យ​ដែល​បាន​រក្សាទុក​ចុងក្រោយ ។"

#: data/org.gnome.five-or-more.gschema.xml:30
msgid "Game field"
msgstr "វាល​ល្បែង"

#: data/org.gnome.five-or-more.gschema.xml:31
msgid "Game field from last saved session."
msgstr "វាល​ល្បែង​ពី​សម័យ​ដែល​បាន​រក្សា​ទុក​​ចុងក្រោយ ។"

#: data/org.gnome.five-or-more.gschema.xml:35
msgid "Game preview"
msgstr "មើល​ល្បែង​ជា​មុន"

#: data/org.gnome.five-or-more.gschema.xml:36
msgid "Game preview from last saved session."
msgstr "មើល​ល្បែង​ជាមុន​ពី​សម័យ​ដែល​បាន​រក្សាទុក​ចុងក្រោយ ។"

#: data/org.gnome.five-or-more.gschema.xml:40
msgid "Width of the window in pixels"
msgstr "ទទឹង​របស់​បង្អួច​​​គិត​​ជា​ភីកសែល ។"

#: data/org.gnome.five-or-more.gschema.xml:44
msgid "Height of the window in pixels"
msgstr "កម្ពស់​របស់​បង្អួច​​​គិត​ជា​ភីកសែល ។"

#: data/org.gnome.five-or-more.gschema.xml:48
msgid "true if the window is maximized"
msgstr "ពិត ប្រសិនបើ​បង្អួច​ត្រូវ​បាន​ពង្រីក​អតិបរមា"

