#: ../data/local.scope.in.in.h:1
msgid "Videos"
msgstr "វីដេអូ"

#: ../data/local.scope.in.in.h:2
msgid ""
"This is an Ubuntu search plugin that enables local videos to be searched and "
"displayed in the Dash underneath the Video header. If you do not wish to "
"search this content source, you can disable this search plugin."
msgstr ""
"វា​ជា​កម្មវិធី​ជំនួយ​ការ​ស្វែងរក​អ៊ូប៊ុនទូ​ដែល​បើក​វីដេអូ​មូលដ្ឋាន​ដើម្បី​ស្វ"
"ែងរក និង​បង្ហាញ​ក្នុង​បឋមកថា​វីដេអូ Dash underneath ។ "
"បើ​អ្នក​មិន​ចង់​ស្វែងរក​ប្រភព​មាតិកា​នេះ, "
"អ្នក​អាច​បិទ​កម្មវិធី​ជំនួយ​ការ​ស្វែងរក​នេះ។"

#: ../data/remote.scope.in.in.h:1
msgid "Remote videos"
msgstr "វីដេអូ​ពី​ចម្ងាយ"

#: ../data/remote.scope.in.in.h:2
msgid ""
"This is an Ubuntu search plugin that enables information from various video "
"providers to be searched and displayed in the Dash underneath the Video "
"header. If you do not wish to search these content sources, you can disable "
"this search plugin."
msgstr ""
"វា​ជា​កម្មវិធី​ជំនួយ​ការ​ស្វែងរក​អ៊ូប៊ុនទូ​ដែល​បើក​ព័ត៌មាន​ពី​កម្មវិធី​ផ្ដល់​"
"វីដេអូ​មុនៗ​​ដើម្បី​ស្វែងរក និង​បង្ហាញ​ក្នុង​បឋមកថា​វីដេអូ Dash underneath ។ "
"បើ​អ្នក​មិន​ចង់​ស្វែងរក​ប្រភព​​មាតិកា​ទាំងនេះ​ទេ, "
"អ្នក​អាច​បិទ​កម្មវិធី​ស្វែងរក​នេះ​បាន។"
