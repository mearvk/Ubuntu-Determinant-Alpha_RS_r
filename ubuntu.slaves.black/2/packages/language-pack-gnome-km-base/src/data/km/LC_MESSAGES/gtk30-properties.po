msgid "Pixbuf for closed expander"
msgstr "Pixbuf សម្រាប់​ឧបករណ៍​ពង្រីក​ដែល​បិទ"

#: gtk/gtkcellrendererpixbuf.c:180
msgid "surface"
msgstr "ផ្ទៃ"

#: gtk/gtkcellrendererpixbuf.c:181
