#: gtk/gtkwindow.c:912
msgid "Focus in Toplevel"
msgstr "ផ្ដោត​នៅ​ក្នុង​កម្រិត​ខ្ពស់"

#: gtk/gtkwindow.c:913
msgid "Whether the input focus is within this GtkWindow"
msgstr ""
"ថា​តើ​ចំណុច​ផ្ដោត​ក្នុង​ការ​បញ្ចូល​ស្ថិត​នៅ​ក្នុង GtkWindow នេះ​ដែរ​ឬ​ទេ"

#: gtk/gtkwindow.c:919
msgid "Type hint"
msgstr "ជំនួយ​ប្រភេទ"

#: gtk/gtkwindow.c:920
msgid ""
"Hint to help the desktop environment understand what kind of window this is "
"and how to treat it."
msgstr ""
"ជំនួយ​សម្រាប់​ជួយ​ឲ្យ​បរិស្ថាន​ផ្ទៃតុ​យល់​អំពី​ប្រភេទ​បង្អួច "
"និង​របៀប​កំណត់​វា ។"

#: gtk/gtkwindow.c:927
msgid "Skip taskbar"
msgstr "រំលង​របារ​ភារកិច្ច"

#: gtk/gtkwindow.c:928
msgid "TRUE if the window should not be in the task bar."
msgstr "ពិត ប្រសិនបើ​បង្អួច​មិន​ស្ថិត​នៅ​ក្នុង​របារ​ភារកិច្ច ។"

#: gtk/gtkwindow.c:934
msgid "Skip pager"
msgstr "រំលង pager"

#: gtk/gtkwindow.c:935
msgid "TRUE if the window should not be in the pager."
msgstr "ពិត ប្រសិនបើ​បង្អួច​មិន​ស្ថិត​នៅ​ក្នុង pager ។"

#: gtk/gtkwindow.c:941
msgid "Urgent"
msgstr "បន្ទាន់"

#: gtk/gtkwindow.c:942
msgid "TRUE if the window should be brought to the user's attention."
msgstr "ពិត ប្រសិនបើ​បង្អួច​ធ្វើឲ្យ​អ្នកប្រើ​ចាប់អារម្មណ៍ ។"

#: gtk/gtkwindow.c:955
msgid "Accept focus"
msgstr "ទទួល​យក​ចំណុច​ផ្ដោត"

#: gtk/gtkwindow.c:956
msgid "TRUE if the window should receive the input focus."
msgstr "ពិត ប្រសិនបើ​បង្អួច​ទទួល​យក​ចំណុច​ផ្ដោត​ក្នុង​ការ​បញ្ចូល ។"

#: gtk/gtkwindow.c:969
msgid "Focus on map"
msgstr "ផ្ដោត​នៅ​លើ​ផែនទី"

#: gtk/gtkwindow.c:970
msgid "TRUE if the window should receive the input focus when mapped."
msgstr ""
"ពិត ប្រសិនបើ​បង្អួច​ទទួល​យក​ចំណុច​ផ្ដោត​ក្នុង​ការ​បញ្ចូល នៅ​ពេល​បាន​ផ្គូផ្គង "
"។"

#: gtk/gtkwindow.c:983
msgid "Decorated"
msgstr "តុបតែង"

#: gtk/gtkwindow.c:984
msgid "Whether the window should be decorated by the window manager"
msgstr ""
"ថា​តើ​បង្អួច​នេះ​គួរតែ​ត្រូវ​បាន​តុបតែង​ដោយ​កម្មវិធី​គ្រប់គ្រង​បង្អួច​ដែរ​ឬ​ទ"
"េ"

#: gtk/gtkwindow.c:997
msgid "Deletable"
msgstr "អាច​លុប​បាន"

#: gtk/gtkwindow.c:998
msgid "Whether the window frame should have a close button"
msgstr "ថា​តើ​ស៊ុម​បង្អួច​គួរតែ​មាន​ប៊ូតុង​បិទ​ដែរ​ឬ​ទេ"

#: gtk/gtkwindow.c:1018
msgid "Resize grip"
msgstr "ចំណុច​ចាប់​ទាញ​ប្ដូរ​ទំហំ"

#: gtk/gtkwindow.c:1019
msgid "Specifies whether the window should have a resize grip"
msgstr "បញ្ជាក់​ថា​តើ​បង្អួច​គួរតែ​មាន​ចំណុច​ចាប់​ទាញ​ប្ដូរ​ទំហំ​ដែរ​ឬ​ទេ"

#: gtk/gtkwindow.c:1034
msgid "Resize grip is visible"
msgstr "អាច​មើល​ឃើញ​ចំណុច​ចាប់​ទាញ​ប្ដូរ​ទំហំ"

#: gtk/gtkwindow.c:1035
msgid "Specifies whether the window's resize grip is visible."
msgstr "បញ្ជាក់​ថា​​តើ​ចំណុច​ចាប់​ទាញ​ប្ដូរ​ទំហំ​អាច​មើល​ឃើញ​ដែរ​ឬទេ ។"

#: gtk/gtkwindow.c:1049
msgid "Gravity"
msgstr "ទំនាញ"

#: gtk/gtkwindow.c:1050
msgid "The window gravity of the window"
msgstr "ទំនាញ​បង្អួច"

#: gtk/gtkwindow.c:1085
msgid "Attached to Widget"
msgstr "ភ្ជាប់​ជាមួយ​ធាតុ​ក្រាហ្វិក"

#: gtk/gtkwindow.c:1086
msgid "The widget where the window is attached"
msgstr "ធាតុ​ក្រាហ្វិក​ដែល​បង្អួច​ភ្ជាប់​ជាមួយ"

#: gtk/gtkwindow.c:1092
msgid "Is maximized"
msgstr ""

#: gtk/gtkwindow.c:1093
msgid "Whether the window is maximized"
msgstr "ថា​តើ​បង្អួច​ត្រូវ​បាន​ពង្រីក​អតិបរមា"

#: gtk/gtkwindow.c:1114
msgid "GtkApplication"
msgstr "GtkApplication"

#: gtk/gtkwindow.c:1115
msgid "The GtkApplication for the window"
msgstr "GtkApplication សម្រាប់​​បង្អួច"

#: gtk/gtkwindow.c:1125 gtk/gtkwindow.c:1126
msgid "Decorated button layout"
msgstr "ប្លង់​ប៊ូតុង​បាន​រចនា"

#: gtk/gtkwindow.c:1132 gtk/gtkwindow.c:1133
msgid "Decoration resize handle size"
msgstr "ការ​រចនា​ប្ដូរ​ទំហំ​ចំណុច​ទាញ"

#: modules/printbackends/cups/gtkprintercups.c:93
msgid "Color Profile Title"
msgstr "ចំណងជើង​ទម្រង់​ពណ៌"

#: modules/printbackends/cups/gtkprintercups.c:94
msgid "The title of the color profile to use"
msgstr "ចំណងជើង​ទម្រង់​ពណ៌​ដែល​ត្រូវ​ប្រើ"
