msgstr "ពុម្ពអក្សរ"

#: gtk/gtkcellrenderertext.c:365 gtk/gtkfontchooser.c:65 gtk/gtktexttag.c:326
msgid "Font description as a string, e.g. \"Sans Italic 12\""
msgstr "សេចក្ដី​ពិពណ៌នា​ពុម្ពអក្សរ​ជា​ខ្សែ​អក្សរ ឧ. \"Sans Italic 12\""

