msgstr ""
"តម្រឹម​អត្ថបទ​ផ្ដេក ចាប់ពី ០ (ឆ្វេង) ដល់ ១ (ស្ដាំ) ។ បញ្ច្រាស​សម្រាប់​ប្លង់ "
"RTL ។"

#: gtk/gtkcellrendererprogress.c:214
msgid "Text y alignment"
msgstr "តម្រឹម​អត្ថបទ​តាម y"

#: gtk/gtkcellrendererprogress.c:215
msgid "The vertical text alignment, from 0 (top) to 1 (bottom)."
msgstr "តម្រឹម​អត្ថបទ​បញ្ឈរ​ ចាប់ពី ០ (ខាងលើ) ដល់ ១ (ខាងក្រោម) ។"

#: gtk/gtkcellrendererprogress.c:226 gtk/gtklevelbar.c:1097
#: gtk/gtkmodelbutton.c:1242 gtk/gtkprogressbar.c:264 gtk/gtkrange.c:441
