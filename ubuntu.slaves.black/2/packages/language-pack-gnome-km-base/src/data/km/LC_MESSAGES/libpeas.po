msgid "View"
msgstr "ទិដ្ឋភាព"

#: ../data/glade/libpeas-gtk.xml.in.h:4
msgid "Plugin Manager View"
msgstr "ទិដ្ឋភាព​កម្មវិធី​គ្រប់គ្រង​កម្មវិធី​ជំនួយ"

