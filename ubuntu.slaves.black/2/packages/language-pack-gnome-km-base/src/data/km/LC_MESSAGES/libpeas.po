msgstr "បាន​បរាជ័យ​ក្នុង​ការ​ផ្ទុក"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:95
msgid "Additional plugins must be disabled"
msgstr "ត្រូវ​តែ​បិទ​កម្មវិធី​ជំនួយ​បន្ថែម"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:102
#, c-format
msgid "The following plugins depend on '%s' and will also be disabled:"
msgstr "កម្មវិធី​ជំនួយ​ខាង​ក្រោម​អាស្រ័យ​លើ '%s' នឹង​ត្រូវ​បាន​បិទ​ផង​ដែរ៖"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:144
msgid "Plugins"
msgstr "កម្មវិធី​ជំនួយ"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:161
msgid "An additional plugin must be disabled"
msgstr "ត្រូវ​តែ​បិទ​កម្មវិធី​ជំនួយ​បន្ថែម"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:168
#, c-format
msgid ""
"The '%s' plugin depends on the '%s' plugin.\n"
"If you disable '%s', '%s' will also be disabled."
msgstr ""
"កម្មវិធី​ជំនួយ '%s' អាស្រ័យ​លើ​កម្មវិធី​ជំនួយ '%s' ។\n"
"ប្រសិន​បើ​អ្នក​បិទ '%s', '%s' នឹង​ត្រូវ​បាន​បិទ​ផង​ដែរ។"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:182
msgid "_Cancel"
msgstr "បោះបង់"

#: ../libpeas-gtk/peas-gtk-disable-plugins-dialog.c:184
msgid "Disable Plugins"
msgstr "បិទ​កម្មវិធី​ជំនួយ"

