#: gtk/gtktexttag.c:396
msgid "Right margin"
msgstr "រឹម​ខាង​ស្ដាំ"

#: gtk/gtktexttag.c:397 gtk/gtktextview.c:613
msgid "Width of the right margin in pixels"
