#: gtk/gtktexttag.c:665
msgid "Whether this tag affects tabs"
msgstr "ថា​តើ​ស្លាក​នេះ​មាន​ឥទ្ធិពល​លើ​ផ្ទាំង​ដែរ​ឬ​ទេ"

#: gtk/gtktexttag.c:668
