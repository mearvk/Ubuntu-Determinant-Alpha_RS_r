msgstr "ទីតាំង Y"

#: gtk/gtkfixed.c:101 gtk/gtklayout.c:610
msgid "Y position of child widget"
msgstr "ទីតាំង Y របស់​ធាតុ​ក្រាហ្វិក​រង"

