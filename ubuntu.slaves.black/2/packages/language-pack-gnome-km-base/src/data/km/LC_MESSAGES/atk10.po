#: atk/atkobject.c:527
msgid "Accessible Table Row Description"
msgstr "សេចក្ដី​ពិពណ៌នា​ជួរដេក​តារាង​ដែល​អាច​ចូល​ដំណើរការ​បាន"

#: atk/atkobject.c:528
msgid "Is used to notify that the table row description has changed"
