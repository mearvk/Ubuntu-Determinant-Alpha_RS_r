msgid "Left side"
msgstr "ផ្នែក​ខាងឆ្វេង"

#: ../panels/appearance/appearance.ui.h:22
msgid "Top left corner"
msgstr "ជ្រុង​ខាងលើ​ផ្នែក​ខាងឆ្វេង"

