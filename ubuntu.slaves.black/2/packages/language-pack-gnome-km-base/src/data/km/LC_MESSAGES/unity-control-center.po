#: ../panels/universal-access/uap.ui.h:58
msgid "accepted"
msgstr "ទទួលយក"

#. This completes the sentence "Beep when a key is"
#: ../panels/universal-access/uap.ui.h:60
msgid "rejected"
msgstr "បដិសេធ"

