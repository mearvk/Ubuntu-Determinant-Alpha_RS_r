msgid "<b>Menus visibility</b>"
msgstr "<b>ភាពមើលឃើញម៉ឺនុយ</b>"

#: ../panels/appearance/appearance.ui.h:33
msgid "Displayed on mouse hovering"
msgstr "ដែលបានបង្ហាញនៅពេលដាក់កណ្ដុរ"

