#: ../panels/appearance/appearance.ui.h:36
#: ../panels/universal-access/zoom-options.ui.h:34
msgid "Low"
msgstr "ទាប"

#. long delay
#: ../panels/appearance/appearance.ui.h:37
#: ../panels/universal-access/zoom-options.ui.h:36
msgid "High"
msgstr "ខ្ពស់"

#: ../panels/appearance/appearance.ui.h:38
msgid ""
"<small>Includes shadows and animations when opening, resizing and switching "
"windows.</small>"
msgstr ""
"<small>រួមមានស្រមោលនិងជីវចលនានៅពេលបើក ប្តូរទំហំ និងផ្លាស់ប្តូរវីនដូ ។</small>"

#: ../panels/appearance/appearance.ui.h:39
msgid ""
"Some settings have been overriden by an external program, press \"Restore "
"Default Behaviors\"  to reset the behavior and return control to this panel."
msgstr ""
"ការ​កំណត់​មួយ​ចំនួន​ត្រូវ​បាន​បដិសេធ​ដោយ​កម្មវិធី​ខាង​ក្រៅ ចុច "
"\"ស្ដារ​ឥរិយាបថ​លំនាំដើម\"  ដើម្បី​កំណត់​ឥរិយាបថ​ឡើងវិញ "
"និង​ត្រឡប់​វត្ថុ​បញ្ជា​ទៅកាន់​បន្ទះ​នេះ ។"

