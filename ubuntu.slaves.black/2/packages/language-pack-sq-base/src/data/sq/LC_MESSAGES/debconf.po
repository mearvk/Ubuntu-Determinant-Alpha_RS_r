#: ../Debconf/Config.pm:131
msgid "Config database not specified in config file."
msgstr ""
"Konfigurimi i bazës së të dhënave nuk është specifikuar në skedarin config."

#: ../Debconf/Config.pm:135
msgid "Template database not specified in config file."
msgstr "Baza e të dhënave të gatshme nuk është specifikuar në skedar."

#: ../Debconf/Config.pm:140
msgid ""
"The Sigils and Smileys options in the config file are no longer used. Please "
"remove them."
msgstr ""
"Opsionet e Sigils dhe Smileys në skedarin config nuk po përdoren më. Ju "
"letemi hiqini ato."

#: ../Debconf/Config.pm:157
#, perl-format
msgid "Problem setting up the database defined by stanza %s of %s."
msgstr ""
"Problem në vendosjen e bazës së të dhënave të përcaktuar nga stanza %s e %s."

#: ../Debconf/Config.pm:232
msgid ""
"  -f,  --frontend\t\tSpecify debconf frontend to use.\n"
"  -p,  --priority\t\tSpecify minimum priority question to show.\n"
"       --terse\t\t\tEnable terse mode.\n"
msgstr ""
"  -f,  --frontend\t\tSpecifikon debconf frontend që do përdoret.\n"
"  -p,  --priority\t\tSpecifikon shfaqjen e pyetjeve me një prioritet "
"minimal.\n"
"       --terse\t\t\tAktivizon mënyrën terse.\n"

#: ../Debconf/Config.pm:312
#, perl-format
msgid "Ignoring invalid priority \"%s\""
msgstr "Po injorojmë prioritetin e pavlefshëm \"%s\""

#: ../Debconf/Config.pm:313
#, perl-format
msgid "Valid priorities are: %s"
msgstr "Prioritete të vlefshme janë: %s"

