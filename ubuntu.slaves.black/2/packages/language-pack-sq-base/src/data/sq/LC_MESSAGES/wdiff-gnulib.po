#: lib/error.c:188
msgid "Unknown system error"
msgstr "Gabim i panjohur i sistemit"

#: lib/getopt.c:547 lib/getopt.c:576
#, c-format
msgid "%s: option '%s' is ambiguous; possibilities:"
msgstr "%s: opsioni '%s' është i dyshimtë; mundësitë:"

#: lib/getopt.c:624 lib/getopt.c:628
#, c-format
msgid "%s: option '--%s' doesn't allow an argument\n"
msgstr "%s: opsioni '--%s' nuk lejon një argument\n"

#: lib/getopt.c:637 lib/getopt.c:642
#, c-format
msgid "%s: option '%c%s' doesn't allow an argument\n"
msgstr "%s: opsionin '%c%s' nuk lejon një argument\n"

#: lib/getopt.c:685 lib/getopt.c:704
#, c-format
msgid "%s: option '--%s' requires an argument\n"
msgstr "%s: opsioni '--%s' kërkon një argument\n"

#: lib/getopt.c:742 lib/getopt.c:745
#, c-format
msgid "%s: unrecognized option '--%s'\n"
msgstr "%s: opsion i panjohur '--%s'\n"

#: lib/getopt.c:753 lib/getopt.c:756
#, c-format
msgid "%s: unrecognized option '%c%s'\n"
msgstr "%s: opsion i panjohur '%c%s'\n"

#: lib/getopt.c:805 lib/getopt.c:808
#, c-format
msgid "%s: invalid option -- '%c'\n"
msgstr "%s: opsion i pavlefshëm -- '%c'\n"

#: lib/getopt.c:861 lib/getopt.c:878 lib/getopt.c:1088 lib/getopt.c:1106
#, c-format
msgid "%s: option requires an argument -- '%c'\n"
msgstr "%s: opsioni kërkon një argument -- '%c'\n"

#: lib/getopt.c:934 lib/getopt.c:950
#, c-format
msgid "%s: option '-W %s' is ambiguous\n"
msgstr "%s: opsioni '-W %s' është i dyshimtë\n"

#: lib/getopt.c:974 lib/getopt.c:992
#, c-format
msgid "%s: option '-W %s' doesn't allow an argument\n"
msgstr "%s: opsioni '-W %s' nuk lejon një argument\n"

#: lib/getopt.c:1013 lib/getopt.c:1031
#, c-format
msgid "%s: option '-W %s' requires an argument\n"
msgstr "%s: opsioni '-W %s' kërkon një argument\n"

#: lib/regcomp.c:131
msgid "Success"
msgstr "Sukses"

#: lib/regcomp.c:134
msgid "No match"
msgstr "Asnjë përputhje"

#: lib/regcomp.c:137
msgid "Invalid regular expression"
msgstr "Shprehje e rregullt e pavlefshme"

#: lib/regcomp.c:140
msgid "Invalid collation character"
msgstr "Karakter i bashkangjitur i pavlefshëm"

#: lib/regcomp.c:143
msgid "Invalid character class name"
msgstr "Emër i pavlefshëm i klasës së karakterit"

#: lib/regcomp.c:146
msgid "Trailing backslash"
msgstr "Gjurmojmë backslash"

#: lib/regcomp.c:149
msgid "Invalid back reference"
msgstr "Referencë dytësore e pavlefshme"

#: lib/regcomp.c:152
msgid "Unmatched [ or [^"
msgstr "Nuk përputhet [ ose [^"

#: lib/regcomp.c:155
msgid "Unmatched ( or \\("
msgstr "Nuk përputhet ( ose \\("

#: lib/regcomp.c:158
msgid "Unmatched \\{"
msgstr "Nuk përputhet \\{"

#: lib/regcomp.c:161
msgid "Invalid content of \\{\\}"
msgstr "Përbërje e pavlefshme e \\{\\}"

#: lib/regcomp.c:164
msgid "Invalid range end"
msgstr "Fund i pavlefshëm i rreshtit"

#: lib/regcomp.c:167
msgid "Memory exhausted"
msgstr "Kujtesa është lodhur"

#: lib/regcomp.c:170
msgid "Invalid preceding regular expression"
msgstr "Shprehje e rregullt pararendëse e pavlefshme"

#: lib/regcomp.c:173
msgid "Premature end of regular expression"
msgstr "Fund i papritur i shprehjes së rregullt"

#: lib/regcomp.c:176
msgid "Regular expression too big"
msgstr "Shprehja e rregullt shumë e madhe"

#: lib/regcomp.c:179
msgid "Unmatched ) or \\)"
msgstr "Nuk përputhet ) ose \\)"

#: lib/regcomp.c:707
msgid "No previous regular expression"
msgstr "Nuk ka shprehje të rregullt të mëparshme"

#: lib/xalloc-die.c:34
msgid "memory exhausted"
msgstr "Kujtesa është mbaruar"
