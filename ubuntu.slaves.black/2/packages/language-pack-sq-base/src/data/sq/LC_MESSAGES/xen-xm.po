#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Gabim i brendshëm: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Kjo hartë tashmë përmban %(1)s -> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "Metoda %(1)s nuk është e suportuar."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "Metoda %(1)s ka %(2)s argument(a) (%(3)s të dhënë)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Leja Mohohet."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Vlera \"%(2)s\" për %(1)s nuk është e suportuar nga ky server.  Serveri tha "
"\"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "%(1)s mbartësja %(2)s nuk është e vlefshme."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "Ju tentuat një veprim që nuk lejohet."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Rrjeti që ju specifikuat e ka tashmë një PIF të bashkangjitur, kështu që nuk "
"mund të bashkangjitet një tjetër."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
