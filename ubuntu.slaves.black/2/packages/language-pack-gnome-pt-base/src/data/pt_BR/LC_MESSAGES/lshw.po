#: ../lshw.cc:24
#, c-format
msgid "usage: %s [-format] [-options ...]\n"
msgstr "uso: %s [-format] [-options ...]\n"

#: ../lshw.cc:25
#, c-format
msgid "       %s -version\n"
msgstr "       %s -version\n"

#: ../lshw.cc:27
#, c-format
msgid "\t-version        print program version (%s)\n"
msgstr "\t-version imprime a versão do programa (%s)\n"

#: ../lshw.cc:28
#, c-format
msgid ""
"\n"
"format can be\n"
msgstr ""
"\n"
"formato pode ser\n"

#: ../lshw.cc:29
#, c-format
msgid "\t-html           output hardware tree as HTML\n"
msgstr "\t-html           gera saída de árvore de hardware como HTML\n"

#: ../lshw.cc:30
#, c-format
msgid "\t-xml            output hardware tree as XML\n"
msgstr "\t-xml            gera saída de árvore de hardware como XML\n"

#: ../lshw.cc:31
#, c-format
msgid "\t-short          output hardware paths\n"
msgstr "\t-short          gera saída dos caminhos de hardware\n"

#: ../lshw.cc:32
#, c-format
msgid "\t-businfo        output bus information\n"
msgstr "\t-businfo        gera saída de informações de barramento\n"

#: ../lshw.cc:34
#, c-format
msgid "\t-X              use graphical interface\n"
msgstr "\t-X usa a interface gráfica\n"

#: ../lshw.cc:35
#, c-format
msgid ""
"\n"
"options can be\n"
msgstr ""
"\n"
"opções podem ser\n"

#: ../lshw.cc:37
#, c-format
msgid "\t-class CLASS    only show a certain class of hardware\n"
msgstr "\t-class CLASS    mostra somente uma classe de hardware\n"

#: ../lshw.cc:38
#, c-format
msgid "\t-C CLASS        same as '-class CLASS'\n"
msgstr "\t-C CLASS        o mesmo que '-class CLASS'\n"

#: ../lshw.cc:39
#, c-format
msgid "\t-c CLASS        same as '-class CLASS'\n"
msgstr "\t-c CLASS        o mesmo que '-class CLASS'\n"

#: ../lshw.cc:41
#, c-format
msgid "\t-disable TEST   disable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr ""
"\t-disable TESTE  desativa um teste (como pci, isapnp, cpuid, etc. )\n"

#: ../lshw.cc:43
#, c-format
msgid "\t-enable TEST    enable a test (like pci, isapnp, cpuid, etc. )\n"
msgstr "\t-enable TESTE    ativa um teste (como pci, isapnp, cpuid, etc. )\n"

#: ../lshw.cc:44
#, c-format
msgid "\t-quiet          don't display status\n"
msgstr "\t-quiet          não exibe o status\n"

#: ../lshw.cc:45
#, c-format
msgid ""
"\t-sanitize       sanitize output (remove sensitive information like serial "
"numbers, etc.)\n"
msgstr ""
"\t-sanitize       sanear saída (remove informações confidenciais como "
"números de série, etc.)\n"

#: ../lshw.cc:46
#, c-format
msgid "\t-numeric        output numeric IDs (for PCI, USB, etc.)\n"
msgstr ""
"\t-numeric        gera saída de IDs numéricas (para PCI, USB, etc.)\n"

