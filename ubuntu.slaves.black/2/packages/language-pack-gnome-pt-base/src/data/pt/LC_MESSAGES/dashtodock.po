#: Settings.ui.h:1
msgid ""
"When set to minimize, double clicking minimizes all the windows of the "
"application."
msgstr ""
"Quando definido para minimizar, o duplo clique minimiza todas as janelas da "
"aplicação."

#: Settings.ui.h:2
msgid "Shift+Click action"
msgstr "Ação de Shift+Clique"

#: Settings.ui.h:3
msgid "Raise window"
msgstr "Levantar a janela"

#: Settings.ui.h:4
msgid "Minimize window"
msgstr "Minimizar a janela"

#: Settings.ui.h:5
msgid "Launch new instance"
msgstr "Abrir uma nova janela"

#: Settings.ui.h:6
msgid "Cycle through windows"
msgstr "Percorrer as janelas"

#: Settings.ui.h:7
msgid "Minimize or overview"
msgstr "Minimizar ou antever"

#: Settings.ui.h:8
msgid "Show window previews"
msgstr "Mostrar antevisão das janelas"

#: Settings.ui.h:9
msgid "Minimize or show previews"
msgstr "Minimizar ou antever"

#: Settings.ui.h:10
msgid "Focus or show previews"
msgstr "Focar ou mostrar antevisões"

#: Settings.ui.h:12
msgid "Focus, minimize or show previews"
msgstr "Focar, minimizar ou mostrar miniaturas"

#: Settings.ui.h:14
msgid "Quit"
msgstr "Sair"

#: Settings.ui.h:15
msgid "Behavior for Middle-Click."
msgstr "Comportamento do clique do meio."

#: Settings.ui.h:16
msgid "Middle-Click action"
msgstr "Ação do clique do meio"

#: Settings.ui.h:17
msgid "Behavior for Shift+Middle-Click."
msgstr "Comportamento do Shift+Clique do meio."

#: Settings.ui.h:18
msgid "Shift+Middle-Click action"
msgstr "Ação do Shift+Clique do meio"

#: Settings.ui.h:19
msgid "Enable Unity7 like glossy backlit items"
msgstr "Usar efeito polido no fundo (estilo Unity7)"

#: Settings.ui.h:20
msgid "Apply glossy effect."
msgstr "Aplicar efeito lustroso."

#: Settings.ui.h:21
msgid "Use dominant color"
msgstr "Usar cor dominante"

#: Settings.ui.h:22
msgid "Customize indicator style"
msgstr "Personalizar os indicadores"

#: Settings.ui.h:23
msgid "Color"
msgstr "Cor"

#: Settings.ui.h:24
msgid "Border color"
msgstr "Cor da borda"

#: Settings.ui.h:25
msgid "Border width"
msgstr "Largura da borda"

#: Settings.ui.h:26
msgid "Show the dock on"
msgstr "Mostrar a doca em"

#: Settings.ui.h:25
msgid "Show on all monitors."
msgstr "Mostrar em todos os monitores."

#: Settings.ui.h:28
msgid "Position on screen"
msgstr "Posição no ecrã"

#: Settings.ui.h:30
msgid "Bottom"
msgstr "Em baixo"

#: Settings.ui.h:31
msgid "Top"
msgstr "Em cima"

#: Settings.ui.h:33
msgid ""
"Hide the dock when it obstructs a window of the current application. More "
"refined settings are available."
msgstr ""
"Ocultar a doca quando obstruir uma janela da aplicação atual. Estão "
"disponíveis opções mais detalhadas."

#: Settings.ui.h:34
msgid "Intelligent autohide"
msgstr "Ocultação inteligente"

#: Settings.ui.h:35
msgid "Dock size limit"
msgstr "Limite do tamanho da doca"

#: Settings.ui.h:36
msgid "Panel mode: extend to the screen edge"
msgstr "Modo painel: expandir até ao limite do ecrã"

#: Settings.ui.h:38
msgid "Icon size limit"
msgstr "Limite do tamanho dos ícones"

#: Settings.ui.h:39
msgid "Fixed icon size: scroll to reveal other icons"
msgstr "Tamanho fixo dos ícones: deslizar para revelar outros ícones"

#: Settings.ui.h:40
msgid "Preview size scale"
msgstr "Pré-visualizar tamanho da escala"

#: Settings.ui.h:41
msgid "Position and size"
msgstr "Posição e dimensão"

#: prefs.js:242
msgid "Show favorite applications"
msgstr "Mostrar aplicações favoritas"

#: Settings.ui.h:43
msgid "Show running applications"
msgstr "Mostrar aplicações em execução"

#: Settings.ui.h:41
msgid "Isolate workspaces."
msgstr "Isolar áreas de trabalho."

#: Settings.ui.h:42
msgid "Show urgent windows despite current workspace."
msgstr "Mostrar janelas urgentes independente da área de trabalho."

#: Settings.ui.h:43
msgid "Isolate monitors."
msgstr "Isolar monitores."

#: Settings.ui.h:44
msgid "Show open windows previews."
msgstr "Mostrar antevisão das janelas abertas."

#: Settings.ui.h:48
msgid "Keep the focused application always visible in the dash"
msgstr "Manter a aplicação focada sempre visível no dash"

#: Settings.ui.h:49
msgid ""
"If disabled, these settings are accessible from gnome-tweak-tool or the "
"extension website."
msgstr ""
"Se desativadas, estas definições estão acessíveis através do gnome-tweak-"
"tool ou no site das extensões."

#: Settings.ui.h:50
msgid "Show <i>Applications</i> icon"
msgstr "Mostrar ícone das <i>Aplicações</i>"

#: Settings.ui.h:48
msgid "Move the applications button at the beginning of the dock."
msgstr "Mover o botão das aplicações para o início da doca."

#: Settings.ui.h:49
msgid "Animate <i>Show Applications</i>."
msgstr "Animar <i>Mostrar aplicações</i>."

#: Settings.ui.h:54
msgid "Show trash can"
msgstr "Mostrar caixote do lixo"

#: Settings.ui.h:55
msgid "Show volumes and devices"
msgstr "Mostrar volumes e dispositivos"

#: Settings.ui.h:56
msgid "Only if mounted"
msgstr "Apenas se montado"

#: Settings.ui.h:57
msgid "Include network volumes"
msgstr "Incluir volumes de rede"

#: Settings.ui.h:58
msgid "Isolate volumes, devices and trash windows from file manager"
msgstr ""
"Isolar janelas dos volumes, dos dispositivos e do caixote do lixo do gestor "
"de ficheiros"

#: Settings.ui.h:65
msgid "Launchers"
msgstr "Lançadores"

#: Settings.ui.h:66
msgid ""
"Enable Super+(0-9) as shortcuts to activate apps. It can also be used "
"together with Shift and Ctrl."
msgstr ""
"Usar Super+(0-9) como atalhos para as aplicações. Também pode ser usado com "
"Shift e Ctrl."

#: Settings.ui.h:67
msgid "Use keyboard shortcuts to activate apps"
msgstr "Usar atalhos de teclado para aplicações"

#: Settings.ui.h:68
msgid "Behaviour when clicking on the icon of a running application."
msgstr "Comportamento do clique no ícone de uma aplicação em execução."

#: Settings.ui.h:69
msgid "Click action"
msgstr "Ação do clique"

#: Settings.ui.h:70
msgid "Minimize"
msgstr "Minimizar"

#: Settings.ui.h:71
msgid "Behaviour when scrolling on the icon of an application."
msgstr "Comportamento do scroll no ícone de uma aplicação."

#: Settings.ui.h:72
msgid "Scroll action"
msgstr "Ação do scroll"

#: Settings.ui.h:73
msgid "Do nothing"
msgstr "Não fazer nada"

#: Settings.ui.h:74
msgid "Switch workspace"
msgstr "Alternar espaço de trabalho"

#: Settings.ui.h:75
msgid "Behavior"
msgstr "Comportamento"

#: Settings.ui.h:80
msgid ""
"Few customizations meant to integrate the dock with the default GNOME theme. "
"Alternatively, specific options can be enabled below."
msgstr ""
"Poucas personalizações destinadas a integrar o dock com o tema padrão do "
"GNOME. Alternativamente, opções específicas podem ser ativadas abaixo."

#: Settings.ui.h:81
msgid "Use built-in theme"
msgstr "Usar tema embutido"

#: Settings.ui.h:76
msgid "Save space reducing padding and border radius."
msgstr "Poupar espaço reduzindo o preenchimento e as bordas."

#: Settings.ui.h:77
msgid "Shrink the dash"
msgstr "Encolher o painel"

#: Settings.ui.h:82
msgid "Customize windows counter indicators"
msgstr "Mostrar indicador com contagem de janelas"

#: Settings.ui.h:83
msgid "Default"
msgstr "Predefinição"

#: Settings.ui.h:84
msgid "Dots"
msgstr "Pontos"

#: Settings.ui.h:85
msgid "Squares"
msgstr "Quadrados"

#: Settings.ui.h:86
msgid "Dashes"
msgstr "Linhas"

#: Settings.ui.h:87
msgid "Segmented"
msgstr "Segmentado"

#: Settings.ui.h:88
msgid "Solid"
msgstr "Sólido"

#: Settings.ui.h:89
msgid "Ciliora"
msgstr "Ciliora"

#: Settings.ui.h:90
msgid "Metro"
msgstr "Metro"

#: Settings.ui.h:92
msgid "Set the background color for the dash."
msgstr "Definir a cor de fundo do painel."

#: Settings.ui.h:93
msgid "Customize the dash color"
msgstr "Personalize a cor do traço"

#: Settings.ui.h:94
msgid "Tune the dash background opacity."
msgstr "Afinar a cor de fundo do painel."

#: Settings.ui.h:96
msgid "Fixed"
msgstr "Fixo"

#: Settings.ui.h:97
msgid "Dynamic"
msgstr "Dinâmico"

#: Settings.ui.h:98
msgid "Opacity"
msgstr "Opacidade"

#: Settings.ui.h:78
msgid "Force straight corner"
msgstr "Forçar esquina quadrada"

#: Settings.ui.h:79
msgid "Show overview on startup"
msgstr "Mostrar visão geral no início"

#: Settings.ui.h:99
msgid "Appearance"
msgstr "Aparência"

#: Settings.ui.h:100
msgid "version: "
msgstr "versão: "

#: Settings.ui.h:101
msgid "Moves the dash out of the overview transforming it in a dock"
msgstr "Retira o painel da vista de Atividades, tornando-o numa doca"

#: Settings.ui.h:102
msgid "Created by"
msgstr "Criado por"

#: Settings.ui.h:103
msgid "Webpage"
msgstr "Página web"

