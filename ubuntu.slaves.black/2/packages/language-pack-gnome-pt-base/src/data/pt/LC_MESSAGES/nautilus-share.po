#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"O Nautilus precisa de adicionar algumas permissões à sua pasta \"%s\" de "
"forma a poder partilhá-la"

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"A pasta \"%s\" precisa das seguintes permissões adicionais para poder ser "
"partilhada:\n"
"%s%s%sDeseja que o Nautilus adicione estas permissões à pasta "
"automaticamente?"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - permissões de leitura por outros\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - permissões de escrita por outros\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - permissões de execução por outros\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "Adicionar as permissões automaticamente"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "Não foi possível alterar as permissões da pasta \"%s\""

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "O nome de partilha é demasiado longo"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "O nome de partilha não pode estar vazio"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr "Erro ao obter informação de partilha: %s"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "Existe outra partilha com o mesmo nome"

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "_Alterar a partilha"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "_Criar uma partilha"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "Instalação do serviço de partilha falhou."

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr ""
"A instalação do serviço de partilha falhou. Gostaria de tentar novamente?"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "Tentar novamente"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "O serviço de partilha não está instalado"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"Tem de instalar o serviço de partilha de redes Windows para partilhar as "
"suas pastas."

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "Instalar serviço"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr "Ocorreu um erro ao obter a informação de partilha"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "Partilha na rede local"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "Partilha de pastas"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "Partilhar esta pasta"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "%s %s %s devolveu o sinal %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s falhou por uma razão desconhecida"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "'net usershare' devolveu o erro %d: %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "'net usershare' devolveu o erro %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "o resultado de 'net usershare' não está codificado em UTF-8 válido"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "Falhou"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "testparm do Samba devolveu o sinal %d"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "testparm do Samba falhou por um motivo desconhecido"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "testparm do Samba devolveu o erro %d: %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "testparm do Samba devolveu o erro %d"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr ""
"Incapaz de remover a partilha do caminho %s: esse caminho não está partilhado"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"Não é possível alterar o caminho de uma partilha existente; remova primeiro "
"a partilha antiga e depois adicione uma nova"

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>Partilha de pastas</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "_Nome da partilha:"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "Partil_har esta pasta"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "Co_mentário:"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr ""
"_Permitir a criação e remoção de ficheiros nesta pasta por parte dos outros"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr ""
"_Acesso de convidado (para pessoas que não tenham uma conta de utilizador)"
