#, c-format
#| msgid ""
#| "Confirm the Bluetooth PIN for '%s'. This can usually be found in the "
#| "device's manual."
msgid ""
"Confirm the Bluetooth PIN for “%s”. This can usually be found in the "
"device’s manual."
msgstr ""
"Confirme o PIN do Bluetooth para \"%s\". Pode ser encontrado no manual do "
"dispositivo."

