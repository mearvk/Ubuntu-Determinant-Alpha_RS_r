#, c-format
#| msgid ""
#| "Please confirm that the following PIN matches the one displayed on '%s'."
msgid ""
"Please confirm that the following PIN matches the one displayed on “%s”."
msgstr "Confirme se o PIN seguinte corresponde ao mostrado em \"%s\"."

