#, c-format
#| msgid "'%s' wants to connect with this device. Do you want to allow it?"
msgid "“%s” wants to connect with this device. Do you want to allow it?"
msgstr ""
"\"%s\" quer emparelhar com este dispositivo. Permitir o emparelhamento?"

