msgstr "Nome"

#: data/app.gschema.xml.in:151
msgid "The name of the external drive."
msgstr "O nome da unidade externa."

#: data/app.gschema.xml.in:155
msgid "Icon"
msgstr "Ícone"

#: data/app.gschema.xml.in:156
msgid "The icon of the external drive, as a serialized GIcon."
msgstr "O ícone do disco externo, como um GIcon de série."

#: data/app.gschema.xml.in:161
msgid ""
"The folder hierarchy where backups are stored. Paths are relative to the "
"drive."
msgstr ""
"A hierarquia das pastas onde as cópias de segurança são gravadas. Os "
"caminhos são relativos ao disco."

#: data/app.gschema.xml.in:168
msgid "The server address"
msgstr "O endereço do servidor"

#: data/app.gschema.xml.in:169
msgid "The URI of the remote server location."
msgstr "O URI do servidor remoto."

#: data/app.gschema.xml.in:174
msgid ""
"The folder hierarchy where backups are stored. Paths can be absolute or "
"relative to the host."
msgstr ""
"A hierarquia das pastas onde as cópias de segurança são gravadas. Os "
"caminhos que podem ser absolutos ou relativos ao sistema anfitrião."

#: data/org.gnome.DejaDup.gschema.xml.in:192
msgid ""
"The folder path where backups are stored. Paths can be absolute or relative "
"to the host."
msgstr ""
"O caminho da pasta onde as cópias de segurança são gravadas. Os caminhos que "
"podem ser absolutos ou relativos ao sistema anfitrião."

