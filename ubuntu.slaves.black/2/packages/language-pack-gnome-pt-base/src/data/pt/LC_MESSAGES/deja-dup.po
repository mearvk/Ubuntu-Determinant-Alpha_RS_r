#: libdeja/duplicity/DuplicityPlugin.vala:55
#, c-format
msgid ""
"Backups requires at least version %d.%d.%.2d of duplicity, but only found "
"version %d.%d.%.2d"
msgstr ""
"Cópias de segurança requere pelo menos a última versão %d.%d.%.2d de "
"duplicity, mas só foi encontrada a verão %d.%d.%.2d"

#: monitor/ReadyWatcher.vala:165
msgid ""
"Backup will begin when an unmetered network connection becomes available."
msgstr ""
"A cópia de segurança começará quando estiver disponível uma ligação de rede "
"sem limite de trafego."
