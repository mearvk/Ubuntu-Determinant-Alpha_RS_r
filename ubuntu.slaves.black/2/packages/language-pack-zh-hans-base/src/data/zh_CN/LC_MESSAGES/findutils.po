msgstr "错误: 格式指令‘%%%c’是留给将来使用的。"

#: find/print.c:406
#, c-format
msgid ""
"warning: format directive `%%%c' should be followed by another character"
msgstr "警告: 格式命令 `%%%c' 应该后跟另一个字符"

#: find/print.c:414
#, c-format
