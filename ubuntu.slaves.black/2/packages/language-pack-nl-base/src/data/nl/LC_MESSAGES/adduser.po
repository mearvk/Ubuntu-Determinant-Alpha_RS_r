msgid "Only one or two names allowed.\n"
msgstr "Er zijn maar één of twee namen toegestaan.\n"

#: ../adduser:197
msgid "Specify only one name in this mode.\n"
msgstr "Specificeer slechts één naam in deze modus.\n"

