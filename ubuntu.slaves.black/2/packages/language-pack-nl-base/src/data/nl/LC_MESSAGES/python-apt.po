#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Server voor %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Hoofdserver"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Aangepaste servers"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Beschrijving voor ‘%s’ ontbreekt. Gelieve dit te melden."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr ""
"Ongeldige unicode in de beschrijving van '%s' (%s). Gelieve dit te melden."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Een overzicht van de wijzigingen is nog niet beschikbaar."

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"De lijst van veranderingen is nog niet beschikbaar\n"
"\n"
"Gebruik a.u.b. http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"totdat de veranderingen beschikbaar zijn, of probeer het later nog eens."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Kon de lijst met wijzigingen niet ophalen. \n"
"Controleer a.u.b. uw internetverbinding."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "De lijst van bestanden voor '%s' kon niet gelezen worden"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "De lijst van bestanden voor '%s' kon niet gelezen worden"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Afhankelijkheid is niet vervulbaar: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Conflicteert met het geïnstalleerde pakket '%s'"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Maakt het bestaande pakket '%(pkgname)s' stuk door afhankelijkheid "
"%(depname)s (%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Maakt het bestaande pakket '%(pkgname)s' stuk door conflict: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Maakt het bestaande pakket '%(pkgname)s' stuk die conflicteert: "
"'%(targetpkg)s'. Maar de '%(debfile)s biedt deze aan via: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Pakket heeft geen Architecture-veld"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Verkeerde architectuur ‘%s’ -- Voer dpkg --add-architecture uit om deze toe "
"te voegen en werk daarna bij"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Er is al een nieuwere versie geÃ¯nstalleerd"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Voldoen van alle vereisten is mislukt (defecte cache)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Kan '%s' niet installeren"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Automatisch uitgepakt:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Automatisch omgezet naar toonbare ASCII:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"Installeer de bouwevereisten voor het bronpakket '%s' waaruit '%s' wordt "
"gebouwd\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Er zou een essentieel pakket verwijderd worden"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Klaar"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Gevonden "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Genegeerd "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Fout "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Ophalen:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Bezig]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Medium wisselen: Gelieve de schijf met etiket\n"
" '%s'\n"
"in het station '%s' te plaatsen en op 'Enter' te drukken\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "%sB opgehaald in %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""
"Gelieve dit medium een naam te geven, bijvoorbeeld: 'Debian 2.1r1 Disk 1'"

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr "Gelieve een installatiemedium in te voeren en op enter te drukken"
