#: xen/xm/XenAPI.py:58
#, python-format
msgid "Internal error: %(1)s."
msgstr "Interne fout: %(1)s."

#: xen/xm/XenAPI.py:59
#, python-format
msgid "This map already contains %(1)s -> %(2)s."
msgstr "Deze map bevat reeds %(1)s -> %(2)s."

#: xen/xm/XenAPI.py:60
#, python-format
msgid "The method %(1)s is unsupported."
msgstr "De methode %(1)s wordt niet ondersteund."

#: xen/xm/XenAPI.py:61
#, python-format
msgid "The method %(1)s takes %(2)s argument(s) (%(3)s given)."
msgstr "De methode %(1)s vereist %(2)s argumenten. (%(3)s gegeven)."

#: xen/xm/XenAPI.py:62
msgid "Permission denied."
msgstr "Toestemming geweigerd."

#: xen/xm/XenAPI.py:63
#, python-format
msgid ""
"Value \"%(2)s\" for %(1)s is not supported by this server.  The server said "
"\"%(3)s\"."
msgstr ""
"Waarde \"%(2)s\" voor %(1)s wordt niet ondersteund door deze server. De "
"server meldde \"%(3)s\"."

#: xen/xm/XenAPI.py:64
#, python-format
msgid "The %(1)s handle %(2)s is invalid."
msgstr "De %(1)s handle %(2)s is ongeldig."

#: xen/xm/XenAPI.py:65
msgid "You attempted an operation that was not allowed."
msgstr "U probeerde een niet-toegestane handeling uit te voeren."

#: xen/xm/XenAPI.py:66
msgid ""
"The network you specified already has a PIF attached to it, and so another "
"one may not be attached."
msgstr ""
"Er is al een PIF op het door u opgegeven netwerk aangekoppeld, er mag daarom "
"geen andere aangekoppeld worden."

#: xen/xm/XenAPI.py:67
#, python-format
msgid "%(2)s"
msgstr "%(2)s"
