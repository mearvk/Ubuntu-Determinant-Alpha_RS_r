#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "%s हेतु सर्वर"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "मुख्य सर्वर"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "विनिर्मित सर्वर"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr ""

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "'%s' (%s) हेतु वर्णन में अवैध यूनीकोड. कृपया रिपोर्ट करें."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "परिवर्तन की सूची उपलब्ध नहीं है"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"परिवर्तन की सूची अभी उपलब्ध नहीं हैं.\n"
"\n"
"कृपया उपयोग करें http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"जब तक परिवर्तन उपलब्ध न हो या बाद में पुनः प्रयास करें."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"परिवर्तन की सूची डाउनलोड करने में असफल. \n"
"कृपया अपना अंतर्जाल संयोजन की जाँच करें."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "'%s' हेतु संचिक सूचीन नहीं पढ़ी जा सकी"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "'%s' के लिए नियंत्रण फ़ाइलों की सूची पढ़ा नहीं जा सकी"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "निर्भरता संतोषजनक नहीं है: %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "संस्थापित पैकेज '%s' के साथ विरोधाभास है"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"वर्तमान पैकेज को तोड़े '%(pkgname)s' निर्भरता %(depname)s (%(deprelation)s "
"%(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"वर्तमान पैकेज को तोड़े '%(pkgname)s' परस्पर-विरोधी: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"वर्तमान पैकेज को तोड़े '%(pkgname)s' जो परस्पर-विरोधी: '%(targetpkg)s'. "
"लेकिन '%(debfile)s' द्वारा प्रदत्त है: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "इस पैकेज में स्थापत्य क्षेत्र नहीं है"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "एक परवर्ति संस्करण पहले से संस्थापित है"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "सभी निर्भरता को संतुष्ट करने में असफल (खंडित कैची)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "'%s' संस्थापित नहीं हो सकता"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"स्वतः असंपिडित:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "स्वचालित छपाईयोग्य ascii में परिवर्तित:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr ""
"स्रोत पैकेज '%s' हेतु निर्मित-निर्भरता संस्थापित करे वह निर्मित %s है\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "एक आवश्यक पैकेज हटाया जा सकता है"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... पुरा हुआ"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "हिट "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "त्रुटि "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "प्राप्त करेंः"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [कार्यरत]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"मिडिया परिवर्तन: कृपया निम्न लेबल लगा डिस्क \n"
" '%s'\n"
"'%s' ड्राइव में लगाएं तथा इंटर दबाएं\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "उत्पन्न %sB को %s (%sB/s) में\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
