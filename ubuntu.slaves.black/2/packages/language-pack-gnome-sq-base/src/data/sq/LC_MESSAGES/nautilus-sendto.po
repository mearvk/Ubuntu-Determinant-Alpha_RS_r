msgstr "Arkivi"

#: src/nautilus-sendto.c:549
#, c-format
msgid "Could not parse command-line options: %s\n"
msgstr "Nuk mund t'i krahasojmë opsionet e rreshtit të komandave: %s\n"

#: src/nautilus-sendto.c:562
#, c-format
msgid "No mail client installed, not sending files\n"
msgstr "Klienti i email nuk është instaluar, nuk po dërgoj skedarët\n"

#: src/nautilus-sendto.c:568
#, c-format
msgid "Expects URIs or filenames to be passed as options\n"
msgstr "Pret që URI-të apo emrat e skedarëve të kalojnë si opsione\n"

