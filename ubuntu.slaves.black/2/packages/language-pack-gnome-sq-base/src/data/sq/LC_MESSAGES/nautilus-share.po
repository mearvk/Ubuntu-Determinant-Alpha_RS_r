#: src/nautilus-share.c:272
#, c-format
msgid ""
"Nautilus needs to add some permissions to your folder \"%s\" in order to "
"share it"
msgstr ""
"Nautilus duhet të shtoj disa të drejta në direktorinë tuaj \"%s\" në mënyrë "
"që ta shpërndaj atë"

#: src/nautilus-share.c:280
#, c-format
msgid ""
"The folder \"%s\" needs the following extra permissions for sharing to "
"work:\n"
"%s%s%sDo you want Nautilus to add these permissions to the folder "
"automatically?"
msgstr ""
"Direrktoria \"%s\" ka nevoj pët të drejtat ne vijim në mënyrë që shpërndarja "
"të funksionoj:\n"
"%s%s%sA dëshironi që Nautilus ti shtoj këto të drejta automatikisht mbi këtë "
"direktori?"

#: src/nautilus-share.c:284
msgid "  - read permission by others\n"
msgstr "  - leje leximi nga të tjerët\n"

#: src/nautilus-share.c:285
msgid "  - write permission by others\n"
msgstr "  - leje shkrimi nga të tjerët\n"

#: src/nautilus-share.c:286
msgid "  - execute permission by others\n"
msgstr "  - leje ekzekutimi nga të tjerët\n"

#: src/nautilus-share.c:290
msgid "Add the permissions automatically"
msgstr "Shto të drejtat automatikisht"

#: src/nautilus-share.c:326
#, c-format
msgid "Could not change the permissions of folder \"%s\""
msgstr "Nuk mund të ndryshoj të drejtat e direktoris \"%s\""

#: src/nautilus-share.c:566
msgid "Share name is too long"
msgstr "Emri i shpërndarjes është shumë i gjatë"

#: src/nautilus-share.c:605
msgid "The share name cannot be empty"
msgstr "Emri i shpërndarjes nuk mund të jetë bosh"

#: src/nautilus-share.c:618
#, c-format
msgid "Error while getting share information: %s"
msgstr "Gabim gjatë marrjes së informacionit të shpërndarjes: %s"

#: src/nautilus-share.c:628
msgid "Another share has the same name"
msgstr "Një shpërndarje tjetër ka të njëjtin emër"

#: src/nautilus-share.c:675 src/nautilus-share.c:912
msgid "Modify _Share"
msgstr "Ndrysho shpërndarjen"

#: src/nautilus-share.c:675 src/nautilus-share.c:914
msgid "Create _Share"
msgstr "Krijo _Shpërndarje"

#: ../src/nautilus-share.c:715
msgid "Sharing service installation failed"
msgstr "Instalimi i shërbimit të shpërndarjes dështoi"

#: ../src/nautilus-share.c:718
msgid ""
"Sharing service installation has failed. Would you like to retry the "
"installation?"
msgstr ""
"Instalimi i shërbimit të shpërndarjes dështoi. Dëshironi ta riprovoni "
"instalimin?"

#: ../src/nautilus-share.c:721
msgid "Retry"
msgstr "Riprovo"

#: ../src/nautilus-share.c:759
msgid "Sharing service is not installed"
msgstr "Shërbimi i shpërndarjes nuk është instaluar"

#: ../src/nautilus-share.c:761
msgid ""
"You need to install the Windows networks sharing service in order to share "
"your folders."
msgstr ""
"Ju nevojitet të instaloni shërbimin e shpërndarjes së rrjetit të Windows në "
"mënyrë që të shpërndanii dosjet tuaja."

#: ../src/nautilus-share.c:763
msgid "Install service"
msgstr "Instalo shërbimin"

#: src/nautilus-share.c:803
msgid "There was an error while getting the sharing information"
msgstr "Pati një gabim gjatë marrjes së informacionit të shpërndarjes"

#: ../src/nautilus-share.c:1270 ../src/nautilus-share.c:1371
msgid "Local Network Share"
msgstr "Shpërndarje në Rrjetin Lokal"

#: src/nautilus-share.c:1247
msgid "Folder Sharing"
msgstr "Shpërndarja e Dosjeve"

#: src/nautilus-share.c:1296
msgid "Share this Folder"
msgstr "Shpërndaje këtë dosje"

#: src/shares.c:125
#, c-format
msgid "%s %s %s returned with signal %d"
msgstr "%s %s %s u kthye me sinjalin %d"

#: src/shares.c:134
#, c-format
msgid "%s %s %s failed for an unknown reason"
msgstr "%s %s %s dështoi për arsye të panjohur"

#: src/shares.c:154
#, c-format
msgid "'net usershare' returned error %d: %s"
msgstr "'net usershare' ktheu gabim %d: %s"

#: src/shares.c:156
#, c-format
msgid "'net usershare' returned error %d"
msgstr "'net usershare' riktheu gabimin %d"

#: src/shares.c:187
#, c-format
msgid "the output of 'net usershare' is not in valid UTF-8 encoding"
msgstr "dalja e 'net usershare' nuk është në kodimin e vlefshëm UTF-8"

#: src/shares.c:442 src/shares.c:616
#, c-format
msgid "Failed"
msgstr "Dështoi"

#: src/shares.c:550
#, c-format
msgid "Samba's testparm returned with signal %d"
msgstr "Samba's testparm u kthye me sinjalin %d"

#: src/shares.c:556
#, c-format
msgid "Samba's testparm failed for an unknown reason"
msgstr "Samba testparm dështoi për një arsye të panjohur"

#: src/shares.c:571
#, c-format
msgid "Samba's testparm returned error %d: %s"
msgstr "Samba testparm ktheu gabimin %d: %s"

#: src/shares.c:573
#, c-format
msgid "Samba's testparm returned error %d"
msgstr "Samba testparm ktheu gabimin %d"

#: src/shares.c:684
#, c-format
msgid "Cannot remove the share for path %s: that path is not shared"
msgstr ""
"Nuk mund ta heq shpërndarjen për shtegun %s: ky shteg nuk është i shpërndarë"

#: src/shares.c:730
#, c-format
msgid ""
"Cannot change the path of an existing share; please remove the old share "
"first and add a new one"
msgstr ""
"Nuk mund ta ndryshoj shtegun e një shpërndarjeje ekzistuese, ju lutemi ta "
"hoqni së pari shpërndarjen e vjetër dhe të shtoni një të re"

#: interfaces/share-dialog.ui:27
msgid "<big><b>Folder Sharing</b></big>"
msgstr "<big><b>Shpërndarje e Dosjeve</b></big>"

#: interfaces/share-dialog.ui:75
msgid "Share _name:"
msgstr "_Emri i shpërndarjes:"

#: interfaces/share-dialog.ui:108
msgid "Share this _folder"
msgstr "Shpërndaje këtë _dosje"

#: interfaces/share-dialog.ui:139
msgid "Co_mment:"
msgstr "Ko_ment:"

#: interfaces/share-dialog.ui:170
msgid "_Allow others to create and delete files in this folder"
msgstr "_Lejo të tjerët që të krijojnë dhe fshijnë skedarë në këtë dosje"

#: interfaces/share-dialog.ui:187
msgid "_Guest access (for people without a user account)"
msgstr "Hyrje _të ftuari (për njerëz pa një llogari përdoruesi)"
