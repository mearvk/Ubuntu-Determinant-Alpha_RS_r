msgid "Click-type window style"
msgstr "Stili i llojit të dritares me klikim"

#: data/org.gnome.mousetweaks.gschema.xml:6
msgid "Button style of the click-type window."
msgstr "Stili i butonit të llojit të dritares me klikim."

#: data/org.gnome.mousetweaks.gschema.xml:10
msgid "Click-type window orientation"
msgstr "Orientimi i llojit të dritares me klikim"

#: data/org.gnome.mousetweaks.gschema.xml:11
msgid "Orientation of the click-type window."
msgstr "Orientimi i LLojit të dritares me klikim."

#: data/org.gnome.mousetweaks.gschema.xml:15 src/mt-main.c:638
msgid "Click-type window geometry"
msgstr "Gjeometria e llojit të dritares me klikim"

#: data/org.gnome.mousetweaks.gschema.xml:16
msgid ""
"Size and position of the click-type window. The format is a standard X "
"Window System geometry string."
msgstr ""
"Përmasa dhe pozicioni i llojit të dritares me klikim. Formati është një "
"shirit standart i gjeometrisë së Sistemit X të Dritareve."

#: src/mt-main.c:624
msgid "Enable dwell click"
msgstr "Aktivizo klik automatik"

#: src/mt-main.c:626
msgid "Enable simulated secondary click"
msgstr "Aktivizon klik dytësor të simuluar"

#: src/mt-main.c:628
msgid "Time to wait before a dwell click"
msgstr "Koha e pritjes para një klikimi automatik"

#: src/mt-main.c:630
msgid "Time to wait before a simulated secondary click"
msgstr "Koha e pritjes para një klikimi dytësor të simuluar"

#: src/mt-main.c:632
msgid "Set the active dwell mode"
msgstr "Vendos mënyrën aktive të zhytjes"

#: src/mt-main.c:634
msgid "Hide the click-type window"
msgstr "Fshihe dritaren e klikimit për të shtypur"

#: src/mt-main.c:636
msgid "Ignore small pointer movements"
msgstr "Shpërfill lëvizje të vogla të mouse"

#: src/mt-main.c:640
msgid "Shut down mousetweaks"
msgstr "Ndalo mousetweaks"

#: src/mt-main.c:642
msgid "Start mousetweaks as a daemon"
msgstr "Nis rregullimet e miut si një daemon"

#: src/mt-main.c:644
msgid "Start mousetweaks in login mode"
msgstr "Nis rregullimet e miut në mënyrën e hyrjes"

