#. Both taken from the desktop file.
#: data/org.gnome.Cheese.appdata.xml.in:9 data/org.gnome.Cheese.desktop.in:3
#: src/cheese-application.vala:116 src/cheese-application.vala:582
msgid "Cheese"
msgstr "Cheese"

#: data/org.gnome.Cheese.appdata.xml.in:10 data/org.gnome.Cheese.desktop.in:5
#: src/cheese-application.vala:577
msgid "Take photos and videos with your webcam, with fun graphical effects"
msgstr ""
"Bëj foto dhe regjistro video me kamerën tënde web, me efekte të këndshme "
"grafike."

#: data/org.gnome.Cheese.appdata.xml.in:12
msgid ""
"Cheese uses your webcam to take photos and videos, applies fancy special "
"effects and lets you share the fun with others."
msgstr ""
"Cheese përdor kamerën tënde për të kapur foto dhe video, vendos efekte të "
"bukura sepciale dhe ju lë që ta ndani kënaqësinë me të tjerët."

#: data/org.gnome.Cheese.appdata.xml.in:16
msgid ""
"Take multiple photos in quick succession with burst mode. Use the countdown "
"to give yourself time to strike a pose, and wait for the flash!"
msgstr ""
"Bëni shumë foto njëra pas tjetrës me mënyrën e njëpasnjëshme. Përdorni "
"numërimin mbrapsht që ti jepni vetes kohë për të bërë një pozë dhe prit për "
"flash!"

#: data/org.gnome.Cheese.appdata.xml.in:21
msgid ""
"Under the hood, Cheese uses GStreamer to apply fancy effects to photos and "
"videos. With Cheese it is easy to take photos of you, your friends, pets or "
"whatever you want and share them with others."
msgstr ""
"Nën sfond, Cheese përdor GStreamer për të aplikuar efekte të bukura tek "
"fotot dhe videot. Me Cheese e keni të lehtë të kapni fotot tuaja, të "
"shokëve, kafshëve apo të çdo gjëje që doni dhe ti ndani ato me të tjerët."

#: data/org.gnome.Cheese.desktop.in:4
msgid "Webcam Booth"
msgstr "Vendi i Webcam"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.Cheese.desktop.in:7
msgid "photo;video;webcam;camera;selfie;"
msgstr ""

#: data/org.gnome.Cheese.gschema.xml:5
msgid "Use a countdown"
msgstr "Përdor një numërim në zbritje"

#: data/org.gnome.Cheese.gschema.xml:6
msgid "Set to true to show a countdown before taking a photo"
msgstr ""
"Nëse vendoset tek e vërtetë do të shfaqë numërimin mbrapsht para se të "
"shkrepë një foto"

#: data/org.gnome.Cheese.gschema.xml:11
msgid "Countdown length"
msgstr "Kohëzgjatja e numërimit mbrapsht"

#: data/org.gnome.Cheese.gschema.xml:12
msgid "The duration of the countdown before taking a photo, in seconds"
msgstr ""
"Kohëzgjatja e numërimit mbrapsht para shkrepjes së një fotoje, në sekonda"

#: data/org.gnome.Cheese.gschema.xml:18
msgid "Fire flash before taking a photo"
msgstr "Ndiz flash para kapjes së një fotoje"

#: data/org.gnome.Cheese.gschema.xml:19
msgid "Set to true to fire a flash before taking a photo"
msgstr ""
"Nëse vendoset tek e vërtetë flash do të ndizet para shkrepjes së një fotoje"

#: data/org.gnome.Cheese.gschema.xml:24
msgid "Camera device string indicator"
msgstr "Treguesi i serisë së pajisjes kamera"

#: data/org.gnome.Cheese.gschema.xml:25
msgid ""
"The path to the device node which points to the camera, for example "
"/dev/video0"
msgstr "Shtegu tek nyja që të çon drejt kamerës, përshembull /dev/video0"

#: data/org.gnome.Cheese.gschema.xml:30
msgid "Last selected effect"
msgstr "Efekti i fundit i zgjedhur"

#: data/org.gnome.Cheese.gschema.xml:31
msgid "Name of the installed effect that was selected last"
msgstr "Emri i efektit të instaluar që u zgjodh herën e fundit"

#: data/org.gnome.Cheese.gschema.xml:36
msgid "Photo width"
msgstr "Gjerësia e fotos"

#: data/org.gnome.Cheese.gschema.xml:37
msgid "The width of the image captured from the camera, in pixels"
msgstr "Gjerësia e imazhit të kapur nga kamera, në pixel"

#: data/org.gnome.Cheese.gschema.xml:43
msgid "Photo height"
msgstr "Lartësia e fotos"

#: data/org.gnome.Cheese.gschema.xml:44
msgid "The height of the image captured from the camera, in pixels"
msgstr "Lartësia e imazhit të kapur nga kamera, në pixel"

#: data/org.gnome.Cheese.gschema.xml:50
msgid "Video width"
msgstr "Gjerësia e videos"

#: data/org.gnome.Cheese.gschema.xml:51
msgid "The width of the video captured from the camera, in pixels"
msgstr "Gjerësia e videos të kapur nga kamera, në pixel"

#: data/org.gnome.Cheese.gschema.xml:57
msgid "Video height"
msgstr "Lartësia e videos"

#: data/org.gnome.Cheese.gschema.xml:58
msgid "The height of the video captured from the camera, in pixels"
msgstr "Lartësia e videos të kapur nga kamera, në pixel"

#: data/org.gnome.Cheese.gschema.xml:64
msgid "Image brightness"
msgstr "Ndriçimi i imazhit"

#: data/org.gnome.Cheese.gschema.xml:65
msgid "Adjusts the brightness of the image coming from the camera"
msgstr "Rregullon ndriçimin e imazhit që vjen nga kamera"

#: data/org.gnome.Cheese.gschema.xml:71
msgid "Image contrast"
msgstr "Kontrasti i imazhit"

#: data/org.gnome.Cheese.gschema.xml:72
msgid "Adjusts the contrast of the image coming from the camera"
msgstr "Rregullon kontrastin e imazhit që vjen nga kamera"

#: data/org.gnome.Cheese.gschema.xml:78
msgid "Image saturation"
msgstr "Ngopja e imazhit"

#: data/org.gnome.Cheese.gschema.xml:79
msgid "Adjusts the saturation of the image coming from the camera"
msgstr "Rregullon ngopjen e imazhit që vjen nga kamera"

#: data/org.gnome.Cheese.gschema.xml:85
msgid "Image hue"
msgstr "Ngjyrimi i imazhit"

#: data/org.gnome.Cheese.gschema.xml:86
msgid "Adjusts the hue (color tint) of the image coming from the camera"
msgstr ""
"Rregullon ngjyrimin (thellësinë e ngjyrave) të imazhit që vjen nga kamera"

#: data/org.gnome.Cheese.gschema.xml:92
msgid "Video path"
msgstr "Shtegu i videos"

#: data/org.gnome.Cheese.gschema.xml:93
msgid ""
"Defines the path where the videos are stored. If empty, "
"“XDG_VIDEOS_DIR/Webcam” will be used."
msgstr ""
"Përkufizon shtegun ku ruhen videot. Nëse është i zbrazët do të përdoret "
"“XDG_VIDEOS_DIR/Webcam”."

#: data/org.gnome.Cheese.gschema.xml:98
msgid "Photo path"
msgstr "Shtegu i fotos"

#: data/org.gnome.Cheese.gschema.xml:99
msgid ""
"Defines the path where the photos are stored. If empty, "
"“XDG_PICTURES_DIR/Webcam” will be used."
msgstr ""
"Përkufizon shtegun ku ruhen fotot. Nëse është i zbrazët do të përdoret "
"“XDG_PICTURES_DIR/Webcam”."

#: data/org.gnome.Cheese.gschema.xml:104
msgid "Time between photos in burst mode"
msgstr "Koha midis fotove në shkrepje të njëpasnjëshme"

#: data/org.gnome.Cheese.gschema.xml:105
msgid ""
"The length of time, in milliseconds, to delay between taking each photo in a "
"burst sequence of photos. If the burst delay is less than the countdown "
"duration, the countdown duration will be used instead."
msgstr ""
"Gjatësia e kohës, në milisekonda, e vonesës midis fotove që kapen në një "
"grup fotosh. Nëse kohëzgjatja e vonesës është më pak se kohëzgjatja e "
"numërimit mbrapsht, do të përdoret kohëzgjatja e numërimit mbrapsht."

#: data/org.gnome.Cheese.gschema.xml:111
msgid "Number of photos in burst mode"
msgstr "Numri i fotove në shkrepje të njëpasnjëshme"

#: data/org.gnome.Cheese.gschema.xml:112
msgid "The number of photos to take in a single burst."
msgstr "Numri i fotove që do shkrepen njëherësh."

