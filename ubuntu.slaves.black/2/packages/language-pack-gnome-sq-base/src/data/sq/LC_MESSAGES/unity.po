#: ../plugins/unity-mt-grab-handles/unitymtgrabhandles.xml.in.h:7
msgid "Hide Handles"
msgstr "Fshihi Mbartësit"

#: ../plugins/unity-mt-grab-handles/unitymtgrabhandles.xml.in.h:8
