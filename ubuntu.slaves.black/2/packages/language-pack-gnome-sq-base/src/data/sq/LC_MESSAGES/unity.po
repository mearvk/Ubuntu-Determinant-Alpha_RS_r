#: ../shutdown/SessionView.cpp:165 ../shutdown/SessionButton.cpp:63
msgid "Log Out"
msgstr "Dil"

#: ../shutdown/SessionView.cpp:170
#, c-format
msgid ""
"Hi %s, you have open files that you might want to save before logging out. "
"Are you sure you want to continue?"
msgstr ""
"Përshëndetje %s, ke disa skedarë të hapur që mund të dëshirosh të ruash para "
"se të dalësh. A je i sigurt që dëshiron të vazhdosh?"

#: ../shutdown/SessionView.cpp:175
#, c-format
msgid ""
"Goodbye, %s. Are you sure you want to close all programs and log out from "
"your account?"
msgstr ""
"Mirupafshim, %s. A je i sigurt që dëshiron të mbyllësh të gjitha programet "
"dhe të dalësh nga llogaria juaj?"

#. We have enough buttons to show the message without a new line.
#: ../shutdown/SessionView.cpp:193
#, c-format
msgid "Hi %s, you have open files you might want to save. Would you like to…"
msgstr ""
"Përshëndetje %s, ke skedarë të hapur që mund të dëshirosh të ruash. A do të "
"doje të..."

#: ../shutdown/SessionView.cpp:198
#, c-format
msgid ""
"Hi %s, you have open files you might want to save.\n"
"Would you like to…"
msgstr ""
"Përshendetje %s, ju keni lënë hapur skedare që mund të dëshironi të ruani.\n"
"A do të donit të..."

#: ../shutdown/SessionView.cpp:204
#, c-format
msgid "Goodbye, %s. Would you like to…"
msgstr "Mirupafshim, %s. A do të donit të..."

