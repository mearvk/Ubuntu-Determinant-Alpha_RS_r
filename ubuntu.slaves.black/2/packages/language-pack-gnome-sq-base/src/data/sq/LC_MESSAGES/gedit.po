#: gedit/gedit-io-error-info-bar.c:164 gedit/gedit-io-error-info-bar.c:204
#: gedit/gedit-io-error-info-bar.c:211
msgid "Please check that you typed the location correctly and try again."
msgstr "Kontrolloni që keni shkruar si duhet pozicionin dhe provoni përsëri."

#. Translators: %s is a URI scheme (like for example http:, ftp:, etc.)
#: gedit/gedit-io-error-info-bar.c:183
#, c-format
msgid "Unable to handle “%s:” locations."
msgstr "Nuk munda të gjej vendndodhjet e “%s:”."

#: gedit/gedit-io-error-info-bar.c:189
msgid "Unable to handle this location."
msgstr "Nuk jam në gjendje të gjej këtë vendndodhje."

#: gedit/gedit-io-error-info-bar.c:198
msgid "The location of the file cannot be accessed."
msgstr "Vendndodhja e skedarit nuk mund të gjendet."

#: gedit/gedit-io-error-info-bar.c:202
#, c-format
msgid "“%s” is a directory."
msgstr "“%s” është një drejtori."

#: gedit/gedit-io-error-info-bar.c:209
#, c-format
msgid "“%s” is not a valid location."
msgstr "“%s” nuk është një vendndodhje e vlefshme."

#. Translators: %s is a host name
#: gedit/gedit-io-error-info-bar.c:245
#, c-format
msgid ""
"Host “%s” could not be found. Please check that your proxy settings are "
"correct and try again."
msgstr ""
"Mbartësi \"%s\" nuk mund të gjendet. Ju lutemi të kontrolloni nëse i keni në "
"rregull parametrat e proksit dhe ta provoni përsëri."

#: gedit/gedit-io-error-info-bar.c:260
#, c-format
msgid ""
"Hostname was invalid. Please check that you typed the location correctly and "
"try again."
msgstr ""
"Emri i mbartësit ishte i pavlefshëm. Ju lutemi të kontrolloni që ju e "
"shtypët vendndodhjen siç duhet dhe provojeni përsëri."

#: gedit/gedit-io-error-info-bar.c:268
#, c-format
msgid "“%s” is not a regular file."
msgstr "“%s” nuk është një skedar i rregullt."

#: gedit/gedit-io-error-info-bar.c:273
msgid "Connection timed out. Please try again."
msgstr "Koha për lidhjen skadoi. Provo edhe njëherë."

#: gedit/gedit-io-error-info-bar.c:306
#, c-format
msgid "Unexpected error: %s"
msgstr "Gabim i papritur: %s"

#: gedit/gedit-io-error-info-bar.c:342
msgid "Cannot find the requested file. Perhaps it has recently been deleted."
msgstr ""
"Nuk munda ta gjej skedarin e kërkuar. Ndoshta është fshirë së fundmi."

#: gedit/gedit-io-error-info-bar.c:352
#, c-format
msgid "Could not revert the file “%s”."
msgstr "Nuk munda ta rikthej skedarin “%s”."

#: gedit/gedit-io-error-info-bar.c:379
msgid "Ch_aracter Encoding:"
msgstr "Kodimi i Gë_rmave:"

#: gedit/gedit-io-error-info-bar.c:451
msgid "_Continue loading"
msgstr ""

#. Translators: the access key chosen for this string should be
#. different from other main menu access keys (Open, Edit, View...)
#: gedit/gedit-io-error-info-bar.c:487 gedit/gedit-io-error-info-bar.c:745
msgid "Edit Any_way"
msgstr "Modifikoje Gji_thësesi"

#: gedit/gedit-io-error-info-bar.c:553
msgid ""
"The number of followed links is limited and the actual file could not be "
"found within this limit."
msgstr ""
"Numri i lidhjeve të ndjekuar është i kufizuar dhe file aktual nuk mund të "
"gjehet me kufirin e përcaktuar."

#: gedit/gedit-io-error-info-bar.c:557
msgid "You do not have the permissions necessary to open the file."
msgstr "Nuk të drejtat e duhura për të hapur atë file."

#: gedit/gedit-io-error-info-bar.c:563
msgid "Unable to detect the character encoding."
msgstr "Nuk munda të dalloj kodimin e karaktereve."

#: gedit/gedit-io-error-info-bar.c:564 gedit/gedit-io-error-info-bar.c:588
msgid "Please check that you are not trying to open a binary file."
msgstr "Kontrollo që nuk po mundohesh të hapësh një file binar."

#: gedit/gedit-io-error-info-bar.c:565
msgid "Select a character encoding from the menu and try again."
msgstr "Zgjidh një kodim të gërmave nga menuja dhe provoje përsëri."

#: gedit/gedit-io-error-info-bar.c:571
#, c-format
msgid "There was a problem opening the file “%s”."
msgstr "Pati një problem në hapjen e skedarit “%s”."

#: gedit/gedit-io-error-info-bar.c:573
msgid ""
"The file you opened has some invalid characters. If you continue editing "
"this file you could corrupt this document."
msgstr ""
"Skedari që ju hapët ka disa gërma të pavlefshme. Nëse vazhdoni ta modifikoni "
"këtë skedar ju mund ta korruptoni këtë dokument."

#: gedit/gedit-io-error-info-bar.c:576
msgid "You can also choose another character encoding and try again."
msgstr ""
"Ju mund të zgjidhni gjithashtu një kodim tjetër të gërmave dhe ta provoni "
"përsëri."

#: gedit/gedit-io-error-info-bar.c:585
#, c-format
msgid "Could not open the file “%s” using the “%s” character encoding."
msgstr ""
"Nuk munda të hap skedarin “%s” duke përdorur kodimin e karaktereve “%s”."

#: gedit/gedit-io-error-info-bar.c:589 gedit/gedit-io-error-info-bar.c:679
msgid "Select a different character encoding from the menu and try again."
msgstr ""
"Zgjidh një kodim të ndryshëm të gërmave nga menuja e kodimit dhe provoje "
"përsëri."

#: gedit/gedit-io-error-info-bar.c:597
#, c-format
msgid "The file “%s” is very big."
msgstr ""

#: gedit/gedit-io-error-info-bar.c:599
msgid ""
"Large files can make gedit slow or unresponsive. You can continue loading "
"this file at your own risk"
msgstr ""

#: gedit/gedit-io-error-info-bar.c:611
#, c-format
msgid "Could not open the file “%s”."
msgstr "Nuk munda të hap skedarin \"%s\"."

#: gedit/gedit-io-error-info-bar.c:674
#, c-format
msgid "Could not save the file “%s” using the “%s” character encoding."
msgstr ""
"Nuk munda ta ruaj skedarin “%s” duke përdorur kodimin e karaktereve “%s”."

#: gedit/gedit-io-error-info-bar.c:677
msgid ""
"The document contains one or more characters that cannot be encoded using "
"the specified character encoding."
msgstr ""
"Dokumenti përmban një apo më tepër gërma që nuk und të kodohen duke përdorur "
"kodimin e specifikuar të gërmave."

#. Translators: the access key chosen for this string should be
#. different from other main menu access keys (Open, Edit, View...)
#: gedit/gedit-io-error-info-bar.c:750
msgid "D_on’t Edit"
msgstr ""

#: gedit/gedit-io-error-info-bar.c:760
#, c-format
msgid "This file “%s” is already open in another window."
msgstr "Skedari “%s” është hapur tashmë në një dritare tjetër."

#: gedit/gedit-io-error-info-bar.c:774
msgid "Do you want to edit it anyway?"
msgstr "Dëshironi ta modifikoni gjithësesi?"

#: gedit/gedit-io-error-info-bar.c:830 gedit/gedit-io-error-info-bar.c:920
#: gedit/gedit-io-error-info-bar.c:1210
msgid "S_ave Anyway"
msgstr "Ru_aj sidoqoftë"

#: gedit/gedit-io-error-info-bar.c:833 gedit/gedit-io-error-info-bar.c:923
#: gedit/gedit-io-error-info-bar.c:1213
msgid "D_on’t Save"
msgstr ""

#. FIXME: review this message, it's not clear since for the user the "modification"
#. * could be interpreted as the changes he made in the document. beside "reading" is
#. * not accurate (since last load/save)
#. 
#: gedit/gedit-io-error-info-bar.c:847
#, c-format
msgid "The file “%s” has been modified since reading it."
msgstr "Skedari “%s” është modifikuar që nga leximi i tij."

#: gedit/gedit-io-error-info-bar.c:862
msgid ""
"If you save it, all the external changes could be lost. Save it anyway?"
msgstr ""
"Nëse e ruani, të gjitha ndryshimet e jashtme do të humbasin. Ruan sidoqoftë?"

#: gedit/gedit-io-error-info-bar.c:942
#, c-format
msgid "Could not create a backup file while saving “%s”"
msgstr "Nuk munda të krijoj një skedar mbështetës ndërkohë që po ruaj “%s”"

#: gedit/gedit-io-error-info-bar.c:947
#, c-format
msgid "Could not create a temporary backup file while saving “%s”"
msgstr ""
"Nuk munda të krijoj një skedar të përkohshëm mbështetës ndërkohë që po ruaj "
"“%s”"

#: gedit/gedit-io-error-info-bar.c:964
msgid ""
"Could not back up the old copy of the file before saving the new one. You "
"can ignore this warning and save the file anyway, but if an error occurs "
"while saving, you could lose the old copy of the file. Save anyway?"
msgstr ""
"Nuk munda ta ruaj kopjen e vjetër të skedarit para se të ruaj të renë. Ju "
"mund ta shpërfillni këtë paralajmërim dhe ta ruani skedarin gjithësesi, por "
"nëse ndodh një gabim gjatë ruajtjes, ju mund të humbisni kopjen e vjetër të "
"skedarit. Ta ruaj gjithësesi?"

#. Translators: %s is a URI scheme (like for example http:, ftp:, etc.)
#: gedit/gedit-io-error-info-bar.c:1024
#, c-format
msgid ""
"Cannot handle “%s:” locations in write mode. Please check that you typed the "
"location correctly and try again."
msgstr ""
"Nuk mund ti përpunoj vendndodhjet “%s:” në mënyrë shkrimi. Ju lutemi të "
"kontrolloni që e keni shtypur vendndodhjen në rregull dhe provojeni përsëri."

#: gedit/gedit-io-error-info-bar.c:1032
msgid ""
"Cannot handle this location in write mode. Please check that you typed the "
"location correctly and try again."
msgstr ""
"Nuk mund ta përpunoj këtë vendndodhje në mënyrë shkrimi. Ju lutemi të "
"kontrolloni që e keni shtypur vendndodhjen në rregull dhe provojeni përsëri."

#: gedit/gedit-io-error-info-bar.c:1041
#, c-format
msgid ""
"“%s” is not a valid location. Please check that you typed the location "
"correctly and try again."
msgstr ""
"\"%s\" nuk është një vendndodhje e vlefshme. Ju lutemi të kontrolloni që e "
"keni shtypur vendndodhjen në rregull dhe provojeni përsëri."

#: gedit/gedit-io-error-info-bar.c:1048
msgid ""
"You do not have the permissions necessary to save the file. Please check "
"that you typed the location correctly and try again."
msgstr ""
"Mungojnë të drejtat e duhura për të ruajtur file. Kontrollo që ke shkruar si "
"duhet pozicionin dhe provo përsëri."

#: gedit/gedit-io-error-info-bar.c:1054
msgid ""
"There is not enough disk space to save the file. Please free some disk space "
"and try again."
msgstr ""
"Hapësirë e pamjaftueshme në disk për të ruajtur file. Liro pak hapësirë në "
"disk dhe provo përsëri."

#: gedit/gedit-io-error-info-bar.c:1059
msgid ""
"You are trying to save the file on a read-only disk. Please check that you "
"typed the location correctly and try again."
msgstr ""
"Përpjekje për të ruajtur këtë file në një disk në vetëm-lexim. Kontrollo që "
"ke shkruar si duhet pozicionin dhe provo përsëri."

#: gedit/gedit-io-error-info-bar.c:1065
msgid ""
"A file with the same name already exists. Please use a different name."
msgstr ""
"Një file me të njëjtin emër ekziston rregullisht. Përdor një emër tjetër."

#: gedit/gedit-io-error-info-bar.c:1070
msgid ""
"The disk where you are trying to save the file has a limitation on length of "
"the file names. Please use a shorter name."
msgstr ""
"Disku ku po përpiqeni të ruani këtë file kufizon gjatësinë e emrave. Përdor "
"një emër më të shkurtër."

#: gedit/gedit-io-error-info-bar.c:1081
msgid ""
"The disk where you are trying to save the file has a limitation on file "
"sizes. Please try saving a smaller file or saving it to a disk that does not "
"have this limitation."
msgstr ""
"Disku ku po përpiqeni ta ruani skedarin ka një kufizim në përmasën e "
"skedarëve. Ju lutemi përpiquni të ruani një skedar më të vogël ose ta ruani "
"në një disk që nuk e ka këtë kufizim."

#: gedit/gedit-io-error-info-bar.c:1098
#, c-format
msgid "Could not save the file “%s”."
msgstr "Nuk munda ta ruaj skedarin “%s”."

#: gedit/gedit-io-error-info-bar.c:1138
#, c-format
msgid "The file “%s” changed on disk."
msgstr "Skedari “%s” ndryshoi në disk."

#: gedit/gedit-io-error-info-bar.c:1149
msgid "Drop Changes and _Reload"
msgstr "Anullo Ndryshimet dhe _Ringarkoje"

#: gedit/gedit-io-error-info-bar.c:1159 gedit/resources/gtk/menus-common.ui:148
#: gedit/resources/gtk/menus.ui:9 gedit/resources/gtk/menus-traditional.ui:9
msgid "_Reload"
msgstr "_Ringarko"

#: gedit/gedit-io-error-info-bar.c:1223
#, c-format
