#: data/org.gnome.SoundRecorder.desktop.in.in:4
#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:5 data/ui/window.ui:10
#: src/application.js:32
msgid "Sound Recorder"
msgstr "Snimatelj zvuka"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:6
msgid "A simple, modern sound recorder for GNOME"
msgstr "Jednostavan, moderan snimatelj zvuka za GNOME"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:10
msgid ""
"Sound Recorder provides a simple and modern interface that provides a "
"straight-forward way to record and play audio. It allows you to do basic "
"editing, and create voice memos."
msgstr ""
"Snimatelj zvuka omogućuje jednostavno i moderno sučelje koje omogućuje "
"ravnomjerno snimanje i reprodukciju zvuka. Omogućuje vam osnovno uređivanje "
"i stvaranje video bilješka."

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:15
msgid ""
"Sound Recorder automatically handles the saving process so that you do not "
"need to worry about accidentally discarding the previous recording."
msgstr ""
"Snimatelj zvuka automatski rukuje procesom spremanja stoga se ne morate "
"brinuti o slučajnom gubitku prijašnjih nespremljenih snimaka."

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:19
msgid "Supported audio formats:"
msgstr "Podržani zvučni formati:"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:21
msgid "Ogg Vorbis, Opus, FLAC, MP3 and MOV"
msgstr "Ogg Vorbis, Opus, FLAC, MP3 i MOV"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:52
msgid "Bugfix release"
msgstr "Izdanje popravaka grešaka"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:54
msgid "Translation updates"
msgstr "Nadopune prijevoda"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:57
msgid "Fix export dialog for recordings disappears shortly after opening"
msgstr "Popravak dijaloga izvoza za snimanja kratko nestane nakon otvaranja"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:60
msgid "Fix not able to use space bar in recording name input"
msgstr "Popravak ne može koristiti razmaknicu u nazivu izlaza snimanja"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:63
msgid "Fix recording is lost when using space bar in name input"
msgstr ""
"Popravak kratkog nestanka snimanja kada se koristi razmaknica u nazivu ulaza"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:66
msgid "Fix ui becomes unusable and recording is lost after stopping a record"
msgstr ""
"Popravljeno korisničko sučelje postaje neupotrebljiv i snimanje je "
"izgubljeno nakon zaustavljanja snimanja"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:69
msgid "Remove m4a option since using it results in unusable recordings"
msgstr ""
"Uklonjena je m4a mogućnost jer se koriste njeni rezultati u nestabilnim "
"snimkama"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:77
msgid "An overall update of Sound Recorder's design"
msgstr "Cjelokupna nadopuna dizajna Snimača zvuka"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:79
msgid "The possibility to seek backward/forward while playing a recording"
msgstr "Mogućnost premotavanja natrag/naprijed pri reprodukciji snimke"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:82
msgid "Recordings now always display the associated wave"
msgstr "Snimke sada uvijek prikazuju pridruženi wave"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:85
msgid "The possiblity to export a recording"
msgstr "Mogućnost izvoza snimke"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:88
msgid "Code cleanup and translations updates"
msgstr "Čišćenje kôda i nadopune prijevoda"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:45
#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:96
msgid "Translations updates"
msgstr "Nadopune prijevoda"

#: data/org.gnome.SoundRecorder.metainfo.xml.in.in:106
msgid "The GNOME Project"
msgstr "GNOME projekt"

#: data/org.gnome.SoundRecorder.desktop.in.in:5
msgid "Record sound via the microphone and play it back"
msgstr "Snimi zvuk putem mikrofona i reproduciraj ga natrag"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.SoundRecorder.desktop.in.in:10
msgid "Audio;Application;Record;"
msgstr "Zvuk;Aplikacija;Snimi;"

#: data/org.gnome.SoundRecorder.gschema.xml.in:15
msgid "Window size"
msgstr "Veličina prozora"

#: data/org.gnome.SoundRecorder.gschema.xml.in:16
msgid "Window size (width and height)."
msgstr "Veličina prozora (širina i visina)."

#: data/org.gnome.SoundRecorder.gschema.xml.in:20
msgid "Window position"
msgstr "Položaj prozora"

#: data/org.gnome.SoundRecorder.gschema.xml.in:21
msgid "Window position (x and y)."
msgstr "Položaj prozora (x-os i y-os)"

#: data/org.gnome.SoundRecorder.gschema.xml.in:25
msgid "Maps media types to audio encoder preset names."
msgstr "Mapiraj vrste medija u predložak naziva zvučnog enkôdera."

#: data/org.gnome.SoundRecorder.gschema.xml.in:26
msgid ""
"Maps media types to audio encoder preset names. If there is no mapping set, "
"the default encoder settings will be used."
msgstr ""
"Mapiraj vrste medija u predložak naziva zvučnog enkôdera. Ako mapiranje nije "
"postavljeno, zada postavke enkôdiranja će se koristiti."

#: data/org.gnome.SoundRecorder.gschema.xml.in:30
msgid "Available channels"
msgstr "Dostupni kanali"

#: data/org.gnome.SoundRecorder.gschema.xml.in:31
msgid ""
"Maps available channels. If there is not no mapping set, stereo channel will "
"be used by default."
msgstr ""
"Mapiraj dostupne kanale. Ako mapiranje nije postavljeno, stereo kanal će se "
"koristiti kao zadani."

