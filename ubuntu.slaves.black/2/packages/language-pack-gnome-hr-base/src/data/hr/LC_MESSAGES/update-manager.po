"Možda želite pričekati dok ne završite s korištenjem širokopojasne mobilne "
"mreže."

#: ../data/gtkbuilder/UpdateManager.ui.h:9
msgid "It’s safer to connect the computer to AC power before updating."
msgstr ""
"Preporučljivo je da prije nadopunjavanja svoje računalo priključite na "
"napajanje."

#: ../data/update-manager.desktop.in.h:2
msgid "Software Updates"
msgstr "Softverske nadopune"

#: ../data/update-manager.desktop.in.h:3
#: ../data/update-manager.appdata.xml.in.h:2
msgid "Show and install available updates"
msgstr "Prikaži i instaliraj dostupne nadopune"

#: ../data/update-manager.appdata.xml.in.h:3
msgid ""
"Software Updater checks for updates using apt and let you choose which "
"updates to install."
msgstr ""
"Nadopunitelj softvera provjerava nadopune pomoću apt alata i omogućuje vam "
"odabir nadopuna za instalaciju."

#: ../update-manager:75
msgid "Show version and exit"
msgstr "Prikaži inačicu i izađi"

#: ../update-manager:78
msgid "Directory that contains the data files"
msgstr "Direktorij koji sadrži podatkovne datoteke"

#: ../update-manager:81
msgid "Check if a new Ubuntu release is available"
msgstr "Provjeri je li dostupno novo Ubuntu izdanje"

#: ../update-manager:84
msgid ""
"If using the latest supported release, upgrade to the development release"
msgstr ""
"Ako se koristi najnovije podržano izdanje, nadogradi na razvojno izdanje"

#: ../update-manager:88
msgid "Upgrade using the latest proposed version of the release upgrader"
msgstr ""
"Nadogradi na najnoviju predloženu inačicu koju ponudi nadograditelj izdanja"

#: ../update-manager:95
msgid "Do not focus on map when starting"
msgstr "Nemoj se usredotočiti na kartu prilikom pokretanja"

#: ../update-manager:98
msgid "Do not check for updates when starting"
msgstr "Ne provjeravaj dostupnost novih nadopuna prilikom pokretanja"

#: ../update-manager:100
msgid "Show debug messages"
msgstr "Prikaži poruke otklanjanja greške"

