msgstr "%i zastarjeli zapisi u datoteci stanja"

#: ../janitor/plugincore/plugins/dpkg_status_plugin.py:43
msgid "Obsolete entries in dpkg status"
msgstr "Zastarjeli zapisi u dpkg stanju"

#. pragma: no cover
