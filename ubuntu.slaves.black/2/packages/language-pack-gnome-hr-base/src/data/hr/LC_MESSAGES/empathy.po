#: ../data/org.gnome.Empathy.gschema.xml.h:90
msgid "Empathy can publish the user's location"
msgstr "Empathy može objaviti korisnikovu lokaciju"

#: ../data/org.gnome.Empathy.gschema.xml.h:91
