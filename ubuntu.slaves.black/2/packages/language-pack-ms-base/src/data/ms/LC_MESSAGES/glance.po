msgstr ""
"Gagal memuat naik data imej bagi imej %(image_id)s kerana terdapat ralat "
"HTTP: %(error)s"

#: glance/notifier.py:281
#, python-format
msgid ""
"Failed to upload image data for image %(image_id)s due to internal error: "
"%(error)s"
