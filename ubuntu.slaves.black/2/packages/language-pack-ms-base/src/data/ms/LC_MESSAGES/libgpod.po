#: ../tests/test-photos.c:39
#, c-format
msgid ""
"Usage to add photos:\n"
"  %s add <mountpoint> <albumname> [<filename(s)>]\n"
"  <albumname> should be set to 'NULL' to add photos to the master photo "
"album\n"
"  (Photo Library) only. If you don't specify any filenames an empty album "
"will\n"
"  be created.\n"
msgstr ""
"Penggunaan untuk tambah foto:\n"
"  %s add <titik lekap> <nama album> [<nama fail>]\n"
"  <nama ablum> sepatutnya ditetapkan pada 'NULL' untuk tambah foto ke album "
"foto master\n"
"  (Pustaka Foto) sahaja. Jika anda tidak nyatakan mana-mana nama fail satu "
"album kosong\n"
"  akan dicipta.\n"

#: ../tests/test-photos.c:40
#, c-format
msgid ""
"Usage to dump all photos to <output_dir>:\n"
"  %s dump <mountpoint> <output_dir>\n"
msgstr ""
"Penggunaan untuk longok semua foto ke <output_dir>:\n"
"  %s dump <titik lekap> <output_dir>\n"

#: ../tests/test-photos.c:41
#, c-format
msgid ""
"Usage to list all photos IDs to stdout:\n"
"  %s list <mountpoint>\n"
msgstr ""
"Penggunaan untuk senaraikan semua ID foto ke stdout:\n"
"  %s list <titik lekap>\n"

#: ../tests/test-photos.c:42
#, c-format
msgid ""
"Usage to remove photo IDs from Photo Library:\n"
"  %s remove <mountpoint> <albumname> [<ID(s)>]\n"
"  <albumname> should be set to 'NULL' to remove photos from the iPod\n"
"  altogether. If you don't specify any IDs, the photoalbum will be removed\n"
"  instead.\n"
"  WARNING: IDs may change when writing the PhotoDB file.\n"
msgstr ""
"Penggunaan untuk buang ID foto dari Pustaka Foto:\n"
"  %s remove <titik lekap> <nama album> [<ID>]\n"
"  <nama album> patutnya ditetapkan kepada 'NULL' untuk buang foto dari "
"iPod.\n"
"  Jika anda tidak nyatakan sebarang ID, album foto akan dibuang.\n"
"  AMARAN: ID boleh bertukar bila menulis ke fail PhotoDB.\n"

