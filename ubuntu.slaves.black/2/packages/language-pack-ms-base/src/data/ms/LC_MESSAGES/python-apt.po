#. TRANSLATORS: %s is a country
#: ../aptsources/distro.py:206 ../aptsources/distro.py:461
#, python-format
msgid "Server for %s"
msgstr "Pelayan untuk %s"

#. More than one server is used. Since we don't handle this case
#. in the user interface we set "custom servers" to true and
#. append a list of all used servers
#: ../aptsources/distro.py:225 ../aptsources/distro.py:237
#: ../aptsources/distro.py:258
msgid "Main server"
msgstr "Pelayan Utama"

#: ../aptsources/distro.py:267
msgid "Custom servers"
msgstr "Pelayan Buatan"

#: ../apt/package.py:619
#, python-format
msgid "Missing description for '%s'.Please report."
msgstr "Keterangan '%s' hilang. Sila buat laporan."

#: ../apt/package.py:629
#, python-format
msgid "Invalid unicode in description for '%s' (%s). Please report."
msgstr "Unicode bermasalan dalam diskripsi '%s' (%s). Tolong laporkan."

#: ../apt/package.py:1330 ../apt/package.py:1346 ../apt/package.py:1459
#: ../apt/package.py:1475
msgid "The list of changes is not available"
msgstr "Tiada senarai penukaran"

#: ../apt/package.py:1467
#, python-format
msgid ""
"The list of changes is not available yet.\n"
"\n"
"Please use http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"until the changes become available or try again later."
msgstr ""
"Masih belum ada senarai penukaran.\n"
"\n"
"Sila menggunakan http://launchpad.net/ubuntu/+source/%s/%s/+changelog\n"
"sehingga senarai penukaran disediakan."

#: ../apt/package.py:1482
msgid ""
"Failed to download the list of changes. \n"
"Please check your Internet connection."
msgstr ""
"Kegagalan muat turun senarai penukaran.\n"
"Sila periksa sambungan Internet anda."

#: ../apt/debfile.py:96
#, python-format
msgid "List of files for '%s' could not be read"
msgstr "Senarai data untuk '%s' tidak dapat dibaca"

#: ../apt/debfile.py:108
#, python-format
msgid "List of control files for '%s' could not be read"
msgstr "Senarai fail kawalan untuk '%s' tidak dapat dibaca"

#: ../apt/debfile.py:242
#, python-format
msgid "Dependency is not satisfiable: %s\n"
msgstr "Gagal menepati keperluan:  %s\n"

#: ../apt/debfile.py:272
#, python-format
msgid "Conflicts with the installed package '%s'"
msgstr "Konflik dengan '%s' yang telah dipasang"

#: ../apt/debfile.py:434
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"
msgstr ""
"Hentikan pakej yang sedia ada '%(pkgname)s' dependency %(depname)s "
"(%(deprelation)s %(depversion)s)"

#: ../apt/debfile.py:465
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' conflict: %(targetpkg)s (%(comptype)s "
"%(targetver)s)"
msgstr ""
"Hentikan pakej yang sedia ada '%(pkgname)s' conflict: %(targetpkg)s "
"(%(comptype)s %(targetver)s)"

#: ../apt/debfile.py:482
#, python-format
msgid ""
"Breaks existing package '%(pkgname)s' that conflict: '%(targetpkg)s'. But "
"the '%(debfile)s' provides it via: '%(provides)s'"
msgstr ""
"Hentikan pakej yang sedia ada '%(pkgname)s' konflik ini: '%(targetpkg)s'. "
"Tetapi '%(debfile)s' berikan ia melalui: '%(provides)s'"

#: ../apt/debfile.py:543
msgid "No Architecture field in the package"
msgstr "Tiada bahagian arkitek dalam pakej"

#: ../apt/debfile.py:555
#, python-format
msgid ""
"Wrong architecture '%s' -- Run dpkg --add-architecture to add it and update "
"afterwards"
msgstr ""
"Senibina '%s' adalah salah -- Jalankan dpkg --add-architecture untuk "
"menambahnya dan kemaskini kemudian"

#. the deb is older than the installed
#: ../apt/debfile.py:570
msgid "A later version is already installed"
msgstr "Versi yang lebih baru telah dipasang"

#: ../apt/debfile.py:596
msgid "Failed to satisfy all dependencies (broken cache)"
msgstr "Gagak menepati semua keperluan (kepecahan cache)"

#: ../apt/debfile.py:627
#, python-format
msgid "Cannot install '%s'"
msgstr "Pemasangan \"%s\" gagal"

#: ../apt/debfile.py:707
msgid ""
"Automatically decompressed:\n"
"\n"
msgstr ""
"Nyahmampat secara automatik:\n"
"\n"

#: ../apt/debfile.py:713
msgid "Automatically converted to printable ascii:\n"
msgstr "Diubah secara automatik kepada ascii yang boleh dicetak:\n"

#: ../apt/debfile.py:824
#, python-format
msgid "Install Build-Dependencies for source package '%s' that builds %s\n"
msgstr "Pasang Build-Dependencies untuk pakage source '%s' yang membina %s\n"

#: ../apt/debfile.py:838
msgid "An essential package would be removed"
msgstr "Satu pakage yang penting akan dipadamkan"

#: ../apt/progress/text.py:97
#, python-format
msgid "%c%s... Done"
msgstr "%c%s... Selesai"

#: ../apt/progress/text.py:143
msgid "Hit "
msgstr "Tekan "

#: ../apt/progress/text.py:153
msgid "Ign "
msgstr "Ign "

#: ../apt/progress/text.py:155
msgid "Err "
msgstr "Rlt "

#: ../apt/progress/text.py:167
msgid "Get:"
msgstr "Dapat:"

#: ../apt/progress/text.py:238
msgid " [Working]"
msgstr " [Berkerja]"

#: ../apt/progress/text.py:252
#, python-format
msgid ""
"Media change: please insert the disc labeled\n"
" '%s'\n"
"in the drive '%s' and press enter\n"
msgstr ""
"Media ditukar: sila masukkan disk berlabel\n"
" '%s'\n"
"kedalam pemacu '%s' dan tekan enter\n"

#: ../apt/progress/text.py:267
#, python-format
msgid "Fetched %sB in %s (%sB/s)\n"
msgstr "Dapat %sB dalam %s (%sB/s)\n"

#: ../apt/progress/text.py:291
msgid "Please provide a name for this medium, such as 'Debian 2.1r1 Disk 1'"
msgstr ""

#: ../apt/progress/text.py:312
msgid "Please insert an installation medium and press enter"
msgstr ""
