#: cmdline/apt-extracttemplates.cc:220
msgid ""
"Usage: apt-extracttemplates file1 [file2 ...]\n"
"\n"
"apt-extracttemplates is used to extract config and template files\n"
"from debian packages. It is used mainly by debconf(1) to prompt for\n"
"configuration questions before installation of packages.\n"
msgstr ""
"Penggunaan: apt-extracttemplates file1 [file2 ...]\n"
"\n"
"apt-extracttemplates digunakan untuk ekstrak fail konfig dan templat\n"
"dari pakej debian. Ia umumnya digunakan oleh debconf(1) untuk prom\n"
"persoalan konfigurasi sebelum pemasangan pakej.\n"

#: cmdline/apt-extracttemplates.cc:275
msgid "Cannot get debconf version. Is debconf installed?"
msgstr "Tidak dapat tentukan versi debconf. Adakah debconf terpasang?"

#: cmdline/apt-internal-planner.cc:46
msgid ""
"Usage: apt-internal-planner\n"
"\n"
"apt-internal-planner is an interface to use the current internal\n"
"installation planner for the APT family like an external one,\n"
"for debugging or the like.\n"
msgstr ""

#: cmdline/apt-internal-solver.cc:46
msgid ""
"Usage: apt-internal-solver\n"
"\n"
"apt-internal-solver is an interface to use the current internal\n"
"resolver for the APT family like an external one, for debugging or\n"
"the like.\n"
msgstr ""
"Penggunaan: apt-internal-solver\n"
"\n"
"apt-internal-solver ialah antaramuka yang gunakan pelerai dalaman\n"
"semasa untuk keluarga APT seperti yang luaran, untuk penyahpepijatan\n"
"atau seumpama dengannya.\n"

#: cmdline/apt-sortpkgs.cc:94
msgid "Unknown package record!"
msgstr "Rekod pakej tidak diketahui!"

#: cmdline/apt-sortpkgs.cc:139
msgid ""
"Usage: apt-sortpkgs [options] file1 [file2 ...]\n"
"\n"
"apt-sortpkgs is a simple tool to sort package information files.\n"
"By default it sorts by binary package information, but the -s option\n"
"can be used to switch to source package ordering instead.\n"
msgstr ""
"Penggunaan: apt-sortpkgs [options] file1 [file2 ...]\n"
"\n"
"apt-sortpkgs ialah alat ringkas yang mengisih fail maklumat pakej.\n"
"Secara lalai ia mengisih maklumat pakej binari, tetapi pilihan -s\n"
"boleh digunakan untuk menukar tertib pakej sumber sebagai ganti.\n"

