"                              may be specified more than once\n"
msgstr ""
"  -C, --compendium=FILE       pustaka tambahan terjemahan mesej,\n"
"                              mungkin dinyatakan lebih dari sekali\n"

#: src/msgmerge.c:572
#, c-format
msgid ""
"  -U, --update                update def.po,\n"
"                              do nothing if def.po already up to date\n"
msgstr ""
