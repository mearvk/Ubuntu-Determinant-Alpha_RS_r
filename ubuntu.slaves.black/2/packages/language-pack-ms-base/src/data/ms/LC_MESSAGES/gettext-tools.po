msgstr ""
"  -<, --less-than=NUMBER      cetak mesej kurang dari sebanyak takrifan\n"
"                              ini, lalai pada tidak terhingga jika tidak "
"ditetapkan\n"

#: src/msgcat.c:408
#, c-format
msgid ""
