#. TRANSLATORS:
#. The first placeholder is a filename, including the directory path.
#. The second placeholder is an ISO standard, e.g. 3166-1 or 639-3.
#: src/isocodes.c:68
#, c-format
msgid "The file \"%s\" does not contain valid ISO %s data."
msgstr "Fail \"%s\" tidak mengandungi data ISO %s yang sah."

#. TRANSLATORS: This is an error message.
#: src/isocodes.c:93 src/isoquery.c:43 src/isoquery.c:60 src/isoquery.c:70
#, c-format
msgid "isoquery: %s\n"
msgstr "isoquery: %s\n"

#: src/isoquery.c:45
msgid ""
"Run \"isoquery --help\" to see a full list of available command line "
"options.\n"
msgstr ""
"Jalankan \"isoquery --help\" untuk melihat senarai penuh pilihan baris "
"perintah yang tersedia.\n"

#: src/options.c:45
msgid ""
"The ISO standard to use. Possible values: 639-2, 639-3, 639-5, 3166-1, 3166-"
"2, 3166-3, 4217, 15924 (default: 3166-1)"
msgstr ""
"Piawaian ISO yang digunakan. Nilai yang mungkin: 639-2, 639-3, 639-5, 3166-"
"1, 3166-2, 3166-3, 4217, 15924 (lalai: 3166-1)"

#: src/options.c:46
msgid "STANDARD"
msgstr "PIAWAI"

#: src/options.c:48
msgid ""
"Use pathname as prefix for the data files (default: /usr/share/iso-"
"codes/json)"
msgstr ""
"Guna nama laluan sebagai awalan untuk fail data (lalai: /usr/share/iso-"
"codes/json)"

#: src/options.c:49
msgid "PATHNAME"
msgstr "PATHNAME"

#: src/options.c:51
msgid "Use this locale for output"
msgstr "Guna lokal ini untuk output"

#: src/options.c:52
msgid "LOCALE"
msgstr "LOKAL"

#: src/options.c:54
msgid "Name for the supplied codes (default)"
msgstr "Nama bagi kod dibekal (lalai)"

#: src/options.c:56
msgid ""
"Official name for the supplied codes. This may be the same as --name (only "
"applies to ISO 3166-1)"
msgstr ""
"Nama rasmi untuk kod dibekal. Ia mungkin sama dengan --name (hanya dilaksana "
"pada ISO 3166-1)"

#: src/options.c:60
msgid ""
"Common name for the supplied codes. This may be the same as --name (only "
"applies to ISO 639-2, 639-3, and 3166-1)"
msgstr ""
"Nama umum untuk kod dibekal. Ia mungkin sama dengan --name (hanya dilaksana "
"pada ISO 639-2, 639-3, dan 3166-1)"

#: src/options.c:63
msgid "Separate entries with a NULL character instead of newline"
msgstr "Pisahkan masukan dengan aksara NOL selain dari baris baharu"

#: src/options.c:65
msgid "Show program version and copyright"
msgstr "Tunjuk versi dan hakcipta program"

#: src/options.c:82
msgid "[ISO codes]"
msgstr "[Kod ISO]"

#. TRANSLATORS: The placeholder is a string like "1234-5".
#: src/options.c:142
#, c-format
msgid "ISO standard \"%s\" is not supported."
msgstr "Piawaian ISO \"%s\" tidak disokong."

#. TRANSLATORS: The placeholder is the version identifier.
#: src/options.c:176
#, c-format
msgid "isoquery %s\n"
msgstr "isoquery %s\n"

#: src/options.c:177
msgid "Copyright © 2007-2016 Dr. Tobias Quathamer\n"
msgstr "Hakcipta © 2007-2016 Dr. Tobias Quathamer\n"

#. TRANSLATORS: Please change the uppercase words as
#. appropriate for your language.
#: src/options.c:180
msgid "Translation to LANGUAGE Copyright © YEAR YOUR-NAME\n"
msgstr "Translation to BAHASA MELAYU Copyright © 2013 ABUYOP\n"

#. TRANSLATORS: The first placeholder is a code like "urgl" or
#. "does-not-exist", the second placeholder is the current
#. ISO standard like "3166-1" or "15924".
#: src/search.c:60
#, c-format
msgid "The code \"%s\" is not defined in ISO %s."
msgstr "Kod \"%s\" tidak ditakrif dalam ISO %s."
