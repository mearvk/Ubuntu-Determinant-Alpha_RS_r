msgstr "Tidak dapat cari sebarang pakej dengan ungkapan nalar '%s'"

#: apt-pkg/cacheset.cc:736
#, c-format
msgid "Couldn't find any package by glob '%s'"
msgstr "Tidak dapat cari sebarang pakej oleh glob '%s'"

#: apt-pkg/cacheset.cc:748
#, c-format
msgid "Unable to locate package %s"
msgstr "Tidak dapat cari pakej %s"

#: apt-pkg/cacheset.cc:775
#, c-format
