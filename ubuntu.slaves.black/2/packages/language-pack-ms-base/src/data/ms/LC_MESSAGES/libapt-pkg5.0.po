msgstr "Tidak mengguna penguncian untuk fail kunci baca sahaja %s"

#: apt-pkg/contrib/fileutl.cc:238
#, c-format
msgid "Could not open lock file %s"
msgstr "Tidak dapat buka fail kunci %s"

#: apt-pkg/contrib/fileutl.cc:261
#, c-format
msgid "Not using locking for nfs mounted lock file %s"
msgstr ""
"Tidak mengguna penguncian untuk nfs yang dilekapkan pada fail kunci %s"

#: apt-pkg/contrib/fileutl.cc:266
#, c-format
msgid "Could not get lock %s"
msgstr "Tidak dapat kunci %s"

#: apt-pkg/contrib/fileutl.cc:403 apt-pkg/contrib/fileutl.cc:520
#, c-format
msgid "List of files can't be created as '%s' is not a directory"
msgstr "Senarai fail tidak dapat dicipta sebagai '%s' bukanlah direktori"

