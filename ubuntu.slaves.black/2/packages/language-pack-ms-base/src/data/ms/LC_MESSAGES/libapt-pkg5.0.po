msgstr "Deria %s tidak difahami, cuba benar atau palsu."

#: apt-pkg/contrib/cmndline.cc:380
#, c-format
msgid "Invalid operation %s"
msgstr "Operasi %s tidak sah"

#: apt-pkg/contrib/configuration.cc:721
#, c-format
