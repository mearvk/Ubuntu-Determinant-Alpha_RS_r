msgstr "Pilih satu bahagian hadapan dengan memasukkan nombornya: "

#: ../apt-listchanges/apt_listchanges.py:122
#: ../apt-listchanges/apt_listchanges.py:468
#, python-format
msgid "Error: %s"
msgstr "Ralat: %s"

#: ../apt-listchanges/apt_listchanges.py:124
#, python-format
