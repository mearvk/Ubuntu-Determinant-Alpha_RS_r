msgstr "Tidak dapat buka semula /dev/tty for stdin: %s"

#: ../apt-listchanges.py:142
#, python-format
msgid "News for %s"
msgstr "Berita untuk %s"

#: ../apt-listchanges.py:144
#, python-format
