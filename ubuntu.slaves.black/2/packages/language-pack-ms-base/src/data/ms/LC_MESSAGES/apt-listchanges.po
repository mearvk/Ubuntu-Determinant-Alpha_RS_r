"Ralat mendapatkan pengguna dari pembolehubah '%(envvar)s': %(errmsg)s"

#: ../apt-listchanges/apt_listchanges.py:502
msgid "Cannot find suitable user to drop root privileges"
msgstr "Tidak dapat  cari pengguna yang sesuai untuk lepaskan kelayakan root"

#: ../apt-listchanges/apt_listchanges.py:528
#, python-format
msgid ""
"None of the following directories is accessible by user %(user)s: %(dirs)s"
msgstr ""
"Tiada dari direktori berikut boleh dicapai oleh pengguna %(user)s: %(dirs)s"

#: ../apt-listchanges/apt_listchanges.py:558
msgid "press q to quit"
msgstr "ketik q untuk keluar"

