msgstr " -O <format>          dipramuat dengan lajur lalai\n"

#: src/ps/help.c:144
msgid "  O <format>          as -O, with BSD personality\n"
msgstr "  O <format>          sebagai -O, dengan BSD secara personal\n"

#: src/ps/help.c:145
msgid ""
" -o, o, --format <format>\n"
"                      user-defined format\n"
msgstr ""
" -o, o, --format <format>\n"
"                      format ditakrif-pengguna\n"

#: src/ps/help.c:148
msgid "  s                   signal format\n"
msgstr "  s                   format isyarat\n"

#: src/ps/help.c:149
msgid "  u                   user-oriented format\n"
msgstr "  u                   format diorientasi-pengguna\n"

#: src/ps/help.c:150
msgid "  v                   virtual memory format\n"
msgstr "  v                   format ingatan maya\n"

#: src/ps/help.c:151
msgid "  X                   register format\n"
msgstr "  X                   daftar format\n"

#: src/ps/help.c:152
msgid ""
" -y                   do not show flags, show rss vs. addr (used with -l)\n"
msgstr ""
" -y                   jangan tunjuk bendera, tunjuk rss lwn. addr (digunakan "
"dengan -l)\n"

