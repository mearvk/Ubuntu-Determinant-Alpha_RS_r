msgid "     --si            use powers of 1000 not 1024\n"
msgstr "     --si guna kuasa 1000 bukannya 1024\n"

#: src/free.c:88
msgid " -l, --lohi          show detailed low and high memory statistics\n"
msgstr " -l, --lohi tunjuk statistik ingatan rendah dan tinggi\n"

