msgstr " -F                   penuh ekstra\n"

#: src/ps/help.c:135
msgid " -f                   full-format, including command lines\n"
msgstr " -f                   format-penuh, termasuklah baris perintah\n"

#: src/ps/help.c:136
msgid "  f, --forest         ascii art process tree\n"
msgstr "  f, --forest         pepohon proses seni ascii\n"

#: src/ps/help.c:137
msgid " -H                   show process hierarchy\n"
msgstr " -H                   tunjuk hieraki proses\n"

#: src/ps/help.c:138
msgid " -j                   jobs format\n"
msgstr " -j                   format kerja\n"

#: src/ps/help.c:139
msgid "  j                   BSD job control format\n"
msgstr "  j                   format kawalan kerja BSD\n"

#: src/ps/help.c:140
msgid " -l                   long format\n"
msgstr " -l                   format panjang\n"

#: src/ps/help.c:141
msgid "  l                   BSD long format\n"
msgstr "  l                   format panjang BSD\n"

#: src/ps/help.c:142
msgid " -M, Z                add security data (for SELinux)\n"
msgstr " -M, Z                tambah data keselamatan (untuk SELinux)\n"

