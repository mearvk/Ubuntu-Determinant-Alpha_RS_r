msgstr ""
"     --rows, --lines <num>\n"
"                      tetapkan tinggi skrin\n"

#: src/ps/help.c:162
msgid ""
"\n"
"Show threads:\n"
msgstr ""
"\n"
"Tunjuk bebenang:\n"

#: src/ps/help.c:163
msgid "  H                   as if they were processes\n"
msgstr "  H                   jika mereka adalah proses\n"

#: src/ps/help.c:164
msgid " -L                   possibly with LWP and NLWP columns\n"
msgstr " -L                   berkemungkinan dengan lajur LWP dan NLWP\n"

