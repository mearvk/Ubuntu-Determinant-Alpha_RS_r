msgid " -l, --list-name           list PID and process name\n"
msgstr " -l, --list-name senarai PID dan nama proses\n"

#: src/pgrep.c:161
msgid " -a, --list-full           list PID and full command line\n"
msgstr " -a, --list-full           senarai PID dan baris perintah penuh\n"

#: src/pgrep.c:162
msgid " -v, --inverse             negates the matching\n"
msgstr " -v, --inverse negasikan pemadanan\n"

#: src/pgrep.c:163
msgid " -w, --lightweight         list all TID\n"
msgstr " -w, --lightweight senarai semua TID\n"

#: src/pgrep.c:176
msgid " -<sig>, --signal <sig>    signal to send (either number or name)\n"
msgstr ""
" -<sig>, --signal <sig> isyarat untuk dihantar (sama ada nombor atau nama)\n"

#: src/pgrep.c:167
msgid " -q, --queue <value>       integer value to be sent with the signal\n"
msgstr ""

#: src/pgrep.c:168
msgid " -e, --echo                display what is killed\n"
msgstr " -e, --echo papar apakah yang dimatikan\n"

#: src/pgrep.c:172
msgid " -e, --echo                display PIDs before waiting\n"
msgstr ""

#: src/pgrep.c:177
msgid " -c, --count               count of matching processes\n"
msgstr " -c, --count kiraan proses pemadanan\n"

#: src/pgrep.c:178
msgid " -f, --full                use full process name to match\n"
msgstr " -f, --full guna nama proses penuh untuk dipadankan\n"

#: src/pgrep.c:179
msgid " -g, --pgroup <PGID,...>   match listed process group IDs\n"
msgstr " -g, --pgroup <PGID,...>   padankan ID kumpulan proses tersenarai\n"

#: src/pgrep.c:180
msgid " -G, --group <GID,...>     match real group IDs\n"
msgstr " -G, --group <GID,...>     padankan ID kumpulan sebenar\n"

#: src/pgrep.c:181
msgid " -i, --ignore-case         match case insensitively\n"
msgstr " -i, --ignore-case         pada kata secara tidak sensitif\n"

#: src/pgrep.c:182
msgid " -n, --newest              select most recently started\n"
msgstr " -n, --newest pilih paling baru-baru ini dimulakan\n"

#: src/pgrep.c:183
msgid " -o, --oldest              select least recently started\n"
msgstr " -o, --oldest pilih paling kurang baru-baru ini dimulakan\n"

#: src/pgrep.c:184
msgid " -O, --older <seconds>     select where older than seconds\n"
msgstr ""

#: src/pgrep.c:185
msgid ""
" -P, --parent <PPID,...>   match only child processes of the given parent\n"
msgstr ""
" -P, --parent <PPID,...>   hanya padankan proses anak bagi induk diberikan\n"

#: src/pgrep.c:186
msgid " -s, --session <SID,...>   match session IDs\n"
msgstr " -s, --session <SID,...>   padan ID sesi\n"

#: src/pgrep.c:187
msgid " -t, --terminal <tty,...>  match by controlling terminal\n"
msgstr " -t, --terminal <tty,...> padan mengikut pengawalan terminal\n"

#: src/pgrep.c:188
msgid " -u, --euid <ID,...>       match by effective IDs\n"
msgstr " -u, --euid <ID,...>       padankan mengikut ID efektif\n"

#: src/pgrep.c:189
msgid " -U, --uid <ID,...>        match by real IDs\n"
msgstr " -U, --uid <ID,...>        padankan mengikut ID sebenar\n"

#: src/pgrep.c:190
msgid " -x, --exact               match exactly with the command name\n"
msgstr " -x, --exact padan setepatnya dengan nama perintah\n"

#: src/pgrep.c:191
msgid " -F, --pidfile <file>      read PIDs from file\n"
msgstr " -F, --pidfile <file> baca PID dari fail\n"

#: src/pgrep.c:192
msgid " -L, --logpidfile          fail if PID file is not locked\n"
msgstr " -L, --logpidfile gagal ika fail PID tidak dikunci\n"

#: src/pgrep.c:193
msgid " -r, --runstates <state>   match runstates [D,S,Z,...]\n"
msgstr ""

#: src/pgrep.c:196
msgid ""
" --ns <PID>                match the processes that belong to the same\n"
"                           namespace as <pid>\n"
msgstr ""
" --ns <PID>                padan proses yang milik nama ruang\n"
"                           yang sama seperti <pid>\n"

#: src/pgrep.c:198
msgid ""
" --nslist <ns,...>         list which namespaces will be considered for\n"
"                           the --ns option.\n"
"                           Available namespaces: ipc, mnt, net, pid, user, "
"uts\n"
msgstr ""
" --nslist <ns,...> senarai ruang nama yang akan diguna untuk\n"
"                           pilihan --ns.\n"
"                           Ruang nama yang tersedia: ipc, mnt, net, pid, "
"user, uts\n"

