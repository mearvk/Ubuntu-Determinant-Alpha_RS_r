#, c-format
msgid "Note, selecting '%s' for regex '%s'\n"
msgstr "Perhatian, pemilihan '%s' untuk ungkapan nalar '%s'\n"

#: apt-private/private-cacheset.cc:266
#, c-format
msgid "Package %s is a virtual package provided by:\n"
msgstr "Pakej %s adalah pakej maya disediakan oleh:\n"

#: apt-private/private-cacheset.cc:280
msgid " [Installed]"
msgstr " [terpasang]"

#: apt-private/private-cacheset.cc:292
msgid " [Not candidate version]"
msgstr " [Bukan versi calon]"

