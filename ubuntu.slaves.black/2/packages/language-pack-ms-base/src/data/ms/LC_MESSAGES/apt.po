#: cmdline/apt-cdrom.cc:208
msgid ""
"Usage: apt-cdrom [options] command\n"
"\n"
"apt-cdrom is used to add CDROM's, USB flashdrives and other removable\n"
"media types as package sources to APT. The mount point and device\n"
"information is taken from apt.conf(5), udev(7) and fstab(5).\n"
msgstr ""
"Penggunaan: apt-cdrom [options] command\n"
"\n"
"apt-cdrom digunakan untuk menambah CDROM, pemacu kilat USB dan\n"
"lain-lain jenis media boleh tanggal sebagai sumber pakej ke APT. \n"
"Maklumat titik lekap dan peranti diambil dari apt.conf(5), udev(7) \n"
"dan fstab(5).\n"

