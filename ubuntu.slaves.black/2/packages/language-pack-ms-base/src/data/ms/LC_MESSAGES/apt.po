msgid ""
"Essential packages were removed and -y was used without --allow-remove-"
"essential."
msgstr ""
"Pakej penting telah dibuang dan -y telah digunakan tanpa --allow-remove-"
"essential."

#: apt-private/private-install.cc:227
msgid "Packages were downgraded and -y was used without --allow-downgrades."
msgstr ""
"Pakej telah dinyahtatar dan -y telah digunakan tanpa --allow-downgrades."

#: apt-private/private-install.cc:229
msgid ""
"Held packages were changed and -y was used without --allow-change-held-"
"packages."
msgstr ""
"Pakej ditahan telah berubah dan -y telah digunakan tanpa --allow-change-held-"
"packages."

#: apt-private/private-install.cc:245
msgid "Internal error, Ordering didn't finish"
msgstr "Ralat dalaman, Penertiban tidak selesai"

#: apt-private/private-install.cc:258
msgid "How odd... The sizes didn't match, email apt@packages.debian.org"
msgstr "Peliknya... Saiz tidak sepadan, emel apt@packages.debian.org"

#. TRANSLATOR: The required space between number and unit is already included
#. in the replacement strings, so %sB will be correctly translate in e.g. 1,5 MB
