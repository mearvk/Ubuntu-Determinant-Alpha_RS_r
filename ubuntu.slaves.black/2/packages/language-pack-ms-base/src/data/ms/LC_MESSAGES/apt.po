msgid "Some packages could not be authenticated"
msgstr "Beberapa pakej yang tidak boleh disahihkan"

#: apt-private/private-download.cc:76
msgid "Install these packages without verification?"
msgstr "Pasang pakej ini tanpa pengesahan?"

#: apt-private/private-download.cc:85
msgid ""
"There were unauthenticated packages and -y was used without --allow-"
"unauthenticated"
msgstr ""
"Terdapat pakej belum disahihkan dan -y telah digunakan tanpa --allow-"
"unauthenticated"

#: apt-private/private-download.cc:117
#, c-format
msgid "Failed to fetch %s  %s"
msgstr ""

