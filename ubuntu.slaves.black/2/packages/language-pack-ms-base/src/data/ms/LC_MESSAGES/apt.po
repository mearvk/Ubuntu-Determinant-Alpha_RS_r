msgstr "Mengisih"

#: apt-private/private-cacheset.cc:226
#, c-format
msgid "Note, selecting '%s' for task '%s'\n"
msgstr "Perhatian, memilih '%s' untuk tugas '%s'\n"

#: apt-private/private-cacheset.cc:232
#, c-format
msgid "Note, selecting '%s' for glob '%s'\n"
msgstr "Perhatian, memilih '%s' untuk glob '%s'\n"

