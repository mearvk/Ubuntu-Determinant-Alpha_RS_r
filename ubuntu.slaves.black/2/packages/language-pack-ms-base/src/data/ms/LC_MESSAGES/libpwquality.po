#: src/pam_pwquality.c:244
#, c-format
msgid "BAD PASSWORD: %s"
msgstr "KATA LALUAN BURUK: %s"

#: src/pwscore.c:22
#, c-format
msgid "Usage: %s [user]\n"
msgstr "Prnggunaan: %s [user]\n"

#: src/pwscore.c:23
#, c-format
msgid ""
"       The command reads the password to be scored from the standard input.\n"
msgstr "       Perintah membaca kata laluan yang diskor dari input piawai.\n"

#: src/pwscore.c:53 src/pwscore.c:61 src/pwscore.c:67
#, c-format
msgid "Error: %s\n"
msgstr "Ralat: %s\n"

#: src/pwscore.c:53
msgid "Could not obtain the password to be scored"
msgstr "Tidak memperoleh kata laluan yang diskorkan"

#: src/pwscore.c:75
#, c-format
msgid ""
"Password quality check failed:\n"
" %s\n"
msgstr ""
"Semakan kualiti kata laluan gagal:\n"
" %s\n"

#: src/pwmake.c:23
#, c-format
msgid "Usage: %s <entropy-bits>\n"
msgstr "Penggunaan: %s <entropy-bits>\n"

#: src/pwmake.c:58
#, c-format
msgid ""
"Warning: Value %ld is outside of the allowed entropy range, adjusting it.\n"
msgstr ""

#: src/error.c:31
msgid "Memory allocation error when setting"
msgstr "Ralat peruntukan ingatan ketika membuat tetapan"

#: src/error.c:35
msgid "Memory allocation error"
msgstr "Ralat peruntukan ingatan"

#: src/error.c:37
msgid "The password is the same as the old one"
msgstr "Kata laluan adalah serupa dengan yang lama"

#: src/error.c:39
msgid "The password is a palindrome"
msgstr "Kata laluan adalah palindrome"

#: src/error.c:41
msgid "The password differs with case changes only"
msgstr "Kata laluan berbeza hanya huruf besar dan kecil"

#: src/error.c:43
msgid "The password is too similar to the old one"
msgstr "Kata laluan sangat serupa dengan yang lama"

#: src/error.c:45
msgid "The password contains the user name in some form"
msgstr "Kata laluan mengandungi nama pengguna"

#: src/error.c:47
msgid ""
"The password contains words from the real name of the user in some form"
msgstr "Kata laluan mengandungi perkataan daripada nama sebenar pengguna"

#: src/error.c:49
msgid "The password contains forbidden words in some form"
msgstr "Kata laluan mengandungi kata terlarang"

#: src/error.c:52
#, c-format
msgid "The password contains less than %ld digits"
msgstr "Kata laluan kurang dari %ld digit"

#: src/error.c:55
msgid "The password contains too few digits"
msgstr "Kata laluan mengandungi terlalu sedikit digit"

#: src/error.c:58
#, c-format
msgid "The password contains less than %ld uppercase letters"
msgstr "Kata laluan mengandungi kurang dari %ld huruf besar"

#: src/error.c:61
msgid "The password contains too few uppercase letters"
msgstr "Kata laluan mengandungi terlalu sedikit huruf besar"

#: src/error.c:64
#, c-format
msgid "The password contains less than %ld lowercase letters"
msgstr "Kata laluan mengandungi kurang dari %ld huruf kecil"

#: src/error.c:67
msgid "The password contains too few lowercase letters"
msgstr "Kata laluan mengandungi terlalu sedikit huruf kecil"

#: src/error.c:70
#, c-format
msgid "The password contains less than %ld non-alphanumeric characters"
msgstr "Kata laluan mengandungi kurang dari %ld aksara bukan-alfanumerik"

#: src/error.c:73
msgid "The password contains too few non-alphanumeric characters"
msgstr "Kata laluan mengandungi terlalu sedikit aksara bukan-alfanumerik"

#: src/error.c:76
#, c-format
msgid "The password is shorter than %ld characters"
msgstr "Kata laluan lebih pendek dari %ld aksara"

#: src/error.c:79
msgid "The password is too short"
msgstr "Kata laluan terlalu pendek"

#: src/error.c:81
msgid "The password is just rotated old one"
msgstr "Kata laluan diubahsuai dari yang lama"

#: src/error.c:84
#, c-format
msgid "The password contains less than %ld character classes"
msgstr "Kata laluan mengandungi kurang dari %ld kelas aksara"

#: src/error.c:87
msgid "The password does not contain enough character classes"
msgstr "Kata laluan tidak mengandungi kelas aksara yang mencukupi"

#: src/error.c:90
#, c-format
msgid "The password contains more than %ld same characters consecutively"
msgstr ""
"Kata laluan mengandungi lebih dari %ld aksara yang sama secara berulangan"

#: src/error.c:93
msgid "The password contains too many same characters consecutively"
msgstr ""
"Kata laluan mengandungi terlalu banyak aksara yang sama secara berulangan"

#: src/error.c:96
#, c-format
msgid ""
"The password contains more than %ld characters of the same class "
"consecutively"
msgstr ""
"Kata laluan mengandungi lebih dari %ld aksara yang sama kelas secara "
"berulangan"

#: src/error.c:99
msgid ""
"The password contains too many characters of the same class consecutively"
msgstr ""
"Kata laluan mengandungi terlalu banyak aksara yang sama kelas secara "
"berulangan"

#: src/error.c:102
#, c-format
msgid "The password contains monotonic sequence longer than %ld characters"
msgstr ""
"Kata laluan mengandungi jujukan monotonik lebih panjang dari %ld aksara"

#: src/error.c:105
msgid "The password contains too long of a monotonic character sequence"
msgstr ""
"Kata laluan mengandungi jujukan aksara monotonik yang terlalu panjang"

#: src/error.c:107
msgid "No password supplied"
msgstr "Tiada kata laluan dibekalkan"

#: src/error.c:109
msgid "Cannot obtain random numbers from the RNG device"
msgstr "Tidak memperoleh nombor rawak dari peranti RNG"

#: src/error.c:111
msgid "Password generation failed - required entropy too low for settings"
msgstr ""
"Penjanaan kata laluan gagal - entropi yang diperlukan terlalu rendah untuk "
"tetapan"

#: src/error.c:114 src/error.c:117
msgid "The password fails the dictionary check"
msgstr "Kata laluan gagal dalam semakan kamus"

#: src/error.c:120 src/error.c:124
msgid "Unknown setting"
msgstr "Tetapan tidak diketahui"

#: src/error.c:127
msgid "Bad integer value of setting"
msgstr "Nilai integer tetapan teruk"

#: src/error.c:131
msgid "Bad integer value"
msgstr "Nilai integer teruk"

#: src/error.c:134
#, c-format
msgid "Setting %s is not of integer type"
msgstr "Tetapan %s bukanlah jenis integer"

#: src/error.c:138
msgid "Setting is not of integer type"
msgstr "Tetapan bukanlah jenis integer"

#: src/error.c:141
#, c-format
msgid "Setting %s is not of string type"
msgstr "Tetapan %s bukanlah jenis rentetan"

#: src/error.c:145
msgid "Setting is not of string type"
msgstr "Tetapan bukanlah jenis rentetan"

#: src/error.c:147
msgid "Opening the configuration file failed"
msgstr "Pembukaan fail konfigurasi mengalami kegagalan"

#: src/error.c:149
msgid "The configuration file is malformed"
msgstr "Fail konfigurasi cacat"

#: src/error.c:151
msgid "Fatal failure"
msgstr "Kegagalan mati"

#: src/error.c:153
msgid "Unknown error"
msgstr "Ralat tidak diketahui"
