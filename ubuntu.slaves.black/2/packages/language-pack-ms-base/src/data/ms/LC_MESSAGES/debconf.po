msgstr ""
"amaran: kemungkinan berlaku  kerosakan pangkalan data. Akan cuba membaikinya "
"dengan meletak semula soalan yg hilang %s."

#: ../Debconf/Template.pm:211
#, perl-format
msgid ""
"Template #%s in %s has a duplicate field \"%s\" with new value \"%s\". "
"Probably two templates are not properly separated by a lone newline.\n"
msgstr ""
"Templat #%s dalam %s mengandungi medan berganda \"%s\" dengan nilai baru "
"\"%s\". Berkemungkinan dua templat tidak dipisahkan dengan baris baru yang "
"tepat.\n"

#: ../Debconf/Template.pm:236
#, perl-format
msgid "Unknown template field '%s', in stanza #%s of %s\n"
msgstr "Medan templat '%s' tidak diketahui, dalam stanza #%s dari %s\n"

