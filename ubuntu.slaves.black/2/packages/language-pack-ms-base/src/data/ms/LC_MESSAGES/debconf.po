#: ../Debconf/Config.pm:232
msgid ""
"  -f,  --frontend\t\tSpecify debconf frontend to use.\n"
"  -p,  --priority\t\tSpecify minimum priority question to show.\n"
"       --terse\t\t\tEnable terse mode.\n"
msgstr ""
"  -f,  --frontend\t\tNyatakan bahagian hadapan debconf yang diguna.\n"
"  -p,  --priority\t\tNyatakan soalan keutamaan minimum untuk ditunjuk.\n"
"       --terse\t\t\tBenarkan mod ringkas.\n"

