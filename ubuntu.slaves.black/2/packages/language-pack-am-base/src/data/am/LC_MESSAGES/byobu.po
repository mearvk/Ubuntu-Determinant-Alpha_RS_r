#: bin/menu:34 byobu-config:129 byobu-config:401 byobu-config:409
msgid "Menu"
msgstr "ዝርዝር"

#: byobu-export:68 byobu-export:71 byobu-select-profile:104
#: byobu-select-profile:107
msgid "Choose"
msgstr "ይምረጡ"

#: byobu-export:171
msgid "File exists"
msgstr "ፋይሉ ቀደም ብሎ ነበር"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "ፋይሉን ላስወግድ? [y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "ቀለም ይምረጡ: "

#: byobu-export:240
msgid "Profile"
msgstr "ገጽታ"

#: byobu-export:241
msgid "Archive"
msgstr "ማህደር"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "በ እርስዎ የ ቤት ዳይሬክቶሪ ውስጥ ማህደሩን ማራገፊያ በ ታለመው ስርአት ውስጥ"

#: byobu-select-profile:49
msgid "Error:"
msgstr "ስህተት:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " ፋይል ነበር: ነገር ግን symlink አይደለም"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "ይምረጡ የ መመልከቻ ገጽታ: "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "ስህተት: ዋጋ የሌለው ምርጫ"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"እርስዎ የሚጠቀሙ ከሆነ ነባር የ ቁልፍ ማጣመሪያ: ይጫኑ\\n<F5> እነዚህን ለውጦች ለ ማስጀመር \\n\\n ያለ በለዚያ "
"ከዚህ ክፍለ ጊዜ መመልከቻ ውስጥ ይውጡ እና አዲስ እንደገና ያስጀምሩ"

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "ማስኬጃ \"byobu\" ለማስጀመር"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu አሁን ይጀምራል በ መግቢያ (መቀያየሪያ ማጥፊያ)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu አሁን አይጀምርም በ መግቢያ (መቀያየሪያ ማብሪያ)"

#: byobu-config:89
msgid "Help"
msgstr "እርዳታ"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "የ Byobu's ቀለም መቀየሪያ"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "የ ሁኔታዎች ማስታወቂያ መቀየሪያ"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "የ ቁልፍ ማጣመሪያ ማሰናጃ መቀየሪያ"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "የ መዝለያ ሂደት መቀየሪያ"

#: byobu-config:94
msgid "Create new windows"
msgstr "አዲስ መስኮት መፍጠሪያ"

#: byobu-config:95
msgid "Manage default windows"
msgstr "ነባር የ መስኮት አስተዳዳሪ"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " የ Byobu ማዋቀሪያ ዝርዝር"

#: byobu-config:110
msgid "Okay"
msgstr "እሺ"

#: byobu-config:110 byobu-config:144 byobu-config:161 byobu-config:195
#: byobu-config:335 byobu-config:376 byobu-config:449
msgid "Cancel"
msgstr "መሰረዣ"

#: byobu-config:130
msgid "Byobu Help"
msgstr "Byobu እርዳታ"

#: byobu-config:144 byobu-config:161 byobu-config:195 byobu-config:335
#: byobu-config:376 byobu-config:449
msgid "Apply"
msgstr "መፈጸሚያ"

#: byobu-config:146
msgid "Which profile would you like to use?"
msgstr "የትኛውን ገጽታ መጠቀም ይፈልጋሉ?"

#: byobu-config:162
msgid "Which set of keybindings would you like to use?"
msgstr "የትኛውን የ ቁልፍ ማጣመሪያ ነው መጠቀም የሚፈልጉት?"

#: byobu-config:175
msgid "Title: "
msgstr "አርእስት: "

#: byobu-config:177
msgid "Command: "
msgstr "ትእዛዝ: "

#: byobu-config:179
msgid "Presets: "
msgstr "በቅድሚያ ማሰናጃ: "

#: byobu-config:193
msgid "Add to default windows"
msgstr "ወደ ነባር መስኮት መጨመሪያ"

#: byobu-config:197
msgid "Create new window(s):"
msgstr "አዲስ መስኮት(ቶች) መፍጠሪያ:"

#: byobu-config:336
msgid "Toggle status notifications:"
msgstr "የ ማስታወቂያ ሁኔታ መቀያየሪያ:"

#: byobu-config:368
msgid "Windows:"
msgstr "መስኮቶች:"

#: byobu-config:378
msgid "Select window(s) to create by default:"
msgstr "ይምረጡ መስኮት(ቶች) በ ነባር ለ መፍጠር:"

#: byobu-config:398
msgid "Byobu will be launched automatically next time you login."
msgstr "እርስዎ በሚቀጥለው ጊዜ ሲገቡ Byobu ራሱ በራሱ ይጀምራል"

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "Byobu አይጠቀምም በሚቀጥለው ጊዜ እርስው ሲገቡ"

#: byobu-config:408
msgid "Message"
msgstr "መልእክት"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "Escape key: ctrl-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "መቀየሪያ የ መዝለያ ሂደት:"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr "<Tab>/<Alt-Tab> በ አካሎች መካከል | <Enter> ይምረጡ | <Esc> መውጫ"
