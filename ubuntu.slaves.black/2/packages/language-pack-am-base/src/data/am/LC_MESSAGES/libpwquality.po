#: src/pam_pwquality.c:244
#, c-format
msgid "BAD PASSWORD: %s"
msgstr "መጥፎ የ መግቢያ ቃል: %s"

#: src/pwscore.c:22
#, c-format
msgid "Usage: %s [user]\n"
msgstr "አጠቃቀም: %s [user]\n"

#: src/pwscore.c:23
#, c-format
msgid ""
"       The command reads the password to be scored from the standard input.\n"
msgstr "       ትእዛዙ የሚያነበው የሚመዘገበውን የ መግቢያ ቃል ነው ከ መደበኛ ማስገቢያ ውስጥ\n"

#: src/pwscore.c:53 src/pwscore.c:61 src/pwscore.c:67
#, c-format
msgid "Error: %s\n"
msgstr "ስህተት: %s\n"

#: src/pwscore.c:53
msgid "Could not obtain the password to be scored"
msgstr "የሚመዘገበውን የ መግቢያ ቃል ማግኘት አልተቻለም"

#: src/pwscore.c:75
#, c-format
msgid ""
"Password quality check failed:\n"
" %s\n"
msgstr ""
"የ መግቢያ ቃል ጥራት ምርመራ አላለፈም:\n"
" %s\n"

#: src/pwmake.c:23
#, c-format
msgid "Usage: %s <entropy-bits>\n"
msgstr "አጠቃቀም: %s <entropy-bits>\n"

#: src/pwmake.c:58
#, c-format
msgid ""
"Warning: Value %ld is outside of the allowed entropy range, adjusting it.\n"
msgstr ""

#: src/error.c:31
msgid "Memory allocation error when setting"
msgstr "የ ማስታወሻ ስርጭት ስህተት ተፈጥርሯል በ ማሰናዳት ላይ እንዳለ"

#: src/error.c:35
msgid "Memory allocation error"
msgstr "የ ማስታወሻ ስርጭት ስህተት"

#: src/error.c:37
msgid "The password is the same as the old one"
msgstr "የ መግቢያ ቃል ተመሳሳይ ነው ከ አሮጌው ጋር"

#: src/error.c:39
msgid "The password is a palindrome"
msgstr "የ መግቢያ ቃል መደበኛ ጽሁፍ ነው"

#: src/error.c:41
msgid "The password differs with case changes only"
msgstr "የ መግቢያ ቃል የሚለየው ጉዳዩ ሲቀየር ብቻ ነው"

#: src/error.c:43
msgid "The password is too similar to the old one"
msgstr "የ መግቢያ ቃል በጣም ተመሳሳይ ነው ከ አሮጌው ጋር"

#: src/error.c:45
msgid "The password contains the user name in some form"
msgstr "የ መግቢያ ቃል የሚይዘው የ ተጠቃሚ ስም ነው"

#: src/error.c:47
msgid ""
"The password contains words from the real name of the user in some form"
msgstr "የ መግቢያ ቃል የሚይዘው ቃል በ ተወሰነ የ ተጠቃሚ ስም ነው"

#: src/error.c:49
msgid "The password contains forbidden words in some form"
msgstr "የ መግቢያ ቃል የሚይዘው በ ተወሰነ የ ተከለከለ ቃል ነው"

#: src/error.c:52
#, c-format
msgid "The password contains less than %ld digits"
msgstr "የ መግቢያ ቃል የሚይዘው አነስተኛ %ld አሀዝ ነው"

#: src/error.c:55
msgid "The password contains too few digits"
msgstr "የ መግቢያ ቃል የያዘው በጣም አነስተኛ አሀዝ ነው"

#: src/error.c:58
#, c-format
msgid "The password contains less than %ld uppercase letters"
msgstr "የ መግቢያ ቃል የያዘው አነስተኛ ነው %ld uppercase ፊደሎች"

#: src/error.c:61
msgid "The password contains too few uppercase letters"
msgstr "የ መግቢያ ቃል የያዘው አነስተኛ ነው የ uppercase ፊደሎች"

#: src/error.c:64
#, c-format
msgid "The password contains less than %ld lowercase letters"
msgstr "የ መግቢያ ቃል የያዘው አነስተኛ ነው %ld lowercase ፊደሎች"

#: src/error.c:67
msgid "The password contains too few lowercase letters"
msgstr "የ መግቢያ ቃል የያዘው አነስተኛ ነው የ lowercase ፊደሎች"

#: src/error.c:70
#, c-format
msgid "The password contains less than %ld non-alphanumeric characters"
msgstr "የ መግቢያ ቃል የሚይዘው አነስተኛ %ld ምንም-የ ፊደል እና ቁጥር ባህሪዎች ነው"

#: src/error.c:73
msgid "The password contains too few non-alphanumeric characters"
msgstr "የ መግቢያ ቃል የሚይዘው አነስተኛ ምንም-የ ፊደል እና ቁጥር ባህሪዎች ነው"

#: src/error.c:76
#, c-format
msgid "The password is shorter than %ld characters"
msgstr "የ መግቢያ ቃል አነስተኛ ነው ከ %ld ባህሪዎች"

#: src/error.c:79
msgid "The password is too short"
msgstr "የ መግቢያ ቃል በጣም አነስተኛ ነው"

#: src/error.c:81
msgid "The password is just rotated old one"
msgstr "የ መግቢያ ቃል የ አሮጌው የ መግቢያ ቃል ግልባጭ ነው"

#: src/error.c:84
#, c-format
msgid "The password contains less than %ld character classes"
msgstr "የ መግቢያ ቃል የያዘው አነስተኛ ነው %ld የ ባህሪ ክፍሎች"

#: src/error.c:87
msgid "The password does not contain enough character classes"
msgstr "የ መግቢያ ቃል በቂ የ ባህሪ ክፍሎች አልያዘም"

#: src/error.c:90
#, c-format
msgid "The password contains more than %ld same characters consecutively"
msgstr "የ መግቢያ ቃል የያዘው ከ በቂ በላይ ነው %ld ተመሳሳይ ባህሪ በ ተከታታይ"

#: src/error.c:93
msgid "The password contains too many same characters consecutively"
msgstr "የ መግቢያ ቃል ከ በቂ በላይ ተመሳሳይ ባህሪ በ ተከታታይ ይዟል"

#: src/error.c:96
#, c-format
msgid ""
"The password contains more than %ld characters of the same class "
"consecutively"
msgstr "የ መግቢያ ቃል ከ በቂ በላይ %ld ተመሳሳይ ባህሪ በ ተከታታይ ይዟል"

#: src/error.c:99
msgid ""
"The password contains too many characters of the same class consecutively"
msgstr "የ መግቢያ ቃል ከ በቂ በላይ ተመሳሳይ ባህሪ በ ተከታታይ ይዟል"

#: src/error.c:102
#, c-format
msgid "The password contains monotonic sequence longer than %ld characters"
msgstr "የ መግቢያ ቃል የያዘው ተከታታይ እረጅም ነው ከ %ld ባህሪዎች"

#: src/error.c:105
msgid "The password contains too long of a monotonic character sequence"
msgstr "የ መግቢያ ቃል የያዘው ተከታታይ በጣም እረጅም ባህሪዎች ነው"

#: src/error.c:107
msgid "No password supplied"
msgstr "ምንም የ መግቢያ ቃል አልተሰጠም"

#: src/error.c:109
msgid "Cannot obtain random numbers from the RNG device"
msgstr "በደፈናው ቁጥሮችን ማግኘት አልተቻለም ከ RNG አካሎች ውስጥ"

#: src/error.c:111
msgid "Password generation failed - required entropy too low for settings"
msgstr "የ መግቢያ ቃል ማመንጨት አልተቻለም - ምልክት ይፈልጋል ዝቅተኛ የሆነ ለ ማሰናጃ"

#: src/error.c:114 src/error.c:117
msgid "The password fails the dictionary check"
msgstr "የ መግቢያ ቃል የ መዝገበ ቃል መመርመሪያ አላለፈም"

#: src/error.c:120 src/error.c:124
msgid "Unknown setting"
msgstr "ያልታወቀ ማሰናጃ"

#: src/error.c:127
msgid "Bad integer value of setting"
msgstr "መጥፎ የ ኢንቲጀር ዋጋ ለ ማሰናጃ"

#: src/error.c:131
msgid "Bad integer value"
msgstr "መጥፎ የ ኢንቲጀር ዋጋ"

#: src/error.c:134
#, c-format
msgid "Setting %s is not of integer type"
msgstr "ማሰናጃ %s ለ ኢንቲጀር አይነት አይደለም"

#: src/error.c:138
msgid "Setting is not of integer type"
msgstr "ማሰናጃ ለ ኢንቲጀር አይነት አይደለም"

#: src/error.c:141
#, c-format
msgid "Setting %s is not of string type"
msgstr "ማሰናጃው %s የ ሀረግ አይነት አይደለም"

#: src/error.c:145
msgid "Setting is not of string type"
msgstr "ማሰናጃው የ ሀረግ አይነት አይደለም"

#: src/error.c:147
msgid "Opening the configuration file failed"
msgstr "የ ማሰናጃ ፋይል መክፈት አልተቻለም"

#: src/error.c:149
msgid "The configuration file is malformed"
msgstr "የ ማሰናጃ ፋይል የ ተበላሸ ነው"

#: src/error.c:151
msgid "Fatal failure"
msgstr "አደገኛ ስህተት"

#: src/error.c:153
msgid "Unknown error"
msgstr "ያልታወቀ ስህተት"
