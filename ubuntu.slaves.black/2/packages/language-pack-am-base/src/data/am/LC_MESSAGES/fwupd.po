#: ../libdfu/dfu-tool.c:1910 ../libdfu/dfu-tool.c:1916
#: ../libdfu/dfu-tool.c:2003
msgid "Name"
msgstr "ስም"

#. TRANSLATORS: this is the encryption method used when writing
#: ../libdfu/dfu-tool.c:1923
