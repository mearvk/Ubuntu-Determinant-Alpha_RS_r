msgstr "(C) 2010 Harald Sitter"

#: src/main.cpp:39
msgid "Harald Sitter"
msgstr "Harald Sitter"

#: src/main.cpp:44
msgid "Files to find debug packages for"
msgstr "Arxius per als que es cercaran paquets de depuració"

