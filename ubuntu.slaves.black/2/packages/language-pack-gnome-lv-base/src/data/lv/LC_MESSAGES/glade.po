msgstr ""
"Kļūda, rakstot privātus datus %s (%s).\n"
"Šīs sesijas privātie dati netiks saglabāti."

#: gladeui/glade-app.c:604
#, c-format
msgid ""
"Error serializing configuration data to save (%s).\n"
