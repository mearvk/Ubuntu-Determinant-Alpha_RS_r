#!/bin/sh
set -e

if [ -f package.json ]; then
  tests=min/tests.js
  moment=./moment
else
  tests=/usr/share/nodejs/moment/min/tests.js
  moment=moment
fi
sed -E '1ivar QUnit = require("/usr/share/javascript/qunit/qunit.js");' "$tests" > tests.js
sed -Ei 's@\.\./\.\./moment@'$moment@ tests.js
node tests.js
rm tests.js

nodejs -e "require('$moment');"
