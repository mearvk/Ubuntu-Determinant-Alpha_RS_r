#: ../luksformat:33
msgid "This program needs to be started as root\n"
msgstr "Ezt a programot rendszergazdaként kell indítani\n"

#: ../luksformat:38
msgid ""
"luksformat - Create and format an encrypted LUKS device\n"
"Usage: luksformat [-t <file system>] <device> [ mkfs options ]\n"
"\n"
msgstr ""
"luksformat - Titkosított LUKS eszköz létrehozása és formázása\n"
"Használat: luksformat [-t <fájlrendszer>] <eszköz> [ mkfs kapcsolók ]\n"
"\n"

#: ../luksformat:56
#, perl-format
msgid "Error: device mounted: %s\n"
msgstr "Hiba: az eszköz csatlakoztatva van: %s\n"

#: ../luksformat:72
#, perl-format
msgid "Error: invalid file system: %s\n"
msgstr "Hiba: érvénytelen fájlrendszer: %s\n"

#: ../luksformat:85
#, perl-format
msgid "Error: could not generate temporary mapped device name"
msgstr "Hiba: nem sikerült átmeneti leképezett eszköznevet előállítani"

#. we do not need to be overly concerned with race conditions here, cryptsetup
#. will just fail if the name already exists now.
#: ../luksformat:89
#, perl-format
msgid "Creating encrypted device on %s...\n"
msgstr "Titkosított eszköz létrehozása ezen: %s…\n"

#: ../luksformat:91
#, perl-format
msgid "Could not create LUKS device %s"
msgstr "Nem sikerült a következő LUKS eszköz létrehozása: %s"

#: ../luksformat:94
msgid "Please enter your passphrase again to verify it\n"
msgstr "Adja meg ismét a jelszavát az ellenőrzéséhez\n"

#: ../luksformat:96
msgid "The passphrases you entered were not identical\n"
msgstr "A beírt jelszavak nem egyeznek\n"

#: ../luksformat:105
#, perl-format
msgid "Could not format device with file system %s"
msgstr "Az eszköz nem formázható %s fájlrendszerrel"
