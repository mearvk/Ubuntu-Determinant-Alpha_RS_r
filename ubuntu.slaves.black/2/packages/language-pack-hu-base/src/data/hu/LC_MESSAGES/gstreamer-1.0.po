msgstr ""
"az adatokhoz fűzött szabad szöveges megjegyzés kulcs=érték vagy "
"kulcs[hu]=megjegyzés formában"

#: gst/gsttaglist.c:160
msgid "track number"
msgstr "dalsorszám"

#: gst/gsttaglist.c:161
