#: ../adduser:465
#, perl-format
msgid "Adding system user `%s' (UID %d) ...\n"
msgstr ""
"`%s' rendszerfelhasználó hozzáadása (%d felhasználói azonosítóval) ...\n"

#: ../adduser:469
#, perl-format
msgid "Adding new group `%s' (GID %d) ...\n"
msgstr "\"%s\" új csoport létrehozása (csoportazonosító: %d)...\n"

#: ../adduser:475
#, perl-format
msgid "Adding new user `%s' (UID %d) with group `%s' ...\n"
msgstr ""
"\"%s\" új felhasználó létrehozása (felhasználóazonosító:  %d) \"%s\" "
