#, c-format
msgid "Addition succeeded for \"%s\".\n"
msgstr "\"%s\" hozzáadása sikerült.\n"

#: ../parser_sysctl.c:157
#, c-format
msgid "Replacement succeeded for \"%s\".\n"
msgstr "\"%s\" cseréje sikerült.\n"

#: ../parser_sysctl.c:161
#, c-format
