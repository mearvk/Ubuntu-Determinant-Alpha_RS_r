               dosfstools,
               grub-common,
               grub-efi-arm64-signed (= 1.187.3~22.04.1+2.06-2ubuntu14.1) [arm64],
               shim-signed (>> 1.51.1) [arm64],
               mtools,
               python3-apt,
Standards-Version: 4.6.0.1
Vcs-Browser: https://code.launchpad.net/~ubuntu-core-dev/ubuntu/+source/cd-boot-images-arm64/+git/cd-boot-images-arm64/+ref/arm64-jammy
