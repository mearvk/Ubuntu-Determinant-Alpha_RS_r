#! /bin/sh

set -e

case "$1" in
    purge)
	rm -rf /var/lib/awstats
	rm -rf /var/cache/awstats
	rmdir /etc/logrotate.d/httpd-prerotate/ || true
	;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
	;;

esac

#DEBHELPER#

exit 0
