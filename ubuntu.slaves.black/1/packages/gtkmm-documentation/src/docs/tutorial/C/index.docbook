              &lt;/object&gt;
            &lt;/child&gt;
          &lt;/object&gt;
          &lt;packing&gt;
            &lt;property name=&quot;pack-type&quot;&gt;end&lt;/property&gt;
          &lt;/packing&gt;
        &lt;/child&gt;
        &lt;child&gt;
          &lt;object class=&quot;GtkMenuButton&quot; id=&quot;gears&quot;&gt;
            &lt;property name=&quot;visible&quot;&gt;True&lt;/property&gt;
