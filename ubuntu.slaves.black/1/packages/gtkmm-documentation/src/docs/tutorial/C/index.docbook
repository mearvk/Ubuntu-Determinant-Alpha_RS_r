    &lt;property name=&quot;default-height&quot;&gt;400&lt;/property&gt;
    &lt;child type=&quot;titlebar&quot;&gt;
      &lt;object class=&quot;GtkHeaderBar&quot; id=&quot;header&quot;&gt;
