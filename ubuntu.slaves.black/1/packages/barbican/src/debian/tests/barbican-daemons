#!/bin/bash
#---------------------
# Testing barbican daemons
#---------------------
set -e
DAEMONS=('apache2' 'barbican-worker') 

ret=0

for daemon in "${DAEMONS[@]}"; do
    TIMEOUT=50
    while [ "$TIMEOUT" -gt 0 ]; do
        if systemctl is-active $daemon > /dev/null; then
            echo "OK"
            break
        fi
        TIMEOUT=$((TIMEOUT - 1))
        sleep 0.1
    done

    if [ "$TIMEOUT" -le 0 ]; then
        echo "ERROR: ${daemon} IS NOT RUNNING"
        ret=1
    fi
done

curl --fail http://localhost:9311 > /dev/null 2>&1
curl --fail http://localhost:9312 > /dev/null 2>&1

exit $ret
