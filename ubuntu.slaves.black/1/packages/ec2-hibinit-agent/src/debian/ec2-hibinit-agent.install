#!/usr/bin/dh-exec
acpid.sleep.conf => etc/acpi/events/hibinit-sleep
acpid.sleep.sh => etc/acpi/actions/sleep.sh
debian/ec2-hibinit-agent-ignore-powerkey.conf usr/lib/systemd/logind.conf.d/
debian/ec2-hibinit-agent-no-suspend.conf usr/lib/systemd/sleep.conf.d/
debian/hibinit-agent.system-sleep => lib/systemd/system-sleep/hibinit-agent
debian/hibinit-power etc/acpi/events
debian/hibinit-power.sh etc/acpi/actions
debian/hibinit-resume usr/lib/ec2-hibinit-agent
etc/hibinit-config.cfg
agent/* usr/bin/
