               dosfstools,
               grub-common,
               grub-efi-amd64-signed (= 1.187.3~22.04.1+2.06-2ubuntu14.1),
               grub-pc-bin,
               mtools,
               python3-apt,
               shim-signed (>> 1.51.1)
Standards-Version: 4.6.0.1
Vcs-Browser: https://code.launchpad.net/~ubuntu-core-dev/ubuntu/+source/cd-boot-images-amd64/+git/cd-boot-images-amd64/+ref/amd64-jammy
