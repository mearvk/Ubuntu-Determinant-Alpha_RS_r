#!/usr/local/bin/fontforge

#
# Fontforge script for OCR B
#

# This file is released to the public domain by its author, Matthew Skala.

# $1 = terse name, lc
# $2 = terse name, uc
# $3 = human-style name
# $4 = if set, do background/foreground subtraction
# $5 = feature file to attach

if (Strtol($4)>0)
  Open("msk-ocrb10"+$1+"bg-rmo.pfb");
  SelectAll();Copy();
  Open("msk-ocrb10"+$1+"fg-rmo.pfb");
  SelectAll();PasteInto();CorrectDirection();
else
  Open("msk-ocrb10"+$1+"-rmo.pfb");
endif

family="OCRB"+$2
fontname=family+"-"+StrJoin(StrSplit($3," "),"");
SetFontNames(fontname,family,"OCR B "+$3,"Regular","Matthew Skala (2011-12); based on code by Norbert Schwarz (1986, 2011)","2");
SetTTFName(0x409,0,"Matthew Skala (2011, 2021); based on code by Norbert Schwarz (1986, 2011)");
SetTTFName(0x409,1,"OCR B "+$2);
SetTTFName(0x409,2,"Regular");
SetTTFName(0x409,4,"OCR B "+$3);
SetTTFName(0x409,11,"https://tsukurimashou.osdn.jp/");
SetTTFName(0x409,16,"OCR B");
SetTTFName(0x409,17,$3);
if (Strlen($2)==0 && Strlen($1)>0) $2=ToUpper($1); endif

SelectAll();SetWidth(723);
"ocrbnames.pe"();
#if (Strtol($4)>0)
#  Select("AE");Cut();
#  Select("OE");Cut();
#  Select("ae");Cut();
#  Select("oe");Cut();
#endif

Reencode("unicode");
Select("circumflex");Copy();Select(0u5E);Paste();
Select("tilde");Copy();Select(0u7E);Paste();
Select("quotesingle");Copy();Select(0x2018);Paste();Select(0x2019);Paste();
Select("quotedbl");Copy();Select(0x201C);Paste();Select(0x201D);Paste();
Reencode("compacted");

SelectAll();RoundToCluster(2,2);
SelectAll();RoundToInt();
SelectAll();Simplify(212,3);
SelectAll();AddExtrema();
SelectAll();RoundToInt();
SelectAll();CorrectDirection();
SelectAll();CanonicalStart();
SelectAll();CanonicalContours();
SelectAll();AutoHint();
SelectAll();AutoCounter();
MergeFeature($5);
Generate("OCRB"+$2+".pfb");
Generate("OCRB"+$2+".otf");
SetFontOrder(2);
SelectAll();AutoHint();
SelectAll();AutoCounter();
Generate("OCRB"+$2+".ttf");
Quit(0);
