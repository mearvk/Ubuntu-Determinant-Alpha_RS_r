#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	for script in sfd2bold.ff sfd2condensed.ff sfd2italic.ff ConvertFont.ff; \
        do fontforge debian/scripts/$$script OCRA.sdf; done
	for sfd in OCRABold.sfd OCRAItalic.sfd OCRACondensed.sfd; \
        do fontforge debian/scripts/ConvertFont.ff $$sfd; done
	find $(CURDIR) -name '*.ttf' -print0 | xargs -0 debian/scripts/fix-modtime.pe
