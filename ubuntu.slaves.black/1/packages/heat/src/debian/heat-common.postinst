#!/bin/sh

set -e

if [ "$1" = "configure" ] ; then
    if ! getent group heat > /dev/null 2>&1; then
        addgroup --system heat >/dev/null
    fi
    if ! getent passwd heat > /dev/null 2>&1; then
        adduser --system --home /var/lib/heat --ingroup heat --no-create-home \
            --shell /bin/false heat
    fi

    chown heat:adm /var/log/heat
    chmod 0750 /var/log/heat

    find /etc/heat -exec chown root:heat "{}" +
    find /etc/heat -type f -exec chmod 0640 "{}" + -o -type d -exec chmod 0750 "{}" +

    find /var/lib/heat -exec chown heat:heat "{}" +
    find /var/lib/heat -type f -exec chmod 0640 "{}" + -o -type d -exec chmod 0750 "{}" +
fi

#DEBHELPER#

exit 0
