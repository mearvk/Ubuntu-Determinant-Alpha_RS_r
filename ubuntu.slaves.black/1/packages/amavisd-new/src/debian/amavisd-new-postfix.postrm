#!/bin/sh
set -e

POSTFIX_BCKFILE="/var/lib/amavisd-new-postfix/backups/main.cf-backup"

if [ "$1" = "remove" ]; then
               if which postconf >/dev/null && [ -f "${POSTFIX_BCKFILE}" ]; then
                       while read line; do
                               postconf -e "$line"
                       done < "${POSTFIX_BCKFILE}"
                       rm -f "${POSTFIX_BCKFILE}"
               fi
       if [ -x "/etc/init.d/postfix" ]; then
               if [ -x /usr/sbin/invoke-rc.d ]; then
                       invoke-rc.d postfix reload
               else
                       /etc/init.d/postfix reload
               fi
       fi
fi

#DEBHELPER#

exit 0
