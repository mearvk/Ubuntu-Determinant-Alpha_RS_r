# gcc manpages are non-free
gnat-mingw-w64-i686-win32: no-manual-page

# These aren't spelling errors
gnat-mingw-w64-i686-win32: spelling-error-in-binary usr/bin/i686-w64-mingw32-gnatlink-* nam name
gnat-mingw-w64-i686-win32: spelling-error-in-binary usr/lib/gcc/i686-w64-mingw32/*/gnat1 Nam Name

# PIE causes issues with pre-compiled headers
gnat-mingw-w64-i686-win32: hardening-no-pie

# ALI files are supposed to be read-only
gnat-mingw-w64-i686-win32: non-standard-file-perm *.ali 0444 != 0644
