Rules-Requires-Root: no
XS-Build-Indep-Architecture: riscv64

Package: cd-boot-images-riscv64
Architecture: all
Built-Using: ${Built-Using}
Depends: ${misc:Depends}, ${shlibs:Depends}
Description: RISC-V images for debian-cd and ubuntu-image
 Provide a RISC-V images for debian-cd and ubuntu-image.
 .
 Trees of bootloader components are provided together with a sample
 xorriso command to use.
 .
 In addition to the provided files, grub.cfg has to be provided by
 the consumer of these products.
 .
 This package must be rebuilt whenever grub-efi-riscv64-bin is updated.
