$(builddir)/application.c: $(builddir)/ibus_ui_gtk3_vala.stamp
	@if test ! -f $@ && test $(srcdir) != $(builddir) && test -n "$$(find -L $(srcdir)/application.vala -prune ! -newer $(srcdir)/application.c)"; then cp -p $(srcdir)/application.c $(builddir)/application.c; fi
	@if test -f $@; then :; else rm -f $(builddir)/ibus_ui_gtk3_vala.stamp; fi
	@if test -f $@; then :; else \
	  $(MAKE) $(AM_MAKEFLAGS) $(builddir)/ibus_ui_gtk3_vala.stamp; \
	  if test $(builddir) != .; then mv application.c $(builddir)/; fi \
	fi
