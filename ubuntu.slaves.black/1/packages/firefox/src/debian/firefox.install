#!/usr/bin/dh-exec
firefox usr/bin/
debian/firefox.desktop usr/share/applications/
debian/icons/16x16.png => usr/share/icons/hicolor/16x16/apps/firefox.png
debian/icons/22x22.png => usr/share/icons/hicolor/22x22/apps/firefox.png
debian/icons/24x24.png => usr/share/icons/hicolor/24x24/apps/firefox.png
debian/icons/32x32.png => usr/share/icons/hicolor/32x32/apps/firefox.png
debian/icons/48x48.png => usr/share/icons/hicolor/48x48/apps/firefox.png
debian/icons/64x64.png => usr/share/icons/hicolor/64x64/apps/firefox.png
debian/icons/128x128.png => usr/share/icons/hicolor/128x128/apps/firefox.png
debian/icons/256x256.png => usr/share/icons/hicolor/256x256/apps/firefox.png
debian/icons/symbolic.svg => /usr/share/icons/hicolor/symbolic/apps/firefox-symbolic.svg
