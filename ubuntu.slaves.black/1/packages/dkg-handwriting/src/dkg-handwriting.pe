#!/usr/bin/fontforge

# fontforge script for generating dkg-handwriting fonts 

# author: Daniel Kahn Gillmor <dkg@fifthhorseman.net>
# Copyright: 2005,2006,2007
# license for this script: GPLv3 or later

Print("Generating Regular Font");
Open("dkg-handwriting.sfd"); 
SetFontNames("DkgHandwriting","DkgHandwriting","DkgHandwriting","regular");
SetTTFName(0x409,2,"Roman")
Generate("dkg.ttf");


Print("Generating Italic Font");
SelectAll();
Skew(30);
SetItalicAngle(-30);
SetFontNames("DkgHandwriting-Oblique","DkgHandwriting","DkgHandwriting-Oblique","regular");
SetTTFName(0x409,2,"Oblique")
Generate("dkgIt.ttf");
Close();

Print("Generating Bold Font");
Open("dkg-handwriting.sfd"); 
SetOS2Value("Weight", 700);
SelectAll();
SetItalicAngle(0);
Copy()
ExpandStroke(50,1,1);
PasteInto();
RemoveOverlap();
SetFontNames("DkgHandwriting-Bold","DkgHandwriting","DkgHandwriting-Bold","bold");
SetTTFName(0x409,2,"Bold")
Generate("dkgBd.ttf");

Print("Generating Bold Italic Font");
Skew(30);
SetItalicAngle(-30);
SetFontNames("DkgHandwriting-Bold-Oblique","DkgHandwriting","DkgHandwriting-Bold-Oblique","bold");
SetTTFName(0x409,2,"Bold Oblique")
Generate("dkgBI.ttf");

Print("cleaning up...");
Close();
