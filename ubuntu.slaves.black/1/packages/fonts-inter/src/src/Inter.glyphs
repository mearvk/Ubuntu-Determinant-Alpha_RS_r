code = "include(features/ccmp.fea);\012";
name = ccmp;
},
{
code = "feature locl;\012feature frac;\012feature numr;\012feature dnom;\012feature case;\012feature calt;\012feature tnum;\012feature pnum;\012feature zero;\012feature sups;\012feature subs;\012feature ordn;\012feature salt;\012feature ss01;\012feature ss02;\012feature ss03;\012feature cv01;\012feature cv02;\012feature cv03;\012feature cv04;\012feature cv05;\012feature cv06;\012feature cv07;\012feature cv08;\012feature cv09;\012feature cv10;\012feature cv11;\012";
name = aalt;
},
{
automatic = 1;
code = "lookup locl_latn_0 {\012	script latn;\012	language ROM;\012	sub Scedilla by Scommaaccent;\012	sub scedilla by scommaaccent;\012	sub tcedilla by tcommaaccent;\012	language MOL;\012	sub Scedilla by Scommaaccent;\012	sub scedilla by scommaaccent;\012	sub tcedilla by tcommaaccent;\012} locl_latn_0;\012\012lookup locl_latn_1 {\012	script latn;\012	language CAT;\012	sub  l' periodcentered' l by ldot;\012	sub  L' periodcentered' L by Ldot;\012} locl_latn_1;\012";
name = locl;
},
{
code = "include(features/frac.fea);";
name = frac;
},
{
automatic = 1;
code = "sub i by i.numr;\012sub n by n.numr;\012sub zero by zero.numr;\012sub one by one.numr;\012sub two by two.numr;\012sub three by three.numr;\012sub four by four.numr;\012sub five by five.numr;\012sub six by six.numr;\012sub seven by seven.numr;\012sub eight by eight.numr;\012sub nine by nine.numr;\012sub plus by plus.numr;\012sub minus by minus.numr;\012sub equal by equal.numr;\012sub parenleft by parenleft.numr;\012sub parenright by parenright.numr;\012";
name = numr;
},
{
automatic = 1;
code = "sub zero by zero.dnom;\012sub one by one.dnom;\012sub two by two.dnom;\012sub three by three.dnom;\012sub four by four.dnom;\012sub five by five.dnom;\012sub six by six.dnom;\012sub seven by seven.dnom;\012sub eight by eight.dnom;\012sub nine by nine.dnom;\012sub plus by plus.dnom;\012sub minus by minus.dnom;\012sub equal by equal.dnom;\012sub parenleft by parenleft.dnom;\012sub parenright by parenright.dnom;\012";
