Description: Fix minor spelling errors in the PostgreSQL driver
Author: Hugh McMaster <hugh.mcmaster@outlook.com>
Forwarded: https://github.com/lurcher/unixODBC/pull/56
Last-Update: 2021-01-25

---
 Drivers/Postgre7.1/connection.c | 2 +-
 Drivers/Postgre7.1/execute.c    | 2 +-
 Drivers/Postgre7.1/statement.c  | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Drivers/Postgre7.1/connection.c b/Drivers/Postgre7.1/connection.c
index c8a14e2..8b5256b 100644
--- a/Drivers/Postgre7.1/connection.c
+++ b/Drivers/Postgre7.1/connection.c
@@ -1196,7 +1196,7 @@ char cmdbuffer[MAX_MESSAGE_LEN+1];	/* QR_set_command() dups this string so dont
 			mylog("send_query: 'E' - %s\n", msgbuffer);
 			qlog("ERROR from backend during send_query: '%s'\n", msgbuffer);
 
-			/* We should report that an error occured. Zoltan */
+			/* We should report that an error occurred. Zoltan */
             if (res)
                 QR_Destructor(res);
 			res = QR_Constructor();
diff --git a/Drivers/Postgre7.1/execute.c b/Drivers/Postgre7.1/execute.c
index 86b8712..9fc4754 100644
--- a/Drivers/Postgre7.1/execute.c
+++ b/Drivers/Postgre7.1/execute.c
@@ -99,7 +99,7 @@ StatementClass *self = (StatementClass *) hstmt;
 		return SQL_ERROR;
 
 	default:
-		SC_set_error(self, STMT_INTERNAL_ERROR, "An Internal Error has occured -- Unknown statement status.");
+		SC_set_error(self, STMT_INTERNAL_ERROR, "An Internal Error has occurred -- Unknown statement status.");
 		SC_log_error(func, "", self);
 		return SQL_ERROR;
 	}
diff --git a/Drivers/Postgre7.1/statement.c b/Drivers/Postgre7.1/statement.c
index 522cfaf..5e8e644 100644
--- a/Drivers/Postgre7.1/statement.c
+++ b/Drivers/Postgre7.1/statement.c
@@ -413,7 +413,7 @@ mylog("recycle statement: self= %u\n", self);
 		break;
 
 	default:
-		SC_set_error(self, STMT_INTERNAL_ERROR, "An internal error occured while recycling statements");
+		SC_set_error(self, STMT_INTERNAL_ERROR, "An internal error occurred while recycling statements");
 		return FALSE;
 	}
 
