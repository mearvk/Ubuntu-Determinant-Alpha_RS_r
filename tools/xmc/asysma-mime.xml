<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared MIME description for the repository's ASYSMA application container. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-asysma">
    <comment>ASYSMA Application Package</comment>
    <glob pattern="*.asysma"/>
    <magic priority="80">
      <match type="string" offset="0" value="ASYSMA\x00\x01"/>
    </magic>
  </mime-type>
</mime-info>
