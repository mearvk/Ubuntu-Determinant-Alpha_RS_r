# Ubuntu White Edition default component manifest
# Provisioning systems may source this manifest to install the default CTRMS
# filesystem observation service. This file does not execute commands itself.

CTRMSCTL_DEFAULT=1
CTRMSCTL_SERVICE=ctrmsctl.service
CTRMSCTL_BINARY=/usr/local/sbin/ctrmsctl
CTRMSCTL_STATE=/var/lib/ctrmsctl
CTRMSCTL_ROOT=/
CTRMSCTL_INDEX=/var/lib/ctrmsctl/index.tsv
