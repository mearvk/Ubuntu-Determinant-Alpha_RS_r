[Desktop Entry]
Type=Application
Version=1.0
Name=JSpec Professional
GenericName=JSpec Executable Launcher
Comment=JSpec Professional launcher for .alpha executable targets
Exec=/usr/local/lib/jspec/jspec-runner %U
TryExec=/usr/local/lib/jspec/jspec-runner
Icon=jspec-professional
Terminal=true
Categories=Development;System;
MimeType=application/x-jspec-alpha;
StartupNotify=true
X-JSpec-ExecutableIdentity=.alpha
X-JSpec-NativeLinuxFormat=ELF
X-JSpec-TargetOrder=.alpha;.elf;.exe
X-JSpec-Preflight=true
X-JSpec-ProximityArming=presentation-only
X-JSpec-ExecutionHandoff=execve
X-JSpec-Policy=professional-default
