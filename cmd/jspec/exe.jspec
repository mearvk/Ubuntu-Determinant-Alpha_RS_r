{
  "jspec": "1.1",
  "title": "JSpec Professional Series Executable Contract",
  "status": "draft",
  "purpose": "Define a deterministic execution layer and native .alpha executable family for the /cmd desktop/executable series while preserving target cause, identity, performance, and OS-native execution semantics.",
  "professional_series": {
    "name": "JSpec Professional",
    "executable_identity": ".alpha",
    "principles": ["preserve-cause", "preserve-performance", "preserve-identity", "deterministic-handoff", "OS-native-execution", "quiet-by-default"]
  },
  "execution_model": {
    "layers": ["desktop-or-shell-launch", "jspec-preflight", ".alpha-native-executable", "operating-system-loader", "target-executable"],
    "rule": "JSpec surrounds execution; it does not replace the target executable.",
    "handoff": "After validation, JSpec delegates to the OS using native process execution.",
    "cause": "The target remains authoritative; JSpec does not silently rewrite argv, environment, working directory, stdio, privileges, or exit semantics."
  },
  "alpha": {
    "extension": ".alpha",
    "linux_v1": {
      "actual_binary_format": "ELF",
      "identity_rule": "The .alpha extension identifies the JSpec family while ELF remains the OS-recognized executable format.",
      "loader": "Linux ELF loader",
      "handoff": "execve"
    },
    "weight": {
      "custom_container": false,
      "persistent_runtime": false,
      "goal": "minimum launch overhead consistent with preflight and contract preservation"
    },
    "congruency": "JSpec and the desktop linking system recognize .alpha; the OS continues to recognize ELF."
  },
  "formats": {
    "linux_v1": {"binary_format": "ELF", "identity": ".alpha", "launcher": "native-posix", "handoff": "execve/execvp"},
    "windows_v2": {"binary_format": "PE/COFF", "identity": ".alpha", "target": ".exe", "launcher": "native-windows", "handoff": "CreateProcessW"}
  },
  "arming": {
    "mode": "pre-launch",
    "trigger": "desktop-or-shell-activation",
    "proximity": "Optional visual presentation only; pointer proximity must never execute a program.",
    "preflight": ["resolve target", "identify .alpha/ELF identity", "verify architecture compatibility", "validate policy", "prepare inherited execution context"]
  },
  "cooling": {
    "default": "calm",
    "visuals": "presentation-only",
    "motion": "bounded and non-blocking",
    "color": "theme-controlled",
    "rule": "Color and movement cannot alter executable semantics or scheduling correctness."
  },
  "security": {
    "default": "fail-closed-on-invalid-target",
    "no_shell_reinterpretation": true,
    "no_argument_mutation": true,
    "no_privilege_escalation": true,
    "no_hidden_network_requirement": true
  },
  "performance": {
    "goal": "minimal launch overhead",
    "steady_state": "No resident JSpec runtime unless explicitly configured as a supervisor.",
    "measurement": "Optional preflight/handoff latency telemetry."
  },
  "compatibility": {
    "legacy_pro_code": "Retain the predictable executable and command model while adding a controlled JSpec pre-run contract.",
    "jdk_jvm_layer": "JSpec may sit beside or below a JDK/JVM at the native OS boundary without requiring Java for Linux v1.",
    "future": ["PE/COFF .alpha", "Windows Shell", "signed executable policy", "GUI launcher", "JVM-integrated runtime"]
  },
  "exit_semantics": {"pass_through": true, "rule": "Unless policy explicitly states otherwise, return the target process result unchanged."},
  "configuration": {
    "format": "JSpec",
    "required": ["target"],
    "optional": ["policy", "integrity", "theme", "telemetry", "supervision"],
    "example": {"target": "/usr/bin/cmd", "policy": "professional-default", "theme": {"mode": "cool-calm"}}
  }
}
