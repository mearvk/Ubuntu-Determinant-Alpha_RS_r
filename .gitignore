# Build artifacts
userland/x11/_build/
build/

# JDesk native build artifacts (rebuilt with: make -C userland/jdesk/native/linux)
userland/jdesk/native/linux/*.o
userland/jdesk/native/linux/libjdesk.so

# Large boot-jdk files (rebuilt from chunks/ via rebuild.sh)
userland/java/boot-jdk-27/lib/modules
userland/java/boot-jdk-27/lib/src.zip

# Compiled Java output (rebuild with: ant compile)
userland/java-web-server/out/
userland/java-web-server/nwe.jar

# Editor
.idea/workspace.xml

# OS
*.swp
*.swo
*~

# Runtime state (never commit)
*.pid
*.log
*.sock

# Large ISO/disk images (too big for GitHub)
*.iso
*.img

# Large archives and binaries (over 50MB, too big for GitHub)
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.7z
*.rar

# Large Java/compiled artifacts
*.gch
*.jar
*.zip
build/linux-x86_64-server-release/support/src.zip
userland/java/openjdk-28-ea*/
graal-latest/.git/objects/pack/
