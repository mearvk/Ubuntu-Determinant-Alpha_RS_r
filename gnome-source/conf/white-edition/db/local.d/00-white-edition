# Ubuntu White Edition distribution defaults.
# These are defaults, not locks: users may override them in their own dconf database.

[org/gnome/desktop/interface]
color-scheme='prefer-light'
icon-theme='Ubuntu-White'

[org/gnome/desktop/background]
picture-options='zoom'

# Start menu popup alignment for the White Edition Shell extension.
# This is a default, not a lock: users may override it in their own dconf database.
# The extension (shell-extension/white-edition@mearvk/) must be installed and
# enabled for this key to take effect; the Start button itself always stays
# fixed at the bottom-left and only the popup honors this alignment.
[org/gnome/shell/extensions/white-edition]
start-menu-alignment='left'
