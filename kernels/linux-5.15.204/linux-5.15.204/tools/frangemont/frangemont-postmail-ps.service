[Unit]
Description=Frangemont PostMail PS — Byte-Level Package Safety Inspection
Documentation=man:frangemont-postmail-ps(8)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=forking
PIDFile=/run/frangemont-postmail-ps.pid
ExecStart=/usr/local/sbin/frangemont-postmail-ps
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/frangemont /var/spool/frangemont /run
PrivateTmp=yes
NoNewPrivileges=no
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN
AmbientCapabilities=CAP_DAC_READ_SEARCH

# Memory protection
MemoryDenyWriteExecute=yes
LimitCORE=0

# Process visibility
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
